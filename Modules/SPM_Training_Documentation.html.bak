                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SUSD_BatteryVoltageRange</span><span class="pd-mult">1..1</span>
                </div>
