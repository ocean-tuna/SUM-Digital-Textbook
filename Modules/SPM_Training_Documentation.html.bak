                <div class="pd-body">
                  <div class="pd-desc">Wakeup activity records configuration for DID E0D7 tracking.</div>
                  <div class="pd-section-title">Parameters</div>
                  <div class="pd-hdr param-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Description</span></div>
                  <div class="pd-param"><span class="pn">Sum_SUSD_AR_Periodicity</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">1.0</span><span class="pdesc">Periodicity of activity records runnable.</span></div>
                  <div class="pd-param"><span class="pn">Sum_SUSD_k_AR_Active_Delay</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;255</span><span class="pdef">120</span><span class="pdesc">Active delay for activity records.</span></div>
                  <div class="pd-param"><span class="pn">Sum_SUSD_k_AR_Init_Delay</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;2550</span><span class="pdef">500</span><span class="pdesc">Init delay for activity records.</span></div>
                  <div class="pd-param"><span class="pn">Sum_SUSD_Record0x01_Type</span><span class="type-badge type-enum">ENUM</span><span class="pm">1..1</span><span class="pr">Enumerated</span><span class="pdef">&mdash;</span><span class="pdesc">Record type for 0x01 activity records.</span></div>
                  <div class="pd-section-title">References</div>
                  <div class="pd-hdr ref-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Target</span><span>Description</span></div>
                  <div class="pd-ref"><span class="pn">Sum_SUSD_E0D7NvMBlockRef</span><span class="type-badge type-ref">REF</span><span class="pm">1..1</span><span class="pr">NvM &rarr; NvMBlockDescriptor</span><span class="pdesc">NvM block for DID E0D7 data.</span></div>
                  <div class="pd-ref"><span class="pn">Sum_SUSD_FirstBootPostFlashNvMBlockRef</span><span class="type-badge type-ref">REF</span><span class="pm">1..1</span><span class="pr">NvM &rarr; NvMBlockDescriptor</span><span class="pdesc">NvM block for first boot post-flash data.</span></div>
                  <div class="pd-ref"><span class="pn">Sum_SUSD_E0D7_MonitorDisabled_NvMBlockRef</span><span class="type-badge type-ref">REF</span><span class="pm">1..1</span><span class="pr">NvM &rarr; NvMBlockDescriptor</span><span class="pdesc">NvM block for E0D7 monitor disabled state.</span></div>
                  <div class="pd-ref"><span class="pn">Sum_SUSD_LIN_WakeupSource</span><span class="type-badge type-ref">REF</span><span class="pm">0..*</span><span class="pr">EcuM &rarr; EcuMWakeupSource</span><span class="pdesc">LIN wakeup source references.</span></div>
                  <div class="pd-ref"><span class="pn">Sum_SUSD_ECU_WakeupSource</span><span class="type-badge type-ref">REF</span><span class="pm">0..*</span><span class="pr">EcuM &rarr; EcuMWakeupSource</span><span class="pdesc">ECU wakeup source references.</span></div>
                </div>
              </div>
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SUSD_C_SWCInfo</span><span class="pd-mult">0..*</span><span class="pd-count">2 params</span><span class="pd-count">2 refs</span>
                </div>
                <div class="pd-body">
                  <div class="pd-desc">Per-SWC shutdown permission and wakeup source configuration.</div>
                  <div class="pd-section-title">Parameters</div>
                  <div class="pd-hdr param-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Description</span></div>
                  <div class="pd-param"><span class="pn">SUSD_SWCName</span><span class="type-badge type-str">STRING</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">&mdash;</span><span class="pdesc">Name of the SWC.</span></div>
                  <div class="pd-param"><span class="pn">SUSD_C_ShutdownPermControl</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">&mdash;</span><span class="pdesc">Enable shutdown permission control for this SWC.</span></div>
                  <div class="pd-section-title">References</div>
                  <div class="pd-hdr ref-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Target</span><span>Description</span></div>
                  <div class="pd-ref"><span class="pn">SUSD_BatteryVoltageRangeRef</span><span class="type-badge type-ref">REF</span><span class="pm">0..1</span><span class="pr">SUSD_C_BatteryVoltageRange</span><span class="pdesc">Battery voltage range for this SWC.</span></div>
                  <div class="pd-ref"><span class="pn">SUSD_SWCs_SpecificWkSrcId</span><span class="type-badge type-ref">REF</span><span class="pm">0..*</span><span class="pr">EcuM &rarr; EcuMWakeupSource</span><span class="pdesc">SWC-specific wakeup source identifiers.</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- SUSDWakeUpRelation -->
          <div class="pd-node">
            <div class="pd-header" onclick="toggleTree(this)">
              <span class="pd-toggle">&#9654;</span><span class="pd-icon container">C</span><span class="pd-name">SUSDWakeUpRelation</span><span class="pd-mult">1..1</span><span class="pd-count">1 ref</span>
            </div>
            <div class="pd-body">
              <div class="pd-desc">Maps wakeup events to execution permissions. References EcuM wakeup sources.</div>
              <div class="pd-section-title">References</div>
              <div class="pd-hdr ref-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Target</span><span>Description</span></div>
              <div class="pd-ref"><span class="pn">SUSD_WakeupSourceId</span><span class="type-badge type-ref">REF</span><span class="pm">1..*</span><span class="pr">EcuM &rarr; EcuMWakeupSource</span><span class="pdesc">Wakeup source IDs determining PermitExecution values.</span></div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="explain-box">
      <div class="title">How SUSD ParamDef    <div class="explain-box">
      <div class="title">How SUSD ParamDef works with the module</div>
      SUSD is the first SUM module to execute. It reads the wakeup source from EcuM, matches it against <strong>SUSDWakeUpRelation</strong> to determine which modules should start,
      then distributes PermitExecution bitmasks through <strong>SUSD_C_SUMsInfo</strong> (one instance per SUM module: SPM, LNM, SSFM, PNC, DIAG, TCS, etc.).
      <br><br>
      <strong>SUSDGeneral</strong> handles Vehicle Power Mode (VPM) determination from Primary/Backup Power Mode COM signals, with configurable security level and initial power mode values.
      Multiple periodicities control how often SUSD polls battery voltage, wakeup sources, RunCrank status, and VPM changes.
      <br><br>
      <strong>SUSDConfigSet</strong> configures RunCrank input diagnostics (stuck high/low with fault maturation counters), battery voltage ranges with hysteresis, and Activity Records (DID E0D7) for tracking wakeup history in NvM.
    </div>

    <div class="warn-box">
      <div class="title">Key relationship: SUSD &harr; PermitExecutionMask</div>
      Every SUM module has a <code>PermitExecutionMask</code> parameter (INTEGER, 0..255, default 254).
      SUSD sets a PermitExecution value based on the wakeup source, and each module checks:
      <code>if (PermitExecution &amp; PermitExecutionMask) != 0 then execute</code>.
      This allows fine-grained control over which modules run for each wakeup scenario.
    </div>
  </div>
</div>
</section>

<!-- ==================== Common Patterns ==================== -->
<section id="common-params">
<h2>Common Patterns Across Modules</h2>

<div class="container-node">
  <div class="container-name">PermitExecutionMask</div>
  <div class="container-desc">Found in: TCS, DIAG, PNC, SrvcMgr, SPM, LNM, SOH, SSFM. Always INTEGER 0..255 with default 254. Used by SUSD to control module startup based on wakeup source.</div>
</div>

<div class="container-node">
  <div class="container-name">GenerateInitRunnable + InitFuncPeriodicity</div>
  <div class="container-desc">Found in: TCS, DIAG, SrvcMgr, and others. A BOOLEAN flag that enables generation of a one-shot init runnable, paired with a FLOAT periodicity (ms). When FALSE, init is called by BswM action list instead.</div>
</div>

<div class="container-node">
  <div class="container-name">ServiceBased References</div>
  <div class="container-desc">Found in: TCS, DIAG, SrvcMgr. Paired FOREIGN-REFs for DataTypeMappingSet + IMPLEMENTATION-DATA-TYPE-ELEMENT. These enable SOME/IP service-based communication as an alternative to signal-based COM. Presence activates service-based mode.</div>
</div>

<div class="container-node">
  <div class="container-name">CHOICE-REFERENCE-DEF</div>
  <div class="container-desc">Found in: TCS, DIAG, SrvcMgr, PNC, SSFM. Used when a reference can point to multiple target types (e.g., ComSignal OR ComGroupSignal, SdClientService OR SdServerService). The integrator selects which target type applies for their project.</div>
</div>

<div class="container-node">
  <div class="container-name">Reliability Monitor / Detector Pattern (SOH)</div>
  <div class="container-desc">SOH uses a highly consistent detector pattern repeated ~20 times: each detector has a Thresh_Init (INT, fault counter), TW_Thresh_Init (INT, time window in seconds), an NvM block reference for persistent storage, and a DcmDspData DID reference for diagnostic readout. Detectors are grouped under 5 Reliability Monitor categories (Reset, MemoryStatus, Communication, WatchdogManager, Platform).</div>
</div>

<div class="container-node">
  <div class="container-name">Error Filter Pattern (SSFM)</div>
  <div class="container-desc">SSFM uses reusable GeneralEventsFilter containers with FilterType (NONE/BLOCK/X_OF_Y), threshold X, and window Y parameters. Error handlers across all error categories reference these shared filters, allowing consistent error debouncing configuration.</div>
</div>

<div class="container-node">
  <div class="container-name">NvM Block References</div>
  <div class="container-desc">Found in: SOH (extensively), SSFM, SUSD, TCS. References to NvMBlockDescriptor containers for persistent data storage across power cycles. Used for DID data, counters, and configuration values that must survive reset.</div>
</div>
</section>

<!-- ==================== Glossary ==================== -->
<section id="glossary">
<h2>Glossary</h2>
<table class="param-table">
  <tr><th style="width:220px">Term</th><th>Definition</th></tr>
  <tr><td class="param-name">ECUC</td><td>ECU Configuration - AUTOSAR mechanism for compile-time and post-build parameter configuration.</td></tr>
  <tr><td class="param-name">ParamDef / EcucParamDef</td><td>Parameter Definition file (.arxml) that declares all configurable parameters for a module.</td></tr>
  <tr><td class="param-name">Container</td><td>Logical grouping of parameters in the ECUC hierarchy. Can contain parameters, references, and sub-containers.</td></tr>
  <tr><td class="param-name">Multiplicity</td><td>How many instances of a container/parameter are allowed (e.g., 0..1 optional, 1..1 mandatory, 1..* one or more).</td></tr>
  <tr><td class="param-name">VARIANT-PRE-COMPILE</td><td>Parameter is resolved at compile time and compiled into the binary.</td></tr>
  <tr><td class="param-name">VARIANT-POST-BUILD</td><td>Parameter can be changed after compilation and loaded at runtime.</td></tr>
  <tr><td class="param-name">ECUC-REFERENCE-DEF</td><td>A reference to a single specific AUTOSAR container type.</td></tr>
  <tr><td class="param-name">ECUC-CHOICE-REFERENCE-DEF</td><td>A reference that can point to one of multiple container types (integrator chooses).</td></tr>
  <tr><td class="param-name">ECUC-FOREIGN-REFERENCE-DEF</td><td>A reference to an AUTOSAR element outside the ECUC domain (e.g., system model elements).</td></tr>
  <tr><td class="param-name">PermitExecution</td><td>Bitmask mechanism used by SUSD to control which SUM modules are allowed to execute based on wakeup source.</td></tr>
  <tr><td class="param-name">BswM</td><td>Basic Software Mode Manager - AUTOSAR module that manages mode-dependent actions including init sequences.</td></tr>
  <tr><td class="param-name">DCM</td><td>Diagnostic Communication Manager - handles diagnostic services (DIDs, RIDs).</td></tr>
  <tr><td class="param-name">NvM</td><td>Non-Volatile Memory Manager - manages persistent data storage.</td></tr>
  <tr><td class="param-name">DEM</td><td>Diagnostic Event Manager - manages DTCs (Diagnostic Trouble Codes).</td></tr>
  <tr><td class="param-name">ComM</td><td>Communication Manager - manages communication channel states.</td></tr>
  <tr><td class="param-name">WdgM</td><td>Watchdog Manager - supervises software execution timing and logical sequences.</td></tr>
  <tr><td class="param-name">SecOC</td><td>Secure Onboard Communication - provides message authentication (MAC) for CAN/Ethernet PDUs.</td></tr>
  <tr><td class="param-name">DTC</td><td>Diagnostic Trouble Code - standardized error codes stored by DEM and readable via diagnostics.</td></tr>
  <tr><td class="param-name">DID</td><td>Data Identifier - diagnostic data element readable/writable via UDS services (e.g., F08F, E0B8).</td></tr>
  <tr><td class="param-name">RID</td><td>Routine Identifier - diagnostic routine triggerable via UDS service 0x31 (e.g., RID 02C0).</td></tr>
  <tr><td class="param-name">SSM</td><td>Startup/Shutdown Manager - SSFM sub-module managing serial data monitoring and startup sequences.</td></tr>
  <tr><td class="param-name">ERRH</td><td>Error Handler - SSFM sub-module handling error DIDs, DTC aggregation, and error filtering.</td></tr>
  <tr><td class="param-name">QoS</td><td>Quality of Service - signal quality indication interfaces used by SSFM for consolidated status reporting.</td></tr>
</table>
</section>

</main>

<script>
function toggleModule(header) {
  header.classList.toggle('open');
  const body = header.nextElementSibling;
  body.classList.toggle('open');
}

function toggleTree(el) {
  const header = el.closest('.pd-header');
  const node = header.closest('.pd-node');
  const body = node.querySelector(':scope > .pd-body');
  const children = node.querySelector(':scope > .pd-children');
  header.classList.toggle('active');
  if (body) body.classList.toggle('open');
  if (children) children.classList.toggle('hidden');
}

function filterAll(query) {
  const q = query.toLowerCase().trim();
  document.querySelectorAll('.module-section').forEach(section => {
    if (!q) { section.style.display = ''; return; }
    const text = section.textContent.toLowerCase();
    section.style.display = text.includes(q) ? '' : 'none';
  });
  document.querySelectorAll('#common-params, #glossary').forEach(section => {
    if (!q) { section.style.display = ''; return; }
    const text = section.textContent.toLowerCase();
    section.style.display = text.includes(q) ? '' : 'none';
  });
}

// Sidebar active state
const links = document.querySelectorAll('nav.sidebar a[href^="#"]');
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      links.forEach(l => l.classList.remove('active'));
      const link = document.querySelector(`nav.sidebar a[href="#${e.target.id}"]`);
      if (link) link.classList.add('active');
    }
  });
}, { rootMargin: '-80px 0px -70% 0px' });
document.querySelectorAll('section[id]').forEach(s => observer.observe(s));
</script>

<script>
(function() {
    /* SVG-based interactive diagrams */
    document.querySelectorAll('.arch-interactive').forEach(function(svg) {
        var activeModule = null;

        svg.querySelectorAll('.module-box').forEach(function(box) {
            box.addEventListener('click', function(e) {
                e.stopPropagation();
                var mod = this.getAttribute('data-module');

                if (activeModule === mod) {
                    resetDiagram(svg);
                    activeModule = null;
                    return;
                }

                activeModule = mod;

                svg.querySelectorAll('.module-box').forEach(function(b) {
                    b.classList.remove('active', 'connected', 'dimmed');
                    b.classList.add('dimmed');
                });
                svg.querySelectorAll('.conn-path').forEach(function(p) {
                    p.classList.remove('highlighted', 'dimmed');
                    p.classList.add('dimmed');
                });
                svg.querySelectorAll('.conn-label').forEach(function(l) {
                    l.classList.remove('highlighted', 'dimmed');
                    l.classList.add('dimmed');
                });

                this.classList.remove('dimmed');
                this.classList.add('active');

                svg.querySelectorAll('.conn-path').forEach(function(p) {
                    var from = p.getAttribute('data-from');
                    var to = p.getAttribute('data-to');
                    if (from === mod || to === mod) {
                        p.classList.remove('dimmed');
                        p.classList.add('highlighted');
                        var connected = (from === mod) ? to : from;
                        var connBox = svg.querySelector('.module-box[data-module="' + connected + '"]');
                        if (connBox) {
                            connBox.classList.remove('dimmed');
                            connBox.classList.add('connected');
                        }
                    }
                });

                svg.querySelectorAll('.conn-label').forEach(function(l) {
                    var from = l.getAttribute('data-from');
                    var to = l.getAttribute('data-to');
                    if (from === mod || to === mod) {
                        l.classList.remove('dimmed');
                        l.classList.add('highlighted');
                    }
                });
            });
        });

        svg.addEventListener('click', function(e) {
            if (!e.target.closest('.module-box')) {
                resetDiagram(svg);
                activeModule = null;
            }
        });
    });

    function resetDiagram(svg) {
        svg.querySelectorAll('.module-box').forEach(function(b) {
            b.classList.remove('active', 'connected', 'dimmed');
        });
        svg.querySelectorAll('.conn-path').forEach(function(p) {
            p.classList.remove('highlighted', 'dimmed');
        });
        svg.querySelectorAll('.conn-label').forEach(function(l) {
            l.classList.remove('highlighted', 'dimmed');
        });
    }

    /* HTML-based interactive diagrams (SPM) */
    document.querySelectorAll('.arch-interactive-html').forEach(function(container) {
        var activeModule = null;

        container.querySelectorAll('.module-box-html').forEach(function(box) {
            box.addEventListener('click', function(e) {
                e.stopPropagation();
                var mod = this.getAttribute('data-module');

                if (activeModule === mod) {
                    resetHtmlDiagram(container);
                    activeModule = null;
                    return;
                }

                activeModule = mod;
                var connections = (this.getAttribute('data-connections') || '').split(',');

                container.querySelectorAll('.module-box-html').forEach(function(b) {
                    b.classList.remove('active', 'connected', 'dimmed');
                    b.classList.add('dimmed');
                });

                this.classList.remove('dimmed');
                this.classList.add('active');

                connections.forEach(function(conn) {
                    var connBox = container.querySelector('.module-box-html[data-module="' + conn.trim() + '"]');
                    if (connBox) {
                        connBox.classList.remove('dimmed');
                        connBox.classList.add('connected');
                    }
                });
            });
        });

        container.addEventListener('click', function(e) {
            if (!e.target.closest('.module-box-html')) {
                resetHtmlDiagram(container);
                activeModule = null;
            }
        });
    });

    function resetHtmlDiagram(container) {
        container.querySelectorAll('.module-box-html').forEach(function(b) {
            b.classList.remove('active', 'connected', 'dimmed');
        });
    }
})();
</script>

</body>
</html>



