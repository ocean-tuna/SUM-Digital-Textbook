              <div class="pd-param"><span class="pn">SUSD_C_RunCrankInputThresholdHigh</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">0&ndash;26.5</span><span class="pdef">5</span><span class="pdesc">RunCrank Active High threshold voltage.</span></div>
              <div class="pd-param"><span class="pn">SUSD_C_RunCrankInputThresholdLow</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">0&ndash;26.5</span><span class="pdef">2</span><span class="pdesc">RunCrank Active Low threshold voltage.</span></div>
              <div class="pd-param"><span class="pn">SUSD_C_RunCrankInput_DebounceTime</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">0.0&ndash;10.0</span><span class="pdef">0.03</span><span class="pdesc">Debounce time in sec for RunCrank input.</span></div>
              <div class="pd-param"><span class="pn">SUSD_C_RunCrankInputType</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">TRUE=DISCRETE, FALSE=ANALOG.</span></div>
