              <div class="pd-param"><span class="pn">SUSD_C_RunCrankInputStuckHi_Enable</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Enable RunCrank Stuck High diagnostic.</span></div>
