              <div class="pd-param"><span class="pn">SUSD_C_RunCrankInputStuckHi_SampleCount</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">20</span><span class="pdesc">Sample count for Stuck High detection.</span></div>
