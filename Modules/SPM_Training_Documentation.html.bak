    },
    "RE_SPM_GetProfileState": {
      symbol: "SPM_GetProfileState",
      trigger: "opinvoke",
      event: "OIE_SPM_RequestStatusProfileState",
      port: "PP_SPM_RequestStatusProfileState / GetProfileState",
      dataReceive: [],
      dataSend: [],
      serverCalls: [],
      modeSwitchPoints: [],
      parameters: [],
      readLocalVars: [],
