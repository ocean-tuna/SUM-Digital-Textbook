    },
    "RE_SPM_DID_0xE0DE": {
      symbol: "Runnable_Spm_DID0xE0DE",
      trigger: "opinvoke",
      event: "OIE_DID_E0DE",
      port: "PP_SPM_Dcm_DataDidE0DE / ReadData",
      dataReceive: [],
