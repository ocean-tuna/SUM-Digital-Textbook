<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RTA-SUM SPM Training Documentation</title>
<style>
  :root {
    --primary: #1a3a5c;
    --primary-light: #2b5f8e;
    --accent: #e8913a;
    --bg: #f8f9fa;
    --card-bg: #ffffff;
    --text: #2d3436;
    --text-light: #636e72;
    --border: #dfe6e9;
    --code-bg: #f0f3f5;
    --success: #00b894;
    --warning: #fdcb6e;
    --danger: #d63031;
    --info: #0984e3;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.7;
    font-size: 15px;
  }

  /* Top navigation bar */
  .top-bar {
    background: var(--primary);
    color: white;
    padding: 12px 30px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .top-bar .logo {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .top-bar .logo span {
    color: var(--accent);
  }

  .top-bar .version {
    font-size: 13px;
    opacity: 0.8;
  }

  /* Sidebar */
  .sidebar {
    position: fixed;
    top: 50px;
    left: 0;
    width: 280px;
    height: calc(100vh - 50px);
    background: var(--card-bg);
    border-right: 1px solid var(--border);
    overflow-y: auto;
    padding: 20px 0;
    z-index: 500;
  }

  .sidebar h3 {
    padding: 0 20px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-light);
    margin-bottom: 12px;
  }

  .sidebar a {
    display: block;
    padding: 7px 20px;
    color: var(--text);
    text-decoration: none;
    font-size: 13.5px;
    border-left: 3px solid transparent;
    transition: all 0.2s;
  }

  .sidebar a:hover,
  .sidebar a.active {
    background: #f0f4f8;
    border-left-color: var(--accent);
    color: var(--primary);
  }

  .sidebar a.sub {
    padding-left: 36px;
    font-size: 12.5px;
    color: var(--text-light);
  }

  .sidebar a.sub:hover {
    color: var(--primary);
  }

  /* Main content */
  .content {
    margin-left: 280px;
    margin-top: 50px;
    padding: 40px 50px 80px;
    max-width: 960px;
  }

  /* Hero section */
  .hero {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: white;
    padding: 50px 40px;
    border-radius: 12px;
    margin-bottom: 40px;
  }

  .hero h1 {
    font-size: 32px;
    margin-bottom: 12px;
    font-weight: 700;
  }

  .hero p {
    font-size: 16px;
    opacity: 0.9;
    max-width: 600px;
    line-height: 1.6;
  }

  .hero .badge {
    display: inline-block;
    background: var(--accent);
    color: white;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    margin-top: 16px;
  }

  /* Section headings */
  h2 {
    font-size: 24px;
    color: var(--primary);
    margin: 50px 0 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--accent);
  }

  h3 {
    font-size: 19px;
    color: var(--primary);
    margin: 32px 0 14px;
  }

  h4 {
    font-size: 16px;
    color: var(--primary-light);
    margin: 24px 0 10px;
  }

  p { margin-bottom: 14px; }

  /* Lists */
  ul, ol {
    margin: 10px 0 18px 24px;
  }

  li {
    margin-bottom: 6px;
  }

  /* Tables */
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 24px;
    font-size: 14px;
    background: var(--card-bg);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  thead th {
    background: var(--primary);
    color: white;
    padding: 11px 14px;
    text-align: left;
    font-weight: 600;
    font-size: 13px;
  }

  tbody td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }

  tbody tr:hover {
    background: #f7f9fb;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  /* Code blocks */
  pre {
    background: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 18px 20px;
    overflow-x: auto;
    margin: 14px 0 20px;
    font-size: 13px;
    line-height: 1.6;
  }

  code {
    font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
    font-size: 13px;
  }

  p code, li code, td code {
    background: var(--code-bg);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 4px;
    color: #c0392b;
  }

  /* Syntax highlighting */
  .kw { color: #cba6f7; }
  .tp { color: #89b4fa; }
  .fn { color: #a6e3a1; }
  .cm { color: #6c7086; font-style: italic; }
  .st { color: #f9e2af; }
  .nm { color: #fab387; }

  /* Blockquotes (notes) */
  blockquote {
    border-left: 4px solid var(--accent);
    background: #fff8f0;
    padding: 14px 20px;
    margin: 16px 0 20px;
    border-radius: 0 8px 8px 0;
    font-size: 14px;
  }

  blockquote p {
    margin-bottom: 0;
  }

  blockquote strong {
    color: var(--accent);
  }

  /* Separator */
  hr {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 40px 0;
  }

  /* Bold and strong */
  strong { color: var(--primary); }
  td strong, th strong { color: inherit; }

  /* Info cards */
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 24px;
    margin: 20px 0;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  }

  .card h4 {
    margin-top: 0;
  }

  /* Scrollbar */
  .sidebar::-webkit-scrollbar {
    width: 5px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 4px;
  }

  /* ── Visual Diagrams ── */

  /* Vertical flow */
  .flow { display: flex; flex-direction: column; align-items: center; gap: 0; margin: 20px 0; }
  .flow-step {
    background: var(--card-bg); border: 2px solid var(--primary); border-radius: 10px;
    padding: 12px 22px; text-align: center; font-size: 13.5px; min-width: 220px; max-width: 520px;
    position: relative;
  }
  .flow-step.hl { border-color: var(--accent); background: #fff8f0; }
  .flow-step.remote { border-color: #d63031; background: #fff5f5; }
  .flow-step.local { border-color: #00b894; background: #f0fff8; }
  .flow-step.gray { border-color: #b2bec3; background: #f8f9fa; color: var(--text-light); }
  .flow-step small { display: block; color: var(--text-light); font-size: 12px; margin-top: 4px; }
  .flow-arrow {
    width: 2px; height: 28px; background: var(--primary); position: relative;
  }
  .flow-arrow::after {
    content: ''; position: absolute; bottom: -1px; left: -5px;
    border-left: 6px solid transparent; border-right: 6px solid transparent;
    border-top: 8px solid var(--primary);
  }
  .flow-label {
    font-size: 11px; color: var(--accent); font-weight: 700; text-align: center; padding: 2px 0;
  }

  /* Horizontal flow */
  .hflow { display: flex; align-items: center; gap: 0; flex-wrap: wrap; justify-content: center; margin: 20px 0; }
  .hflow .flow-step { min-width: 100px; max-width: 160px; padding: 10px 12px; font-size: 12px; }
  .hflow-arrow {
    width: 32px; height: 2px; background: var(--primary); position: relative; flex-shrink: 0;
  }
  .hflow-arrow::after {
    content: ''; position: absolute; right: -1px; top: -5px;
    border-top: 6px solid transparent; border-bottom: 6px solid transparent;
    border-left: 8px solid var(--primary);
  }
  .hflow-label {
    font-size: 10px; color: var(--text-light); text-align: center; min-width: 32px;
    margin-top: -18px; position: relative; top: -6px;
  }

  /* Branching (fork) */
  .fork { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin: 6px 0; }
  .fork-branch { display: flex; flex-direction: column; align-items: center; gap: 0; }

  /* SVG state machine */
  .svg-wrap { text-align: center; margin: 24px 0; overflow-x: auto; }
  .svg-wrap svg { max-width: 100%; height: auto; }

  /* Dependency tree */
  .dep-tree { margin: 20px 0; }
  .dep-root {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: var(--primary); color: white; border-radius: 10px;
    font-weight: 700; font-size: 14px;
  }
  .dep-children { margin-left: 30px; border-left: 3px solid var(--border); padding-left: 0; }
  .dep-child {
    display: flex; align-items: center; gap: 0; padding: 8px 0;
  }
  .dep-line {
    width: 40px; height: 2px; background: var(--border); flex-shrink: 0;
  }
  .dep-badge {
    font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 12px;
    background: var(--accent); color: white; white-space: nowrap; margin-right: 10px; flex-shrink: 0;
  }
  .dep-node-remote {
    display: inline-flex; align-items: center; padding: 8px 16px;
    background: #fff5f5; border: 2px solid #e74c3c; border-radius: 8px;
    font-size: 13px; font-weight: 600; color: #c0392b;
  }
  .dep-node-local {
    display: inline-flex; align-items: center; padding: 8px 16px;
    background: #f0fff8; border: 2px solid #27ae60; border-radius: 8px;
    font-size: 13px; font-weight: 600; color: #1e8449;
  }

  /* Timeline */
  .timeline { position: relative; margin: 24px 0 24px 90px; padding-left: 28px; }
  .timeline::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px; background: linear-gradient(to bottom, var(--primary), var(--accent));
    border-radius: 2px;
  }
  .tl-event {
    position: relative; padding: 12px 0 12px 20px; font-size: 13.5px;
  }
  .tl-event::before {
    content: ''; position: absolute; left: -34px; top: 16px;
    width: 12px; height: 12px; border-radius: 50%; background: var(--accent);
    border: 3px solid white; box-shadow: 0 0 0 2px var(--accent);
  }
  .tl-time {
    position: absolute; left: -112px; top: 12px; width: 70px; text-align: right;
    font-size: 12px; font-weight: 700; color: var(--primary);
  }
  .tl-detail { font-size: 12px; color: var(--text-light); margin-top: 3px; }

  /* Network topology */
  .net-topo { display: flex; flex-direction: column; align-items: center; gap: 0; margin: 20px 0; }
  .net-row { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .net-node {
    padding: 10px 18px; border-radius: 10px; font-size: 12px; font-weight: 700;
    text-align: center; border: 2px solid var(--primary); background: var(--card-bg);
  }
  .net-node.hub { background: var(--primary); color: white; border-color: var(--primary); padding: 14px 24px; }
  .net-link-v { width: 2px; height: 24px; background: var(--primary); }
  .net-link-h { width: 30px; height: 2px; background: var(--primary); }
  .net-link-label { font-size: 10px; color: var(--text-light); text-align: center; }

  /* Print */
  @media print {
    .sidebar, .top-bar { display: none; }
    .content { margin-left: 0; margin-top: 0; max-width: 100%; }
    .hero { background: var(--primary) !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    h2 { page-break-before: always; }
    table, pre, .flow, .hflow, .svg-wrap, .dep-tree, .timeline { page-break-inside: avoid; }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .sidebar { display: none; }
    .content { margin-left: 0; padding: 20px; }
  }

  /* ===== ParamDef Section Styles ===== */
  .pd-tree { margin: 12px 0 16px; }
  .pd-node { position: relative; margin-left: 0; }
  .pd-node .pd-node { margin-left: 24px; }
  .pd-node .pd-node .pd-node { margin-left: 24px; }
  .pd-node .pd-node::before {
    content: ''; position: absolute; left: -16px; top: 0; bottom: 0;
    width: 1px; background: #cbd5e1;
  }
  .pd-node .pd-node::after {
    content: ''; position: absolute; left: -16px; top: 18px;
    width: 12px; height: 1px; background: #cbd5e1;
  }
  .pd-node .pd-node:last-child::before { height: 18px; }
  .pd-header {
    display: flex; align-items: center; gap: 8px; padding: 7px 12px;
    cursor: pointer; border-radius: 6px; transition: all 0.15s;
    border: 1px solid transparent; user-select: none; flex-wrap: wrap;
  }
  .pd-header:hover { background: #eef3f8; border-color: #d1d9e6; }
  .pd-header.active { background: #e8f0fe; border-color: #93b4e8; }
  .pd-toggle {
    width: 18px; height: 18px; display: flex; align-items: center; justify-content: center;
    font-size: 0.65rem; color: #64748b; transition: transform 0.2s;
    background: #f1f5f9; border-radius: 3px; flex-shrink: 0;
  }
  .pd-header.active .pd-toggle { transform: rotate(90deg); color: #0f3460; }
  .pd-header.leaf .pd-toggle { visibility: hidden; }
  .pd-icon {
    width: 22px; height: 22px; border-radius: 4px; display: flex;
    align-items: center; justify-content: center; font-size: 0.7rem;
    font-weight: 700; color: #fff; flex-shrink: 0;
  }
  .pd-icon.root { background: #0f3460; }
  .pd-icon.container { background: #e67e22; }
  .pd-icon.sub { background: #64748b; }
  .pd-icon.param { background: #2980b9; font-size: 0.6rem; }
  .pd-icon.ref { background: #c0392b; font-size: 0.6rem; }
  .pd-name { font-weight: 600; color: #0f3460; font-size: 0.88rem; }
  .pd-mult {
    background: #e2e8f0; color: #475569; padding: 1px 7px;
    border-radius: 3px; font-size: 0.68rem; font-weight: 600; white-space: nowrap;
  }
  .pd-brief { color: #64748b; font-size: 0.8rem; }
  .pd-count {
    background: #dbeafe; color: #1e40af; padding: 1px 6px;
    border-radius: 3px; font-size: 0.65rem; font-weight: 600; white-space: nowrap;
  }
  .pd-body {
    display: none; margin: 2px 0 8px 42px; padding: 12px 16px;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  }
  .pd-body.open { display: block; }
  .pd-section-title {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px;
    color: #94a3b8; font-weight: 700; margin: 10px 0 6px; padding-top: 8px;
    border-top: 1px solid #f1f5f9;
  }
  .pd-section-title:first-child { border-top: none; padding-top: 0; margin-top: 0; }
  .pd-param {
    display: grid; grid-template-columns: minmax(200px,1.5fr) auto auto auto auto 2fr;
    gap: 6px 10px; padding: 6px 8px; border-radius: 4px; font-size: 0.82rem;
    align-items: center;
  }
  .pd-param:nth-child(even) { background: #f8fafc; }
  .pd-param:hover { background: #eef3f8; }
  .pd-param .pn { font-weight: 600; color: #0f3460; word-break: break-all; }
  .pd-param .pm { color: #64748b; font-size: 0.78rem; white-space: nowrap; }
  .pd-param .pr { color: #475569; font-size: 0.78rem; white-space: nowrap; }
  .pd-param .pdef { color: #475569; font-size: 0.78rem; white-space: nowrap; }
  .pd-param .pdesc { color: #64748b; font-size: 0.78rem; }
  .pd-ref {
    display: grid; grid-template-columns: minmax(200px,1.5fr) auto auto auto 2fr;
    gap: 6px 10px; padding: 6px 8px; border-radius: 4px; font-size: 0.82rem;
    align-items: center;
  }
  .pd-ref:nth-child(even) { background: #fef5f5; }
  .pd-ref:hover { background: #fdeaea; }
  .pd-ref .pn { font-weight: 600; color: #c0392b; word-break: break-all; }
  .pd-hdr {
    display: grid; gap: 6px 10px; padding: 4px 8px; font-size: 0.7rem;
    font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;
  }
  .pd-hdr.param-hdr { grid-template-columns: minmax(200px,1.5fr) auto auto auto auto 2fr; }
  .pd-hdr.ref-hdr { grid-template-columns: minmax(200px,1.5fr) auto auto auto 2fr; }
  .pd-desc {
    font-size: 0.85rem; color: #475569; margin-bottom: 10px;
    padding: 8px 12px; background: #f8fafc; border-radius: 4px;
    border-left: 3px solid #e67e22;
  }
  .pd-note {
    font-size: 0.8rem; color: #1e40af; background: #eff6ff;
    border: 1px solid #bfdbfe; border-radius: 4px; padding: 6px 10px; margin: 6px 0;
  }
  .pd-children { margin-top: 2px; }
  .pd-children.hidden { display: none; }
  .module-desc-box {
    font-size: 0.92rem; color: #475569; margin-bottom: 16px;
    padding: 12px 16px; background: #f8fafc; border-radius: 6px;
    border-left: 3px solid #e67e22;
  }
  .type-badge {
    display: inline-block; padding: 1px 8px; border-radius: 4px;
    font-size: 0.72rem; font-weight: 700; color: #fff;
  }
  .type-int { background: #2980b9; }
  .type-bool { background: #27ae60; }
  .type-float { background: #8e44ad; }
  .type-enum { background: #d35400; }
  .type-str { background: #16a085; }
  .type-ref { background: #c0392b; }
  .type-func { background: #2c3e50; }
  .explain-box {
    background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px;
    padding: 12px 16px; margin: 12px 0; font-size: 0.88rem;
  }
  .explain-box .title { font-weight: 700; color: #1e40af; margin-bottom: 4px; }
  .warn-box {
    background: #fff7ed; border: 1px solid #fed7aa; border-radius: 6px;
    padding: 12px 16px; margin: 12px 0; font-size: 0.88rem;
  }
  .warn-box .title { font-weight: 700; color: #c2410c; margin-bottom: 4px; }
  @media (max-width: 900px) {
    .pd-param, .pd-ref { grid-template-columns: 1fr; }
    .pd-hdr { display: none; }
  }

  /* Collapsible details */
  details {
      margin: 12px 0;
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
  }

  details summary {
      padding: 12px 16px;
      background: #f0f3f5;
      cursor: pointer;
      font-weight: 600;
      font-size: 14px;
      user-select: none;
      list-style: none;
  }

  details summary::before {
      content: '\25B6  ';
      font-size: 10px;
      transition: transform 0.2s;
      display: inline-block;
  }

  details[open] summary::before {
      transform: rotate(90deg);
  }

  details summary:hover { background: #e4eaf0; }

  details > .details-content {
      padding: 20px;
  }

  /* Info boxes */
  .info-box {
      padding: 16px 20px;
      border-radius: 8px;
      margin: 16px 0;
      border-left: 4px solid;
  }

  .info-box.note {
      background: #eef6ff;
      border-color: var(--info);
  }

  .info-box.important {
      background: #fff8e6;
      border-color: var(--warning);
  }

  .info-box.warning {
      background: #ffeef0;
      border-color: var(--danger);
  }

  .info-box.tip {
      background: #eefff4;
      border-color: var(--success);
  }

  .info-box .box-title {
      font-weight: 700;
      margin-bottom: 4px;
      font-size: 0.9rem;
  }

  .file-ref {
      display: inline-block;
      background: #f0f6ff;
      border: 1px solid #c8d6e5;
      border-radius: 4px;
      padding: 2px 8px;
      font-family: 'Consolas', monospace;
      font-size: 0.85rem;
      color: #2d3436;
  }

  /* Interactive Architecture Diagram */
  @keyframes pulse-glow {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
  }

  .arch-interactive-html .module-box-html {
      cursor: pointer;
      transition: transform 0.3s ease, filter 0.3s ease, opacity 0.3s ease, box-shadow 0.3s ease;
  }

  .arch-interactive-html .module-box-html:hover {
      filter: brightness(1.1);
      transform: scale(1.05);
  }

  .arch-interactive-html .module-box-html.active {
      box-shadow: 0 0 12px rgba(59, 130, 246, 0.7) !important;
  }

  .arch-interactive-html .module-box-html.dimmed {
      opacity: 0.25;
  }

  .arch-interactive-html .module-box-html.connected {
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.6) !important;
      animation: pulse-glow 1.5s ease-in-out infinite;
  }

  .arch-interactive-html .layer-label {
      transition: opacity 0.3s ease;
  }

  .arch-interactive-html .layer-label.dimmed {
      opacity: 0.3;
  }

  /* SVG-based interactive architecture (reused across files) */
  @keyframes dash-flow {
      to { stroke-dashoffset: -20; }
  }

  .arch-interactive .module-box {
      cursor: pointer;
      transition: transform 0.3s ease, filter 0.3s ease;
  }

  .arch-interactive .module-box:hover {
      filter: brightness(1.1);
  }

  .arch-interactive .module-box.active {
      filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));
  }

  .arch-interactive .conn-path {
      transition: opacity 0.3s ease, stroke-width 0.3s ease;
  }

  .arch-interactive .conn-path.dimmed {
      opacity: 0.1;
  }

  .arch-interactive .conn-path.highlighted {
      stroke: #3b82f6 !important;
      stroke-width: 3 !important;
      stroke-dasharray: 8, 4 !important;
      animation: dash-flow 0.6s linear infinite;
      filter: drop-shadow(0 0 4px rgba(59, 130, 246, 0.5));
  }

  .arch-interactive .conn-label {
      transition: opacity 0.3s ease, font-weight 0.3s ease;
  }

  .arch-interactive .conn-label.dimmed {
      opacity: 0.15;
  }

  .arch-interactive .conn-label.highlighted {
      fill: #1e40af !important;
      font-weight: 700 !important;
      font-size: 10px !important;
  }

  .arch-interactive .module-box.dimmed {
      opacity: 0.25;
      transition: opacity 0.3s ease;
  }

  .arch-interactive .module-box.connected {
      filter: drop-shadow(0 0 6px rgba(34, 197, 94, 0.5));
      animation: pulse-glow 1.5s ease-in-out infinite;
  }

  /* ── Runnable popup styles ── */
  .runnable-link { cursor: pointer; border-bottom: 1.5px dashed #3b82f6; transition: background 0.2s, color 0.2s; }
  .runnable-link:hover { background: #dbeafe; color: #1e40af; }
  .runnable-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 10000; justify-content: center; align-items: center; }
  .runnable-overlay.active { display: flex; }
  .runnable-popup { background: #fff; border-radius: 10px; box-shadow: 0 8px 32px rgba(0,0,0,0.25); max-width: 680px; width: 92vw; max-height: 82vh; overflow-y: auto; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; animation: runnablePopIn 0.2s ease-out; }
  @keyframes runnablePopIn { from { transform: scale(0.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .runnable-popup-header { background: linear-gradient(135deg, #1e3a5f 0%, #1a56db 100%); color: #fff; padding: 16px 22px 14px; border-radius: 10px 10px 0 0; display: flex; justify-content: space-between; align-items: flex-start; }
  .runnable-popup-header h3 { margin: 0; font-size: 16px; font-weight: 700; word-break: break-all; }
  .runnable-popup-header .popup-close { background: none; border: none; color: #fff; font-size: 22px; cursor: pointer; line-height: 1; padding: 0 0 0 12px; opacity: 0.8; }
  .runnable-popup-header .popup-close:hover { opacity: 1; }
  .runnable-popup-body { padding: 18px 22px 22px; }
  .runnable-popup-body table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .runnable-popup-body th { text-align: left; padding: 7px 10px; background: #f0f4ff; color: #1e3a5f; font-weight: 600; border-bottom: 1px solid #e2e8f0; white-space: nowrap; width: 160px; vertical-align: top; }
  .runnable-popup-body td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: top; }
  .runnable-popup-body td code { background: #f1f5f9; padding: 1px 5px; border-radius: 3px; font-size: 12px; }
  .runnable-popup-body .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; margin: 1px 2px; }
  .badge-timing { background: #dbeafe; color: #1e40af; }
  .badge-datarcv { background: #dcfce7; color: #166534; }
  .badge-server { background: #fef3c7; color: #92400e; }
  .badge-mode { background: #f3e8ff; color: #6b21a8; }
  .badge-init { background: #e0e7ff; color: #3730a3; }
  .badge-opinvoke { background: #ffe4e6; color: #9f1239; }
  .runnable-popup-body ul { margin: 2px 0; padding-left: 18px; }
  .runnable-popup-body ul li { margin: 2px 0; font-size: 12.5px; }

  /* ── Animated SVG Diagram Styles ── */
  @keyframes stepFadeSlideIn {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes arrowPulse {
      0%, 100% { opacity: 0.4; }
      50%      { opacity: 1; }
  }
  @keyframes stateGlow {
      0%, 100% { filter: drop-shadow(0 0 0px transparent); }
      50%      { filter: drop-shadow(0 0 6px rgba(59,130,246,0.35)); }
  }
  @keyframes marchingAnts {
      to { stroke-dashoffset: -16; }
  }
  @keyframes fieldShimmer {
      0%   { opacity: 0.6; transform: scaleX(0.92); }
      100% { opacity: 1;   transform: scaleX(1); }
  }
  @keyframes starEntrance {
      from { opacity: 0; transform: scale(0.85); }
      to   { opacity: 1; transform: scale(1); }
  }
  @keyframes lineDrawIn {
      from { stroke-dashoffset: 200; }
      to   { stroke-dashoffset: 0; }
  }
  /* Workflow step click-to-code styles */
  .wf-step { cursor: pointer; }
  .wf-step:hover rect { filter: brightness(0.92); stroke-width: 2.5; }
  .wf-step:hover text { fill: #1a5276 !important; }
  .wf-popup-code { background: #1e293b; color: #e2e8f0; padding: 14px 16px; border-radius: 6px; font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace; font-size: 12px; line-height: 1.6; overflow-x: auto; margin: 8px 0 4px; white-space: pre; }
  .wf-popup-code .cmt { color: #64748b; }
  .wf-popup-code .kw { color: #7dd3fc; }
  .wf-popup-code .str { color: #86efac; }
  .wf-popup-code .fn { color: #fbbf24; }
  .wf-popup-files { display: flex; flex-wrap: wrap; gap: 4px; margin: 4px 0; }
  .wf-popup-files span { background: #f0f4ff; border: 1px solid #c7d2fe; color: #3730a3; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-family: monospace; }
</style>
</head>
