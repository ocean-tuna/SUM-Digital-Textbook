                  <div class="pd-param"><span class="pn">LNM_Network_ID</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">1&ndash;16</span><span class="pdef">1</span><span class="pdesc">Network ID (1-16). Needed for F1BE DID.</span></div>
                  <div class="pd-param"><span class="pn">LNM_MSCL_Strategy</span><span class="type-badge type-enum">ENUM</span><span class="pm">1..1</span><span class="pr">Calibration, Evaluation</span><span class="pdef">Calibration</span><span class="pdesc">Strategy used for MSCL.</span></div>
                  <div class="pd-param"><span class="pn">LNM_ChannelEnable_InitValue</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Init value for calibration parameter enabling MSCL execution.</span></div>
                  <div class="pd-param"><span class="pn">LNM_ActivationSignalType</span><span class="type-badge type-enum">ENUM</span><span class="pm">0..1</span><span class="pr">SWC, Com, Rule</span><span class="pdef">SWC</span><span class="pdesc">Source of the activation signal.</span></div>
                  <div class="pd-param"><span class="pn">LNM_ActivationMask</span><span class="type-badge type-int">INT</span><span class="pm">0..1</span><span class="pr">0&ndash;255</span><span class="pdef">&mdash;</span><span class="pdesc">Bit mask for channel activation.</span></div>
                  <div class="pd-param"><span class="pn">LNM_DeactivationMask</span><span class="type-badge type-int">INT</span><span class="pm">0..1</span><span class="pr">0&ndash;255</span><span class="pdef">&mdash;</span><span class="pdesc">Bit mask for channel deactivation.</span></div>
                  <div class="pd-param"><span class="pn">LNM_C_DTC_LINBusOff</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">Enable DTC for LIN Bus off.</span></div>
                  <div class="pd-param"><span class="pn">LNM_C_PreSleepDelay</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;4000</span><span class="pdef">25</span><span class="pdesc">Delay in ms before transition to NULL schedule when SLEEP issued.</span></div>
                  <div class="pd-section-title">References</div>
                  <div class="pd-hdr ref-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Target</span><span>Description</span></div>
                  <div class="pd-ref"><span class="pn">Sum_LNM_LinSMNetworkId_ref</span><span class="type-badge type-ref">REF</span><span class="pm">0..1</span><span class="pr">LinSM &rarr; LinSMChannel</span><span class="pdesc">Reference to the unique LIN network index.</span></div>
                  <div class="pd-ref"><span class="pn">Sum_LNM_Rule_ref</span><span class="type-badge type-ref">REF</span><span class="pm">0..1</span><span class="pr">LNM_Rule</span><span class="pdesc">Reference to the activation rule.</span></div>
                </div>
                <div class="pd-children hidden">
                  <div class="pd-node">
                    <div class="pd-header" onclick="toggleTree(this)">
                      <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">LNM_Responders</span><span class="pd-mult">1..*</span><span class="pd-count">10 params</span>
                    </div>
                    <div class="pd-body">
                      <div class="pd-desc">Configuration of LIN Responder devices. Handles MSCL, DTC, and IEF settings per responder.</div>
                      <div class="pd-section-title">Parameters</div>
                      <div class="pd-hdr param-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Description</span></div>
                      <div class="pd-param"><span class="pn">LNM_MSCL_ByteIndex</span><span class="type-badge type-enum">ENUM</span><span class="pm">1..1</span><span class="pr">MSCL_BYTE_1/2</span><span class="pdef">MSCL_BYTE_1</span><span class="pdesc">MSCL byte related to this Responder.</span></div>
                      <div class="pd-param"><span class="pn">LNM_MSCL_BitIndex</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;7</span><span class="pdef">0</span><span class="pdesc">Bit index in the MSCL byte.</span></div>
                      <div class="pd-param"><span class="pn">LNM_C_ResponderPresent_InitValue</span><span class="type-badge type-bool">BOOL</span><span class="pm">0..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Init value for MSCL via Calibration.</span></div>
                      <div class="pd-param"><span class="pn">LNM_LossOfComm_withDevice_Timer</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">0</span><span class="pdesc">Timer for ERRH debouncing of Lost Communication.</span></div>
                      <div class="pd-param"><span class="pn">LNM_Internal_Electronic_Failure_Supported</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">Enable IEF DTC for this Responder.</span></div>
                      <div class="pd-param"><span class="pn">LNM_IEF_APINFO2_Supported</span><span class="type-badge type-bool">BOOL</span><span class="pm">0..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">Enable APINFO2 (Reset Status) for IEF.</span></div>
                      <div class="pd-param"><span class="pn">LNM_IEF_Reset_Threshold</span><span class="type-badge type-int">INT</span><span class="pm">0..1</span><span class="pr">1&ndash;255</span><span class="pdef">3</span><span class="pdesc">Reset notification threshold before setting IEF DTC.</span></div>
                      <div class="pd-param"><span class="pn">LNM_IEF_APINFO4_Supported</span><span class="type-badge type-bool">BOOL</span><span class="pm">0..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">Enable APINFO4 (Application Status) for IEF.</span></div>
                      <div class="pd-param"><span class="pn">LNM_Responder_Device_Not_Configured_Supported</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">Enable Device Not Configured DTC.</span></div>
                      <div class="pd-param"><span class="pn">LNM_Config_Retries</span><span class="type-badge type-int">INT</span><span class="pm">0..1</span><span class="pr">0&ndash;7</span><span class="pdef">3</span><span class="pdesc">Config retries before Device Not Configured DTC.</span></div>
                    </div>
                  </div>
                  <div class="pd-node">
                    <div class="pd-header" onclick="toggleTree(this)">
                      <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">LNM_ScheduleManagement</span><span class="pd-mult">0..1</span>
                    </div>
                    <div class="pd-children hidden">
                      <div class="pd-node">
                        <div class="pd-header" onclick="toggleTree(this)">
                          <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">LNM_ScheduleState</span><span class="pd-mult">0..*</span><span class="pd-count">1 ref</span>
                        </div>
                        <div class="pd-body">
                          <div class="pd-desc">Configuration of a schedule state. Each state references a LinSM schedule.</div>
                          <div class="pd-section-title">References</div>
                          <div class="pd-hdr ref-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Target</span><span>Description</span></div>
                          <div class="pd-ref"><span class="pn">LNM_ScheduleRef</span><span class="type-badge type-ref">CHOICE-REF</span><span class="pm">0..1</span><span class="pr">LinSM &rarr; LinSMSchedule</span><span class="pdesc">Reference to LinSM schedule for this state.</span></div>
                        </div>
                      </div>
                      <div class="pd-node">
                        <div class="pd-header" onclick="toggleTree(this)">
                          <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">LNM_ScheduleTransition</span><span class="pd-mult">0..*</span><span class="pd-count">3 refs</span>
                        </div>
                        <div class="pd-body">
                          <div class="pd-desc">Defines a state transition between schedule states, linking start/end states to a rule.</div>
                          <div class="pd-section-title">References</div>
                          <div class="pd-hdr ref-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Target</span><span>Description</span></div>
                          <div class="pd-ref"><span class="pn">LNM_StartStateRef</span><span class="type-badge type-ref">CHOICE-REF</span><span class="pm">1..1</span><span class="pr">ScheduleState / StartState / SleepState</span><span class="pdesc">Starting state of the transition.</span></div>
                          <div class="pd-ref"><span class="pn">LNM_EndStateRef</span><span class="type-badge type-ref">CHOICE-REF</span><span class="pm">1..1</span><span class="pr">ScheduleState / StartState / SleepState</span><span class="pdesc">End state of the transition.</span></div>
                          <div class="pd-ref"><span class="pn">LNM_TransitionRuleRef</span><span class="type-badge type-ref">REF</span><span class="pm">1..1</span><span class="pr">LNM_Rule</span><span class="pdesc">Rule that triggers this transition.</span></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="explain-box">
      <div class="title">How LNM ParamDef    <div class="explain-box">
      <div class="title">How LNM ParamDef works with the module</div>
      LNM (LIN Network Manager) manages LIN bus networks with a layered configuration:
      <br><br>
      <strong>1. Inputs &rarr; Conditions &rarr; Rules</strong>: Schedule signals (from SWC, COM, or VPM) serve as inputs. Conditions compare inputs against values using operators (==, !=, &lt;, &gt;). Rules combine conditions with AND/OR logic.
      <br><br>
      <strong>2. Networks &rarr; Schedule States &rarr; Transitions</strong>: Each LIN network has its own schedule state machine. Transitions between states are triggered by Rules. States reference LinSM schedules.
      <br><br>
      <strong>3. Responders</strong>: Each network has LIN responder devices with MSCL (Master Schedule Control List) bit assignments, DTC configurations for loss-of-communication, and Internal Electronic Failure monitoring.
      <br><br>
      The wakeup delays (Commander/Responder) control timing when transitioning from sleep. The MSCL strategy (Calibration vs Evaluation) determines how responder presence is managed.
    </div>
  </div>
</div>
</section>

<!-- ==================== SOH ==================== -->
<section id="mod-soh" class="module-section">
<div class="module-card">
  <div class="module-header" onclick="toggleModule(this)">
    <div style="display:flex;align-items:center;gap:12px">
      <span class="badge">SOH</span>
      <h2>State of Health</h2>
    </div>
    <span class="arrow">&#9654;</span>
  </div>
  <div class="module-body">
    <div class="module-desc-box">
      <strong>SOH</strong> monitors the "state of health" of ECU subsystems and communication interfaces.
      It is the largest SUM ParamDef (182KB arxml, 33 containers, 66 params, 52 refs), reflecting its extensive monitoring across
      resets, NvM, OS errors, communications, watchdog supervision, and platform shutdown.
    </div>

    <div class="pd-tree">
      <div class="pd-node">
        <div class="pd-header" onclick="toggleTree(this)">
          <span class="pd-toggle">&#9654;</span><span class="pd-icon root">M</span><span class="pd-name">SOH</span><span class="pd-mult">0..1</span>
          <span class="pd-brief">&mdash; State of Health (66 params, 52 refs, 33 containers)</span>
        </div>
        <div class="pd-children hidden">

          <!-- SOHGeneral -->
          <div class="pd-node">
            <div class="pd-header" onclick="toggleTree(this)">
              <span class="pd-toggle">&#9654;</span><span class="pd-icon container">C</span><span class="pd-name">SOHGeneral</span><span class="pd-mult">1..1</span><span class="pd-count">5 params + 21 flags</span><span class="pd-count">2 refs</span>
            </div>
            <div class="pd-body">
              <div class="pd-desc">General configuration: runnable periodicities, permit execution mask, initialization mode, and 21 boolean flags to enable/disable individual detector classes.</div>
              <div class="pd-section-title">Parameters</div>
              <div class="pd-hdr param-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Description</span></div>
              <div class="pd-param"><span class="pn">SOH_RunnableSOHMainPeriod</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">0.001&ndash;0.2 s</span><span class="pdef">0.1</span><span class="pdesc">Periodicity of Runnable_SOH_Main.</span></div>
              <div class="pd-param"><span class="pn">SOH_RunnableSOHTimingPeriod</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">0.001&ndash;0.2 s</span><span class="pdef">0.1</span><span class="pdesc">Periodicity of Runnable_SOH_Timing.</span></div>
              <div class="pd-param"><span class="pn">SOH_PermitExecution_Mask</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;255</span><span class="pdef">190</span><span class="pdesc">PermitExecution bitmask for SOH startup control.</span></div>
              <div class="pd-param"><span class="pn">SohGenerateInitRunnable</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">When TRUE, generates periodic runnable for init().</span></div>
              <div class="pd-param"><span class="pn">SohInitFuncPeriodicity</span><span class="type-badge type-float">FLOAT</span><span class="pm">0..1</span><span class="pr">1&ndash;5000 ms</span><span class="pdef">1000</span><span class="pdesc">Periodicity of Runnable_SOH_Init.</span></div>
              <div class="pd-section-title">Detector Enable Flags (all BOOL, default: true)</div>
              <div class="pd-hdr param-hdr"><span>Flag</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Enables</span></div>
              <div class="pd-param"><span class="pn">SOH_StatNvM_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">NvM Status class detector</span></div>
              <div class="pd-param"><span class="pn">SOH_ActNvM_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">NvM Action class detector</span></div>
              <div class="pd-param"><span class="pn">SOH_PrivNvM_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">NvM Privilege class detector</span></div>
              <div class="pd-param"><span class="pn">SOH_ExcepOS_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">OS HW Protection Exceptions</span></div>
              <div class="pd-param"><span class="pn">SOH_ServOS_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">OS Service/Trusted Function Protection</span></div>
              <div class="pd-param"><span class="pn">SOH_StackOS_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">OS Stack Fault detector</span></div>
              <div class="pd-param"><span class="pn">SOH_MemProtOS_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">OS Memory Protection detector</span></div>
              <div class="pd-param"><span class="pn">SOH_TimeProtOS_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">OS Time Protection detector</span></div>
              <div class="pd-param"><span class="pn">SOH_ErrOS_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Other OS Errors detector</span></div>
              <div class="pd-param"><span class="pn">SOH_ImmediateDelayed_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Immediate &amp; Delayed Reset detectors</span></div>
              <div class="pd-param"><span class="pn">SOH_DiagnosticReset_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Diagnostic Reset detector</span></div>
              <div class="pd-param"><span class="pn">SOH_ClearDiagnosticInformation_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Clear Diagnostic Info detectors</span></div>
              <div class="pd-param"><span class="pn">SOH_DiagnosticSessionControl_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Diagnostic Session Control detectors</span></div>
              <div class="pd-param"><span class="pn">SOH_MACFailures_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">MAC Failures Types 1/2/3 detectors</span></div>
              <div class="pd-param"><span class="pn">SOH_SecurityAccessFailures_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">SecurityAccess (0x27) Failures detector</span></div>
              <div class="pd-param"><span class="pn">SOH_SecPErrors_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">SecP Errors detector</span></div>
              <div class="pd-param"><span class="pn">SOH_LocalSupervisionFailures_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">WdgM Local Supervision Failures</span></div>
              <div class="pd-param"><span class="pn">SOH_WdgMDEMSupervisionErrors_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">WdgM DEM Supervision Errors</span></div>
              <div class="pd-param"><span class="pn">SOH_ERRHLocalSupervision_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">ERRH Local Supervision from SOH side</span></div>
              <div class="pd-param"><span class="pn">ERRH_SOHLocalSupervision_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">SOH Local Supervision from ERRH side</span></div>
              <div class="pd-param"><span class="pn">SOH_ShutdownDelay_SupportEnabled</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Shutdown delay detector in Platform monitor</span></div>
              <div class="pd-section-title">References</div>
              <div class="pd-hdr ref-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Target</span><span>Description</span></div>
              <div class="pd-ref"><span class="pn">SOH_RID_02C0_SOH_Clear_Log_Reference</span><span class="type-badge type-ref">REF</span><span class="pm">1..1</span><span class="pr">DcmDspRoutine</span><span class="pdesc">RID 02C0 routine for clearing SOH log.</span></div>
              <div class="pd-ref"><span class="pn">SOH_OsCounterRef</span><span class="type-badge type-ref">REF</span><span class="pm">1..1</span><span class="pr">OsCounter</span><span class="pdesc">SOH specific OS counter reference.</span></div>
            </div>
          </div>

          <!-- SOHConfigSet -->
          <div class="pd-node">
            <div class="pd-header" onclick="toggleTree(this)">
              <span class="pd-toggle">&#9654;</span><span class="pd-icon container">C</span><span class="pd-name">SOHConfigSet</span><span class="pd-mult">1..1</span>
              <span class="pd-brief">&mdash; 5 Reliability Monitor sub-containers</span>
            </div>
            <div class="pd-body">
              <div class="pd-desc">Contains 5 Reliability Monitor sub-containers. Each monitor groups related detectors following a consistent pattern:</div>
              <div class="pd-note"><strong>Detector Pattern</strong> (repeated ~20 times):<br>&bull; <span class="type-badge type-int">INT</span> Thresh_Init &mdash; fault threshold counter init (def: 1, 0&ndash;65535)<br>&bull; <span class="type-badge type-int">INT</span> TW_Thresh_Init &mdash; time window threshold in seconds (def: 3600, 0&ndash;16777215)<br>&nbsp;&nbsp;&nbsp;&nbsp;<em>Variations:</em> MACfailTenAct TW def=2; WdgM TW def=10; MACfail/ReplayCount/SecP TW max=65535<br>&bull; <span class="type-badge type-ref">REF</span> NvM block reference &mdash; persistent storage<br>&bull; <span class="type-badge type-ref">REF</span> DcmDspData DID reference &mdash; diagnostic readout (F08F/F090/F091/F092/F093)</div>
            </div>
            <div class="pd-children hidden">
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SOH_ResetReliabilityMonitor</span><span class="pd-mult">1..1</span><span class="pd-count">3 detectors</span>
                </div>
                <div class="pd-body">
                  <div class="pd-desc">Monitors ECU reset patterns for reliability.</div>
                  <div class="pd-section-title">Detectors (DID F08F)</div>
                  <div class="pd-hdr param-hdr"><span>Detector</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Details</span></div>
                  <div class="pd-param"><span class="pn">SOH_ImmediateReset</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Thresh_Init=1, TW=3600. NvM + DcmDspData refs.</span></div>
                  <div class="pd-param"><span class="pn">SOH_DelayedReset</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Thresh_Init=1, TW=3600. NvM + DcmDspData refs.</span></div>
                  <div class="pd-param"><span class="pn">SOH_DiagnosticReset</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Thresh_Init=1. 2 NvM refs (counter + DID) + DcmDspData ref.</span></div>
                </div>
              </div>
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SOH_MemoryStatusReliabilityMonitor</span><span class="pd-mult">1..1</span><span class="pd-count">2 sub-groups</span>
                </div>
                <div class="pd-body">
                  <div class="pd-desc">Monitors NvM and OS error patterns. DID F090.</div>
                  <div class="pd-section-title">Detectors</div>
                  <div class="pd-hdr param-hdr"><span>Sub-group</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Detectors</span></div>
                  <div class="pd-param"><span class="pn">NVMErrorsDetector</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">&mdash;</span><span class="pdesc">SOH_StatusNVM, SOH_ActionNVM, SOH_PrivilegeNVM (each Thresh + TW + NvM + DcmDspData)</span></div>
                  <div class="pd-param"><span class="pn">OSErrorsDetector</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">&mdash;</span><span class="pdesc">SOH_ExcepOS, ServOS, StackOS, MemProtOS, TimeProtOS, ErrOS (same pattern &times;6)</span></div>
                </div>
              </div>
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SOH_CommunicationReliabilityMonitor</span><span class="pd-mult">1..1</span><span class="pd-count">8 detectors</span>
                </div>
                <div class="pd-body">
                  <div class="pd-desc">Monitors diagnostic communication health. DID F092.</div>
                  <div class="pd-section-title">Detectors</div>
                  <div class="pd-hdr param-hdr"><span>Detector</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Notes</span></div>
                  <div class="pd-param"><span class="pn">SOH_ClearDiagInfo</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Thresh_Init only (no TW).</span></div>
                  <div class="pd-param"><span class="pn">SOH_RejectClearDiag</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Thresh_Init only.</span></div>
                  <div class="pd-param"><span class="pn">SOH_DiagSession</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">2 NvM refs (counter + DID).</span></div>
                  <div class="pd-param"><span class="pn">SOH_Accept_DiagSession</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">2 NvM refs (counter + DID).</span></div>
                  <div class="pd-param"><span class="pn">SOH_SecurityAccess</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">SecurityAccess (0x27) Failures. 2 NvM refs.</span></div>
                  <div class="pd-param"><span class="pn">SOH_MACfailTenAct</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">MAC Failures Types 1&amp;2. TW def=2.</span></div>
                  <div class="pd-param"><span class="pn">SOH_ReplayCount</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">3 INTs: Thresh=1, TW=3600, Start_Thresh=5 (max:255).</span></div>
                  <div class="pd-param"><span class="pn">SOH_SecP</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Standard Thresh + TW pattern.</span></div>
                </div>
              </div>
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SOH_WatchdogManagerReliabilityMonitor</span><span class="pd-mult">1..1</span><span class="pd-count">3 detectors</span>
                </div>
                <div class="pd-body">
                  <div class="pd-desc">Monitors WdgM supervision status. DID F093.</div>
                  <div class="pd-section-title">Detectors</div>
                  <div class="pd-hdr param-hdr"><span>Detector</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Notes</span></div>
                  <div class="pd-param"><span class="pn">Local_Supervision_Failures_Detector</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Standard + Supervised_Entity_Reference (0..*, WdgMSupervisedEntity).</span></div>
                  <div class="pd-param"><span class="pn">WdgM_DEM_Supervision_Errors_Detector</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Standard Thresh + TW pattern.</span></div>
                  <div class="pd-param"><span class="pn">SUM_ERRH_Local_Supervision_Detector</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Standard + extra DcmDspData ref for ERRH Local Supervision.</span></div>
                </div>
              </div>
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SOH_PlatformReliabilityMonitor</span><span class="pd-mult">1..1</span><span class="pd-count">1 detector</span>
                </div>
                <div class="pd-body">
                  <div class="pd-desc">Monitors platform-level reliability events. DID F091.</div>
                  <div class="pd-section-title">Detectors</div>
                  <div class="pd-hdr param-hdr"><span>Detector</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Details</span></div>
                  <div class="pd-param"><span class="pn">SOH_Shutdown</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;65535</span><span class="pdef">1</span><span class="pdesc">Thresh=1, Timer_Thresh=60 (max:65535). 2 NvM refs + DcmDspData ref.</span></div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="explain-box">
      <div class="title">How SOH ParamDef    <div class="explain-box">
      <div class="title">How SOH ParamDef works with the module</div>
      SOH's paramdef is built around a <strong>Reliability Monitor</strong> architecture with 5 monitor categories:
      <ul style="margin:8px 0 4px 18px">
        <li><strong>Reset Monitor</strong>: Tracks immediate, delayed, and diagnostic resets. Each detector counts occurrences within a time window (TW) and reports via DID F08F.</li>
        <li><strong>Memory Status Monitor</strong>: Tracks NvM errors (Status/Action/Privilege classes) and OS errors (6 OS error categories). Reports via DID F090.</li>
        <li><strong>Communication Monitor</strong>: Tracks diagnostic session activity, security access failures, MAC failures, replay attacks, and SecP errors. Reports via DID F092.</li>
        <li><strong>Watchdog Monitor</strong>: Tracks WdgM local supervision failures and DEM supervision errors, including ERRH-reported supervision status. Reports via DID F093.</li>
        <li><strong>Platform Monitor</strong>: Tracks shutdown delay patterns. Reports via DID F091.</li>
      </ul>
      The 21 <em>SupportEnabled</em> flags in SOHGeneral allow project-specific detector selection. Each detector's Thresh_Init and TW_Thresh_Init are calibratable, and NvM blocks ensure data persists across power cycles. This modular architecture lets integrators enable only the health monitoring relevant to their ECU.
    </div>
  </div>
</div>
</section>

<!-- ==================== SSFM ==================== -->
<section id="mod-ssfm" class="module-section">
<div class="module-card">
  <div class="module-header" onclick="toggleModule(this)">
    <div style="display:flex;align-items:center;gap:12px">
      <span class="badge">SSFM</span>
      <h2>Signal Status &amp; Fault Monitor</h2>
    </div>
    <span class="arrow">&#9654;</span>
  </div>
  <div class="module-body">
    <div class="module-desc-box">
      <strong>SSFM</strong> manages startup sequences, serial data monitoring, and error handling.
      It has two sub-modules: <strong>SSM</strong> (Startup/Shutdown Manager) and <strong>ERRH</strong> (Error Handler).
      The ParamDef is the second-largest in SUM (~40 containers, ~55 params, ~40 refs), reflecting the module's extensive serial data and error monitoring capabilities.
    </div>

    <div class="pd-tree">
      <div class="pd-node">
        <div class="pd-header" onclick="toggleTree(this)">
          <span class="pd-toggle">&#9654;</span><span class="pd-icon root">M</span><span class="pd-name">SSFM</span><span class="pd-mult">0..1</span>
          <span class="pd-brief">&mdash; Signal Status &amp; Fault Monitor (~40 containers, ~55 params, ~40 refs)</span>
        </div>
        <div class="pd-children hidden">

          <!-- Sum_Ssfm_General -->
          <div class="pd-node">
            <div class="pd-header" onclick="toggleTree(this)">
              <span class="pd-toggle">&#9654;</span><span class="pd-icon container">C</span><span class="pd-name">Sum_Ssfm_General</span><span class="pd-mult">1..1</span><span class="pd-count">15 params</span><span class="pd-count">3 refs</span>
            </div>
            <div class="pd-body">
              <div class="pd-desc">General configuration: periodicities for all runnables, permit execution masks (separate for SSM and ERRH), and feature flags.</div>
              <div class="pd-section-title">Parameters</div>
              <div class="pd-hdr param-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Description</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_SsmPermitExecutionMask</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;255</span><span class="pdef">254</span><span class="pdesc">PermitExecution mask for SSM sub-module.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_ErrhPermitExecutionMask</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">0&ndash;255</span><span class="pdef">254</span><span class="pdesc">PermitExecution mask for ERRH sub-module.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_ExecutionManagerPeriodicity</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">1&ndash;65535 ms</span><span class="pdef">100</span><span class="pdesc">Period of Main Function Runnables.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_DTCTriggeredRunnablePeriodicity</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">1&ndash;65535 ms</span><span class="pdef">100</span><span class="pdesc">Period of DTC Triggered Message Handler.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_KeySlotVerify_RunnablePeriodicity</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">1&ndash;65535 ms</span><span class="pdef">1.0</span><span class="pdesc">Period of KeySlotVerifyErrors runnable.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_NodeLossError_RunnablePeriodicity</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">1&ndash;65535 ms</span><span class="pdef">1.0</span><span class="pdesc">Period of NodeLossError runnable.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_MissingMsg_Periodicity</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">1&ndash;65535 ms</span><span class="pdef">100</span><span class="pdesc">Period of LIN Missing Message runnable.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_MissingMsg_CalibratableTime</span><span class="type-badge type-int">INT</span><span class="pm">1..1</span><span class="pr">1&ndash;65535 s</span><span class="pdef">5</span><span class="pdesc">Test enable timer for LIN missing message error.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_FxI_FxFA_SinglePortsSupport</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">Enable single-port indication for FxI/FxFA.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_IsThisECUGateway</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">false</span><span class="pdesc">Indicates ECU acts as a gateway.</span></div>
              <div class="pd-param"><span class="pn">Sum_Ssfm_DtcTriggerMessageSupport</span><span class="type-badge type-bool">BOOL</span><span class="pm">1..1</span><span class="pr">&mdash;</span><span class="pdef">true</span><span class="pdesc">Enables DTC Trigger Message function.</span></div>
