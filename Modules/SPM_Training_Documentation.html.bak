      ],
      readLocalVars: [],
      exclusiveAreas: [],
      description: "Power Manager cyclic runnable at 5ms. Manages target device power states (HW outputs, SoCs, remote nodes), evaluates wakeup bit assignments, monitors communication-ready mode from BswM, and controls the HB shutdown delay timer."
    },
    "RE_SPM_ActivateProfile": {
