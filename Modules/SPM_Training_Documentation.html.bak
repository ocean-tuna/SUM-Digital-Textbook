                  <div class="pd-ref"><span class="pn">LNM_InputRef</span><span class="type-badge type-ref">REF</span><span class="pm">1..1</span><span class="pr">LNM_ScheduleSignal</span><span class="pdesc">Reference to the input to compare.</span></div>
                </div>
              </div>
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">LNM_Rule</span><span class="pd-mult">0..*</span><span class="pd-count">1 param</span><span class="pd-count">1 ref</span><span class="pd-brief">&mdash; under LNM_Rules</span>
