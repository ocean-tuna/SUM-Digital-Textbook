  <rect x="16" y="91" width="26" height="26" rx="13" fill="#2563eb"/>
  <text x="29" y="109" text-anchor="middle" font-size="12" font-weight="700" fill="#fff">2</text>
  <text x="52" y="102" font-size="11" font-weight="700" fill="#1e40af">T=5ms &#8212; PGTT Step 1: TC10 Wakeup</text>
  <text x="52" y="118" font-size="10" fill="#2d3436">EthSM_RequestComMode(COMM_FULL_COMMUNICATION)</text>
  <line x1="310" y1="137" x2="310" y2="151" stroke="#94a3b8" stroke-width="2" marker-end="url(#spm_sw6_arr)"/>
