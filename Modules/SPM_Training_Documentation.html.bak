      description: "Operation-invoked runnable called by SrvcMgr to notify SPM about SD learning session status changes (PENDING / COMPLETED). Controls the Spm_Learning_Status inter-runnable variable which gates profile activation."
    }
  };

  var TRIGGER_BADGES = {
    timing:   '<span class="badge badge-timing">Timing Event</span>',
    init:     '<span class="badge badge-init">Init Event</span>',
    datarcv:  '<span class="badge badge-datarcv">Data-Received Event</span>',
    opinvoke: '<span class="badge badge-opinvoke">Operation-Invoked Event</span>',
    mode:     '<span class="badge badge-mode">Mode-Switch Event</span>',
    server:   '<span class="badge badge-server">Server-Call Event</span>'
  };

  function formatList(arr, tag) {
    if (!arr || arr.length === 0) return '<em style="color:#94a3b8">None</em>';
    tag = tag || 'code';
    return '<ul>' + arr.map(function(item) {
      return '<li><' + tag + '>' + item.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</' + tag + '></li>';
    }).join('') + '</ul>';
  }

  function buildPopupHTML(key, r) {
    var rows = '';
    rows += '<tr><th>Short-Name</th><td><code>' + key + '</code></td></tr>';
    rows += '<tr><th>Symbol (C func)</th><td><code>' + r.symbol + '</code></td></tr>';
    rows += '<tr><th>Trigger</th><td>' + (TRIGGER_BADGES[r.trigger] || r.trigger) + '</td></tr>';
    if (r.event) rows += '<tr><th>Event</th><td><code>' + r.event + '</code></td></tr>';
    if (r.period) rows += '<tr><th>Period</th><td>' + r.period + '</td></tr>';
    if (r.port) rows += '<tr><th>Port / Operation</th><td><code>' + r.port + '</code></td></tr>';
    rows += '<tr><th>Data Receive Points</th><td>' + formatList(r.dataReceive) + '</td></tr>';
    rows += '<tr><th>Data Send Points</th><td>' + formatList(r.dataSend) + '</td></tr>';
    rows += '<tr><th>Server Call Points</th><td>' + formatList(r.serverCalls) + '</td></tr>';
    if (r.modeAccessPoints && r.modeAccessPoints.length)
      rows += '<tr><th>Mode Access Points</th><td>' + formatList(r.modeAccessPoints) + '</td></tr>';
    if (r.modeSwitchPoints && r.modeSwitchPoints.length)
      rows += '<tr><th>Mode Switch Points</th><td>' + formatList(r.modeSwitchPoints) + '</td></tr>';
    if (r.parameters && r.parameters.length)
      rows += '<tr><th>Parameter Access</th><td>' + formatList(r.parameters) + '</td></tr>';
    if (r.writtenLocalVars && r.writtenLocalVars.length)
      rows += '<tr><th>Written Local Vars</th><td>' + formatList(r.writtenLocalVars) + '</td></tr>';
    if (r.readLocalVars && r.readLocalVars.length)
      rows += '<tr><th>Read Local Vars</th><td>' + formatList(r.readLocalVars) + '</td></tr>';
    if (r.exclusiveAreas && r.exclusiveAreas.length)
      rows += '<tr><th>Exclusive Areas</th><td>' + formatList(r.exclusiveAreas) + '</td></tr>';
    rows += '<tr><th>Description</th><td>' + r.description + '</td></tr>';
    return '<table>' + rows + '</table>';
  }

  function findRunnableKey(text) {
    var t = text.replace(/\(.*/, '').replace(/[();\s]+$/g, '').trim();
    /* Direct match on SHORT-NAME */
    if (RUNNABLE_DB[t]) return t;
    /* Match on SYMBOL */
    for (var k in RUNNABLE_DB) {
      if (RUNNABLE_DB[k].symbol === t) return k;
    }
    /* SPM patterns: try prefixing */
    var patterns = [
      /^(?:RE_)?SPM_SoftMgr_MainFunction$/,
      /^(?:RE_)?SPM_PowerManager_MainFunction$/,
      /^(?:Runnable_)?SPM_PowerManager_MainFunction$/,
      /^(?:RE_)?SPM_ActivateProfile$/,
      /^(?:SPM_)?ActivateProfile$/,
      /^(?:RE_)?SPM_DeactivateProfile$/,
      /^(?:SPM_)?DeactivateProfile$/,
      /^(?:RE_)?SPM_GetProfileState$/,
      /^(?:SPM_)?GetProfileState$/,
      /^(?:RE_)?SPM_GetProfileActivationPermission$/,
      /^(?:SPM_)?GetProfileActivationPermission$/,
      /^(?:RE_)?SPM_GetDTCIdentifier$/,
      /^(?:SPM_)?GetDTCIdentifier$/,
      /^(?:RE_|Runnable_)?SPM_SdLearningStatusIndication$/,
      /^(?:RE_)?SPM_SrvcMgr_SdLearningStatusIndication$/,
      /^(?:RE_)?SPM_SUSD_ActivityRecordCmd$/,
      /^(?:SPM_)?ActivityRecordCmd$/,
      /^(?:Runnable_)?SPM_Init$/,
      /^(?:RE_)?SPM_Init$/,
      /^(?:RE_)?SPM_DID_E0DD/,
      /^(?:Runnable_)?SPM_DID_E0DD/,
      /^(?:RE_)?SPM_DID_0xE0D[EF]/,
      /^(?:Runnable_)?Spm_DID0xE0D[EF]/
    ];
    var mapping = {
      'SPM_SoftMgr_MainFunction': 'RE_SPM_SoftMgr_MainFunction',
      'SPM_PowerManager_MainFunction': 'RE_SPM_PowerManager_MainFunction',
      'Runnable_SPM_PowerManager_MainFunction': 'RE_SPM_PowerManager_MainFunction',
      'SPM_ActivateProfile': 'RE_SPM_ActivateProfile',
      'ActivateProfile': 'RE_SPM_ActivateProfile',
      'SPM_DeactivateProfile': 'RE_SPM_DeactivateProfile',
      'DeactivateProfile': 'RE_SPM_DeactivateProfile',
      'SPM_GetProfileState': 'RE_SPM_GetProfileState',
      'GetProfileState': 'RE_SPM_GetProfileState',
      'SPM_GetProfileActivationPermission': 'RE_SPM_GetProfileActivationPermission',
      'GetProfileActivationPermission': 'RE_SPM_GetProfileActivationPermission',
      'SPM_GetDTCIdentifier': 'RE_SPM_GetDTCIdentifier',
      'GetDTCIdentifier': 'RE_SPM_GetDTCIdentifier',
      'SPM_SdLearningStatusIndication': 'RE_SPM_SrvcMgr_SdLearningStatusIndication',
      'Runnable_SPM_SdLearningStatusIndication': 'RE_SPM_SrvcMgr_SdLearningStatusIndication',
      'SPM_SrvcMgr_SdLearningStatusIndication': 'RE_SPM_SrvcMgr_SdLearningStatusIndication',
      'SPM_SUSD_ActivityRecordCmd': 'RE_SPM_SUSD_ActivityRecordCmd',
      'SPM_ActivityRecordCmd': 'RE_SPM_SUSD_ActivityRecordCmd',
      'ActivityRecordCmd': 'RE_SPM_SUSD_ActivityRecordCmd',
      'Runnable_SPM_Init': 'Runnable_SPM_Init',
      'RE_SPM_Init': 'Runnable_SPM_Init'
    };
    if (mapping[t]) return mapping[t];
    /* DID pattern matching */
    if (/E0DD.*CheckRead/i.test(t)) return 'RE_SPM_DID_E0DD_ActivationProfileActivationStatus_CheckRead';
    if (/E0DD/i.test(t)) return 'RE_SPM_DID_E0DD_ActivationProfileActivationStatus';
    if (/E0DE.*CheckRead/i.test(t)) return 'RE_SPM_DID_0xE0DE_CheckRead';
    if (/E0DE/i.test(t)) return 'RE_SPM_DID_0xE0DE';
    if (/E0DF.*CheckRead/i.test(t)) return 'RE_SPM_DID_0xE0DF_CheckRead';
    if (/E0DF/i.test(t)) return 'RE_SPM_DID_0xE0DF';
    return null;
  }

  /* ── Scan <code> elements and wrap matching text ── */
  var codeEls = document.querySelectorAll('code, td, span');
  var runnablePattern = /\b(RE_SPM_\w+|Runnable_SPM_\w+|SPM_SoftMgr_MainFunction|SPM_PowerManager_MainFunction|SPM_ActivateProfile|SPM_DeactivateProfile|SPM_GetProfileState|SPM_GetProfileActivationPermission|SPM_ActivityRecordCmd|SPM_GetDTCIdentifier|Runnable_SPM_SdLearningStatusIndication|Runnable_Spm_DID0xE0D[EF]\w*|RE_SPM_Init)\b/;

  codeEls.forEach(function(el) {
    /* Skip elements already processed or inside popups */
    if (el.closest('.runnable-overlay') || el.closest('.runnable-popup')) return;
    if (el.querySelector('.runnable-link')) return;

    var nodes = Array.prototype.slice.call(el.childNodes);
    nodes.forEach(function(node) {
      if (node.nodeType !== 3) return; /* text nodes only */
      var text = node.textContent;
      if (!runnablePattern.test(text)) return;

      var frag = document.createDocumentFragment();
      var parts = text.split(runnablePattern);
      parts.forEach(function(part) {
        if (runnablePattern.test(part)) {
          var key = findRunnableKey(part);
          if (key && RUNNABLE_DB[key]) {
            var span = document.createElement('span');
            span.className = 'runnable-link';
            span.setAttribute('data-runnable', key);
            span.textContent = part;
            frag.appendChild(span);
          } else {
            frag.appendChild(document.createTextNode(part));
          }
        } else {
          frag.appendChild(document.createTextNode(part));
        }
      });
      node.parentNode.replaceChild(frag, node);
    });
  });

  /* ── Popup open / close handlers ── */
  var overlay = document.getElementById('runnableOverlay');
  var popup   = document.getElementById('runnablePopup');
  var title   = document.getElementById('runnablePopupTitle');
  var body    = document.getElementById('runnablePopupBody');
  var closeBtn = document.getElementById('runnablePopupClose');

  document.addEventListener('click', function(e) {
    var link = e.target.closest('.runnable-link');
    if (!link) return;
    var key = link.getAttribute('data-runnable');
    var r = RUNNABLE_DB[key];
    if (!r) return;
    title.textContent = key;
    body.innerHTML = buildPopupHTML(key, r);
    overlay.classList.add('active');
    e.preventDefault();
    e.stopPropagation();
  });

  closeBtn.addEventListener('click', function() {
    overlay.classList.remove('active');
  });

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) overlay.classList.remove('active');
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('active')) {
      overlay.classList.remove('active');
    }
  });
})();
</script>

<script>
// ── Animated SVG Diagrams (fast) ──
(function() {
    var STEP_DELAY = 0.07;

    function animateSvg(svg) {
        if (svg.classList.contains('animated')) return;
        svg.classList.add('animated');
        var gen = (svg._animGen = (svg._animGen || 0) + 1);

        var rects = svg.querySelectorAll(':scope > rect, :scope > g > rect');
        var lines = svg.querySelectorAll(':scope > line, :scope > g > line');
        var paths = svg.querySelectorAll(':scope > path, :scope > g > path');
        var texts = svg.querySelectorAll(':scope > text, :scope > g > text');

        var si = 0;
        rects.forEach(function(rect) {
            rect.style.opacity = '0';
            rect.style.animation = 'stepFadeSlideIn 0.18s ease-out ' + (si * STEP_DELAY) + 's forwards';
            si++;
        });
        var ti = 0;
        texts.forEach(function(txt) {
            txt.style.opacity = '0';
            txt.style.animation = 'stepFadeSlideIn 0.14s ease-out ' + (0.03 + ti * STEP_DELAY * 0.4) + 's forwards';
            ti++;
        });
        lines.forEach(function(line, i) {
            line.style.opacity = '0';
            line.style.animation = 'stepFadeSlideIn 0.12s ease-out ' + ((i + 1) * STEP_DELAY) + 's forwards';
        });
        paths.forEach(function(path) {
            var len = 200;
            try { len = path.getTotalLength(); } catch(e) {}
            path.style.strokeDasharray = len;
            path.style.strokeDashoffset = len;
            path.style.animation = 'lineDrawIn 0.35s ease-out 0.1s forwards';
            (function(p, g) {
                setTimeout(function() {
                    if (svg._animGen !== g) return;
                    p.style.strokeDasharray = '8 4';
                    p.style.strokeDashoffset = '0';
                    p.style.animation = 'marchingAnts 1.5s linear infinite';
                }, 450);
            })(path, gen);
        });

        var isFsm = svg.closest('.fsm-diagram');
        if (isFsm) {
            var glowDelay = (rects.length * STEP_DELAY + 0.3) * 1000;
            (function(g) {
                setTimeout(function() {
                    if (svg._animGen !== g) return;
                    rects.forEach(function(rect) {
                        var rx = rect.getAttribute('rx');
                        if (rx === '25' || rx === '20') {
                            rect.style.opacity = '1';
                            rect.style.animation = 'stateGlow 3s ease-in-out infinite';
                        }
                    });
                }, glowDelay);
            })(gen);
        }
    }

    if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) { animateSvg(entry.target); observer.unobserve(entry.target); }
            });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('svg[viewBox]').forEach(function(svg) {
            if (!svg.closest('.arch-interactive')) observer.observe(svg);
        });
    }

    document.querySelectorAll('details').forEach(function(det) {
        det.addEventListener('toggle', function() {
            if (det.open) {
                det.querySelectorAll('svg[viewBox]').forEach(function(svg) {
                    svg.classList.remove('animated');
                    svg.querySelectorAll(':scope > rect, :scope > text, :scope > line, :scope > path, :scope > g > rect, :scope > g > text, :scope > g > line, :scope > g > path').forEach(function(el) {
                        el.style.opacity = ''; el.style.animation = '';
                        el.style.strokeDasharray = ''; el.style.strokeDashoffset = '';
                    });
                    setTimeout(function() { animateSvg(svg); }, 50);
                });
            }
        });
    });
})();
</script>

<script>
// ── Click-to-Highlight Route ──
(function() {
    function midY(el) {
        var t = el.tagName.toLowerCase();
        if (t === 'rect') return parseFloat(el.getAttribute('y') || 0) + parseFloat(el.getAttribute('height') || 0) / 2;
        if (t === 'text') return parseFloat(el.getAttribute('y') || 0);
        if (t === 'line') return (parseFloat(el.getAttribute('y1') || 0) + parseFloat(el.getAttribute('y2') || 0)) / 2;
        if (t === 'path') { try { var b = el.getBBox(); return b.y + b.height / 2; } catch(e) { return 9999; } }
        return 9999;
    }

    document.querySelectorAll('svg[viewBox]').forEach(function(svg) {
        if (svg.closest('.arch-interactive')) return;

        var allEls = Array.from(svg.querySelectorAll(':scope > rect, :scope > text, :scope > line, :scope > path, :scope > g > rect, :scope > g > text, :scope > g > line, :scope > g > path'));

        var stepRects = allEls.filter(function(el) {
            return el.tagName.toLowerCase() === 'rect' && parseFloat(el.getAttribute('width') || 0) > 100;
        });
        if (stepRects.length < 2) return;

        stepRects.sort(function(a, b) {
            return parseFloat(a.getAttribute('y')) - parseFloat(b.getAttribute('y'));
        });

        var activeRect = null;

        function highlightRoute(rect) {
            var cutoff = parseFloat(rect.getAttribute('y')) + parseFloat(rect.getAttribute('height')) + 2;
            allEls.forEach(function(el) {
                el.style.transition = 'opacity 0.25s ease, filter 0.25s ease';
                if (midY(el) <= cutoff) {
                    el.style.opacity = ''; el.style.filter = '';
                } else {
                    el.style.opacity = '0.10'; el.style.filter = 'grayscale(1)';
                }
            });
        }

        function resetRoute() {
            activeRect = null;
            allEls.forEach(function(el) {
                el.style.transition = 'opacity 0.25s ease, filter 0.25s ease';
                el.style.opacity = ''; el.style.filter = '';
            });
        }

        stepRects.forEach(function(r) { r.style.cursor = 'pointer'; });

        svg.addEventListener('click', function(e) {
            var tgt = e.target;
            if (tgt === svg || tgt.closest('defs')) { if (activeRect) resetRoute(); return; }
            if (tgt.closest('.wf-step')) return;

            var y = midY(tgt);
            var step = null;
            for (var i = stepRects.length - 1; i >= 0; i--) {
                var sy = parseFloat(stepRects[i].getAttribute('y'));
                var sh = parseFloat(stepRects[i].getAttribute('height'));
                if (y >= sy - 5 && y <= sy + sh + 5) { step = stepRects[i]; break; }
            }
            if (!step) {
                for (var i = stepRects.length - 1; i >= 0; i--) {
                    if (y >= parseFloat(stepRects[i].getAttribute('y'))) { step = stepRects[i]; break; }
                }
            }

            if (step) {
                e.stopPropagation();
                if (activeRect === step) { resetRoute(); } else { activeRect = step; highlightRoute(step); }
            } else if (activeRect) { resetRoute(); }
        });
    });
})();
</script>

<!-- Workflow Step Code Popup -->
<div class="runnable-overlay" id="wfOverlay">
  <div class="runnable-popup" id="wfPopup"></div>
</div>

<script>
(function() {
  var WF_DB = {
    "01": {
      title: "Step 01 \u2014 ConfGen",
      script: "70_Workflow/step_01_*.py",
      purpose: "Configuration generation \u2014 imports ECU Extract into the RTA-CAR project.",
      files: ["30_Generation/RTA-CAR_SPM_Project/ecu_config/"],
      code: '<span class="cmt"># Run ConfGen</span>\npython 70_Workflow/step_01_confgen.py\n\n<span class="cmt"># Imports system extract .arxml</span>\n<span class="cmt"># Updates ecu_config/ directory</span>'
    },
    "02": {
      title: "Step 02 \u2014 BSW CodeGen",
      script: "70_Workflow/step_02_*.py",
      purpose: "BSW code generation using RTA-BSW.",
      files: ["30_Generation/RTA-CAR_SPM_Project/src/bsw/"],
      code: '<span class="cmt"># Run BSW code generation</span>\npython 70_Workflow/step_02_bsw_codegen.py'
    },
    "03": {
      title: "Step 03 \u2014 ParamDef from YAML",
      script: "70_Workflow/step_03_*.py",
      purpose: "Generate Spm_EcucParamDef.arxml from YAML definition (Spm_paramConf.yaml). SPM is unique in using YAML-driven paramdef generation.",
      files: ["design_driven/Spm_paramConf.yaml", "20_Implementation/scripts/paramdef/Spm_EcucParamDef.arxml"],
      code: '<span class="cmt"># Generate ParamDef from YAML</span>\npython 70_Workflow/step_03_paramdef.py\n\n<span class="cmt"># Input:  design_driven/Spm_paramConf.yaml</span>\n<span class="cmt"># Output: Spm_EcucParamDef.arxml</span>\n\n<span class="cmt"># YAML defines parameters declaratively:</span>\n<span class="cmt"># containers:</span>\n<span class="cmt">#   SpmGeneral:</span>\n<span class="cmt">#     parameters:</span>\n<span class="cmt">#       SpmMainFunctionPeriod:</span>\n<span class="cmt">#         type: FLOAT</span>\n<span class="cmt">#         range: [0.001, 1.0]</span>\n<span class="cmt">#         default: 0.01</span>'
    },
    "04": {
      title: "Step 04 \u2014 SUM CodeGen (Xpand)",
      script: "70_Workflow/step_04_sums_codegen.py",
      purpose: "Xpand code generation + copy test files. The key SUM step \u2014 generates C source from 46 Xpand templates.",
      files: ["Sum_Spm_*.c", "Sum_Spm_*.h", "Sum_Spm_Cfg.*"],
      code: '<span class="cmt"># Run SUM code generation</span>\npython 70_Workflow/step_04_sums_codegen.py\n\n<span class="cmt"># 46 Xpand templates \u2192 C/H files</span>\n<span class="cmt"># Output: 30_Generation/.../src/sum/</span>\n\n<span class="cmt"># SPM has many submodules:</span>\n<span class="cmt">#   ShutdownCoordinator, WakeupManager,</span>\n<span class="cmt">#   VoltageMonitor, ModeManager,</span>\n<span class="cmt">#   ResetHandler, etc.</span>'
    },
    "05": {
      title: "Step 05 \u2014 ECU Extract",
      script: "70_Workflow/step_05_*.py",
      purpose: "Generate ECU extract from ISOLAR project.",
      files: ["30_Generation/RTA-CAR_SPM_Project/ecu_extract/"],
      code: '<span class="cmt"># Generate ECU extract</span>\npython 70_Workflow/step_05_ecu_extract.py'
    },
    "07": {
      title: "Step 07 \u2014 RTE CodeGen",
      script: "70_Workflow/step_07_*.py",
      purpose: "RTE code generation using RTA-RTE from SWCD .arxml.",
      files: ["30_Generation/RTA-CAR_SPM_Project/src/rte/"],
      code: '<span class="cmt"># Run RTE code generation</span>\npython 70_Workflow/step_07_rte_codegen.py\n\n<span class="cmt"># Generates Rte_Spm.c / Rte_Spm.h</span>\n<span class="cmt"># from SWCD .arxml (output of step 04)</span>'
    },
    "08": {
      title: "Step 08 \u2014 MISRA",
      script: "70_Workflow/step_08_*.py",
      purpose: "MISRA/PRQA static analysis on all SPM source files.",
      files: ["40_Test/02_Static_Analysis/"],
      code: '<span class="cmt"># Run MISRA static analysis</span>\npython 70_Workflow/step_08_misra.py\n\n<span class="cmt"># Checks all SPM .c/.h against</span>\n<span class="cmt"># MISRA C:2012 rules</span>'
    },
    "09": {
      title: "Step 09 \u2014 Unit Test",
      script: "70_Workflow/step_09_*.py",
      purpose: "Compile + run all 19 Cantata test suites for SPM with MC/DC coverage.",
      files: ["40_Test/SPM_CantataUT/"],
      code: '<span class="cmt"># Compile and run unit tests</span>\npython 70_Workflow/step_09_ut.py\n\n<span class="cmt"># 19 Cantata test suites</span>\n<span class="cmt"># MC/DC coverage required</span>\n<span class="cmt"># Test dir: 40_Test/SPM_CantataUT/</span>'
    },
    "10": {
      title: "Step 10 \u2014 Traceability",
      script: "70_Workflow/step_10_*.py",
      purpose: "Update traceability report (SRS \u2194 SDD \u2194 Code \u2194 Test).",
      files: ["10_Documents/30_Traceability/"],
      code: '<span class="cmt"># Update traceability report</span>\npython 70_Workflow/step_10_traceability.py\n\n<span class="cmt"># Maps: SRS \u2192 SDD \u2192 Code \u2192 Test</span>\n<span class="cmt"># 100% coverage required</span>'
    },
    "11": {
      title: "Step 11 \u2014 Documentation",
      script: "70_Workflow/step_11_*.py",
      purpose: "Build Sphinx documentation (requirements, design, user guide).",
      files: ["10_Documents/RTA-SUM_SPM_Docs/DocsAsCode/"],
      code: '<span class="cmt"># Build Sphinx documentation</span>\npython 70_Workflow/step_11_docs.py\n\n<span class="cmt"># Generates HTML docs from .rst sources</span>\n<span class="cmt"># Output: 10_Documents/</span>'
    }
  };

  function buildWfPopup(step) {
    var s = WF_DB[step];
    if (!s) return '';
    var filesHtml = '';
    if (s.files && s.files.length) {
      filesHtml = '<div class="wf-popup-files">';
      for (var i = 0; i < s.files.length; i++) filesHtml += '<span>' + s.files[i] + '</span>';
      filesHtml += '</div>';
    }
    return '<div class="runnable-popup-header"><h3>' + s.title + '</h3>' +
      '<button class="popup-close" id="wfCloseBtn" title="Close">&times;</button></div>' +
      '<div class="runnable-popup-body"><table>' +
      '<tr><th>Script</th><td><code>' + s.script + '</code></td></tr>' +
      '<tr><th>Purpose</th><td>' + s.purpose + '</td></tr>' +
      '<tr><th>Key Files</th><td>' + filesHtml + '</td></tr></table>' +
      '<div class="wf-popup-code">' + s.code + '</div></div>';
  }

  var overlay = document.getElementById('wfOverlay');
  var popup = document.getElementById('wfPopup');
  document.addEventListener('click', function(e) {
    var step = e.target.closest('.wf-step');
    if (step) {
      var key = step.getAttribute('data-step');
      var html = buildWfPopup(key);
      if (html) { popup.innerHTML = html; overlay.classList.add('active'); e.preventDefault(); e.stopPropagation(); }
    }
  });
  overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.classList.remove('active'); });
  popup.addEventListener('click', function(e) { if (e.target.id === 'wfCloseBtn' || e.target.closest('#wfCloseBtn')) overlay.classList.remove('active'); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && overlay.classList.contains('active')) overlay.classList.remove('active'); });
})();
</script>

</body>
</html>
