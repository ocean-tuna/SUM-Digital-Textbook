    "RE_SPM_SrvcMgr_SdLearningStatusIndication": {
      symbol: "Runnable_SPM_SdLearningStatusIndication",
      trigger: "opinvoke",
      event: "OIE_SPM_SrvcMgr_SdLearningStatusIndication",
      port: "PP_SPM_SrvcMgr_SdLearningStatusIndication / SdLearningStatusIndication",
      dataReceive: [],
      dataSend: [],
      serverCalls: [],
      modeSwitchPoints: [],
      parameters: [],
      writtenLocalVars: [
        "Spm_Learning_Status"
      ],
