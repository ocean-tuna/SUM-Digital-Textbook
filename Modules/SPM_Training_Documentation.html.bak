  <text x="29" y="99" text-anchor="middle" font-size="12" font-weight="700" fill="#fff">2</text>
  <text x="52" y="92" font-size="11" font-weight="700" fill="#065f46">SEND_ETH_WKUP_FRM_A, Bit 5</text>
  <text x="52" y="108" font-size="10" fill="#2d3436">Transmit Ethernet wake-up frame A with bit 5 set &rarr; Camera ECU starts booting</text>
  <text x="560" y="120" font-size="9" fill="#94a3b8" text-anchor="end">delay: 100ms</text>
  <line x1="310" y1="127" x2="310" y2="145" stroke="#94a3b8" stroke-width="2" marker-end="url(#wk_arr)"/>
