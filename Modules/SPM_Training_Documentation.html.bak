                    <div class="pd-header" onclick="toggleTree(this)">
                      <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">SUSD_C_BatteryVoltageRange</span><span class="pd-mult">0..*</span><span class="pd-count">3 params</span>
                    </div>
                    <div class="pd-body">
                      <div class="pd-desc">Custom battery voltage range definitions.</div>
                      <div class="pd-section-title">Parameters</div>
                      <div class="pd-hdr param-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Description</span></div>
                      <div class="pd-param"><span class="pn">SUSD_C_BatteryVoltageRange_Min</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">3&ndash;28.5</span><span class="pdef">9</span><span class="pdesc">Minimum voltage of this range.</span></div>
                      <div class="pd-param"><span class="pn">SUSD_C_BatteryVoltageRange_Max</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">3&ndash;28.5</span><span class="pdef">16</span><span class="pdesc">Maximum voltage of this range.</span></div>
                      <div class="pd-param"><span class="pn">SUSD_C_BatteryVoltageRange_AccuracyHSV</span><span class="type-badge type-float">FLOAT</span><span class="pm">1..1</span><span class="pr">0&ndash;0.5</span><span class="pdef">0</span><span class="pdesc">Accuracy hysteresis value.</span></div>
