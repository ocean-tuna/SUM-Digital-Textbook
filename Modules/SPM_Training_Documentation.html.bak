      exclusiveAreas: [],
      description: "Operation-invoked runnable that checks whether activation of a given profile is currently permitted."
    },
    "RE_SPM_DID_E0DD_ActivationProfileActivationStatus": {
      symbol: "Runnable_SPM_DID_E0DD_ActivationProfileActivationStatus",
      trigger: "opinvoke",
      event: "OIE_DID_E0DD_ActivationProfileActivationStatus",
      port: "PP_SPM_DCM_DID_E0DD_ActivationProfileActivationStatus / ReadData",
      dataReceive: [],
      dataSend: [],
      serverCalls: [],
      modeSwitchPoints: [],
      parameters: [],
      readLocalVars: [],
      exclusiveAreas: [],
      description: "Diagnostic DID E0DD read handler. Returns the activation profile activation status to DCM. Conditional on spm_DID_E0DD configuration."
    },
    "RE_SPM_DID_E0DD_ActivationProfileActivationStatus_CheckRead": {
      symbol: "Runnable_SPM_DID_E0DD_ActivationProfileActivationStatus_CheckRead",
      trigger: "opinvoke",
      event: "OIE_DID_E0DD_ActivationProfileActivationStatus_CheckRead",
      port: "PP_SPM_DCM_DID_E0DD_ActivationProfileActivationStatus / ConditionCheckRead",
      dataReceive: [],
