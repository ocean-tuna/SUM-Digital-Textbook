                  <div class="pd-section-title">Parameters</div>
                  <div class="pd-hdr param-hdr"><span>Name</span><span>Type</span><span>Mult</span><span>Range</span><span>Default</span><span>Description</span></div>
                  <div class="pd-param"><span class="pn">LNM_ScheduleSignalSource</span><span class="type-badge type-enum">ENUM</span><span class="pm">1..1</span><span class="pr">SWC, Com, VPM</span><span class="pdef">SWC</span><span class="pdesc">Source of the schedule signal.</span></div>
