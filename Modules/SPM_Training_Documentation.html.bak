            </div>
          </div>

          <!-- LNM_Arbitration -->
          <div class="pd-node">
            <div class="pd-header" onclick="toggleTree(this)">
              <span class="pd-toggle">&#9654;</span><span class="pd-icon container">C</span><span class="pd-name">LNM_Arbitration</span><span class="pd-mult">0..1</span>
              <span class="pd-brief">&mdash; project-specific arbitration logic</span>
            </div>
            <div class="pd-children hidden">
              <div class="pd-node">
                <div class="pd-header" onclick="toggleTree(this)">
                  <span class="pd-toggle">&#9654;</span><span class="pd-icon sub">S</span><span class="pd-name">LNM_ScheduleSignal</span><span class="pd-mult">0..*</span><span class="pd-count">2 params</span><span class="pd-brief">&mdash; under LNM_Inputs</span>
