      ],
      readLocalVars: [
        "Spm_LastDeactReqID",
        "Spm_LastDeactReqFlag",
        "Spm_Learning_Status"
      ],
      exclusiveAreas: [],
      description: "Operation-invoked runnable called by application SWCs to request activation of a profile via its ApplicationInterfaceID. Validates no conflicting deactivation is pending, stores the activation request, and returns E_OK or E_NOT_OK."
    },
    "RE_SPM_DeactivateProfile": {
