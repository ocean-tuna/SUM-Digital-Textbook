<!-- Sidebar scroll highlight -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const links = document.querySelectorAll('.sidebar a');
  const sections = [];

  links.forEach(function(link) {
    const href = link.getAttribute('href');
    if (href && href.startsWith('#')) {
      const el = document.getElementById(href.substring(1));
      if (el) sections.push({ link: link, el: el });
    }
  });

  function onScroll() {
    const scrollY = window.scrollY + 80;
    let current = null;
    for (let i = sections.length - 1; i >= 0; i--) {
      if (sections[i].el.offsetTop <= scrollY) {
        current = sections[i];
        break;
      }
    }
    links.forEach(function(l) { l.classList.remove('active'); });
    if (current) current.link.classList.add('active');
  }

  window.addEventListener('scroll', onScroll);
  onScroll();

  // Smooth scroll
  links.forEach(function(link) {
    link.addEventListener('click', function(e) {
      const href = this.getAttribute('href');
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const target = document.getElementById(href.substring(1));
        if (target) {
          window.scrollTo({ top: target.offsetTop - 60, behavior: 'smooth' });
        }
      }
    });
  });
});

function toggleTree(el) {
  var header = el.closest('.pd-header');
  var node = header.closest('.pd-node');
  var body = node.querySelector(':scope > .pd-body');
  var children = node.querySelector(':scope > .pd-children');
  header.classList.toggle('active');
  if (body) body.classList.toggle('open');
  if (children) children.classList.toggle('hidden');
}
</script>

<!-- ── Runnable Interactive Popup ── -->
<div class="runnable-overlay" id="runnableOverlay">
  <div class="runnable-popup" id="runnablePopup">
    <div class="runnable-popup-header">
      <h3 id="runnablePopupTitle"></h3>
      <button class="popup-close" id="runnablePopupClose">&times;</button>
    </div>
    <div class="runnable-popup-body" id="runnablePopupBody"></div>
  </div>
</div>

<script>
(function() {
  /* ── Runnable metadata database (extracted from Sum_Spm_Cfg_CDD_arxml.xpt) ── */
  var RUNNABLE_DB = {
    "RE_SPM_SoftMgr_MainFunction": {
      symbol: "SPM_SoftMgr_MainFunction",
      trigger: "timing",
      period: "Configurable (spmSMMainFuncPeriodicity, default 1000ms)",
      event: "TE_SPM_SoftMgr_Main",
      dataReceive: [
        "DRPA_SPM_PermitExecution_0 \u2190 RP_SUSD_SPM_PerExec / SUSD_SWC_ExecutionStatus",
        "DRPA_SPM_VehiclePowerMode_0 \u2190 RP_SUSD_SPM_VehiclePowerMode / VehiclePowerMode",
        "DRPA_SPM_{VLAN}_PwrMgrHeartbeatRx{n} \u2190 per-VLAN heartbeat Rx",
        "DRPA_SPM_{VLAN}_SwMgrInfoRx \u2190 per-VLAN SwMgrInfo Rx",
        "DRPA_SPM_{VLAN}_PwrMgrWakeupRx \u2190 per-VLAN wakeup Rx",
        "DRPA_SPM_{VLAN}_PwrMgrWakeupRx_Multicast \u2190 per-VLAN multicast wakeup Rx",
        "SignalAvailability \u2190 RP_SSFM_SPM_LowVoltSwActPrioReqAvailability (conditional)",
        "DRPA_VeActvProp_YeDrvnVeh \u2190 RP_Com_Spm_LowVoltSwActPrioReq (conditional)"
      ],
      dataSend: [
        "DSP_SPM_ShutdownPermission_0 \u2192 PP_SPM_SUSD_ShutDown / SUSD_UserRequest",
        "DSP_LossOfNodeIndication_0 \u2192 PP_SPM_SerDatMon_LoNInd / LossOfNodeIndication",
        "DSP_SPM_{VLAN}_PwrMgrHeartbeatTx \u2192 per-VLAN heartbeat Tx",
        "DSP_SPM_{VLAN}_SwMgrInfoTx \u2192 per-VLAN SwMgrInfo Tx",
        "DSP_SPM_{VLAN}_PwrMgrWakeupTx \u2192 per-VLAN wakeup Tx",
        "DSP_StatusNotification_0 \u2192 PP_SPM_SrvcMgr_Notif / StatusNotification"
      ],
      serverCalls: [
        "ActivateService \u2192 RP_SPM_SrvcMgr_ActivateSrvc / ActivateServices",
        "UpdateRecords \u2192 RP_SUSD_SPM_UpdateRecord / UpdateRecord",
        "GetDeviceVariantInfo \u2192 RP_SPM_GetDeviceVariantInfo / setVariant (conditional)",
        "SSCP_E0DE_WriteBlock \u2192 RP_SPM_Dcm_E0DE_Write / NvM WriteBlock (conditional)",
        "SSCP_E0DF_WriteBlock \u2192 RP_SPM_Dcm_E0DF_Write / NvM WriteBlock (conditional)",
        "LowVoltageActivationPriority_SetRamBlockStatus \u2192 NvM SetRamBlockStatus (conditional)"
      ],
      modeSwitchPoints: [
        "MSP_{PduGr} \u2192 PP_SPM_BswM_ComIpduGroup_{PduGr} (Tx PDU groups)",
        "MSP_{PduGr} \u2192 PP_SPM_BswM_ComIpduGroup_{PduGr} (Rx PDU groups)"
      ],
      parameters: [
        "Spm_Ethernet_Periodicity_BurstPhase_ms",
        "Spm_Can_Periodicity_BurstPhase_ms",
        "Spm_HB_Periodicity_BurstPhase_ms",
        "Spm_HB_Periodicity_ms",
        "Spm_SM_Stay_Awake_Time_ms",
        "Spm_PduTx_SwitchOff_Delay_ms (conditional)",
        "Spm_ActDeactRetry_Periodicity_Fast_ms",
        "Spm_ActDeactRetry_Periodicity_Slow_ms",
        "SPM_NetworkInfo_{variant}_{VLAN} (per variant/VLAN)",
        "TrgDvcs_{WkngDvc}",
        "Spm_Wakeup_Frame_Info_{variant} (per variant)",
        "Spm_Ethernet_BurstPhase_Interval",
        "Spm_Can_BurstPhase_Interval",
        "Spm_WkUp_Periodicity_ms"
      ],
      readLocalVars: [
        "Spm_E0D7ActiveStatus",
        "Spm_DevicePowerState",
        "Spm_Learning_Status"
      ],
      exclusiveAreas: [],
      description: "Main Software Manager cyclic runnable. Orchestrates profile activation/deactivation state machine, heartbeat/wakeup frame Tx/Rx, BFS dispatching, service activation via SrvcMgr, PDU group switching, and shutdown permission reporting."
    },
    "Runnable_SPM_Init": {
      symbol: "RE_SPM_Init",
      trigger: "timing",
      period: "Configurable (spmInitFuncPeriodicity)",
      event: "TE_SPM_SoftMgr_Init",
      dataReceive: [],
      dataSend: [],
      serverCalls: [],
      modeSwitchPoints: [],
      parameters: [],
      readLocalVars: [],
      exclusiveAreas: [],
      description: "Optional initialization runnable (generated when spmGenerateInitRunnable is enabled). Performs one-time SPM initialization tasks."
    },
    "RE_SPM_PowerManager_MainFunction": {
      symbol: "Runnable_SPM_PowerManager_MainFunction",
      trigger: "timing",
      period: "5ms (fixed)",
      event: "TE_SPM_PowerManager_Main",
      dataReceive: [],
      dataSend: [],
      serverCalls: [],
      modeAccessPoints: [
        "RP_SPM_BswM_CommunicationReady / SPM_MDG_CR (read communication-ready mode)"
      ],
      modeSwitchPoints: [],
      parameters: [
