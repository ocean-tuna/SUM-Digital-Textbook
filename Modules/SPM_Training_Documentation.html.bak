  <text x="52" y="38" font-size="10" fill="#2d3436">Wake Ethernet switch port 3 &rarr; physical link to Camera ECU comes up</text>
  <text x="560" y="50" font-size="9" fill="#94a3b8" text-anchor="end">delay: 50ms</text>
  <line x1="310" y1="57" x2="310" y2="75" stroke="#94a3b8" stroke-width="2" marker-end="url(#wk_arr)"/>
