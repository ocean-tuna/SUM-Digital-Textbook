  <ADMIN-DATA>
    <DOC-REVISIONS>
      <DOC-REVISION>
        <REVISION-LABEL>3.1.0</REVISION-LABEL>
        <ISSUED-BY>ETAS</ISSUED-BY>
        <DATE>2019-09-09</DATE>
      </DOC-REVISION>
    </DOC-REVISIONS>
  </ADMIN-DATA>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AUTOSAR_Tcs_Tcs</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>EcucModuleDefs</SHORT-NAME>
          <ELEMENTS>
            <ECUC-MODULE-DEF>
              <SHORT-NAME>Tcs</SHORT-NAME>
              <LONG-NAME>
                <L-4 L="EN">Tcs</L-4>
              </LONG-NAME>
              <DESC>
                <L-2 L="EN">Configuration of the Tcs module.</L-2>
              </DESC>
              <CATEGORY>VENDOR_SPECIFIC_MODULE_DEFINITION</CATEGORY>
              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
              <REFINED-MODULE-DEF-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/Tcs</REFINED-MODULE-DEF-REF>
              <SUPPORTED-CONFIG-VARIANTS>
                <SUPPORTED-CONFIG-VARIANT>VARIANT-PRE-COMPILE</SUPPORTED-CONFIG-VARIANT>
                <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
              </SUPPORTED-CONFIG-VARIANTS>
              <CONTAINERS>
                <ECUC-PARAM-CONF-CONTAINER-DEF>
                  <SHORT-NAME>TcsGeneral</SHORT-NAME>
                  <LONG-NAME>
                    <L-4 L="EN">TcsGeneral</L-4>
                  </LONG-NAME>
                  <DESC>
                    <L-2 L="EN">General configuration of the TCS module.</L-2>
                  </DESC>
                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <POST-BUILD-CHANGEABLE>false</POST-BUILD-CHANGEABLE>
                  <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                  <PARAMETERS>
                  <!-- [$Satisfies $SDD_TCS 031] -->
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>MasterClockPollingPeriodicity</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="EN">MasterClockPollingPeriodicity</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="EN">Time in msec, for the periodicity of MasterClockPolling.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <IMPLEMENTATION-CONFIG-CLASSES>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>100</DEFAULT-VALUE>
                      <MAX>1000</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>PermitExecutionMask</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="EN">PermitExecutionMask</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="EN">PermitExecution mask to start execution of the TCS module.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <IMPLEMENTATION-CONFIG-CLASSES>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>254</DEFAULT-VALUE>
                      <MAX>255</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>SumTCSGlobalTimePrecision</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="EN">SumTCSGlobalTimePrecision</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="EN">Local time source accuracy in msec. Must be a multiple of the periodicity of TimeManagement.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <IMPLEMENTATION-CONFIG-CLASSES>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>100</DEFAULT-VALUE>
                      <MAX>1000</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>TimeManagementPeriodicity</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="EN">TimeManagementPeriodicity</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="EN">Time in msec, for the periodicity of TimeManagement.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <IMPLEMENTATION-CONFIG-CLASSES>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>100</DEFAULT-VALUE>
                      <MAX>1000</MAX>
                      <MIN>1</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
                    <ECUC-BOOLEAN-PARAM-DEF>
                        <SHORT-NAME>TcsGenerateInitRunnable</SHORT-NAME>
                        <LONG-NAME>
                          <L-4 L="EN">TcsGenerateInitRunnable</L-4>
                        </LONG-NAME>
                        <DESC>
                          <L-2 L="EN">Configuration parameter TcsGenerateInitRunnable is used to allow the generation of a periodic runnable to run function RE_TCS_Init one time. If TRUE the Tcs should generate the periodic runnable to execute init() function one time otherwise, the init() function is called by a BswM action list during startup.</L-2>
                        </DESC>
                        <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <IMPLEMENTATION-CONFIG-CLASSES>
                          <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        </IMPLEMENTATION-CONFIG-CLASSES>
                        <ORIGIN>RB:0.1.0:2015-12-05</ORIGIN>
                        <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        <DEFAULT-VALUE>false</DEFAULT-VALUE>
                      </ECUC-BOOLEAN-PARAM-DEF>
                      <ECUC-FLOAT-PARAM-DEF>
                        <SHORT-NAME>TcsInitFuncPeriodicity</SHORT-NAME>
                        <LONG-NAME>
                          <L-4 L="EN">TcsInitFuncPeriodicity</L-4>
                        </LONG-NAME>
                        <DESC>
                          <L-2 L="EN">Specifies time in millisecond, for the periodicity of the runnable RE_TCS_Init. Float values are supported. This parameter is required when TcsGenerateInitRunnable is set to TRUE</L-2>
                        </DESC>
                        <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <IMPLEMENTATION-CONFIG-CLASSES>
                          <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        </IMPLEMENTATION-CONFIG-CLASSES>
                        <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                        <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        <DEFAULT-VALUE>1000.0</DEFAULT-VALUE>
                        <MAX>5000.0</MAX>
                        <MIN>1.0</MIN>
                      </ECUC-FLOAT-PARAM-DEF>
                  </PARAMETERS>
	              <REFERENCES>
	                <ECUC-REFERENCE-DEF>
	                 <SHORT-NAME>DID_F129_TotalVehicleTimeValue_Reference</SHORT-NAME>
	                 <DESC>
	                   <L-2 L="EN">Reference to DCM DID 0xF129 Total Vehicle Time Value</L-2>
	                 </DESC>
	                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
	                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
	                 <IMPLEMENTATION-CONFIG-CLASSES>
	                   <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
	                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
	                     <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
	                   </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
	                 </IMPLEMENTATION-CONFIG-CLASSES>
	                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                     <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dcm/EcucModuleDefs/Dcm/DcmConfigSet/DcmDsp/DcmDspDid</DESTINATION-REF>
	               </ECUC-REFERENCE-DEF>
	               <ECUC-REFERENCE-DEF>
	                 <SHORT-NAME>TcsDemTimestampRef</SHORT-NAME>
	                 <DESC>
	                   <L-2 L="EN">Reference to Dem Timestamp</L-2>
	                 </DESC>
	                 <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
	                 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
	                 <IMPLEMENTATION-CONFIG-CLASSES>
	                   <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
	                     <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
	                     <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
	                   </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
	                 </IMPLEMENTATION-CONFIG-CLASSES>
	                 <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                     <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dem/EcucModuleDefs/Dem/DemGeneral/DemDidClass</DESTINATION-REF>
	               </ECUC-REFERENCE-DEF>
                  <ECUC-REFERENCE-DEF>
                    <SHORT-NAME>TCSInitValueNvmRef</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Reference to NVM Block for storing TCS Init time value</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>ETAS:1.1.0:2015-07-15</ORIGIN>
                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_NvM/EcucModuleDefs/NvM/NvMBlockDescriptor</DESTINATION-REF>
                  </ECUC-REFERENCE-DEF>
                  <ECUC-CHOICE-REFERENCE-DEF>
                    <SHORT-NAME>TCS_TimeSyncMessageSignalRef</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Reference to the TimeSyncMessage ComSignal or ComGroupSignal.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                    <DESTINATION-REFS>
                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComSignalGroup/ComGroupSignal</DESTINATION-REF>
                      <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/Com/ComConfig/ComSignal</DESTINATION-REF>
                    </DESTINATION-REFS>
                  </ECUC-CHOICE-REFERENCE-DEF>
                  <ECUC-FOREIGN-REFERENCE-DEF>
                    <SHORT-NAME>TCS_ServiceBased_TimeSyncMessage_DataTypeMappingSet</SHORT-NAME>
                    <LONG-NAME>
                      <L-4 L="EN">TCS_ServiceBased_TimeSyncMessage_DataTypeMappingSet</L-4>
                    </LONG-NAME>
                    <DESC>
                      <L-2 L="EN">Foreign reference to the DATA-TYPE-MAPPING-SET in the system extract used for service-based TimeSyncMessage. Required when TCS_ServiceBased_TimeSyncMessage_Ref is configured.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <DESTINATION-TYPE>DATA-TYPE-MAPPING-SET</DESTINATION-TYPE>
                  </ECUC-FOREIGN-REFERENCE-DEF>
                  <ECUC-FOREIGN-REFERENCE-DEF>
                    <SHORT-NAME>TCS_ServiceBased_TimeSyncMessage_Ref</SHORT-NAME>
                    <LONG-NAME>
                      <L-4 L="EN">TCS_ServiceBased_TimeSyncMessage_Ref</L-4>
                    </LONG-NAME>
                    <DESC>
                      <L-2 L="EN">Reference to the IMPLEMENTATION-DATA-TYPE-ELEMENT for service-based TimeSyncMessage from the system extract. Presence of this reference activates service-based mode.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>RB</ORIGIN>
                    <DESTINATION-TYPE>IMPLEMENTATION-DATA-TYPE-ELEMENT</DESTINATION-TYPE>
                  </ECUC-FOREIGN-REFERENCE-DEF>
	             </REFERENCES>
                </ECUC-PARAM-CONF-CONTAINER-DEF>
              </CONTAINERS>
            </ECUC-MODULE-DEF>
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
