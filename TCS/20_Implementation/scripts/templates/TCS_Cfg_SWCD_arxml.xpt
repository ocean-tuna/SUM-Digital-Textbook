                              <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/SUM_TCS/Component/SUM_TCS/TCS_SUSD_ShutdownPermission</PORT-PROTOTYPE-REF>
                              <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/TCS_SUSD_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                            </AUTOSAR-VARIABLE-IREF>
                          </ACCESSED-VARIABLE>
                        </VARIABLE-ACCESS>
                      </DATA-SEND-POINTS>
                      <SERVER-CALL-POINTS>
                        <SYNCHRONOUS-SERVER-CALL-POINT>
                          <SHORT-NAME>SSCP_TCSInitValue_SetRamBlockStatus</SHORT-NAME>
                          <OPERATION-IREF>
                            <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_TCS/Component/SUM_TCS/RP_NvMService_TCSTimeValue</CONTEXT-R-PORT-REF>
                            <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_NvM/PortInterfaces/NvMService/SetRamBlockStatus</TARGET-REQUIRED-OPERATION-REF>
                          </OPERATION-IREF>
                        </SYNCHRONOUS-SERVER-CALL-POINT>
                      </SERVER-CALL-POINTS>
                      <SYMBOL>Runnable_TCS_PermitExecutionShutdown</SYMBOL>
                      <WRITTEN-LOCAL-VARIABLES>
                        <VARIABLE-ACCESS>
                          <SHORT-NAME>WLV_EA_Localtime_Clock</SHORT-NAME>
                          <ACCESSED-VARIABLE>
                            <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/SUM_TCS/Component/SUM_TCS/SUM_TCS_IB/EA_Localtime_Clock</LOCAL-VARIABLE-REF>
                          </ACCESSED-VARIABLE>
                        </VARIABLE-ACCESS>
                        <VARIABLE-ACCESS>
                          <SHORT-NAME>WLV_EA_SubCounter</SHORT-NAME>
                          <ACCESSED-VARIABLE>
                            <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/SUM_TCS/Component/SUM_TCS/SUM_TCS_IB/EA_SubCounter</LOCAL-VARIABLE-REF>
                          </ACCESSED-VARIABLE>
                        </VARIABLE-ACCESS>
                      </WRITTEN-LOCAL-VARIABLES>
                    </RUNNABLE-ENTITY>
                  </RUNNABLES>
                </SWC-INTERNAL-BEHAVIOR>
              </INTERNAL-BEHAVIORS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <SWC-IMPLEMENTATION>
              <SHORT-NAME>SwcImplementation_IB_TCS</SHORT-NAME>
              <CODE-DESCRIPTORS>
                <CODE>
                  <SHORT-NAME>Code_0_0</SHORT-NAME>
                  <ARTIFACT-DESCRIPTORS>
                    <AUTOSAR-ENGINEERING-OBJECT>
                      <SHORT-LABEL>AEO0</SHORT-LABEL>
                      <CATEGORY>SWSRC</CATEGORY>
                    </AUTOSAR-ENGINEERING-OBJECT>
                  </ARTIFACT-DESCRIPTORS>
                </CODE>
              </CODE-DESCRIPTORS>
              <PROGRAMMING-LANGUAGE>C</PROGRAMMING-LANGUAGE>
              <RESOURCE-CONSUMPTION>
                <SHORT-NAME>TCS_ResourceConsumption_0</SHORT-NAME>
                <MEMORY-SECTIONS>
                  <MEMORY-SECTION>
                    <SHORT-NAME>CODE</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_CLEARED_8</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_CLEARED_16</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_CLEARED_32</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_CLEARED_UNSPECIFIED</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_INIT_8</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_INIT_16</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_INIT_32</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>VAR_INIT_UNSPECIFIED</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>CONST_8</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>CONST_16</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>CONST_32</SHORT-NAME>
                  </MEMORY-SECTION>
                  <MEMORY-SECTION>
                    <SHORT-NAME>CONST_UNSPECIFIED</SHORT-NAME>
                  </MEMORY-SECTION>
                </MEMORY-SECTIONS>
              </RESOURCE-CONSUMPTION>
              <BEHAVIOR-REF DEST="SWC-INTERNAL-BEHAVIOR">/SUM_TCS/Component/SUM_TCS/SUM_TCS_IB</BEHAVIOR-REF>
            </SWC-IMPLEMENTATION>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>TimeSyncMessage</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>TimeSyncMessage</SHORT-NAME>
«IF Tcs_IsTimeSyncServiceBased(tcs.tcsGeneral)-»
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«Tcs_GetImplementationDataTypePath(tcs.tcsGeneral.tCS_ServiceBased_TimeSyncMessage_Ref)»</TYPE-TREF>
«ELSEIF Tcs_IsTimeSyncGroupSignal(tcs.tcsGeneral)-»
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_TCS/Component/RxSignal_TCS_TimeSyncMessage_GroupSignal</TYPE-TREF>
«ELSE-»
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint64</TYPE-TREF>
«ENDIF-»
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
«REM» Implementation Data Type and Base Type for Com Group Signal «ENDREM»
«IF Tcs_IsTimeSyncGroupSignal(tcs.tcsGeneral) && !Tcs_IsTimeSyncServiceBased(tcs.tcsGeneral)-»
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>RxSignal_TCS_TimeSyncMessage_GroupSignal</SHORT-NAME>
              <LONG-NAME>
                <L-4 L="EN">TimeSyncMessageRxSignal</L-4>
              </LONG-NAME>
              <CATEGORY>STRUCTURE</CATEGORY>
              <SUB-ELEMENTS>
«FOREACH tcs.tcsGeneral.tCS_TimeSyncMessageSignalRef.parent.comGroupSignal AS single_signal-»
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
                  <CATEGORY>TYPE_REFERENCE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
«IF single_signal.comSignalType == "UINT8_N"-»
                        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_TCS/Component/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
«ELSE-»
                        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
«ENDIF-»
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
«ENDFOREACH-»
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
«FOREACH Tcs_SignalLengthList(tcs.tcsGeneral.tCS_TimeSyncMessageSignalRef.parent.comGroupSignal) AS sigSize-»
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>IMPL_LenNByte«sigSize»</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/SUM_TCS/Component/Bytes«sigSize»</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
            </IMPLEMENTATION-DATA-TYPE>
            <SW-BASE-TYPE>
              <SHORT-NAME>Bytes«sigSize»</SHORT-NAME>
              <CATEGORY>FIXED_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
              <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
              <MEM-ALIGNMENT>8</MEM-ALIGNMENT>
              <NATIVE-DECLARATION>Bytes_«sigSize»</NATIVE-DECLARATION>
            </SW-BASE-TYPE>
            <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>Bytes_«sigSize»</SHORT-NAME>
              <CATEGORY>STRUCTURE</CATEGORY>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>Array_«sigSize»</SHORT-NAME>
                  <CATEGORY>ARRAY</CATEGORY>
                  <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                  <SUB-ELEMENTS>
                    <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                      <SHORT-NAME>ArrayElement</SHORT-NAME>
                      <CATEGORY>TYPE_REFERENCE</CATEGORY>
                      <ARRAY-SIZE>«sigSize»</ARRAY-SIZE>
                      <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                      <SW-DATA-DEF-PROPS>
                        <SW-DATA-DEF-PROPS-VARIANTS>
                          <SW-DATA-DEF-PROPS-CONDITIONAL>
                            <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</IMPLEMENTATION-DATA-TYPE-REF>
                          </SW-DATA-DEF-PROPS-CONDITIONAL>
                        </SW-DATA-DEF-PROPS-VARIANTS>
                      </SW-DATA-DEF-PROPS>
                    </IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  </SUB-ELEMENTS>
                </IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
            </IMPLEMENTATION-DATA-TYPE>
«ENDFOREACH-»
«ENDIF-»
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
«ENDFILE»
«ENDDEFINE»
