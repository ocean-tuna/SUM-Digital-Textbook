#ifndef SUM_TCS_H
#define SUM_TCS_H

/* TimeSyncMessage reception mode indicators - used by unit tests to select the correct isolate stub */
«IF Tcs_IsTimeSyncServiceBased(tcs.tcsGeneral)-»
#define TCS_TIMESYNC_SERVICE_BASED_ENABLED (STD_ON)
«ELSE-»
#define TCS_TIMESYNC_SERVICE_BASED_ENABLED (STD_OFF)
«ENDIF-»
«IF Tcs_IsTimeSyncGroupSignal(tcs.tcsGeneral)-»
#define TCS_TIMESYNC_GROUP_SIGNAL_ENABLED (STD_ON)
«ELSE-»
#define TCS_TIMESYNC_GROUP_SIGNAL_ENABLED (STD_OFF)
«ENDIF-»
«IF Tcs_IsE2EConfigured(tcs.tcsGeneral, "TimeSyncMessage")-»
#define TCS_TIMESYNC_E2E_ENABLED (STD_ON)
«ELSE-»
#define TCS_TIMESYNC_E2E_ENABLED (STD_OFF)
«ENDIF-»

/* Public function prototypes*/
«IF tcs.tcsGeneral.tcsGenerateInitRunnable == false-»
#define TCS_RUNNABLE_INIT_ENABLED (STD_OFF)
extern void TCS_Init(void);
«ELSE-»
#define TCS_RUNNABLE_INIT_ENABLED (STD_ON)
«ENDIF-»

#endif  /* SUM_TCS_H */
«ENDFILE-»
«ENDDEFINE»
