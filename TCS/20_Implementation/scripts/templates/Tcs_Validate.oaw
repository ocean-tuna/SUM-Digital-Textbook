<workflow>
	<!-- Property file containing model package and generator version info -->
	<property file="Tcs_Workflow.properties"/>
	<component class="com.bosch.oawtypesystem.actions.BCTCheckComponent">
		<metaModel id="mm" class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<checkFile value="Tcs" />
		<emfAllChildrenSlot value="model"/>
		<warnIfNothingChecked value="false"/>
	</component>
</workflow>
