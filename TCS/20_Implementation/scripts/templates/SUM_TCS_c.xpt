/***********************************************************************************

  Function name :   TCS_Init
  Description   : TCS initialization routine, initialize local static variables
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   Satisfies: [$SDD_TCS 005], [$SDD_TCS 006], [$SDD_TCS 007], [$SDD_TCS 017], [$SDD_TCS 018], [$SDD_TCS 027] [$SDD_TCS 033]
 ************************************************************************************/
#define SUM_TCS_START_SEC_CODE
#include "SUM_TCS_MemMap.h"
«IF tcs.tcsGeneral.tcsGenerateInitRunnable == true-»
static FUNC(void,SUM_TCS_CODE) TCS_Init(void)
«ELSE-»
/* PRQA S 1503 1 # This function will and must be called by the BSW Init rule */
FUNC (void, SUM_TCS_CODE) TCS_Init(void) /* PRQA S 5087 EOF */
«ENDIF-»
{
    static boolean Sum_TCS_Initialization = FALSE;
    TimeSyncMessageType initTime;
    if (Sum_TCS_Initialization == FALSE)
	{
		/* Set Initialization status of TCS to INIT */
        Sum_TCS_Initialization = TRUE;

        /* initialize permit execution to false, if ready to run this will be reset in *
        * the TimeManagement function                                                 *
        */
        permit_execution = FALSE;

        /* initialize the precision counter, used to determine when to increment the local clock,
        * note SumTCSGlobalTimePrecision must be a multiple of TCS_t_TimeManagement_Periodicity,
        * i.e., s = nt where n = subCounter
        * This is checked in the validation script.
        */
        precisionCounter = ((uint32) SumTCSGlobalTimePrecision / (uint32) TCS_t_TimeManagement_Periodicity);

        /* read the stored initial clock value from NvM (5-byte big-endian to uint64) */
        initTime = TCS_Prv_getInitTime();

        /* save the initial clock value to the local clock */
        /* PRQA S 3432 2*/ /*It is not possible to use brackets here as per AUTOSAR concept. */
        Rte_IrvWrite_Runnable_TCS_TimeManagement_EA_Localtime_Clock(initTime);

        /* initialize the clock output port */
        TCS_Prv_output_timeSyncMsg(initTime);
    }
}
#define SUM_TCS_STOP_SEC_CODE
#include "SUM_TCS_MemMap.h"

