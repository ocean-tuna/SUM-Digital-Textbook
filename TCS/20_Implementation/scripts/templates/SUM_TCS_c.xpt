/***********************************************************************************

  Function name :   TCS_Prv_byteArray_to_uint64
  Description   :   Convert a big-endian byte array to a uint64 value
  Parameter in  :   in - pointer to a big-endian buffer (MSB first)
                    size - number of bytes to convert
  Parameter out :   None
  Return value  :   The time value as uint64
  Remarks       :   Endianness-independent via bit shifting.
 ************************************************************************************/
#define SUM_TCS_START_SEC_CODE
#include "SUM_TCS_MemMap.h" /* PRQA S 5087 EOF */ /* include SUM_TCS_MemMap.h required here for memory mapping */
static uint64 TCS_Prv_byteArray_to_uint64(const uint8* in, uint8 size)
{
    uint64 result = 0u;
    uint8 i;

    for (i = 0u; i < size; i++)
    {
        result = (result << 8u) | (uint64)in[i];
    }
    return result;
}
#define SUM_TCS_STOP_SEC_CODE
#include "SUM_TCS_MemMap.h"


/***********************************************************************************
  Function name :   TCS_Prv_increment_current_time
  Description   :   Increment the current time by the configured precision:
                    increment every precisionCounter by precisionCounter.
  Parameter in  :   A pointer to the TimeSyncMessageType (uint64) to increment
  Parameter out :   Overwrites the input parameter in place
  Return value  :   None
  Remarks       :   
 ************************************************************************************/
#define SUM_TCS_START_SEC_CODE
#include "SUM_TCS_MemMap.h"
static void TCS_Prv_increment_current_time(TimeSyncMessageType *currentTime)
{
    uint32 low = (uint32)(*currentTime & 0xFFFFFFFFuLL);
    uint8  high = (uint8)(*currentTime >> 32u);

    low += precisionCounter;
    if (low < (uint32)(*currentTime & 0xFFFFFFFFuLL))
    {
        /* Overflow occurred: increment the high byte */
        high++;
        /* Truncate the high byte to the 4 low bits */
        high &= SUM_TCS_TIMESYNCMESSAGE_HIGH_BITMASK;
    }
    *currentTime = ((uint64)high << 32u) | (uint64)low;
}
#define SUM_TCS_STOP_SEC_CODE
#include "SUM_TCS_MemMap.h"

/***********************************************************************************

  Function name :   TCS_Prv_uint64_to_byteArray
  Description   :   Convert a uint64 value to a 5-byte big-endian buffer
  Parameter in  :   in - the time value as uint64 (lower 40 bits used)
  Parameter out :   out - pointer to an existing buffer of at least 5 bytes
  Return value  :   None
  Remarks       :   Used for NvM write and DEM/DCM output. Endianness-independent.
 ************************************************************************************/
#define SUM_TCS_START_SEC_CODE
#include "SUM_TCS_MemMap.h"
static void TCS_Prv_uint64_to_byteArray(uint64 in, uint8* out)
{
    uint8 i;
    uint64 val = in;

    for (i = 0u; i < SUM_TCS_TIMESYNCMESSAGE_NVM_SIZE; i++)
    {
        out[SUM_TCS_TIMESYNCMESSAGE_NVM_SIZE - 1u - i] = (uint8)(val & 0xFFu);
        val >>= 8u;
    }
}
#define SUM_TCS_STOP_SEC_CODE
#include "SUM_TCS_MemMap.h"

