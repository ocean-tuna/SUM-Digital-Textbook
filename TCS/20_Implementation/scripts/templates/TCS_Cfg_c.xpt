#include "Rte_SUM_TCS.h"
#include "SUM_TCS_Cfg.h"

/*
** Access Function Pointers for NVM Blocks.
*/
/* PRQA S 1531 1 # The object is referred in one file but the possibility if the scope of the object needs to be visible outside of the file */
const Tcs_GenericNvmAccessType tcs_Nvm_TcsTimeValueBlock_FP =
{
&«tcs.tcsGeneral.tCSInitValueNvmRef.nvMRamBlockDataAddress-»[0],
&Rte_Call_RP_NvMService_TCSTimeValue_GetErrorStatus,
&Rte_Call_RP_NvMService_TCSTimeValue_SetRamBlockStatus,
&Rte_Call_RP_NvMService_TCSTimeValue_WriteBlock
};

«IF (tcs.tcsGeneral.timeManagementPeriodicity != null)-»
/* PRQA S 1533 1 # Configuration value, generated, in future can be used by other modules */
const uint16 TCS_t_TimeManagement_Periodicity = «tcs.tcsGeneral.timeManagementPeriodicity»u;
«ENDIF»

«IF (tcs.tcsGeneral.permitExecutionMask != null)-»
/* PRQA S 1533 1 # Configuration value, generated, in future can be used by other modules */
const uint32 TCS_PermitExecution_Mask = «tcs.tcsGeneral.permitExecutionMask.Hex()»u;	/* bit 0 is the WAKEUP bit */
«ENDIF»

/* SumTCSGlobalTimePrecision must be a non-zero multiple of TCS_t_TimeManagement_Periodicity */
«IF (tcs.tcsGeneral.sumTCSGlobalTimePrecision != null)-»
/* PRQA S 1533 1 # Configuration value, generated, in future can be used by other modules */
const uint16 SumTCSGlobalTimePrecision = «tcs.tcsGeneral.sumTCSGlobalTimePrecision»u;
«ENDIF»
«ENDFILE-»
«ENDDEFINE»
