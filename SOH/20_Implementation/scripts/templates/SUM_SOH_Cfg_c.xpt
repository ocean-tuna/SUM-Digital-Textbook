												}
											};
«ENDIF-»

«IF sOHGeneral.sOH_ShutdownDelay_SupportEnabled == true -»
/*!
 *	\Requirement{008}
 *		The Shutdown Delay Detector adopts the Threshold filter.
 *	\Satisfies{002}
 *
 *	The variables required by this detector to work with the Threshold filter are:
 *	\Requirement{002}
 *		- counter SUM_SOH_ShutDown_Cntr
 *	\Satisfies{002}
 *	\Requirement{003}
 *		- counter threshold SUM_SOH_ShutDown_Thresh
 *	\Satisfies{002}
 *	\Requirement{004}
 *		- DID counter SUM_SOH_DID_ShutDown_Cntr.
 *	\Satisfies{002} \Satisfies{022}
 *
 *	Additional variables required by the logic of the Shutdown detector (not part of this struct):
 *	\Requirement{005}
 *		- a 2-byte unsigned integer timer in seconds SUM_SOH_ShutDown_Timer to monitor the time the ECU is taking to shutdown
 *	\Satisfies{003} \Satisfies{020}
 *	\Requirement{006}
 *		- a ECU calibration shutdown threshold time SUM_SOH_ShutDown_Timer_Thresh.
 *	\Satisfies{021} \Satisfies{020}
 *	\Requirement{007}
 *		SUM_SOH_ShutDown_Timer is stored in a section of RAM cleared at any reset, so its value will be 0 even at ECU production.
 *	\Satisfies{003} \Satisfies{004}
 *
 *	Ports required by the logic of the Shutdown detector (not part of this struct):
 *	\Requirement{037}
 *		- SUSD_SOH_PermitExecution
 *	\Satisfies{028}
 *	\Requirement{038}
 *		- PNC_SUSD_ShutdownPermission.
 *	\Satisfies{028}
 *
 */
static SOH_DetectorType ShutdownDelay = {
											/* [$Satisfies $DDS_SOH 008] */
											SOH_ThresholdFiltering,
											SOH_AdaptiveNvM,
											/*SOH_ThresholdType Detector Values */
											{
												/* [$Satisfies $DDS_SOH 002] */
												&SUM_SOH_ShutDown_Cntr,
												NULL_PTR,
												/* [$Satisfies $DDS_SOH 004] */
												&SUM_SOH_DID_Shutdown_Cntr,
												/* [$Satisfies $DDS_SOH 003] */
												&Get_CData_SUM_SOH_Shutdown_Thresh,
												NULL_PTR,
												NULL_PTR
											},
											/*SOH_GenericNvmAccessType NvM Counter*/
											{
												&«sOHConfigSet.sOH_PlatformReliabilityMonitor.sOH_Shutdown.sOH_NvMShutdownCntr_Reference.nvMRamBlockDataAddress»,
												&Rte_Call_RP_SOH_NvMShutDownCntr_GetErrorStatus,
												&Rte_Call_RP_SOH_NvMShutDownCntr_SetRamBlockStatus,
												&Rte_Call_RP_SOH_NvMShutDownCntr_WriteBlock
											},
											/*SOH_GenericNvmAccessType NvM DID*/
											{
												&«sOHConfigSet.sOH_PlatformReliabilityMonitor.sOH_Shutdown.sOH_NvMShutdownDID_Reference.nvMRamBlockDataAddress»,
												&Rte_Call_RP_SOH_NvMShutDownDID_GetErrorStatus,
												&Rte_Call_RP_SOH_NvMShutDownDID_SetRamBlockStatus,
												&Rte_Call_RP_SOH_NvMShutDownDID_WriteBlock
											}
										};
«ENDIF-»

