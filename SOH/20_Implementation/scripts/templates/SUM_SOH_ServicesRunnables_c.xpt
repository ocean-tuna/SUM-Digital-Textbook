/**
 * Runnable_SOH_DID_F092_Data_ReplayCount_Cntr implementation.
 * Updates the DCM "data" array with the MAC Failures Type 3 DID Counter ( 2 bytes unsigned )
 *
 * @param[in]  DCM operation status
 * @param[out]  DCM data pointer
