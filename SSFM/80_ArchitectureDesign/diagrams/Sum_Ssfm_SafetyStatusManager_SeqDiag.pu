@startuml Sum_Ssfm_SafetyStatusManager_SeqDiag

participant RTE as R
participant DEM as DEM
box SUM_SSFM
    participant Sum_Ssfm_ReceivedSerialData_Handler as RecSigHdlr
    participant Sum_Ssfm_SecurityStatus_Manager as SecStatMgr
	participant Sum_Ssfm_SafetyStatusManager as SafStatMgr
    participant Sum_Ssfm_EventDebouncer_Manager as Debouncer
    participant Sum_Ssfm_FaultIndications_DataManager as FIM
    participant Sum_Ssfm_Service_Manager as SM
end box
participant SWC as S


activate S
activate SafStatMgr

alt Successful or No MAC verification  
    activate RecSigHdlr
        RecSigHdlr -> SafStatMgr: Ask to update the FsI interface
    deactivate RecSigHdlr
else Unsuccessful MAC verification
    SecStatMgr -> SafStatMgr: Update the SerialData FsI interface
end

opt single port FxI disabled
    SafStatMgr -> S: Update the SerialData FsI interface according to the FoI and FpI
end

SafStatMgr -> Debouncer: Debounce the error
Debouncer --> SafStatMgr: Debouncing Status

alt debouncer failed
    SafStatMgr -> SM: Resolve Service DTC
    SafStatMgr -> DEM: Set DTC
else
    SafStatMgr -> FIM: Ask for multiplexing
end

deactivate SafStatMgr
deactivate S

@enduml 