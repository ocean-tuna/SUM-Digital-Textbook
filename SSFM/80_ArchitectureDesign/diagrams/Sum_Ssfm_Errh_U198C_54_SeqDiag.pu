@startuml Sum_Ssfm_Errh_U198C_54_SeqDiag

participant Dem 
box SUM_SSFM
    participant Sum_Ssfm_Errh_U198C_54_Handler as ERRH_U198C_54
end box
participant Sum_SSC as SSC
participant Sum_DIAG as DIAG

activate ERRH_U198C_54
SSC -> ERRH_U198C_54: Notification about change in the \n status of the DTC U198C 54
ERRH_U198C_54 -> ERRH_U198C_54: Check if calibration parameter is set

alt ResetPowerUpRecoveryTimerFlag & BatteryVoltageRecoveryTimerFlag
    ERRH_U198C_54 -> SSC: Ask for DTC 198C 54 status
    SSC --> ERRH_U198C_54
    alt status == FALSE
        ERRH_U198C_54 -> Dem: reset the U198C_54 DTC
    else 
        ERRH_U198C_54 -> ERRH_U198C_54: Apply X/Y debouncing filter
        DIAG --> ERRH_U198C_54
        alt Debouncing result valid
            ERRH_U198C_49 -> Dem: set/reset the U198C_54 DTC
        end
    end
end

deactivate ERRH_U198C_54

@enduml 