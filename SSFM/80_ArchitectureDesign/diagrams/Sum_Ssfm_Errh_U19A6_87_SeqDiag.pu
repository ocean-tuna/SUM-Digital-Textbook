@startuml Sum_Ssfm_Errh_U19A6_87_SeqDiag

participant Dem 
box SUM_SSFM
    participant Sum_Ssfm_Errh_U19A6_87_Handler as ERRH_U19A6_87
end box
participant Sum_SUSD as SUSD
participant Sum_SrvcMgr as SrvcMgr

activate ERRH_U19A6_87

ERRH_U19A6_87 -> ERRH_U19A6_87: Check if calibration parameter is set

alt Calibration parameter is set
    ERRH_U19A6_87 -> SUSD: Ask for battery voltage range
    SUSD --> ERRH_U19A6_87
	
    alt (No OBD Support and voltage in range) or (OBD Support and not under voltage)

        ERRH_U19A6_87 -> SrvcMgr: Ask "learning table state"
        SrvcMgr --> ERRH_U19A6_87

        alt LearningTableState == SUM_RID_0654_STATUS_COMPLETE || LearningTableState == SUM_RID_0654_STATUS_INCOMPLETE
            alt error is Missing Message
                ERRH_U19A6_87 -> SrvcMgr: Notify missing ServiceId (SSFM_SrvcMgr_SDMissingMessage)
                ERRH_U19A6_87 -> Dem: set the U19A6_87 DTC
            else no error
                ERRH_U19A6_87 -> Dem: reset the U19A6_87 DTC
            end
        end		
    end
end

deactivate ERRH_U19A6_87

@enduml 