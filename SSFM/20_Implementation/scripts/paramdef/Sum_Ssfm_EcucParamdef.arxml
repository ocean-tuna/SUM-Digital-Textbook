                          <SUB-CONTAINERS>
                            <ECUC-PARAM-CONF-CONTAINER-DEF>
                              <SHORT-NAME>Sum_Ssfm_LNM_ResponderInfoError</SHORT-NAME>
                              <LONG-NAME/>
                              <DESC>
                                <L-2 L="EN">List of all LNM reported errors of Network Responder(s) information type</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                              <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                              <PARAMETERS>
                                <ECUC-ENUMERATION-PARAM-DEF>
                                  <SHORT-NAME>Sum_Ssfm_LNM_ResponderInfoErrorType</SHORT-NAME>
                                  <LONG-NAME/>
                                  <DESC>
                                    <L-2>Enumerative value to specify the type of LNM Network Responder Information Error Type:
													- SSFM_LNM_RESPONDER_IEF 		    = Internal Electronic Fault;
													- SSFM_LNM_RESPONDER_MISSING_MSG    = Missing Message Error;
													- SSFM_LNM_RESPONDER_MISSING_CAL    = Missing Calibration Error;
													- SSFM_LNM_RESPONDER_NOT_CONFIGURED = Not Configured Sensor;</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                  <LITERALS>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>SSFM_LNM_RESPONDER_IEF</SHORT-NAME>
                                      <LONG-NAME/>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>SSFM_LNM_RESPONDER_MISSING_MSG</SHORT-NAME>
                                      <LONG-NAME/>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>SSFM_LNM_RESPONDER_MISSING_CAL</SHORT-NAME>
                                      <LONG-NAME/>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                    <ECUC-ENUMERATION-LITERAL-DEF>
                                      <SHORT-NAME>SSFM_LNM_RESPONDER_NOT_CONFIGURED</SHORT-NAME>
                                      <LONG-NAME/>
                                    </ECUC-ENUMERATION-LITERAL-DEF>
                                  </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                              </PARAMETERS>
                              <REFERENCES>
                                <ECUC-REFERENCE-DEF>
                                  <SHORT-NAME>Sum_Ssfm_LNMResponderErr_EventFilter_Ref</SHORT-NAME>
                                  <DESC>
