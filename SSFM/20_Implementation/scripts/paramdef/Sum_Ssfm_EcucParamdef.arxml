                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_SSFM/EcucModuleDefs/SSFM/Sum_Ssfm_ConfigSet/Sum_Ssfm_SerialData</DESTINATION-REF>
                                  </DESTINATION-REFS>
                                </ECUC-CHOICE-REFERENCE-DEF>
                              </REFERENCES>
                            </ECUC-PARAM-CONF-CONTAINER-DEF>
                            <ECUC-PARAM-CONF-CONTAINER-DEF>
                              <SHORT-NAME>Sum_Ssfm_LINInfo_Event</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This sub container contains Dem event for Internal Electronic Fault and signaling invalid data of a LIN Responder.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <REFERENCES>
                                <ECUC-REFERENCE-DEF>
                                  <SHORT-NAME>Sum_Ssfm_IeF_DemEvent_Ref</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to the Dem event that should keep track of the Internal Electronic Fault Error Code for the referenced LIN Responder.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dem/EcucModuleDefs/Dem/DemConfigSet/DemEventParameter</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                                <ECUC-REFERENCE-DEF>
                                  <SHORT-NAME>Sum_Ssfm_MissingMsg_DemEvent_Ref</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to the Dem event that should keep track of the Missing Message Error Code for the referenced LIN Responder.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dem/EcucModuleDefs/Dem/DemConfigSet/DemEventParameter</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                                <ECUC-REFERENCE-DEF>
                                  <SHORT-NAME>Sum_Ssfm_InvalidData_DemEvent_Ref</SHORT-NAME>
                                  <DESC>
                                    <L-2 L="EN">Reference to the Dem event that should keep track of invalid data event for the referenced LIN SerialData channel.</L-2>
                                  </DESC>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dem/EcucModuleDefs/Dem/DemConfigSet/DemEventParameter</DESTINATION-REF>
                                </ECUC-REFERENCE-DEF>
                              </REFERENCES>
