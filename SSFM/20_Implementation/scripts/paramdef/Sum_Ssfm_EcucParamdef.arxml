                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                      </SUB-CONTAINERS>
                    </ECUC-PARAM-CONF-CONTAINER-DEF>
                    <ECUC-PARAM-CONF-CONTAINER-DEF>
                      <SHORT-NAME>Sum_Ssfm_ErrorsHandlers</SHORT-NAME>
                      <LONG-NAME/>
                      <DESC>
                        <L-2 L="EN">List of all configured errors that are handled by Errh submodule of SSFM.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <SUB-CONTAINERS>
                        <ECUC-PARAM-CONF-CONTAINER-DEF>
                          <SHORT-NAME>Sum_Ssfm_Errh_BswError</SHORT-NAME>
                          <LONG-NAME/>
                          <DESC>
                            <L-2 L="EN">List all configured BSW events that shall be debounced by Errh as possible errors.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                          <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                          <PARAMETERS>
                            <ECUC-BOOLEAN-PARAM-DEF>
                              <SHORT-NAME>Sum_Ssfm_Errh_C_BswDTCProcess</SHORT-NAME>
                              <LONG-NAME/>
                              <DESC>
                                <L-2 L="EN">Boolean flag for controlling whether to process DTC</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <IMPLEMENTATION-CONFIG-CLASSES>
                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              </IMPLEMENTATION-CONFIG-CLASSES>
                              <ORIGIN>GM_ECUC</ORIGIN>
                              <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                              <DEFAULT-VALUE>true</DEFAULT-VALUE>
                            </ECUC-BOOLEAN-PARAM-DEF>
                            <ECUC-ENUMERATION-PARAM-DEF>
                              <SHORT-NAME>Sum_Ssfm_BswEventType</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Describes BswEvent/bitmap which are routed from SSFM-ERRH to the SUM_SOH for processing.

											Bit 0 == NVM_E_HARDWARE,
											Bit 1 == NVM_E_INTEGRITY_FAILED,
											Bit 2 == NVM_E_REQ_FAILED,
											Bit 3 == NVM_E_WRONG_BLOCK_ID,
											Bit 4 == NVM_E_VERIFY_FAILED,
											Bit 5== NVM_E_LOSS_OF_REDUNDANCY,
											Bit 6 == NVM_E_QUEUE_OVERFLOW,
											Bit 7 == NVM_E_WRITE_PROTECTED,
											Bit 8 == WDGM_E_SUPERVISION,
											Bit 9 == WDGM_E_SET_MODE,
											Bit 10 till Bit 31== Reserved.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <LITERALS>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_HARDWARE</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_INTEGRITY_FAILED</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_REQ_FAILED</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_WRONG_BLOCK_ID</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_VERIFY_FAILED</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_LOSS_OF_REDUNDANCY</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_QUEUE_OVERFLOW</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>NVM_E_WRITE_PROTECTED</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>WDGM_E_SUPERVISION</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                                <ECUC-ENUMERATION-LITERAL-DEF>
                                  <SHORT-NAME>WDGM_E_SET_MODE</SHORT-NAME>
                                </ECUC-ENUMERATION-LITERAL-DEF>
                              </LITERALS>
                            </ECUC-ENUMERATION-PARAM-DEF>
                          </PARAMETERS>
                          <REFERENCES>
                            <ECUC-REFERENCE-DEF>
                              <SHORT-NAME>Sum_Ssfm_Errh_BSWErr_EventFilter_Ref</SHORT-NAME>
                              <LONG-NAME/>
                              <DESC>
                                <L-2 L="EN">Reference to the SSFM associated error filter.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_SSFM/EcucModuleDefs/SSFM/Sum_Ssfm_ConfigSet/Sum_Ssfm_ErrorFilter/Sum_Ssfm_Errh_GeneralEventsFilter</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                            <ECUC-REFERENCE-DEF>
                              <SHORT-NAME>Sum_Ssfm_EventIdToUpdateError_ref</SHORT-NAME>
                              <LONG-NAME/>
                              <DESC>
                                <L-2 L="EN">Reference to the associated DEM event for filtering.(I/P)</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <IMPLEMENTATION-CONFIG-CLASSES>
                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              </IMPLEMENTATION-CONFIG-CLASSES>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dem/EcucModuleDefs/Dem/DemConfigSet/DemEventParameter</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                            <ECUC-REFERENCE-DEF>
                              <SHORT-NAME>Sum_Ssfm_EventIdForSettingDTC_ref</SHORT-NAME>
                              <LONG-NAME/>
                              <DESC>
                                <L-2 L="EN">Reference for the associated DEM event that sets the DTC for this relevant error(O/P).</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <IMPLEMENTATION-CONFIG-CLASSES>
                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              </IMPLEMENTATION-CONFIG-CLASSES>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dem/EcucModuleDefs/Dem/DemConfigSet/DemEventParameter</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                            <ECUC-REFERENCE-DEF>
                              <SHORT-NAME>Sum_Ssfm_Channel_Ref</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Reference to Sum_Ssfm_Channel, Needed to publish Bus off errors</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                              <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                              <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_SSFM/EcucModuleDefs/SSFM/Sum_Ssfm_Channel</DESTINATION-REF>
                            </ECUC-REFERENCE-DEF>
                          </REFERENCES>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <ECUC-PARAM-CONF-CONTAINER-DEF>
                          <SHORT-NAME>Sum_Ssfm_Errh_LNMErrors</SHORT-NAME>
                          <LONG-NAME/>
                          <DESC>
                            <L-2 L="EN">List all configured LNM events that shall be debounced by Errh as possible errors.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
