                    <ECUC-PARAM-CONF-CONTAINER-DEF>
                      <SHORT-NAME>Sum_Ssfm_SerialData</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">It contains the parameters related to the Ethernet/CAN SerialData.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                      <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                      <PARAMETERS>
                        <ECUC-BOOLEAN-PARAM-DEF>
                          <SHORT-NAME>Sum_Ssfm_IsNonDiscoverable</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Identifies if this SerialData represents a non-discoverable SOME/IP service (signal-based PDU using SOME/IP transformer). Non-discoverable services are always available, bypass partial network conditions, and only report Security and Safety diagnostics.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
