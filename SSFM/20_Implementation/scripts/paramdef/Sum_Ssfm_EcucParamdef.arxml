        			<ECUC-PARAM-CONF-CONTAINER-DEF>
        			  <SHORT-NAME>RteSerialData</SHORT-NAME>
        				<DESC>
        				  <L-2 L="EN">Configuration of an individual serial data corresponding to a protected signal/signalGroup.</L-2>
        				</DESC>
        				<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
        				<UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
        				<DESTINATION-URI-REFS>
        				  <DESTINATION-URI-REF DEST="ECUC-DESTINATION-URI-DEF">/AUTOSAR_Rte/EcucDestinationUriDefSets/RteUriDefSet/RteSerialData</DESTINATION-URI-REF>
        				 </DESTINATION-URI-REFS>
        				<ORIGIN>ETAS</ORIGIN>
        				<PARAMETERS>
        				  <!-- PARAMETER DEFINITION: RteSerialDataE2EInTransformerChain -->
        				  <ECUC-BOOLEAN-PARAM-DEF>
        					<SHORT-NAME>RteSerialDataE2EInTransformerChain</SHORT-NAME>
        					<DESC>
        					  <L-2 L='EN'> If the E2E transformer is configured, this parameter must be set to True, otherwise to False. If True, the Rte will pass the transformerError to the RteSerialData.RteCallBackFunction.</L-2>
        					</DESC>
        					<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
        					<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
        					<SCOPE>LOCAL</SCOPE>
        					<ORIGIN>ETAS</ORIGIN>
        					<VALUE-CONFIG-CLASSES>
        					<ECUC-VALUE-CONFIGURATION-CLASS>
        					  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
        					  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
        					</ECUC-VALUE-CONFIGURATION-CLASS>
        					</VALUE-CONFIG-CLASSES>
        					<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
        					<DEFAULT-VALUE>false</DEFAULT-VALUE>
        				  </ECUC-BOOLEAN-PARAM-DEF>
        				  <!-- PARAMETER DEFINITION: RteSerialDataHeaderInclude -->
        				  <ECUC-STRING-PARAM-DEF>
        					<SHORT-NAME>RteSerialDataHeaderInclude</SHORT-NAME>
        					<DESC>
        					  <L-2 L="EN">Defines the header file where the serial data provides the function declarations for configured callbacks.</L-2>
        					</DESC>
        					<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
        					<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
        					<SCOPE>LOCAL</SCOPE>
        					<MULTIPLICITY-CONFIG-CLASSES>
        					  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
        					  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        					  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
        					  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        					</MULTIPLICITY-CONFIG-CLASSES>
        					<ORIGIN>ETAS</ORIGIN>
        					<POST-BUILD-VARIANT-VALUE>false</POST-BUILD-VARIANT-VALUE>
        					<VALUE-CONFIG-CLASSES>
        					  <ECUC-VALUE-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
        					  </ECUC-VALUE-CONFIGURATION-CLASS>
        					  <ECUC-VALUE-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
        					  </ECUC-VALUE-CONFIGURATION-CLASS>
        					</VALUE-CONFIG-CLASSES>
        					<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
        					<ECUC-STRING-PARAM-DEF-VARIANTS>
        					  <ECUC-STRING-PARAM-DEF-CONDITIONAL/>
        					</ECUC-STRING-PARAM-DEF-VARIANTS>
        				  </ECUC-STRING-PARAM-DEF>
        				  <!-- PARAMETER DEFINITION: RteCallBackFunction -->
        				  <ECUC-FUNCTION-NAME-DEF>
        					<SHORT-NAME>RteCallBackFunction</SHORT-NAME>
        					<DESC>
        					  <L-2 L="EN">Definition of the Callback function provided by module which is interested in the serial data.</L-2>
        					</DESC>
        					<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
        					<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
        					<SCOPE>LOCAL</SCOPE>
        					<MULTIPLICITY-CONFIG-CLASSES>
        					  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
        					  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        					  <ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
        					  </ECUC-MULTIPLICITY-CONFIGURATION-CLASS>
        					</MULTIPLICITY-CONFIG-CLASSES>
        					<ORIGIN>ETAS</ORIGIN>
        					<POST-BUILD-VARIANT-MULTIPLICITY>true</POST-BUILD-VARIANT-MULTIPLICITY>
        					<POST-BUILD-VARIANT-VALUE>true</POST-BUILD-VARIANT-VALUE>
        					<VALUE-CONFIG-CLASSES>
        					  <ECUC-VALUE-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
        					  </ECUC-VALUE-CONFIGURATION-CLASS>
        					  <ECUC-VALUE-CONFIGURATION-CLASS>
        						<CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
        						<CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
        					  </ECUC-VALUE-CONFIGURATION-CLASS>
        					</VALUE-CONFIG-CLASSES>
        					<SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
        					<ECUC-FUNCTION-NAME-DEF-VARIANTS>
        					  <ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
        						<DEFAULT-VALUE>"NULL"</DEFAULT-VALUE>
        					  </ECUC-FUNCTION-NAME-DEF-CONDITIONAL>
        					</ECUC-FUNCTION-NAME-DEF-VARIANTS>
        				  </ECUC-FUNCTION-NAME-DEF>
        				</PARAMETERS>
        				<SUB-CONTAINERS>
        				  <!-- Container Definition: RteSignal -->
        				  <ECUC-PARAM-CONF-CONTAINER-DEF>
        					<SHORT-NAME>RteSignal</SHORT-NAME>
        					<DESC>
        					  <L-2 L="EN">Reference to the signal in the system description.</L-2>
        					</DESC>
        					<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
        					<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
        					<SUB-CONTAINERS>
        					  <!-- Choice Container Definition: RteSignalChoice -->
        					  <ECUC-CHOICE-CONTAINER-DEF>
        						<SHORT-NAME>RteSignalChoice</SHORT-NAME>
        						<DESC>
        						  <L-2 L="EN">Choice whether an ISignal or an ISignalGroup shall be referenced.</L-2>
        						</DESC>
        						<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
        						<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
        						<CHOICES>
        						  <!-- Container Definition: RteISignalRefChoice -->
        						  <ECUC-PARAM-CONF-CONTAINER-DEF>
        							<SHORT-NAME>RteISignalRefChoice</SHORT-NAME>
        							<DESC>
        							  <L-2 L="EN">Reference to the ISignal in the system description.</L-2>
