                            <ECUC-PARAM-CONF-CONTAINER-DEF>
                              <SHORT-NAME>Sum_Ssfm_ECUInfo_Event</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">This sub container contains mappings between channels of serial datas and Dem events for LossOfCommunication and signaling invalid data on the same serial datas.</L-2>
                              </DESC>
                              <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
