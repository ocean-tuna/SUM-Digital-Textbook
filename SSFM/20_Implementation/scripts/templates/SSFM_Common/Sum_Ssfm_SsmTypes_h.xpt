	/*! 2 = Signal Status Supervision Received */
	SUM_SSFM_SigSts_Supervision_Received
} Sum_Ssfm_SigStatusSupervision;

typedef enum Sum_Ssfm_SigStatusType
{
	/*! 0 = Signal Status Disabled */
	SUM_SSFM_SigSts_Disabled,
	/*! 1 = Signal Status Uninitialized */
	SUM_SSFM_SigSts_Uninitialized,
	/*! 2 = Signal Status Unavailable */
	SUM_SSFM_SigSts_Unavailable,
	/*! 3 = Signal Status Available */
