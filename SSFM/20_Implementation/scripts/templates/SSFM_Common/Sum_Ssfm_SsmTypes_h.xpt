/** @brief Enum for SSFM Execution Status values */
typedef enum Sum_Ssfm_ExecutionStatusType
{
	SUM_SSFM_Run_Mode      = 0x00u ,
	SUM_SSFM_Shutdown_Mode = 0x01u,
	SUM_SSFM_Invalid_Mode  = 0xffu
} Sum_Ssfm_ExecutionStatus;

typedef enum Sum_Ssfm_SigStatusSupervisionType
{
	/*! 0 = Signal Status Supervision Uninitialized */
	SUM_SSFM_SigSts_Supervision_Uninitialized,
	/*! 1 = Signal Status Supervision Timeout */
