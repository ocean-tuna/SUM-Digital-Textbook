struct Sum_Ssfm_MessageInfoGroupType
{
	/*! Pointer to array of function pointers to read the Rx enable state from Partial network id */
	P2CONST(FP_Rte_Read_RP_PNC_RxStatus_Sig, TYPEDEF, RTE_CODE) pSigRxStatus;
	/* Number of participated partial networks */
	uint8 No_Of_PNs;
	/* Pointer to array of pointers to the Sum_Ssfm_PnInformation structure describing each participated partial network */
	Sum_Ssfm_PnInformation ** PN_Info_ptr;
	/*! DTC setting enabling flag for participated partial networks */
	Sum_Ssfm_PnDtcEnabledStatus PN_DTC_Enabled_Flag;
	/*! Pointer to read status of diagnostics normal communication from Channel ID */
	FUNC(Std_ReturnType, RTE_CODE) (*FP_Rte_Read_RP_DisableNormalComm_Status)(SUM_DiagNormalCom_ModeType*);
	/*! Pointer to PDU structure to read for Disable Rx PDU */
	FUNC(boolean, RTE_CODE) (*FP_SSFM_pCdata_Type)(void);
	/*! Pointer to a function to write Signal status to be notified to SWC */
	FUNC(Std_ReturnType, RTE_CODE) (*FP_RxMonitoredSignal_Av)(uint8 data);
	/* enum signal supervision status */
	Sum_Ssfm_SigStatusSupervision SigSts_Supervision;
	/* enum signal status */
	Sum_Ssfm_SigStatus SigSts;
	/* The timestamp in which message went unavailable, in unit of Ticks */
	uint32 UnavailableSince;
	/* The time in ms this message was Unavailable the previous session, in unit of ms */
	uint16 UnavailableTimePrevSession;
	/* The number of times the status became Unavailable (For DID E0B8)*/
	uint16 UnavailableCount;
};

