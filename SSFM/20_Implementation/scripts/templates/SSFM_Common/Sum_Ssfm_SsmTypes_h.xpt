/** @brief Macro to define code shutdown enable to be provided to SUSD */
#define SUM_SSFM_ENABLE_SHUTDOWN 					(uint8)0xFFu
/** @brief Macro to check for Reset bit(bit 6) in Permit execution to enable/disable shutdown */
#define SUM_SSFM_RESETBIT_MASK 						(uint8)0xBFu
/** @brief Macro addresses the Permit Execution value has passed the masking operation */
#define SUM_SSFM_EXEC_MASKING_PASSED				(uint8)0xFFu
/** @brief Macro addresses the SSFM/SSM module as uninitialized */
#define SUM_SSFM_UNINIT								(boolean)0x00
/** @brief Macro addresses the SSFM/SSM module as initialized */
#define SUM_SSFM_INIT								(boolean)0x01u

#define SUM_SSFM_ERRH_MAX_RESET_TIMER           5000u
#define SUM_SSFM_MS_TO_US_UNIT					1000u


#define ECU_NODE_STATUS_NO_MISSINGMSG FALSE
#define ECU_NODE_STATUS_MISSINGMSG TRUE

/* bit 0: TestFailed */
#define SSFM_DEM_TF_DTC_BITMASK           0x01u
/* bit 3: ConfirmedDTC */
#define SSFM_DEM_CONFIRMED_DTC_BITMASK    0x08u
/* bit 0 and bit 6: TestFailed and TestNotCompletedThisOperationCycle bit */
#define SSFM_DEM_TF_TNCTOC_DTC_BITMASK       0x41u

/**
 * @brief Diagnostic Trouble Codes (DTC) Status Bit Positions
 *
 * These macros define the bit positions for various DTC statuses. Each macro corresponds
 * to a specific status bit within the DTC status byte/word. These statuses are used to
 * indicate the results of diagnostic tests or the state of the system.
 */

/*Bit position indicating the test has failed.*/
#define SSFM_DEM_TESTFAILED             0u
/*Bit position indicating the test has failed this operation cycle.*/
#define SSFM_DEM_TESTFAILED_TOC         1u
/*Bit position for a pending DTC, indicating that an error was detected but it is not yet considered confirmed.*/
#define SSFM_DEM_PENDINGDTC             2u
/*Bit position for a confirmed DTC, indicating the error has been confirmed and is considered a fault.*/
#define SSFM_DEM_CONFIRMEDDTC           3u
/*Bit position indicating the test is not complete since last clear. This means the diagnostic test has not run to completion since the last time DTCs were cleared.*/
#define SSFM_DEM_TESTNOTCOMPLETE_SLC    4u
/*Bit position indicating the test has failed since last clear. This represents a failure that has occurred since the last time DTCs were cleared.*/
#define SSFM_DEM_TESTFAILED_SLC         5u
/*Bit position indicating the test has not completed this operation cycle. This means the diagnostic test has not run to completion during the current operation cycle.*/
#define SSFM_DEM_TESTNOTCOMPLETE_TOC    6u
/*Bit position used to control the warning indicator lamp. When set, it may trigger a warning light on the vehicle's dashboard.*/
#define SSFM_DEM_WARNINGINDICATOR       7u

«IF sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_BswError.size > 0-»
/** @brief Macro for bsw error channel type */
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_BswError AS DEM_EVENT ITERATOR i-»
«IF DEM_EVENT.sum_Ssfm_Channel_Ref != null-»
#define SUM_SSFM_BSW_Error_«DEM_EVENT.sum_Ssfm_Channel_Ref.shortName-»	«i.counter0-»u
«ENDIF-»
«ENDFOREACH-»
«ENDIF-»

