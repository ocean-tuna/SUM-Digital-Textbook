	/* Function pointer to Rte_Read SSFM_LNM_NodeStatusTimer function call */
	Std_ReturnType (*Rte_Read_LNM_SSFM_NodeStatusTimer)(uint32* Timer);
	/* Function pointer to Rte_Read function call */
	Std_ReturnType (*Rte_Read_LNM_SSFM_IntElectFault)(uint8* data);
	/* Number of LIN Signals for this LIN Slave ECU */
   	uint8 NoOfLINSignals;
   	/* Pointer to the list of LIN Signals List */
	const Sum_Ssfm_LINSignalInfo** pLINSignalInfo;
	/* Internal state of LIN Responder */
	Sum_Ssfm_EcuNodeState LinRespState;
	/* Elapsed time */
	uint32 TimerElapsed;
	/* LNM_ErrorStatus */
	uint8 error_status;
};

