#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"


/* PRQA S 1503 EOF # The following functions will be scheduled by OS Tasks */

/**
 * @brief			Runnable function for the Execution Manager.
 *					Entry point of the module. It's called periodicly by the RTE.
 *
 *
 * @param[in]		None
 * @param[inout]	None
 * @param[out]		None
 * @return			void
 */
 /*[$Satisfies $DDS_SSFM 001]*/
FUNC(void, SUM_SSFM_CODE) Runnable_SSFM_ExecutionManager(void)
{
	/* Evaluate the requesting execution mode for ERRH */
	 Sum_Ssfm_prv_ErrhExecutionManager();
	/* Evaluate the requesting execution mode for SSM */
	Sum_Ssfm_prv_SsmExecutionManager();
}

#define SUM_SSFM_STOP_SEC_CODE
