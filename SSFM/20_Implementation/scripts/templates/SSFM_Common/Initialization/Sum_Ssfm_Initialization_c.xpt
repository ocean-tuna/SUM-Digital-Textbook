 */
static boolean Sum_Ssfm_SsmInitialization = FALSE;

/**
 *  @brief Variable for initialization status of Errh
 *  @private
 */
static boolean Sum_Ssfm_ErrhInitialization = FALSE;


/*
 *********************************************************************************************************************************************************
