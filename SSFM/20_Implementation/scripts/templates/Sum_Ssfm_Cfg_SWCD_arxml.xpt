	            </R-PORT-PROTOTYPE>
«ENDFOREACH-»
«IF Sum_Ssfm_Errh_U19A3_57_PreCondition_IsValid(sum_Ssfm_ConfigSet) -»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSC_SSFM_ERRH_DTC_U19A3_57_Status</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SSC_ERRH_DTC_U19A3_57_Status</REQUIRED-INTERFACE-TREF>
