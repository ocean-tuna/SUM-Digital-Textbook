                </R-PORT-PROTOTYPE>
				        <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SUSD_SSFM_Errh_BatteryVoltage_BatteryVoltageRangeMinToMax</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/BatteryVoltageRangeMinToMax</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«IF Sum_Ssfm_Errh_U19A6_54_IsValid(sum_Ssfm_ConfigSet) -»
				        <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SrvcMgr_Errh_U19A6_54_Status</SHORT-NAME>
