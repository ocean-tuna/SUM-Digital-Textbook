                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dem/PortInterfaces/DiagnosticMonitor</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ENDFOREACH-»
«REM» Create separate MACAuthenticationEnabled ports for each Rx secured message «ENDREM»
«FOREACH sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.select(e | e.Ssfm_IsAuthenticated()) AS SSFM_SERIAL_DATA-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSFM_SSM_SerialData_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()»_MACAuthenticationEnabled</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/MACAuthenticationEnabled</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ENDFOREACH»

                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_NvM_SSFM_NvMService_DID_E0B8_Data</SHORT-NAME>
