«FOREACH sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.sum_Ssfm_Partial_Network_Ref.toSet() AS SSFM_PN_Ref-»
        <R-PORT-PROTOTYPE>
                <SHORT-NAME>RP_SUM_PNC_SSFM_PnDtcAllowed_«SSFM_PN_Ref.comMPncId»</SHORT-NAME>
                <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/PN_DTC_Allowed</REQUIRED-INTERFACE-TREF>
