«ENDIF-»
«ENDIF-»
«ENDFOREACH-»
«ENDIF-»
«IF Ssfm_AnyServiceBased(sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SPM_SSFM_ServiceActivationStatusNotification</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SPM_ServiceActivationStatusNotification</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ENDIF-»
«IF ((Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(sum_Ssfm_ConfigSet) != 0) && (Sum_Ssfm_Errh_U19A3_8A_PreCondition_IsValid(sum_Ssfm_ConfigSet) == true))»
	«FOREACH sum_Ssfm_ConfigSet.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_KeySlotVerifyFilter.sum_Ssfm_Errh_KeySlotNumber AS ssc_keyslotverify-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSC_SSFM_E_KeySlotVerify_«ssc_keyslotverify.shortName»</SHORT-NAME>
                  <REQUIRED-COM-SPECS>
                    <QUEUED-RECEIVER-COM-SPEC>
                      <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/SSC_E_KeySlotVerify/E_KeySlotVerify</DATA-ELEMENT-REF>
                      <HANDLE-OUT-OF-RANGE>NONE</HANDLE-OUT-OF-RANGE>
                      <QUEUE-LENGTH>«ssc_keyslotverify.sum_Ssfm_Errh_KeySlotVerify_QueueLength»</QUEUE-LENGTH>
                    </QUEUED-RECEIVER-COM-SPEC>
                  </REQUIRED-COM-SPECS>
