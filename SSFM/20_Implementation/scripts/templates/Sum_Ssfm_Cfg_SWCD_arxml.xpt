                </R-PORT-PROTOTYPE>
«ENDIF-»
«ENDFOREACH-»
«IF !sum_Ssfm_General.sum_Ssfm_IsThisECUGateway-»
«FOREACH Ssfm_GetControllerECUInfos(ECUs, true) AS controller-»
«IF !controller.getProperty("is_CGM")-»
«IF !controller.getProperty("is_all_direct")-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSFM_NodeStsECU_«controller.getProperty("name")»_LcFA</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/SUM_SSFM/Component/SSFM_IF_NodeStsECU_LcFA</REQUIRED-INTERFACE-TREF>
