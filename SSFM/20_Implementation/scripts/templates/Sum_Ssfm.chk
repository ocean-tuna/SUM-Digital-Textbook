	(this.rteSignal.rteSignalChoice.rteISignalGroupRefChoice != null || this.rteSignal.rteSignalChoice.rteISignalRefChoice != null)
;
/* Check the configuration of the RteISignalGroupRef */
context Sum_Ssfm_RteSerialData
