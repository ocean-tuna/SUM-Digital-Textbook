    ERROR "SUM_SSFM: DCM DcmDspDataByteSize for DID 0xE0B8 is invalid: (length-1) must be divisible by 10 (required format: 1 + N*10)." :
    (Ssfm_DID_E0B8_IsDcmLengthFormatValid(this))
