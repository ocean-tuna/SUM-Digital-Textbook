	 ((Integer)(this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SUSDErrors.Sum_Ssfm_Errh_SUSD_RunCrankHIGH_DiagStatus.sum_Ssfm_Errh_SUSD_RCHigh_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y"))) +
	 ((Integer)(this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SUSDErrors.sum_Ssfm_SUSD_RunCrankLOW_DiagStatus.sum_Ssfm_Errh_SUSD_RCLow_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y"))) +
	 (this.sum_Ssfm_ErrorsHandlers.Sum_Ssfm_Errh_SSMInternalFIErrors.sum_Ssfm_SsmMeasureFailed.select(e|e.sum_Ssfm_SsmMeasureFailed_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y")).size)
	))
;
// Case 3: susd not present; lnm, ssm present
context Sum_Ssfm_ConfigSet
if this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_LNMErrors != null && this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SUSDErrors == null && this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SSMInternalFIErrors != null
	ERROR "SUM_SSFM: The number of configured filters with XofY type and the numbers of referenced ones from Handlers don't match. Please removed unused filter, or check if you referenced the same XofY filter in more than one handler." :
	((this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_GeneralEventsFilter.select(e|e.sum_Ssfm_FilterType.contains("X_OF_Y")).size) == (
	 (this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_BswError.select(e|e.sum_Ssfm_Errh_BSWErr_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y")).size) +
	 (this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_LNMErrors.sum_Ssfm_LNM_NetworkError.select(e|e.sum_Ssfm_Errh_LNMNetworkErr_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y")).size) +
	 (this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_LNMErrors.sum_Ssfm_LNM_ResponderInfoError.select(e|e.sum_Ssfm_LNMResponderErr_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y")).size) +
	 (this.sum_Ssfm_ErrorsHandlers.Sum_Ssfm_Errh_SSMInternalFIErrors.sum_Ssfm_SsmMeasureFailed.select(e|e.sum_Ssfm_SsmMeasureFailed_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y")).size)
	))
;
// Case 4: only ssm present
context Sum_Ssfm_ConfigSet
if this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_LNMErrors == null && this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SUSDErrors == null && this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SSMInternalFIErrors != null
	ERROR "SUM_SSFM: The number of configured filters with XofY type and the numbers of referenced ones from Handlers don't match. Please removed unused filter, or check if you referenced the same XofY filter in more than one handler." :
	((this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_GeneralEventsFilter.select(e|e.sum_Ssfm_FilterType.contains("X_OF_Y")).size) == (
	 (this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_BswError.select(e|e.sum_Ssfm_Errh_BSWErr_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y")).size) +
	 (this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SSMInternalFIErrors.sum_Ssfm_SsmMeasureFailed.select(e|e.sum_Ssfm_SsmMeasureFailed_EventFilter_Ref.sum_Ssfm_FilterType.contains("X_OF_Y")).size)
	))
;

context Sum_Ssfm_ConfigSet
	ERROR "SUM_SSFM: You have configured some Bsw Error Handler without reference to an Error filter. Please add the reference" :
	this.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_BswError.select(e|e.sum_Ssfm_Errh_BSWErr_EventFilter_Ref == null).size == 0
;
*/

context Sum_Ssfm_ConfigSet
	ERROR "SUM_SSFM: Please add X and Y initialization value for X_OF_Y filters" :
	this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_GeneralEventsFilter.select(e|e.sum_Ssfm_FilterType.contains("X_OF_Y") && (e.sum_Ssfm_Errh_C_ThrX == null || e.sum_Ssfm_Errh_C_ThrY == null)).size == 0
;

context Sum_Ssfm_ConfigSet
	ERROR "SUM_SSFM: X > Y for a X_OF_Y Filter. Filter will never detect a fail. If you want to bypass the filter please configure it as BLOCK" :
	this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_GeneralEventsFilter.select(e|e.sum_Ssfm_FilterType.contains("X_OF_Y") && (e.sum_Ssfm_Errh_C_ThrX > e.sum_Ssfm_Errh_C_ThrY) ).size == 0
;

context Sum_Ssfm_ConfigSet
	ERROR "SUM_SSFM: You configured an X_OF_Y_* filter with X,Y to 1s. If you need this configuration please change the Filter Type to NONE" :
	this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_GeneralEventsFilter.select(e|e.sum_Ssfm_FilterType.contains("X_OF_Y") && ((e.sum_Ssfm_Errh_C_ThrX == 1) && (e.sum_Ssfm_Errh_C_ThrY == 1))).size == 0
;

context Sum_Ssfm_ConfigSet
	ERROR "SUM_SSFM: You configured an X_OF_Y_MOVING_WINDOW_TIMEBASED filter. If you need this configuration please set value for Sum_Ssfm_Errh_MovingWindow_XofY_Periodicity" :
	this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_GeneralEventsFilter.select(e|e.sum_Ssfm_FilterType.contains("X_OF_Y_MOVING_WINDOW_TIMEBASED") && (this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_MovingWindow_XofY_Periodicity == null)).size == 0
;

context Sum_Ssfm_ECUInfo ERROR "Parameter Sum_Ssfm_Errh_C_DTCProcess_SsmNodeLoss is mandatory for " + this.shortName + "!" :
	(this.sum_Ssfm_Errh_C_DTCProcess_SsmNodeLoss != null)
;

context Sum_Ssfm_ECUInfo ERROR "Parameter Sum_Ssfm_LC_ECU_Timer_Ref is mandatory for " + this.shortName + "!" :
	(this.sum_Ssfm_LC_ECU_Timer_Ref != null)
;

context Sum_Ssfm_ECUInfo
	ERROR "SUM_SSFM: The parameter Sum_Ssfm_NodeLossError_RunnablePeriodicity must be configured under Sum_Ssfm_General.":
	this.eRootContainer.sSFM.sum_Ssfm_General.sum_Ssfm_NodeLossError_RunnablePeriodicity != null
;

context Sum_Ssfm_ECUInfo
	ERROR "SUM_SSFM: The Sum_Ssfm_LC_ECU_Timer_Ref must be divisible by Sum_Ssfm_NodeLossError_RunnablePeriodicity for an accurate timing.":
	(
		let timer = 1000 * this.sum_Ssfm_LC_ECU_Timer_Ref:
		let period = (1000 * this.eRootContainer.sSFM.sum_Ssfm_General.sum_Ssfm_NodeLossError_RunnablePeriodicity).extractMantissaFrmFloatValue():
			(timer/period).extractMantissaFrmFloatValue() * period == timer
	)
;

context Sum_Ssfm_ECUInfo_SerialData ERROR "Parameter Sum_Ssfm_RoutingMethod is mandatory for " + this.shortName + "!" :
	(this.sum_Ssfm_RoutingMethod != null)
;

context Sum_Ssfm_ECUInfo_SerialData ERROR "Parameter Sum_Ssfm_FaultDetectionUsage is mandatory for " + this.shortName + "!" :
	(this.sum_Ssfm_FaultDetectionUsage != null)
;

/* Non-discoverable SerialData must have FaultDetectionUsage = None (no timeout monitoring) */
context Sum_Ssfm_ECUInfo_SerialData
	if this.sum_Ssfm_SerialData_Ref.Ssfm_IsNonDiscoverableService()
	ERROR "SerialData '" + this.sum_Ssfm_SerialData_Ref.shortName + "' is non-discoverable but has FaultDetectionUsage = '" + this.sum_Ssfm_FaultDetectionUsage + "' under ECU '" + this.parent.shortName + "'. Non-discoverable services are always available and must have FaultDetectionUsage = 'None' (no timeout monitoring)." :
	this.sum_Ssfm_FaultDetectionUsage == "None"
;

context Sum_Ssfm_ECUInfo ERROR "Parameter Sum_Ssfm_IsGateway is mandatory for " + this.shortName + "!" :
	(this.sum_Ssfm_IsGateway != null)
;

/*Check if Sum_Ssfm_Channel_Ref is configured for Sum_Ssfm_ECUInfo_Event*/
context Sum_Ssfm_ECUInfo_Event
	ERROR "SUM_SSFM: Parameter Sum_Ssfm_Channel_Ref should be configured in the Sum_Ssfm_ECUInfo_Event subcontainer of "+this.parent.shortName+"!":
	this.sum_Ssfm_Channel_Ref != null
;

/*Check if Sum_Ssfm_SerialData_Ref is configured for Sum_Ssfm_ECUInfo_SerialData*/
context Sum_Ssfm_ECUInfo_SerialData
	ERROR "SUM_SSFM: Parameter Sum_Ssfm_SerialData_Ref should be configured in the Sum_Ssfm_ECUInfo_SerialData subcontainer of "+this.parent.shortName+"!":
	this.sum_Ssfm_SerialData_Ref != null
;

/*No Sum_Ssfm_ECUInfo_SerialData should be service based*/
context Sum_Ssfm_ECUInfo_SerialData
	ERROR "SUM_SSFM: The the Sum_Ssfm_ECUInfo_SerialData should not be related to a service based serial data " + this.shortName + " assigned to " + this.parent.shortName + "!":
	(this.sum_Ssfm_SerialData_Ref.Ssfm_IsServiceBased() == false)
;

/* All target devices should have Sum_Ssfm_SpmTargetDevice_Ref configured */
context Sum_Ssfm_TrgDvcInfo
	ERROR "SUM_SSFM: The target device should have a reference to a SPM TrgDvc. Please configure Sum_Ssfm_SpmTargetDevice_Ref for " + this.shortName + "!":
	(this.sum_Ssfm_SpmTargetDevice_Ref != null)
;

context Sum_Ssfm_TrgDvcInfo
	if this.parent.sum_Ssfm_TrgDvcInfo.size > 1
	ERROR "SUM_SSFM: The configured Sum_Ssfm_SpmTargetDevice_Ref for " + this.shortName +
	" has been used by the following Sum_Ssfm_TrgDvcInfo instances: " +
	(this.parent.sum_Ssfm_TrgDvcInfo.without({this}).select(e | e.sum_Ssfm_SpmTargetDevice_Ref == this.sum_Ssfm_SpmTargetDevice_Ref).shortName).toString() +
	". The Sum_Ssfm_SpmTargetDevice_Ref must be unique among Sum_Ssfm_TrgDvcInfo instances!":
	(this.parent.sum_Ssfm_TrgDvcInfo.without({this}).sum_Ssfm_SpmTargetDevice_Ref.contains(this.sum_Ssfm_SpmTargetDevice_Ref) == false)
;

context Sum_Ssfm_TrgDvcInfo ERROR "Parameter Sum_Ssfm_Errh_C_DTCProcess_TrgDvc_SsmNodeLoss is mandatory for " + this.shortName + "!" :
	(this.sum_Ssfm_Errh_C_DTCProcess_TrgDvc_SsmNodeLoss != null)
;

context Sum_Ssfm_TrgDvcInfo ERROR "Parameter Sum_Ssfm_LF_TrgDvc_Timer is mandatory for " + this.shortName + "!" :
	(this.sum_Ssfm_LF_TrgDvc_Timer != null)
;

context Sum_Ssfm_ConfigSet
	if this.sum_Ssfm_GroupInfo != null
	ERROR "Parameter Sum_Ssfm_IsGateway should be set to True not for more than one ECUInfo!" :
	(this.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.select(ecu | ecu.sum_Ssfm_IsGateway == true).size <= 1)
;

context Sum_Ssfm_ConfigSet
	if(this.sum_Ssfm_GroupInfo != null && this.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.sum_Ssfm_ECUInfo_SerialData.exists(e | e.sum_Ssfm_RoutingMethod == 'SignalRouted'))
	ERROR "There is a SerialData configured with signal routing, but there is no gateway configured!" :
	(this.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.exists(ecu | ecu.sum_Ssfm_IsGateway == true))
;

context Sum_Ssfm_ConfigSet
	if(this.sum_Ssfm_GroupInfo != null && this.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.sum_Ssfm_ECUInfo_SerialData.exists(e | e.sum_Ssfm_RoutingMethod == 'PDURouted'))
	ERROR "There is a SerialData configured with PDU routing, but there is no gateway configured!" :
	(this.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.exists(ecu | ecu.sum_Ssfm_IsGateway == true))
;

context Sum_Ssfm_General ERROR "Setting parameter Sum_Ssfm_IsThisECUGateway is mandatory for Sum_Ssfm_General." :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_IsThisECUGateway != null)
;

context Sum_Ssfm_General ERROR "Setting parameter Sum_Ssfm_DtcTriggerMessageSupport is mandatory for Sum_Ssfm_General." :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_DtcTriggerMessageSupport != null)
;

/* Implementation of the queue size will consider the value as a sint16/int16_t (2Bytes-signed) */
context Sum_Ssfm_General
     if(this.sum_Ssfm_DtcTriggerMessageSupport == true)
	 ERROR "SSFM: DTC notification queue size is out-of-boundaries." :
	(this.sum_Ssfm_DTCNotificationQueueSize >= 0) && (this.sum_Ssfm_DTCNotificationQueueSize < 32746)
;

context SSFM
	if(this.sum_Ssfm_General.sum_Ssfm_IsThisECUGateway == true)
	ERROR "When the current ECU is the gateway, all 'the sum_Ssfm_RoutingMethod's should be 'Direct'" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.sum_Ssfm_ECUInfo_SerialData.exists(e | e.sum_Ssfm_RoutingMethod != 'Direct') == false)
;

context SSFM
	if(this.sum_Ssfm_General.sum_Ssfm_IsThisECUGateway == true)
	ERROR "When the current ECU is the gateway, no Sum_Ssfm_ECUInfo should be configured as gateway" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.exists(e | e.sum_Ssfm_IsGateway == true) == false)
;

context Sum_Ssfm_ECUInfo
	if(this.sum_Ssfm_IsGateway == true)
	ERROR "When the ECU is a gateway it cannot have any SerialDatas other than a 'Direct' routed one." :
	(this.sum_Ssfm_ECUInfo_SerialData.select(e | e.sum_Ssfm_RoutingMethod != 'Direct').size == 0)
;

/* Check the RteCallBackFunction */
context Sum_Ssfm_RteSerialData
    ERROR "SUM_SSFM: Parameter RteCallBackFunction should be defined for the "+this.shortName+"!" :
	/* Exception handling if the next condition is not verified */
	(this.rteCallBackFunction != null && this.rteCallBackFunction != "")
;
/* Check the RteSerialDataHeaderInclude */
context Sum_Ssfm_RteSerialData
    ERROR "SUM_SSFM: Parameter RteSerialDataHeaderInclude should be defined for the "+this.shortName+"!" :
	/* Exception handling if the next condition is not verified */
	(this.rteSerialDataHeaderInclude != null && this.rteSerialDataHeaderInclude != "")
;

/*Non-discoverable services do not require PN or ECU association */
context Sum_Ssfm_SerialData
	if(Ssfm_IsNonDiscoverableService(this))
	    WARNING "SUM_SSFM: Non-discoverable SerialData '"+this.shortName+"' will bypass PN conditions and always be Available." :
		/* Non-discoverable is valid, just inform the user */
		(true)
;

/* Check for having at most one reference among PN and SD references */
context Sum_Ssfm_SerialData
	if(this.sum_Ssfm_SDService_Ref != null && !this.Ssfm_IsLINChannelCfg() && !Ssfm_IsNonDiscoverableService(this))
	    ERROR "SUM_SSFM: Whenever the Sum_Ssfm_SDService_Ref is defined there should be no Sum_Ssfm_Partial_Network_Ref defined; for the "+this.shortName+"!" :
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_Partial_Network_Ref.size == 0)
;

/* Check for having a reference in the RteSerialData */
context Sum_Ssfm_SerialData
	ERROR "SUM_SSFM: The Sum_Ssfm_RteSerialData_Ref for this serial data do not point to an RteSerialData with a valid RteISignalGroupRefChoice or RteISignalRefChoice ; for the "+this.shortName+"!" :
	/* Exception handling if the next condition is not verified */
	(
		(this.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalGroupRefChoice != null) ||
		(this.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalRefChoice != null)
	)
;

/* Check for having the correct reference in the RteSerialData */
context Sum_Ssfm_SerialData
	if(this.Ssfm_IsSignalGroup())
	ERROR "SUM_SSFM: The Sum_Ssfm_RteSerialData_Ref for this serial data (Signal Group) do not point to an RteSerialData with a SignalGroup reference ; for the "+this.shortName+"!" :
	/* Exception handling if the next condition is not verified */
	(
		(this.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalGroupRefChoice != null) &&
		(this.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalGroupRefChoice.rteISignalGroupRef != null)
	)
;

/* Check for having the correct reference in the RteSerialData */
context Sum_Ssfm_SerialData
	if(!this.Ssfm_IsSignalGroup())
	ERROR "SUM_SSFM: The Sum_Ssfm_RteSerialData_Ref for this serial data (Signal) do not point to an RteSerialData with a Signal reference ; for the "+this.shortName+"!" :
	/* Exception handling if the next condition is not verified */
	(
		(this.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalRefChoice != null) &&
		(this.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalRefChoice.rteISignalRef != null)
	)
;

/* Check for having the message id reference whenever the serial data has the message info */
context Sum_Ssfm_SerialData
	if(!this.Ssfm_IsLINChannelCfg())
	ERROR "SUM_SSFM: The Sum_Ssfm_MessageID_Ref should be configured when the message is CAN/ETH; for the "+this.shortName+"!" :
	/* Exception handling if the next condition is not verified */
	(
		(this.sum_Ssfm_MessageID_Ref != null)
	)
;


////////////// FxI Debouncing //////////////
context Sum_Ssfm_SerialData
	if(this.Ssfm_IsAuthenticated() == true)
	    ERROR "SUM_SSFM: Whenever the Sum_Ssfm_SerialData is an Authenticated SerialData the Sum_Ssfm_FcI_Debouncer should be defined; for the "+this.shortName+"!" :
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_FcI_Debouncer != null)
;
context Sum_Ssfm_SerialData
	if(this.Ssfm_IsContOp() == true)
	    ERROR "SUM_SSFM: Whenever the Sum_Ssfm_SerialData is a ContOp SerialData the Sum_Ssfm_FoI_Debouncer should be defined; for the "+this.shortName+"!" :
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_FoI_Debouncer != null)
;
context Sum_Ssfm_SerialData
	if(this.Ssfm_IsProtected() == true)
	    ERROR "SUM_SSFM: Whenever the Sum_Ssfm_SerialData is a Protected SerialData the Sum_Ssfm_FpI_Debouncer should be defined; for the "+this.shortName+"!" :
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_FpI_Debouncer != null)
;
context Sum_Ssfm_SerialData
	if(this.Ssfm_IsSafety() == true)
	    ERROR "SUM_SSFM: Whenever the Sum_Ssfm_SerialData is a Safety SerialData the Sum_Ssfm_FsI_Debouncer should be defined; for the "+this.shortName+"!" :
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_FsI_Debouncer != null)
;

context DemClient
    ERROR "SUM_SSFM: The DemClient container should contain a DemCallbackDTCStatusChanged with function callback name set to Ssfm_Dem_CB_DTCStatusChanged!" :
	/* Exception handling if the next condition is not verified */
	(this.demCallbackDTCStatusChanged.exists(e | e.demCallbackDTCStatusChangedFnc == "Ssfm_Dem_CB_DTCStatusChanged"))
;

/* Check if all serial datas are assigned to at least one ECU (for signal based serial data) */
/*Non-discoverable services do not require ECU assignment */
context Sum_Ssfm_SerialData
	if(!Ssfm_IsLINChannelCfg(this) && !Ssfm_IsServiceBased(this) && !Ssfm_IsNonDiscoverableService(this))
		ERROR "SUM_SSFM: The serial data is not assigned to any ECU. Consider adding the serial data to the corresponding ECU_Info; for the "+this.shortName+"!" :
		/* Exception handling if the next condition is not verified */
		(this.parent.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.exists(e|e.sum_Ssfm_ECUInfo_SerialData.sum_Ssfm_SerialData_Ref.contains(this)))
;

////////////// LossOfCommunication Dem events configuration //////////////

/*!
 * Check for all configured ECUInfos that a proper binding between SerialDatas and channels
 * has been defined inside the sum_Ssfm_ECUInfo_Event container, to be able to
 * report LossOfCommunication events to the Dem for all pairs of ECU-channel
 */
context Sum_Ssfm_ECUInfo
	ERROR "SUM_SSFM: "+this.shortName+" is missing a reference to a Dem event for a linked SerialData channel. See the Sum_Ssfm_ECUInfo_Event subcontainer." :
	Ssfm_GetControllerECUInfos(this.parent.sum_Ssfm_ECUInfo, false)                  // ...for all ECU/channel bindings ...
	.forAll(binding |
					  ((binding.getProperty("ecu_name") != this.shortName)          // ...filter the bindings to the current ECU ...
	                  || this.sum_Ssfm_ECUInfo_Event
	                         .collect(ch | if(ch.sum_Ssfm_Channel_Ref != null) then ch.sum_Ssfm_Channel_Ref.shortName)        // ...collect names of bound channels ...
	                         .exists(ch | ch == binding.getProperty("channel_name") ) // ...and check if the required binding's channel is part of the bound channels
	                  )
	       )
;

/*!
 * Check that there are no duplicate channels' binding in
 * Sum_Ssfm_ECUInfo_Event containers
 */
context Sum_Ssfm_ECUInfo_Event
	ERROR "SUM_SSFM: multiple bindings for the "+this.sum_Ssfm_Channel_Ref.shortName+" SSFM channel are present in the current sum_Ssfm_ECUInfo_Events container. At most one binding per channel per ECU shall be present." :
	!this.parent.sum_Ssfm_ECUInfo_Event.exists(binding | (binding != this) && (binding.sum_Ssfm_Channel_Ref == this.sum_Ssfm_Channel_Ref))
;

context Sum_Ssfm_ECUInfo
	ERROR "Parameter Sum_Ssfm_LossCommID is mandatory for " + this.shortName:
	Ssfm_GetControllerECUInfos(this.parent.sum_Ssfm_ECUInfo, false)
	.select(controller | controller.getProperty("ecu_name") == this.shortName)
	.toSet().contains(false) ? (this.sum_Ssfm_LossCommID != null) : true
;
////////////// LIN Fault Indications configuration //////////////
/*!
 * Check that there are no sum_Ssfm_SecOCRxPdu_Ref when LIN serial data is configured
 */
context Sum_Ssfm_SerialData
	if(this.sum_Ssfm_Channel_Ref != null &&
	this.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref != null && 	this.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref.comMBusType == "COMM_BUS_TYPE_LIN")
	    ERROR "SUM_SSFM: Parameter Sum_Ssfm_Channel_ID_Ref of "+this.shortName+" is refered to LIN communication so we shall not configure sum_Ssfm_SecOCRxPdu_Ref for "+this.shortName+"!":
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_SecOCRxPdu_Ref == null)
;

/*!
 * Check that there are no sum_Ssfm_SDService_Ref when LIN serial data is configured
 */
context Sum_Ssfm_SerialData
	if(Ssfm_IsLINChannelCfg(this))
	    ERROR "SUM_SSFM: Parameter Sum_Ssfm_Channel_ID_Ref of "+this.shortName+" is refered to LIN communication so we shall not configure sum_Ssfm_SDService_Ref for "+this.shortName+"!":
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_SDService_Ref == null)
;

/* Check that there are no partial network when LIN serial data is configured */
context Sum_Ssfm_SerialData
	if(Ssfm_IsLINChannelCfg(this))
	    ERROR "SUM_SSFM: Parameter Sum_Ssfm_Channel_ID_Ref of "+this.shortName+" is refered to LIN communication so we shall not configure sum_Ssfm_Partial_Network_Ref for "+this.shortName+"!":
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_Partial_Network_Ref.size == 0)
;


/* Check that there are no security debouncer when LIN serial data is configured */
context Sum_Ssfm_SerialData
	if(this.sum_Ssfm_Channel_Ref != null && this.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref != null && this.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref.comMBusType == "COMM_BUS_TYPE_LIN")
	    ERROR "SUM_SSFM: Parameter Sum_Ssfm_Channel_ID_Ref of "+this.shortName+" is refered to LIN communication so we shall not configure sum_Ssfm_FcI_Debouncer for "+this.shortName+"!":
		/* Exception handling if the next condition is not verified */
		(this.sum_Ssfm_FcI_Debouncer == null)
;


/* Check if LIN serial datas are assigned to any Sum_Ssfm_LINInfo container */
context Sum_Ssfm_LINInfo_SerialData
