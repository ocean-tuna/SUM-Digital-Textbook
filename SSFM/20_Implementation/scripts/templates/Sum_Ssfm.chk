	(this.sum_Ssfm_MissingMsg_DemEvent_Ref != null)
;

/* Check if multiple duplicate reference to the same Sum_Ssfm_LINInfo_Ref with error type is SSFM_LNM_RESPONDER_MISSING_MSG*/
context Sum_Ssfm_LNM_ResponderInfoError
	if(this.sum_Ssfm_LINInfo_Ref !=null && this.sum_Ssfm_LNM_ResponderInfoErrorType == "SSFM_LNM_RESPONDER_MISSING_MSG")
	ERROR "SUM_SSFM: Multiple Sum_Ssfm_LINInfo_Ref reference to the same "+this.sum_Ssfm_LINInfo_Ref.shortName+" with error type is SSFM_LNM_RESPONDER_MISSING_MSG in container Sum_Ssfm_LNM_ResponderInfoError." :
	!this.parent.sum_Ssfm_LNM_ResponderInfoError.exists(binding | (binding.sum_Ssfm_LNM_ResponderInfoErrorType == "SSFM_LNM_RESPONDER_MISSING_MSG") && (binding != this) && (binding.sum_Ssfm_LINInfo_Ref == this.sum_Ssfm_LINInfo_Ref))
