/* Check the configuration of the execution mask */
context Sum_Ssfm_General ERROR "Parameter Sum_Ssfm_SsmPermitExecutionMask has not a valid value." :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_SsmPermitExecutionMask >= 0 && this.sum_Ssfm_SsmPermitExecutionMask <= 255)
;

/* Check the configuration of the execution mask */
context Sum_Ssfm_General ERROR "Parameter Sum_Ssfm_ErrhPermitExecutionMask has not a valid value!" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_ErrhPermitExecutionMask >= 0 && this.sum_Ssfm_ErrhPermitExecutionMask <= 255)
;

/* Check the configuration of the execution mask */
context Sum_Ssfm_General ERROR "Parameter Sum_Ssfm_FxI_FxFA_SinglePortsSupport is not configured in " + this.shortName + "!" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_FxI_FxFA_SinglePortsSupport != null)
;

/* Check the configuration of the Execution Manager period */
context Sum_Ssfm_General ERROR "Parameter Sum_Ssfm_ExecutionManagerPeriodicity is mandatory!" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_ExecutionManagerPeriodicity != null)
;

/* Check the configuration of the DTCTriggeredRunnablePeriodicity */
context Sum_Ssfm_General
	if(this.sum_Ssfm_DtcTriggerMessageSupport == true)
	ERROR "Parameter sum_Ssfm_DTCTriggeredRunnablePeriodicity is mandatory when sum_Ssfm_DtcTriggerMessageSupport enabled !" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_DTCTriggeredRunnablePeriodicity != null)
;

/* Check the configuration of the SSFM Os Counter */
context Sum_Ssfm_General ERROR "Parameter Sum_Ssfm_Os_Counter_1ms_Ref is mandatory!" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_Os_Counter_1ms_Ref != null)
;

/* Check the configuration of the sum_Ssfm_ComMPNCRef */
context Sum_Ssfm_General
	if(this.sum_Ssfm_DtcTriggerMessageSupport == true)
	ERROR "Parameter sum_Ssfm_ComMPNCRef is mandatory when sum_Ssfm_DtcTriggerMessageSupport enabled !" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_ComMPNCRef.size != 0)
;

/* Check the configuration of the sum_Ssfm_Errh_C_DTC_ControlModule_InvalidIncompatibleConfiguration parameter */
context Sum_Ssfm_Errh_C_Params ERROR "Parameter sum_Ssfm_Errh_C_DTC_ControlModule_InvalidIncompatibleConfiguration is mandatory!" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_Errh_C_DTC_ControlModule_InvalidIncompatibleConfiguration != null)
;

/* Check the configuration of the sum_Ssfm_Errh_C_DTC_SecurityPeripheral_PerformanceIncorrectOperation parameter */
context Sum_Ssfm_Errh_C_Params ERROR "Parameter sum_Ssfm_Errh_C_DTC_SecurityPeripheral_PerformanceIncorrectOperation is mandatory!" :
	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_Errh_C_DTC_SecurityPeripheral_PerformanceIncorrectOperation != null)
;

