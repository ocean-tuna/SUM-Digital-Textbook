;

/* Check the configuration of Sum_Ssfm_LossCommID should be unique for all the instances of Sum_Ssfm_ECUInfo*/
context Sum_Ssfm_ConfigSet
	if this.sum_Ssfm_GroupInfo != null
	ERROR "Parameter Sum_Ssfm_LossCommID should be unique for all the instances of Sum_Ssfm_ECUInfo!":
	(this.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.sum_Ssfm_LossCommID.select(e|e != null).size == this.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo.sum_Ssfm_LossCommID.select(e|e != null).toSet().size)
;

/* Check if Sum_Ssfm_IeF_DemEvent_Ref is configured for each of Sum_Ssfm_LINInfo */
