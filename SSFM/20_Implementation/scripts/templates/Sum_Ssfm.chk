	if(this.parent.parent.parent.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_LNMErrors != null
	&& this.parent.sum_Ssfm_LNM_ResponderInfo_Ref != null
	&& Ssfm_IsAnyRefToLINInfo(this.parent.parent.parent.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_LNMErrors.sum_Ssfm_LNM_ResponderInfoError,this.parent))
    ERROR "SUM_SSFM: Parameter Sum_Ssfm_MissingMsg_DemEvent_Ref of "+this.shortName+" shall be configured whenever missing message error feature is supported!" :
