	    WARNING "SUM_SSFM: The Nvm block length for Sum_Ssfm_MACVerPerKSNvmRef is greater than E0BB DID length, " + Ssfm_DID_E0BB_Length(this.sum_Ssfm_ConfigSet) :
		(false)
;

/* Check key slot Nvm block length */
context SSFM
	if((Ssfm_DID_E0BB_IsConfigured(this.eRootContainer.sSFM)) &&
	   (this.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_MACVerPerKSNvmRef != null) &&
	   (this.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_MACVerPerKSNvmRef.nvMNvBlockLength < Ssfm_DID_E0BB_Length(this.sum_Ssfm_ConfigSet)))
	    ERROR "SUM_SSFM: The Nvm block length for Sum_Ssfm_MACVerPerKSNvmRef is less than E0BB DID length, " + Ssfm_DID_E0BB_Length(this.sum_Ssfm_ConfigSet):
		(false)
;