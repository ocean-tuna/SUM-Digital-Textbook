context Sum_Ssfm_ConfigSet
	if ((this.sum_Ssfm_ErrorFilter != null) && (this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_KeySlotVerifyFilter != null))
	ERROR "SUM_SSFM : Parameter Sum_Ssfm_Errh_C_DTC_KeySlotVerify is mandatory.":
	this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_KeySlotVerifyFilter.sum_Ssfm_Errh_C_DTC_KeySlotVerify != null
;

context Sum_Ssfm_ConfigSet
	if ((this.sum_Ssfm_ErrorFilter != null) && (this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_KeySlotVerifyFilter != null))
	ERROR "SUM_SSFM : Parameter Sum_Ssfm_Errh_C_FailedAuthenticationTimer is mandatory.":
	this.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_KeySlotVerifyFilter.sum_Ssfm_Errh_KeySlotNumber.sum_Ssfm_Errh_C_FailedAuthenticationTimer != null
;

context Sum_Ssfm_Errh_KeySlotVerifyFilter
	if(this != null)
	ERROR "SUM_SSFM: Please configure Sum_Ssfm_KeySlotVerify_RunnablePeriodicity under Sum_Ssfm_General.":
	this.eRootContainer.sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity != null
;

context Sum_Ssfm_Errh_KeySlotNumber
	if(this != null)
	ERROR "SUM_SSFM: The Sum_Ssfm_Errh_C_FailedAuthenticationTimer must be divisible by Sum_Ssfm_KeySlotVerify_RunnablePeriodicity for an accurate timing.":
	(
		let timer = 1000 * this.sum_Ssfm_Errh_C_FailedAuthenticationTimer:
		let period = (1000 * this.eRootContainer.sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity).extractMantissaFrmFloatValue():
			(timer/period).extractMantissaFrmFloatValue() * period == timer
	)
;

// Checking that provided value (expressed in ms) has a resolution of 50ms
context Sum_Ssfm_Errh_KeySlotNumber
	if(this != null)
	ERROR "SUM_SSFM: The Sum_Ssfm_Errh_C_SlowestPDU_RateTimer must be a multiple of 50ms (resolution is 50ms).":
	(
		let timer = (this.sum_Ssfm_Errh_C_SlowestPDU_RateTimer).extractMantissaFrmFloatValue():
			(timer / 50).extractMantissaFrmFloatValue() * 50 == timer
	)
;

context Sum_Ssfm_Errh_KeySlotNumber
	if(this != null)
	ERROR "SUM_SSFM: The Sum_Ssfm_Errh_C_SlowestPDU_RateTimer must be divisible by Sum_Ssfm_KeySlotVerify_RunnablePeriodicity for an accurate timing.":
	(
		let timer = 1000 * this.sum_Ssfm_Errh_C_SlowestPDU_RateTimer:
		let period = (1000 * this.eRootContainer.sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity).extractMantissaFrmFloatValue():
			(timer/period).extractMantissaFrmFloatValue() * period == timer
	)
;

context Sum_Ssfm_Errh_KeySlotNumber
	ERROR "SUM_SSFM : Parameter Sum_Ssfm_Errh_C_SlowestPDU_RateTimer is mandatory.":
	this.sum_Ssfm_Errh_C_SlowestPDU_RateTimer != null
;

