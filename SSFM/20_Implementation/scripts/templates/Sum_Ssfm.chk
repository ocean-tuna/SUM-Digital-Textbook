	ERROR "SUM_SSFM: the serial data referenced in "+ this.shortName +" must have the CAN or ETH channel type!":
	(
	(this.sum_Ssfm_SerialData_Ref.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref.comMBusType == "COMM_BUS_TYPE_CAN") ||
	(this.sum_Ssfm_SerialData_Ref.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref.comMBusType == "COMM_BUS_TYPE_ETH")
	)
;

/*********/
/*Check if Sum_Ssfm_ECUInfo_SerialData container is enabled, then all parameters must be configured*/
context Sum_Ssfm_ECUInfo_SerialData
	if ( this != null)
	ERROR "SUM_SSFM: Parameters of the enabled "+ this.shortName +" container must be configured!":
	((this.sum_Ssfm_FaultDetectionUsage != null) &&
	(this.sum_Ssfm_RoutingMethod != null ) &&
	(this.sum_Ssfm_SerialData_Ref != null )
	)
;

