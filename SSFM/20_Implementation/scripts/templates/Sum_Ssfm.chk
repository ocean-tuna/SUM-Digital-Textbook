    if((this.sum_Ssfm_SerialData.size > 0)&&(this.sum_Ssfm_SerialData.select(e|e.sum_Ssfm_SecOCRxPdu_Ref != null).size > 0))
    ERROR "SSFM_Verification_Status_Callout should be included in the SecOC/SecOCGeneral/SecOCVerificationStatusCallout list" :
	(this.sum_Ssfm_SerialData.select(e|e.sum_Ssfm_SecOCRxPdu_Ref != null).first().sum_Ssfm_SecOCRxPdu_Ref.parent.secOCGeneral.secOCVerificationStatusCallout.select(e|e == "SSFM_Verification_Status_Callout").size != 0)
;

context Sum_Ssfm_ConfigSet
