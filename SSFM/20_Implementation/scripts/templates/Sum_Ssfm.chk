	/* Exception handling if the next condition is not verified */
	(this.sum_Ssfm_RteSerialData_Ref != null)
;

/* Check the configuration of the Sum_Ssfm_Channel_Ref
But for the case the Serial Data is service based, we don't need to configure the Sum_Ssfm_Channel_Ref*/
context Sum_Ssfm_SerialData
