#ifndef SUM_SSFM_NODE_STS_MANAGER_H
#define SUM_SSFM_NODE_STS_MANAGER_H

#define SUM_SSFM_LIST_FAULT_AND_RECOVERY 0
#define SUM_SSFM_LIST_RECOVERY_ONLY 1
#define SUM_SSFM_LIST_NON_FAULT_AND_RECOVERY 2

«LET sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUs-»
«LET Ssfm_GetControllerECUInfos(ECUs, false) AS controllers-»
/** @brief  Number of configured controllers */
#define SSFM_NUM_OF_SIGNALBASED_CONTROLLERS  («controllers.size»u)
«ENDLET-»
«ENDLET-»

/** @brief  Number of configured Target Devices which might report DTC events to be forwarded to the DEM */
#define SSFM_NUM_OF_SERVICEBASED_TARGETDEVICES  («sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo.size»u)
#define SSFM_DTC_VALUE_LOW_BYTE_LOSS_OF_FUNCTION 0x87u

«IF Ssfm_AnyServiceBased(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
extern const Sum_Ssfm_DemEvent Sum_Ssfm_LoF_DemEvents[SSFM_NUM_OF_SERVICEBASED_TARGETDEVICES];
«ENDIF-»
«ENDIF-»
extern Sum_Ssfm_Debouncer Sum_Ssfm_NodeLoss_Debouncers[SSFM_NUM_OF_SIGNALBASED_CONTROLLERS + SSFM_NUM_OF_SERVICEBASED_TARGETDEVICES];

/**************************************************************************************************************************
 * FUNCTION DECLARATION
 **************************************************************************************************************************
 */

extern boolean Sum_Ssfm_Node_MissingMsg_TestEnableConditions(const Sum_Ssfm_SerialData* serialData);
extern void Sum_Ssfm_NodeSts_Manager_UpdateSerialDataLostComm(const Sum_Ssfm_SerialData* serialData);
extern Sum_Ssfm_EvaluationStatus Sum_Ssfm_NodeLossError_Manager(Sum_Ssfm_Debouncer* const deb_event);
extern void Sum_Ssfm_LoC_Dem_CB_DTCStatusChanged(uint32 DTC, Dem_UdsStatusByteType DTCStatusOld, Dem_UdsStatusByteType DTCStatusNew);
extern boolean Sum_Ssfm_IsSerialDataInLossOfComm(const Sum_Ssfm_SerialData * serial_data);
#endif
