«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo AS TrgDvcInfo-»
 /**
 * @brief           SSFM/SSM getter of calibration parameter for timer loss com of TrgDvc «TrgDvcInfo.shortName-»
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          uint32 - Rte_CData_Sum_Ssfm_Ssm_C_LF_TrgDvc_«TrgDvcInfo.shortName-»_Timer
 */
 static uint32 Sum_Ssfm_Get_CalibPar_LF_TrgDvc_«TrgDvcInfo.shortName-»_Timer(void)
 {
 	return Rte_CData_Sum_Ssfm_Ssm_C_LF_TrgDvc_«TrgDvcInfo.shortName»_Timer();
 }
«ENDFOREACH-»
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo AS TrgDvcInfo-»
 /**
 * @brief           SSFM/SSM getter of calibration parameter for DTC process loss com of TrgDvc «TrgDvcInfo.shortName-»
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          boolean - Rte_CData_Sum_Ssfm_Errh_C_DTC_Process_NodeLossError_«TrgDvcInfo.shortName-»
 */
 static boolean Sum_Ssfm_Get_CalibPar_DTC_Process_NodeLossError_«TrgDvcInfo.shortName»(void)
 {
 	return Rte_CData_Sum_Ssfm_Errh_C_DTC_Process_NodeLossError_«TrgDvcInfo.shortName»();
 }
«ENDFOREACH-»

#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
