/* Include SSFM-SSM Top Level Library */
#include "Sum_Ssfm.h"


/* PRQA S 1532 EOF # Here for modularity */
/* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 3469 EOF # The function like macros is used. This is necessary to get value via RTE variable */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */
#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"

/*
 *********************************************************************************************************************************************************
 * Functions Declaration
 *********************************************************************************************************************************************************
 */
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo AS TrgDvcInfo-»
static uint32 Sum_Ssfm_Get_CalibPar_LF_TrgDvc_«TrgDvcInfo.shortName»_Timer(void);
«ENDFOREACH-»
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo AS TrgDvcInfo-»
static boolean Sum_Ssfm_Get_CalibPar_DTC_Process_NodeLossError_«TrgDvcInfo.shortName»(void);
«ENDFOREACH-»


«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
static Sum_Ssfm_SerialData* ServiceBased_TrgDvcs_SharedFaultAndRecoveryList[SSFM_SSM_NUM_OF_SERVICEINFO_SERIALDATAS] = {
	«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SERIAL_DATA ITERATOR i-»
	«IF SERIAL_DATA.Ssfm_IsServiceBased()-»
	&Sum_Ssfm_SerialDatas[«i.counter0»],
	«ENDIF-»
	«ENDFOREACH-»
};
«ENDIF-»


«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo AS TrgDvcInfo ITERATOR i-»
static uint32 Sum_Ssfm_TrgDvc_«TrgDvcInfo.shortName»_IPList[«TrgDvcInfo.sum_Ssfm_SpmTargetDevice_Ref.Ssfm_GetSpmTargetDeviceIPList().size»] = {
	«FOREACH TrgDvcInfo.sum_Ssfm_SpmTargetDevice_Ref.Ssfm_GetSpmTargetDeviceIPList() AS IPAddress-»
	«IPAddress»u,
	«ENDFOREACH-»
};
«ENDFOREACH-»

«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo AS TrgDvcInfo ITERATOR i-»
/* PRQA S 1531 9 */ //This object is kept here to have a better modularity
/* ECUInfo for Service Based TrgDvc TrgDvc_«TrgDvcInfo.shortName» */
Sum_Ssfm_ECUInfo Sum_Ssfm_TrgDvc_«TrgDvcInfo.shortName» = {
	/* List of Size of FaultAndRecovery, RecoveryOnly, and NonFaultAndRecovery Lists */
	{
	SSFM_SSM_NUM_OF_SERVICEINFO_SERIALDATAS, // In current implementation all services are checked. When iterating over them, those with a different provider will be ignored.
	0u,
	0u,
	},
	/* List of Pointers to FaultAndRecovery, RecoveryOnly, and NonFaultAndRecovery Lists */
	{
	ServiceBased_TrgDvcs_SharedFaultAndRecoveryList,
	NULL_PTR,
	NULL_PTR,
	},
	/* LC ECU Timer value */
	&Sum_Ssfm_Get_CalibPar_LF_TrgDvc_«TrgDvcInfo.shortName»_Timer, // In mili-seconds
	/* Time elapsed */
	0u,
	/* The temporary loss of comm value before the DTC confirm (if applicable) */
	ECU_NODE_STATUS_NO_MISSINGMSG,
	/* The confirmed loss of comm through the DTC confirmation (if applicable) */
	FALSE,
	/* The received NodeStsECU (if applicable) */
	FALSE,
	/* The pointer to the RTE write function to notify SWCs about the NodeSts. In case of service based the gateway is not supported. */
	NULL_PTR,
	/* The pointer to Error Debouncer Event */
	&Sum_Ssfm_NodeLoss_Debouncers[SSFM_NUM_OF_SIGNALBASED_CONTROLLERS + «i.counter0»u], «REM»in the list first comes the signal based controllers and then service based target devices«ENDREM»
	/* Function pointer to boolean RTE Calibration NodeLossError */
	&Sum_Ssfm_Get_CalibPar_DTC_Process_NodeLossError_«TrgDvcInfo.shortName»,
	/* Internal state of ECU Node */
	SUM_SSFM_EcuNodeState_Normal,
	/* IP Address List */
	Sum_Ssfm_TrgDvc_«TrgDvcInfo.shortName»_IPList,
	/* IP Address List Length */
	«TrgDvcInfo.sum_Ssfm_SpmTargetDevice_Ref.Ssfm_GetSpmTargetDeviceIPList().size»u,
};
«ENDFOREACH-»

«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
/* PRQA S 1533 1 # Kept here for modularity */
Sum_Ssfm_ECUInfo* Sum_Ssfm_TrgDvcs[SUM_SSFM_NUM_OF_TRGDVCS] = {
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_TrgDvcInfo AS TrgDvcInfo ITERATOR i-»
	&Sum_Ssfm_TrgDvc_«TrgDvcInfo.shortName»,
«ENDFOREACH-»
};
«ENDIF-»

