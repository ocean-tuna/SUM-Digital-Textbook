/* Include SSFM-SSM Top Level Library */
#include "Sum_Ssfm.h"

/* PRQA S 1532 EOF # Here for modularity */
/* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 3469 EOF # The function like macros is used. This is necessary to get value via RTE variable */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */
#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"

/*
 *********************************************************************************************************************************************************
 * Functions Declaration
 *********************************************************************************************************************************************************
 */
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUInfo-»
static uint32 Sum_Ssfm_Get_CalibPar_LC_ECU_«ECUInfo.shortName»_Timer(void);
«ENDFOREACH-»«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUInfo-»
static boolean Sum_Ssfm_Get_CalibPar_DTC_Process_NodeLossError_«ECUInfo.shortName»(void);
«ENDFOREACH-»

«LET sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUs-»
«LET Ssfm_GetControllerECUInfos(ECUs, false) AS controllers-»


«FOREACH controllers AS controller-»
«LET Ssfm_GetControllerFaultAndRecoverySignals(controller) AS FaultAndRecoveryList-»
«LET Ssfm_GetControllerRecoveryOnlySignals(controller) AS RecoveryOnlyList-»
«LET Ssfm_GetControllerNonFaultAndRecoverySignals(controller) AS NonFaultAndRecoveryList-»
	«IF FaultAndRecoveryList.size > 0-»
static Sum_Ssfm_SerialData* ECU_«controller.getProperty("name")»_FaultAndRecoveryList[«FaultAndRecoveryList.size»] = {
	«FOREACH FaultAndRecoveryList AS SERIAL_DATA-»
	&Sum_Ssfm_SerialDatas[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.indexOf(SERIAL_DATA)»],
	«ENDFOREACH-»
};
	«ENDIF-»
	«IF RecoveryOnlyList.size > 0-»
static Sum_Ssfm_SerialData* ECU_«controller.getProperty("name")»_RecoveryOnlyList[«RecoveryOnlyList.size»] = {
	«FOREACH RecoveryOnlyList AS SERIAL_DATA-»
	&Sum_Ssfm_SerialDatas[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.indexOf(SERIAL_DATA)»],
	«ENDFOREACH-»
};
	«ENDIF-»
	«IF NonFaultAndRecoveryList.size > 0-»
static Sum_Ssfm_SerialData* ECU_«controller.getProperty("name")»_NonFaultAndRecoveryList[«NonFaultAndRecoveryList.size»] = {
	«FOREACH NonFaultAndRecoveryList AS SERIAL_DATA-»
	&Sum_Ssfm_SerialDatas[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.indexOf(SERIAL_DATA)»],
	«ENDFOREACH-»
};
	«ENDIF-»
«ENDLET-»
«ENDLET-»
«ENDLET-»
«ENDFOREACH-»

«FOREACH controllers AS controller ITERATOR i-»
«LET Ssfm_GetControllerFaultAndRecoverySignals(controller) AS FaultAndRecoveryList-»
«LET Ssfm_GetControllerRecoveryOnlySignals(controller) AS RecoveryOnlyList-»
«LET Ssfm_GetControllerNonFaultAndRecoverySignals(controller) AS NonFaultAndRecoveryList-»
/* PRQA S 1531 9 */ //This object is kept here to have a better modularity
/* ECUInfo for Signal Based Controller ECU_«controller.getProperty("name")» */
Sum_Ssfm_ECUInfo Sum_Ssfm_Controller_«controller.getProperty("name")» = {
	/* List of Size of FaultAndRecovery, RecoveryOnly, and NonFaultAndRecovery Lists */
	{
	«FaultAndRecoveryList.size»u,
	«RecoveryOnlyList.size»u,
	«NonFaultAndRecoveryList.size»u,
	},
	/* List of Pointers to FaultAndRecovery, RecoveryOnly, and NonFaultAndRecovery Lists */
	{
	«IF FaultAndRecoveryList.size > 0-»
	&(ECU_«controller.getProperty("name")»_FaultAndRecoveryList[0]),
	«ELSE-»
	NULL_PTR,
	«ENDIF-»
	«IF RecoveryOnlyList.size > 0-»
	&(ECU_«controller.getProperty("name")»_RecoveryOnlyList[0]),
	«ELSE-»
	NULL_PTR,
	«ENDIF-»
	«IF NonFaultAndRecoveryList.size > 0-»
	&(ECU_«controller.getProperty("name")»_NonFaultAndRecoveryList[0]),
	«ELSE-»
	NULL_PTR,
	«ENDIF-»
	},
	/* LC ECU Timer value */
	&Sum_Ssfm_Get_CalibPar_LC_ECU_«controller.getProperty("lc_ecu_timer_name")»_Timer, // In mili-seconds
	/* Time elapsed */
	0u,
	/* The temporary loss of comm value before the DTC confirm (if applicable) */
	ECU_NODE_STATUS_NO_MISSINGMSG,
	/* The confirmed loss of comm through the DTC confirmation (if applicable) */
	FALSE,
	/* The received NodeStsECU (if applicable) */
	FALSE,
	/* The pointer to the RTE write function to notify SWCs about the NodeSts */
	«IF sSFM.sum_Ssfm_General.sum_Ssfm_IsThisECUGateway-»
	&Rte_Write_SUM_SSFM_PP_SSFM_NodeStsECU_«controller.getProperty("name")»_LcFA_SSFM_NodeStsECU_LcFA,
	«ELSE-»
	NULL_PTR,
	«ENDIF-»
	/* The pointer to Error Debouncer Event */
	&Sum_Ssfm_NodeLoss_Debouncers[«i.counter0»],«REM»in the list first comes the signal based controllers and then service based target devices«ENDREM»
	/* Function pointer to boolean RTE Calibration NodeLossError */
	&Sum_Ssfm_Get_CalibPar_DTC_Process_NodeLossError_«controller.getProperty("lc_ecu_timer_name")»,
	/* Internal state of ECU Node */
	SUM_SSFM_EcuNodeState_Normal,
	/* IP Address List */
	NULL_PTR,
	/* IP Address List Length */
	0u,
};
«ENDLET-»
«ENDLET-»
«ENDLET-»
«ENDFOREACH-»



/*
 *********************************************************************************************************************************************************
 * Variables (Global)
 *********************************************************************************************************************************************************
 */


/*
 *********************************************************************************************************************************************************
