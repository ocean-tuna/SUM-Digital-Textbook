 *********************************************************************************************************************************************************
 */

 «FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUInfo»
 /**
 * @brief           SSFM/SSM getter of calibration parameter for timer loss com of ECU «ECUInfo.shortName-»
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          uint32 - Rte_CData_Sum_Ssfm_Ssm_C_LC_ECU_«ECUInfo.shortName-»_Timer
 */
 static uint32 Sum_Ssfm_Get_CalibPar_LC_ECU_«ECUInfo.shortName-»_Timer(void)
 {
 	return Rte_CData_Sum_Ssfm_Ssm_C_LC_ECU_«ECUInfo.shortName»_Timer();
 }
«ENDFOREACH-»
 «FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUInfo»
 /**
 * @brief           SSFM/SSM getter of calibration parameter for DTC process loss com of ECU «ECUInfo.shortName-»
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          boolean - Rte_CData_Sum_Ssfm_Errh_C_DTC_Process_NodeLossError_«ECUInfo.shortName-»
 */
 static boolean Sum_Ssfm_Get_CalibPar_DTC_Process_NodeLossError_«ECUInfo.shortName»(void)
 {
 	return Rte_CData_Sum_Ssfm_Errh_C_DTC_Process_NodeLossError_«ECUInfo.shortName»();
 }
«ENDFOREACH-»


«ENDLET-»«REM»controllers«ENDREM»
«ENDLET-»«REM»ECUs«ENDREM»
#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
