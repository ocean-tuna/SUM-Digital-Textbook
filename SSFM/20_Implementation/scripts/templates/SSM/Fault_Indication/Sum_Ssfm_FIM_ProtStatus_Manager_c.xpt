/* PRQA S 1532 EOF # The functions are invoked by runnables or other functions in external file */
/* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */

#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"


/**
 * @brief			SSFM function used to set the FpI interface state
 *
 * @param[in]       serialData        - Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[in]       transformer_error - const Rte_TransformerError*: E2E/Transformer check status
 * @param[inout]	void
 * @param[out]		void
 * @return			void
 */
/* PRQA S 1532 11 # The function belongs to Protection Status Manager yet used in ReceivedSerialData Handler. */
FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_ProtStatus_Manager_Set_FpI_Given_Transformer_Error(Sum_Ssfm_SerialData* serialData, const Rte_TransformerError* transformer_error)
{
   	/*[$Satisfies $DDS_SSFM 021]*/ /*[$Satisfies $DDS_SSFM 023]*/
   	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

   	// Check if SerialData is Protected
   	/*[$Satisfies $DDS_SSFM 189]*/
    if((serialData->Protected != NULL_PTR) && (dtcs_are_disabled == FALSE))
    {
    	switch(transformer_error->errorCode){
    		// No Error: Set FpI to False
    		case E_OK:
    		case E_SAFETY_NODATA_OK:
    		case E_SAFETY_INIT_OK:
    		case E_SAFETY_INVALID_OK:
    			serialData->Protected->FxI = FALSE;
    			break;

    		// Error: Set FpI to True
	   		case E_SAFETY_VALID_ERR:
	   		case E_SAFETY_NODATA_ERR:
	   		case E_SAFETY_INIT_ERR:
	   		case E_SAFETY_INVALID_ERR:
	   		case E_SAFETY_SOFT_RUNTIMEERROR:
	   		case E_SAFETY_HARD_RUNTIMEERROR:
«IF Ssfm_AnySomeIpConfigured(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
   			case E_SER_GENERIC_ERROR:
	   		case E_SER_WRONG_PROTOCOL_VERSION:
	   		case E_SER_WRONG_INTERFACE_VERSION:
	   		case E_SER_MALFORMED_MESSAGE:
	   		case E_SER_WRONG_MESSAGE_TYPE:
«ENDIF-»
	   			serialData->Protected->FxI = TRUE;
				break;

			/* PRQA S 2053 7 # The following error codes do not present in any header files*/
	   		/*
   			case E_E2E_HARD_SAFETY_ERR:
	   		case E_SAFETY_NOSM_ERR:
	   			serialData->Protected->FxI = TRUE;
				break;
			*/

			// Default: Keep the state
			/* PRQA S 2016 2 # Given the unknown error code the FpI state should remain untouched.*/
			default:
				break;
   		}
«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == false-»
		//Sets the FpI port
		serialData->Protected->FP_Rte_Write_PP_FxI_LocalSWC(serialData->Protected->FxI);
«ENDIF-»
    	/*[$Satisfies $DDS_SSFM 083]*/
		if (serialData->Protected->DebouncerRef != NULL_PTR){
			Sum_Ssfm_FxI_Debouncing_Handler(serialData, serialData->Protected);
		}
		// Update E0B8/E0BA
		if(serialData->Protected->FxI == TRUE){
			Sum_Ssfm_DID_E0B8_MetricUpdated(serialData, SUM_SSFM_DID_E0B8_Protected);
			/* Update E0BA - Signal Protection Calculation Incorrect*/
			Sum_Ssfm_DID_E0BA_Update_Message_Protection(serialData);
		}

	}
}
/* PRQA S 1503 20 # The function might be useful for another case later. */
/**
 * @brief			SSFM function used to set the FpI interface state
 *
 * @param[in]       serialData      - Sum_Ssfm_SerialData*:  The SerialData structure to access the message info and RTE functions
 * @param[in]       protection_status - boolean: Value to force for FpI
 * @param[inout]	void
 * @param[out]		void
 * @return			void -
 */
FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_ProtStatus_Manager_Set_FpI(Sum_Ssfm_SerialData* serialData, boolean protection_status)
{
  	/*[$Satisfies $DDS_SSFM 011]*/ /*[$Satisfies $DDS_SSFM 021]*/ /*[$Satisfies $DDS_SSFM 022]*/
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 189]*/
	if((serialData->Protected != NULL_PTR) && (dtcs_are_disabled == FALSE)){
		//Sets the FpI variable equal to the protection status
		serialData->Protected->FxI = protection_status;
«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == false-»
		//Sets the FpI port equal to security_status
	  	serialData->Protected->FP_Rte_Write_PP_FxI_LocalSWC(protection_status);
«ENDIF-»
    	/*[$Satisfies $DDS_SSFM 083]*/
		if (serialData->Protected->DebouncerRef != NULL_PTR){
			Sum_Ssfm_FxI_Debouncing_Handler(serialData, serialData->Protected);
		}
		// Update E0B8/E0BA
		if(serialData->Protected->FxI == TRUE){
			Sum_Ssfm_DID_E0B8_MetricUpdated(serialData, SUM_SSFM_DID_E0B8_Protected);
			/* Update E0BA - Signal Protection Calculation Incorrect */
			Sum_Ssfm_DID_E0BA_Update_Message_Protection(serialData);
		}

	}
}

#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
«ENDIF-»
/* EOF */
«ENDFILE»
«ENDDEFINE»