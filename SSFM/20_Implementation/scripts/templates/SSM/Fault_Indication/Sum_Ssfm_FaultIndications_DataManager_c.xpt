«LET Ssfm_Get_AllComBasedSerialData_InvalidDataDemEvents(controllers, sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData).size
	 + Ssfm_Get_AllServiceBasedSerialDatas_InvalidDataDemEvents(sSFM).size AS DEM_EVENTS_SIZE-»
void Sum_Ssfm_FIM_Dem_CB_DTCStatusChanged(uint32 DTC, Dem_UdsStatusByteType DTCStatusOld, Dem_UdsStatusByteType DTCStatusNew){
	/*[$Satisfies $DDS_SSFM 085]*/
«IF DEM_EVENTS_SIZE > 0-»
	uint16 i;
	for (i = 0; i < «DEM_EVENTS_SIZE»u; i++){
		if (Sum_Ssfm_FxI_DemEvents[i].DTCValue == DTC){
			Sum_Ssfm_FIM_DTCStatusChanged(&Sum_Ssfm_FxI_DemEvents[i], DTCStatusOld, DTCStatusNew);
			break;
		}
	}
«ELSE-»
	// No Dem Event
	return;
«ENDIF-»
}
«ENDLET-»


«REM»
	Since the logic for Authenticated/ContOp/Protected/Safety serial data is the same, to prevent repeating the same code
	in the xpt file, the following FOREACH is used. The DEB_LIST will represent one of the four above mentioned features.
«ENDREM»
«FOREACH {
	"Authenticated",
	"ContOp",
	"Protected",
	"Safety"
	} AS DEB_LIST ITERATOR i-»
«IF Ssfm_IsAnyACPS(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData, DEB_LIST)-»
static void Sum_Ssfm_FIM_«DEB_LIST»_DTCStatusChanged(const Sum_Ssfm_DemEvent* dem_event, const boolean dem_confirmed){
	uint16 i;
	Sum_Ssfm_FxI_SerialData const* fxi_serial_data;

	for (i = 0u; i < SSFM_SSM_NUM_OF_«DEB_LIST.toUpperCase()»_SERIALDATAS; i++){
		if (Sum_Ssfm_FIM_«DEB_LIST»_Debouncers[i].DemEvent == dem_event){
			fxi_serial_data = Sum_Ssfm_FIM_«DEB_LIST»_Debouncers[i].DebouncerOwner.FIM->«DEB_LIST»;
			if(
				fxi_serial_data->FP_Rte_Write_PP_FxFA_LocalSWC != NULL_PTR
			){
				fxi_serial_data->FP_Rte_Write_PP_FxFA_LocalSWC(
					dem_confirmed && fxi_serial_data->FxFA
				);
			}
		}
	}
}
«ENDIF-»
«ENDFOREACH-»

/* PRQA S 3206 1 */ /* DTCStatusOld might be used in the future implementation, thus kept */
static void Sum_Ssfm_FIM_DTCStatusChanged(const Sum_Ssfm_DemEvent* dem_event, Dem_UdsStatusByteType DTCStatusOld, Dem_UdsStatusByteType DTCStatusNew){
	/*[$Satisfies $DDS_SSFM 086]*/
	boolean dem_confirmed = ((SSFM_DEM_DTC_TEST_FAILED_MASK & DTCStatusNew) == SSFM_DEM_DTC_TEST_FAILED_MASK);

«REM»
	For all the four possibilities of Authenticated/ContOp/Protected/Safety check if there is any serial data supporting the
	feature, and call Sum_Ssfm_FIM_<FEATURE>_DTCStatusChanged if the condition met.
«ENDREM»
	«FOREACH {
		"Authenticated",
		"ContOp",
		"Protected",
		"Safety"
		} AS DEB_LIST ITERATOR i-»
	«IF Ssfm_IsAnyACPS(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData, DEB_LIST)-»
	Sum_Ssfm_FIM_«DEB_LIST»_DTCStatusChanged(dem_event, dem_confirmed);
	«ENDIF-»
	«ENDFOREACH-»
}


«REM»
	Since the logic for Authenticated/ContOp/Protected/Safety serial data is the same, to prevent repeating the same code
	in the xpt file, the following FOREACH is used. The DEB_LIST will represent one of the four above mentioned features.
«ENDREM»
«FOREACH {
	"Authenticated",
	"ContOp",
	"Protected",
	"Safety"
	} AS DEB_LIST ITERATOR i-»
«IF Ssfm_IsAnyACPS(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData, DEB_LIST)-»
/* PRQA S 3673 5 # The pointer is not pointing to const to be aligned with the other callbacks used for debouncing callback */
/* PRQA S 0794 5 # The function name can be simillar to other identifiers but there is no point of confusion */
static boolean Sum_Ssfm_FIM_«DEB_LIST»_Debouncer_MUX(Sum_Ssfm_Debouncer* debouncer_instance){
	uint32 i;
	boolean result = FALSE;

	for (i = 0u; i < SSFM_SSM_NUM_OF_«DEB_LIST.toUpperCase()»_SERIALDATAS; i++){
		if((debouncer_instance->DemEvent == Sum_Ssfm_FIM_«DEB_LIST»_Debouncers[i].DemEvent)
				&& (Sum_Ssfm_FIM_«DEB_LIST»_Debouncers[i].LastEvalStatus == SUM_SSFM_EvaluationSts_Failed)){
			result = TRUE;
			break;
		}
	}
	return result;
}
«ENDIF-»
«ENDFOREACH-»

«IF Ssfm_AnyServiceBased(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
/* Helper function to resolve service-based DEM events */
static void Sum_Ssfm_ResolveAllServiceDemEvents(void){
	static boolean allServicesResolved = FALSE;
	boolean anyUnresolved = FALSE;
	uint32 i;	

	if (!allServicesResolved){	
		for (i = 0; i < SSFM_SSM_NUM_OF_SERIALDATAS; i++){
			if((Sum_Ssfm_SerialDatas[i].ServiceInfo != NULL_PTR) && (Sum_Ssfm_SerialDatas[i].ServiceInfo->IsResolved == FALSE)){
				anyUnresolved = TRUE;
				Sum_Ssfm_ResolveServiceDemEvent(&Sum_Ssfm_SerialDatas[i]);
«IF Sum_Ssfm_Errh_U19A6_87_IsValid(sSFM.sum_Ssfm_ConfigSet)-»
				/*[$Satisfies $DDS_SSFM 166]*/
				// Update U19A6_87 by checking all the services. In case of no IP found (ip==0), the ResolveServiceDemEvent function updates the U19A6_87 itself.
				if(Sum_Ssfm_SerialDatas[i].ServiceInfo->IpAddress != 0u){
					Sum_Ssfm_U19A6_87_Update(FALSE);
				}
«ENDIF-»
			}
		}
		
		if (!anyUnresolved){
			allServicesResolved = TRUE;
		}
	}
}
«ENDIF-»
«ENDIF-»

/* PRQA S 3673 5 # The pointer is not pointing to const to be aligned with the other callbacks used for debouncing callback */
void Sum_Ssfm_FIM_Debouncer_MUX(Sum_Ssfm_Debouncer* debouncer_instance){
	/*[$Satisfies $DDS_SSFM 104]*/
	boolean invalid_debouncer = FALSE;
	boolean dem_status;
	boolean debouncer_status = (debouncer_instance->LastEvalStatus == SUM_SSFM_EvaluationSts_Failed) ? TRUE : FALSE;
	// Set FxFA
	switch (debouncer_instance->DebouncerOwnerType){
«IF Ssfm_IsAnyAuthenticated(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
		case SUM_SSFM_DebouncerRefType_FIM_FcI:
			debouncer_instance->DebouncerOwner.FIM->Authenticated->FxFA = debouncer_status;
			break;
«ENDIF-»
«IF Ssfm_IsAnyContOp(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
		case SUM_SSFM_DebouncerRefType_FIM_FoI:
			debouncer_instance->DebouncerOwner.FIM->ContOp->FxFA = debouncer_status;
			break;
«ENDIF-»
«IF Ssfm_IsAnyProtected(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
		case SUM_SSFM_DebouncerRefType_FIM_FpI:
			debouncer_instance->DebouncerOwner.FIM->Protected->FxFA = debouncer_status;
			break;
«ENDIF-»
«IF Ssfm_IsAnySafety(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
		case SUM_SSFM_DebouncerRefType_FIM_FsI:
			debouncer_instance->DebouncerOwner.FIM->Safety->FxFA = debouncer_status;
			break;
«ENDIF-»
		/* PRQA S 2016 5 # The default should do nothing */
		default:
			invalid_debouncer = TRUE;
			break;
	}

	if (!invalid_debouncer){
«IF Ssfm_AnyServiceBased(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
		// Resolve Service Based Serial Datas Dem Event (only if not yet resolved)
		Sum_Ssfm_ResolveAllServiceDemEvents();
«ENDIF-»
«ENDIF-»
		// Check if resolve is executed successfully
		if (debouncer_instance->DemEvent != NULL_PTR)
		{
			«LET Ssfm_IsAnyAuthenticated(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData) AS ANY_Authenticated-»
			«LET Ssfm_IsAnyContOp(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData) AS ANY_ContOp-»
			«LET Ssfm_IsAnyProtected(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData) AS ANY_Protected-»
			«LET Ssfm_IsAnySafety(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData) AS ANY_Safety-»
			// Multiplexing
				«IF ANY_Authenticated-»
			dem_status = Sum_Ssfm_FIM_Authenticated_Debouncer_MUX(debouncer_instance);
				«ENDIF-»
				«IF ANY_ContOp-»
			dem_status = Sum_Ssfm_FIM_ContOp_Debouncer_MUX(debouncer_instance) «ANY_Authenticated ? "|| dem_status" : ""»;
				«ENDIF-»
				«IF ANY_Protected-»
			dem_status = Sum_Ssfm_FIM_Protected_Debouncer_MUX(debouncer_instance) «ANY_Authenticated || ANY_ContOp ? "|| dem_status" : ""»;
				«ENDIF-»
				«IF ANY_Safety-»
			dem_status = Sum_Ssfm_FIM_Safety_Debouncer_MUX(debouncer_instance) «ANY_Authenticated || ANY_ContOp || ANY_Protected ? "|| dem_status" : ""»;
				«ENDIF-»
			«ENDLET-»
			«ENDLET-»
			«ENDLET-»
			«ENDLET-»

			debouncer_instance->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(
				dem_status ? DEM_EVENT_STATUS_FAILED : DEM_EVENT_STATUS_PASSED
			);
		}
	}
}

/*[$Satisfies $DDS_SSFM 150]*/
void Sum_Ssfm_FxI_Debouncing_Handler(Sum_Ssfm_SerialData* serial_data, Sum_Ssfm_FxI_SerialData* FxI_handler){

	«IF Sum_Ssfm_Errh_UXXXX_83_IsValid(sSFM.sum_Ssfm_ConfigSet)-»
   	Sum_Ssfm_EvaluationStatus debouncer_status;
	OperatingRangeType battery_voltage;
	Std_ReturnType ret_battery_voltage = Rte_Read_RP_SUSD_SSFM_Errh_BatteryVoltage_BatteryVoltageRangeMinToMax_OperatingRange(&battery_voltage);
	boolean pn_activestatus = (serial_data->IsNonDiscoverable == TRUE) ? TRUE : Sum_Ssfm_Is_ServiceOrAtLeastOnePNActive(serial_data);
	boolean stable_check = (serial_data->IsNonDiscoverable == TRUE) ? TRUE : Sum_Ssfm_Is_ServiceOrAtLeastOnePNActive_StabilityCheck(serial_data);
	boolean voltage_recovery = Sum_Ssfm_Errh_GetBatteryVoltageRecoveryTimerFlag();
	boolean power_recovery = Sum_Ssfm_Errh_GetResetPowerUpRecoveryTimerFlag();
	/*[$Satisfies $DDS_SSFM 159]*/
	/* PN_DTC_Enabled_Flag gate: block DTCs until at least one PN is in the confirmed stable state (DTC_Allowed); in the keep-alive state (DTC_Might_Be_Allowed), block DTCs until after the first confirmation.
	 * Only applies to OCM-based signals with at least one PN mapping (No_Of_PNs > 0).
	 * Non-discoverable signals and signals with no PN mappings are always allowed. */
	boolean pn_dtc_enabled = (serial_data->IsNonDiscoverable == TRUE) ||
                            (serial_data->MsgInfoGrp == NULL_PTR) ||
                            (serial_data->MsgInfoGrp->No_Of_PNs == 0u) ||
                            (serial_data->MsgInfoGrp->PN_DTC_Enabled_Flag == SUM_SSFM_Pn_Dtc_Enabled);

	if ((E_OK == ret_battery_voltage) && «IF dem.demGeneral.demOBDSupport == "DEM_OBD_NO_OBD_SUPPORT"-» (IN_Range == battery_voltage) «ELSE-» (OUT_OF_RANGE_LOW != battery_voltage) «ENDIF-» && (TRUE == pn_activestatus)
	&& (TRUE == stable_check) && (TRUE == power_recovery) && (TRUE == voltage_recovery)
	&& (TRUE == pn_dtc_enabled))
	{
		debouncer_status = Sum_Ssfm_ErrhDebouncerExecution(FxI_handler->DebouncerRef, (FxI_handler->FxI == TRUE) ? SUM_SSFM_EventSts_Failed : SUM_SSFM_EventSts_Passed);

		if (debouncer_status == SUM_SSFM_EvaluationSts_Failed){
			FxI_handler->FxFA = TRUE;
	«IF Ssfm_AnyServiceBased(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
	«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
			// Update U19A6_87 by checking all the services. In case of no IP found (ip==0), the ResolveServiceDemEvent function updates the U19A6_87 itself.
			if(serial_data->ServiceInfo != NULL_PTR){
				// Resolve Service Based Serial Data Dem Event (only if not yet resolved)
				if(serial_data->ServiceInfo->IsResolved == FALSE){
					Sum_Ssfm_ResolveServiceDemEvent(serial_data);
	«IF Sum_Ssfm_Errh_U19A6_87_IsValid(sSFM.sum_Ssfm_ConfigSet)-»
					/*[$Satisfies $DDS_SSFM 166]*/
					if(serial_data->ServiceInfo->IpAddress != 0u){
						Sum_Ssfm_U19A6_87_Update(FALSE);
					}
	«ENDIF-»
				}
			}
	«ENDIF-»
	«ENDIF-»
			// Check if resolve is executed successfully
			if (FxI_handler->DebouncerRef->DemEvent != NULL_PTR)
			{
				(void)FxI_handler->DebouncerRef->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(
					DEM_EVENT_STATUS_FAILED
				);
			}
		}
		else if (debouncer_status == SUM_SSFM_EvaluationSts_Passed){
			FxI_handler->FxFA = FALSE;
			Sum_Ssfm_FIM_Debouncer_MUX(FxI_handler->DebouncerRef);
		}
		else {
			/* do nothing */
		}

	}

	«ELSE-»
	SUM_PARAM_UNUSED(serial_data);
	SUM_PARAM_UNUSED(FxI_handler);
	«ENDIF-»


«IF !Ssfm_AnyServiceBased(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData) || !Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet)-»
	SUM_PARAM_UNUSED(serial_data);
«ENDIF-»
}

«ENDLET-»«REM»controllers«ENDREM»
«ENDLET-»«REM»ECUs«ENDREM»
#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
/* EOF */
«ENDFILE»
«ENDDEFINE»