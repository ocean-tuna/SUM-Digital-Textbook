static boolean Sum_Ssfm_Get_CalibPar_Ssm_C_UsageOfCanBusOffDTC_«channel.shortName»(void){
  return Rte_CData_Sum_Ssfm_Ssm_C_UsageOfCanBusOffDTC_«channel.shortName»();
}
