/* PRQA S 3218 1 # This variable maybe used by other functions later.*/
Sum_Ssfm_SerialData Sum_Ssfm_SerialDatas[SSFM_SSM_NUM_OF_SERIALDATAS] = {
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SSFM_SERIAL_DATA ITERATOR i-»
	{
	«IF Ssfm_IsAuthenticated(SSFM_SERIAL_DATA)-»
		// SecOCDataId
		{(uint8)«SSFM_SERIAL_DATA.sum_Ssfm_SecOCRxPdu_Ref.secOCDataId.shiftRightOperand(32)»u, (uint8)«SSFM_SERIAL_DATA.sum_Ssfm_SecOCRxPdu_Ref.secOCDataId.shiftRightOperand(24)»u, (uint8)«SSFM_SERIAL_DATA.sum_Ssfm_SecOCRxPdu_Ref.secOCDataId.shiftRightOperand(16)»u, (uint8)«SSFM_SERIAL_DATA.sum_Ssfm_SecOCRxPdu_Ref.secOCDataId.shiftRightOperand(8)»u, (uint8)«SSFM_SERIAL_DATA.sum_Ssfm_SecOCRxPdu_Ref.secOCDataId»u},
		// Authenticated
		&(Sum_Ssfm_Authenticated_SerialDatas[«counterInc("authenticated") - 1»]),
	«ELSE-»
		// SecOCDataId
		{0u, 0u, 0u, 0u, 0u},
		// Authenticated
		NULL_PTR,
	«ENDIF-»
		// ContOp
	«IF Ssfm_IsContOp(SSFM_SERIAL_DATA)-»
		&(Sum_Ssfm_ContOp_SerialDatas[«counterInc("contOp") - 1»]),
	«ELSE-»
		NULL_PTR,
	«ENDIF-»
		// Protected
	«IF Ssfm_IsProtected(SSFM_SERIAL_DATA)-»
		&(Sum_Ssfm_Protected_SerialDatas[«counterInc("protected") - 1»]),
	«ELSE-»
		NULL_PTR,
	«ENDIF-»
		// Safety
	«IF Ssfm_IsSafety(SSFM_SERIAL_DATA)-»
		&(Sum_Ssfm_Safety_SerialDatas[«counterInc("safety") - 1»]),
	«ELSE-»
		NULL_PTR,
	«ENDIF-»
		// FxI Source
	«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == true-»
		«LET Ssfm_GetFxISourceVariable(SSFM_SERIAL_DATA) AS FxISource-»
		«IF FxISource == "FoI"-»
		SUM_SSFM_FxI_Source_FoI,
		«ELSEIF FxISource == "FsI"-»
		SUM_SSFM_FxI_Source_FsI,
		«ELSEIF FxISource == "FpI"-»
		SUM_SSFM_FxI_Source_FpI,
		«ELSE-»
		SUM_SSFM_FxI_Source_FcI,
		«ENDIF-»
		«ENDLET-»
	«ELSE-»
		SUM_SSFM_FxI_Source_Invalid,
	«ENDIF-»
		// Message Info
	«IF Ssfm_IsMessageInfo(SSFM_SERIAL_DATA)-»
		&(Sum_Ssfm_MessageInfoGroups[«counterInc("messageinfo") - 1»]),
	«ELSE-»
		NULL_PTR,
	«ENDIF-»
		// LIN Info
	«IF Ssfm_IsLINChannelCfg(SSFM_SERIAL_DATA)-»
		&(Sum_Ssfm_LINSignal[«counterInc("LINInfo") - 1»]),
	«ELSE-»
		NULL_PTR,
	«ENDIF-»
		// LostComm
	«IF Ssfm_IsNonDiscoverableService(SSFM_SERIAL_DATA)-»
		/*Non-discoverable services do not participate in LoC */
		NULL_PTR,
	«ELSEIF Ssfm_IsSerialDataLcFA(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo, SSFM_SERIAL_DATA)-»
		&(Sum_Ssfm_SerialDatas_LostCommInfo[«counterInc("LcFA") - 1»]),
	«ELSE-»
		NULL_PTR,
	«ENDIF-»
		// Service Info
	«IF Ssfm_IsServiceBased(SSFM_SERIAL_DATA)-»
		&(Sum_Ssfm_ServiceInfo_SerialDatas[«counterInc("ServiceBased") - 1»]),
	«ELSE-»
		NULL_PTR,
	«ENDIF-»
		/* Message ID */
		«Ssfm_GetMessageID(SSFM_SERIAL_DATA)»u,
		/* DID E0B8 */
		FALSE,
		/* IsNonDiscoverable */
«IF Ssfm_IsNonDiscoverableService(SSFM_SERIAL_DATA)-»		TRUE«ELSE-»		FALSE«ENDIF-»,
	},
«ENDFOREACH-»
};

«LET Ssfm_Get_AllComBasedSerialData_InvalidDataDemEvents(controllers, sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData) AS SIG_DEM_EVENTS-»
«LET Ssfm_Get_AllServiceBasedSerialDatas_InvalidDataDemEvents(sSFM) AS SERVICE_DEM_EVENTS-»
«LET Ssfm_Get_InvalidLINDemEvents(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_LINInfo) AS LIN_DEM_EVENTS-»
