«LET sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUs-»
«LET Ssfm_GetControllerECUInfos(ECUs, false) AS controllers-»

static Sum_Ssfm_SerialData_LostCommInfo Sum_Ssfm_SerialDatas_LostCommInfo[«Ssfm_NumOfSerialDataLcFA(ECUs, sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)»] = {
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SSFM_SERIAL_DATA-»
«IF Ssfm_IsSerialDataLcFA(ECUs, SSFM_SERIAL_DATA) && !Ssfm_IsNonDiscoverableService(SSFM_SERIAL_DATA)-»
«LET Ssfm_GetSerialDataControllers(controllers, SSFM_SERIAL_DATA) AS SerialDataControllers-»
	{
		ECU_NODE_STATUS_NO_MISSINGMSG,
		// By default the current provider will be set to the number of ECUs meaning that the provider is not known
		«IF Ssfm_IsServiceBased(SSFM_SERIAL_DATA) || Ssfm_HasMultipleProvider(controllers, SSFM_SERIAL_DATA)-»
		NULL_PTR,
		«ELSE-»
		&Sum_Ssfm_Controller_«SerialDataControllers.get(0).getProperty("name")»,
		«ENDIF-»
		/* Function pointer to write the SerialData_LcFA status*/
		&Rte_Write_SUM_SSFM_PP_SSFM_SerialData_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()-»_LcFA_SSFM_RxSerialData_LcFA,
		/* Function pointer to calibration usage of CAN BUS OFF DTC */
«IF (SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref!=null) &&
    (SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref!=null) &&
    (SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref.comMBusType == "COMM_BUS_TYPE_CAN")-»
		&Sum_Ssfm_Get_CalibPar_Ssm_C_UsageOfCanBusOffDTC_«SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref.shortName»,
«ELSE-»
		NULL_PTR,
«ENDIF-»
        /* Function pointer to get status of the DTCs BUS OFF for each CAN channel */
«LET (SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref!=null) ? SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref.getReferrers().parent.typeSelect(Sum_Ssfm_Errh_BswError) : {} AS demEvents -»
«IF (!demEvents.isEmpty) &&
    (SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref!=null) &&
    (SSFM_SERIAL_DATA.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref.comMBusType == "COMM_BUS_TYPE_CAN")-»
		&Sum_Ssfm_Errh_Publish_«demEvents.first().sum_Ssfm_Channel_Ref.shortName-»,
«ELSE-»
		NULL_PTR,
«ENDIF-»
«ENDLET-»
	},
«ENDLET-»
«ENDIF-»
«ENDFOREACH-»
};

