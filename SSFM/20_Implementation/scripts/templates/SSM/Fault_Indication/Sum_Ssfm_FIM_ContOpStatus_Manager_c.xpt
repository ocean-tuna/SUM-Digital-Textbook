 *********************************************************************************************************************************************************
 */

/* PRQA S 1532 EOF # The functions are invoked by runnables or other functions in external file */
/* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */

#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"


/**
 * @brief			SSFM function used to set the FoI interface state
 *
 * @param[in]       serialData      - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[in]       transformer_error - const Rte_TransformerError*: E2E/Transformer check status
 * @param[inout]	void
 * @param[out]		void
 * @return			void
 */
/* PRQA S 1532 11 # The function belongs to ContOpStatus Manager yet used in ReceivedSerialData Handler. */
FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_ContOpStatus_Manager_Set_FoI_Given_Transformer_Error(Sum_Ssfm_SerialData* serialData, const Rte_TransformerError* transformer_error)
{
   	/*[$Satisfies $DDS_SSFM 014]*/ /*[$Satisfies $DDS_SSFM 015]*/
   	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

   	// Check if SerialData is ContOp
   	/*[$Satisfies $DDS_SSFM 189]*/
    if((serialData->ContOp != NULL_PTR) && (dtcs_are_disabled == FALSE))
    {
    	switch(transformer_error->errorCode){
    		// No Error: Set FoI to False
    		case E_OK:
    		case E_SAFETY_NODATA_OK:
    		case E_SAFETY_INIT_OK:
    		case E_SAFETY_INVALID_OK:
    			serialData->ContOp->FxI = FALSE;
    			break;

    		// Error: Set FoI to True
	   		case E_SAFETY_VALID_REP:
	   		case E_SAFETY_VALID_SEQ:
	   		case E_SAFETY_NODATA_REP:
	   		case E_SAFETY_NODATA_SEQ:
	   		case E_SAFETY_INIT_REP:
	   		case E_SAFETY_INIT_SEQ:
	   		case E_SAFETY_INVALID_REP:
	   		case E_SAFETY_INVALID_SEQ:
	   		case E_SAFETY_SOFT_RUNTIMEERROR:
	   		case E_SAFETY_HARD_RUNTIMEERROR:
«IF Ssfm_AnySomeIpConfigured(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
   			case E_SER_GENERIC_ERROR:
	   		case E_SER_WRONG_PROTOCOL_VERSION:
	   		case E_SER_WRONG_INTERFACE_VERSION:
	   		case E_SER_MALFORMED_MESSAGE:
	   		case E_SER_WRONG_MESSAGE_TYPE:
«ENDIF-»
	   			serialData->ContOp->FxI = TRUE;
				break;

			/* PRQA S 2053 6 # The following error codes do not present in any header files*/
	   		/*
	   		case E_SAFETY_NOSM_REP:
	   		case E_SAFETY_NOSM_SEQ:
	   			serialData->ContOp->FxI = TRUE;
				break;
			*/

			// Default: Keep the state
			/* PRQA S 2016 2 # Given the unknown error code the FoI state should remain untouched.*/
			default:
				break;
   		}
«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == false-»
		//Sets the FoI port equal to cont_op_status
		serialData->ContOp->FP_Rte_Write_PP_FxI_LocalSWC(serialData->ContOp->FxI);
«ENDIF-»
    	/*[$Satisfies $DDS_SSFM 082]*/
		if (serialData->ContOp->DebouncerRef != NULL_PTR){
			Sum_Ssfm_FxI_Debouncing_Handler(serialData, serialData->ContOp);
		}
		// Update E0B8/E0BA
		if(serialData->ContOp->FxI == TRUE){
			Sum_Ssfm_DID_E0B8_MetricUpdated(serialData, SUM_SSFM_DID_E0B8_ContOp);
			/* Update E0BA - Signal Protection Calculation Incorrect*/
			Sum_Ssfm_DID_E0BA_Update_Message_Protection(serialData);
		}

	}
}

#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
«ENDIF-»
/* EOF */
«ENDFILE»
«ENDDEFINE»