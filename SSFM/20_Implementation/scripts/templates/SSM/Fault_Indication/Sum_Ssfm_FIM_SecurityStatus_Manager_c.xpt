 *********************************************************************************************************************************************************
 * Functions Declaration
 *********************************************************************************************************************************************************
 */


static Sum_Ssfm_SerialData* Sum_Ssfm_prv_GetSerialData_GivenSecOCDataID(const uint8* secOCDataId);


/*
 *********************************************************************************************************************************************************
 * Functions Definition
 *********************************************************************************************************************************************************
 */

/* PRQA S 1532 EOF # The functions are invoked by runnables or other functions in external file */
/* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */

#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"

/**
 * @brief			The getter function to get the SerialData given its secOCDataId
 *
 * @param[in]		const uint8* secOCDataId
 * @param[inout]	void
 * @param[out]		void
 * @return			Sum_Ssfm_SerialData*
 */
static Sum_Ssfm_SerialData* Sum_Ssfm_prv_GetSerialData_GivenSecOCDataID(const uint8* secOCDataId){

    /*[$Satisfies $DDS_SSFM 011]*/

    // If no SerialData will be found having secOCdataID equal to the input parameter, the
    // return value will be equal to NULL_PTR
	Sum_Ssfm_SerialData* serialData = NULL_PTR;
	uint32 i;
	/*PRQA S 2877 2*/ // The number of iterations depends on the configuration
	// It loops across all the SerialDatas
	for(i = 0; i < SSFM_SSM_NUM_OF_SERIALDATAS; i++){
		if(Sum_Ssfm_SerialDatas[i].Authenticated != NULL_PTR){
		    // If any of the configured SerialDatas has a secOCDataId equal to the input parameter
			if  ((Sum_Ssfm_SerialDatas[i].secOCDataId[0] == secOCDataId[0]) &&
				(Sum_Ssfm_SerialDatas[i].secOCDataId[1] == secOCDataId[1]) &&
				(Sum_Ssfm_SerialDatas[i].secOCDataId[2] == secOCDataId[2]) &&
				(Sum_Ssfm_SerialDatas[i].secOCDataId[3] == secOCDataId[3]) &&
				(Sum_Ssfm_SerialDatas[i].secOCDataId[4] == secOCDataId[4])){
				  // The SerialData has been found and we can return a pointer to it
				  serialData = &Sum_Ssfm_SerialDatas[i];
				  break;
			}
		}
	}
	return serialData;
}


/**
 * @brief			SSFM function used to set the FcI interface state
 *
 * @param[in]       serialData      - Sum_Ssfm_SerialData*:  The SerialData structure to access the SerialData info and RTE functions
 * @param[in]       security_status - boolean: Value to force for FcI
 * @param[inout]	void
 * @param[out]		void
 * @return			void -
 */
FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_SecStatus_Manager_Set_FcI(Sum_Ssfm_SerialData* serialData, boolean security_status)
{
   /*[$Satisfies $DDS_SSFM 010]*/ /*[$Satisfies $DDS_SSFM 012]*/
   	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

   	if((serialData->Authenticated != NULL_PTR) && (dtcs_are_disabled == FALSE)){
		//Sets the FcI variable equal to the security status
		serialData->Authenticated->FxI = security_status;
«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == false-»
		//Sets the FcI port equal to security_status
	  	serialData->Authenticated->FP_Rte_Write_PP_FxI_LocalSWC(security_status);
«ENDIF-»
    	/*[$Satisfies $DDS_SSFM 081]*/
		if (serialData->Authenticated->DebouncerRef != NULL_PTR){
			Sum_Ssfm_FxI_Debouncing_Handler(serialData, serialData->Authenticated);
		}
	}
}


/* PRQA S 1503 9 */ //This function will be called by the RTE
/**
 * @brief			SSFM Verification Status Callout function to set the FcI interface state of the corresponding SerialData
 *
 * @param[in]		SecOC_VerificationStatusType verificationStatus
 * @param[inout]	void
 * @param[out]		void
 * @return			void -
 */
void SSFM_Verification_Status_Callout(SecOC_VerificationStatusType verificationStatus){
    /*[$Satisfies $DDS_SSFM 010]*/ /*[$Satisfies $DDS_SSFM 011]*/ /*[$Satisfies $DDS_SSFM 021]*/

	Sum_Ssfm_SerialData* serialData;
	boolean Sum_Ssfm_Mac_Authentication_Enable;

    //If the SUSD permits the execution
	if(TRUE == Sum_Ssfm_Ssm_GetFuncPermitExecution())
	{
	    //Find the configured SerialData that has secOCDataId equal to the one in the input parameter
	    serialData = Sum_Ssfm_prv_GetSerialData_GivenSecOCDataID(verificationStatus.secOCDataId);
        //If it exists one configured SerialData that has secOCDataId equal to the one in  the input parameter
		if(serialData != NULL_PTR)
		{
			(void)serialData->Authenticated->FP_AuthenticationEnable(&Sum_Ssfm_Mac_Authentication_Enable);

		    //If a MAC verification failure occurred
		    if(
				(verificationStatus.verificationStatus == SECOC_VERIFICATIONFAILURE) ||
				(verificationStatus.verificationStatus == SECOC_FRESHNESSFAILURE) ||
				(verificationStatus.verificationStatus == SECOC_AUTHENTICATIONBUILDFAILURE) ||
				(verificationStatus.verificationStatus == SECOC_VERIFICATIONFAILURE_OVERWRITTEN)||
			  ((verificationStatus.verificationStatus == SECOC_NO_VERIFICATION) && (Sum_Ssfm_Mac_Authentication_Enable == TRUE))
				)
			{
	      		//Set the FcI and FpI status to true
	           	Sum_Ssfm_SecStatus_Manager_Set_FcI(serialData, TRUE);
                Sum_Ssfm_ProtStatus_Manager_Set_FpI(serialData, TRUE);
                /*[$Satisfies $DDS_SSFM 027]*/
                Sum_Ssfm_SafetyStatus_Manager_Populate_FsI(serialData);
				«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == true-»
				/*[$Satisfies $DDS_SSFM 078]*/
				// Set the single port FxI
		    	Sum_Ssfm_SingleFxI_Manager_Set_FxI(serialData);
				«ENDIF-»
        		Sum_Ssfm_SigStsAvailability_Manager_CANETH(serialData);
			}
			// Note: if we get inside the else-if Sum_Ssfm_Mac_Authentication_Enable is always false, so we don't need to
			//       explicitly check it
			else if (verificationStatus.verificationStatus == SECOC_NO_VERIFICATION)
			{
				/*[$Satisfies $DDS_SSFM 075]*/
				//Set the FcI and FpI status to false
	           	Sum_Ssfm_SecStatus_Manager_Set_FcI(serialData, FALSE);
                Sum_Ssfm_ProtStatus_Manager_Set_FpI(serialData, FALSE);
                /*[$Satisfies $DDS_SSFM 027]*/
                Sum_Ssfm_SafetyStatus_Manager_Populate_FsI(serialData);
				«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == true-»
				/*[$Satisfies $DDS_SSFM 078]*/
				// Set the single port FxI
		    	Sum_Ssfm_SingleFxI_Manager_Set_FxI(serialData);
				«ENDIF-»
        		Sum_Ssfm_SigStsAvailability_Manager_CANETH(serialData);

			}
			else
			{
				/* Nothing to do */
			}
		}
	}
}


#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
«ENDIF-»
/* EOF */
«ENDFILE»
