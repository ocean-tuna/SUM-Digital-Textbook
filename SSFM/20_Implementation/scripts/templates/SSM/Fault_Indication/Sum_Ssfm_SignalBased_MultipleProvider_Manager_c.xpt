/* Include SSFM-SSM Top Level Library */
#include "Sum_Ssfm.h"

/* PRQA S 1532 EOF # Here for modularity */
/* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 3469 EOF # The function like macros is used. This is necessary to get value via RTE variable */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */
#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"
«LET sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUs-»
«LET Ssfm_GetControllerECUInfos(ECUs, false) AS controllers-»

/*
 *********************************************************************************************************************************************************
 * Functions Declaration
 *********************************************************************************************************************************************************
 */

/**
 * @brief           SSFM/SSM getters of calibration parameter for each PDU-Controller pair
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          boolean - Calibration parameter
 */
«FOREACH controllers AS controller-»
	«FOREACH Ssfm_GetControllerTxPDUs(controller)
		.select(pdu |
			Ssfm_GetPDUControllerSerialDatas(controller, pdu).exists(
				serial_data | Ssfm_HasMultipleProvider(controllers, serial_data)
			)
		) AS PDU-»
static boolean Sum_Ssfm_Get_CalibPar_C_«PDU»_IsReceivedFrom_«controller.getProperty("ecu_name")» (void)
{ return Rte_CData_SSM_C_«PDU»_IsReceivedFrom_«controller.getProperty("ecu_name")»(); }
	«ENDFOREACH-»
«ENDFOREACH-»


/*
 *********************************************************************************************************************************************************
 * Variables (Global)
 *********************************************************************************************************************************************************
 */

/*
 *********************************************************************************************************************************************************
 * Functions Definition
 *********************************************************************************************************************************************************
 */

void Sum_Ssfm_SetSerialDatasProviders(void){
	/*[$Satisfies $DDS_SSFM 116]*/
«FOREACH controllers AS controller-»
	«FOREACH Ssfm_GetControllerTxPDUs(controller)
		.select(pdu |
			Ssfm_GetPDUControllerSerialDatas(controller, pdu).exists(
				serial_data | Ssfm_HasMultipleProvider(controllers, serial_data)
			)
		)
	 AS PDU-»
	if (Sum_Ssfm_Get_CalibPar_C_«PDU»_IsReceivedFrom_«controller.getProperty("ecu_name")»()){
		«FOREACH Ssfm_GetPDUControllerSerialDatas(controller, PDU)
			.select(serial_data | Ssfm_HasMultipleProvider(controllers, serial_data))
			.select(serial_data | !Ssfm_IsServiceBased(serial_data)).toSet()
			AS SERIAL_DATA-»
			«LET Ssfm_Get_AllComBasedSerialData_InvalidDataDemEvents(controllers, sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData).indexOf(controller.getProperty("invalid_data_DEM")) AS DEM_INDEX-»
			«IF SERIAL_DATA.Ssfm_IsAuthenticated()-»
		Sum_Ssfm_FIM_Authenticated_Debouncers[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.select(e | e.Ssfm_IsAuthenticated()).indexOf(SERIAL_DATA)»].DemEvent = &(Sum_Ssfm_FxI_DemEvents[«DEM_INDEX»]);
			«ENDIF-»
			«IF SERIAL_DATA.Ssfm_IsContOp()-»
		Sum_Ssfm_FIM_ContOp_Debouncers[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.select(e | e.Ssfm_IsContOp()).indexOf(SERIAL_DATA)»].DemEvent = &(Sum_Ssfm_FxI_DemEvents[«DEM_INDEX»]);
			«ENDIF-»
			«IF SERIAL_DATA.Ssfm_IsProtected()-»
		Sum_Ssfm_FIM_Protected_Debouncers[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.select(e | e.Ssfm_IsProtected()).indexOf(SERIAL_DATA)»].DemEvent = &(Sum_Ssfm_FxI_DemEvents[«DEM_INDEX»]);
			«ENDIF-»
			«IF SERIAL_DATA.Ssfm_IsSafety()-»
		Sum_Ssfm_FIM_Safety_Debouncers[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.select(e | e.Ssfm_IsSafety()).indexOf(SERIAL_DATA)»].DemEvent = &(Sum_Ssfm_FxI_DemEvents[«DEM_INDEX»]);
			«ENDIF-»
			«ENDLET-»

			«IF Ssfm_IsSerialDataLcFA(ECUs, SERIAL_DATA) && !Ssfm_IsNonDiscoverableService(SERIAL_DATA)-»
			«LET Ssfm_GetSerialDataControllers(controllers, SERIAL_DATA) AS SerialDataControllers-»
		Sum_Ssfm_SerialDatas[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.indexOf(SERIAL_DATA)»].LostCommInfo->CurrentProvider = &Sum_Ssfm_Controller_«controller.getProperty("name")»;
			«ENDLET-»
			«ENDIF-»
		«ENDFOREACH-»
	}
	«ENDFOREACH-»
«ENDFOREACH-»
}

«ENDLET-»«REM»controllers«ENDREM»
«ENDLET-»«REM»ECUs«ENDREM»

#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
