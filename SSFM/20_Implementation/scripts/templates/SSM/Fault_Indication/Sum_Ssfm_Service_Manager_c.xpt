«IF Ssfm_AnyServiceBased(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
static void Sum_Ssfm_UnassignFxIDemFromService(const Sum_Ssfm_SerialData* service_based_serialdata){
	/*[$Satisfies $DDS_SSFM 101]*/
«FOREACH {
	"Authenticated",
	"ContOp",
	"Protected",
	"Safety"
	} AS DEB_LIST ITERATOR i-»
«IF Ssfm_IsAnyACPS(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData, DEB_LIST)-»
	if(service_based_serialdata->«DEB_LIST» != NULL_PTR){
		service_based_serialdata->«DEB_LIST»->DebouncerRef->DemEvent = NULL_PTR;
	}
«ENDIF-»
«ENDFOREACH-»
}

static void Sum_Ssfm_UnassignLoFDemFromService(const Sum_Ssfm_SerialData* service_based_serialdata){
	/*[$Satisfies $DDS_SSFM 107]*/
	if((service_based_serialdata->LostCommInfo != NULL_PTR) &&
		(service_based_serialdata->LostCommInfo->CurrentProvider != NULL_PTR)){

		service_based_serialdata->LostCommInfo
			->CurrentProvider
			->ECUFilter->DemEvent = NULL_PTR;
		service_based_serialdata->LostCommInfo->CurrentProvider = NULL_PTR;
	}
}

«LET Ssfm_Get_AllComBasedSerialData_InvalidDataDemEvents(controllers, sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData) AS SIG_DEM_EVENTS-»
«LET Ssfm_Get_AllServiceBasedSerialDatas_InvalidDataDemEvents(sSFM) AS SERVICE_DEM_EVENTS-»
static void Sum_Ssfm_AssignFxIDemToService(const Sum_Ssfm_SerialData* service_based_serialdata, uint32 dtc_value_high_byte){
	/*[$Satisfies $DDS_SSFM 102]*/
	uint16 i;
	boolean dem_found = FALSE;

	// Assign FIM Dem Events
	for(i = «SIG_DEM_EVENTS.size-»u; i < «SIG_DEM_EVENTS.size + SERVICE_DEM_EVENTS.size»u; i++){
		if(Sum_Ssfm_FxI_DemEvents[i].DTCValue == ((dtc_value_high_byte << 8) + (uint32)SSFM_DTC_VALUE_LOW_BYTE_INVALID_DATA)){
		«FOREACH {
			"Authenticated",
			"ContOp",
			"Protected",
			"Safety"
			} AS DEB_LIST ITERATOR i-»
		«IF Ssfm_IsAnyACPS(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData, DEB_LIST)-»
			if(service_based_serialdata->«DEB_LIST» != NULL_PTR){
				service_based_serialdata->«DEB_LIST»->DebouncerRef->DemEvent = &Sum_Ssfm_FxI_DemEvents[i];
			}
		«ENDIF-»
		«ENDFOREACH-»
			dem_found = TRUE;
			break;
		}
	}

	if(!dem_found){
		Sum_Ssfm_UnassignFxIDemFromService(service_based_serialdata);
	}
}

static void Sum_Ssfm_AssignLoFDemToService(const Sum_Ssfm_SerialData* service_based_serialdata, uint32 dtc_value_high_byte){
	/*[$Satisfies $DDS_SSFM 108]*/
	uint16 i;
	boolean dem_found = FALSE;
	if(service_based_serialdata->LostCommInfo != NULL_PTR){
		for(i = 0u; i < SSFM_NUM_OF_SERVICEBASED_TARGETDEVICES; i++){
			if(Sum_Ssfm_LoF_DemEvents[i].DTCValue == ((dtc_value_high_byte << 8) + (uint32)SSFM_DTC_VALUE_LOW_BYTE_LOSS_OF_FUNCTION)){
				// Check if the relevant ECU is already found
				if (service_based_serialdata->LostCommInfo->CurrentProvider != NULL_PTR){
					service_based_serialdata->LostCommInfo
						->CurrentProvider
						->ECUFilter->DemEvent = &Sum_Ssfm_LoF_DemEvents[i];
					dem_found = TRUE;
				}
				break;
			}
		}
		if(!dem_found){
			Sum_Ssfm_UnassignLoFDemFromService(service_based_serialdata);
		}
	}
}

void Sum_Ssfm_ResolveServiceDemEvent(Sum_Ssfm_SerialData* service_based_serialdata){
	/*[$Satisfies $DDS_SSFM 103]*/
	Std_ReturnType ret_value;
	uint32 ip_address;
	uint16 dtc_value_high_byte;
	uint8 i, j;
	boolean serial_data_loss_of_comm;

	if (service_based_serialdata->ServiceInfo != NULL_PTR){
		ret_value = Sd_GetNodeAddress(
			service_based_serialdata->ServiceInfo->ServiceID,
			service_based_serialdata->ServiceInfo->InstanceID,
			service_based_serialdata->ServiceInfo->MajorVersion,
			&ip_address
		);
		if ((ret_value == E_OK) && (ip_address != 0u)){
			if (service_based_serialdata->ServiceInfo->IpAddress != ip_address){
				service_based_serialdata->ServiceInfo->IpAddress = ip_address;
				/* PRQA S 2812 1 # Setting to Null is safe as it will be checked before usage.*/
				service_based_serialdata->LostCommInfo->CurrentProvider = NULL_PTR;
				// Set the current provider controller
				for (i = 0u; i < SUM_SSFM_NUM_OF_TRGDVCS; i++){
					for(j = 0u; j < Sum_Ssfm_TrgDvcs[i]->IpAddressListLength; j++){
						if (Sum_Ssfm_TrgDvcs[i]->IpAddressList[j] == ip_address){
							service_based_serialdata->LostCommInfo->CurrentProvider = Sum_Ssfm_TrgDvcs[i];
							break;
						}
					}
					if(service_based_serialdata->LostCommInfo->CurrentProvider != NULL_PTR){ // Target device found
						break;
					}
				}
				(void)Rte_Call_SUM_SSFM_RP_SPM_SSFM_GetDTCIdentifier_GetDTCIdentifier(
					ip_address,
					&dtc_value_high_byte
				);
				Sum_Ssfm_AssignFxIDemToService(
					service_based_serialdata,
					(uint32)dtc_value_high_byte);
				Sum_Ssfm_AssignLoFDemToService(
					service_based_serialdata,
					(uint32)dtc_value_high_byte);

				/*[$Satisfies $DDS_SSFM 156]*/
				/* Get serial data loss of comm status */
				serial_data_loss_of_comm = Sum_Ssfm_IsSerialDataInLossOfComm(service_based_serialdata);
				// Update AV, since the new provider might have a different NodeSts
				Sum_Ssfm_SigStsAvailability_Manager_CANETH(service_based_serialdata);
				// Update LcFA, since the new provider might have a different NodeSts
				service_based_serialdata->LostCommInfo->Rte_Write_LcFA(serial_data_loss_of_comm);
				/*[$Satisfies $DDS_SSFM 103]*/
				// Mark as resolved: IP successfully retrieved and provider assigned
				service_based_serialdata->ServiceInfo->IsResolved = TRUE;
			}
			else {
				// Do nothing, the ip matches the previous IP.
				// It is assumed that if the IP is not changed then the Dem Event is not changed as well.
				// Mark as resolved: IP already known and unchanged, no re-resolution needed
				service_based_serialdata->ServiceInfo->IsResolved = TRUE;
			}
		}
		else {
			// Unset the dem related parameters to null/default value as the event is not resolved
			service_based_serialdata->ServiceInfo->IpAddress = 0u;
			Sum_Ssfm_UnassignFxIDemFromService(service_based_serialdata);
			Sum_Ssfm_UnassignLoFDemFromService(service_based_serialdata);
«IF Sum_Ssfm_Errh_U19A6_87_IsValid(sSFM.sum_Ssfm_ConfigSet)-»
«IF Ssfm_DID_E0CD_IsConfigured(sSFM) -»	
			/* Notify SrvcMgr about missing service */		
			/*[$Satisfies $DDS_SSFM 216]*/
			(void)Rte_Write_PP_SSFM_SrvcMgr_SDMissingMessage_SSFM_ServiceId(service_based_serialdata->ServiceInfo->ServiceID);
«ENDIF-»
			/*[$Satisfies $DDS_SSFM 166]*/
			Sum_Ssfm_U19A6_87_Update(TRUE);
«ENDIF-»
		}
	}
}
