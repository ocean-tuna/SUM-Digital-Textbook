«IF Ssfm_IsAnySafety(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)»
/* Include SSFM-SSM Top Level Library */
#include "Sum_Ssfm.h"

/* PRQA S 3469 EOF # The function like macros is used. This is necessary to get value via RTE variable */
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SSFM_SERIAL_DATA ITERATOR i-»
«IF Ssfm_IsSafety(SSFM_SERIAL_DATA)-»
«LET SSFM_SERIAL_DATA.sum_Ssfm_FsI_Debouncer.sum_Ssfm_EventFilter_Ref AS DEB_INSTANCE-»
	«IF Ssfm_isXofYFilterType(DEB_INSTANCE)-»
static uint16 Sum_Ssfm_Get_CalibPar_DebX_«SSFM_SERIAL_DATA.shortName»_FsI(void){
	return Rte_CData_«DEB_INSTANCE.shortName»_X();
}
static uint16 Sum_Ssfm_Get_CalibPar_DebY_«SSFM_SERIAL_DATA.shortName»_FsI(void){
	return Rte_CData_«DEB_INSTANCE.shortName»_Y();
}
	«ENDIF-»
«ENDLET-»
«ENDIF-»
«ENDFOREACH-»

/*
 *********************************************************************************************************************************************************
 * Variables (Global)
 *********************************************************************************************************************************************************
 */
/* PRQA S 1531 1 # Based on the architecture design it is decided to keep the object in the corresponding component. */
Sum_Ssfm_FxI_SerialData Sum_Ssfm_Safety_SerialDatas[SSFM_SSM_NUM_OF_SAFETY_SERIALDATAS] = {
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SSFM_SERIAL_DATA-»
«IF Ssfm_IsSafety(SSFM_SERIAL_DATA)-»
	{
		// FsI variable
		FALSE,
	    // FsI Port
		«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == false-»
		&Rte_Write_PP_SSFM_SerialData_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()»_FsI_FsI_Safety,
		«ELSEIF Ssfm_GetFxISourceVariable(SSFM_SERIAL_DATA) == "FsI"-»
		&Rte_Write_PP_SSFM_SerialData_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()»_FxI_RxSerialData_FxI,
		«ELSE-»
		NULL_PTR,
		«ENDIF-»
		// FsFA variable
		FALSE,
	    // FsI Port
		«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == false-»
		&Rte_Write_PP_SSFM_SerialData_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()»_FsFA_DTC_STATUS_FSFA,
		«ELSEIF Ssfm_GetFxISourceVariable(SSFM_SERIAL_DATA) == "FsI"-»
		&Rte_Write_PP_SSFM_SerialData_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()»_FxFA_DTC_STATUS_FXFA,
		«ELSE-»
		NULL_PTR,
		«ENDIF-»
		// Event Debouncer Ref
		&(Sum_Ssfm_FIM_Safety_Debouncers[«counterInc("safety") - 1»]),
		/* MAC authentication is enabled or not */
		NULL_PTR,
		/* Number of occurrence */
		0u,
	},
«ENDIF-»
«ENDFOREACH-»
};

«LET sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo AS ECUs-»
«LET Ssfm_GetControllerECUInfos(ECUs, false) AS controllers-»
Sum_Ssfm_Debouncer Sum_Ssfm_FIM_Safety_Debouncers[SSFM_SSM_NUM_OF_SAFETY_SERIALDATAS] = {
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.select(e | e.Ssfm_IsSafety()) AS SERIAL_DATA-»
«LET SERIAL_DATA.sum_Ssfm_FsI_Debouncer.sum_Ssfm_EventFilter_Ref AS DEB_INSTANCE-»
	{
		/* Error filter type */
		SUM_SSFM_ErrorFilter_«Ssfm_GetFilterType(DEB_INSTANCE)-»,
		«IF Ssfm_isXofYFilterType(DEB_INSTANCE)-»
		/* Number of configured X threshold */
		&Sum_Ssfm_Get_CalibPar_DebX_«SERIAL_DATA.shortName»_FsI,
		/* Number of configured Y threshold */
		&Sum_Ssfm_Get_CalibPar_DebY_«SERIAL_DATA.shortName»_FsI,
		«ELSE-»
		/* Number of configured X threshold */
		NULL_PTR,
		/* Number of configured Y threshold */
		NULL_PTR,
		«ENDIF-»
		/* Callback function */
		«IF Ssfm_IsTimeBasedFilterType(DEB_INSTANCE)-»
		&Sum_Ssfm_FIM_Debouncer_MUX,
		«ELSE-»
		NULL_PTR,
		«ENDIF-»
		/* Counter failed event */
		0u,
		/* Number of sample or ms*/
		0u,
		/* First failed flag */
		FALSE,
		/* Last Evaluation Status */
		SUM_SSFM_EvaluationSts_Unknown,
		/* Reference to Safety Serial Data */
		{.FIM = &Sum_Ssfm_SerialDatas[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.indexOf(SERIAL_DATA)»]}, /* PRQA S 1053 # To use the union type. */
		/* Owner Type*/
		SUM_SSFM_DebouncerRefType_FIM_FsI,
		/* Reference to DemEvent */
		«IF !SERIAL_DATA.Ssfm_IsLINChannelCfg()-»
		«IF SERIAL_DATA.Ssfm_IsServiceBased()-»
		// Resolved in runtime for service based traffic
		NULL_PTR,
		«ELSE-»
			«LET Ssfm_Get_ComBasedSerialData_InvalidDataDemEvents(controllers, SERIAL_DATA) AS DEM_EVENTS-»
			«IF DEM_EVENTS.size > 1 -»
		// Resolved in runtime for multiple provider serial data
		NULL_PTR,
			«ELSE-»
		&(Sum_Ssfm_FxI_DemEvents[«Ssfm_Get_AllComBasedSerialData_InvalidDataDemEvents(controllers, sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData).indexOf(DEM_EVENTS.get(0))»]),
			«ENDIF-»
			«ENDLET-»
		«ENDIF-»
		«ELSE-»
			«LET Ssfm_Get_LINInfoOfSerialData(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_LINInfo, SERIAL_DATA) AS LIN_INFO-»
			«LET Ssfm_Get_InvalidLINDemEvents(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_LINInfo) AS LIN_DEM_EVENTS-»
			«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_LINInfo AS LIN_INFO-»
			«IF Ssfm_Get_InvalidLINDemEvents_index(LIN_INFO, SERIAL_DATA) != -1 -»
		&(Sum_Ssfm_FxI_DemEvents[«Ssfm_Get_SizeofFxl_DemEvent(controllers, sSFM) + LIN_DEM_EVENTS.indexOf(LIN_INFO.sum_Ssfm_LINInfo_Event.sum_Ssfm_InvalidData_DemEvent_Ref)»]),
			«ENDIF-»
			«ENDFOREACH-»
			«ENDLET-»
			«ENDLET-»
		«ENDIF-»

	},
«ENDLET-»
«ENDFOREACH-»
};
«ENDLET-»
«ENDLET-»

