/* PRQA S 1532 EOF # The functions are invoked by runnables or other functions in external file */
/* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */

#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"


/**
 * @brief			SSFM function used to populate the FsI interface state based on the defined logic
 *
 * @param[in]       serialData      - Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[inout]	void
 * @param[out]		void
 * @return			void
 */
/* PRQA S 1532 11 # The function belongs to Safety Status Manager yet used in ReceivedSerialData Handler. */
FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_SafetyStatus_Manager_Populate_FsI(Sum_Ssfm_SerialData* serialData)
{
   	/*[$Satisfies $DDS_SSFM 028]*/
   	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

   	// Check if SerialData is Safety
	/*[$Satisfies $DDS_SSFM 189]*/
    if((serialData->Safety != NULL_PTR) && (dtcs_are_disabled == FALSE))
    {
		// The FsI shall be set to TRUE if there is an error on Continuous Operation (FoI) and/or Protection (FpI).
		// Therefore, FsI is populated with the boolean OR of the FoI and FpI.
		// If any of the FpI or FoI are not present, they cannot report any error and they will be ignored in the calculation of the FsI.

    	boolean safety_status = FALSE;
		if(serialData->Protected != NULL_PTR){
			safety_status = serialData->Protected->FxI;
		}
		if(serialData->ContOp != NULL_PTR){
			safety_status = safety_status || serialData->ContOp->FxI;
		}
		// Sets the FsI value
		serialData->Safety->FxI = safety_status;
«IF sSFM.sum_Ssfm_General.Ssfm_IsSinglePortSupportEnabled() == false-»
		// Sets the FsI port
		serialData->Safety->FP_Rte_Write_PP_FxI_LocalSWC(serialData->Safety->FxI);
«ENDIF-»
    	/*[$Satisfies $DDS_SSFM 084] */
		if (serialData->Safety->DebouncerRef != NULL_PTR){
			Sum_Ssfm_FxI_Debouncing_Handler(serialData, serialData->Safety);
		}
	}
}

#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
«ENDIF-»
/* EOF */
«ENDFILE»
«ENDDEFINE»