#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"


/**
 * @brief			SSFM function used to populate the single port FxI interface state
 *
 * @param[in]       serialData      - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[inout]	void
 * @param[out]		void
 * @return			void
 */
FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_SingleFxI_Manager_Set_FxI(const Sum_Ssfm_SerialData* serialData)
{
   	/*[$Satisfies $DDS_SSFM 078]*/
   	// Check if SerialData FxI source is valid
	switch(serialData->FxI_Source){
		case SUM_SSFM_FxI_Source_FcI:
			serialData->Authenticated->FP_Rte_Write_PP_FxI_LocalSWC(serialData->Authenticated->FxI);
			break;
		case SUM_SSFM_FxI_Source_FoI:
			serialData->ContOp->FP_Rte_Write_PP_FxI_LocalSWC(serialData->ContOp->FxI);
			break;
		case SUM_SSFM_FxI_Source_FpI:
			serialData->Protected->FP_Rte_Write_PP_FxI_LocalSWC(serialData->Protected->FxI);
			break;
		case SUM_SSFM_FxI_Source_FsI:
			serialData->Safety->FP_Rte_Write_PP_FxI_LocalSWC(serialData->Safety->FxI);
			break;
		/* PRQA S 2016 5 # The default should do nothing */
		default:
			break;
	}
}

#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
