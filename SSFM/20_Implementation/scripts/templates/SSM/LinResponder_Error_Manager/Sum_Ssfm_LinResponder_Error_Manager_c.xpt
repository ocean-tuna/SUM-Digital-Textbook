«FOREACH Ssfm_Get_LNMError_LinSlaveInfo(sSFM.sum_Ssfm_ConfigSet, "SSFM_LNM_RESPONDER_IEF") AS SlaveInfoError ITERATOR i-»
/**
 * @brief           SSFM/SSM runnable function to be called upon any change in the status Internal Electronic Fault of «SlaveInfoError.sum_Ssfm_LINInfo_Ref.sum_Ssfm_LNM_ResponderInfo_Ref.parent.shortName»_«SlaveInfoError.sum_Ssfm_LINInfo_Ref.sum_Ssfm_LNM_ResponderInfo_Ref.shortName»
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
FUNC (void, SUM_SSFM_CODE) Runnable_SSFM_LNM_«SlaveInfoError.sum_Ssfm_LINInfo_Ref.sum_Ssfm_LNM_ResponderInfo_Ref.parent.shortName»_«SlaveInfoError.sum_Ssfm_LINInfo_Ref.sum_Ssfm_LNM_ResponderInfo_Ref.shortName»_IntElectFault_Changed(void)
{
	/* [$Satisfies $DDS_SSFM 135] */
	uint8 operating_range;
	Std_ReturnType ret_val;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 189]*/
	if (Sum_Ssfm_LINSlaveInfo[«Ssfm_Get_LNMError_LinResponder_index(SlaveInfoError, "SSFM_LNM_RESPONDER_IEF")»].Rte_Read_SUSD_SSFM_BatteryVoltage_IeF != NULL_PTR)
	{
		ret_val = Sum_Ssfm_LINSlaveInfo[«Ssfm_Get_LNMError_LinResponder_index(SlaveInfoError, "SSFM_LNM_RESPONDER_IEF")»].Rte_Read_SUSD_SSFM_BatteryVoltage_IeF(&operating_range);
		if ((ret_val == RTE_E_OK) && (dtcs_are_disabled == FALSE))
		{
			«IF dem.demGeneral.demOBDSupport == "DEM_OBD_NO_OBD_SUPPORT"-»
			if(operating_range == IN_Range)
			«ELSE-»
			if(operating_range != OUT_OF_RANGE_LOW)
			«ENDIF-»
			{
				Sum_Ssfm_IeF_LINResponder_Manager(&Sum_Ssfm_LINSlaveInfo[«Ssfm_Get_LNMError_LinResponder_index(SlaveInfoError, "SSFM_LNM_RESPONDER_IEF")»], &Sum_Ssfm_Ief_LNMError_Debouncers[«i.counter0-»]);
			}
		}
		else
		{
			/* do nothing */
		}
	}

}
«ENDFOREACH-»

/**
 * @brief           SSFM/SSM function to manage the internal logic and perform debounce for Internal Electronic Fault for the LIN Responder
 *
 * @param[in]       Sum_Ssfm_LNM_SlaveInfoError      - const Sum_Ssfm_LNM_SlaveInfoError*: Sum_Ssfm_LNM_SlaveInfoError structure to access the LNM_SlaveInfoError
 * @param[in]       debouncer_instance               - Sum_Ssfm_Debouncer*: Sum_Ssfm_Debouncer structure to access the type of the debouncer owner
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_IeF_LINResponder_Manager(const Sum_Ssfm_LNM_SlaveInfoError* slaveInfoError, Sum_Ssfm_Debouncer*  err_debouncer)
{
	/* [$Satisfies $DDS_SSFM 133] */
	Sum_Ssfm_EvaluationStatus debouncer_status;
	Dem_EventStatusType event_status;
	uint8 linslave_IefFA;

    if (slaveInfoError->Rte_Read_LNM_SSFM_IntElectFault != NULL_PTR )
    {
    	/* Check if DTC is set for internal electronic failure fault active */
		(void) slaveInfoError->Rte_Read_LNM_SSFM_IntElectFault(&linslave_IefFA);
		/* Execute Debouncer with linslave_IefFA: SIGNAL_VALID: 0u, SIGNAL_INVALID 1u */
		debouncer_status = Sum_Ssfm_ErrhDebouncerExecution(err_debouncer, (linslave_IefFA == 1u) ? SUM_SSFM_EventSts_Failed : SUM_SSFM_EventSts_Passed);

		/* Check if debouncer status is still in debouncing or not */
		if ((debouncer_status != SUM_SSFM_EvaluationSts_InDebouncing) && (debouncer_status != SUM_SSFM_EvaluationSts_Unknown))
		{
			/* Convert the event status result after performing debouncing */
			event_status = ((debouncer_status) == SUM_SSFM_EvaluationSts_Passed) ? DEM_EVENT_STATUS_PASSED : DEM_EVENT_STATUS_FAILED;
			/* Set the event status from Dem_SetEventStatus */
			(void) err_debouncer->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(event_status);
		}
		else
		{
			/* do nothing */
		}
    }
}

