 /**
 * @brief           SSFM getter of calibration parameter for Missing Message Calibratable Time
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          uint32 - Rte_CData_SUM_SSFM_Sum_Ssfm_C_MissingMsg_CalibratableTime
 */
static uint32 Sum_Ssfm_Get_CalibPar_MissingMsg_CalibratableTime(void)
{
	return (Rte_CData_Sum_Ssfm_C_MissingMsg_CalibratableTime() * 1000u);
}

/**
 * @brief           SSFM function to check the vehicle is within the first 5 seconds of a power-up reset, a running reset, a recovery from an under voltage condition or a recovery from an over voltage.
 *
 * @param[in]       err_debouncer      - Sum_Ssfm_Debouncer*: Sum_Ssfm_Debouncer structure to access debouncer
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 3206 1 # The function will be updated in the future */
static void Sum_Ssfm_Check_MissingMsg_TestEnableCondition(Sum_Ssfm_Debouncer*  err_debouncer)
{
	/* [$Satisfies $DDS_SSFM 181] */
	boolean battery_voltage_flag;
	boolean reset_recovery_flag;

	battery_voltage_flag = Sum_Ssfm_Errh_GetBatteryVoltageRecoveryTimerFlag();
	reset_recovery_flag = Sum_Ssfm_Errh_GetResetPowerUpRecoveryTimerFlag();

	/* Checks for battery voltage status and recovery timer for overvoltage/undervoltage */
	if((battery_voltage_flag == TRUE) && (reset_recovery_flag == TRUE))
	{
		Sum_Ssfm_LinResponder_MissingMessage_Debouncer(err_debouncer);
	}
	else
	{
		/* do nothing */
	}

}

/**
 * @brief           SSFM function to monitor the debouncer of the LIN Responder missing message error
 *
 * @param[in]       Sum_Ssfm_Debouncer *
 * @param[inout]    void
 * @param[out]      void
 * @return          Sum_Ssfm_EvaluationStatus
 */
static void Sum_Ssfm_LinResponder_MissingMessage_Debouncer(Sum_Ssfm_Debouncer*  err_debouncer)
{
	/* [$Satisfies $DDS_SSFM 182] */
	(void) err_debouncer->DebouncerOwner.LINRespInfo->Rte_Read_LNM_SSFM_NodeStatusId(&err_debouncer->DebouncerOwner.LINRespInfo->error_status);
	/* The SUM_SSFM_EventSts_Passed is just a place holder for LINInfo debouncer. The actual state will be realized internally. */
	(void) Sum_Ssfm_ErrhDebouncerExecution(err_debouncer, SUM_SSFM_EventSts_Passed);
}

/**
 * @brief           SSFM function to handling the state of the LIN Responder missing message error
 *
 * @param[in]       Sum_Ssfm_Debouncer *
 * @param[inout]    void
 * @param[out]      void
 * @return          Sum_Ssfm_EvaluationStatus
 */
Sum_Ssfm_EvaluationStatus Sum_Ssfm_LinResponder_MissingMsg_Handler(Sum_Ssfm_Debouncer* const deb_event)
{
	/* [$Satisfies $DDS_SSFM 182] */
	Sum_Ssfm_EvaluationStatus ret_val = SUM_SSFM_EvaluationSts_InDebouncing;

	switch (deb_event->DebouncerOwner.LINRespInfo->LinRespState)
	{
		case SUM_SSFM_EcuNodeState_Normal:
			ret_val = Sum_Ssfm_Process_MissingMsg_Normal(deb_event);
			break;
		/* Check if timer has expired and missing message has occurred */
		case SUM_SSFM_EcuNodeState_LostComm:
			ret_val = Sum_Ssfm_Process_MissingMsg_LossComm(deb_event);
			break;
		default:
			/* Do nothing */
			break;
	}
	return ret_val;
}

/**
 * @brief           SSFM function to process normal state of the LIN Responder missing message error
 *
 * @param[in]       Sum_Ssfm_Debouncer *
 * @param[inout]    void
 * @param[out]      void
 * @return          Sum_Ssfm_EvaluationStatus
 */
static Sum_Ssfm_EvaluationStatus Sum_Ssfm_Process_MissingMsg_Normal(Sum_Ssfm_Debouncer* const deb_event)
{
	/* [$Satisfies $DDS_SSFM 182] */
	Sum_Ssfm_EvaluationStatus ret_val;
	if (deb_event->DebouncerOwner.LINRespInfo->error_status == ERROR_EVENT_ACTIVE)
	{
		/* Start timer when missing message occurs */
		deb_event->DebouncerOwner.LINRespInfo->TimerElapsed = 0u;
		deb_event->DebouncerOwner.LINRespInfo->LinRespState = SUM_SSFM_EcuNodeState_LostComm;
		ret_val = SUM_SSFM_EvaluationSts_InDebouncing;
	}
	else
	{
		ret_val = SUM_SSFM_EvaluationSts_Passed;
		/* Notify the Dem that no missing message has been observed */
		deb_event->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(DEM_EVENT_STATUS_PASSED);
	}
	return ret_val;
}

/**
 * @brief           SSFM function to process lostcom state of the LIN Responder missing message error
 *
 * @param[in]       Sum_Ssfm_Debouncer *
 * @param[inout]    void
 * @param[out]      void
 * @return          Sum_Ssfm_EvaluationStatus
 */
static Sum_Ssfm_EvaluationStatus Sum_Ssfm_Process_MissingMsg_LossComm(Sum_Ssfm_Debouncer* const deb_event)
{
	/* [$Satisfies $DDS_SSFM 182] */
	Sum_Ssfm_EvaluationStatus ret_val;
	if (deb_event->DebouncerOwner.LINRespInfo->error_status == ERROR_EVENT_ACTIVE)
	{
		/* Get evaluation status periodic checked by runnable*/
		ret_val = deb_event->LastEvalStatus;
	}
	else
	{
		/* Reset timer when missing message error is back to normal state */
		deb_event->DebouncerOwner.LINRespInfo->TimerElapsed = 0u;
		deb_event->DebouncerOwner.LINRespInfo->LinRespState = SUM_SSFM_EcuNodeState_Normal;
		ret_val = SUM_SSFM_EvaluationSts_Passed;
		/* Notify the Dem that no missing message has been observed */
		deb_event->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(DEM_EVENT_STATUS_PASSED);
	}
	return ret_val;
}

/**
 * @brief           SSFM function to execute when timeout callback from Com
 * @param[in]       uint16 - LINSlaveInfo index
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
void Sum_Ssfm_LINResponder_CbkRxTOut_Handler(uint16 LINSlaveInfo_idx)
{
	/* [$Satisfies $DDS_SSFM 182] */
   /* Indicate missing message with the LIN Responder to LNM, set interface NodeTimeout to LNM as DTC ACTIVE */
   (void) Sum_Ssfm_LINSlaveInfo[LINSlaveInfo_idx].Rte_Write_SSM_LNM_NodeTimeout(DTC_ACTIVE);
}

/**
 * @brief           SSFM function to be called upon the reception of new data for a given SerialData.
 * @param[in]       uint16 - LINSlaveInfo index
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
void Sum_Ssfm_LINResponder_CbkRxRec_Handler(uint16 LINSlaveInfo_idx)
{
	/* [$Satisfies $DDS_SSFM 182] */
	boolean recovery_flag = TRUE;
	uint8 linsignal_idx;
	for (linsignal_idx = 0u; linsignal_idx < Sum_Ssfm_LINSlaveInfo[LINSlaveInfo_idx].NoOfLINSignals; linsignal_idx++)
	{
		if (Sum_Ssfm_LINSlaveInfo[LINSlaveInfo_idx].pLINSignalInfo[linsignal_idx]->SigSts_Supervision != SUM_SSFM_SigSts_Supervision_Received)
		{
			/* if any of lin signal status supervision is not received, set the recovery flag to FALSE */
			recovery_flag = FALSE;
			break;
		}
		else
		{
			/* do nothing */
		}
	}
	if (recovery_flag == TRUE)
	{
		/* When all lin signals status supervision of corresponding Lin Responder are received, set interface NodeTimeout to LNM as DTC INACTIVE */
		(void) Sum_Ssfm_LINSlaveInfo[LINSlaveInfo_idx].Rte_Write_SSM_LNM_NodeTimeout(DTC_INACTIVE);
	}
}


/**
 * @brief           SSFM runnable function to be called periodically to monitor for the test enable criteria flag to execute the Missing Message errror and perform the debouncing time.
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
FUNC (void, SUM_SSFM_CODE) Runnable_SSFM_Execution_LNMError_MissingMessage(void)
{
	/* [$Satisfies $DDS_SSFM 182] */
	/* Time in microseconds */
	uint16 deb_index;
	static boolean Sum_Ssfm_BatteryVoltageWithinTimer[SSFM_NUM_OF_MISSING_MSG_LNMERROR];
	static uint32 time_in_range[SSFM_NUM_OF_MISSING_MSG_LNMERROR];
	static uint32 NodeStatusTimer[SSFM_NUM_OF_MISSING_MSG_LNMERROR];
	for (deb_index = 0u; deb_index < SSFM_NUM_OF_MISSING_MSG_LNMERROR; deb_index++)
	{
		if (Sum_Ssfm_LNMError_MissingMsg_TestEnableFlag[deb_index] == TRUE)
		{
			if (Sum_Ssfm_BatteryVoltageWithinTimer[deb_index] == TRUE)
			{
				/* Increment the time spent in the calibratable range */
				time_in_range[deb_index] += SSFM_RUNNABLE_MISSING_MSG_PERIODICITY_MS;
			}
			else
			{
				/* If transitioning into range, reset the timer */
				Sum_Ssfm_BatteryVoltageWithinTimer[deb_index] = TRUE;
				time_in_range[deb_index] = 0u;
			}
			/* Check if the time in range exceeds the calibratable time */
			if (time_in_range[deb_index] >= Sum_Ssfm_Get_CalibPar_MissingMsg_CalibratableTime())
			{
				Sum_Ssfm_Check_MissingMsg_TestEnableCondition(&Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index]);
				/* Reset for the next period check */
				time_in_range[deb_index] = 0u;
				/* Reset or keep accumulating based on requirement */
				Sum_Ssfm_BatteryVoltageWithinTimer[deb_index]  = FALSE;
				Sum_Ssfm_LNMError_MissingMsg_TestEnableFlag[deb_index] = FALSE;
			}
		}
		/* Monitoring the debouncing time via NodeStatusTimer from LNM */
		if (Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].LastEvalStatus == SUM_SSFM_EvaluationSts_InDebouncing)
		{
			(void) Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].DebouncerOwner.LINRespInfo->Rte_Read_LNM_SSFM_NodeStatusTimer(&NodeStatusTimer[deb_index]);
			/* Check if timer has expired */
			if(Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].DebouncerOwner.LINRespInfo->TimerElapsed >= NodeStatusTimer[deb_index])
			{
				Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].DebouncerOwner.LINRespInfo->TimerElapsed = 0u;
				Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].LastEvalStatus = SUM_SSFM_EvaluationSts_Failed;
				/* Notify the Dem that a LossOfCommunication event has been observed */
				Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(DEM_EVENT_STATUS_FAILED);
			}
			else
			{
				Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].DebouncerOwner.LINRespInfo->TimerElapsed += SSFM_RUNNABLE_MISSING_MSG_PERIODICITY_MS;
				Sum_Ssfm_MissingMsg_LNMError_Debouncers[deb_index].LastEvalStatus = SUM_SSFM_EvaluationSts_InDebouncing;
			}
		}
	}
}
«ENDIF-»
