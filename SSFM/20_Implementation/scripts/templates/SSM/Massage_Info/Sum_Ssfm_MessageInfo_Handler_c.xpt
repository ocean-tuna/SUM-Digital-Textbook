/**
 * @brief           SSFM/SSM function to disable PDU in transmission via checking calibration parameter
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_SsmDisablePdu_Tx(void)
{
	/*[$Satisfies $DDS_SSFM 024]*/
«IF sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_C_SsmDisable_Tx_PDU.size > 0-»
	uint8 i;
	boolean state;

	/* Disable PDUs which are set to TRUE in calibration and publish the parameter to SUM_SSC and SUM_PNC*/
	for (i = 0u; i < SSFM_SSM_NO_OF_DISABLEPDUS; i++)
	{
		state = Sum_Ssfm_SsmDisablePDU[i].FP_SSFM_pCdata_Type();
		if (state == TRUE)
		{
			/* Invoke BswM to disable PDUs */
			(void) Sum_Ssfm_SsmDisablePDU[i].FP_Rte_Switch_SSFM_BswM_DisablePdu(RTE_MODE_MDG_DisablePdu_PDU_DISABLE_REQ);
		}

		/* The parameter C_DisablePdu is published to SUMs */
		(void) Sum_Ssfm_SsmDisablePDU[i].FP_Rte_Write_SSFM_C_DisablePdu(state);
	}
«ELSE» /* there is no Disable PDU instances created */
«ENDIF-»
}

/**
 * @brief           SSFM/SSM function to check:
 						whether there is at least one partial network active for a specific serial data if it is ocm-based
						whether the service is active for a specific serial data if it is service-based
 *                  This function also updates per-PN timers (AvailableSince) when reading PN status.
 *
 * @param[in]       serialData - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[inout]    void
 * @param[out]      void
 * @return          PN_status - boolean: TRUE: The service or at least one PN  active - FALSE: There is no PN active
 */
boolean Sum_Ssfm_Is_ServiceOrAtLeastOnePNActive(const Sum_Ssfm_SerialData* serialData)
{
	/*[$Satisfies $DDS_SSFM 031]*/
	/* Variable used to store the return value of the Rte_Read */
	Std_ReturnType ReadRet;
	uint32 i;
	boolean status = FALSE;
	boolean ReadVal = FALSE;

	if(serialData->ServiceInfo == NULL_PTR){
		if((serialData->MsgInfoGrp == NULL_PTR) || (serialData->MsgInfoGrp->No_Of_PNs == 0u) || (serialData->MsgInfoGrp->pSigRxStatus == NULL_PTR))
		{
			/* LIN/non-PN serial data: no PN gating applies */
			status = TRUE;
		}
		else
		{
			for (i = 0u; i < serialData->MsgInfoGrp->No_Of_PNs; i++)
			{
				ReadRet = serialData->MsgInfoGrp->pSigRxStatus[i](&ReadVal);
				/* If the Rte_Read was successful */
				if(RTE_E_OK == ReadRet)
				{
					/* SIDE EFFECT: Update per-PN timer based on current state */
					Sum_Ssfm_PnInformation* pn = serialData->MsgInfoGrp->PN_Info_ptr[i];
					if(TRUE == ReadVal)
					{
						/* PN is active - set timestamp if not already set */
						if(pn->AvailableSince == 0u)
						{
							(void)GetCounterValue(SSFM_1ms_Counter, &pn->AvailableSince);
						}
						status = TRUE;
					}
					else
					{
						/* PN is inactive - reset timestamp */
						pn->AvailableSince = 0u;
					}
				}
			}
		}
	}
	else{
		status = serialData->ServiceInfo->IsActive;
	}
	return status;
}

/**
 * @brief           SSFM/SSM helper function to check if service/AP has been active for >= 5 seconds
 *
 * @param[in]       serialData - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure
 * @param[in]       current_time_ms - uint32: Current time in milliseconds
 * @param[inout]    void
 * @param[out]      void
 * @return          boolean: TRUE if service active >= 5000ms, FALSE otherwise
 */
static boolean Sum_Ssfm_Service_StabilityCheck(const Sum_Ssfm_SerialData* serialData, uint32 current_time_ms)
{
    uint32 elapsed_ms;
    boolean status = FALSE;
    
    if ((serialData->ServiceInfo != NULL_PTR) &&
        (serialData->ServiceInfo->IsActive == TRUE) &&
        (serialData->ServiceInfo->AvailableSince != 0u))
    {
        elapsed_ms = current_time_ms - serialData->ServiceInfo->AvailableSince;
        if (elapsed_ms >= 5000u)
        {
            status = TRUE;  /* Service active >= 5s */
        }
    }
    
    return status;
}

/**
 * @brief           SSFM/SSM helper function to check if at least one PN has been active for >= 5 seconds
 *
 * @param[in]       serialData - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure
 * @param[in]       current_time_ms - uint32: Current time in milliseconds
 * @param[inout]    void
 * @param[out]      void
 * @return          boolean: TRUE if at least one PN active >= 5000ms, FALSE otherwise
 */
static boolean Sum_Ssfm_PN_StabilityCheck(const Sum_Ssfm_SerialData* serialData, uint32 current_time_ms)
{
    uint32 i;
    boolean ReadVal;
    Std_ReturnType ret;
    boolean status = FALSE;
    
    /* OCM-based: Check PNs for stability */
    if (serialData->MsgInfoGrp != NULL_PTR)
    {
        if (serialData->MsgInfoGrp->pSigRxStatus != NULL_PTR)
        {
            /* Loop through all mapped PNs and check for stable activity */
            for (i = 0u; i < serialData->MsgInfoGrp->No_Of_PNs; i++)
            {
                ret = serialData->MsgInfoGrp->pSigRxStatus[i](&ReadVal);
                if ((ret == RTE_E_OK) && (ReadVal == TRUE))
                {
                    /* PN is active - check if it has been stable for >= 5 seconds */
                    const Sum_Ssfm_PnInformation* pn = serialData->MsgInfoGrp->PN_Info_ptr[i];
                    if ((pn->AvailableSince != 0u) &&
                        ((current_time_ms - pn->AvailableSince) >= 5000u))
                    {
                        status = TRUE;
                        break;
                    }
                }
            }
        }
        else if (serialData->ServiceInfo == NULL_PTR)
        {
            /* No AP, PN mappings configured for this signal.
             * Therefore, it is always considered stable and ready for DTC testing */
            status = TRUE;
        }
        else
        {
            /* ServiceInfo exists, so this is not an OCM-only signal.
             * PN checks should not override service-based checks; status remains FALSE */
        }
    }
    else
    {
        /* MsgInfoGrp is NULL; status remains FALSE */
    }
    
    return status;
}

/**
 * @brief           SSFM/SSM function to check if at least one PN/AP has been active for >= 5 seconds (stability check for test enable criteria)
 *
 * @param[in]       serialData - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[inout]    void
 * @param[out]      void
 * @return          boolean: TRUE if at least one PN/AP has been active >= 5000ms, FALSE otherwise
 */
boolean Sum_Ssfm_Is_ServiceOrAtLeastOnePNActive_StabilityCheck(const Sum_Ssfm_SerialData* serialData)
{
    /*[$Satisfies $DDS_SSFM 048]*/
    uint32 current_time_ms;
    boolean status = FALSE;
    
    /* Get current time */
    (void)GetCounterValue(SSFM_1ms_Counter, &current_time_ms);

    /* Check service-based (AP) first - if stable, return TRUE */
    if (Sum_Ssfm_Service_StabilityCheck(serialData, current_time_ms))
    {
        status = TRUE;
    }
    /* Check PNs - only if no ServiceInfo exists (PN-based signals) */
    else if (Sum_Ssfm_PN_StabilityCheck(serialData, current_time_ms))
    {
        status = TRUE;
    }
    else
    {
        /* Neither AP nor PN is stable; status remains FALSE */
    }
    
    return status;
}


/**
 * @brief           SSFM/SSM function to check the notification about the status of diagnostics enabling or disabling of normal communication per channel
 *
 * @param[in]       serialData      - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[inout]    void
 * @param[out]      void
 * @return          status - SUM_DiagNormalCom_ModeType: TRUE: Normal Communications Mode Disabled - FALSE: Normal Communications Mode Enabled
 */
boolean Sum_Ssfm_Is_DisableNormalComm(const Sum_Ssfm_SerialData* serialData)
{
	/*[$Satisfies $DDS_SSFM 032]*/
	/* Variable used to store the return value of the Rte_Read */
	Std_ReturnType ReadRet;
	uint8 ReadVal = 0u;
	boolean status = FALSE;
	if(serialData->MsgInfoGrp->FP_Rte_Read_RP_DisableNormalComm_Status != NULL_PTR)
	{
		/* Get the status of diagnostics enabling or disabling of normal communication */
		ReadRet = serialData->MsgInfoGrp->FP_Rte_Read_RP_DisableNormalComm_Status(&ReadVal);
		/* If the Rte_Read was successful */
		if(RTE_E_OK == ReadRet)
		{
			status = (ReadVal == 1u) ? TRUE : FALSE;
		}
	}
	return status;
}

/**
 * @brief           SSFM/SSM function to check whether PDU in reception is disabled via checking calibration parameter
 *
 * @param[in]       serialData - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[inout]    void
 * @param[out]      void
 * @return          status - boolean: TRUE: Rx PDU disabled - FALSE: Rx PDU enabled
 */
boolean Sum_Ssfm_Is_DisablePdu_Rx(const Sum_Ssfm_SerialData* serialData)
{
	/*[$Satisfies $DDS_SSFM 033]*/
	boolean status = FALSE;
	if(serialData->MsgInfoGrp->FP_SSFM_pCdata_Type != NULL_PTR)
	{
		/* Get status of the Disable Rx PDUs calibration parameter */
		status = serialData->MsgInfoGrp->FP_SSFM_pCdata_Type();
	}
	return status;
}

/**
 * @brief           SSFM/SSM function to check whether the SecOC verification status is failed
 *
 * @param[in]       serialData - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[inout]    void
 * @param[out]      void
 * @return          status - boolean: TRUE: verification failed - FALSE: verification successed
 */
boolean Sum_Ssfm_Is_SecOC_VerificationSts_Failure(const Sum_Ssfm_SerialData* serialData)
{
	/*[$Satisfies $DDS_SSFM 034]*/
	boolean status = FALSE;
	«IF Ssfm_IsAnyAuthenticated(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData)-»
	if(serialData->Authenticated != NULL_PTR)
	{
		/* Get the FcI variable equal to the security status */
		status = serialData->Authenticated->FxI;
	}
	«ELSE-»
	(void)serialData;
	«ENDIF-»
	return status;
}
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SSFM_SERIAL_DATA ITERATOR i»
/**
 * @brief           SSFM/SSM Com callback timeout function Sum_Ssfm_COMCbkTOut_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()-»
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
/* PRQA S 1503 1 #  This callback is called by the BsW through the RTE */
FUNC (void, RTE_CODE) Sum_Ssfm_COMCbkTOut_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()-»(void)
{
	/*[$Satisfies $DDS_SSFM 035]*/
«IF !Ssfm_IsLINChannelCfg(SSFM_SERIAL_DATA)-»
	Sum_Ssfm_SerialDatas[«i.counter0»].MsgInfoGrp->SigSts_Supervision = SUM_SSFM_SigSts_Supervision_Timeout;
	Sum_Ssfm_SigStsAvailability_Manager_CANETH(&Sum_Ssfm_SerialDatas[«i.counter0»]);

	«IF Ssfm_IsSerialDataLcFA(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_GroupInfo.sum_Ssfm_ECUInfo, SSFM_SERIAL_DATA)-»
		«IF SSFM_SERIAL_DATA.Ssfm_IsServiceBased()-»
		«IF Ssfm_AnyTrgDvc(sSFM.sum_Ssfm_ConfigSet) == true-»
	/*[$Satisfies $DDS_SSFM 105]*/
	if(Sum_Ssfm_SerialDatas[«i.counter0»].ServiceInfo->DTCAllowed){
		if(Sum_Ssfm_SerialDatas[«i.counter0»].ServiceInfo->IsResolved == FALSE){
			Sum_Ssfm_ResolveServiceDemEvent(&Sum_Ssfm_SerialDatas[«i.counter0»]);
		«IF Sum_Ssfm_Errh_U19A6_87_IsValid(sSFM.sum_Ssfm_ConfigSet)-»
			/*[$Satisfies $DDS_SSFM 166]*/
			// Update U19A6_87 by checking all the services. In case of no IP found (ip==0), the ResolveServiceDemEvent function updates the U19A6_87 itself.
			if(Sum_Ssfm_SerialDatas[«i.counter0»].ServiceInfo->IpAddress != 0u){
				Sum_Ssfm_U19A6_87_Update(FALSE);
			}
	«ENDIF-»
		}
		// Check if the corresponding ECU has been found
		if (Sum_Ssfm_SerialDatas[«i.counter0»].LostCommInfo->CurrentProvider != NULL_PTR) {
			if (Sum_Ssfm_Node_MissingMsg_TestEnableConditions(&Sum_Ssfm_SerialDatas[«i.counter0»])){
				Sum_Ssfm_NodeSts_Manager_UpdateSerialDataLostComm(&Sum_Ssfm_SerialDatas[«i.counter0»]);
			}
		}
	}
		«ENDIF-»
		«ELSE-»
	/*[$Satisfies $DDS_SSFM 044]*/
	if(Sum_Ssfm_Node_MissingMsg_TestEnableConditions(&Sum_Ssfm_SerialDatas[«i.counter0»])){
		Sum_Ssfm_NodeSts_Manager_UpdateSerialDataLostComm(&Sum_Ssfm_SerialDatas[«i.counter0»]);
	}
		«ENDIF-»
	«ENDIF-»
«ELSE-»
	Sum_Ssfm_SerialDatas[«i.counter0»].LINInfo->SigSts_Supervision = SUM_SSFM_SigSts_Supervision_Timeout;
	Sum_Ssfm_SigStsAvailability_Manager_LIN(&Sum_Ssfm_SerialDatas[«i.counter0»]);
    /* Indicate lost communication with the LIN slave to LNM */
«IF sum_Ssfm_CheckSerialDataAssociatedMissingMsgCfg(SSFM_SERIAL_DATA)-»
    Sum_Ssfm_LINResponder_CbkRxTOut_Handler(«Ssfm_Get_SerialDataAssociatedLINInfo(SSFM_SERIAL_DATA)»);
«ENDIF-»
«ENDIF-»
}
«ENDFOREACH-»

«LET sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SERIAL_DATAS-»
«FOREACH SERIAL_DATAS.sum_Ssfm_Partial_Network_Ref.comMPncId.toSet() AS PN_Id-»
/**
 * @brief           SSFM/SSM runnable function to be called upon any change in the status of PN «PN_Id»
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
FUNC(void, SUM_SSFM_CODE) Runnable_SSFM_PnDtcAllowedStatusChanged_«PN_Id»(void)
{
	/*[$Satisfies $DDS_SSFM 158]*/
	/* update the DTC_Allowed_Flag for partial network of ID «PN_Id» */
	(void) Rte_Read_SUM_SSFM_RP_SUM_PNC_SSFM_PnDtcAllowed_«PN_Id»_DTC_Allowed(
				&(Sum_Ssfm_PNs_DTCAllowed_Status[«SERIAL_DATAS.sum_Ssfm_Partial_Network_Ref.comMPncId.toSet().toList().sortBy(pn | pn).indexOf(PN_Id)»].PN_DTC_Allowed_Flag)
				);
	/* for every serial data participating in partial network «PN_Id», update its PN_DTC_Enabled_Flag */
	«FOREACH SERIAL_DATAS.select(serialData | Ssfm_IsSerialDataAssociatedWithPN(serialData, PN_Id)) AS RELATED_SIGNAL-»
	Sum_Ssfm_prv_UpdatePnDtcEnabledFlag(&Sum_Ssfm_SerialDatas[«SERIAL_DATAS.indexOf(RELATED_SIGNAL)»]);
	«ENDFOREACH-»
}
«ENDFOREACH-»
«ENDLET-»

«IF sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.sum_Ssfm_Partial_Network_Ref.toSet().size > 0-»
/**
 * @brief           SSFM/SSM function to perform the update of the PN_DTC_Enabled flag of serial data participating at partial networks
 					whose DTC allowance status has just changed (via notification from PNC)
 *
 * @param[in]       void
 * @param[inout]    serialData - const Sum_Ssfm_SerialData*: Sum_Ssfm_SerialData structure to access the SerialData info and RTE functions
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_prv_UpdatePnDtcEnabledFlag(const Sum_Ssfm_SerialData *serial_data)
{
	/*[$Satisfies $DDS_SSFM 159]*/
	boolean DTC_is_settable = FALSE;
	SUM_PNC_DTC_AllowedType current_PN_DTC_Allowed_Flag;
	Sum_Ssfm_MessageInfoGroup *MessageInfoGroupPtr;
	uint8 i;

	/* Retrieve MessageInfoGroup pointer for this serial data */
	MessageInfoGroupPtr = serial_data->MsgInfoGrp;

	/* Loop through the PNs'PN_DTC_Allowed_Flag of the participated partial networks for this serial data */
	for(i=0; i < MessageInfoGroupPtr->No_Of_PNs; i++)
	{
		/* Read the PN_DTC_Allowed_Flag for the i-th participated partial network */
		current_PN_DTC_Allowed_Flag = MessageInfoGroupPtr->PN_Info_ptr[i]->PN_DTC_Allowed_Flag;

		/* Apply the SDV-8002 logic */
		if ((current_PN_DTC_Allowed_Flag == DTC_Allowed) ||
			((current_PN_DTC_Allowed_Flag == DTC_Might_Be_Allowed) && (MessageInfoGroupPtr->PN_DTC_Enabled_Flag == SUM_SSFM_Pn_Dtc_Enabled)))
		{
			DTC_is_settable = TRUE;
			break;
		}
	}

	/* Update the PN_DTC_Enabled_Flag for this serial data */
	MessageInfoGroupPtr->PN_DTC_Enabled_Flag = (DTC_is_settable == TRUE) ? SUM_SSFM_Pn_Dtc_Enabled : SUM_SSFM_Pn_Dtc_Not_Enabled;
}
«ENDIF-»

#define SUM_SSFM_STOP_SEC_CODE
