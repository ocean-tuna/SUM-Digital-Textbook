#ifndef SUM_SSFM_MESSAGE_INFO_HANDLER_H
#define SUM_SSFM_MESSAGE_INFO_HANDLER_H

/**
 * @brief This macro indicates number of Disabled PDUs configured for calibration
 */
#define SSFM_SSM_NO_OF_DISABLEPDUS «sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_C_SsmDisable_Tx_PDU.size»u

#define SSFM_SSM_NUM_OF_MESSAGE_INFO_GRP «sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData.select(e|Ssfm_IsMessageInfo(e)).size »u

«IF sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_C_SsmDisable_Tx_PDU.size > 0»
extern CONST(Sum_Ssfm_SsmPBCalibData, RTE_CODE) Sum_Ssfm_SsmDisablePDU[«sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_C_SsmDisable_Tx_PDU.size»];
«ENDIF-»
«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SSFM_SERIAL_DATA»
«IF Ssfm_IsPNCfg(SSFM_SERIAL_DATA) -»
extern CONST (FP_Rte_Read_RP_PNC_RxStatus_Sig, RTE_CODE) Sum_Ssfm_PNC_RxStatus_«Ssfm_GetComSerialDataName(SSFM_SERIAL_DATA)-»[];
«ENDIF-»
«ENDFOREACH-»

extern Sum_Ssfm_MessageInfoGroup Sum_Ssfm_MessageInfoGroups[SSFM_SSM_NUM_OF_MESSAGE_INFO_GRP];
/**************************************************************************************************************************
 * FUNCTION DECLARATION
 **************************************************************************************************************************
 */
extern FUNC(void, SUM_SSFM_SSM_CODE) Sum_Ssfm_SsmDisablePdu_Tx(void);

«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData AS SSFM_SERIAL_DATA-»
extern FUNC (void, RTE_CODE) Sum_Ssfm_COMCbkTOut_«SSFM_SERIAL_DATA.Ssfm_GetSerialDataName()»(void);
«ENDFOREACH-»

extern boolean Sum_Ssfm_Is_ServiceOrAtLeastOnePNActive(const Sum_Ssfm_SerialData* serialData);

extern boolean Sum_Ssfm_Is_ServiceOrAtLeastOnePNActive_StabilityCheck(const Sum_Ssfm_SerialData* serialData);

extern boolean Sum_Ssfm_Is_DisableNormalComm(const Sum_Ssfm_SerialData* serialData);

extern boolean Sum_Ssfm_Is_DisablePdu_Rx(const Sum_Ssfm_SerialData* serialData);

extern boolean Sum_Ssfm_Is_SecOC_VerificationSts_Failure(const Sum_Ssfm_SerialData* serialData);
