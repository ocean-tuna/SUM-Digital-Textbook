///////////////////////////// SSFM Counter //////////////////////
String Ssfm_GetSsfm1msCounterName(Sum_Ssfm_General cfg):
	cfg.sum_Ssfm_Os_Counter_1ms_Ref.shortName
;

Boolean sum_Ssfm_DtcTriggerMessageSupport_IsTRUE(Sum_Ssfm_General cfg):
	cfg.sum_Ssfm_DtcTriggerMessageSupport == true
;

Integer Ssfm_Get_SizeofFxl_DemEvent(List[Object] controllers, SSFM cfg):
	Ssfm_Get_AllComBasedSerialData_InvalidDataDemEvents(controllers, cfg.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData).size
	+ Ssfm_Get_AllServiceBasedSerialDatas_InvalidDataDemEvents(cfg).size
;
///////////////////////////// General E2E ///////////////////////////////
// Returns True if the SerialData is configured to use the E2EXf transformer
Boolean Ssfm_IsE2EConfigured(Sum_Ssfm_SerialData serialData):
	let e2exf = serialData.eRootContainer.xfrm.select(e | e.shortName.toLowerCase() == "e2exf"):
		if e2exf != null then (
			if serialData.Ssfm_IsSignalGroup() then (
				e2exf.xfrmImplementationMapping.xfrmSignal
				.xfrmSignalChoice.select(e | e.xfrmISignalGroupRefChoice != null)
				.xfrmISignalGroupRefChoice.xfrmISignalGroupRef
				.exists(e | e == serialData.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalGroupRefChoice.rteISignalGroupRef)
			)
			else (
				e2exf.xfrmImplementationMapping.xfrmSignal
				.xfrmSignalChoice.select(e | e.xfrmISignalRefChoice != null)
				.xfrmISignalRefChoice.xfrmISignalRef
				.exists(e | e == serialData.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalRefChoice.rteISignalRef)
			)
		)
		else
			false
;

// Returns True if there is at least one SerialData with E2E reference available
Boolean Ssfm_AnyE2EConfigured(List[Sum_Ssfm_SerialData] cfg):
	cfg.exists(e | Ssfm_IsE2EConfigured(e) == true)
;

Integer Ssfm_GetIndexOfOneE2EConfigured(List[Sum_Ssfm_SerialData] cfg):
	if (Ssfm_AnyE2EConfigured(cfg) == true) then
	(
		0.upTo(cfg.size-1).select(e|Ssfm_IsE2EConfigured(cfg.get(e))==true).get(0)
	)
	else
		-1
;

Boolean Ssfm_IsE2EProfileGM01(Sum_Ssfm_SerialData serialData):
	if (Ssfm_IsE2EConfigured(serialData) == true) then
	(
		let e2exf = serialData.eRootContainer.xfrm.select(e | e.shortName.toLowerCase() == "e2exf"):
			if serialData.Ssfm_IsSignalGroup() then (
				e2exf.xfrmImplementationMapping
				.select(e |
					e.xfrmSignal
					.xfrmSignalChoice
					.xfrmISignalGroupRefChoice != null)
				.select(e |
					e.xfrmSignal
					.xfrmSignalChoice
					.xfrmISignalGroupRefChoice
					.xfrmISignalGroupRef
					==
					serialData
					.sum_Ssfm_RteSerialData_Ref
					.rteSignal.rteSignalChoice.rteISignalGroupRefChoice.rteISignalGroupRef
				)
				.first()
				.rba_SysElem_XfrmTransformationTechnologyRef.shortName.endsWith("PROFILE_GM_01")
			)
			else (
				e2exf.xfrmImplementationMapping
				.select(e |
					e.xfrmSignal
					.xfrmSignalChoice
					.xfrmISignalRefChoice != null)
				.select(e |
					e.xfrmSignal
					.xfrmSignalChoice
					.xfrmISignalRefChoice
					.xfrmISignalRef
					==
					serialData
					.sum_Ssfm_RteSerialData_Ref
					.rteSignal.rteSignalChoice.rteISignalRefChoice.rteISignalRef
				)
				.first()
				.rba_SysElem_XfrmTransformationTechnologyRef.shortName.endsWith("PROFILE_GM_01")
			)
	)
	else
		false
;

///////////////////////////////////// SomeIpXf ///////////////////////////////////
// Returns True if the SerialData is configured to use the SomeIpXf transformer
Boolean Ssfm_IsSomeIpConfigured(Sum_Ssfm_SerialData serialData):
	let someipxf = serialData.eRootContainer.xfrm.select(e | e.shortName.toLowerCase() == "someipxf"):
		if someipxf != null then (
			if serialData.Ssfm_IsSignalGroup() then (
				someipxf.xfrmImplementationMapping.xfrmSignal
				.xfrmSignalChoice.select(e | e.xfrmISignalGroupRefChoice != null)
				.xfrmISignalGroupRefChoice.xfrmISignalGroupRef
				.exists(e | e == serialData.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalGroupRefChoice.rteISignalGroupRef)
			)
			else (
				someipxf.xfrmImplementationMapping.xfrmSignal
				.xfrmSignalChoice.select(e | e.xfrmISignalRefChoice != null)
				.xfrmISignalRefChoice.xfrmISignalRef
				.exists(e | e == serialData.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalRefChoice.rteISignalRef)
			)
		)
		else
			false
;

// Returns True if there is at least one SerialData which is configured to use the SomeIpXf transformer
Boolean Ssfm_AnySomeIpConfigured(List[Sum_Ssfm_SerialData] cfg):
	cfg.exists(e | Ssfm_IsSomeIpConfigured(e) == true)
;

// Returns True if the serial data requires any sort of transformer in the chain (Com, E2E, SomeIp)
Boolean Ssfm_IsTransformerErrorNeeded(Sum_Ssfm_SerialData serial_data):
	if serial_data.Ssfm_IsSignalGroup() then (
		serial_data.eRootContainer.xfrm.xfrmImplementationMapping.xfrmSignal
		.xfrmSignalChoice.select(e | e.xfrmISignalGroupRefChoice != null)
		.xfrmISignalGroupRefChoice.xfrmISignalGroupRef
		.exists(e | e == serial_data.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalGroupRefChoice.rteISignalGroupRef)
	)
	else (
		serial_data.eRootContainer.xfrm.xfrmImplementationMapping.xfrmSignal
		.xfrmSignalChoice.select(e | e.xfrmISignalRefChoice != null)
		.xfrmISignalRefChoice.xfrmISignalRef
		.exists(e | e == serial_data.sum_Ssfm_RteSerialData_Ref.rteSignal.rteSignalChoice.rteISignalRefChoice.rteISignalRef)
	)
;
///////////////////////////// Authentication (FcI) ///////////////////////////////

// Returns True if the SerialData is authenticated
Boolean Ssfm_IsAuthenticated(Sum_Ssfm_SerialData serialData):
	serialData.sum_Ssfm_SecOCRxPdu_Ref != null
;

// Returns True if the SerialData is authenticated
Boolean Ssfm_IsAnyAuthenticated(List[Sum_Ssfm_SerialData] cfg):
	cfg.select(e|e.sum_Ssfm_SecOCRxPdu_Ref != null).size > 0
;

Integer Ssfm_GetIndexOfOneAuthenticated(List[Sum_Ssfm_SerialData] cfg):
	if (Ssfm_IsAnyAuthenticated(cfg) == true) then
	(
		0.upTo(cfg.size-1).select(e|Ssfm_IsAuthenticated(cfg.get(e))==true).get(0)
	)
	else
		-1
;

///////////////////////////// Continuous Operation (FoI) ///////////////////////////////

// Returns true if the SerialData is continuous-operation-enabled
// The logic is:
// The SerialData is continuous operation enabled if it is E2E configured regardless of the E2E profile
Boolean Ssfm_IsContOp(Sum_Ssfm_SerialData serialData):
	Ssfm_IsE2EConfigured(serialData) ? true : false
;

// Returns true if there is at least one SerialData for which FoI is neeeded
Boolean Ssfm_IsAnyContOp(List[Sum_Ssfm_SerialData] cfg):
	cfg.select(e | Ssfm_IsContOp(e) == true).size > 0 ? true : false
;

Integer Ssfm_GetIndexOfOneContOp(List[Sum_Ssfm_SerialData] cfg):
	if (Ssfm_IsAnyContOp(cfg) == true) then
	(
		0.upTo(cfg.size-1).select(e|Ssfm_IsContOp(cfg.get(e))==true).get(0)
	)
	else
		-1
;

///////////////////////////// Protection (FpI) ///////////////////////////////

// Returns true if the SerialData is protected
// The logic is:
// The SerialData is protection enabled if the E2E is configured (except for profile GM_01) or it is an authenticated SerialData
Boolean Ssfm_IsProtected(Sum_Ssfm_SerialData serialData):
	(
		(Ssfm_IsE2EConfigured(serialData) && !Ssfm_IsE2EProfileGM01(serialData))
	 	|| Ssfm_IsAuthenticated(serialData)
	)
	? true : false
;

// Returns true if there is at least one SerialData for which FoI is neeeded
Boolean Ssfm_IsAnyProtected(List[Sum_Ssfm_SerialData] cfg):
	cfg.select(e | Ssfm_IsProtected(e) == true).size > 0 ? true : false
;

Integer Ssfm_GetIndexOfOneProtected(List[Sum_Ssfm_SerialData] cfg):
	if (Ssfm_IsAnyProtected(cfg) == true) then
	(
		0.upTo(cfg.size-1).select(e|Ssfm_IsProtected(cfg.get(e))==true).get(0)
	)
	else
		-1
;

///////////////////////////// Safety (FsI) ///////////////////////////////

// Returns true if the SerialData requires a safety status notification
// The logic is:
// The SerialData is safety status enabled if the FpI and/or the FoI is required
Boolean Ssfm_IsSafety(Sum_Ssfm_SerialData serialData):
	(Ssfm_IsContOp(serialData) || Ssfm_IsProtected(serialData))
	? true : false
;

// Returns true if there is at least one SerialData for which FsI is neeeded
Boolean Ssfm_IsAnySafety(List[Sum_Ssfm_SerialData] cfg):
	cfg.select(e | Ssfm_IsSafety(e) == true).size > 0 ? true : false
;

Integer Ssfm_GetIndexOfOneSafety(List[Sum_Ssfm_SerialData] cfg):
	if (Ssfm_IsAnySafety(cfg) == true) then
	(
		0.upTo(cfg.size-1).select(e|Ssfm_IsSafety(cfg.get(e))==true).get(0)
	)
	else
		-1
;

Integer Ssfm_GetIndexOfOneSafetyWithProtectedAndContOp(List[Sum_Ssfm_SerialData] cfg):
	if (Ssfm_IsAnySafety(cfg) == true) then
	(
		0.upTo(cfg.size-1).select(e| (Ssfm_IsSafety(cfg.get(e)) && Ssfm_IsContOp(cfg.get(e)) && Ssfm_IsProtected(cfg.get(e))) ==true).get(0)
	)
	else
		-1
;

/* It combines the four Ssfm_IsAnyAuthenticated/ContOp/Protected/Safety into one function.
 * i.e. Ssfm_IsAnyACPS(serial_datas, "ContOp") checks if there is any ContOp Serial Data.
 */
Boolean Ssfm_IsAnyACPS(List[Sum_Ssfm_SerialData] serialDatas, String ACPS):
	switch(ACPS)
	{
		case "Authenticated" : Ssfm_IsAnyAuthenticated(serialDatas)
		case "ContOp" : Ssfm_IsAnyContOp(serialDatas)
		case "Protected" : Ssfm_IsAnyProtected(serialDatas)
		case "Safety" : Ssfm_IsAnySafety(serialDatas)
		default : false
	}
;

///////////////////////////// Message Info Handler ///////////////////////////////

List[ComIPdu] Ssfm_SignalRxPDU(List[Sum_Ssfm_SerialData] serialData) :
    let listofRxPDU1 = serialData.sum_Ssfm_C_SsmDisable_Rx_PDURef.shortName:
    	listofRxPDU1.toSet()
;

// Returns True if the SerialData participated in Partial Network
Boolean Ssfm_IsPNCfg(Sum_Ssfm_SerialData serialData):
	serialData.sum_Ssfm_Partial_Network_Ref != null
;

// Returns True if the SerialData channel monitor disable normal communication request
Boolean Ssfm_IsChannelInfo(Sum_Ssfm_SerialData serialData):
	serialData.sum_Ssfm_Channel_Ref != null && serialData.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref != null
;

// Returns True if the SerialData disable Rx PDU is configured
Boolean Ssfm_IsDisableRxPDU(Sum_Ssfm_SerialData serialData):
	serialData.sum_Ssfm_C_SsmDisable_Rx_PDURef != null
;

// Returns True if the any message info condition is configured
Boolean Ssfm_IsMessageInfo(Sum_Ssfm_SerialData serialData):
	(Ssfm_IsPNCfg(serialData) || Ssfm_IsChannelInfo(serialData) || Ssfm_IsDisableRxPDU(serialData))
	&& !Ssfm_IsLINChannelCfg(serialData)
;

/* When the message is not from LIN, this function returns the message ID of the serial data.
   For CAN serial data the message ID is derived from CAN ID and for ETH serial data it is derived from PDU Header ID.
 */
Integer Ssfm_GetMessageID(Sum_Ssfm_SerialData serialData):
	if serialData.Ssfm_IsLINChannelCfg() then (
		0
	)
	else if (serialData.sum_Ssfm_MessageID_Ref != null) then (
		if (serialData.sum_Ssfm_MessageID_Ref.metaType.toString().endsWith("CanIfRxPduCfg")) then (
			serialData.sum_Ssfm_MessageID_Ref.canIfRxPduCanId
		) else (
			serialData.sum_Ssfm_MessageID_Ref.soAdRxPduHeaderId
		)
	)
	else (
		0
	)
;

// Returns size of PN configured
Integer Ssfm_GetPNsizeSerialData(Sum_Ssfm_SerialData serialData):
	serialData.sum_Ssfm_Partial_Network_Ref.size
;

// Returns SerialData name
String Ssfm_GetComSerialDataName(Sum_Ssfm_SerialData serialData):
	serialData.Ssfm_GetSerialDataName()
;


// Returns True if the given SerialData is associated with the given PN id
Boolean Ssfm_IsSerialDataAssociatedWithPN(Sum_Ssfm_SerialData serialData, Integer PNId):
	serialData.sum_Ssfm_Partial_Network_Ref.exists(PN | PN.comMPncId == PNId)
;

// Returns a list of com SerialData names that are associated with the given PN id
List[String] Ssfm_GetComSerialDataNamesGivenPNId(List[Sum_Ssfm_SerialData] serialDatas, Integer PNId):
	serialDatas.select(serialData | Ssfm_IsSerialDataAssociatedWithPN(serialData, PNId))
	.Ssfm_GetSerialDataName().toList()
;

// Returns a set of PN Ids that are associated with the given SerialDatas
List[Integer] Ssfm_ListOfAllAssociatedPNsIdsToSerialDatas(List[Sum_Ssfm_SerialData] serialDatas):
    serialDatas.sum_Ssfm_Partial_Network_Ref.comMPncId
	.toSet()
;

// Returns True if the give lnm moduele is available and networks are configured
Boolean sum_Lnm_NetworkSupport_IsTRUE(LNM cfg):
	((cfg != null)&&((cfg.lNM_Networks != null)&&(cfg.lNM_Networks.lNMNetwork.size > 0 ))) ? true : false
;

// Returns True if the given SerialData is associated with the given channel id
Boolean Ssfm_IsSerialDataAssociatedWithChannel(Sum_Ssfm_SerialData serialData, Integer ChId):
	if (serialData.sum_Ssfm_Channel_Ref != null && serialData.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref != null) then
		serialData.sum_Ssfm_Channel_Ref.sum_Ssfm_Channel_ID_Ref.comMChannelId == ChId
	else
		false
;

// Returns a list of com SerialData names that are associated with the given channel id
List[String] Ssfm_GetComSerialDataNamesGivenChId(List[Sum_Ssfm_SerialData] serialDatas, Integer ChId):
	serialDatas.select(serialData | Ssfm_IsSerialDataAssociatedWithChannel(serialData, ChId))
	.Ssfm_GetSerialDataName().toList()
;

// Returns a set of CAN/ETH channel Ids that are associated with the given SerialDatas
List[Integer] Ssfm_GetAllCANETHChannelIDs(List[Sum_Ssfm_SerialData] serialDatas):
    serialDatas.select(e | e.sum_Ssfm_Channel_Ref != null)
    .sum_Ssfm_Channel_Ref.select(e | e.sum_Ssfm_Channel_ID_Ref != null && e.sum_Ssfm_Channel_ID_Ref.comMBusType != "COMM_BUS_TYPE_LIN")
    .sum_Ssfm_Channel_ID_Ref.comMChannelId.toSet()
;

