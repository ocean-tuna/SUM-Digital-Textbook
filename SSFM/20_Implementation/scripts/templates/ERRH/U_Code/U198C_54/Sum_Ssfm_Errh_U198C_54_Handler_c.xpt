}
static uint16 Sum_Ssfm_Get_CalibPar_«DEM_FILTER.shortName»_Y(void){
	return Rte_CData_«DEM_FILTER.shortName»_Y();
}

/* PRQA S 1504 1 # Based on the architecture design it is decided to keep the object in the corresponding component. */
static Sum_Ssfm_U198C_54ErrorType  Sum_Ssfm_U198C_54_ErrorInfo = {

	/* Function pointer to get flag for controlling whether to process DTC */
	&Sum_Ssfm_Errh_Get_C_DTC_U198C_54_MissSetup,
	/* Function pointer to Rte_Read function call */
