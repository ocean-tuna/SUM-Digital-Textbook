/* PRQA S 3469 EOF # The function like macros is used. This is necessary to get value via RTE variable */
static uint16 Sum_Ssfm_Get_CalibPar_«DEM_FILTER.shortName»_X(void){
	return Rte_CData_«DEM_FILTER.shortName»_X();
}
static uint16 Sum_Ssfm_Get_CalibPar_«DEM_FILTER.shortName»_Y(void){
	return Rte_CData_«DEM_FILTER.shortName»_Y();
}

