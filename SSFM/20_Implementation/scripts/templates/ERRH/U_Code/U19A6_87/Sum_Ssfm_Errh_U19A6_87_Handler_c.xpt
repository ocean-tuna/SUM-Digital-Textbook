«IF Sum_Ssfm_Errh_U19A6_87_IsValid(sSFM.sum_Ssfm_ConfigSet)-»

/**
 * @brief           SSFM function to be called upon any change in the status of DTC_U19A6_87
 *
 * @param[in]       boolean direct_failure: Setting this to true, indicates that the test is known as failed and
 *											the DTC shall be set right after checking the test enable criteria.
 * 											Having direct_failure==false will cause the check of conditions for pass or fail status.
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */

void Sum_Ssfm_U19A6_87_Update(boolean direct_failure){
	/*[$Satisfies $DDS_SSFM 166]*/
	OperatingRangeType operating_range;
	SrvcMgr_SSFM_LearningTableStatusType l_SSFM_LearningTableStatus_st;
	boolean dtc_U19A6_87_status = FALSE;
	uint16 i;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 167]*/
	if(direct_failure){
		dtc_U19A6_87_status = TRUE;
	} else {
		for (i = 0u; i < SSFM_SSM_NUM_OF_SERIALDATAS; i++){
			if(Sum_Ssfm_SerialDatas[i].ServiceInfo != NULL_PTR){
				if(Sum_Ssfm_SerialDatas[i].ServiceInfo->IpAddress == 0u){
					dtc_U19A6_87_status = TRUE;
					break;
				}
			}
		}
	}

	/*[$Satisfies $DDS_SSFM 168]*/ /*[$Satisfies $DDS_SSFM 189]*/
	if((Sum_Ssfm_Errh_Get_C_DTC_U19A6_87_MissingMessage() == TRUE) && (dtcs_are_disabled == FALSE)){
		/*[$Satisfies $DDS_SSFM 169]*/
		(void)Rte_Read_RP_SUSD_SSFM_Errh_BatteryVoltage_BatteryVoltageRangeMinToMax_OperatingRange(&operating_range);
		if(operating_range
			«IF dem.demGeneral.demOBDSupport == "DEM_OBD_NO_OBD_SUPPORT"-»== IN_Range«ELSE-»!= OUT_OF_RANGE_LOW«ENDIF-»
		){
			/*[$Satisfies $DDS_SSFM 170]*/
			(void)Rte_Read_RP_SrvcMgr_SSFM_LearningTableStatus_LearningTableStatus(&l_SSFM_LearningTableStatus_st);
			if((l_SSFM_LearningTableStatus_st.RID_0654_Status == SUM_RID_0654_STATUS_COMPLETE) || (l_SSFM_LearningTableStatus_st.RID_0654_Status == SUM_RID_0654_STATUS_INCOMPLETE)){
				/*[$Satisfies $DDS_SSFM 171]*/
				(void)Rte_Call_RP_Dem_SSFM_DTC_U19A6_87_SetEventStatus((dtc_U19A6_87_status == TRUE) ? DEM_EVENT_STATUS_FAILED : DEM_EVENT_STATUS_PASSED);
			}
		}
	}
}


/**
 * @brief           Runnable to handle Learning Table Status changes
 *
 * @param[in]       -
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
FUNC(void, SUM_SSFM_CODE) Runnable_SSFM_LearningTableStatus(void)
{
	/*[$Satisfies $DDS_SSFM 364]*/
    /* Trigger U19A6_87 evaluation when Learning Table Status changes */
    Sum_Ssfm_U19A6_87_Update(FALSE);
}
