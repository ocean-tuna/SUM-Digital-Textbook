«IF Sum_Ssfm_Errh_U19A3_57_PreCondition_IsValid(sSFM.sum_Ssfm_ConfigSet) -»
/* PRQA S 1503 10 # When the SSFM is integrated, this runnable will be called by the RTE*/
/**
 * @brief           SSFM/SSM runnable function to be called upon any change in the status of SSC_DTC_U19A3_57
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
void Runnable_SSFM_SSC_DTC_U19A3_57_Status_Changed(void){
	/*[$Satisfies $DDS_SSFM 057]*/
	OperatingRangeType operating_range;
	boolean dtc_U19A3_57_Status;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 058]*/ /*[$Satisfies $DDS_SSFM 189]*/
	/* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
	if((Sum_Ssfm_Errh_Get_C_DTC_ControlModule_InvalidIncompatibleConfiguration() == TRUE) && (dtcs_are_disabled == FALSE)){
		/*[$Satisfies $DDS_SSFM 059]*/
		(void)Rte_Read_RP_SUSD_SSFM_Errh_BatteryVoltage_BatteryVoltageRangeMinToMax_OperatingRange(&operating_range);

		«IF dem.demGeneral.demOBDSupport == "DEM_OBD_NO_OBD_SUPPORT"-»
		if(operating_range == IN_Range){
		«ELSE-»
		if(operating_range != OUT_OF_RANGE_LOW){
		«ENDIF-»
			/*[$Satisfies $DDS_SSFM 060]*/
			(void)Rte_Read_RP_SSC_SSFM_ERRH_DTC_U19A3_57_Status_DTC_U19A3_57_Status(&dtc_U19A3_57_Status);
			if(dtc_U19A3_57_Status == TRUE){
				(void)Rte_Call_RP_SSFM_DTC_U19A3_57_InvalidConfiguration_SetEventStatus(DEM_EVENT_STATUS_FAILED);
			}
			else{
				(void)Rte_Call_RP_SSFM_DTC_U19A3_57_InvalidConfiguration_SetEventStatus(DEM_EVENT_STATUS_PASSED);
			}
		}
	}
}
«ENDIF-»

#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
