};

/* PRQA S 1514 1 # Based on the architecture design it is decided to keep the object in the corresponding component. */
Sum_Ssfm_Debouncer Sum_Ssfm_U19A6_57Error_Debouncer[SSFM_NUM_OF_U19A6_57_ERROR] = {
	{
		/* Error filter type */
		SUM_SSFM_ErrorFilter_«Ssfm_GetFilterType(DEM_FILTER)-»,
		/* Number of configured X threshold */
		«IF Ssfm_IsFilterTypeNone(DEM_FILTER)-»
		NULL_PTR,
		«ELSE-»
		&Sum_Ssfm_Get_CalibPar_«DEM_FILTER.shortName»_X,
		«ENDIF-»
		/* Number of configured Y threshold */
		«IF Ssfm_IsFilterTypeNone(DEM_FILTER)-»
		NULL_PTR,
		«ELSE-»
		&Sum_Ssfm_Get_CalibPar_«DEM_FILTER.shortName»_Y,
		«ENDIF-»
		/* Callback function */
		«IF Ssfm_IsTimeBasedFilterType(DEM_FILTER)-»
		&Sum_Ssfm_Errh_FP_U19A6_57_CbkWindowMoving,
		«ELSE-»
		NULL_PTR,
		«ENDIF-»
		/* Counter failed event */
		0u,
		/* Number of sample or ms*/
		0u,
		/* First failed flag */
		FALSE,
		/* Last Evaluation Status */
		SUM_SSFM_EvaluationSts_Unknown,
		/* Reference to input DTC */
		{.U19A6_57Info = &Sum_Ssfm_U19A6_57_ErrorInfo},/* PRQA S 1053 # To use the union type. */
		/* Owner Type*/
		SUM_SSFM_DebouncerRefType_PhyECU_InvIncComp,
		/* Reference to DemEvent */
		/*[$Satisfies $DDS_SSFM 197]*/
		&Sum_Ssfm_U19A6_57Error_DemEvents,
	},

};

/**
 * @brief           SSFM/SSM runnable function to be called upon any change in the status of DTC_U19A6_57
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE*/
void Runnable_SSFM_SrvcMgr_DTC_U19A6_57_Status_Changed(void)
{

	boolean dtc_U19A6_57_status;
	boolean battery_flag;
	Dem_EventStatusType event_status;
	Sum_Ssfm_EvaluationStatus debouncer_status;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 195]*/ 
	/* check processing of DTC enable */
	if ((Sum_Ssfm_U19A6_57_ErrorInfo.FP_SSFM_pCdata_DTCProcess() == TRUE) && (dtcs_are_disabled == FALSE))
	{

		/*[$Satisfies $DDS_SSFM 196]*/
		battery_flag = Sum_Ssfm_Errh_GetBatteryVoltageRecoveryTimerFlag();

		if(battery_flag)
		{
			/* Check if DTC is set for Service Discovery Failure (Physical ECU Invalid/Incompatible SW Component) */
			Sum_Ssfm_U19A6_57Error_Debouncer[0u].DebouncerOwner.U19A6_57Info->Rte_Read_SSFM_DiagnosticStatus(&dtc_U19A6_57_status);
			/*[$Satisfies $DDS_SSFM 198]*/	
			/* Execute Debouncer for failure */
			debouncer_status = Sum_Ssfm_ErrhDebouncerExecution(&Sum_Ssfm_U19A6_57Error_Debouncer[0u],(Sum_Ssfm_EventStatus)
							((dtc_U19A6_57_status == TRUE) ? SUM_SSFM_EventSts_Failed : SUM_SSFM_EventSts_Passed));
	
			/* Check if debouncer status is still in debouncing or not */
			if((debouncer_status != SUM_SSFM_EvaluationSts_InDebouncing) && (debouncer_status != SUM_SSFM_EvaluationSts_Unknown))
			{
				/*[$Satisfies $DDS_SSFM 199]*/
				/* Convert the event status result after performing debouncing */
				event_status = ((debouncer_status) == SUM_SSFM_EvaluationSts_Passed) ? DEM_EVENT_STATUS_PASSED : DEM_EVENT_STATUS_FAILED;
				/* Set the event status from Dem_SetEventStatus */
				Sum_Ssfm_U19A6_57Error_Debouncer[0u].DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(event_status);
			}
			else
			{
				/* do nothing */
			}
		}
	}
}
«IF Ssfm_IsTimeBasedFilterType(DEM_FILTER)-»
/**
 * @brief           callback function of debouncing Moving Window X of Y
 * @details         To Pointer callback function of debouncing Moving Window X of Y
 *
 * @param[in]       Sum_Ssfm_Debouncer
 * @return          void
 */
/* PRQA S 3673 5 # The pointer is not pointing to const to be aligned with the other callbacks used for debouncing callback */
/* PRQA S 3219 5 # Callback is not used if filter type is event */
/*[$Satisfies $DDS_SSFM 197]*/
static void Sum_Ssfm_Errh_FP_U19A6_57_CbkWindowMoving(Sum_Ssfm_Debouncer* debouncer_instance)
{
	/*set as event passed as call back is called after time elaspe condition*/
	debouncer_instance->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(DEM_EVENT_STATUS_PASSED);

}
«ENDIF-»
«ENDLET-»
