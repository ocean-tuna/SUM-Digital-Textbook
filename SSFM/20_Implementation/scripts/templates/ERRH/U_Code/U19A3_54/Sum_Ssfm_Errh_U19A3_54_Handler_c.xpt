 /* PRQA S 3214 EOF # The Macros are defined for security and memory mapping reason              */
/* PRQA S 1532 EOF # The functions are invoked by runnables or other functions in external file */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */
#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"

«IF Sum_Ssfm_Errh_U19A3_54_SecPer_MissSetup_IsValid(sSFM.sum_Ssfm_ConfigSet) -»
/**
 * @brief           SSFM/SSM runnable function to be called upon any change in the status of DTC_U19A3_54
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE*/
void Runnable_SSFM_SSC_DTC_U19A3_54_Status_Changed(void){
	/*[$Satisfies $DDS_SSFM 117]*/
	OperatingRangeType operating_range;
	boolean dtc_u19A3_54_Status;
	SSC_IVMASType Read_Ivmas;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 118]*/ /*[$Satisfies $DDS_SSFM 189]*/
	if((Sum_Ssfm_Errh_Get_C_DTC_SecurityPeripheral_MissingSetup() == TRUE) && (dtcs_are_disabled == FALSE)){

		/*[$Satisfies $DDS_SSFM 119]*/
		(void)Rte_Read_RP_SUSD_SSFM_Errh_BatteryVoltage_BatteryVoltageRangeMinToMax_OperatingRange(&operating_range);

		/*Read the IVMAS data from RPORT PP_SSC_SWC_IVMAS */
		(void)Rte_Read_RP_SSC_SWC_IVMAS_IVMAS_Status(&Read_Ivmas);

		/* Per SDV-6001/IDOC-887: U19A3_54 (SecurityPeripheral_MissingSetup) is a Key-Provisioning concern.
		 * It must fire only when KP is supported, i.e. IVMAS in {0x01, 0x03}. */
		«IF dem.demGeneral.demOBDSupport == "DEM_OBD_NO_OBD_SUPPORT"-»
		if((operating_range == IN_Range)&&
		   ((Read_Ivmas == SSC_IVMAS_KP_AND_AUTH_SUPPORTED) ||
		    (Read_Ivmas == SSC_IVMAS_KP_SUPPORTED_AND_AUTH_NOT_SUPPORTED))){
		«ELSE-»
		if((operating_range != OUT_OF_RANGE_LOW)&&
		   ((Read_Ivmas == SSC_IVMAS_KP_AND_AUTH_SUPPORTED) ||
		    (Read_Ivmas == SSC_IVMAS_KP_SUPPORTED_AND_AUTH_NOT_SUPPORTED))){
		«ENDIF-»

			/*[$Satisfies $DDS_SSFM 120]*/
			(void)Rte_Read_RP_SSC_SSFM_ERRH_DTC_U19A3_54_Status_status(&dtc_u19A3_54_Status);
			if(dtc_u19A3_54_Status == TRUE){
				(void)Rte_Call_RP_Dem_SSFM_DTC_U19A3_54_SetEventStatus(DEM_EVENT_STATUS_FAILED);
			}
			else{
				(void)Rte_Call_RP_Dem_SSFM_DTC_U19A3_54_SetEventStatus(DEM_EVENT_STATUS_PASSED);
			}
		}
	}
}
«ENDIF-»
#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
