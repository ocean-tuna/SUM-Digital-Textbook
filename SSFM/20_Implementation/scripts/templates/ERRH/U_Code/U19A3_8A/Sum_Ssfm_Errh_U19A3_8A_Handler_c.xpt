 */
FUNC (void, SUM_SSFM_CODE) Runnable_SSFM_SSC_KeySlotVerifyErrors_«ssc_keyslotverify.shortName»(void)
{
	/* [$Satisfies $DDS_SSFM 079] */ /*[$Satisfies $DDS_SSFM 189]*/
	boolean verificationPassed;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	if ((Sum_Ssfm_Errh_KeySlotVerifyFilter[«i.counter0»].Rte_Read_SSC_SSFM_E_KeySlotVerify(&verificationPassed) != RTE_E_NO_DATA) && (dtcs_are_disabled == FALSE))
	{
		/* Reset the slowest PDU rate timer each time receiving a frame from SSC */
		Sum_Ssfm_Errh_KeySlotVerifyFilter[«i.counter0»].last_received_pdu_timer = 0u;
		Sum_Ssfm_Errh_Process_KeySlotVerifyErrors(&Sum_Ssfm_Errh_KeySlotVerifyFilter[«i.counter0»], verificationPassed);
	}

}
«ENDFOREACH-»

/**
 * @brief           SSFM/ERRH function to advance last received PDU timer of KeySlotVerifyError
 *
 * @param[in]       void
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_LastReceivedPDU_Timer_Update(void)
{
	/* [$Satisfies $DDS_SSFM 092] */
	uint8 i;

	/* Per-keyslot last_received_pdu_timer update */
	for (i = 0u; i < SSFM_ERRH_NUM_OF_CFG_KEYSLOT_VERIFY_FILTER; i++)
	{
		/* We just check that we do not overflow */
		if (Sum_Ssfm_Errh_KeySlotVerifyFilter[i].last_received_pdu_timer <= (SUM_SSFM_PDU_TIMER_MAX - «(1000 * sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity).extractMantissaFrmFloatValue()»u))
		{
			Sum_Ssfm_Errh_KeySlotVerifyFilter[i].last_received_pdu_timer += «(1000 *  sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity).extractMantissaFrmFloatValue()»u;
		}
	}
}


