/**
 * @brief           SSFM/ERRH function to handle the start stop authentication timer of KeySlotVerifyError
 * @details         AuthenticationWindowTimer: Decrement when last received PDU < 3*k_ERRH_SlowestPDURate
 *                  FailedAuthenticationTimer (per-keyslot): Increment when #Err > 0 AND last received PDU < 3*k_ERRH_SlowestPDURate
 *                  FailedAuthenticationTimer: Cleared when #Err == 0
 *
 * @param[in]       void
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_StartStopAuthenticationTimer_Handler(void)
{
	/* [$Satisfies $DDS_SSFM 094] */
	uint8 i;
	uint32 SlowestPDU_Timer_ks;

	for (i = 0u; i < SSFM_ERRH_NUM_OF_CFG_KEYSLOT_VERIFY_FILTER; i++)
	{
		SlowestPDU_Timer_ks = 3u * 1000u * Sum_Ssfm_Errh_KeySlotVerifyFilter[i].k_ERRH_SlowestPDUTimer;

		if (Sum_Ssfm_Errh_KeySlotVerifyFilter[i].last_received_pdu_timer < SlowestPDU_Timer_ks)
		{
			/* AuthenticationWindowTimer decrement */
			if (Sum_Ssfm_Errh_KeySlotVerifyFilter[i].authentication_window_timer >= «(1000 * sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity).extractMantissaFrmFloatValue()»u)
			{
				Sum_Ssfm_Errh_KeySlotVerifyFilter[i].authentication_window_timer -= «(1000 * sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity).extractMantissaFrmFloatValue()»u;
			}
			else
			{
				Sum_Ssfm_Errh_KeySlotVerifyFilter[i].authentication_window_timer = 0u;
			}

			/* FailedAuthenticationTimer increment when #Err > 0 */
			if (Sum_Ssfm_Errh_KeySlotVerifyFilter[i].num_of_failure > 0u)
			{
				Sum_Ssfm_Errh_KeySlotVerifyFilter[i].failed_auth_timer += «(1000 * sSFM.sum_Ssfm_General.sum_Ssfm_KeySlotVerify_RunnablePeriodicity).extractMantissaFrmFloatValue()»u;
			}
			/* FailedAuthenticationTimer reset when #Err == 0 */
			else
			{
				Sum_Ssfm_Errh_KeySlotVerifyFilter[i].failed_auth_timer = 0u;
			}
		}
		else
		{
			/* Stop timers for this keyslot: last received PDU >= 3*k_ERRH_SlowestPDURate */
		}
	}
		/* Update KeySlotState after timer changes */
	for (i = 0u; i < SSFM_ERRH_NUM_OF_CFG_KEYSLOT_VERIFY_FILTER; i++)
	{
		Sum_Ssfm_Update_KeySlotState(&Sum_Ssfm_Errh_KeySlotVerifyFilter[i]);
	}
}

/**
 * @brief           SSFM/ERRH function to manage the passed/failed authentication timer of KeySlotVerifyError
 * @details         Test Fail: KeySlotState = $2 (Failed) AND FailedAuthenticationTimer > k_ERRH_FailedAuthenticationTimer
 *                  Test Pass: All KeySlotStates != $2 (Failed) AND at least one KeySlotState = $1 (Passed)
 *
 * @param[in]       void
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_Authentication_Timer_Manager(void)
{
	/* [$Satisfies $DDS_SSFM 093] */
	boolean has_keyslot_failed = FALSE;
	boolean has_keyslot_passed = FALSE;
	boolean has_keyslot_failed_with_timer = FALSE;
	uint8 i; 

	/* Check all keyslots per IDOC-1010 specification */
	for (i = 0u; i < SSFM_ERRH_NUM_OF_CFG_KEYSLOT_VERIFY_FILTER; i++)
	{
		/* Test Fail Criteria: KeySlotState = $2 (Failed) AND FailedAuthenticationTimer > k_ERRH_FailedAuthenticationTimer */
		if (Sum_Ssfm_Errh_KeySlotVerifyFilter[i].keyslot_status == 2u)
		{
			/* Check if any Failed state exists (for Pass criteria: All KeySlotStates != $2 Failed) */
			has_keyslot_failed = TRUE;

			/* Check if timer expired */
			if (Sum_Ssfm_Errh_KeySlotVerifyFilter[i].failed_auth_timer > Sum_Ssfm_Errh_KeySlotVerifyFilter[i].k_ERRH_FailedAuthenticationTimer)
			{
				has_keyslot_failed_with_timer = TRUE;
			}
		}

		/* Check for at least one Passed state (for Pass criteria: At least one KeySlotState = $1 Passed)*/
		if (Sum_Ssfm_Errh_KeySlotVerifyFilter[i].keyslot_status == 1u)
		{
			has_keyslot_passed = TRUE;
		}
	}

	/* Test Fail: KeySlotState = $2 Failing AND FailedAuthenticationTimer > k_ERRH_FailedAuthenticationTimer */
	if (has_keyslot_failed_with_timer == TRUE)
	{
		(void) Rte_Call_RP_Dem_SSFM_DiagnosticMonitor_SSC_E_KeySlotVerifyError_SetEventStatus(DEM_EVENT_STATUS_FAILED);
	}
	/* Test Pass: All KeySlotStates != $2 (Failed) AND at least one KeySlotState = $1 (Passed) */
	else if ((has_keyslot_failed == FALSE) && (has_keyslot_passed == TRUE))
	{
		(void) Rte_Call_RP_Dem_SSFM_DiagnosticMonitor_SSC_E_KeySlotVerifyError_SetEventStatus(DEM_EVENT_STATUS_PASSED);
	}
	else
	{
		/* Do nothing */
	}

	/* Execution of start/stop authentication timer handler */
	Sum_Ssfm_StartStopAuthenticationTimer_Handler();
}

/**
 * @brief			Runnable function for SUM SSFM KeySlotVerifyErrors to handle the time management
 *
 *
 * @param[in]		None
 * @param[inout]	None
 * @param[out]		None
 * @return			void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE*/
FUNC(void, SUM_SSFM_CODE) Runnable_SSFM_KeySlotVerifyErrors_Time_Management(void)
{
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 091]*/
	/* Execution of slowest PDU rate timer handler */
	Sum_Ssfm_LastReceivedPDU_Timer_Update();
	/* Execution of authentication timer handler */

	if(dtcs_are_disabled == FALSE)
	{
		Sum_Ssfm_Authentication_Timer_Manager();
	}

}

/**
 * @brief			Runnable function for SUM SSFM upon successful completion of key provisioning
 *
 * @param[in]		None
 * @param[inout]	None
 * @param[out]		None
 * @return			void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE*/
FUNC(void, SUM_SSFM_CODE) Runnable_SSC_SSFM_U19A3_8A_KeyProvisioned(void)
{
	uint8 keySlotId;

	/* Read keySlotId upon successful completion of key provisioning*/
	(void)Rte_Read_RP_SSC_SSFM_U19A3_8A_KeyProvisioned_KeySlotId(&keySlotId);

	if (keySlotId < SSFM_ERRH_NUM_OF_CFG_KEYSLOT_VERIFY_FILTER)
	{
		/* Set FailedAuthenticationTimer and KeySlot State are 0u */
		Sum_Ssfm_Errh_KeySlotVerifyFilter[keySlotId].failed_auth_timer = 0u;
		Sum_Ssfm_Errh_KeySlotVerifyFilter[keySlotId].keyslot_status = 0u;

		/* Set AuthenticationWindowTimer is k_ERRH_FailedAuthenticationTimer */
		/* k_ERRH_FailedAuthenticationTimer is initialized in Sum_Ssfm_Errh_Initialize_KeySlotVerify func*/
		Sum_Ssfm_Errh_KeySlotVerifyFilter[keySlotId].authentication_window_timer = Sum_Ssfm_Errh_KeySlotVerifyFilter[keySlotId].k_ERRH_FailedAuthenticationTimer;
	}
	else
	{
		/* Nothing */
	}
}
«ENDIF-»

