/**
 * @brief           SSFM/ERRH function to process KeySlotVerifyErrors
 *
 * @param[in]       keyslotfilter      - Sum_Ssfm_Errh_KeySlotVerifyStatus*: Sum_Ssfm_Errh_KeySlotVerifyStatus structure to access the KeySlotVerifyStatus member and RTE functions
 * @param[in]       SSC_data           - boolean: E_KeySlotVerify data from SSC
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_Errh_Process_KeySlotVerifyErrors(Sum_Ssfm_Errh_KeySlotVerifyStatus* keyslotfilter, boolean SSC_data)
{
	/* [$Satisfies $DDS_SSFM 099] */
	boolean battery_voltage_flag;
	boolean reset_recovery_flag;

	if(keyslotfilter != NULL_PTR)
	{
		if (Sum_Ssfm_Get_CalibPar_Errh_C_DTCProcess_KeySlotVerifyError() == TRUE)
		{
			battery_voltage_flag = Sum_Ssfm_Errh_GetBatteryVoltageRecoveryTimerFlag();
			reset_recovery_flag = Sum_Ssfm_Errh_GetResetPowerUpRecoveryTimerFlag();

			/* Checks for battery voltage status and recovery timer for overvoltage/undervoltage */
			/* Checks for at least one PN active is already covered from SSC side before sending the data - related to DDS_SSFM 159 */
			if((battery_voltage_flag == TRUE) && (reset_recovery_flag == TRUE))
			{
				/* If SECP is reporting an error mode, invalidate active KeySlotVerify errors */
				Sum_Ssfm_Errh_SecPError_Handler(keyslotfilter, SSC_data);
			}
			else
			{
				/* do nothing */
			}
		}
		else
		{
			/* do nothing */
		}
	}
}

/**
 * @brief           SSFM/ERRH function to initialize KeySlotVerify flag
 * @details         Called on init (operation cycle start).
 *
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
/* PRQA S 1532 1 # Here for modularity */
void Sum_Ssfm_Errh_Initialize_KeySlotVerify(void)
{
	uint8 i;

«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_KeySlotVerifyFilter.sum_Ssfm_Errh_KeySlotNumber AS ssc_keyslotverify ITERATOR i-»
	Sum_Ssfm_Errh_KeySlotVerifyFilter[«i.counter0»].k_ERRH_FailedAuthenticationTimer = 1000u * Sum_Ssfm_Get_CalibPar_Errh_C_FATimer_«ssc_keyslotverify.shortName»();
	Sum_Ssfm_Errh_KeySlotVerifyFilter[«i.counter0»].k_ERRH_SlowestPDUTimer = Sum_Ssfm_Get_CalibPar_Errh_C_SlowestPDU_RateTimer_«ssc_keyslotverify.shortName»();
«ENDFOREACH-»

	for (i = 0u; i < SSFM_ERRH_NUM_OF_CFG_KEYSLOT_VERIFY_FILTER; i++)
	{
		/* FailedAuthenticationTimer and KeySlot State are initialized to 0 */
		Sum_Ssfm_Errh_KeySlotVerifyFilter[i].failed_auth_timer = 0u;
		Sum_Ssfm_Errh_KeySlotVerifyFilter[i].keyslot_status = 0u;

		/* AuthenticationWindowTimer is initialized to k_ERRH_FailedAuthenticationTimer */
		Sum_Ssfm_Errh_KeySlotVerifyFilter[i].authentication_window_timer = Sum_Ssfm_Errh_KeySlotVerifyFilter[i].k_ERRH_FailedAuthenticationTimer;
	}
}

/**
 * @brief           EERH Function that clears all KeySlotVerify authentication and failure timers
 * @details         Called when clear DTC executed (service 0x14 triggered).
 *
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
/* PRQA S 1532 1 # Here for modularity */
void Sum_Ssfm_Clear_KeySlot_Authentication_Failure_Timers(void)
{
	uint8 i;

	for (i = 0u; i < SSFM_ERRH_NUM_OF_CFG_KEYSLOT_VERIFY_FILTER; i++)
	{
		/* Reset FailedAuthenticationTimer flag */
		Sum_Ssfm_Errh_KeySlotVerifyFilter[i].failed_auth_timer = 0u;	
		/* Reset AuthenticationWindowTimer flag*/
		Sum_Ssfm_Errh_KeySlotVerifyFilter[i].authentication_window_timer = Sum_Ssfm_Errh_KeySlotVerifyFilter[i].k_ERRH_FailedAuthenticationTimer;
	}
}

/**
 * @brief           Update KeySlot State based on timer values
 * @details         State determination:
 *                  $0 Indeterminate: AuthenticationWindowTimer > 0 AND FailedAuthenticationTimer = 0
 *                  $1 Passed: AuthenticationWindowTimer = 0 AND FailedAuthenticationTimer = 0
 *                  $2 Failed: FailedAuthenticationTimer > 0
 *                  $3 Unused: KeySlot not configured (preserved)
 *
 * @param[in]       keyslotfilter - Pointer to KeySlot structure
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
void Sum_Ssfm_Update_KeySlotState(Sum_Ssfm_Errh_KeySlotVerifyStatus* keyslotfilter)
{
	if(keyslotfilter != NULL_PTR)
	{
		/* Check if KeySlot is configured/active in SSFM (unused) */
		if (Sum_Ssfm_Get_CalibPar_Errh_C_DTCProcess_KeySlotVerifyError() == TRUE)
		{
			if (keyslotfilter->failed_auth_timer == 0u)
			{
				/* KeySlotState = $0 (Indeterminate) when AuthenticationWindowTimer > 0 AND FailedAuthenticationTimer = 0 */
				if (keyslotfilter->authentication_window_timer > 0u)
				{
					keyslotfilter->keyslot_status = 0u;
				}
				/* KeySlotState = $1 (Passed) when AuthenticationWindowTimer = 0 AND FailedAuthenticationTimer = 0 */
				else
				{
					keyslotfilter->keyslot_status = 1u;
				}
			}
			/* KeySlotState = $2 (Failed) when FailedAuthenticationTimer > 0 */
			else
			{
				keyslotfilter->keyslot_status = 2u;
			}
		}
		/* KeySlotState = $3 (Unused) when a key slot is calibrated off */
		else
		{
			keyslotfilter->keyslot_status = 3u;
		}
	}
}

/**
 * @brief           SSFM/ERRH function to handle SecPError
 *
 * @param[in]       keyslotfilter      - Sum_Ssfm_Errh_KeySlotVerifyStatus*: Sum_Ssfm_Errh_KeySlotVerifyStatus structure to access the KeySlotVerifyStatus member and RTE functions
 * @param[in]       SSC_data           - boolean: E_KeySlotVerify data from SSC
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_Errh_SecPError_Handler(Sum_Ssfm_Errh_KeySlotVerifyStatus* keyslotfilter, boolean SSC_data)
{
	/* [$Satisfies $DDS_SSFM 098] */
	Dem_EventStatusType ActiveEventStatus;

	uint16 Sum_Ssfm_Errh_SecPErrorStatusNextMode;
	uint16 Sum_Ssfm_Errh_SecPErrorStatusCurrentMode;
	(void)Rte_Mode_RP_BswM_SSFM_SecPError_SUM_ERC(&Sum_Ssfm_Errh_SecPErrorStatusCurrentMode, &Sum_Ssfm_Errh_SecPErrorStatusNextMode);
	if (Sum_Ssfm_Errh_SecPErrorStatusNextMode == RTE_MODE_SECP_Error_Status_SUM_ERC_NO_ERROR)
	{
		ActiveEventStatus = (SSC_data == TRUE) ? DEM_EVENT_STATUS_FAILED : DEM_EVENT_STATUS_PASSED;
		Sum_Ssfm_Errh_KeySlotVerifyErrors_Handler(keyslotfilter, ActiveEventStatus);
	}
	else
	{
		/* do nothing when SECP Error */
	}
}

/**
 * @brief           SSFM/ERRH function to handle KeySlotVerifyErrors
 * @details         Number of Failures: Increment only if failure detected (SecP check already done in caller)
 *                  Reset to 0 if no failure from SSC
 *
 * @param[in]       keyslotfilter      - Sum_Ssfm_Errh_KeySlotVerifyStatus*: Sum_Ssfm_Errh_KeySlotVerifyStatus structure to access the KeySlotVerifyStatus member and RTE functions
 * @param[in]       EventStatus        - Dem_EventStatusType: Event status (PASSED/FAILED)
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_Errh_KeySlotVerifyErrors_Handler(Sum_Ssfm_Errh_KeySlotVerifyStatus* keyslotfilter, Dem_EventStatusType EventStatus)
{
	/* [$Satisfies $DDS_SSFM 097] */
	/* Handle KeySlotVerify events */
	if (EventStatus == DEM_EVENT_STATUS_FAILED)
	{
		/* Increment Number of Failures with overflow protection */
		if (keyslotfilter->num_of_failure < 0xFFFFu)
		{
			keyslotfilter->num_of_failure++;
		}
	}
	else
	{
		/* Reset the number of failure of specific keyslot */
		keyslotfilter->num_of_failure = 0u;
	}
}

«FOREACH sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorFilter.sum_Ssfm_Errh_KeySlotVerifyFilter.sum_Ssfm_Errh_KeySlotNumber AS ssc_keyslotverify ITERATOR i-»
