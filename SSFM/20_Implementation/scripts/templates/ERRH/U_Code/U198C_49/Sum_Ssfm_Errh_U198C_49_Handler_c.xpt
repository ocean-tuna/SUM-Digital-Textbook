		/* Reference to DemEvent */
		&Sum_Ssfm_U198C_49Error_DemEvents,
	},

};
«ENDLET-»
/**
 * @brief           SSFM/SSM runnable function to be called upon any change in the status of DTC_U198C_49
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE*/
void Runnable_SSFM_SSC_DTC_U198C_49_KPKeysProvisioned(void)
{

	boolean dtc_U198C_49_status;
	boolean reset_flag;
	boolean battery_flag;
	Dem_EventStatusType event_status;
	Sum_Ssfm_EvaluationStatus debouncer_status;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 190]*/ 
	/* check processing of DTC enable */
	if ((Sum_Ssfm_U198C_49_ErrorInfo.FP_SSFM_pCdata_DTCProcess() == TRUE) && (dtcs_are_disabled == FALSE))
	{

		/*[$Satisfies $DDS_SSFM 191]*/
		reset_flag = Sum_Ssfm_Errh_GetResetPowerUpRecoveryTimerFlag();
		battery_flag = Sum_Ssfm_Errh_GetBatteryVoltageRecoveryTimerFlag();

		if(battery_flag && reset_flag)
		{
		
			/* Check if DTC is set for Primary security internal electronic failure fault active */
			Sum_Ssfm_U198C_49Error_Debouncer[0u].DebouncerOwner.U198C_49Info->Rte_Read_SSFM_DiagnosticStatus(&dtc_U198C_49_status);
			/*[$Satisfies $DDS_SSFM 192]*/	
			/* Execute Debouncer for failure */
			debouncer_status = Sum_Ssfm_ErrhDebouncerExecution(&Sum_Ssfm_U198C_49Error_Debouncer[0u],(Sum_Ssfm_EventStatus)
							((dtc_U198C_49_status == TRUE) ? SUM_SSFM_EventSts_Passed : SUM_SSFM_EventSts_Failed));
	
			/* Check if debouncer status is still in debouncing or not */
			if((debouncer_status != SUM_SSFM_EvaluationSts_InDebouncing) && (debouncer_status != SUM_SSFM_EvaluationSts_Unknown))
			{
				/*[$Satisfies $DDS_SSFM 193]*/
				/* Convert the event status result after performing debouncing */
				event_status = ((debouncer_status) == SUM_SSFM_EvaluationSts_Passed) ? DEM_EVENT_STATUS_PASSED : DEM_EVENT_STATUS_FAILED;
				/* Set the event status from Dem_SetEventStatus */
				Sum_Ssfm_U198C_49Error_Debouncer[0u].DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(event_status);
			}
			else
			{
				/* do nothing */
			}
		}
	}
}

/**
 * @brief           callback function of debouncing Moving Window X of Y
 * @details         To Pointer callback function of debouncing Moving Window X of Y
 *
 * @param[in]       Sum_Ssfm_Debouncer
 * @return          void
 */
/* PRQA S 3673 5 # The pointer is not pointing to const to be aligned with the other callbacks used for debouncing callback */
static void Sum_Ssfm_Errh_FP_U198C_49_CbkWindowMoving(Sum_Ssfm_Debouncer* debouncer_instance)
{
	/*set as event passed as call back is called after time elaspe condition*/
	debouncer_instance->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(DEM_EVENT_STATUS_PASSED);

}

