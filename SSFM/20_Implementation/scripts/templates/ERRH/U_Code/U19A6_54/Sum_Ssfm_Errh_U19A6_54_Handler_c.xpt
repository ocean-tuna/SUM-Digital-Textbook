/**
 * @brief           SSFM/SSM runnable function to be called upon any change in the status of DTC_U19A6_54
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE*/
void Runnable_SSFM_SrvcMgr_U19A6_54_Status_Changed(void){
	/*[$Satisfies $DDS_SSFM 160]*/
	OperatingRangeType operating_range;
	boolean dtc_u19A6_54_Status;
	uint8 mec;
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/*[$Satisfies $DDS_SSFM 161]*/ /*[$Satisfies $DDS_SSFM 189]*/
	if((Sum_Ssfm_Errh_Get_C_DTC_U19A6_54_MissingSetup() == TRUE) && (dtcs_are_disabled == FALSE)){
		/*[$Satisfies $DDS_SSFM 162]*/
		(void)Rte_Read_RP_SUSD_SSFM_Errh_BatteryVoltage_BatteryVoltageRangeMinToMax_OperatingRange(&operating_range);
		if(operating_range
			«IF dem.demGeneral.demOBDSupport == "DEM_OBD_NO_OBD_SUPPORT"-»== IN_Range«ELSE-»!= OUT_OF_RANGE_LOW«ENDIF-»
		){
			/*[$Satisfies $DDS_SSFM 163]*/
			(void)Rte_Read_RP_DIAG_Errh_GetMEC_GetMec(&mec);
			if(mec == 0u){
				/*[$Satisfies $DDS_SSFM 164]*/
				(void)Rte_Read_RP_SrvcMgr_Errh_U19A6_54_Status_U19A6_54_Status(&dtc_u19A6_54_Status);
				(void)Rte_Call_RP_Dem_SSFM_DTC_U19A6_54_SetEventStatus((dtc_u19A6_54_Status == TRUE) ? DEM_EVENT_STATUS_FAILED : DEM_EVENT_STATUS_PASSED);
			}
		}
	}
}

