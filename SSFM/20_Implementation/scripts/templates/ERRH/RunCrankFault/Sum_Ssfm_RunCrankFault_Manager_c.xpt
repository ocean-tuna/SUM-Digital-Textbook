«IF (Ssfm_IsTimeBasedFilterInSUSDError(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SUSDErrors) > 0)-»
/**
 * @brief           SSFM/ERRH callback function to update SUSD error's debouncing result and notify DEM in case of timebased moving window expired
 *
 * @param[in]       debouncer_instance      - Sum_Ssfm_Debouncer*: Sum_Ssfm_Debouncer structure to access the type of the debouncer owner
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 3673 2 # The struct type where this signature is defined doesn't assume the function parameter always point to a constant object */
static void Sum_Ssfm_Errh_FP_SSFM_RunCrankFault_CbkWindowMoving(Sum_Ssfm_Debouncer* debouncer_instance)
{
	/*[$Satisfies $DDS_SSFM 056]*/
	Dem_EventStatusType event_status;

	/* Update Sum_Ssfm_Errh_ErrorSUSD object's debouncing result, as when this function is called it's not due to an explicit
	* event debouncing request from the RunCrankFaultManager (through Sum_Ssfm_ErrhDebouncerExecution, whose return value should update said debouncing result)
	* but to the EventDebouncerManager runnable that only resets expired time windows, resulting in an implicit debouncer successful evaluation.
	*/
	debouncer_instance->DebouncerOwner.RunCrank->debouncing_result = SUM_SSFM_EvaluationSts_Passed;

	/* Set the event status from Dem_SetEventStatus */
	event_status = DEM_EVENT_STATUS_PASSED;
	(void) debouncer_instance->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(event_status);
}
