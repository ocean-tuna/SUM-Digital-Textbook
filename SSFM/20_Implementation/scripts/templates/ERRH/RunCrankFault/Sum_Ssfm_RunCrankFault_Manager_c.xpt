/**
 * @brief           SSFM/ERRH function to process DTC confirmation for RunCrankInputStuckFaultDiagnostic
 *
 * @param[in]       error_susd      - const Sum_Ssfm_Errh_ErrorSUSD*: Sum_Ssfm_Errh_ErrorSUSD structure to access the SUSD errors and RTE functions
 * @param[in]		DTCStatusNew   New status of the updated DTC
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_Errh_Process_DTC_Confirmation(const Sum_Ssfm_Errh_ErrorSUSD*  error_susd, Dem_UdsStatusByteType DTCStatusNew)
{
	/*[$Satisfies $DDS_SSFM 067]*/

	/* Check the test failed DTC bitmask and debouncing result */
    if (((DTCStatusNew & SSFM_DEM_DTC_TEST_FAILED_MASK) == SSFM_DEM_DTC_TEST_FAILED_MASK))
    {
		/* Set the Fault Active Status Request DTC to Active */
        (void) error_susd->Rte_Write_SSFM_SUSD_FA_StatusRequest(TRUE);
    }
    else
    {
    	/* Set the Fault Active Status Request DTC to Inactive */
        (void) error_susd->Rte_Write_SSFM_SUSD_FA_StatusRequest(FALSE);
	}
}
