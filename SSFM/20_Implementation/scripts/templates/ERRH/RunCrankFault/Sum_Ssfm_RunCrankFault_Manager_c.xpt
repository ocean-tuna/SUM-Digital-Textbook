/**
 * @brief           SSFM/ERRH function to process RunCrank Input Stuck Diagnostic Status
 *
 * @param[in]       error_susd      - Sum_Ssfm_Errh_ErrorSUSD*: Sum_Ssfm_Errh_ErrorSUSD structure to access the SUSD errors and RTE functions
 * @param[in]       err_debouncer   - Sum_Ssfm_Debouncer*: Sum_Ssfm_Errh_ErrorSUSD structure to access the error debouncer event
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_Errh_Process_RunCrankInputStuckDiagnosticStatus(Sum_Ssfm_Errh_ErrorSUSD* error_susd, Sum_Ssfm_Debouncer*  err_debouncer)
{

	/*[$Satisfies $DDS_SSFM 065]*/
	/* Check if the RTE function pointers are valid*/
	if (error_susd->Rte_Read_SSFM_DiagnosticStatus != NULL_PTR)
	{
		/* Flag for controlling whether to process the DTC for SUM_SUSD errors */
		if (error_susd->FP_SSFM_pCdata_DTCProcess() == TRUE)
		{
			Sum_Ssfm_Errh_Process_DTC_RunCrankInputStuckFault(error_susd, err_debouncer);
		}
		else
		{
			/* Do nothing*/
		}
	}
	else
	{
		/* Do nothing */
	}
}


/**
 * @brief           SSFM/ERRH function to process DTC for RunCrank Input Stuck Fault Indication
 *
 * @param[in]       error_susd      - Sum_Ssfm_Errh_ErrorSUSD*: Sum_Ssfm_Errh_ErrorSUSD structure to access the SUSD errors and RTE functions
 * @param[in]       err_debouncer   - Sum_Ssfm_Debouncer*: Sum_Ssfm_Errh_ErrorSUSD structure to access the error debouncer event
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_Errh_Process_DTC_RunCrankInputStuckFault(Sum_Ssfm_Errh_ErrorSUSD*  error_susd, Sum_Ssfm_Debouncer*  err_debouncer)
{
	/*[$Satisfies $DDS_SSFM 066]*/
	uint8 diag_sts;
	Sum_Ssfm_EventStatus new_event_status;
	Dem_EventStatusType event_status;
	Std_ReturnType ret_val;

	/* Get the diagnostic status from SUSD */
	ret_val = error_susd->Rte_Read_SSFM_DiagnosticStatus(&diag_sts);
	if (ret_val == RTE_E_OK)
	{
		/* Check if there is something to report or filtering is ongoing */
		if ((diag_sts != SSFM_SUSD_NO_STATUS_TO_REPORT) || (error_susd->debouncing_result == SUM_SSFM_EvaluationSts_InDebouncing))
		{
			/* If debouncing is ongoing or SUSD diagnostic is passed, setting to event passed */
			if ((diag_sts == SSFM_SUSD_NO_STATUS_TO_REPORT) || (diag_sts == SSFM_SUSD_DIAGNOSTIC_PASSED))
			{
				new_event_status = SUM_SSFM_EventSts_Passed;
			}
			else
			{
				/* SUSD diagnostic is failed */
				new_event_status = SUM_SSFM_EventSts_Failed;
			}

			/* Check debouncing result if filter is X of Y, otherwise receive the event status */
			error_susd->debouncing_result = Sum_Ssfm_ErrhDebouncerExecution(err_debouncer, new_event_status);

			/* Report the error when the debouncing finished */
			if ((error_susd->debouncing_result != SUM_SSFM_EvaluationSts_InDebouncing) && (error_susd->debouncing_result != SUM_SSFM_EvaluationSts_Unknown))
			{
				/* Convert the event status result after performing debouncing */
				event_status = ((error_susd->debouncing_result) == SUM_SSFM_EvaluationSts_Passed) ? DEM_EVENT_STATUS_PASSED : DEM_EVENT_STATUS_FAILED;
				/* Set the event status from Dem_SetEventStatus */
				(void) err_debouncer->DemEvent->Rte_Call_Dem_SSFM_SetEventStatus(event_status);

			}
			else
			{
				/* Do nothing */
			}

		}
		else
		{
			/* Do nothing */
		}
	}
	else
	{
		/* Do nothing */
	}

}

«IF (Ssfm_IsRunCrankHighDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet)) -»
/**
 * @brief           SSFM/ERRH runnable function to be called upon any change in the status of RunCrankHighInputStuckDiagnosticStatus
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE */
FUNC (void, SUM_SSFM_CODE) Runnable_SSFM_RunCrankHighInputStuckDiagnosticStatus_Changed(void)
{

	/*[$Satisfies $DDS_SSFM 189]*/
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	if (dtcs_are_disabled == FALSE)
	{
		/* [$Satisfies $DDS_SSFM 068] */
		/* Check Run Crank Input Stuck High Fault Indication */
		Sum_Ssfm_Errh_Process_RunCrankInputStuckDiagnosticStatus(&Sum_Ssfm_Errh_RunCrankInputStuckFault[«Ssfm_GetSUSDErrorIndex(sSFM.sum_Ssfm_ConfigSet,"HIGH")-»], &Sum_Ssfm_RunCrank_Debouncers[«Ssfm_GetSUSDErrorIndex(sSFM.sum_Ssfm_ConfigSet,"HIGH")-»]);
	}
}
«ENDIF-»
«IF (Ssfm_IsRunCrankLowDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet)) -»
/**
 * @brief           SSFM/ERRH runnable function to be called upon any change in the status of RunCrankLowInputStuckDiagnosticStatus
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE */
FUNC (void, SUM_SSFM_CODE) Runnable_SSFM_RunCrankLowInputStuckDiagnosticStatus_Changed(void)
{

	/*[$Satisfies $DDS_SSFM 189]*/
	boolean dtcs_are_disabled = Sum_Ssfm_Errh_GetDTCsDisabled();

	/* Check control DTC status */
	if (dtcs_are_disabled == FALSE)
	{
		/* [$Satisfies $DDS_SSFM 069] */
		/* Check Run Crank Input Stuck Low Fault Indication */
