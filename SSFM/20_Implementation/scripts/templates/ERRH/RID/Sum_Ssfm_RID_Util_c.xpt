 *********************************************************************************************************************************************************
 */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */
#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"

/*
 *********************************************************************************************************************************************************
 * Variables (Global)

 *********************************************************************************************************************************************************
 */
 «IF Ssfm_isEnableERRHLocalSupervision(sSFM.sum_Ssfm_General) -»
/*!
 *Write the variable in te NvM.
 *@param[in]  item to write
 *@return void
 */
 /* PRQA S 1505 9 # This function is put here for modularity */
 FUNC(void, SUM_ERRH_CODE) SSFM_ERRH_Write(ERRH_DetectorType const* item)
{
	*(item->NvMDID.NvmRamBlock) = *(item->ERRH_ThresholdItem.ERRH_DIDCntr);
	item->NvMDID.ERRH_RteCallNvmSetRamBlockStatus_fp(TRUE);
}

/*!
 *Sets the the detectors to their default values.
 *@param[in]  item
 *@return Std_ReturnType
 */
/* PRQA S 1532 2 # This function is put here for modularity */
 FUNC(void, SUM_ERRH_CODE) SSFM_ERRH_ClearItem(ERRH_DetectorType const* item)
{

	*(item->ERRH_ThresholdItem.ERRH_Cntr)=0x0000;
	*(item->ERRH_ThresholdItem.ERRH_DIDCntr)=0x0000;

	*(item->ERRH_ThresholdItem.ERRH_TW) = 0x00000000;
	*(item->ERRH_ThresholdItem.ERRH_TWStarted) = FALSE;

	 SSFM_ERRH_Write(item);

}
«ENDIF-»
#define SUM_SSFM_STOP_SEC_CODE
#include "SUM_SSFM_MemMap.h"
