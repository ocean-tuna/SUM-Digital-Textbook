/* Include SSFM Top Level Library */
#include "Sum_Ssfm.h"

static Sum_Ssfm_SerialData* Sum_Ssfm_DID_E0B8_SerialDatas_InList[SSFM_DID_E0B8_MAX_MSGS];
static uint8 Sum_Ssfm_DID_E0B8_NumOfMsgs = 0u;
/*
 *********************************************************************************************************************************************************
 * Functions Declaration
 *********************************************************************************************************************************************************
 */
/* PRQA S 5087 EOF # This is necessary for security/memory Mapping reasons                      */
#define SUM_SSFM_START_SEC_CODE
#include "SUM_SSFM_MemMap.h"

static boolean Sum_Ssfm_DID_E0B8_AddSerialData(Sum_Ssfm_SerialData* serial_data);

