#ifndef SUM_SSFM_DID_E0B8_HANDLER_H
#define SUM_SSFM_DID_E0B8_HANDLER_H

// Derived from DCM DcmDspDataByteSize for DID 0xE0B8: max_msgs = (dcm_length - 1) / 10
#define SSFM_DID_E0B8_MAX_MSGS ((uint16)«Ssfm_DID_E0B8_CalcMaxMsgs(sSFM)»u)
#define SSFM_DID_E0B8_MAX_COUNTER ((uint16)65535u)
#define SSFM_DID_E0B8_MSGS_START_BYTE ((uint16)1u)
#define SSFM_DID_E0B8_MSG_ID_SIZE ((uint16)4u)
#define SSFM_DID_E0B8_MSG_AV_CNT_SIZE ((uint16)2u)
#define SSFM_DID_E0B8_MSG_CONTOP_CNT_SIZE ((uint16)2u)
#define SSFM_DID_E0B8_MSG_PROT_CNT_SIZE ((uint16)2u)
#define SSFM_DID_E0B8_MSG_SIZE (SSFM_DID_E0B8_MSG_ID_SIZE + SSFM_DID_E0B8_MSG_AV_CNT_SIZE + SSFM_DID_E0B8_MSG_CONTOP_CNT_SIZE + SSFM_DID_E0B8_MSG_PROT_CNT_SIZE)

/**************************************************************************************************************************
 * FUNCTION DECLARATION
 **************************************************************************************************************************
 */

extern void Sum_Ssfm_DID_E0B8_MetricUpdated(Sum_Ssfm_SerialData* serial_data, Sum_Ssfm_DID_E0B8_Metric metric);
extern void Sum_Ssfm_DID_E0B8_ResetData(void);
extern void Sum_Ssfm_DID_E0B8_SaveData(void);
extern void Sum_Ssfm_DID_E0B8_RestoreData(void);
#endif
