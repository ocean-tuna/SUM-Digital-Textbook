«IF Ssfm_isEnableERRHLocalSupervision(sSFM.sum_Ssfm_General) -»
/**
 * @brief           Internal function: ERRH_ConvertUint16ToBigEndianUint8Array implementation.
 *
 * @param[in]       source
 * @param[inout]    output
 * @param[out]      -
 * @return          E_OK
 */
static void ERRH_ConvertUint16ToBigEndianUint8Array(uint16 source, uint8* const output )
{
    /* to Big-Endian  */
	*output       = (uint8) ((source & 0xFF00u) >> 8u);
	*(output+1)   = (uint8) ((source & 0x00FFu) );
}

/**
 * @brief            * Runnable_WdgMReliabilityMonitor_ERRH_FailedLocalSupervision implementation.
 * 						It handles the notification sent by the WdgM through the port ERRH_BsWM_WdgM_SOHMode
 * 						about Failed Local Supervision events of the SOH.
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      -
 * @return          void
 */
 /*[$Satisfies $DDS_SSFM 144][$Satisfies $DDS_SSFM 145][$Satisfies $DDS_SSFM 147][$Satisfies $DDS_SSFM 148]*/
/* PRQA S 1503 2 # This runnable will be called by RTE */
FUNC(void, SUM_SOH_CODE) Runnable_WdgMReliabilityMonitor_ERRH_FailedLocalSupervision(void)
{
	/* Pass event to the corresponding filter */
	(void) ERRH_Event_Detector(&SOHSupFail);

	/* Check condition then Write DID counter and detection counter changed into NvM if satisfied*/
	ERRH_CheckConditionAndWrite(&SOHSupFail);

}

/**
 * @brief			Runnable_SUM_ERRH_Timing implementation.
 *					It reads the current Time from TCS and if 1s is elapsed it updates the Time Window of the
 *					detectors that are using a Time Windows filter.
 *
 * @param[in]		void
 * @param[inout]	void
 * @param[out]		void
 * @return			void
 */
  /*[$Satisfies $DDS_SSFM 148]*/
/* PRQA S 1503 2 # This function is put here for modularity */
FUNC(void, SUM_ERRH_CODE) Runnable_SUM_ERRH_Timing(void)
{
	uint64 CurrentTime;
	static uint64 OldTime = 0x0u;

    (void)Rte_Read_TCS_ERRH_SWC_Clock_GlobalTime(&CurrentTime);

    if(OldTime == 0x0u)
    {
    	OldTime = CurrentTime;
    }
    else
    {
    	/* Time in 100 ms, so if 10 = 1s */
    	if((CurrentTime-OldTime)>=10u)
    	{
    		ERRH_UpdateTimeWindows();
    		OldTime = CurrentTime;
    	}

    }
}

«ENDIF-»
«IF (this.eRootContainer.sOH != null) -»
/**
 * @brief           This Runnable will be run at the time of DID F094 read request.
 * 					This is a 2-byte unsigned integer and is used to maintain a filtered count
 * 					of the frequency of occurrences of SUM_SOH local supervision failures.
 *
 * @param[in]       OpStatus - Dcm_OpStatusType: No usage
 * @param[inout]    Data - uint8 *: The 2 byte buffer to fill in the data
 * @param[out]      -
 * @return          E_OK
 */
 /*[$Satisfies $DDS_SSFM 144][$Satisfies $ADS_SSFM 135]*/
/* PRQA S 1503 2 # This runnable will be called by RTE */
/* PRQA S 3432 2 # This runnable is invoked so the argument will follow the AUTOSAR specification */
FUNC(Std_ReturnType, SUM_SSFM_CODE) Runnable_DID_F094_SUM_ERRH_DID_SOHSupFail_Cntr(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                                                                   P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
    switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
			«IF (this.eRootContainer.sOH.sOHGeneral.sOH_ERRHLocalSupervision_SupportEnabled == true) -»
            	ERRH_ConvertUint16ToBigEndianUint8Array(*SOHSupFail.ERRH_ThresholdItem.ERRH_DIDCntr, Data);
			«ELSE-»
            	*(Data) = 0xFFu;
            	*(Data+1) = 0xFFu;
			«ENDIF-»
                break;
            default:
                /*Do nothing*/
                break;
        }

    return(E_OK);
}

/**
 * @brief           This Runnable will be run at the time of DID F094 read request.
 * 					This is a 1-byte enumeration and is used to indicate the current
 * 					local supervision status of the SUM_SOH supervised entity
 *
 * @param[in]       OpStatus - Dcm_OpStatusType: No usage
 * @param[inout]    Data - uint8 *: The 1 byte buffer to fill in the data
 * @param[out]      -
 * @return          E_OK
 */
  /*[$Satisfies $DDS_SSFM 145][$Satisfies $ADS_SSFM 136]*/
/* PRQA S 1503 2 # This runnable will be called by RTE */
/* PRQA S 3432 2 # This runnable is invoked so the argument will follow the AUTOSAR specification */
FUNC(Std_ReturnType, SUM_SSFM_CODE) Runnable_DID_F094_SUM_SOHLocalSupervisionStatus(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                                                                    P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
«IF (this.eRootContainer.sOH.sOHGeneral.sOH_ERRHLocalSupervision_SupportEnabled == true) -»
	uint8 SOH_Local_Supervision_Status;
«ENDIF-»
    switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
			«IF (this.eRootContainer.sOH.sOHGeneral.sOH_ERRHLocalSupervision_SupportEnabled == true) -»
            	/* get current local supervision status of SOH */
            	SOH_Local_Supervision_Status = Rte_Mode_ERRH_BsWM_WdgM_SOHMode_currentMode();

            	/* Mapping between AUTOSAR Spec and GM Spec */
            	switch (SOH_Local_Supervision_Status){
            		case 0x00u: /* OK */
            			SOH_Local_Supervision_Status = WDGM_LOCAL_STATUS_OK;
            			break;
            		case 0x01u: /* Failed */
            			SOH_Local_Supervision_Status = WDGM_LOCAL_STATUS_FAILED;
            			break;
            		case 0x02u: /* Expired */
            			SOH_Local_Supervision_Status = WDGM_LOCAL_STATUS_EXPIRED;
            			break;
            		case 0x04u: /* Deactivated */
            			SOH_Local_Supervision_Status = WDGM_LOCAL_STATUS_DEACTIVATED;
            			break;
            		default:    /* Invalid */
            			SOH_Local_Supervision_Status = WDGM_LOCAL_STATUS_INVALID;
            			break;
            	}

            	*Data = SOH_Local_Supervision_Status;
	         «ELSE-»
	            *Data = 0xFFu;
	         «ENDIF-»
	                break;
            default:
                /*Do nothing*/
                break;
        }

	return(E_OK);
}


/**
 * @brief           This Runnable will be run at the time of DID F094 check read
 * 					Condition check read
 *
 * @param[in]       OpStatus - Dcm_OpStatusType: No usage
 * @param[inout]    ErrorCode - Error code
 * @param[out]      -
 * @return          E_OK
 */
  /*[$Satisfies $DDS_SSFM 146]*/
  /*[$Satisfies $ADS_SSFM 135]*/
/* PRQA S 1503 2 # This runnable will be called by RTE */
/* PRQA S 3432 2 # This runnable is invoked so the argument will follow the AUTOSAR specification */
FUNC(Std_ReturnType, SUM_SSFM_CODE) Runnable_ERRH_DID_F094_CheckRead(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                                                     P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) ErrorCode)
{
    switch (OpStatus)
    {
        case DCM_INITIAL:
        case DCM_PENDING:
            *ErrorCode = 0u;
            break;
        default:
            /*Do nothing*/
            break;
    }

    return(E_OK);
}
