#ifndef SUM_SSFM_DID_E0BB_HANDLER_H
#define SUM_SSFM_DID_E0BB_HANDLER_H

«LET Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(sSFM.sum_Ssfm_ConfigSet) AS keySlotErrorSize-»
#define SUM_SSFM_NUMBER_KEY_SLOTS_CONFIGURED 	« keySlotErrorSize -»u
«LET Ssfm_DID_E0BB_SupportedKeySlotSize(keySlotErrorSize) AS supportedKeySlotSize-»
#define SUM_SSFM_NUMBER_KEY_SLOTS_SUPPORTED		« supportedKeySlotSize -»u
«IF (supportedKeySlotSize > 0)-»
/* Key Slot 1 (ECU Unlock Key) is excluded from reporting in the DID E0BB */
#define SUM_SSFM_DID_E0BB_ENTRY_NUMBER		  	(SUM_SSFM_NUMBER_KEY_SLOTS_SUPPORTED - 1u)
«ELSE-»
#define SUM_SSFM_DID_E0BB_ENTRY_NUMBER		  	0u
«ENDIF-»
«ENDLET-»
«ENDLET-»
#define SUM_SSFM_DID_E0BB_ENTRY_SIZE		  	3u


/**************************************************************************************************************************
 * FUNCTION DECLARATION
 **************************************************************************************************************************
 */
«IF ((Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(sSFM.sum_Ssfm_ConfigSet) != 0) && (Sum_Ssfm_Errh_U19A3_8A_PreCondition_IsValid(sSFM.sum_Ssfm_ConfigSet) == true))-»
FUNC(void, SUM_SSFM_CODE) Sum_Ssfm_DID_E0BB_SaveData(void);
FUNC(void, SUM_SSFM_CODE) Sum_Ssfm_DID_E0BB_RestoreData(void);
«ENDIF»

#endif
