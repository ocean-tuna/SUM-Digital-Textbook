/*[$Satisfies $DDS_SSFM 211]*/
Std_ReturnType Runnable_SSFM_DID_E0BB_ReadDataLength(Dcm_OpStatusType OpStatus,
                                                     uint16 * DataLength){

	Std_ReturnType ret = E_NOT_OK;
«IF ((Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(sSFM.sum_Ssfm_ConfigSet) != 0) && (Sum_Ssfm_Errh_U19A3_8A_PreCondition_IsValid(sSFM.sum_Ssfm_ConfigSet) == true))»
	if((OpStatus == DCM_INITIAL) || (OpStatus == DCM_PENDING)){
