 /**
 * @brief           Helper function to compute Key Slot State
 * 
 * @param[in]       KeySlotIndex - index of the Key Slot in the configuration array 
 * 
 * @return         	uint8 - Key Slot State (0-3)
 */
 static uint8 Sum_Ssfm_Compute_KeySlotState(const uint8 KeySlotIndex){
	/* Update the KeySlot state in the filter structure */
	Sum_Ssfm_Update_KeySlotState(&Sum_Ssfm_Errh_KeySlotVerifyFilter[KeySlotIndex]);
	
	/* Return the computed KeySlotState */
	return Sum_Ssfm_Errh_KeySlotVerifyFilter[KeySlotIndex].keyslot_status;
 }

  /**
 * @brief           Helper function to fill unused entry DID E0BB
 *
 * @param[inout]    Data - pointer to the buffer to fill in the data
 * @param[in]       KeySlotIndex - index of the Key Slot in the configuration array 
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_Fill_DID_E0BB_Unused_Entry(uint8* Data){
		

		Data[0u] = 0u; 
		Data[1u] = 0u;
		/* Label as Unused the corresponding bits */ 
		Data[2u] = 3u << 6u;

}

 /**
 * @brief           Helper function to fill in one entry of DID E0BB
 *
 * @param[inout]    Data - pointer to the buffer to fill in the data
 * @param[in]       KeySlotIndex - index of the Key Slot in the configuration array 
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_Fill_DID_E0BB_Entry(uint8* Data,
										 const uint8 KeySlotIndex){
		
		if (Restore_E0BB_flag == TRUE)
		{
			/* failed_auth_timer is in microseconds -> convert the data in second */
			uint8 failed_auth_timer_s = (uint8)(Sum_Ssfm_Errh_KeySlot_E0BB[KeySlotIndex].failed_auth_timer / 1000000u);

			Data[0u] = (uint8)(Sum_Ssfm_Errh_KeySlot_E0BB[KeySlotIndex].provider_DTC_Id >> 8u);
			Data[1u] = (uint8)(Sum_Ssfm_Errh_KeySlot_E0BB[KeySlotIndex].provider_DTC_Id);
			
			/* saturate the value failed_auth_timer_s to 63u (for 6 bits) */
			Data[2u] = (failed_auth_timer_s > 63u) ? 63u : failed_auth_timer_s;
			Data[2u] |=  (uint8)Sum_Ssfm_Errh_KeySlot_E0BB[KeySlotIndex].keyslot_status << 6u;

			/* Disable Restore flag after retrieving data from the last keyslot.*/
			if (KeySlotIndex >= (SUM_SSFM_NUMBER_KEY_SLOTS_CONFIGURED - 1u))
			{
				Restore_E0BB_flag = FALSE;
			}
		}
		else
		{
			/* failed_auth_timer is in microseconds -> convert the data in second */
			uint8 failed_auth_timer_s = (uint8)(Sum_Ssfm_Errh_KeySlotVerifyFilter[KeySlotIndex].failed_auth_timer / 1000000u);

			Data[0u] = (uint8)(Sum_Ssfm_Errh_KeySlotVerifyFilter[KeySlotIndex].provider_DTC_Id >> 8u);
			Data[1u] = (uint8)(Sum_Ssfm_Errh_KeySlotVerifyFilter[KeySlotIndex].provider_DTC_Id);
			
			/* saturate the value failed_auth_timer_s to 63u (for 6 bits) */
			Data[2u] = (failed_auth_timer_s > 63u) ? 63u : failed_auth_timer_s;
			Data[2u] |= Sum_Ssfm_Compute_KeySlotState(KeySlotIndex) << 6u;
		}	
}

/**
 * @brief           This function will be run at the time of DTC U19A3_8A is set or DCM is execured for the DID E0BB.
 * 					It to populate the buffer with the E0DB info.
 *
 * @param[inout]    Data - uint8 *: The buffer to fill in the data
 * @param[in]       
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_ReadData_DID_E0BB(uint8* Data)
{
	uint8 i;

	Data[0u] = SUM_SSFM_NUMBER_KEY_SLOTS_SUPPORTED;
	
	for(i = 0u; i < SUM_SSFM_NUMBER_KEY_SLOTS_CONFIGURED; i++){
		Sum_Ssfm_Fill_DID_E0BB_Entry(&Data[1u + (i * SUM_SSFM_DID_E0BB_ENTRY_SIZE)], i);
	}
	/* Fill the remaining unused entries with unused state */
	for(i = SUM_SSFM_NUMBER_KEY_SLOTS_CONFIGURED; i < SUM_SSFM_DID_E0BB_ENTRY_NUMBER; i++){
		Sum_Ssfm_Fill_DID_E0BB_Unused_Entry(&Data[1u + (i * SUM_SSFM_DID_E0BB_ENTRY_SIZE)]);
	}
}
«ENDIF»
 /**
 * @brief           This Runnable will be run at the time of DID E0BB read request.
 *
 * @param[in]       OpStatus - Dcm_OpStatusType: No usage
 * @param[inout]    Data - uint8 *: The buffer to fill in the data
 * @param[out]      -
 * @return          void
 */
/*[$Satisfies $DDS_SSFM 210]*/
/* PRQA S 1505 1 # The Runnable declaration is provided by RTE */
Std_ReturnType Runnable_SSFM_DID_E0BB(Dcm_OpStatusType OpStatus,
                                      uint8 *Data){

	Std_ReturnType ret = E_NOT_OK;

«IF ((Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(sSFM.sum_Ssfm_ConfigSet) != 0) && (Sum_Ssfm_Errh_U19A3_8A_PreCondition_IsValid(sSFM.sum_Ssfm_ConfigSet) == true))»
	if((OpStatus == DCM_INITIAL) || (OpStatus == DCM_PENDING)){
		Sum_Ssfm_ReadData_DID_E0BB(Data);
		ret = E_OK;
	}
«ELSE»
	if((OpStatus == DCM_INITIAL) || (OpStatus == DCM_PENDING)){
		Data[0u] = 0u;

		ret = E_OK;
	}
«ENDIF»
	return ret;
}
«IF IsDemFF_U19A3_8A_Required(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorFilter)-»
/**
 * @brief           This Runnable will be run at the time of DTC U19A3_8A is set.
 * 					Dem will use it to retrieve the info related to DID E0BB as Freeze Frame for DTC U19A3_8A.
 *                  Always returns current runtime data (KeySlotVerifyFilter), not restored data.
 *
 * @param[in]       -
 * @param[inout]    Data - uint8 *: The buffer to fill in the data
 * @param[out]      -
 * @return          Std_ReturnType
 */
FUNC(Std_ReturnType, SUM_SSFM_CODE) Runnable_SSFM_E0BB_FreezeFrame(uint8* Data)
{
	/*[$Satisfies $DDS_SSFM 217]*/

	/* Save current flag state */
	boolean saved_flag = Restore_E0BB_flag;
	
	/* Temporarily disable Restore_E0BB_flag to ensure runtime KeySlotVerifyFilter data is returned instead of stale restored data */
	Restore_E0BB_flag = FALSE;

	Sum_Ssfm_ReadData_DID_E0BB(Data);
	
	/* Restore original flag state */
	Restore_E0BB_flag = saved_flag;

	return E_OK;
}
«ENDIF»
