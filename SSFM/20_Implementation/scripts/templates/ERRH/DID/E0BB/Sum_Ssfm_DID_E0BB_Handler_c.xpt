		ret = E_OK;
	}
«ELSE»
	if((OpStatus == DCM_INITIAL) || (OpStatus == DCM_PENDING)){
		*DataLength = 0u;
		ret = E_OK;
	}
«ENDIF»
	return ret;
}

/**
 * @brief           This Runnable will be run at the time of DID E0BB check read
 * 					Condition check read
 *
 * @param[in]       OpStatus - Dcm_OpStatusType: No usage
 * @param[inout]    ErrorCode - Error code
 * @param[out]      -
 * @return          E_OK
 */
/*[$Satisfies $DDS_SSFM 212]*/
Std_ReturnType Runnable_SSFM_DID_E0BB_CheckRead(Dcm_OpStatusType OpStatus,
                                                Dcm_NegativeResponseCodeType* ErrorCode)
{
	Std_ReturnType ret = E_NOT_OK;

	if((OpStatus == DCM_INITIAL) || (OpStatus == DCM_PENDING)){
		*ErrorCode = E_OK; 
		ret = E_OK;
	}

	return ret;
}

«IF ((Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(sSFM.sum_Ssfm_ConfigSet) != 0) && (Sum_Ssfm_Errh_U19A3_8A_PreCondition_IsValid(sSFM.sum_Ssfm_ConfigSet) == true))-»
/**
 * @brief           Restore DID E0BB data from RAM block after NvM initialization.
 *                  Called during ECU startup after NvM restores the RAM block.
 *                  Parses the NvM buffer and restores authentication timers to KeySlotVerifyFilter array
 *                  to enable accumulation of key slot authentication data across ignition cycles.
 *
 * @param[in]       -
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1532 2 # Defined here for modularity reason */
/*[$Satisfies $DDS_SSFM 213]*/
FUNC(void, SUM_SSFM_CODE) Sum_Ssfm_DID_E0BB_RestoreData(void){
	uint8 i;
	uint8 entryOffset;
	uint8 failed_auth_timer_s;
	uint8 keySlotState;
	uint16 provider_DTC_Id;

	/* Enable the Restore flag for 0xE0BB */
	Restore_E0BB_flag = TRUE;
	
	/* Restore data from NvM buffer to KeySlotVerifyFilter array */
	for(i = 0u; i < SUM_SSFM_NUMBER_KEY_SLOTS_CONFIGURED; i++)
	{
		/* Calculate offset for this entry in the NvM buffer (skip first byte which is upperLimit) */
		entryOffset = 1u + (i * SUM_SSFM_DID_E0BB_ENTRY_SIZE);
		
		/* Extract DTC ID from bytes 0-1 of entry */
		provider_DTC_Id = (uint16)(((uint16)«sSFM.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_MACVerPerKSNvmRef.nvMRamBlockDataAddress-»[entryOffset] << 8u) | 
		                           (uint16)«sSFM.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_MACVerPerKSNvmRef.nvMRamBlockDataAddress-»[entryOffset + 1u]);
		
		/* Extract failed_auth_timer (6 bits) and keySlotState (2 bits) from byte 2 of entry */
		failed_auth_timer_s = «sSFM.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_MACVerPerKSNvmRef.nvMRamBlockDataAddress-»[entryOffset + 2u] & 0x3Fu; /* Mask lower 6 bits */
		keySlotState = (uint8)(«sSFM.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_MACVerPerKSNvmRef.nvMRamBlockDataAddress-»[entryOffset + 2u] >> 6u); /* Extract upper 2 bits */
		
		/* Restore values to KeySlotVerifyFilter array */
		Sum_Ssfm_Errh_KeySlot_E0BB[i].provider_DTC_Id = provider_DTC_Id;
		
		Sum_Ssfm_Errh_KeySlot_E0BB[i].keyslot_status = keySlotState;

		/* Failed state: restore failed_auth_timer */
		Sum_Ssfm_Errh_KeySlot_E0BB[i].failed_auth_timer = (uint32)failed_auth_timer_s * 1000000u;

	}
}

/**
 * @brief           This function is called during ERRH shutdown transition.
 *                  It saves the current key slot verification status to NvM RAM buffer
 *                  and marks it for persistence to non-volatile memory.
 *
 * @param[in]       -
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
/* PRQA S 1532 2 # Defined here for modularity reason */
/*[$Satisfies $DDS_SSFM 214]*/
FUNC(void, SUM_SSFM_CODE) Sum_Ssfm_DID_E0BB_SaveData(void){

	/* Disable Restore_E0BB_flag to ensure runtime KeySlotVerifyFilter data is saved instead of stale restored data */
	Restore_E0BB_flag = FALSE;

	/* Call the runnable to fill the NvM buffer with latest key slot status */
	(void)Runnable_SSFM_DID_E0BB(DCM_INITIAL, «sSFM.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_MACVerPerKSNvmRef.nvMRamBlockDataAddress-»);

	/* Inform NvM that RAM buffer has been updated and shall be saved to non-volatile memory */
	(void)Rte_Call_RP_SSFM_NvMService_DidE0BB_MACVerPerKeySlot_SetRamBlockStatus(TRUE);
}
«ENDIF»

