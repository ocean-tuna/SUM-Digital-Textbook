import bsw;
import bsw::SSFMModule;
import bsw::ComModule;
import bsw::SdModule;
import bsw::DemModule;

extension templates::mathlib;
extension org::eclipse::xtend::util::stdlib::elementprops;
extension org::eclipse::xtend::util::stdlib::io;
extension org::eclipse::xtend::util::stdlib::counter;
extension org::eclipse::xtend::util::stdlib::cloning;
extension Util::SSFM_Utils;

////////////////////////////// E0B9 //////////////////////////////
// Returns True if the DID_E0B9 is configured in Dcm
Boolean Ssfm_DID_E0B9_IsConfigured(SSFM cfg):
    cfg.eRootContainer.dcm.dcmConfigSet.dcmDsp.dcmDspDid.exists(e|e.dcmDspDidIdentifier == 57529) == true // 0xE0B9
;

// Returns the short name of the configured DID_E0B9 in the Dcm
String Ssfm_DID_E0B9_ShortName(SSFM cfg):
    if Ssfm_DID_E0B9_IsConfigured(cfg) then (
        cfg.eRootContainer.dcm.dcmConfigSet.dcmDsp.dcmDspDid.select(e|e.dcmDspDidIdentifier == 57529).first().shortName // 0xE0B9
    )
    else (
        throwError("DID_E0B9 is not configured in Dcm.")
    )
;

// Returns the short name of the configured DID_E0B9 data type in the Dcm
String Ssfm_DID_E0B9_Data_ShortName(SSFM cfg):
    if Ssfm_DID_E0B9_IsConfigured(cfg) then (
        cfg.eRootContainer.dcm.dcmConfigSet.dcmDsp.dcmDspDid
        .select(e|e.dcmDspDidIdentifier == 57529).first() // 0xE0B9
        .dcmDspDidSignal.dcmDspDidDataRef.shortName.first()
    )
    else (
        throwError("DID_E0B9 is not configured in Dcm.")
    )
;

