// Returns the number of supported key slot for DID_E0BB based on configured key slot number
Integer Ssfm_DID_E0BB_SupportedKeySlotSize(Integer keySlotErrorSize):
	if (keySlotErrorSize == 0) then (0)
	else if (keySlotErrorSize <= 10) then (10)
	else if (keySlotErrorSize <= 20) then (20)
	else if (keySlotErrorSize <= 50) then (50)
	else if (keySlotErrorSize <= 100) then (100)
	else if (keySlotErrorSize <= 150) then (150)
	else if (keySlotErrorSize <= 200) then (200)
	else (255)
;

// Returns DID_E0BB length based on configured key slot number
Integer Ssfm_DID_E0BB_Length(Sum_Ssfm_ConfigSet cfg):
    let supportedKeySlotSize = Ssfm_DID_E0BB_SupportedKeySlotSize(Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(cfg)):
	if (supportedKeySlotSize > 0) then ((supportedKeySlotSize - 1) * 3 + 1)
	else (1)
;


