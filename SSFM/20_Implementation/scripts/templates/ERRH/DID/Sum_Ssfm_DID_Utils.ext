;


/* Returns true or false according to the parameter ERRHLocalSupervision*/
Boolean Ssfm_isEnableERRHLocalSupervision(Sum_Ssfm_General general_cfg):
 	((general_cfg.eRootContainer.sOH != null) && (general_cfg.eRootContainer.sOH.sOHGeneral.sOH_ERRHLocalSupervision_SupportEnabled != null) && (general_cfg.eRootContainer.sOH.sOHGeneral.sOH_ERRHLocalSupervision_SupportEnabled == true)) ? true : false
 ;

/**
 * Returns true if the given DID (by dcmDspDidIdentifier) is configured for async client-server port usage.
 * Requires an SSFM config object as first parameter for context.
 */
boolean Get_DID_UsePortAsync(SSFM cfg, int dcmDspDidIdentifier):
    /* List of supported DIDs */
    let supportedDids = {57528, 57529, 57530, 57531}:
    
    /* Check if DID is supported and configured for async */
    supportedDids.contains(dcmDspDidIdentifier) &&
    cfg.eRootContainer.dcm.dcmConfigSet.dcmDsp.dcmDspDid.exists(e |
        e.dcmDspDidIdentifier == dcmDspDidIdentifier &&
        e.dcmDspDidSignal.exists(s | true) &&
        e.dcmDspDidSignal.first().dcmDspDidDataRef != null &&
        e.dcmDspDidSignal.first().dcmDspDidDataRef.dcmDspDataUsePort == "USE_DATA_ASYNCH_CLIENT_SERVER"
    )
;