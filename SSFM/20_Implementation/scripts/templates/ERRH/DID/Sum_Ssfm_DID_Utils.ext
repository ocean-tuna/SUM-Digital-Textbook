// Returns the DCM DcmDspDataByteSize (max buffer length) for DID 0xE0B8
Integer Ssfm_DID_E0B8_DcmByteSize(SSFM cfg):
    cfg.eRootContainer.dcm.dcmConfigSet.dcmDsp.dcmDspDid
    .select(e|e.dcmDspDidIdentifier == 57528).first() // 0xE0B8
    .dcmDspDidSignal.first().dcmDspDidDataRef.dcmDspDataByteSize
;

// Returns max_msgs = (DCM_E0B8_length - 1) / 10. Validated by Sum_Ssfm.chk.
Integer Ssfm_DID_E0B8_CalcMaxMsgs(SSFM cfg):
    (Ssfm_DID_E0B8_DcmByteSize(cfg) - 1) / 10
;


// Returns true if DCM DcmDspDataByteSize for E0B8 satisfies format 1 + N*10
Boolean Ssfm_DID_E0B8_IsDcmLengthFormatValid(SSFM cfg):
    let payload = Ssfm_DID_E0B8_DcmByteSize(cfg) - 1 :
    (payload - ((payload / 10) * 10)) == 0
;

// Returns true if N = (dcm_length - 1) / 10 is within supported range [1, 255]
Boolean Ssfm_DID_E0B8_IsDcmLengthRangeValid(SSFM cfg):
    let n = (Ssfm_DID_E0B8_DcmByteSize(cfg) - 1) / 10 :
    (n >= 1 && n <= 255)
;

// Returns true if NvM NvMNvBlockLength matches DCM DcmDspDataByteSize for E0B8
Boolean Ssfm_DID_E0B8_IsNvmLengthConsistent(SSFM cfg):
    cfg.sum_Ssfm_Errh_DID.sum_Ssfm_NvM_References.sum_Ssfm_CommFigureOfMeritNvmRef.nvMNvBlockLength == Ssfm_DID_E0B8_DcmByteSize(cfg)
;

