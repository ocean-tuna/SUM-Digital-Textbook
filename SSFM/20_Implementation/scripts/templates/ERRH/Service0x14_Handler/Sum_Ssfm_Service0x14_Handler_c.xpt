/**
 * @brief           SSFM/ERRH function to handle clear diagnostic request of ServiceRequest confirmation
 *
 * @param[in]       ConfirmationStatus - Dcm_ConfirmationStatusType*: confirmation of a successful transmission or a transmission error of a diagnostic service.
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_Errh_ClearDiagnosticRequest_Confirmation(Dcm_ConfirmationStatusType ConfirmationStatus)
{
	/*[$Satisfies $DDS_SSFM 113]*/
	if (ConfirmationStatus == DCM_RES_POS_OK)
	{
		/* Clear application related DTC flags */
		Sum_Ssfm_Errh_Reset_Internal_Statuses();
«IF (Ssfm_IsSUSDErrors_Configured(sSFM.sum_Ssfm_ConfigSet))-»
«IF ((Ssfm_IsRunCrankHighDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet)) || (Ssfm_IsRunCrankLowDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet))) -»
		/* SSFM ERRH shall provide a notification back to SUSD */
		Sum_Ssfm_Errh_Notification_SUSD();
«ENDIF-»
«ENDIF-»
		/* Notify other components that the clear diagnostic request has been approved */
		(void) Rte_Write_SUM_SSFM_PP_SSFM_ClearDiagReq_SSFMClearDiagReq(SUM_SSFM_ClearDiagReq_Approved);
		«IF Sum_Ssfm_Errh_U19A6_87_IsValid(sSFM.sum_Ssfm_ConfigSet)-»
		/* Handle DTC D9A687 */
		Sum_Ssfm_U19A6_87_Update(FALSE);
		«ENDIF-»
		Sum_Ssfm_Errh_Service14Requested = TRUE;
	}
	else
	{
		/* Notify other components that the clear diagnostic request has been Rejected */
		(void) Rte_Write_SUM_SSFM_PP_SSFM_ClearDiagReq_SSFMClearDiagReq(SUM_SSFM_ClearDiagReq_Rejected);
		Sum_Ssfm_Errh_Service14Requested = FALSE;
	}
}

/**
 * @brief           Runnable function for SUM SSFM to handle the ServiceRequest upon a ClearDiagnosticInformation confirmation
 *
 * @param[in]       ConfirmationStatus - Dcm_ConfirmationStatusType*: confirmation of a successful transmission or a transmission error of a diagnostic service.
 * @param[inout]    -
 * @param[out]      -
 * @return          E_OK
 */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called by the RTE */
FUNC(Std_ReturnType, SUM_SSFM_CODE) Runnable_SSFM_ServiceRequest_Confirmation(VAR(uint8, AUTOMATIC) SID,
                                                                         VAR(uint8, AUTOMATIC) ReqType,
                                                                         VAR(uint16, AUTOMATIC) ConnectionId,
                                                                         VAR(Dcm_ConfirmationStatusType, AUTOMATIC) ConfirmationStatus,
                                                                         VAR(Dcm_ProtocolType, AUTOMATIC) ProtocolType,
                                                                         VAR(uint16, AUTOMATIC) TesterSourceAddress)
{
	/*[$Satisfies $DDS_SSFM 115]*/
	/* These parameters are the inputs from DCM which are not used in this part of code */
	SUM_PARAM_UNUSED(ConnectionId);
	SUM_PARAM_UNUSED(ReqType);
	SUM_PARAM_UNUSED(ProtocolType);
	SUM_PARAM_UNUSED(TesterSourceAddress);

	switch (SID)
	{
		case SSFM_ERRH_DCM_CLEARDIAGNOSTICREQUEST:
			Sum_Ssfm_Errh_ClearDiagnosticRequest_Confirmation(ConfirmationStatus);
			break;

		default:
			/* do Nothing */
		break;
	}
	return E_OK;
}

