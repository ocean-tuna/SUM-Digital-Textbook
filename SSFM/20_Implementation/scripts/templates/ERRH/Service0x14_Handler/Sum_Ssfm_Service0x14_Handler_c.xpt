/**
 * @brief           SSFM/ERRH function to reset Loss of Comm internal variable statuses
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_Errh_Reset_LossOfComm_Internal_Statuses(void)
{
	uint16 index;
	for (index = 0u; index < (SSFM_NUM_OF_SIGNALBASED_CONTROLLERS + SSFM_NUM_OF_SERVICEBASED_TARGETDEVICES); index++)
	{
		Sum_Ssfm_NodeLoss_Debouncers[index].DebouncerOwner.ECUInfo->LossOfComm = FALSE;
		Sum_Ssfm_NodeLoss_Debouncers[index].DebouncerOwner.ECUInfo->TempLossOfComm = FALSE;
		Sum_Ssfm_NodeLoss_Debouncers[index].DebouncerOwner.ECUInfo->FaultTimerElapsed = 0u;
	}
	for(index = 0u; index < SSFM_SSM_NUM_OF_SERIALDATAS; index++){
		if(Sum_Ssfm_SerialDatas[index].LostCommInfo != NULL_PTR){
			Sum_Ssfm_SerialDatas[index].LostCommInfo->Rte_Write_LcFA(FALSE);
		}
	}
}
/**
 * @brief           SSFM/ERRH function to reset all the internal variable statuses
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
static void Sum_Ssfm_Errh_Reset_Internal_Statuses(void)
{
	/*[$Satisfies $DDS_SSFM 110]*/
	uint16 feature_index, index;
	/* Reset all the internal variables */
«IF (Ssfm_IsSUSDErrors_Configured(sSFM.sum_Ssfm_ConfigSet))-»
«IF ((Ssfm_IsRunCrankHighDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet)) || (Ssfm_IsRunCrankLowDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet))) -»
«IF (Ssfm_NumOfRunCrankDebouncers(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SUSDErrors) > 1)-»
	for (index = 0u; index < SSFM_ERRH_NUM_OF_CFG_ERROR_SUSD; index++)
	{
		Sum_Ssfm_RunCrank_Debouncers[index].DebouncerOwner.RunCrank->debouncing_result = SUM_SSFM_EvaluationSts_Unknown;
	}
«ELSE-»
		Sum_Ssfm_RunCrank_Debouncers[0].DebouncerOwner.RunCrank->debouncing_result = SUM_SSFM_EvaluationSts_Unknown;
«ENDIF-»
«ENDIF-»
«ENDIF-»
	Sum_Ssfm_Errh_Reset_LossOfComm_Internal_Statuses();
«REM»
	Since the logic for Authenticated/ContOp/Protected/Safety serial data is the same, to prevent repeating the same code
	in the xpt file, the following FOREACH is used. The DEB_LIST will represent one of the four above mentioned features.
«ENDREM»
«FOREACH {
	"Authenticated",
	"ContOp",
	"Protected",
	"Safety"
	} AS DEB_LIST ITERATOR i-»
«IF Ssfm_IsAnyACPS(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_SerialData, DEB_LIST)-»
	for (index = 0u; index < SSFM_SSM_NUM_OF_«DEB_LIST.toUpperCase()»_SERIALDATAS; index++){
		Sum_Ssfm_FIM_«DEB_LIST»_Debouncers[index].DebouncerOwner.FIM->«DEB_LIST»->FxFA = FALSE;
		Sum_Ssfm_FIM_«DEB_LIST»_Debouncers[index].DebouncerOwner.FIM->«DEB_LIST»->FP_Rte_Write_PP_FxFA_LocalSWC(FALSE);
	}
«ENDIF-»
«ENDFOREACH-»

	for (feature_index = 0u; feature_index < SSFM_DEBOUNCING_FEATURES; feature_index++){
		for (index = 0u; index < Sum_Ssfm_Debouncer_Sizes[feature_index]; index++){
			Sum_Ssfm_Debouncer_Lists[feature_index][index].Y = 0u;
			Sum_Ssfm_Debouncer_Lists[feature_index][index].X = 0u;
			Sum_Ssfm_Debouncer_Lists[feature_index][index].LastEvalStatus = SUM_SSFM_EvaluationSts_Unknown;
		}
	}

	Sum_Ssfm_DID_E0B8_ResetData();
	Sum_Ssfm_DID_E0BA_ResetData();
	/*[$Satisfies $DDS_SSFM 132]*/
	Sum_Ssfm_ClearDIDE0B9_Info();
«IF ((Sum_Ssfm_Errh_Get_SSCKeySlotErrorSize(sSFM.sum_Ssfm_ConfigSet) != 0) && (Sum_Ssfm_Errh_U19A3_8A_PreCondition_IsValid(sSFM.sum_Ssfm_ConfigSet) == true))-»
	/*[$Satisfies $DDS_SSFM 213]*/
	Sum_Ssfm_Clear_KeySlot_Authentication_Failure_Timers();
«ENDIF-»
}

«IF (Ssfm_IsSUSDErrors_Configured(sSFM.sum_Ssfm_ConfigSet))-»
«IF ((Ssfm_IsRunCrankHighDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet)) || (Ssfm_IsRunCrankLowDiagStatus_Configured(sSFM.sum_Ssfm_ConfigSet))) -»
/**
 * @brief           SSFM/ERRH function to send notification to SUSD
 *
 * @param[in]       void
 * @param[inout]    -
 * @param[out]      -
 * @return          void
 */
static void Sum_Ssfm_Errh_Notification_SUSD(void)
{
	/*[$Satisfies $DDS_SSFM 111]*/
«IF (Ssfm_NumOfRunCrankDebouncers(sSFM.sum_Ssfm_ConfigSet.sum_Ssfm_ErrorsHandlers.sum_Ssfm_Errh_SUSDErrors) > 1)-»
	uint8 index;
	for (index = 0; index < SSFM_ERRH_NUM_OF_CFG_ERROR_SUSD; index++)
	{
		Sum_Ssfm_Errh_RunCrankInputStuckFault[index].Rte_Write_SSFM_SUSD_FA_StatusRequest(FALSE);
	}
«ELSE-»
	Sum_Ssfm_Errh_RunCrankInputStuckFault[0].Rte_Write_SSFM_SUSD_FA_StatusRequest(FALSE);
«ENDIF-»
