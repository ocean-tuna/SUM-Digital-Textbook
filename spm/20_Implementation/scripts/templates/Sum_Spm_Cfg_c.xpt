};
	«ENDIF-»
«REM»Rx side«ENDREM»
	«IF pp.spmComIPduGroupEvnt_Rx.size > 0-»
#define SPM_«pp.shortName»_NUM_OF_CTR_PDU_GRP_RX («pp.spmComIPduGroupEvnt_Rx.size»U)
/*
 * Pdu for Sw dep «pp.shortName» (RX)
 */
static const Spm_Rte_SwitchPduGroup
Spm_Rte_SwitchPduGroup_«pp.shortName»_rx_refs[SPM_«pp.shortName»_NUM_OF_CTR_PDU_GRP_RX] = {
		«FOREACH pp.spmComIPduGroupEvnt_Rx AS pduGr SEPARATOR "\t,\n" -»
	(Rte_Switch_PP_SPM_BswM_ComIpduGroup_«pduGr.shortName»_SPM_SWCH_PDUGR)
