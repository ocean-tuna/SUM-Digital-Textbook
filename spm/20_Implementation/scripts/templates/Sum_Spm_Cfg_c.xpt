/* PRQA S 1531 EOF # This object can be used in other translation units and is defined here for template needs */


/**
 * @brief
 *
 * @param[in]		in0_out1				Parameter defines the direction of the communication handling
 * @param[inout]	srcIpU32Ptr				Pointer to the source address to publish OR received in/from the frame
 * @param[inout]	counterU32Ptr			Pointer Value of the heartbeat counter in the frame
 * @param[inout]	activeProfileU16Ptr		Pointer value to number of profile active in the current/remote SPM instance
 * @param[inout]	metadataPtr				Pointer to metadata buffer
 *
 * @return			Std_ReturnType
 * @retval			E_OK					Transmission OR reception successfully happened
 * @retval			E_NOT_OK				Transmission OR reception failed
 *
 * @note			The function scope is private since it is used by Top level function Spm_HandleVLANCommunication
 */
static Std_ReturnType Spm_«vlan.shortName»_PwrMgrHeartbeatHandleCom(
	Spm_CommHanldeDirectionType                  const   in0_out1,
	uint32 				                        *const   srcIpU32Ptr,
	uint32 					                    *const   counterU32Ptr,
	uint16 					                    *const   activeProfilesU16Ptr,
	uint8  					                    *const   metadataPtr
	);

/**
 * @brief
 *
 * @param[in]		in0_out1				Parameter defines the direction of the communication handling
 * @param[inout]	srcIpU32Ptr				Pointer to the source address to publish OR received in/from the frame
 * @param[inout]	A_wkupU8Ptr			    Pointer Value to the wake-up frame A buffer
 * @param[inout]	B_wkupU8Ptr		        Pointer value to the wake-up frame B buffer
 * @param[inout]	B_wkupU8Ptr		        Pointer value to the wake-up frame C buffer
 * @param[inout]	metadataPtr				Pointer to metadata buffer
 *
 * @return			Std_ReturnType
 * @retval			E_OK					Transmission OR reception successfully happened
 * @retval			E_NOT_OK				Transmission OR reception failed
 *
 * @note			The function scope is private since it is used by Top level function Spm_HandleVLANCommunication
 */
static
Std_ReturnType Spm_«vlan.shortName»_PwrMgrWakeupHandleCom(
	Spm_CommHanldeDirectionType                  const   in0_out1,
	uint32 					 	                *const   srcIpU32Ptr,
	uint8  				                        *const   A_wkupU8Ptr,
	uint8  					                    *const   B_wkupU8Ptr,
	uint8  					                    *const   C_wkupU8Ptr,
	uint8  					                    *const   metadataPtr
	);

/**
 * @brief
 *
 * @param[in]		in0_out1				Parameter defines the direction of the communication handling
 * @param[inout]	srcIpU32Ptr				Pointer to the source address to publish OR received in/from the frame
 * @param[inout]	A_wkupU8Ptr			    Pointer Value to the wake-up frame A buffer
 * @param[inout]	B_wkupU8Ptr		        Pointer value to the wake-up frame B buffer
 * @param[inout]	B_wkupU8Ptr		        Pointer value to the wake-up frame C buffer
 * @param[inout]	metadataPtr				Pointer to metadata buffer
 *
 * @return			Std_ReturnType
 * @retval			E_OK					Transmission OR reception successfully happened
 * @retval			E_NOT_OK				Transmission OR reception failed
 *
 * @note			The function scope is private since it is used by Top level function Spm_HandleVLANCommunication
 */
static
Std_ReturnType Spm_«vlan.shortName»_PwrMgrWakeupMulticastHandleCom(
	Spm_CommHanldeDirectionType                  const   in0_out1,
	uint32 					 	                *const   srcIpU32Ptr,
	uint8  				                        *const   A_wkupU8Ptr,
	uint8  					                    *const   B_wkupU8Ptr,
	uint8  					                    *const   C_wkupU8Ptr,
	uint8  					                    *const   metadataPtr
	);


/**
 * @brief
 *
 * @param[in]		in0_out1				Parameter defines the direction of the communication handling
 * @param[inout]	srcIpU32Ptr				Pointer to the source address to publish OR received in/from the frame
 * @param[inout]	dstIpU32Ptr				Pointer to the deestination address to publish OR received in/from the frame
 * @param[inout]	prMsgTypeU8Ptr			Pointer value to Request Message Type code (Just for completeness - Fixed value)
 * @param[inout]	rspsMsgTypeU8Ptr		Pointer value to Request Response Message Type code (Just for completeness - Fixed value)
 * @param[inout]	reqTypeSRef				Pointer value to request payload in the frame
 * @param[inout]	resTypeSRef				Pointer value to request response in the frame
 * @param[inout]	metadataPtr				Pointer to metadata buffer
 *
 * @return			Std_ReturnType
 * @retval			E_OK					Transmission OR reception successfully happened
 * @retval			E_NOT_OK				Transmission OR reception failed
 *
 * @note			The function scope is private since it is used by Top level function Spm_HandleVLANCommunication
 */
static
Std_ReturnType Spm_«vlan.shortName»_SwMgrInfoHandleCom(
	Spm_CommHanldeDirectionType    			     const   in0_out1,
	uint32 							 			*const   srcIpU32Ptr,
	uint32 							 			*const   dstIpU32Ptr,
	uint8										*const	 prMsgTypeU8Ptr,
	uint8										*const	 rspsMsgTypeU8Ptr,
	ProfileRequestDataType_SvcStruct 		    *const	 reqTypeSRef,
	RequestStatusProfileStateDataType_SvcStruct *const   resTypeSRef,
	uint8										*const	 metadataPtr
	);
«ENDFOREACH»

