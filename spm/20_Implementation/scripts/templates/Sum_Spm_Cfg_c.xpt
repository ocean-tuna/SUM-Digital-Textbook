«LET vlan.spmVLANComSwrMgrInfo AS sm -»
static
Std_ReturnType Spm_«vlan.shortName»_SwMgrInfoHandleCom(
		Spm_CommHanldeDirectionType    			     const   in0_out1,
		uint32 							 			*const   srcIpU32Ptr,
		uint32 							 			*const   dstIpU32Ptr,
		uint8										*const	 prMsgTypeU8Ptr,
		uint8										*const	 rspsMsgTypeU8Ptr,
		ProfileRequestDataType_SvcStruct 		    *const	 reqTypeSRef,
		RequestStatusProfileStateDataType_SvcStruct *const   resTypeSRef,
		uint8										*const	 metadataPtr
	)
{
	Std_ReturnType rtn_u8;

	switch (in0_out1) {
		case SPM_RECV_HNDL: { /* IN */
			«IF sm != null && sm.spmSwMgrInfoRxImpDataTypeRef_Foreign != null && sm.spmSwMgrInfoRxSendRecvIntRef_Foreign != null -»
			«sm.spmSwMgrInfoRxImpDataTypeRef_Foreign.toString().split("/").last()» data_in;

			rtn_u8 = Rte_Receive_RP_SPM_«vlan.shortName»_SwMgrInfoRx_«sm.spmSwMgrInfoRxSendRecvIntRef_Foreign.toString().split("/").last()»(&(data_in), metadataPtr);

			if(E_OK == rtn_u8){
				
			*(srcIpU32Ptr) = data_in.PMSrcId;
			*(dstIpU32Ptr) = data_in.PMDestId;

			*(prMsgTypeU8Ptr) = 0u;
			*(rspsMsgTypeU8Ptr) = 1u;

				reqTypeSRef->Size_Indicator = data_in.ProfileRequest.Size_Indicator;

				{
					uint16 req_idx;

					for (req_idx = 0U; req_idx < data_in.ProfileRequest.Size_Indicator; req_idx++) {
						SPM_SwMgrInfo_Req_ProfileID_SWID(&(data_in.ProfileRequest), reqTypeSRef, req_idx);
						SPM_SwMgrInfo_Req_ProfileID_ProfileNumber(&(data_in.ProfileRequest), reqTypeSRef, req_idx);
						SPM_SwMgrInfo_Req_RequestType(&(data_in.ProfileRequest), reqTypeSRef, req_idx);
					}
				}

				resTypeSRef->Size_Indicator = data_in.RequestStatusProfileState.Size_Indicator;

				{
					uint16 res_idx;

					for (res_idx = 0U; res_idx < data_in.RequestStatusProfileState.Size_Indicator; res_idx++) {
						SPM_SwMgrInfo_Res_ProfileID_SWID(&(data_in.RequestStatusProfileState), resTypeSRef, res_idx);
						SPM_SwMgrInfo_Res_ProfileID_ProfileNumber(&(data_in.RequestStatusProfileState), resTypeSRef, res_idx);
						SPM_SwMgrInfo_Res_RequestStatus(&(data_in.RequestStatusProfileState), resTypeSRef, res_idx);
						SPM_SwMgrInfo_Res_ProfileStatus(&(data_in.RequestStatusProfileState), resTypeSRef, res_idx);
					}
				}
			}
			«ELSE-»
			rtn_u8 = E_NOT_OK;
			«ENDIF-»
			break;
		}
		case SPM_SEND_HNDL: { /* OUT */
			«IF sm != null && sm.spmSwMgrInfoTxImpDataTypeRef_Foreign != null && sm.spmSwMgrInfoTxSendRecvIntRef_Foreign != null -»
			«sm.spmSwMgrInfoTxImpDataTypeRef_Foreign.toString().split("/").last()» data_out;

			data_out.PMSrcId  = *(srcIpU32Ptr);
			data_out.PMDestId = *(dstIpU32Ptr);

			data_out.PR_MsgType = 0u;
			data_out.RSPS_MsgType = 1u;

			{
				data_out.ProfileRequest.Size_Indicator = reqTypeSRef->Size_Indicator;

				{
					uint16 req_idx;

					for (req_idx = 0U; req_idx < data_out.ProfileRequest.Size_Indicator; req_idx++) {
						SPM_SwMgrInfo_Req_ProfileID_SWID(reqTypeSRef, &(data_out.ProfileRequest), req_idx);
						SPM_SwMgrInfo_Req_ProfileID_ProfileNumber(reqTypeSRef, &(data_out.ProfileRequest), req_idx);
						SPM_SwMgrInfo_Req_RequestType(reqTypeSRef, &(data_out.ProfileRequest), req_idx);
					}
				}

				data_out.RequestStatusProfileState.Size_Indicator = resTypeSRef->Size_Indicator;

				{
					uint16 res_idx;

					for (res_idx = 0U; res_idx < resTypeSRef->Size_Indicator; res_idx++) {
						SPM_SwMgrInfo_Res_ProfileID_SWID(resTypeSRef, &(data_out.RequestStatusProfileState), res_idx);
						SPM_SwMgrInfo_Res_ProfileID_ProfileNumber(resTypeSRef, &(data_out.RequestStatusProfileState), res_idx);
						SPM_SwMgrInfo_Res_RequestStatus(resTypeSRef, &(data_out.RequestStatusProfileState), res_idx);
						SPM_SwMgrInfo_Res_ProfileStatus(resTypeSRef, &(data_out.RequestStatusProfileState), res_idx);
					}
				}
			}

			rtn_u8 = Rte_Send_PP_SPM_«vlan.shortName»_SwMgrInfoTx_«sm.spmSwMgrInfoTxSendRecvIntRef_Foreign.toString().split("/").last()»(&(data_out), metadataPtr);
			«ELSE-»
			rtn_u8 = E_NOT_OK;
			«ENDIF-»

			break;
		}
		default: {
			rtn_u8 = E_NOT_OK;
			break;
		}
	}

	return rtn_u8;
}
«ENDLET -»

«ENDFOREACH»

