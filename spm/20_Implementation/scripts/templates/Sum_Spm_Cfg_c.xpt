SpmSduDataBuffType spm_sdu_Can_WuFPduData_Tx_Frame_A = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
SpmSduDataBuffType spm_sdu_Can_WuFPduData_Tx_Frame_B = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
SpmSduDataBuffType spm_sdu_Can_WuFPduData_Tx_Frame_C = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};

Spm_PduInfoTypeWrpp
Spm_CanIf_Tx_WakeUpFrame_A = {
«LET spm.spmGeneral.spmCANWkUpFrmRef.spmCANWkUpFrmTxRef.select(e | e.canIfTxPduCanId == 339).first() AS can_tx -»
	/* pduId ............................................. */
	CanIfConf_CanIfTxPduCfg_«can_tx.shortName-»,
«ENDLET-»
	/* pduInfo ........................................... */
	{
		/* SduDataPtr .................................... */
		(uint8 *)(&spm_sdu_Can_WuFPduData_Tx_Frame_A[0U]),
		/* MetaDataPtr ................................... */
		NULL_PTR,
		/* SduLength ..................................... */
		8U
	}
};

Spm_PduInfoTypeWrpp
Spm_CanIf_Tx_WakeUpFrame_B = {
«LET spm.spmGeneral.spmCANWkUpFrmRef.spmCANWkUpFrmTxRef.select(e | e.canIfTxPduCanId == 355).first() AS can_tx -»
	/* pduId ............................................. */
