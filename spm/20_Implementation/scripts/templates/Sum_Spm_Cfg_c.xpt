Spm_Rte_SwitchPduGroup_«pp.shortName»_tx_refs[SPM_«pp.shortName»_NUM_OF_CTR_PDU_GRP_TX] = {
		«FOREACH pp.spmComIPduGroupEvnt_Tx AS pduGr SEPARATOR "\t,\n" -»
	(Rte_Switch_PP_SPM_BswM_ComIpduGroup_«pduGr.shortName»_SPM_SWCH_PDUGR)
