	}
};

Spm_PduInfoTypeWrpp
Spm_CanIf_Tx_WakeUpFrame_C = {
«LET spm.spmGeneral.spmCANWkUpFrmRef.spmCANWkUpFrmTxRef.select(e | e.canIfTxPduCanId == 371).first() AS can_tx -»
	/* pduId ............................................. */
