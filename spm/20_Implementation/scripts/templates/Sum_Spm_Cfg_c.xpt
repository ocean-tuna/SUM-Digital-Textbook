«IF spm.spmGeneral.spmCANWkUpFrmRef.spmCANWkUpFrmRxRef.size > 0-»
const Spm_RxPduInfoType Spm_CanIf_Rx[SPM_WUF_CAN_RX_LEN] = {
«FOREACH spm.spmGeneral.spmCANWkUpFrmRef.spmCANWkUpFrmRxRef AS pdu_can -»
	«LET pdu_can.canIfRxPduCanId.convertToHex().toString().bitWiseAnd("FF") AS canIdLastByte-»
	«FOREACH cdd AS cdd_itm -»
		«IF cdd_itm.cddComStackContribution != null && cdd_itm.cddComStackContribution.cddComIfUpperLayerContribution != null && cdd_itm.cddComStackContribution.cddComIfUpperLayerContribution.cddComIfUpperLayerRxPdu.size > 0 -»
    		«LET cdd_itm.cddComStackContribution.cddComIfUpperLayerContribution.cddComIfUpperLayerRxPdu AS pdus_cdd-»
      			«FOREACH pdus_cdd AS pdu_cdd -»
        			«IF pdu_can.canIfRxPduRef.shortName.matches(pdu_cdd.cddComIfPduRef.shortName) -»
	{
		/* PduId ............................................*/
		CddConf_CddComIfUpperLayerRxPdu_«pdu_cdd.shortName»,
		/* Last byte of CanId ...............................*/
		0x«canIdLastByte»u
	},
					«ENDIF-»
      			«ENDFOREACH-»
    		«ENDLET-»
		«ENDIF-»
    «ENDFOREACH-»
	«ENDLET-»
«ENDFOREACH-»
};
«ENDIF-»

«ELSE -»
/*
 * Wake-up on CAN is not supported for the current ECU instance
 */
«ENDIF -»
