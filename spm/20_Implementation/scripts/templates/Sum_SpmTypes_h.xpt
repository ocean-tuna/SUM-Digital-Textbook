/**
 * @brief the enum type defines the type of frames to handle
 *
 * SPM supports the following frames direclty:
 *
 * | Frame | Code |
 * |:---------------------:|:--------:|
 * | PM Heartbeat Frame    | 0        |
 * | SM Profile Info Frame | 1        |
 * | PM Wakeup Frame (ETH) | 2        |
 */
typedef enum {
	SPM_HB_COMHNDLING 	         = 0x00u, /**< Handle communication of Heartbeat frame */
	SPM_SM_COMHNDLING	         = 0x01u, /**< Handle communication of SM frame */
	SPM_WK_COMHNDLING            = 0x02u, /**< Handle communication of WakeUp frame */
	SPM_WK_MULTICAST_COMHNDLING  = 0x03u, /**< Handle communication of Multicast WakeUp frame */
	SPM_INV_COMHNDLING  		 = 0xFFu  /**< Error Code - Unsupported frame */
} Spm_CommHandleFrameType;

/**
 * @brief the enum type defines the direction of frames that SPM handles
 *
 * SPM supports the following frames direclty:
 *
 * | Frame | Code |
 * |:----------:|:--------:|
 * | Sending    | 0        |
 * | Receiving  | 1        |
 */
typedef enum {
	SPM_RECV_HNDL		= 0x00u, /**< Handling the frame in receiving side */
	SPM_SEND_HNDL		= 0x01u  /**< Handling the frame in sending side   */
} Spm_CommHanldeDirectionType;

/* @brief Enum that defines the priority levels */
typedef enum {
	SPM_NOT_APPLICABLE = 0U,
	SPM_LOW = 1U, 
	SPM_MEDIUM_LOW = 2U,
	SPM_MEDIUM = 3U,
	SPM_MEDIUM_HIGH = 4U,
	SPM_HIGH = 5U,
	SPM_CRITICAL = 6U,
	SPM_EMERGENCY = 7U,
	SPM_ACCESS = 8U
} Spm_LowVoltPriorityLevel;

/**
 * @brief The struct defines the Data Type for the payload of a PM Heartbeat Frame
 *
 * @note The frame definition follows the model specified by the extract but it is
 *       private at SPM internal development scope
 */
typedef struct {
	uint32											SrcPMId;	/**< SourceIp of the SPM node */
	uint32											HrtBtCntr;  /**< Current value of the heartbeat counter to share */
	uint16											NmbrPrfAct; /**< Number of the current profile NOT in inactive state */
} SPM_HB_dt_Prv;

/**
 * @brief The struct defines the Data Type for the payload of a SM Info frame
 *
 * @note The frame definition follows the model specified by the extract but it is
 *       private at SPM internal development scope
 */
typedef struct {
	uint32											PMSrcId;					/**< SourceIp of the SPM node */
	uint32											PMDestId;					/**< DestinationIp of the SPM remote node */
	uint8											PR_MsgType;					/**< Code that address the beginning of the requests part in the message */
	ProfileRequestDataType_SvcStruct				ProfileRequest;				/**< Profile request payload */
	uint8											RSPS_MsgType;				/**< Code that address the beginning of the response part in the message */
	RequestStatusProfileStateDataType_SvcStruct		RequestStatusProfileState;	/**< Profile request response payload */
} SPM_dt_Prv;

/**
 * @brief The struct defines the Data Type for the payload of a PM Wakeup frame
 *
 * @note The frame definition follows the model specified by the extract but it is
 *       private at SPM internal development scope
 */
typedef struct {
	uint32											SrcPMId;					/**< SourceIp of the SPM node */
	uint8											WakeupFrameA[8U];			/**< Wakeup frame A buffer (Ethernet) */
	uint8											WakeupFrameB[8U];			/**< Wakeup frame B buffer (Ethernet) */
	uint8											WakeupFrameC[8U];			/**< Wakeup frame C buffer (Ethernet) */
} SPM_WkUp_dt_Prv;

/**
 * @brief The function pointer is a reference to function for handling Hertbeat communication
 *        to/from current SPM instance
 */
typedef Std_ReturnType (*Spm_VLAN_Heartbeat_ComHndlrType_fptr)(
	Spm_CommHanldeDirectionType		             const   in0_out1,
	uint32 						                *const   srcIpU32Ptr,
	uint32                                      *const   counterU32Ptr,
	uint16                                      *const   activeProfilesU16Ptr,
	uint8                                       *const   metadataPtr);

/**
 * @brief The function pointer is a reference to function for handling Wakeup frame (Ethernet) communication
 *        to/from current SPM instance
 */
typedef Std_ReturnType (*Spm_VLAN_WakeUp_ComHndlrType_fptr)(
	Spm_CommHanldeDirectionType                  const   in0_out1,
	uint32 						                *const   srcIpU32Ptr,
	uint8  						                *const   A_wkupU8Ptr,
	uint8  						                *const   B_wkupU8Ptr,
	uint8  						                *const   C_wkupU8Ptr,
	uint8  					                    *const   metadataPtr);

/**
 * @brief The function pointer is a reference to function for handling SwMgrInfo communication
 *        to/from current SPM instance
 */
typedef Std_ReturnType (*Spm_VLAN_SmInfo_ComHndlrType_fptr)(
	Spm_CommHanldeDirectionType   				 const   in0_out1,
	uint32 							 			*const   srcIpU32Ptr,
	uint32 							 			*const   dstIpU32Ptr,
	uint8										*const	 prMsgTypeU8Ptr,
	uint8										*const	 rspsMsgTypeU8Ptr,
	ProfileRequestDataType_SvcStruct 		    *const	 reqTypeSRef,
	RequestStatusProfileStateDataType_SvcStruct *const   resTypeSRef,
	uint8										*const	 metadataPtr);

typedef struct{
	const SPM_NetworkInfo* SPM_NetInfo;
}SPM_NetworkInfo_WrapType;

typedef struct{
	RID_Enum cmdEnum; 
	boolean *sendTracker; 
	boolean (*getActiveLocalProfOrRequestedRemoteProf)(); 
}ProfileHandleE0D7Config; 

typedef struct{
	uint32 ActivityTimerInTick;  /* Cumulative amount of tick that the profile was active. */
	uint8 ActivationCount;       /* Number of times the profile was directly locally activated. */
}SpmDiagActivityTiming; 

typedef struct{
	uint16 ServiceId; 
	uint8 ProfNumber; 
	uint8 LastByteIPRequester; 
	SpmDiagActivityTiming ActualPowerOffRecords; 
}SpmDiagActivatedProfileStruct; 

#endif

