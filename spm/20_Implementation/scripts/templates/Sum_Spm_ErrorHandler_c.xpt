static SpmFeedbackErrorListType SpmFeedbackErrorList = {
	{«FOREACH 0.upTo(spm.spmConfigSet.spmPowPrf.size - 1) AS itm-» {0u, 0u, 0u, 0u, 0u}, «ENDFOREACH -»},
	0u
};
