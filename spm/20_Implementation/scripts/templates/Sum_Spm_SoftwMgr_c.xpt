/**
 * @brief			Retrieves TrgDvcIP for all the PowProf Configured that are NOT configured as local.
 * 
 * @param[in]		None
 * @param[inout]	None
 * @param[out]		None
 * @return			void
 */
/* PRQA S 1532 1 # Following macro are used to access data structure */
void SPM_PM_Init_ProfilesStructs(void)
{
	uint16 i;
	uint32 trgDvcId;
	uint16 srvcId;
«IF spm.spmConfigSet.spmPowPrf.select(e|e.spmProfileIsLocal == false).size > 0-»
	uint16 sdSrvcInstId;
	uint8  sdMajorVer;
«ENDIF-»
	Std_ReturnType rtn_getNodeAddr_u8;
	for(i = 0U; i < SPM_CONF_POW_PRF_NUM; i++){

		/* ====================================================================================================================
			Retrieve the TrgDvcIP for all the PowProf Configured that are NOT configured as local.
		--------------------------------------------------------*/
		if( SPM_GET_PROF_IS_LOC_FROM_CONF(i) == FALSE ){
			srvcId = SPM_SRVCID_FROM_PRFID( (SpmPowPrf_Cfg_WrpTable[i].powPrf_data->PowPrfID) );
«IF spm.spmConfigSet.spmPowPrf.select(e|e.spmProfileIsLocal == false).size > 0-»
			/* Get the service instance ID and major version based on Sd service configuration. */
			/* [$Satisfies $DDS_SPM 0011] */
			Spm_GetSdServiceConfig(srvcId,
									SPM_SRVC_INSTID_FROM_PRFID( (SpmPowPrf_Cfg_WrpTable[i].powPrf_data->PowPrfID) ),
									&sdSrvcInstId,
									&sdMajorVer);
			/* [$Satisfies $DDS_SPM 0026] *//* [$Satisfies $DDS_SPM 0040] *//* [$Satisfies $DDS_SPM 0011] */
			rtn_getNodeAddr_u8 = Sd_GetNodeAddress(srvcId, sdSrvcInstId, sdMajorVer, &trgDvcId);
«ELSE-»
			/* [$Satisfies $DDS_SPM 0026] *//* [$Satisfies $DDS_SPM 0040] *//* [$Satisfies $DDS_SPM 0011] */
			rtn_getNodeAddr_u8 = Sd_GetNodeAddress(srvcId, 0u, 0u, &trgDvcId);
«ENDIF-»
			if (rtn_getNodeAddr_u8 == E_OK) {
				if (trgDvcId != 0UL) {
					/*
					* If the profile is a local one, its TrgDvcIp value is 0u as per definition of the struct.
					*/
					SPM_PrfStsMgr_RAM[i].TrgDvcIp = trgDvcId;
				}
			}
		}

		/* Reset the mask. */
		SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step = 0U;

		/* Init retry trackers with the calibrated slow periodicity (CData value available at runtime). */
		SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_ActDeactRetry_StoredPeriodicityInTicks = SPM_ACT_RETRY_SLOW_TICKS;
		SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_ActDeactRetry_OngoingTrackerInTicks   = SPM_ACT_RETRY_SLOW_TICKS;

		/* Convert s in tick w.r.t. SM periodicity. */
		SPM_GET_TICKTRACKER_VEH_OFF(i) = (uint32)SPM_GET_TIMEOUT_VEH_OFF_SECOND(i) * 1000u / SPM_SM_PERIODICITY_MS;
	}
}
