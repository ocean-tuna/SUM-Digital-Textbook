#define SPM_START_SEC_CODE
#include "SPM_MemMap.h"
/*=====================================================================================================================================
 * BEGIN Function: Spm_LoC_wRequester_Handler
 *-------------------------------------------------------------------------------------------------------------------------------------*/
/*
 * @brief The function iterates over the requesters for each Power Profile and checks whether the remote requester ReqType
 * 	is different from SPM_NULL_REQ or SPM_REQ_DEACTIVATION. If so, the function retrieves the Power State of that specific
 *  Target device and sets the ReqType field for the requester to SPM_NULL_REQ under two conditions.
 *
 * The function performs the following operations:
 * 	1. **Retrieves the Power State of the Target Devices**
 *	2. **Iterates over the Power Profiles:**
 *		- For each Power Profile, iterates through its list of requesters.
 *		- For each requester, checks if the ReqType is neither SPM_NULL_REQ nor SPM_REQ_DEACTIVATION.
 *			- If so, retrieves the Power State of the target device using Spm_DevicePowerStateParser.
 *			2.1 **Two conditions to sets the ReqType to SPM_NULL_REQ**
 *			- The target device is not in the ON state and is present in the configuration list. It also adds the item to
 *				the list of errors and sets the stay awake timer if the profile is local.
 *			- The Target Device is not present in the configuration list.
 * @param[in]  void
 *
 * @return void
 */
static void Spm_LoC_wRequester_Handler( void ) {
	uint16 pp_idx_u16 = 0U;
	uint8 td_idx_u8;
	boolean prf_activity_Notreq_On_b;
	SpmDevicePowerStateCode dvc_pow_state_ret; // Device power state return value
	uint8 err_code_u8;

	Spm_DevicePowerStateInfo ds_read_s;

	/* [$Satisfies $DDS_SPM 0535] */
	Rte_IrvRead_SPM_RE_SPM_SoftMgr_MainFunction_Spm_DevicePowerState(&(ds_read_s));

	/* Iterate for each configured power profile and its requesters*/
	for ( ;pp_idx_u16 < SPM_CONF_POW_PRF_NUM; pp_idx_u16++ ) {
		/* [$Satisfies $DDS_SPM 0533] */
		for ( td_idx_u8 = 0U; td_idx_u8 < SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.size; td_idx_u8++ ) {

			/* [$Satisfies $DDS_SPM 0534] *//* Check if the Request type of the requester is deactivation or no request */
			prf_activity_Notreq_On_b =  (SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.spmReqLst[td_idx_u8].ReqType == SPM_NULL_REQ) ||
										(SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.spmReqLst[td_idx_u8].ReqType == SPM_REQ_DEACTIVATION);

			if ((prf_activity_Notreq_On_b != TRUE) && (SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.spmReqLst[td_idx_u8].requesterIP != 0UL)) {
				/* Retrieve the Power State  of the target device by using the dedicated utility in SPM code */
				/* [$Satisfies $DDS_SPM 0533] [$Satisfies $DDS_SPM 0534] [$Satisfies $DDS_SPM 0535] */
				dvc_pow_state_ret = Spm_DevicePowerStateParser(SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.spmReqLst[td_idx_u8].requesterIP, &ds_read_s);

					/* Check the two conditions to remove the requester
				* 	condition 1: The target Device is present in the configuration and is in Faulted or Reboot state
				* condition 2 : The Target Device is not present in the configuration list -> No message can be delivered
				*/
				if ((dvc_pow_state_ret == SPM_Faulted) || (dvc_pow_state_ret == SPM_Reboot)) {

					/* [$Satisfies $DDS_SPM 0536] */
					/* If the Target device in Fault state sends feedback by setting the Request Status to Spm_REJECTED_LOSS_OF_HEARTBEAT,
					otherwise, if in Restart status, it sets the field to Spm_REJECTED_RESET_DETECTED. */
					err_code_u8 = (uint8) ((dvc_pow_state_ret ==  SPM_Faulted) ? Spm_REJECTED_LOSS_OF_HEARTBEAT : Spm_REJECTED_RESET_DETECTED);
					/* Add the item to the list of errors */
					Spm_AppendFeedbackErrorItemToList( (uint8)pp_idx_u16,
													SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.spmReqLst[td_idx_u8].requesterIP,
													err_code_u8, 
													(uint32)0xFFFFFFFFU, 
													(uint8)0xFFU);

					/* Remove the target from the list of requester for the profile */
					SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.spmReqLst[td_idx_u8].ReqType = SPM_NULL_REQ;

					/* Check if the Power Profile is Local and reset the timer if a Target device is in Fault or Reboot state */
					if (SPM_GET_PROF_IS_LOC_FROM_CONF(pp_idx_u16) == TRUE) {
						/* [$Satisfies $DDS_SPM 0646] */
						Spm_StartStayAwakeTimer();
					}
				} /* endif */

				/* [$Satisfies $DDS_SPM 0537] */
				if (dvc_pow_state_ret == SPM_UnknownDevice) { /* Device not found in configuration */
					SPM_PrfStsMgr_RAM[pp_idx_u16].reqLst.spmReqLst[td_idx_u8].ReqType = SPM_NULL_REQ;
				} /* endif */
			}

		}
	}

}
/*-------------------------------------------------------------------------------------------------------------------------------------
 * END Function: Spm_LoC_wRequester_Handler
 *=====================================================================================================================================*/
#define SPM_STOP_SEC_CODE
