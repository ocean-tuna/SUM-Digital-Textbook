/**
 * @brief Main function of the Software Power Manager (SPM) module.
 *
 * This function periodically executes and manages the overall operation of the SPM module.
 * It performs the following key tasks:
 *
 * 1. **Checks Execution Permission:**
 *    - Reads the `SPM_PermitExecution` flag to verify if SPM execution is allowed based on external factors.
 * 2. **Evaluates Shutdown Conditions:**
 *    - If permission is denied and no activity is detected on local power profiles, initiates a controlled shutdown process.
 * 3. **Manages SPM Functionality (when permitted):**
 *    - Monitors vehicle states for potential power profile activation triggers.
 *    - Processes incoming messages from other Software Managers.
 *    - Handles power profile status updates, including deactivation requests, activation requests, and state transitions.
 *    - Reacts to loss-of-node indications.
 *    - Manages service activation status and notifies the Service Manager about active services.
 * 4. **Handles Module States:**
 *    - Transitions to the `Spm_Running` state if execution permission is granted.
 *    - Remains in the `Spm_Initialized` or `Spm_PrepareToShutdown` state otherwise, depending on the current state and received permission.
 * 5. **Writes Shutdown Permission:**
 *    - Updates the `SPM_ShutdownPermission` value with the current shutdown rolling counter.
 *
 * @note This function interacts with various external functions and data structures for communication, state management, and power profile information.
 *       - Refer to the implementation for details on specific dependencies.
 *
 *
 */
/* [$Satisfies $DDS_SPM 0403] [$Satisfies $DDS_SPM 0650]*/
FUNC(void, SPM_CODE) SPM_SoftMgr_MainFunction(void)
{

	SPM_PermitExecution Spm_allowed = 0x00U;

	if(TRUE == SpmCtrl_Initilization_Status){
		/* [$Satisfies $DDS_SPM 0414] *//* [$Satisfies $DDS_SPM 0415] */
		(void)Rte_Read_RP_SUSD_SPM_PerExec_SUSD_SWC_ExecutionStatus(&(Spm_allowed));

	    switch(SpmCtrl_Status) {
			/* SPM Module is requested */
			case Spm_Running:
	      	{

				Spm_ShutdownRollingCounter = ( (Spm_ShutdownRollingCounter + 1u) % 0x04u );

				/* ===================================
					Evaluate Shutdown conditions
				------------------------------------*/
				if( ((Spm_allowed | SPM_PERMIT_EXEC_MASK) != SPM_EXEC_MASK_PASSED)) {
					/* [$Satisfies $DDS_SPM 0416] */
					SpmCtrl_Status = Spm_PrepareToShutdown;
					Spm_ErrorHandler_ShutdownDetected();
					/* Reset request queue */
					SPM_InitQueue( &Sum_Spm_RequestQueue );
					break; /* switch break */
				}

	«IF Spm_ExistMultipleVariantConfigured(spm) == true -»
			if(FALSE == Sum_Spm_GetIsBranded())
			{
				Sum_Spm_GetVariantId_DataStructurePopulation_WithVariant();
			}
			else
			{	
	«ENDIF-»

		«IF Spm_IsLowVoltPrioServiceConfigured(spm.spmConfigSet.spmLowVoltagePowerInfo)-»
				/* Check if the LVOptmzerChk Application Interface ID profile needs to handled. */
				Spm_LowVoltLVOptmzerChkApplicationInterfaceID_PeriodicCheck();
				/* Read the Low Voltage Priority level value */
				Spm_ReadLowVoltagePriorityStatus();
				/* REJECTED_LACK_OF_POWER recovery's handler */
				Spm_RecoveryHandler_RejectedLackOfPower();
		«ENDIF-»
				/* Read the incoming packet coming from other SM. */
				Spm_ReadIncoming_SM_Message();

				/* HNDLR: Error Handler PowerModeVehicle. */
				Spm_ErrorHandler_VehOff();

			«IF Spm_IsLowVoltPrioServiceConfigured(spm.spmConfigSet.spmLowVoltagePowerInfo)-»
				/* HNDLR: Error Handler Low Voltage Battery. */
				Spm_ErrorHandler_LowVoltageBattery();
			«ENDIF-»

				/*  HNLDR: Update Profile Status by Profile Status Manager. */
				Spm_DequeueReqActionHandler();

				/* HNDLR: check for the LossOfNode. */
				Sum_Spm_WriteLossofNode();

				/* HNDLR: check LossOf Communication with Requesting SM(s) [$Satisfies $DDS_SPM 0532] */
				Spm_LoC_wRequester_Handler();

				/* HNDLR: Start Deactivation Path. */
				Spm_FSMManger();

				/* HNDLR: function for calling the PowerOffDevice for the requested target device that are no longer needed (no power profile running). */
				Spm_SoftwMgr_PowerOffDevice_Handler();

				/* HNDLR: function to determine whether the target device is still a requester or not. */
				Spm_SoftwMgr_Requester_Handler();

				/* HNDLR: report local/remote request presence to SUSD */
				Spm_E0D7_RequestsHandler();

	«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
				/* HNDLR: function that increase the activity timers of the DID's records.*/
				(void)Sum_Spm_UpdateActivityTimerDID_E0DE_E0DF();
	«ENDIF-»
				/* Handler function for sending the Req Prof Activation Packet; */
				Spm_SoftwMgr_PopulateSMFrame();

				/* Update the stay awake timer */
				Spm_DecreaseStayAwakeTimer();
					
				/* Check whether the status of a service has changed; if so, handle communication with the Service Manager */
				if( Spm_SrvcMgrIf_RAM.isChanged )	
				{
					Spm_SrvcMgrIf_HandleSrvcMgrComm();
				} 
	«IF Spm_ExistMultipleVariantConfigured(spm) == true -»
			}
	«ENDIF -»

				/* [$Satisfies $DDS_SPM 0530] [$Satisfies $DDS_SPM 0639] [$Satisfies $DDS_SPM 0641] */
				/* PRQA S 3415 2 #  No side effect since the function is a getter. */
				if(( TRUE == Sum_Spm_Shutdown_Delay_Has_Expired() ) &&
				( FALSE == Spm_GetOwnwakeUpBit() ) &&
				( 0u == Spm_GetNotInactiveLocalProfNumberForHB()) &&
				( Spm_IsStayAwakeTimerActive() == FALSE )
				«IF Spm_IsThereAnyManagedDevice(spm) && (Spm_ECU_INTERMEDIATE(spm) == true) -»
				&& (Spm_IsTargetDeviceRequestedByRemote() == FALSE)
				«ENDIF-»
				){
					SpmCtrl_Status = Spm_PrepareToShutdown;
				}

				break;
			}
			/* SPM Module is not requested */
			case Spm_PrepareToShutdown:
			{		
				/* Evaluate full-scale HB condition only during shutdown preparation. */
				Sum_Spm_CheckHBCounterShallBeSentFullScale(Spm_allowed);
				Spm_ShutdownRollingCounter = 0xFFU;

				/* Handle PrepareToShutdown state logic */
				Spm_HandleInitAndShutdownState(Spm_allowed);

				break;
	      	}
			case Spm_Initialized:
			{
				/* Handle Init state logic */
				Spm_HandleInitAndShutdownState(Spm_allowed);

				break;
			}
	      	default:
			{
				/* Nothing to do */
				break;
			}
		}

		(void)Rte_Write_PP_SPM_SUSD_ShutDown_SUSD_UserRequest( Spm_ShutdownRollingCounter );
	}
}
