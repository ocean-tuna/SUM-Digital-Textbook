«IF spm.spmConfigSet.spmPowPrf.select(e|e.spmProfileIsLocal == false).size > 0-»
/**
 * @brief Retrieves Service Discovery (SD) service configuration parameters.
 *
 * This function searches for the SD service configuration that matches the provided
 * profile service ID and instance ID. It determines the appropriate SD instance ID
 * and major version based on the extended learning table format setting.
 *
 * The function performs the following operations:
 * 1. **Validates input parameters:**
 *    - Checks that output pointers are not NULL.
 * 2. **Checks extended learning table format:**
 *    - If enabled, searches through the SD service configuration table for a matching entry.
 * 3. **Returns configuration or defaults:**
 *    - If a match is found, returns the configured SD instance ID and first major version.
 *    - If no match is found or extended format is disabled, returns default values (0).
 *
 * @param[in]  profServiceId   The service ID from the power profile.
 * @param[in]  profInstanceId  The instance ID from the power profile.
 * @param[out] sdInstanceId    Pointer to store the retrieved SD instance ID.
 * @param[out] majorVersion    Pointer to store the retrieved major version.
 *
 * @return void
 *
 * @note This function assumes the existence of:
 *       - SchM_CData_Sd_SdEnableExtendedLearningTableFormat() function
 *       - Spm_SdServiceConfig[] configuration array
 *       - SPM_SD_CLIENT_SERVICE_CONFIG_NUM constant
 */
static void Spm_GetSdServiceConfig(uint16 profServiceId, uint16 profInstanceId, uint16 *sdInstanceId, uint8 *majorVersion) {
	uint16 i;
	boolean cfgFound = FALSE;

	if((sdInstanceId != NULL_PTR) && (majorVersion != NULL_PTR)) {
		/* Check the status of the extendedFlag in the Sd to determine instance Id and major version */
		if (SchM_CData_Sd_SdEnableExtendedLearningTableFormat() == TRUE) {
			/* Search for matching service configuration for current profile */
			for(i = 0u; ((cfgFound == FALSE) && (i < SPM_SD_CLIENT_SERVICE_CONFIG_NUM)); i++) {
				if((Spm_SdServiceConfig[i].serviceId == profServiceId) &&
				   (Spm_SdServiceConfig[i].instanceId == profInstanceId)) {
					cfgFound = TRUE;
					*sdInstanceId = Spm_SdServiceConfig[i].instanceId;
					/* Use first major version if multiple versions available (to be updated in future) */
					*majorVersion = Spm_SdServiceConfig[i].majorVersions[0];
				}
			}
		}

		/* If no configuration found (or if Sd extendedFlag is FALSE),
		fall back to defaults */
		if(cfgFound == FALSE) {
			*sdInstanceId = 0u;
			*majorVersion = 0u;
		}
	}

}
«ENDIF-»
