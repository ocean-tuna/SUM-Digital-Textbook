/**
 * @brief Initializes the Software Power Manager (SPM) module.
 *
 * This function performs the following initialization steps:
 *
 * 1. **Initializes the request queue:**
 *    - Calls `SPM_InitQueue` to initialize the queue used for handling power profile requests.
 * 2. **Retrieves target device IPs for power profiles:**
 *    - Iterates through all configured power profiles (`SPM_CONF_POW_PRF_NUM`).
    - For each profile:
      - Extracts the service ID using `SPM_SRVCID_FROM_PRFID`.
      - Attempts to retrieve the target device IP (TrgDvcIP) of the service using `Sd_GetNodeAddress`.
      - If the IP retrieval fails or the retrieved IP is 0, marks the profile as local (`SPM_PrfStsMgr_RAM[i].TrgDvcIp = 0x00U`).
      - Otherwise, sets the profile's TrgDvcIP based on the retrieved value, indicating a remote profile.
      - Sets the initial activation state for the profile (`SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step`).
 * 3. **Retrieves working device IPs for target device IPs:**
 *    - Iterates through all possible outgoing power gates (`SPM_NUM_OF_PG_OUT_EDGE`).
    - For each combination:
      - Iterates through target device IPs in the Power Gate Table Translator (PGTT) of the working device.
      - If a target device IP from a power profile request matches the current target IP in the PGTT, sets the source device ID (PMSrcID) of the request to the working device IP.
      - This indicates that the target device is a subordinate of the working device.
    - If a match is found, stops searching for further matches for the current request.
 * 4. **Sets the module state:**
 *    - Sets the `SpmCtrl_Status` to `Spm_Initialized` to indicate successful initialization.
 *
 */
/* PRQA S 1505 1 # This runnable will be called by RTE */
«IF spm.spmGeneral.spmGenerateInitRunnable == true-»
static void SPM_Init(void){
«ELSE-»
void SPM_Init(void){
«ENDIF-»
	uint16 i;
	if(FALSE == SpmCtrl_Initilization_Status){

		Sum_Spm_VariantManagement_DataStructureInit();
		«IF Spm_ExistMultipleVariantConfigured(spm) == false -»
		Sum_Spm_DataStructurePopulation_WithoutVariant(); 
		«ELSE-»
		Sum_Spm_GetVariantId_DataStructurePopulation_WithVariant();
		«ENDIF-»

		SpmPgttRowEntry_CfgTable[0] = Rte_CData_TrgDvcs_«spm.spmConfigSet.spmPgttEntries.spmWkngDvc.shortName»();
		
		/* Init the periodicity of the WkUp Frame. */
		SPM_PM_Init_WkUpFrame_Period();

		/* Init the periodicity of the HB */
		SPM_PM_Init_HB_BurstPhase();

		/* ===============================================
				Init request queue
		   --------------------------------*/
		SPM_InitQueue( &Sum_Spm_RequestQueue );
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
		Spm_InitializeQueueDID_E0DE_E0DF();
«ENDIF-»
        
		SPM_PM_Init_ProfilesStructs();

		/* ====================================================================================================================
				Retrieve the WkngDvcIp for all the TrgDvcIp
		   -----------------------------------------------------*/
		for(i = 0U; i < SPM_NUM_OF_PG_OUT_EDGE; i++){
			Spm_PowMgr_TrgDvc_List[i].MonitoringTypeInfo.WkUpSeqHBState = FALSE;
			Spm_PowMgr_TrgDvc_List[i].MonitoringTypeInfo.DTCTImeoutTracker = SPM_GET_PGTT_INST_TIMEOUT( i ) / SUM_SPM_PERIOD_PM_MAINFUNCTION_MS;
			Spm_PowMgr_TrgDvc_List[i].IndexColumnInPgtt = (uint8)i;
			Spm_PowMgr_TrgDvc_List[i].WkUpSeqTypeInfo.PowerOnDeviceRetry_WaitTime = (uint16)(SPM_GET_PGTT_INST_POWERONDEVICERETRY_WAITTIME( i ) / SUM_SPM_PERIOD_PM_MAINFUNCTION_MS);
			Spm_PowMgr_TrgDvc_List[i].WkUpSeqTypeInfo.PowerOnDeviceRetry_Periodicity = (uint16)(SPM_GET_PGTT_INST_POWERONDEVICERETRY_PERIODICITY( i ) / SUM_SPM_PERIOD_PM_MAINFUNCTION_MS);
		}

		SpmCtrl_Status = Spm_Initialized;
		SpmCtrl_Initilization_Status = TRUE;
	}
}
