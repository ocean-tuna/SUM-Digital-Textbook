/**
 * @brief Helper function needed to set the variable Spm_HBCounterShallBeSentFullScale.
 *		  Sets the flag to TRUE if the shutdown target bit (bit 1) is 0.
 *		  This function is called only in PrepareToShutdown state.
 *
 * @retval None.
 *//*[$Satisfies $DDS_SPM 0652]*/
/* PRQA S 1532 2 # The function is defined here for modularity reason. */
static void Sum_Spm_CheckHBCounterShallBeSentFullScale(const SPM_PermitExecution Spm_allowed){
	const boolean target_is_off = ((Spm_allowed & SPM_SHUTDOWN_TARGET_BIT) == 0x00U);

	if (target_is_off) {
		Sum_Spm_SetHBCounterShallBeSentFullScale(TRUE);
	}
}

/**
 * @brief Set the SpmStayAwakeTimer to the predefined value.
 *
 * @retval None.
 */
static void Spm_StartStayAwakeTimer(void)
{
	SpmStayAwakeTimer = SPM_ERR_REQUESTER_TIMER_TICK;
}
/**
 * @brief Decrease the SpmStayAwakeTimer by one tick if it is greater than zero.
 *
 * @retval None.
 */
static void Spm_DecreaseStayAwakeTimer(void)
{
	if (SpmStayAwakeTimer > 0u) {
		SpmStayAwakeTimer--;
	}
}
/**
 * @brief Check if the SpmStayAwakeTimer is active.
 *
 * @retval TRUE: The timer is still active.
 *         FALSE: The timer is not active.
 */
static boolean Spm_IsStayAwakeTimerActive(void)
{
	return (SpmStayAwakeTimer > 0u) ? TRUE : FALSE;
}

/**
 * @brief Handles dequeued profile request actions.
 *
 * This function processes requests dequeued from the request queue (`Sum_Spm_RequestQueue`).
 *
 * 1. **Iterates through dequeued requests:**
 *    - Uses a loop (`while`) to continue processing as long as requests are successfully dequeued using `SPM_DequeueRequest`.
    - Each iteration retrieves the request information into the `Itm` struct.
 * 2. **Checks request type:**
 *    - Compares the `reqCode` in the request to `SPM_ACT_REQ` (activation request).
      - If it's an activation request:
        - Calls `Spm_RequesterList_ActivationRequestHandler` to add the requester address (`Itm.TrgDvcIpRequester`) to the request list associated with the specified profile (using `SPM_PrfStsMgr_RAM[Itm.posOfPrfInCfgArray].reqLst`).
      - Otherwise (deactivation request):
        - Calls `Spm_RequesterList_DeactivationRequestHandler` to remove the requester address from the request list associated with the specified profile.
 */
void Spm_DequeueReqActionHandler(void){

	struct SPM_ProfileReqItm Itm;


	while(SPM_DequeueRequest(&Sum_Spm_RequestQueue, &Itm) != FALSE) {

		/* Check if it is a deactivation or activation item request. */
		if((Itm.reqCode & 1u) == SPM_ACT_REQ){

			/** Just add reqAddr to the buff list. */
			/* [$Satisfies $DDS_SPM 0014] *//* [$Satisfies $DDS_SPM 0015] *//* [$Satisfies $DDS_SPM 0016] */
			Spm_RequesterList_ActivationRequestHandler( &(SPM_PrfStsMgr_RAM[Itm.posOfPrfInCfgArray].reqLst), Itm);

		}else{
			/* Just delete the reqAddr from the list. */
			/* [$Satisfies $DDS_SPM 0014] *//* [$Satisfies $DDS_SPM 0032] *//* [$Satisfies $DDS_SPM 0036] */
			Spm_RequesterList_DeactivationRequestHandler(&(SPM_PrfStsMgr_RAM[Itm.posOfPrfInCfgArray].reqLst), Itm);
		}

	}
}

/**
 * @brief Retrieve the device power state information for a specific device.
 *
 * 	This function retrieves the power state information (`Spm_DvcPwrSt`) for a specific target device identified
 *   by its IP address (`TrgDvcIp`)
 *
 * 1. **Retrieves target device index:**
 *    - Calls `Spm_GetIndexTrgDvcFromIP()` to obtain the index of the target device in the configuration list.
 * 2. **Validates the index:**
 *    - Checks if the returned index is valid (not equal to `SPM_INVALID`).
 * 3. **Return value:**
 *    - if the device is found, then the IndexOfTrgDvc is valid, returns the power state of the corresponding device retrieved from
 * `	Spm_DvcPwrSt->Spm_TrgDvcState[IndexOfTrgDvc]`.
 *    - If the device IP is not found in the configuration (index is `SPM_INVALID`), it returns the default value SPM_UnknownDevice`.
 *
 * @param TrgDvcIp     The IP address of the target device.
 * @param Spm_DvcPwrSt A pointer to the device power state information structure.
 *
 * @return SpmDevicePowerStateCode 		The power state of the target device found, otherwise  SPM_UnknownDevice(0xFEu) .
 */
/* PRQA S 1532 1 # The function is defined here for modularity reason. */
SpmDevicePowerStateCode Spm_DevicePowerStateParser(const uint32 TrgDvcIp, Spm_DevicePowerStateInfo const * Spm_DvcPwrSt){
	
	SpmDevicePowerStateCode ret;
	sint16 IndexOfTrgDvc;

	/* Search for the Target device index based on the IP address. */
	IndexOfTrgDvc = Spm_GetIndexTrgDvcFromIP(TrgDvcIp);

	if(IndexOfTrgDvc != SPM_INVALID){
		/* PRQA S 4342 1 # Cast needed since the RTE uses the uint8 type for device power states. */
		ret = (SpmDevicePowerStateCode) Spm_DvcPwrSt->Spm_TrgDvcState[IndexOfTrgDvc];
	}else{
		ret = SPM_UnknownDevice;
	}

	return ret;
}

/**
 * @brief Writes information about loss of nodes to the RTE.
 *
 * This function monitors changes in the power state of target devices and reports them as loss-of-node indications to the RTE.
 *
 * 1. **Initializes variables:**
 *    - Declares a static array `Spm_StateOld` to store previous power states of target devices, initialized with `SPM_Off` for all entries.
 *    - Declares arrays `Spm_ListOfDtc` and `Spm_ListOfState` to store data to be written.
 *    - Declares variables `i`, `Spm_BufferRead`, and `Spm_DataToWrite` for loop control and data storage.
 * 2. **Reads device power states:**
 *    - Calls `Rte_IrvRead_RE_SPM_SoftMgr_MainFunction_Spm_DevicePowerState` to read the latest device power state information and stores it in `Spm_BufferRead`.
 * 3. **Prepares data to write:**
 *    - Initializes the `nodeListLength` member of `Spm_DataToWrite` to 0.
 * 4. **Iterates through target devices:**
 *    - Uses a loop (`i`) to iterate through all possible target devices (`SPM_NUM_OF_PG_OUT_EDGE`).
 *    - For each device:
      - Calculates `trs_toOkToFault_` to indicate a transition from non-faulted to faulted state.
      - Calculates `trs_fromFault_` to indicate a transition from faulted to `SPM_On` state.
      - If either transition condition is met:
        - Adds the device ID (using `Sum_Spm_GetDTCId`) and corresponding state information (0x01U for transition to faulted, 0x00U for transition from faulted) to the respective lists in `Spm_DataToWrite`.
        - Increments `nodeListLength` to indicate the number of entries added.
 * 5. **Writes data if available:**
 *    - Checks if `Spm_DataToWrite.nodeListLength` is greater than 0 (i.e., there are entries to write).
 *    - If there is data to write:
      - Calls `Rte_Write_PP_SPM_SerDatMon_LoNInd_LossOfNodeIndication` to write the `Spm_DataToWrite` structure to the RTE.
      - Copies the newly read device states from `Spm_BufferRead` to `Spm_StateOld` to update the stored previous states.
 *
 * @note This function relies on the `Sum_Spm_GetDTCId` function to retrieve device IDs.
 */
static void Sum_Spm_WriteLossofNode(void){

	static SpmDevicePowerStateCode Spm_StateOld[SPM_NUM_OF_PG_OUT_EDGE] = {
«FOREACH spm.spmConfigSet.spmPgttEntries.spmTrgDvc AS pp-»
		SPM_Off,
«ENDFOREACH»
	};

	uint16 Spm_ListOfDtc[SPM_NUM_OF_PG_OUT_EDGE];
	NodeStatusType Spm_ListOfState[SPM_NUM_OF_PG_OUT_EDGE];
	uint8 i;
	Spm_DevicePowerStateInfo Spm_BufferRead;

	SPM_LossOfNodeIndicationType Spm_DataToWrite;

	boolean trs_toOkToFault_;
	boolean trs_fromFault_;

	/* [$Satisfies $DDS_SPM 0204] */
	Rte_IrvRead_RE_SPM_SoftMgr_MainFunction_Spm_DevicePowerState(&Spm_BufferRead);

	Spm_DataToWrite.nodeListLength = 0U;

	for(i = 0U; i < SPM_NUM_OF_PG_OUT_EDGE; i++){

		trs_toOkToFault_ = (Spm_StateOld[i] != SPM_Faulted) && (Spm_BufferRead.Spm_TrgDvcState[i] == (uint8)SPM_Faulted);
		trs_fromFault_ = (Spm_StateOld[i] == SPM_Faulted) && (Spm_BufferRead.Spm_TrgDvcState[i] == (uint8)SPM_On);

		if( (trs_toOkToFault_) || (trs_fromFault_) ){
			/* [$Satisfies $DDS_SPM 0200] *//* [$Satisfies $DDS_SPM 0202] */
			Spm_ListOfDtc[Spm_DataToWrite.nodeListLength] = SPM_GET_PGTT_INST_TRGDVC_DTCID(i);
			/* GDT - 135 */
			Spm_ListOfState[Spm_DataToWrite.nodeListLength] = ( (trs_toOkToFault_) ? 0x00u : 0x01u );
			(Spm_DataToWrite.nodeListLength)++;

		}

		/* PRQA S 4442 1 # Cast needed since the RTE generates the unsigned char type.  */
		Spm_StateOld[i] = Spm_BufferRead.Spm_TrgDvcState[i];

	}

	if(Spm_DataToWrite.nodeListLength > 0U){
		Spm_DataToWrite.nodeDtcCodeValue = Spm_ListOfDtc;
		Spm_DataToWrite.nodeStatus = Spm_ListOfState;
		/* [$Satisfies $DDS_SPM 0202] *//* [$Satisfies $DDS_SPM 0203] */
		(void)Rte_Write_PP_SPM_SerDatMon_LoNInd_LossOfNodeIndication(&Spm_DataToWrite);
	}

}


/**
 * @brief This function check if there is any requesters for profiles located on
 * that target device index.
 *
 * @param TrgDvcIndex Index of the TrgDvc.
 *
 * @return TRUE: if there is at least one profile requested on that TargetDevice
 * 		   FALSE: otherwise
 */
static boolean Spm_GetIfProfileRunningOnRemoteTrgDvc_Handler(const uint8 TrgDvcIndex){
	boolean ProfRunningOnTrg = FALSE;
	boolean temp;
	uint8 j;

	for(j = 0u; j < SPM_GET_PGTT_INST_NUMBER_IP_ASSOCIATED(TrgDvcIndex); j++){
		temp = Spm_GetIfProfileRunningOnRemoteTrgDvc(SPM_GET_PGTT_INST_TRGDVCIP( TrgDvcIndex, j ));
		ProfRunningOnTrg = ( ProfRunningOnTrg || temp );
	}

	return ProfRunningOnTrg;
}

/**
 * @brief Handles the power-off requests for the requested target devices.
 *
 * This function checks if any remote profile are running on our requested Target device.
 * If the Target device is no longer needed, because there is no remote profile running on it, the PowerOffDevice() is triggered.
 *
 */
/* [$Satisfies $DDS_SPM 0039] */ /* [$Satisfies $DDS_SPM 0205]*/
static void Spm_SoftwMgr_PowerOffDevice_Handler(void){

	uint8 i;

	for(i = 0u; i < SPM_NUM_OF_PG_OUT_EDGE; i++){
		/*Check that there are no power profiles running on the requested target device in order to Power Off that specific Target device. */
		if( (Sum_Spm_IsRequested(i) == TRUE)){
			if(Spm_GetIfProfileRunningOnRemoteTrgDvc_Handler(i) == FALSE){
				(void)Spm_PowerOffDevice(SPM_GET_PGTT_INST_TRGDVCIP( i, 0u));
			}
		}
	}

}

/**
 * @brief Check if a target device IP has an active request in a specific power profile
 *
 * @param powProfIndex Index of the power profile to check
 * @param TrgDvcIpAss IP address of the target device to search
 * @return TRUE if an active request exists, FALSE otherwise
 *
 */
static boolean Spm_HasActiveRequestFromRequester(const uint8 powProfIndex, uint32 TrgDvcIpAss){

	uint16 reqIndex;
	boolean activeReqFound = FALSE;
	/* Iterate over the requesters of the local power profile */
	for (reqIndex = 0U; ((reqIndex <  SPM_PrfStsMgr_RAM[powProfIndex].reqLst.size) && (activeReqFound == FALSE)); reqIndex++) {

		/* Check if the requester is present in the requesterList with a valid request type (not DEACTIVATION or NULL) */
		if ((SPM_PrfStsMgr_RAM[powProfIndex].reqLst.spmReqLst[reqIndex].requesterIP == TrgDvcIpAss) &&
		    (SPM_PrfStsMgr_RAM[powProfIndex].reqLst.spmReqLst[reqIndex].ReqType != SPM_REQ_DEACTIVATION) &&
		    (SPM_PrfStsMgr_RAM[powProfIndex].reqLst.spmReqLst[reqIndex].ReqType != SPM_NULL_REQ)) {
			/* Found an active request for this target device IP */
			activeReqFound = TRUE;
		}
	}

	return activeReqFound;
}


/**
 * @brief Handle and validate requester bit status for all the target devices
 *
 * This function checks if target devices, marked as requesters, have active requests in local power profiles.
 * If the device has at least one active request, it will remain marked as a requester. Otherwise, if no active requests
 * are found, the requester status is reset.
 *
 * @param void
 * @return void
 *//*[$Satisfies $DDS_SPM 0205]*/
static void Spm_SoftwMgr_Requester_Handler(void){
	uint8 IndexOfTrgDvc;
	uint8 powProfIndex;
	uint8 numIpAss;
	uint32 TrgDvcIpAss;
	/* */
	boolean foundActiveRequest;

	/*Iteration over the Target devices configured */
	for(IndexOfTrgDvc = 0U; IndexOfTrgDvc < SPM_NUM_OF_PG_OUT_EDGE; IndexOfTrgDvc++){
		/* Check if the target device is marked as a requester */
		if(Sum_Spm_IsRequester((uint8)IndexOfTrgDvc) == TRUE){
			/* Assume no active requests until we find at least one */
			foundActiveRequest = FALSE;

			/* Iterate over local power profiles as long as there is no active request */
			for(powProfIndex = 0u; (powProfIndex < SPM_CONF_POW_PRF_NUM) && (foundActiveRequest == FALSE); powProfIndex++){
				/* Check if the profile is a local power profile */
				if (SPM_GET_PROF_IS_LOC_FROM_CONF(powProfIndex) == TRUE)
				{
					/* Check all IPs associated with the current target device */
					for(numIpAss = 0u; numIpAss < SPM_GET_PGTT_INST_NUMBER_IP_ASSOCIATED(IndexOfTrgDvc); numIpAss++){
						/* Retrieve the IP associated to the current Target Device */
						TrgDvcIpAss = SPM_GET_PGTT_INST_TRGDVCIP(IndexOfTrgDvc, numIpAss);

						/* Check if this IP has an active request in the current power profile */
						if (Spm_HasActiveRequestFromRequester(powProfIndex, TrgDvcIpAss) == TRUE)
						{
							/* Active request found, so the device is a valid requester */
							foundActiveRequest = TRUE;
							break; /* no need to check other IPs for this profile */
						}
					} /* END ITERATION OVER IPs ASSOCIATED TO THE TARGET DEVICE */
				}
			} /* END ITERATION FOR THE CONFIGURED POWER PROFILES */

			/* No active requests found: Reset the requester bit for the target device. Otherwise, no action needed ( it's a requester) */
			if (foundActiveRequest == FALSE){

				Sum_Spm_ResetAsRequester((uint8)IndexOfTrgDvc);
			}
		}
	} /* END ITERATION FOR THE TARGET DEVICES */
}



/**
 * @brief Manages the state machine of power profiles.
 *
 *
 * @note This function assumes the existence of functions and data structures to
 *       manage power profile states, requesters, and state machine transitions.
 */
void Spm_FSMManger(void){

	uint8 i;

	for( i = 0U; i < SPM_CONF_POW_PRF_NUM; i++){

		if(SPM_GET_PROF_IS_LOC_FROM_CONF(i) == TRUE){
			Spm_LocalPowerProfile_FSM(i);
		}else{
			Spm_RemotePowerProfile_FSM(i);
		}
	}
}

/**
 * @brief Handles the Initialized and PrepareToShutdown states logic.
 *
 * This function manages the transition :
 *  * from Initialized state to Running state when permit execution is granted
 *  * in PrepareToShutdown state and handles the shutdown ready signal (0xFE) when all final heartbeats are transmitted 
 *    during PrepareToShutdown.
 *
 * @param[in] Spm_allowed The permit execution status from SUSD
 *//*[$Satisfies $DDS_SPM 0651]*/
static void Spm_HandleInitAndShutdownState(const SPM_PermitExecution Spm_allowed){
	
	/* Transition from Initialized state to running state when permit execution is granted */
	if(((Spm_allowed | SPM_PERMIT_EXEC_MASK) == SPM_EXEC_MASK_PASSED ) && (SpmCtrl_Status == Spm_Initialized)) {
		/* Reset final heartbeat sent flag */
		Sum_Spm_Set_FinalHeartbeatSent(FALSE);
		/* Reset HB counter flag when returning to running */
		Sum_Spm_SetHBCounterShallBeSentFullScale(FALSE);
		/* Initializes the the SPM's Initial Shutdown Delay timer state to "not expired" */
		Sum_Spm_Set_Shutdown_Delay_Timer_Expire_State(FALSE);
		/* [$Satisfies $DDS_SPM 0415] */
		SpmCtrl_Status = Spm_Running;
	}
	else if( SpmCtrl_Status == Spm_PrepareToShutdown ) {
		/* Check if final heartbeat has been sent */
		if(Sum_Spm_IsFinalHeartbeatSent()) {
			/* All final heartbeat messages are transmitted, set SPM_Shutdown_ready */
			Spm_ShutdownRollingCounter = 0xFEU; /* SPMShutdown_ready */
		}
	}
	else
	{
		/* Do nothing */
	}
}

/**
 * @brief Count how many local profile are NOT in inactive state.
 *
 * @return The number of local profiles NOT in inactive state.
 */
/* [$Satisfies $DDS_SPM 0310] */
/* PRQA S 1532 2 # Function defined here for modularity reason */
uint16 Spm_GetNotInactiveLocalProfNumberForHB(void){
	uint16 i;
	uint16 counter = 0u;

	for(i = 0u; i < SPM_CONF_POW_PRF_NUM; i++){
		if((SPM_GET_PROF_IS_LOC_FROM_CONF(i) == TRUE) && (SPM_PrfStsMgr_RAM[i].sm != SPM_Inactive)){
			counter++;
		}
	}

	return counter;
}
