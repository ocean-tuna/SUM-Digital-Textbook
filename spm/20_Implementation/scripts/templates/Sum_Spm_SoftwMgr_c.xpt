/**
 * @brief function that deactivates a profiles as
 *        Shutdown Detected reason.
 *
 * @return void
 */
 /* [$Satisfies $DDS_SPM 0538] */
static void Spm_ErrorHandler_ShutdownDetected(void){

	uint32 powProfIndex;
	uint8 itm;
	for(powProfIndex = 0u; powProfIndex < SPM_CONF_POW_PRF_NUM; powProfIndex++)
	{
		if(SPM_GET_PROF_IS_LOC_FROM_CONF(powProfIndex) == TRUE)
		{
			for(itm = 0u; itm < SPM_PrfStsMgr_RAM[powProfIndex].reqLst.size; itm++)
			{
				SPM_PrfStsMgr_RAM[powProfIndex].reqLst.spmReqLst[itm].ReqType = SPM_NULL_REQ;
			}
			/*Call the FSM function to deactivate the service*/
			Spm_LocalPowerProfile_FSM(powProfIndex);
		}
	}

}

«IF Spm_IsThereAnyManagedDevice(spm) && (Spm_ECU_INTERMEDIATE(spm) == true) -»
/**
 * @brief  Checks if any target device in the Power Graph Traversal Table has been requested by a remote node.
 *
 * @return boolean
 */

static boolean Spm_IsTargetDeviceRequestedByRemote(void) {
	uint8 trg_id;
	boolean RequestedByRemote = FALSE;

	for(trg_id = 0U; trg_id < SPM_NUM_OF_PG_OUT_EDGE; trg_id++)
	{
		if ((Spm_PowMgr_TrgDvc_List[trg_id].SpmTrgDevInfo.trgHndl_p != NULL_PTR )&&
            (Spm_PowMgr_TrgDvc_List[trg_id].SpmTrgDevInfo.TargetDevicerequestedByRemote == TRUE))
		{
            RequestedByRemote = TRUE;
        }
	}

	return RequestedByRemote;
}
«ENDIF-»

