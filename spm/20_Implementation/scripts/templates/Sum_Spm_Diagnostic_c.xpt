«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Function that checks if an item with specific ServiceId and ProfNumber is present in a deque.
 *
 * @param  deque: Pointer to the deque to search in.
 * @param  serviceId: Service ID to search for.
 * @param  profNumber: Profile Number to search for.
 * @param  position: Pointer to store the position if item is found.
 *
 * @return E_OK: Item found, position stored in *position parameter.
 * @return E_NOT_OK: Item not found or invalid parameters.
 */
static Std_ReturnType Spm_FindItemByServiceIdAndProfNumber(const Sum_Algo_Deque* deque, uint16 serviceId, uint8 profNumber, uint8* position)
{
    Std_ReturnType returnValue = E_NOT_OK;
    uint8 i;
    uint8 queueSize;
    boolean itemFound = FALSE;

    if ((deque != NULL_PTR) && (position != NULL_PTR)) {
        queueSize = (uint8)Sum_Algo_Deque_Size(deque);

        /* Search through all items in the deque until item is found */
        for (i = 0u; (i < queueSize) && (itemFound == FALSE); i++) {
            SpmDiagActivatedProfileStruct tempItem;
            if (Sum_Algo_Deque_GetAt(deque, i, &tempItem) == E_OK) {
                if ((tempItem.ServiceId == serviceId) && (tempItem.ProfNumber == profNumber)) {
                    *position = i;
                    returnValue = E_OK;
                    itemFound = TRUE;
                }
            }
        }
    }

    return returnValue;
}
«ENDIF-»
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Function that adds an item to a deque using FIFO behavior. If the deque is full,
 *        it overwrites the oldest item (removes from front and adds to back).
 *
 * @param  deque: Pointer to the deque to add the item to.
 * @param  element: Pointer to the element to add.
 *
 * @return E_OK: Item added successfully (either to empty space or overwriting oldest).
 * @return E_NOT_OK: Invalid parameters.
 */
static Std_ReturnType Spm_AddItemToFifoQueue(Sum_Algo_Deque* deque, const SpmDiagActivatedProfileStruct* element)
{
    Std_ReturnType returnValue = E_NOT_OK;

    if ((deque != NULL_PTR) && (element != NULL_PTR)) {
        /* Check if queue is full */
        if (Sum_Algo_Deque_IsFull(deque) == TRUE) {
            /* Queue is full - remove oldest item (from front) to make space */
            SpmDiagActivatedProfileStruct tempBuffer;
            (void)Sum_Algo_Deque_PopFront(deque, &tempBuffer); /* Discard oldest item */
        }

        /* Add new item to back of queue (FIFO) */
        returnValue = Sum_Algo_Deque_PushBack(deque, element);
    }

    return returnValue;
}
«ENDIF-»
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Core function that checks if a profile is inactive and updates its position in the queue if needed.
 *
 * This function checks if a profile identified by serviceId and profNumber is currently inactive.
 * If the profile is inactive, it removes the item from its current position in the queue,
 * increments the ActivationCount, and pushes it back to the end of the queue (FIFO behavior).
 * If the profile is active, no update is performed (or only IP update for remote profiles).
 *
 * @param  deque: Pointer to the deque (E0DE or E0DF).
 * @param  serviceId: Service ID of the profile to check.
 * @param  profNumber: Profile number to check.
 * @param  position: Current position of the item in the queue.
 * @param  isLocalQueue: TRUE for E0DE queue (locally activated), FALSE for E0DF queue (remotely activated).
 * @param  lastByteIP: Last byte IP of the requester (only used for remote profiles).
 *
 * @return E_OK: Item successfully updated or no update needed (profile is active).
 * @return E_NOT_OK: Failed to update the item in the queue.
 */
static Std_ReturnType Spm_CheckAndUpdateProfileAtPosition(Sum_Algo_Deque* deque, const uint16 serviceId, const uint8 profNumber, const uint8 position, const boolean isLocalQueue, const uint8 lastByteIP)
{
    Std_ReturnType returnValue = E_NOT_OK;
    
    if (deque != NULL_PTR) {
        if (Spm_GetItemIsInactive(serviceId, profNumber) == TRUE) {
            SpmDiagActivatedProfileStruct tempItem;
            
            /* Remove item from the queue */
            if (Sum_Algo_Deque_PopAtPosition(deque, position, &tempItem) == E_OK) {
                /* [$Satisfies $DDS_SPM 0632] */
                /* PRQA S 2983 2 # tempItem will be used to update the queue by Sum_Algo_Deque_SetAt. */
                /* Increment activation count */
                tempItem.ActualPowerOffRecords.ActivationCount++;
                /* PRQA S 2983 2 # tempItem will be used to update the queue by Sum_Algo_Deque_SetAt. */
                /* Update last byte IP (will be 0 for local profiles) */
                tempItem.LastByteIPRequester = lastByteIP;
                /* Push back to end of queue */
                returnValue = Sum_Algo_Deque_PushBack(deque, &tempItem);
            }
        } else {
            /* Profile is active */
            if (isLocalQueue == TRUE) {
                /* For local request, no update needed */
                returnValue = E_OK;
            } else {
                «IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
                /* For remote request, update the IP */
                returnValue = Spm_UpdateRemotelyActivatedLastByteIPRequester(position, lastByteIP);
                «ENDIF-»
            }
        }
    }
    
    return returnValue;
}
«ENDIF-»
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
/**
 * @brief Checks if a locally activated profile is inactive and updates its position in the queue if needed.
 *
 * @param  serviceId: Service ID of the profile to check.
 * @param  profNumber: Profile number to check.
 * @param  localPosition: Current position of the item in the E0DE queue.
 *
 * @return E_OK: Item successfully updated or no update needed (profile is active).
 * @return E_NOT_OK: Failed to update the item in the queue.
 */
static Std_ReturnType Spm_CheckAndUpdateLocallyActivatedProfile(const uint16 serviceId, const uint8 profNumber, const uint8 localPosition)
{
    return Spm_CheckAndUpdateProfileAtPosition(&Sum_Spm_DID_E0DE_Queue, serviceId, profNumber, localPosition, TRUE, 0u);
}
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Checks if a remotely activated profile is inactive and updates its position in the queue if needed.
 *
 * @param  serviceId: Service ID of the profile to check.
 * @param  profNumber: Profile number to check.
 * @param  remotePosition: Current position of the item in the E0DF queue.
 * @param  lastByteIP: Last byte IP of the requester to update.
 *
 * @return E_OK: Item successfully updated or IP updated (if profile is active).
 * @return E_NOT_OK: Failed to update the item in the queue.
 */
static Std_ReturnType Spm_CheckAndUpdateRemotelyActivatedProfile(const uint16 serviceId, const uint8 profNumber, const uint8 remotePosition, const uint8 lastByteIP)
{
    return Spm_CheckAndUpdateProfileAtPosition(&Sum_Spm_DID_E0DF_Queue, serviceId, profNumber, remotePosition, FALSE, lastByteIP);
}
«ENDIF-»
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Function the Power Profile Status.
 *
 * @param  ServiceID: Service ID of the profile to look for.
 * @param  ProfileNumber: Profile number of the profile to look for.
 *
 * @return TRUE: the profile is active.
 *         FALSE: otherwise
 */
/* [$Satisfies $DDS_SPM 0627] [$Satisfies $DDS_SPM 0628] [$Satisfies $DDS_SPM 0629] [$Satisfies $DDS_SPM 0637] [$Satisfies $DDS_SPM 0638] */
static boolean Spm_GetItemIsInactive(const uint16 ServiceID, const uint8 ProfileNumber){

    uint16 index;
    boolean checkRet = Spm_GetPowProfIndexFromProfIDProfNumber(ServiceID, ProfileNumber, &index);
    boolean ret = FALSE;

    if((checkRet == TRUE) && (SPM_PrfStsMgr_RAM[index].sm == SPM_Inactive)){
        ret = TRUE;
    }

    return ret;
}
«ENDIF-»
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Function the Power Profile Status.
 *
 * @param  ServiceID: Service ID of the profile to look for.
 * @param  ProfileNumber: Profile number of the profile to look for.
 *
 * @return TRUE: the profile is active.
 *         FALSE: otherwise
 */
/* [$Satisfies $DDS_SPM 0627] [$Satisfies $DDS_SPM 0628] [$Satisfies $DDS_SPM 0629] [$Satisfies $DDS_SPM 0637] [$Satisfies $DDS_SPM 0638] */
static boolean Spm_GetItemNeedActivityTimerUpdate(const uint16 ServiceID, const uint8 ProfileNumber){

    uint16 index;
    boolean checkRet = Spm_GetPowProfIndexFromProfIDProfNumber(ServiceID, ProfileNumber, &index);
    boolean ret = FALSE;

    if((checkRet == TRUE) && (SPM_PrfStsMgr_RAM[index].sm == SPM_Activated)){
        ret = TRUE;
    }

    return ret;
}
«ENDIF-»
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Function that increments the ActivityTimerInTick of ActualPowerOffRecords for an item at a specific position in the queue.
 *
 * @param  deque: Pointer to the deque containing the item.
 * @param  position: Position of the item in the queue.
 *
 * @return E_OK: ActivityTimerInTick incremented successfully.
 * @return E_NOT_OK: Invalid parameters or position out of bounds.
 */
static Std_ReturnType Spm_IncrementActivityTimerAtPositionIfProfileIsActive(Sum_Algo_Deque* deque, uint8 position)
{
    Std_ReturnType returnValue = E_NOT_OK;

    if (deque != NULL_PTR) {
        SpmDiagActivatedProfileStruct tempItem;

        /* Get the item from the queue */
        if (Sum_Algo_Deque_GetAt(deque, position, &tempItem) == E_OK) {


            if(TRUE == Spm_GetItemNeedActivityTimerUpdate(tempItem.ServiceId, tempItem.ProfNumber)){
                /* Increment the ActivityTimerInTick */
                /* PRQA S 2983 1 # tempItem will be used to update the queue by Sum_Algo_Deque_SetAt. */
                tempItem.ActualPowerOffRecords.ActivityTimerInTick++;

                /* Set the modified item back to the queue */
                returnValue = Sum_Algo_Deque_SetAt(deque, position, &tempItem);
            }

        }
    }

    return returnValue;
}
«ENDIF-»
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Checks if SUSD allows data updates and we're in PowerOff session
 *
 * @return TRUE if updates are allowed, FALSE otherwise
 */
/* [$Satisfies $DDS_SPM 0627] [$Satisfies $DDS_SPM 0628] [$Satisfies $DDS_SPM 0629]
   [$Satisfies $DDS_SPM 0631] [$Satisfies $DDS_SPM 0637] [$Satisfies $DDS_SPM 0638] */
static boolean Spm_IsQueueUpdateAllowed(void)
{
    /* Check if the actual VehiclePowerMode is different from Propulsion. */
    boolean VehPowModeConditionSatisfied = Spm_GetVehPowModeConditionSatisfiedForDID();

    /* Check if SUSD informed we can update data */
    Spm_E0D7ActiveStatusType e0d7Status = Rte_IrvRead_RE_SPM_SoftMgr_MainFunction_Spm_E0D7ActiveStatus();

    return ((e0d7Status == E0D7_ACTIVE) && (VehPowModeConditionSatisfied == TRUE));
}

«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Creates a new profile request with default values
 *
 * @param[out] item Pointer to store the initialized profile
 * @param[in] serviceId Service ID for the profile
 * @param[in] profNumber Profile number for the profile
 * @param[in] lastByteIP Last byte IP of the requester (0 for local profiles)
 *
 */
static void Spm_InitializeRequest(SpmDiagActivatedProfileStruct* item, const uint16 serviceId, const uint8 profNumber, const uint8 lastByteIP)
{

    /* Initialize with provided ServiceId and ProfNumber */
    item->ServiceId = serviceId;
    item->ProfNumber = profNumber;
    item->LastByteIPRequester = lastByteIP;

    /* Initialize records */
    item->ActualPowerOffRecords.ActivationCount = 1u;  /* Start with 1 activation */
    item->ActualPowerOffRecords.ActivityTimerInTick = 0u;

    return;
}
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral) && GetDIDE0DEIsConfigured(spm.spmGeneral) -»
/**
 * @brief Transfers a profile from the remote queue to the local queue
 *
 * @param[in] serviceId Service ID of the profile
 * @param[in] profNumber Profile number of the profile
 * @param[in] remotePosition Position in the remote queue
 *
 * @return E_OK: Transfer completed successfully
 * @return E_NOT_OK: Transfer failed
 */
static Std_ReturnType Spm_TransferFromRemoteToLocal(const uint16 serviceId, const uint8 profNumber, const uint8 remotePosition)
{
    Std_ReturnType returnValue = E_NOT_OK;
    SpmDiagActivatedProfileStruct remoteItem;
    SpmDiagActivatedProfileStruct localItem;

    /* Get the remotely activated profile */
    if (Sum_Algo_Deque_GetAt(&Sum_Spm_DID_E0DF_Queue, remotePosition, &remoteItem) == E_OK) {
        /* Initialize the local profile */
        Spm_InitializeRequest(&localItem, serviceId, profNumber, 0u);

        /* PRQA S 2983 3 # tempItem will be used to update the queue by Sum_Algo_Deque_SetAt. */
        /* Copy ActivityTimerInTick and ActivationCount from remote profile */
        localItem.ActualPowerOffRecords.ActivityTimerInTick = remoteItem.ActualPowerOffRecords.ActivityTimerInTick;
        localItem.ActualPowerOffRecords.ActivationCount = remoteItem.ActualPowerOffRecords.ActivationCount;
        
        /* Add item to E0DE queue */
        if (Spm_AddItemToFifoQueue(&Sum_Spm_DID_E0DE_Queue, &localItem) == E_OK) {
            /* Remove item from E0DF queue. The remoteItem is passed for coherence with function prototype. */
            returnValue = Sum_Algo_Deque_PopAtPosition(&Sum_Spm_DID_E0DF_Queue, remotePosition, &remoteItem);
        }

    }

    return returnValue;
}
«ENDIF-»
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
/**
 * @brief Handles case when profile is not found in either queue
 *
 * @param[in] serviceId Service ID of the profile
 * @param[in] profNumber Profile number of the profile
 *
 * @return E_OK: Operation completed successfully
 * @return E_NOT_OK: Operation failed
 */
static Std_ReturnType Spm_HandleNewLocalRequest(const uint16 serviceId, const uint8 profNumber)
{
    Std_ReturnType returnValue;
    SpmDiagActivatedProfileStruct newItem;

    /* Initialize the new local request */
    Spm_InitializeRequest(&newItem, serviceId, profNumber, 0u);

    /* Add to E0DE queue */
    returnValue = Spm_AddItemToFifoQueue(&Sum_Spm_DID_E0DE_Queue, &newItem);

    return returnValue;
}
«ENDIF-»
