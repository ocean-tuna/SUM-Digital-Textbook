/**
 * @brief Function that handle the DID E0DD Activation Profile Activaiton Status.
 * «IF Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spm_DID_E0DD_ActivationProfileActivationStatus_DCM_Ref)-»
 * @param  OpStatus: Status
 * «ENDIF-»
 * @param  Data: Buffer to populate. Pointer to an array of 64 bytes.
 *
 * @return E_OK: Standard return value since this operation can not fail.
 */
/* PRQA S 1503 2 # This function will be called by the RTE. */
/* [$Satisfies $DDS_SPM 0626] */
Std_ReturnType Runnable_SPM_DID_E0DD_ActivationProfileActivationStatus(
«IF Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spm_DID_E0DD_ActivationProfileActivationStatus_DCM_Ref)-»
																		Dcm_OpStatusType OpStatus,
«ENDIF-»
	                                                                    uint8* Data)
{

	uint8 i;
«IF Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spm_DID_E0DD_ActivationProfileActivationStatus_DCM_Ref)-»
	SUM_SPM_UNUSED(OpStatus);
«ENDIF-»
	/* Initialization of the buffer received. */
	for(i = 0u; i < SUM_SPM_DID_E0DD_SIZE_BYTES; i++){
		Data[i] = 0u;
	}

	for(i = 0u; i < SPM_CONF_POW_PRF_NUM; i++){
		/* The particular bit SHALL be set to 1 if the state is NOT Inactive and the SpmProfBitMapIndex is configured. */
		if((SPM_PrfStsMgr_RAM[i].sm != SPM_Inactive) && (SPM_GET_BITMAPINDEX_FROM_CONF(i) != NULL_PTR)){
			Spm_DID_E0DD_SetBitToOne(&Data[0u], *(SPM_GET_BITMAPINDEX_FROM_CONF(i)));
		}
	}

	return E_OK;
}
