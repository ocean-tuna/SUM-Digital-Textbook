/**
 * @brief Handles local activation request and updates the diagnostic queues accordingly.
 *
 * @param[in] serviceId Service ID of the profile to activate
 * @param[in] profNumber Profile number to activate
 *
 * @return E_OK: Request processed successfully
 * @return E_NOT_OK: Request processing failed
 */
/* PRQA S 1532 3 # Defined here for modular reason. */
 /* [$Satisfies $DDS_SPM 0627] [$Satisfies $DDS_SPM 0628] [$Satisfies $DDS_SPM 0629]
    [$Satisfies $DDS_SPM 0630] [$Satisfies $DDS_SPM 0637] [$Satisfies $DDS_SPM 0638] */
Std_ReturnType Spm_HandleLocalActivationRequest(const uint16 serviceId, const uint8 profNumber)
{
    Std_ReturnType returnValue = E_NOT_OK;
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
    uint8 remotePosition;
«ENDIF-»
    uint8 localPosition;

    /* Check if SUSD allows updates and we're in PowerOff session */
    if (Spm_IsQueueUpdateAllowed() == TRUE) {
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
        /* Check if profile already present in E0DF queue (remotely activated) */
        if (Spm_FindItemByServiceIdAndProfNumber(&Sum_Spm_DID_E0DF_Queue, serviceId, profNumber, &remotePosition) == E_OK) {
            /* Transfer profile from remote to local queue */
            returnValue = Spm_TransferFromRemoteToLocal(serviceId, profNumber, remotePosition);
        }
«ENDIF»
        /* If not in remote queue or transfer failed, check if in local queue */
       «IF GetDIDE0DFIsConfigured(spm.spmGeneral)»
            else «ENDIF» if (Spm_FindItemByServiceIdAndProfNumber(&Sum_Spm_DID_E0DE_Queue, serviceId, profNumber, &localPosition) == E_OK) {
            /* Profile already in E0DE queue - check if it needs an update */
            returnValue = Spm_CheckAndUpdateLocallyActivatedProfile(serviceId, profNumber, localPosition);
        }
        /* Profile not found in either queue - add new entry */
        else {
            returnValue = Spm_HandleNewLocalRequest(serviceId, profNumber);
        }
    }

    return returnValue;
}
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Create a new item and enqueue in the E0DF queue.
 *
 * @param[in] serviceId Service ID of the profile
 * @param[in] profNumber Profile number of the profile
 * @param[in] lastByteIP Last byte IP of the requester
 *
 * @return E_OK: Operation completed successfully
 * @return E_NOT_OK: Operation failed
 */
static Std_ReturnType Spm_HandleNewRemoteRequest(const uint16 serviceId, const uint8 profNumber, const uint8 lastByteIP)
{
    Std_ReturnType returnValue;
    SpmDiagActivatedProfileStruct newItem;

    /* Initialize the new remote request */
    Spm_InitializeRequest(&newItem, serviceId, profNumber, lastByteIP);

    /* Add to E0DF queue */
    returnValue = Spm_AddItemToFifoQueue(&Sum_Spm_DID_E0DF_Queue, &newItem);

    return returnValue;
}
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Update the value of the lastByteIP of the requester
 *
 * @param[in] position in the E0DF list of the item to udpate the LastByteIp
 * @param[in] lastByteIP Last byte IP of the requester
 *
 * @return E_OK: Operation completed successfully
 * @return E_NOT_OK: Operation failed
 */
static Std_ReturnType Spm_UpdateRemotelyActivatedLastByteIPRequester(const uint8 position, const uint8 lastByteIP){

    Std_ReturnType returnValue = E_NOT_OK;
    SpmDiagActivatedProfileStruct tempItem;

    /* Get the item from the queue */
    if (Sum_Algo_Deque_GetAt(&Sum_Spm_DID_E0DF_Queue, position, &tempItem) == E_OK) {

        /* Update LastByteIPRequester. */
		/* PRQA S 2983 1 # tempItem will be used to update the queue by Sum_Algo_Deque_SetAt. */
        tempItem.LastByteIPRequester = lastByteIP;

        /* Set the modified item back to the queue */
        returnValue = Sum_Algo_Deque_SetAt(&Sum_Spm_DID_E0DF_Queue, position, &tempItem);

    }

    return returnValue;
}
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Handles remote activation request and updates the diagnostic queues accordingly.
 *
 * @param[in] serviceId Service ID of the profile to activate
 * @param[in] profNumber Profile number to activate
 * @param[in] lastByteIP Last byte IP of the requester
 *
 * @return E_OK: Request processed successfully
 * @return E_NOT_OK: Request processing failed
 */
/* PRQA S 1532 3 # Defined here for modularity reason. */
 /* [$Satisfies $DDS_SPM 0627] [$Satisfies $DDS_SPM 0628] [$Satisfies $DDS_SPM 0629]
    [$Satisfies $DDS_SPM 0631] [$Satisfies $DDS_SPM 0637] [$Satisfies $DDS_SPM 0638] */
Std_ReturnType Spm_HandleRemoteActivationRequest(const uint16 serviceId, const uint8 profNumber, const uint8 lastByteIP)
{
    Std_ReturnType returnValue = E_NOT_OK;
    uint8 remotePosition;
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
    uint8 localPosition;
«ENDIF-»
    /* Check if SUSD allows updates and we're in PowerOff session */
    if (Spm_IsQueueUpdateAllowed() == TRUE) {
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
        /* If the item is already present in the local queue, NO operation is needed since
           by definition an item that has both locally and remotely activation criteria is
           defined as locally activated. */
        if( Spm_FindItemByServiceIdAndProfNumber(&Sum_Spm_DID_E0DE_Queue, serviceId, profNumber, &localPosition) == E_OK ){

            returnValue = E_NOT_OK;

        }
«ENDIF-»
       «IF GetDIDE0DEIsConfigured(spm.spmGeneral)»
            else «ENDIF» if (Spm_FindItemByServiceIdAndProfNumber(&Sum_Spm_DID_E0DF_Queue, serviceId, profNumber, &remotePosition) == E_OK) {

			/* Update the requester's last byte IP */
            returnValue = Spm_CheckAndUpdateRemotelyActivatedProfile(serviceId, profNumber, remotePosition, lastByteIP);

        } else {
            /* Create a new item and enqueue in E0DF queue. */
            returnValue = Spm_HandleNewRemoteRequest(serviceId, profNumber, lastByteIP);
        }

    }

    return returnValue;
}
«ENDIF-»
/**
 * @brief Updates the ActivityTimerInTick for all items in both E0DE and E0DF queues.
 *
 * This function iterates through all items in the E0DE (locally activated) and E0DF (remotely activated)
 * queues and increments their ActivityTimerInTick counters by calling the appropriate increment functions.
 *
 * @return E_OK: All activity timers updated successfully
 * @return E_NOT_OK: Failed to update at least one activity timer
 */
/* PRQA S 1532 2 # Defined here for modular reason. */
 /* [$Satisfies $DDS_SPM 0633] */
Std_ReturnType Sum_Spm_UpdateActivityTimerDID_E0DE_E0DF(void)
{
    Std_ReturnType returnValue = E_OK;
    uint8 i;
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
    uint8 localQueueSize;
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
    uint8 remoteQueueSize;
«ENDIF-»
    /* Check if SUSD allows updates and we're in PowerOff session */
    if (Spm_IsQueueUpdateAllowed() == TRUE) {
        /* Get the size of both queues */
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
        localQueueSize = (uint8)Sum_Algo_Deque_Size(&Sum_Spm_DID_E0DE_Queue);
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
        remoteQueueSize = (uint8)Sum_Algo_Deque_Size(&Sum_Spm_DID_E0DF_Queue);
«ENDIF-»
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
        /* Update all items in the E0DE queue (locally activated profiles) */
        for (i = 0u; i < localQueueSize; i++) {
            if (Spm_IncrementActivityTimerAtPositionIfProfileIsActive(&Sum_Spm_DID_E0DE_Queue, i) != E_OK) {
                returnValue = E_NOT_OK;
            }
        }
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
        /* Update all items in the E0DF queue (remotely activated profiles) */
        for (i = 0u; i < remoteQueueSize; i++) {
            if (Spm_IncrementActivityTimerAtPositionIfProfileIsActive(&Sum_Spm_DID_E0DF_Queue, i) != E_OK) {
                returnValue = E_NOT_OK;
            }
        }
«ENDIF-»
    }

    return returnValue;
}
«ENDIF-»
«IF GetDIDE0DDIsConfigured(spm.spmGeneral)-»
/**
 * @brief Function that set to 1 a particular bit.
 *
 * @param  Data: Buffer to populate. Pointer to an array of 64 bytes.
 * @param  position: Position of bit to set to 1. In range [0, 511].
 *
 */
static void Spm_DID_E0DD_SetBitToOne(uint8* Data, const uint16 position){

	uint8 bytePosition;
	uint8 bitPosition;

	/* Check if the position is smaller than the max position available.
	   Anyway the position (i.e. BitMapIndex) is already checked at generation time. */
	if(position <  512u){

		bytePosition = (uint8)(position / 8u);
		bitPosition = (uint8)(7u - (position % 8u));
		Data[bytePosition] |= 1u << bitPosition;

	}
}


«ENDIF-»

