«IF Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spmDID0xE0DFDcmRef)-»
	SUM_SPM_UNUSED(OpStatus);
«ENDIF-»

	*(ErrorCode) = DCM_POS_RESP;

	return E_OK;
}
	«ENDIF -»
«ENDIF»
«ENDIF -» «REM»SpmDiagnostic is configured«ENDREM»

