«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
/**
 * @brief Regulates activity on SPM DIDs 0xE0DE/0xE0DF based on the processing status of DID 0xE0D7 (SUSD side)
 *
 * Receives a command notification from the SUSD indicating whether:
 * - DIDs should be saved to NvM ("NvMStore" command);
 * - DIDs should be cleared ("Reset" command);
 * - DIDs can be updated ("UpdateRecord" command);
 * - DIDs update should be aborted ("StopUpdate" command).
 *
 * @param[in] Cmd The selected command
 * @return RTE_E_SPM_SUSD_ActivityRecordCmd_E_OK.
 */
/* [$Satisfies $DDS_SPM 0627] [$Satisfies $DDS_SPM 0628] [$Satisfies $DDS_SPM 0629]
   [$Satisfies $DDS_SPM 0609] [$Satisfies $DDS_SPM 0637] [$Satisfies $DDS_SPM 0638] */
/* PRQA S 1503 1 # Usage of function in a complete integrated project due to project specific conditions */
FUNC(Std_ReturnType, SPM_CODE) SPM_ActivityRecordCmd(VAR(SPM_SUSD_ActivityRecordCmdType, AUTOMATIC) Cmd)
{

	switch(Cmd)
	{
		case SUM_ARC_Reset: {
			/* Call function to clear DIDs 0xE0DE/0xE0DF */
			Spm_ClearQueueDID_E0DE_E0DF();
		}
		/* PRQA S 2003 1 # 'Break' is not used in SUM_ARC_Reset state to fall through to SUM_ARC_NvMStore state  to save data. */
		case SUM_ARC_NvMStore: {
«IF (Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spmDID0xE0DEDcmRef) ||  Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spmDID0xE0DFDcmRef))-»
			Dcm_OpStatusType opStatus_u8 = DCM_INITIAL;
«ENDIF-»
			/* Call function to store DIDs 0xE0DE/0xE0DF to NvM */
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
			(void)Runnable_Spm_DID0xE0DE(«IF Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spmDID0xE0DEDcmRef)»opStatus_u8,«ENDIF» &(«spm.spmGeneral.spmDiagnostic.spmDID0xE0DENvmRef.nvMRamBlockDataAddress-»[0U]));
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
			(void)Runnable_Spm_DID0xE0DF(«IF Get_DID_UsePortAsync(spm.spmGeneral.spmDiagnostic.spmDID0xE0DFDcmRef)»opStatus_u8,«ENDIF» &(«spm.spmGeneral.spmDiagnostic.spmDID0xE0DFNvmRef.nvMRamBlockDataAddress-»[0U]));
«ENDIF-»
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
			(void)Rte_Call_RP_SPM_Dcm_E0DE_Write_WriteBlock(&(«spm.spmGeneral.spmDiagnostic.spmDID0xE0DENvmRef.nvMRamBlockDataAddress-»[0U]));
«ENDIF-»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
			(void)Rte_Call_RP_SPM_Dcm_E0DF_Write_WriteBlock(&(«spm.spmGeneral.spmDiagnostic.spmDID0xE0DFNvmRef.nvMRamBlockDataAddress-»[0U]));
«ENDIF-»
			break;
		}
		case SUM_ARC_UpdateRecord: {
			/* Set E0D7ActiveStatus IRV to "Active" */
			Rte_IrvWrite_RE_SPM_SUSD_ActivityRecordCmd_Spm_E0D7ActiveStatus((E0D7_ACTIVE));
			break;
		}
		case SUM_ARC_StopUpdate: {
			/* Set E0D7ActiveStatus IRV to "Not Active" */
			Rte_IrvWrite_RE_SPM_SUSD_ActivityRecordCmd_Spm_E0D7ActiveStatus((E0D7_NOT_ACTIVE));
			break;
		}
		default: {
			/* Do nothing */
			break;
		}
	}
	/* For now, always exit with a good status */
	return RTE_E_SPM_SUSD_ActivityRecordCmd_E_OK;
}
«ENDIF-»

