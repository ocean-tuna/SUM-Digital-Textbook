/*
 * File contains the wake-up for the remotes node/Host and the single hardwaree device
 */


#include "Rte_SPM.h"
#include "Sum_Spm_PBCfg.h"
#include "Sum_Spm_HeartBeat_Mgr.h"

/* PRQA S 1503 EOF # Usage of function in a complete integrated project due to project specific conditions */
/* PRQA S 3214 EOF # Memory Mapping for security reason */
/* PRQA S 1532 EOF # The functions are defined here for modularity reason. */

/*
 * Define getter and setters .....................................................................................
 */

/**
 * @brief Attempts to power on a device identified by its IP address.
 *
 * This function searches for a specific device, in the Spm_PowMgr_TrgDvc_List, by using the provided IP address.
 * If the device is found,  it sets the requested bit (0) to 1, since it is a device requested.
 *
 * @param[in] reqIp The IP address of the target device to be powered on. It is used to search for the
 *                  device in the Spm_PowMgr_TrgDvc_List.
 * 
 * The function returns :
 *
 * @return 	 TRUE if the device is found (allowing the flag to be updated correctly and the device to be set as requested)
 *			 FALSE otherwise.
 */
/* [$Satisfies $DDS_SPM 0116] */ /* [$Satisfies $DDS_SPM 0205] */ 
boolean Spm_PowerOnDevice( uint32 reqIp ) {
	boolean retVal = FALSE;
	sint16 IndexOfTrgDvc;

	/* Search the item inside the Spm_PowMgr_TrgDvc_List. */
	IndexOfTrgDvc = Spm_GetIndexTrgDvcFromIP(reqIp);

	if(IndexOfTrgDvc != SPM_INVALID){
		/* Set the TargetDevice as requested */
		/* [$Satisfies $DDS_SPM 0400] */
		Sum_Spm_SetAsRequested((uint8)IndexOfTrgDvc); 
		retVal = TRUE;
	}

	return retVal;

}

/**
 * @brief Attempts to power off a device identified by its IP address.
 *
 * This function searches for a device, in the Spm_PowMgr_TrgDvc_List, by using the provided IP address.
 * If the device is found, it reset the requested flag (indicating that the target device is no longer requested). 
 * The function returns TRUE if the device is found and the request flag
 * is set successfully; otherwise, it returns FALSE.
 *
 * @param[in] reqIp The IP address of the target device to be powered off. It is used to search for the
 *                  device in the Spm_PowMgr_TrgDvc_List.
 * @return TRUE if the device is found and the power-off request is successfully set; FALSE otherwise.
 *
 */
/* [$Satisfies $DDS_SPM 0118] *//* [$Satisfies $DDS_SPM 0119] */
boolean Spm_PowerOffDevice( uint32 reqIp ) {
	boolean retVal = FALSE;
	sint16 IndexOfTrgDvc;

	/* Search the item inside the Spm_PowMgr_TrgDvc_List. */
	IndexOfTrgDvc = Spm_GetIndexTrgDvcFromIP(reqIp);

	if(IndexOfTrgDvc != SPM_INVALID){
		/* Set the TargetDevice as requester */
		Sum_Spm_ResetAsRequested((uint8)IndexOfTrgDvc);
		retVal = TRUE;
	}

	return retVal;
}

/* EOF */

«ENDFILE»
