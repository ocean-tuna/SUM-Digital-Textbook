#ifndef SUM_SPM_HEARTBEATH_MGR_H_
#define SUM_SPM_HEARTBEATH_MGR_H_

#include "Sum_Spm_Cfg.h"
#include "Sum_Spm_SoftwMgr.h"
#include "Sum_Spm_PwrMgr.h"
#include "Sum_Spm_DevicePowerState.h"

#define SPM_HB_CNTR_MAX_VALUE     				( 0xFFFFFFFFu )

/* [$Satisfies $DDS_SPM 0308] */
#define SPM_STEADYSTATE_DELAY_HB_MS				( Rte_CData_Spm_HB_Periodicity_ms() )
#define SPM_INITIAL_DEBOUNCE_DELAY_HB_MS		( Rte_CData_Spm_HB_Periodicity_BurstPhase_ms() )

#define SPM_INITIAL_DEBOUNCE_DELAY_HB_TICK 		(SPM_INITIAL_DEBOUNCE_DELAY_HB_MS / SUM_SPM_PERIOD_PM_MAINFUNCTION_MS)
#define SPM_STEADYSTATE_DELAY_HB_TICK			(SPM_STEADYSTATE_DELAY_HB_MS / SUM_SPM_PERIOD_PM_MAINFUNCTION_MS)

#define SPM_NUMBER_OF_INITIALSENDING			(0x03u)

typedef struct {
	/* [$Satisfies $DDS_SPM 0300] */
	SPM_HB_dt_Prv Spm_PayloadToWrite;
	uint8   Spm_InitialBurstPhase;	/** Necessary to understand if the initial phase is ended. */
	uint16  Spm_TimerTracker_Tick;
} Spm_HB_Tx_InfoType;

void Spm_PM_HB_Tx_Handler(void);
void Spm_PM_Rx_Polling_Handler(void);
void SPM_PM_Init_HB_BurstPhase(void);
boolean Sum_Spm_InitialHbBurstPhaseCompleted(void);

#endif

/* EOF */

