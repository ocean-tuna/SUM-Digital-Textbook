/**
 * @brief  wake-up frame handler for all protocols (CAN, ETH, GPIO)
 * @details Handles buffer operations and protocol-specific timer management
 *
 * @param[in] ComandEnum The enumeration value of the command (bit position)
 * @param[in] cmd        Boolean to set (TRUE) or clear (FALSE) the bit
 * @param[in] buffer     Pointer to protocol-specific buffer
 * @param[in] protocol   Protocol type (CAN, ETH, or GPIO)
 */
/* [$Satisfies $DDS_SPM 0105] *//* [$Satisfies $DDS_SPM 0107] *//* [$Satisfies $DDS_SPM 0140] *//* [$Satisfies $DDS_SPM 0113] */
static void Sum_Spm_LocalWakeUpFrameTx_Handler(const uint8 ComandEnum, const boolean cmd, uint8* buffer, uint16* tickTracker)
{
	uint8 offset ;
	uint8 index ;

	/* Calculate bit position for the command */
	offset = ComandEnum >> 3u;    /* Divide by 8 to get byte offset */
	index = ComandEnum & 0x7u;    /* Modulo 8 to get bit position */

	/* Set/clear the command bit in buffer */
	if(TRUE == cmd){
		/* [$Satisfies $DDS_SPM 0105] */
		buffer[offset] |= 1u << index;     /* Set bit using OR logic */
	}else{
		/* [$Satisfies $DDS_SPM 0140] *//* [$Satisfies $DDS_SPM 0107] */
		buffer[offset] &= (~(1u << index)); /* Clear bit using AND logic */
	}

	/* [$Satisfies $DDS_SPM 0103] */
    /* Set counter to 1 - in this way, next time Sum_Spm_ProtocolSpecificHandler() is called, the timer will elapse. */
    if(NULL_PTR != tickTracker){
	    *tickTracker = 1u;
    }

}
