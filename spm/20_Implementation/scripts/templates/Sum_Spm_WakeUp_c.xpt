/**
 * @brief Check if a sending of WUFs with all zeros is needed.
 *
 * @param[in] config Pointer to protocol-specific configuration (includes state)
 */
static void Sum_Spm_HandleSteadyState(const Sum_Spm_WkUpFrameConfig* config)
{
    /* This function checks if the buffers are all zeros and the hasTransmittedAtLeastOnce is set to TRUE. */
    if (Sum_Spm_IsNoDevicesActivated(config->state->hasTransmittedAtLeastOnce, config) == TRUE)
    {
        (void)Sum_Common_MemSet(config->txFrameBufferA, 0, (WAKEUP_FRAME_LEN * sizeof(uint8)));
        (void)Sum_Common_MemSet(config->txFrameBufferB, 0, (WAKEUP_FRAME_LEN * sizeof(uint8)));
        (void)Sum_Common_MemSet(config->txFrameBufferC, 0, (WAKEUP_FRAME_LEN * sizeof(uint8)));
        config->state->numberWUFAllZerosSent++;
    }
    else
    {
        config->state->numberWUFAllZerosSent = 0u;
    }
}

/**
 * @brief Processes frame transmission logic when timer elapsed
 *
 * @param[in] config Pointer to protocol-specific configuration
 */
static void Sum_Spm_ProcessFrameTransmission(Sum_Spm_WkUpFrameConfig* config)
{
    boolean transmissionSuccess;

    /* [$Satisfies $DDS_SPM 0100] *//* [$Satisfies $DDS_SPM 0111] *//* [$Satisfies $DDS_SPM 0112] */
    if (config->state->transmissionActive  == TRUE)
    {
        /* Store the buffer before sending to avoid missing data */
        Sum_Spm_StoreWkUpFrameBuffer(config);

        /* Protocol-specific transmission */
        transmissionSuccess = Sum_Spm_TransmitProtocolFrames(config);

        if ((config->protocol == SPM_PROTOCOL_ETH) ||
           ((config->protocol == SPM_PROTOCOL_CAN) && (transmissionSuccess == TRUE)))
        {
            /* If the trasmission gone well, re-load the timerTracker. */
            config->timerTickTracker = config->steadyStateTickPeriodicity;
        }
    }
}
/**
 * @brief protocol-specific wake-up frame processing
 *
 * This function handles wake-up frame processing for a specific protocol
 *
 * @param[in] config Pointer to protocol-specific configuration
 */
static void Sum_Spm_ProtocolSpecificHandler(Sum_Spm_WkUpFrameConfig* config)
{
    uint8 i;
    boolean bufferChanged;
    boolean paramValidationOk = TRUE;


    /* Input parameter validation */
    if ((config == NULL_PTR) ||
        (config->txFrameBufferA == NULL_PTR) || (config->txFrameBufferB == NULL_PTR) || (config->txFrameBufferC == NULL_PTR) ||
        (config->state == NULL_PTR) ||
        (config->wakeUpCmdBufferA == NULL_PTR) || (config->wakeUpCmdBufferB == NULL_PTR) || (config->wakeUpCmdBufferC == NULL_PTR))
    {
        paramValidationOk = FALSE;
    }

    if (paramValidationOk == TRUE)
    {
        /* Decrement the timer  */
        if ((config->timerTickTracker) > 0u)
        {
            (config->timerTickTracker)--;
        }

        /* Timer elapsed. Necessary to transmit the WkUp Frame. */
        if (0u == (config->timerTickTracker))
        {
            /* [$Satisfies $DDS_SPM 0108] *//* [$Satisfies $DDS_SPM 0106] *//* [$Satisfies $DDS_SPM 0117] *//* [$Satisfies $DDS_SPM 0311] *//* [$Satisfies $DDS_SPM 0110] */
            for (i = 0u; i < WAKEUP_FRAME_LEN; i++)
            {
                /* Update frame buffers that will be sent over the bus ORing with
                   the buffers that store the commands retrieved by parsing the WakeUp sequences.
                   No flag are updated. */
                Sum_Spm_UpdateFrameBuffers(config, i);

                /* Check if the buffer that will be sent is different from the one previously sent.
                   If yes, the hasTransmittedAtLeastOnce flag is set to true and the transmissionActive  flag set to True.
                   The bufferChanged flag will be used in order to understand the tick tracker timer
                   needs to be reloaded with the burst periodicity (if TRUE) or with the normal one. */
                bufferChanged = Sum_Spm_CheckBufferChanges(config, i);

            }

            /* This function check if a sending of WUF with all zeros if:
                - hasTransmittedAtLeastOnce is TRUE
                - all three WUF is zeros.

                If the above conditions are satisfied, the tracker numberWUFAllZerosSent is increased by one.
                Otherwise, it is reset to zero.
             */
            Sum_Spm_HandleSteadyState(config);

            /* Process frame transmission if the transmissionActive flag is TRUE.
               It reload the timer timerTickTracker as normal periodicity steadyStateTickPeriodicity. */
            Sum_Spm_ProcessFrameTransmission(config);

            /* Handling of the timerTickTracker and burstPhaseCounter w.r.t. internal flag. */
            Sum_Spm_HandlerBurstPhasePeriodicity(bufferChanged, config);

            /* Check if all-zero wakeup frame has been transmitted for 3 steady state intervals
               and the tramsission is Active. */
            if ((config->state->numberWUFAllZerosSent >= 3u) && (config->state->transmissionActive  == TRUE))
            {
                /* Stop transmitting the frame */
                config->timerTickTracker = config->steadyStateTickPeriodicity;
                config->state->transmissionActive  = FALSE;
                config->state->numberWUFAllZerosSent = 0u;
            }
        }
    }
}

