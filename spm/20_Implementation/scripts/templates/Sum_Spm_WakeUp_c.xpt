/**
 * @brief This function check if the SrcIP of the WakeUp frame is a configured TrgDvc.
 *
 * @param[in] SrcIP IP address of the WkUp Frame received.
 */
static boolean Spm_ETHWkUpFrameSrcIPisValid(const uint32 SrcIP){

	sint32 indexTrgDvc;
	boolean ret = FALSE;

/* PRQA S 1291 1 # Cast is necessary for API signature */
	indexTrgDvc = Spm_GetIndexTrgDvcFromIP(SrcIP);

	if(indexTrgDvc != SPM_INVALID){
		ret = TRUE;
	}

	return ret;
}

«IF Spm_ECU_INTERMEDIATE(spm) == true-»
/**
 * @brief This function dequeues all received ETH Wake-Up Frames and processes each one by calling the corresponding wake-up handler
 *
 */
/* PRQA S 1532 1 # Following macro are used to access data structure */
void Spm_ETHWkUpFrame_Rx_Polling_Handler(void){

	SPM_WkUp_dt_Prv Spm_EthWkUpRxFrame;
	uint8 idx;
	uint8 idx_net;
	uint8 metaData_loc[SPM_METADAT_SIZE]; /* PRQA S 3678 # the value cannot be constant because it is written by API Rte_Receive, also if it is not currently used */

	/* [$Satisfies $DDS_SPM 0111] */
	/* PRQA S 2877 1 # This loop will never be executed more than once for configuration reason. */
	for(idx_net = 0u; idx_net < SUM_SPM_NUMBER_OF_NET_CONF; idx_net++){
        /*Using the first variant's VlanID as VlanID should not differ w.r.t the variants */
   		while(E_OK == Spm_HandleVLANCommunication(Spm_NetworkInfo_Wrap_PerVariant[0][idx_net].SPM_NetInfo->VlanID,
					                              SPM_RECV_HNDL,
											      SPM_WK_COMHNDLING,
											      NULL_PTR,
											      &Spm_EthWkUpRxFrame,
											      NULL_PTR,
											      (uint8 *)&(metaData_loc[0U]) )){

			SUM_SPM_UNUSED(metaData_loc);

            /* Check if the Source Ip is valid */
			if(TRUE == Spm_ETHWkUpFrameSrcIPisValid(Spm_EthWkUpRxFrame.SrcPMId)){
   	   			for(idx = 0u; idx < WAKEUP_FRAME_LEN; idx++){
   	   			   Spm_CanIf_Tx_WakeUpFrame_A.pduInfo.SduDataPtr[idx] |= Spm_EthWkUpRxFrame.WakeupFrameA[idx];
				   Spm_CanIf_Tx_WakeUpFrame_B.pduInfo.SduDataPtr[idx] |= Spm_EthWkUpRxFrame.WakeupFrameB[idx];
                   Spm_CanIf_Tx_WakeUpFrame_C.pduInfo.SduDataPtr[idx] |= Spm_EthWkUpRxFrame.WakeupFrameC[idx];
   	   			}
   	   			/* [$Satisfies $DDS_SPM 0660] */
   	   			/* We insert the newly received WUF within the rolling buffer*/
   	   			Sum_Spm_WufRollingBuffer_StoreWuf(
   	   			   Spm_EthWkUpRxFrame.WakeupFrameA,
   	   			   Spm_EthWkUpRxFrame.WakeupFrameB,
   	   			   Spm_EthWkUpRxFrame.WakeupFrameC,
   	   			   (uint8)(Spm_EthWkUpRxFrame.SrcPMId & 0xFFu));

   	   			/* After storing the newly received WUF let's react on possible updates. */
   	   			/* Here we are not owner of any timer, therefore we pass FALSE as parameter
   	   			   so that we do not advance the WUF Rolling Buffer internal timer */
   	   			Spm_ExecuteWakeUpFrameActions(FALSE);

				«IF Spm_IsThereAnyManagedDevice(spm)-»
				/* [$Satisfies $DDS_SPM 0524] */
				/* Call wake-up handler for WUF */
				Sum_Spm_WkupEdgeNodes();
				«ENDIF-»
            }
   		}
	}
}
«ENDIF-»

/**
 * @brief This function dequeues all received Multicast ETH Wake-Up Frames and processes each one by calling the corresponding wake-up handler
 *
 * @param[in]    None
 * @return       Void
 */
/* PRQA S 1532 2 # Defined here for modularity reason */
/* [$Satisfies $DDS_SPM 0233] [$Satisfies $DDS_SPM 0234] */
void Spm_ETHWkUpFrame_Multicast_Rx_Polling_Handler(void){

	SPM_WkUp_dt_Prv Spm_EthWkUpMulticastRxFrame;
	uint8 idx_net;
	uint8 metaData_loc[SPM_METADAT_SIZE]; /* PRQA S 3678 # the value cannot be constant because it is written by API Rte_Receive, also if it is not currently used */

	/* PRQA S 2877 1 # This loop will never be executed more than once for configuration reason. */
	for(idx_net = 0u; idx_net < SUM_SPM_NUMBER_OF_NET_CONF; idx_net++){
        /*Using the first variant's VlanID as VlanID should not differ w.r.t the variants */
   		while(E_OK == Spm_HandleVLANCommunication(Spm_NetworkInfo_Wrap_PerVariant[0][idx_net].SPM_NetInfo->VlanID,
					                              SPM_RECV_HNDL,
											      SPM_WK_MULTICAST_COMHNDLING,
											      NULL_PTR,
											      &Spm_EthWkUpMulticastRxFrame,
											      NULL_PTR,
											      (uint8 *)&(metaData_loc[0U]) )){

			SUM_SPM_UNUSED(metaData_loc);
            /* Check if the Source Ip is valid */
			if(TRUE == Spm_ETHWkUpFrameSrcIPisValid(Spm_EthWkUpMulticastRxFrame.SrcPMId)){
   	   			/* [$Satisfies $DDS_SPM 0660] */
   	   			/* We insert the newly received WUF within the rolling buffer*/
   	   			Sum_Spm_WufRollingBuffer_StoreWuf(
   	   			   Spm_EthWkUpMulticastRxFrame.WakeupFrameA,
   	   			   Spm_EthWkUpMulticastRxFrame.WakeupFrameB,
   	   			   Spm_EthWkUpMulticastRxFrame.WakeupFrameC,
   	   			   (uint8)(Spm_EthWkUpMulticastRxFrame.SrcPMId & 0xFFu));

   	   			/* After storing the newly received WUF let's react on possible updates. */
   	   			/* Here we are not owner of any timer, therefore we pass FALSE as parameter
   	   			   so that we do not advance the WUF Rolling Buffer internal timer */
   	   			Spm_ExecuteWakeUpFrameActions(FALSE);

   	   			«IF Spm_IsThereAnyManagedDevice(spm) && Spm_ECU_INTERMEDIATE(spm) == true-»										
   	   			/* Call wake-up handler for WUF */
   	   			Sum_Spm_WkupEdgeNodes();
   	   			«ENDIF-»	
			}
   		}
	}
}

/**
 * @brief Checks if a specific wakeup bit status in a wakeup frame.
 *
 * This utility function calculates the byte index and bit mask for a given bit position
 * within a wakeup frame buffer and check whether that bit is asserted (set to 1) or not.
 *
 * @param[in] wakeUpFrame: Pointer to the wakeup frame buffer to check.
 * @param[in] wakeUpBitPos: Bit position to check (0-63 for 8 bytes, where 0 is LSB of first byte).
 * @return boolean: TRUE if the bit is asserted (1), FALSE if not asserted (0).
 *
 * @note The function does not perform null pointer validation before accessing the frame data.
 */
  /* PRQA S 1532 1 # Defined here for modular reason. */
boolean Spm_IsWakeUpBitSet(const uint8* wakeUpFrame, const uint8 wakeUpBitPos)
{
	boolean ret = FALSE;
    uint8 byteIdx;
    uint8 bitMask;
	if(wakeUpFrame != NULL_PTR )
	{
	    /* Calculate byte index and bit mask for the wakeup bit */
	    byteIdx = wakeUpBitPos / 8u;
	    bitMask = (uint8)(1u << (wakeUpBitPos % 8u));

	    /* Check if the bit is asserted */
	    ret = ((wakeUpFrame[byteIdx] & bitMask) != 0u) ? TRUE : FALSE;
    }

	return ret;
}

/**
 * @brief The function :
 *  - updates the global variable Spm_OwnWakeUpBit based on what has been stored within the WUF Rolling Buffer;
 *  - retrieves the information, for DID 0xE0D7, to be forwarded to the SUSD module..;
 *  - advances the WUF Rolling Buffer Timer if requested.
 *
 * @param[in] advanceTimer: boolean: TRUE if we need to contextually advance Rolling Buffer timer.
 * @warning only Power Manager main loop should call this function with advanceTimer == TRUE.
 * @return None (void)
 *//* [$Satisfies $DDS_SPM 0610] */
void Spm_ExecuteWakeUpFrameActions(boolean advanceTimer)
{
    uint8 lastRequesterId;
    «IF Spm_ExistMultipleVariantConfigured(spm) == true -»
    uint8 i;

	/* [$Satisfies $DDS_SPM 0674] */
	/* If the SPM is unbranded, as per SDVA-7596 requirements, the SPM needs to check within every Variant configured.
	   If the SPM is branded, the SPM needs just to check the bit for the actual variant. */
	if(FALSE == Sum_Spm_GetIsBranded()){
		
		/* The following loop iterate on each variant to check if at least one SpmVariantWkupFrame/SpmVariantWkupBit for a variant is set. 
		   If at least one, the SPM needs to NOT vote for shutdown (Spm_OwnWakeUpBit = TRUE). */
		for(i = 0u; i < SUM_SPM_NUMBER_OF_VARIANTS; i++)
        {
			Spm_OwnWakeUpBit = Sum_Spm_WufRollingBuffer_RetrievesWUFInfoForE0D7(&lastRequesterId, Spm_WkupFrameInfo_PerVariant[i]);
            Spm_E0D7_LastRequesterIdHandler(lastRequesterId);
            if(TRUE == Spm_OwnWakeUpBit)
            {
                break;
            }
		}
	}
	else{

		Spm_OwnWakeUpBit = Sum_Spm_WufRollingBuffer_RetrievesWUFInfoForE0D7(&lastRequesterId, Spm_ActiveWkupFrameInfo_p);
		Spm_E0D7_LastRequesterIdHandler(lastRequesterId);
	}
    «ELSE -»
    Spm_OwnWakeUpBit = Sum_Spm_WufRollingBuffer_RetrievesWUFInfoForE0D7(&lastRequesterId, Spm_ActiveWkupFrameInfo_p);
	Spm_E0D7_LastRequesterIdHandler(lastRequesterId);
    «ENDIF-»
    if(TRUE == advanceTimer)
    {
        /* Advance the WUF rolling buffer timer. */
        Sum_Spm_WufRollingBuffer_CheckAndShiftWufSlot();
    }
}



/*
 * @brief Returns the current state of the device's own wakeup bit.
 *
 * This getter function provides access to the global variable that tracks whether
 * the device's own bit is asserted in the received wakeup frame. 
 *
 * @return boolean: TRUE if the device wakeup bit is asserted (1),
 * 					FALSE if not asserted (0).
 */
/* PRQA S 1532 1 # Defined here for modular reason. */
boolean Spm_GetOwnwakeUpBit(void)
{
    return Spm_OwnWakeUpBit;
}


/**
 * @brief This function perform the operation requested by parsing the WakeUp Sequence.
 *
 *  @param[in] cmdType: Command type retrieved parsing the WakeUp Sequence.
 *  @param[in] cmdValue: Command value retrieved parsing the WakeUp Sequence.
 *  @param[in] numberIPAssociated: number of all the IP addresses defined for the target device.
 *  @param[in] ListIP: pointer to list of all the IP addresses defined for the target device.
 *  @param[in] IsPoweringOn: boolean that define if this function is called during a PowerOn (TRUE) or PowerOff (FALSE) sequence.
 */
/* PRQA S 1532 1 # Defined here for modularity reason. */
void Sum_Spm_WakeUpCmdDispatcher(const uint8 cmdType, const uint8 cmdValue, const uint8 numberIPAssociated, const uint32 *ListIP, const boolean IsPoweringOn){

	switch(cmdType)
	{

«IF Spm_ECU_INTERMEDIATE(spm) == true-»
        /* [$Satisfies $DDS_SPM 0144] */
		case SEND_CAN_WKUP_FRM_A:
			Sum_Spm_LocalWakeUpFrameTx_Handler(cmdValue, IsPoweringOn, &Spm_WkUpFrameConfig_CAN.wakeUpCmdBufferA[0U], &Spm_WkUpFrameConfig_CAN.timerTickTracker);
			break;
		/* [$Satisfies $DDS_SPM 0145] */
		case SEND_CAN_WKUP_FRM_B:
			Sum_Spm_LocalWakeUpFrameTx_Handler(cmdValue, IsPoweringOn, &Spm_WkUpFrameConfig_CAN.wakeUpCmdBufferB[0U], &Spm_WkUpFrameConfig_CAN.timerTickTracker);
			break;
        /* [$Satisfies $DDS_SPM 0645] */
        case SEND_CAN_WKUP_FRM_C:
			Sum_Spm_LocalWakeUpFrameTx_Handler(cmdValue, IsPoweringOn, &Spm_WkUpFrameConfig_CAN.wakeUpCmdBufferC[0U], &Spm_WkUpFrameConfig_CAN.timerTickTracker);
			break;
«ENDIF-»
«IF (Spm_IsETHCommandPresent(spm) == true)-»
		/* [$Satisfies $DDS_SPM 0113] */
		case SEND_ETH_WKUP_FRM_A:
			Sum_Spm_LocalWakeUpFrameTx_Handler(cmdValue, IsPoweringOn, &Spm_WkUpFrameConfig_ETH.wakeUpCmdBufferA[0U], &Spm_WkUpFrameConfig_ETH.timerTickTracker);
			break;
		/* [$Satisfies $DDS_SPM 0148] */
		case SEND_ETH_WKUP_FRM_B:
			Sum_Spm_LocalWakeUpFrameTx_Handler(cmdValue, IsPoweringOn, &Spm_WkUpFrameConfig_ETH.wakeUpCmdBufferB[0U], &Spm_WkUpFrameConfig_ETH.timerTickTracker);
			break;
        /* [$Satisfies $DDS_SPM 0644] */
        case SEND_ETH_WKUP_FRM_C:
			Sum_Spm_LocalWakeUpFrameTx_Handler(cmdValue, IsPoweringOn, &Spm_WkUpFrameConfig_ETH.wakeUpCmdBufferC[0U], &Spm_WkUpFrameConfig_ETH.timerTickTracker);
			break;
«ENDIF-»
«IF Spm_IsTC10CommandPresent(spm)== true -»
		/* [$Satisfies $DDS_SPM 0147] */
		case SEND_TC10_SWTCH_1:
		case SEND_TC10_SWTCH_2:
			if((TRUE == IsPoweringOn) && (numberIPAssociated > 0U) && (ListIP != NULL_PTR)){
				Sum_Spm_EthSM_RequestComMode(numberIPAssociated, ListIP);
			}
			break;
«ENDIF-»
«IF spm.spmGeneral.spmWkUpHelperFunction != null-»
		/* [$Satisfies $DDS_SPM 0146] */
		case SEND_BOARD_LV_WKUP_GPIO:
			Sum_Spm_LocalWakeUpFrameTx_Handler(cmdValue, IsPoweringOn, &Spm_Local_BufferPassedToHelperFunction[0U], NULL_PTR);
        	/* [$Satisfies $DDS_SPM 0141] *//* [$Satisfies $DDS_SPM 0412] *//* [$Satisfies $DDS_SPM 0114] *//* [$Satisfies $DDS_SPM 0115] */
        	SPM_WakeUp_HelperFunction((uint8 *)Spm_Local_BufferPassedToHelperFunction);
			break;
«ENDIF-»
		default:
			/* Default case. */
			break;
	}

}

«IF Spm_IsTC10CommandPresent(spm)== true -»
/**
 * @brief This function supports the call to the the EthSM_RequestComMode with the corresponding
 * 		  network handle based on IP addresses of the target device.
 *
 *  @param[in] numberIPAssociated: number of all the IP addresses defined for the target device.
 *  @param[in] ListIP: pointer to list of all the IP addresses defined for the target device.
 */
static void Sum_Spm_EthSM_RequestComMode(const uint8 numberIPAssociated, const uint32 *ListIP){
	NetworkHandleType networkHndId;
	boolean networkHndFound;

	/* [$Satisfies $DDS_SPM 0149] */
	networkHndFound = Sum_Spm_GetNetworkHndFromIPList(numberIPAssociated, ListIP, &networkHndId);
	if(networkHndFound == TRUE) {
		/* [$Satisfies $DDS_SPM 0101] */
		(void)EthSM_RequestComMode(networkHndId, COMM_FULL_COMMUNICATION_WITH_WAKEUP_REQUEST);
	}
}

/**
 * @brief This function searches the corresponding network handle ID in SpmTc10DstMap, based on
 * 		  IP addresses of the target device.
 *
 *  @param[in] numberIPAssociated: number of all the IP addresses defined for the target device.
 *  @param[in] ListIP: pointer to list of all the IP addresses defined for the target device.
 *  @param[in] networkHndId: Pointer to the variable where the corresponding network handle ID *                           should be copied if it is found in the mapping struct.
 * 							 This variable is modified by the function.
 *  @param[out] ret: A boolean value indicating whether to the corresponding network handle ID is
 * 					found (TRUE) or not (FALSE).
 */
static boolean Sum_Spm_GetNetworkHndFromIPList(const uint8 numberIPAssociated, const uint32 *ListIP, NetworkHandleType *networkHndId){
	uint8 idxNetworkHandle;
	uint8 idxIPAssociated;
	uint16 vlanId;
	boolean ret = FALSE;

	for(idxIPAssociated = 0; ((idxIPAssociated < numberIPAssociated) && (ret == FALSE)); idxIPAssociated++)	{
		/* Extract the VLAN ID from the target device IP. */
		vlanId = (uint16)((ListIP[idxIPAssociated] >> 16u) & 0x00FFU);

		/* Search network handle ID corresponding to VLAN ID */
		for(idxNetworkHandle = 0; idxNetworkHandle < SPM_NETWORK_HANDLE_CNT; idxNetworkHandle++) {
			if (SpmTc10DstMap[idxNetworkHandle].vlanId == vlanId){
				*networkHndId = SpmTc10DstMap[idxNetworkHandle].networkHndId;
				ret = TRUE;
				break;
			}
		}
	}

	return ret;
}
«ENDIF-»

/**
 * @brief Store wakeup frame buffer
 *
 * Handles the store of Wakeup frame buffer before transmit to avoid missing the data
 *
 */
static void Sum_Spm_StoreWkUpFrameBuffer(const Sum_Spm_WkUpFrameConfig* config)
{
	uint8 i;

    /* Copy frame data from the configured buffers to storage buffers */
	for(i = 0u; i < WAKEUP_FRAME_LEN; i++){
        if ((config->txFrameBufferA != NULL_PTR) && (config->txFrameBufferB != NULL_PTR) && (config->txFrameBufferC != NULL_PTR) && (config->state != NULL_PTR)) {
            config->state->prevFrameBufferA[i] = config->txFrameBufferA[i];
            config->state->prevFrameBufferB[i] = config->txFrameBufferB[i];
            config->state->prevFrameBufferC[i] = config->txFrameBufferC[i];
        }
	}
}

/**
 * @brief Handler wakeup frame buffer
 *
 * Handles the wakeup frame buffer to execute in order to transmit in a burst
 * periodic fashion for a calibrated amount of time at a calibratable time interval
 */
/* [$Satisfies $DDS_SPM 0101] */
static void Sum_Spm_HandlerBurstPhasePeriodicity(boolean bufferChanged, Sum_Spm_WkUpFrameConfig* config)
{
    if((config != NULL_PTR) && (config->state->transmissionActive == TRUE))
    {
        /* If the buffer has changed, reset timer and burst phase counter */
        /* [$Satisfies $DDS_SPM 0311] */
        if(bufferChanged == TRUE){
            /* Default value if protocol is not recognized */
            if (config->protocol == SPM_PROTOCOL_CAN) {
                config->timerTickTracker = SPM_CAN_PERIOD_BP_VAL;
                config->burstPhaseCounter = SPM_CAN_BP_INTERVAL;
            } else {
                config->timerTickTracker = SPM_ETH_PERIOD_BP_VAL;
                config->burstPhaseCounter = SPM_ETH_BP_INTERVAL;
            }

        } else if (config->burstPhaseCounter > 0u) {
            /* Decrement the interval counter */
            config->burstPhaseCounter--;

            if (config->burstPhaseCounter == 0u) {
                config->timerTickTracker = config->steadyStateTickPeriodicity;
            }
            else {
                if (config->protocol == SPM_PROTOCOL_CAN) {
                    config->timerTickTracker = SPM_CAN_PERIOD_BP_VAL;
                } else {
                    config->timerTickTracker = SPM_ETH_PERIOD_BP_VAL;
                }
            }
        } else {
            /* do nothing */
        }
    }
}

/**
 * @brief Check if there is no device activated by:
 *        - checking if the init_changed_flag is changed;
 *        - checking if all the buffers store NO bit;
 *
 * Function to check if there is no device activated before to clear the buffer to transmit all zero wakeup frame
 */
static boolean Sum_Spm_IsNoDevicesActivated(boolean init_changed_flag, const Sum_Spm_WkUpFrameConfig* config) {
    boolean enable_flag = TRUE;
    uint8 i;

    /* [$Satisfies $DDS_SPM 0311] */
    if((init_changed_flag == TRUE) && (config != NULL_PTR) && (config->txFrameBufferA != NULL_PTR) && (config->txFrameBufferB != NULL_PTR) && (config->txFrameBufferC != NULL_PTR))
    {
        for(i = 0u; i < WAKEUP_FRAME_LEN; i++){
            if ((config->txFrameBufferA[i] != 0u) || (config->txFrameBufferB[i] != 0u) || (config->txFrameBufferC[i] != 0u))
            {
                enable_flag = FALSE;
                break;
            }
        }
    }
    return enable_flag;
}

/**
 * @brief Updates frame buffers with persistent data based on protocol
 *
 * @param[in] config Pointer to protocol-specific configuration
 * @param[in] index Current buffer index being processed
 */
static void Sum_Spm_UpdateFrameBuffers(const Sum_Spm_WkUpFrameConfig* config, uint8 index)
{
    if ((config->wakeUpCmdBufferA != NULL_PTR) && (config->wakeUpCmdBufferB != NULL_PTR) && (config->wakeUpCmdBufferC != NULL_PTR))
    {
        if (config->protocol == SPM_PROTOCOL_CAN)
        {
            config->txFrameBufferA[index] |= config->wakeUpCmdBufferA[index];
            config->txFrameBufferB[index] |= config->wakeUpCmdBufferB[index];
            config->txFrameBufferC[index] |= config->wakeUpCmdBufferC[index];
        }
        else
        {
            config->txFrameBufferA[index] = config->wakeUpCmdBufferA[index];
            config->txFrameBufferB[index] = config->wakeUpCmdBufferB[index];
            config->txFrameBufferC[index] = config->wakeUpCmdBufferC[index];
        }
    }
}

/**
 * @brief Checks if buffer contents have changed
 *
 * @param[in] config Pointer to protocol-specific configuration
 * @param[in] index Current buffer index being checked
 * @return TRUE if buffer changed, FALSE otherwise
 */
static boolean Sum_Spm_CheckBufferChanges(const Sum_Spm_WkUpFrameConfig* config, uint8 index)
{
    boolean bufferChanged = FALSE;

    /* Check if the buffer has changed */
    if ((config->txFrameBufferA[index] != config->state->prevFrameBufferA[index]) ||
        (config->txFrameBufferB[index] != config->state->prevFrameBufferB[index]) ||
        (config->txFrameBufferC[index] != config->state->prevFrameBufferC[index]))
    {
        bufferChanged = TRUE;
        config->state->hasTransmittedAtLeastOnce = TRUE;
        config->state->transmissionActive  = TRUE;
    }

    return bufferChanged;
}

