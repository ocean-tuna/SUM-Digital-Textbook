#define spmPrfStsMgrInstCode_VAL(i)                            (  SPM_PrfStsMgr_RAM[i].spmPrfStsMgrInstCode )
#define Spm_CurrentPduStatus(i)                                (  SPM_PrfStsMgr_RAM[i].PduStatus )
#define Spm_SetCommandToBeSent(i)                              (  SPM_PrfStsMgr_RAM[i].CommandSend )

#define Spm_SetPowProfileStateIsChanged(i)                     (  SPM_PrfStsMgr_RAM[i].isStateProfileChanged =  TRUE )

#define SPM_ACT_DEACT_CMD_NOT_SENT                             ( 0x00u )
#define SPM_ACT_DEACT_CMD_SENT                                 ( 0x01u )
#define SPM_ACT_DEACT_CMD_SENT_RCVD_ERROR_TAG                  ( 0x02u )
#define SPM_ACT_DEACT_CMD_ACKED                                ( 0x03u )

#define GetActReqStatus(i)                                     ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step & 0x03u))
#define SetActReqIsSentToRemoteTrgDvc(i)                       ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step = ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step & 0xFCu) | SPM_ACT_DEACT_CMD_SENT)) )
#define SetActCorrectAckReceivedFromRemoteTrgDvc(i)            ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step = ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step & 0xFCu) | SPM_ACT_DEACT_CMD_ACKED)) )
#define SetReqIsRjctByRemoteTrgDvc(i)                          ( ( SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step = ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step & 0xFCu) | SPM_ACT_DEACT_CMD_SENT_RCVD_ERROR_TAG)) )

#define ResetActReqIsSentToRemoteTrgDvc(i)                     ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step &= 0xFCu) )

#define GetDeactReqStatus(i)                                   ( ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step >> 2u) & 0x03u))
/* PRQA S 3214 2 # Following macro are left for future use */
#define GetDeactReqIsSentToRemoteTrgDvc(i)                     ( ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step >> 2u) & 0x03u) == SPM_ACT_DEACT_CMD_SENT )
#define GetDeactCorrectAckReceivedFromRemoteTrgDvc(i)          ( ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step >> 2u) & 0x03u) == SPM_ACT_DEACT_CMD_ACKED )
#define SetDeactReqIsSentToRemoteTrgDvc(i)                     ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step = ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step & 0xF3u) | (SPM_ACT_DEACT_CMD_SENT << 2u))) )
#define SetDeactCorrectAckReceivedFromRemoteTrgDvc(i)          ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step = ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step & 0xF3u) | (SPM_ACT_DEACT_CMD_ACKED << 2u))) )
#define ResetDeactReqIsSentToRemoteTrgDvc(i)                   ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step &= 0xF3u) )

#define SPM_SET_AT_LEAST_ONE_ACT_CMD_SENT(i)                   ( (SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step |= (0x01u << 4u) ) )
#define SPM_GET_AT_LEAST_ONE_ACT_CMD_SENT(i)                   ( ((SPM_PrfStsMgr_RAM[i].Spm_RemotePowProf_Activation_Step >> 4u) & 0x01u) == 1u )
