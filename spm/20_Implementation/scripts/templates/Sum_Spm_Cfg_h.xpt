/** Number of Network configured. */
#define SUM_SPM_NUMBER_OF_NET_CONF   («spm.spmGeneral.spmVLANCom.size»u)
«IF Spm_ECU_INTERMEDIATE(spm) == true && spm.spmGeneral.spmCANWkUpFrmRef != null-»
