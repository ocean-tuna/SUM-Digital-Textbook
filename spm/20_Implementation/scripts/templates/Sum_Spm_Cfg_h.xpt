#define SUM_SPM_UNUSED(x)   ( (void)( x ) )

#ifndef STD_ON
#define STD_ON				1U
#endif

#ifndef STD_OFF
#define STD_OFF				0U
#endif

typedef Std_ReturnType (* Spm_Rte_SwitchPduGroup )( SPM_SrvcPduGrState data );

#define SPM_SM_PERIODICITY_MS           «spm.spmGeneral.spmSMMainFuncPeriodicity.toInteger()-»U
#define SPM_ACT_RETRY_PERIODICITY_FAST_MS    ( Rte_CData_Spm_ActDeactRetry_Periodicity_Fast_ms() )
#define SPM_ACT_RETRY_PERIODICITY_SLOW_MS    ( Rte_CData_Spm_ActDeactRetry_Periodicity_Slow_ms() )

/* Effective retry ticks: runtime calibratable, clamped to minimum 1 tick (SM cycle) */
#define SPM_ACT_RETRY_FAST_TICKS    ((SPM_ACT_RETRY_PERIODICITY_FAST_MS >= SPM_SM_PERIODICITY_MS) ? \
                                     ((uint32)SPM_ACT_RETRY_PERIODICITY_FAST_MS / (uint32)SPM_SM_PERIODICITY_MS) : (uint32)1U)
#define SPM_ACT_RETRY_SLOW_TICKS    ((SPM_ACT_RETRY_PERIODICITY_SLOW_MS >= SPM_SM_PERIODICITY_MS) ? \
                                     ((uint32)SPM_ACT_RETRY_PERIODICITY_SLOW_MS / (uint32)SPM_SM_PERIODICITY_MS) : (uint32)1U)

/* Timing period, in ms, of the SM to stay awake if a requester is in Fault or Reboot state*/
#define SPM_STAY_AWAKE_TIME_MS		( Rte_CData_Spm_SM_Stay_Awake_Time_ms() )
#define SPM_ERR_REQUESTER_TIMER_TICK    ((uint32) SPM_STAY_AWAKE_TIME_MS / SPM_SM_PERIODICITY_MS)
«IF spm.spmConfigSet.spmPowPrf.spmComIPduGroupEvnt_Tx.size > 0 -»
#define SPM_PDU_TX_SWITCHOFF_DELAY_MS   ( Rte_CData_Spm_PduTx_SwitchOff_Delay_ms() )
#define SPM_PDU_TX_SWITCHOFF_DELAY_TICK ((uint16) SPM_PDU_TX_SWITCHOFF_DELAY_MS / SPM_SM_PERIODICITY_MS)
«ENDIF-»
#define SPM_CONTAINS_PP					( «spm.spmConfigSet.spmPowPrf.size» > 0 )
#define SPM_CONF_POW_PRF_NUM			((uint16)«spm.spmConfigSet.spmPowPrf.size»U)

#define SPM_SRVCS_LST_SIZE				SPM_CONF_POW_PRF_NUM

«IF Spm_ECU_INTERMEDIATE(spm) == true && spm.spmGeneral.spmCANWkUpFrmRef != null -»
#define SPM_WUF_CAN_RX_LEN			    («spm.spmGeneral.spmCANWkUpFrmRef.spmCANWkUpFrmRxRef.size»U)
«ENDIF -»

#define SPM_ASSERT_WKUP_CURR_NODE( rcv, wkUpbits, bIdx )  ( (rcv[bIdx] & (1U << wkUpbits)) == (1U << wkUpbits) )
#define SPM_WKUP_BIT_ENUM     			((uint8)6U) // OLD - @todo remove this and its implications

#define SPM_PERMIT_EXEC_MASK			((uint8)«spm.spmGeneral.spmPermitExecutionMask»U)
#define SPM_EXEC_MASK_PASSED			((uint8)0xFFU)

#define SPM_INVALID       				((sint16)(-1))
#define SPM_HEARTBEAT_LOWER_INTERVAL	(0x01U)
#define SPM_NUM_OF_PG_OUT_EDGE			(«spm.spmConfigSet.spmPgttEntries.spmTrgDvc.size»U)

/* Size of the requester list is equal to the number of target device + 1 (for request coming from local SWC) */
#define SPM_REQER_LST_SIZE				(SPM_NUM_OF_PG_OUT_EDGE + 1u)

#define SPM_MAX_NUMBER_OF_HB_RX_MISSED  (0x03u)

#define SPM_SHUTDOWN_TARGET_BIT         (0x02U)

# define SPM_ACT_REQ					((uint8)0U)
# define SPM_DEA_REQ					((uint8)1U)

#define SPM_PROF_INVALID_INDEX       SPM_CONF_POW_PRF_NUM + 1U

#define SPM_GET_LOWVOLTAGEPRIORITY_VEHOFF(i) 			(( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->LowVoltagePriority_VEH_OFF ))
#define SPM_GET_LOWVOLTAGEPRIORITY_VEHON(i) 			(( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->LowVoltagePriority_VEH_ON ))
#define SPM_GET_TIMEOUT_VEH_OFF_SECOND(i) 			(SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->TimeOutVehOff_inSecond)
#define SPM_GET_APP_ID_FROM_CONF(i)				    ( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->ApplIntfID )
#define SPM_GET_BITMAPINDEX_FROM_CONF(i)		    ( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->BitMapIndex )
#define SPM_GET_SW_ID_FROM_CONF(i)				    ( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->PowPrfID )
#define SPM_GET_POW_PROF_NUMBER_FROM_CONF(i)	    ( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->PowPrfNum )
#define SPM_GET_LOC_ACT_ALLOWED_FROM_CONF(i)	    ( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->LocActAllowed )
#define SPM_GET_PROF_IS_LOC_FROM_CONF(i)	        ( SpmPowPrf_Cfg_WrpTable[(i)].powPrf_data->isLocal )

#define SPM_SIZE_ERROR_CODE_LIST 		SPM_CONF_POW_PRF_NUM
«IF AnyE0DEOrE0DFIsConfigured(spm.spmGeneral)-»
#define SPM_DID_E0DE_E0DF_QUEUE_SIZE_U				(5U)
#define SPM_DID_E0DE_E0DF_QUEUE_SIZE_L				(5U)
«ENDIF-»
/**
 *	\brief Macro to define the MAX size of the metadata
 */
# define SPM_METADAT_SIZE				(0x0AU)		/* SPM metadata len without padding in structure */
/* Number of variants */
