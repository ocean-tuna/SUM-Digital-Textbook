#define SPM_VLAN_COMMHNDL_SIZE		(«spm.spmGeneral.spmVLANCom.size»u)
/* Number of configured SD client services */
#define SPM_SD_CLIENT_SERVICE_CONFIG_NUM     (« Spm_GetUniqueSdClientServiceIds(sd.sdConfig.sdInstance.sdClientService).size »u)

typedef enum SpmDevicePowerStateCodeEnum{
	SPM_Faulted = 0x00u,
	SPM_Off,
	SPM_On,
	SPM_Reboot,
	SPM_ShutdownPending,
    SPM_Initializing,
	SPM_UnknownDevice = 0xFEu
} SpmDevicePowerStateCode;

typedef struct {
	uint32 PowPrfID;
	uint8  PowPrfNum;
	Spm_LowVoltPriorityLevel  LowVoltagePriority_VEH_OFF;
	Spm_LowVoltPriorityLevel  LowVoltagePriority_VEH_ON;
	uint16 TimeOutVehOff_inSecond;
	const uint16 * ApplIntfID;
	const uint16 * BitMapIndex;   /* Bit position value used for DID 0xE0DD*/
	boolean isLocal;
	boolean LocActAllowed;
	uint16 PrfDepLstSize;
	const SpmPrfDepLstType * PrfDepLst;
} SpmConfPowPrf;

typedef struct {
	SpmConfPowPrf const * 				powPrf_data;
	uint8 								modeSwitchTableTx_Len;
	Spm_Rte_SwitchPduGroup const *		modeSwitchTableTx_Data;
	uint8 								modeSwitchTableRx_Len;
	Spm_Rte_SwitchPduGroup const *		modeSwitchTableRx_Data;
} SpmPowPrf_Cfg_Wrp;


typedef SpmPowPrf_Cfg_Wrp SpmPowPrf_Cfg_WrpTableType[SPM_CONF_POW_PRF_NUM];

/* Array of SPM_CONF_POW_PRF_NUM items */
extern const SpmPowPrf_Cfg_WrpTableType SpmPowPrf_Cfg_WrpTable;




typedef uint8 SpmSduDataBuffType[8U];

typedef struct {
	const PduIdType 				pduId;
	PduInfoType						pduInfo;
} Spm_PduInfoTypeWrpp;

typedef struct{
	uint8 prfIndex;
	uint32 trgDvcIp;
	uint8 errorCode;
	uint32 swId;
    uint8 profileNumber;
}SpmFeedbackErrorItemType;

typedef struct{
	SpmFeedbackErrorItemType list[SPM_SIZE_ERROR_CODE_LIST];
	uint8 size;
}SpmFeedbackErrorListType;

/**
 * @brief SD Service Configuration Structure for Extended Learning Mode
 *        This structure holds service configuration data to support
 *        SPM integration with extended learning format
 */
typedef struct {
    uint16 serviceId;                /* Service ID */
    uint16 instanceId;               /* Service Instance ID */
    uint32 majorVersionsNum;         /* Number of major versions */
    const uint8* majorVersions;      /* Pointer to major versions array */
} Spm_SdServiceConfigType;

«IF Spm_ECU_INTERMEDIATE(spm) == true-»
	«IF spm.spmGeneral.spmCANWkUpFrmRef.spmCANWkUpFrmRxRef.size > 0 »
typedef struct {
	PduIdType pduId; /* PduId */
	uint32 	canIdLastByte; /* Last Byte of CAN ID associated to the Pdu */
} Spm_RxPduInfoType; 
extern const Spm_RxPduInfoType Spm_CanIf_Rx[];
	«ENDIF-»

