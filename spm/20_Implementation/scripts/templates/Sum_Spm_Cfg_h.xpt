/* PRQA S 3469 EOF # Macros are used for readability of the code */
/* PRQA S 3472 EOF # Macros are used for readability of the code */
#define SPM_SwMgrInfo_Req_ProfileID_SWID(src, dst, id)			((dst)->ProfileRequestPayLoad[(id)].ProfileID_SWID = (src)->ProfileRequestPayLoad[(id)].ProfileID_SWID)
#define SPM_SwMgrInfo_Req_ProfileID_ProfileNumber(src, dst, id) ((dst)->ProfileRequestPayLoad[(id)].ProfileID_ProfileNumber = (src)->ProfileRequestPayLoad[(id)].ProfileID_ProfileNumber)
#define SPM_SwMgrInfo_Req_RequestType(src, dst, id)				((dst)->ProfileRequestPayLoad[(id)].RequestType = (src)->ProfileRequestPayLoad[(id)].RequestType)

#define SPM_SwMgrInfo_Res_ProfileID_SWID(src, dst, id)			((dst)->RequestStatusProfileStatePayLoad[(id)].ProfileID_SWID = (src)->RequestStatusProfileStatePayLoad[(id)].ProfileID_SWID)
#define SPM_SwMgrInfo_Res_ProfileID_ProfileNumber(src, dst, id)	((dst)->RequestStatusProfileStatePayLoad[(id)].ProfileID_ProfileNumber = (src)->RequestStatusProfileStatePayLoad[(id)].ProfileID_ProfileNumber)
#define SPM_SwMgrInfo_Res_RequestStatus(src, dst, id)			((dst)->RequestStatusProfileStatePayLoad[(id)].RequestStatus = (src)->RequestStatusProfileStatePayLoad[(id)].RequestStatus)
#define SPM_SwMgrInfo_Res_ProfileStatus(src, dst, id)			((dst)->RequestStatusProfileStatePayLoad[(id)].ProfileStatus = (src)->RequestStatusProfileStatePayLoad[(id)].ProfileStatus)


/**
 * @brief	The function is the Top-Level one that is used in the SPM code to gateway/routing
 *          the communication handling to the right RTE APIs
 *
 * @param[in]		vlanId				Identifier of VLAN to reach in Tx/Rx
 * @param[in]		frameDirection		Code to address the direction of the communication (IN/OUT) - Look Spm_CommHanldeDirectionType
 * @param[in]		frameType			Code to address the frame type to handle (PwrMgrHeartbeat/PwrMgrWakeup/SwMgrInfo) - Look Spm_CommHandleFrameType
 * @param[inout]	data_hb				Pointer value to data structure for storing Heartbeat frame information
 * @param[inout]	data_wkup			Pointer value to data structure for storing Wakeup frame information
 * @param[inout]	data_sminfo			Pointer value to data structure for storing Software Manager frame information
 * @param[inout]	metadataPtr			Pointer to metadataPtr
 *
 * @return			Std_ReturnType
 * @retval			E_OK				Gateway and Rte API execution success
 * @retval			E_NOT_OK			Gateway and Rte API execution failed
 *
 * @note Remove the comment for the MISRA violation or modify the violation id
 * @note
 */
extern Std_ReturnType Spm_HandleVLANCommunication(
		uint16 				        const 		vlanId,
		Spm_CommHanldeDirectionType const		frameDirection,
		Spm_CommHandleFrameType     const	    frameType,
		SPM_HB_dt_Prv              *const 		data_hb,
		SPM_WkUp_dt_Prv			   *const 		data_wkup,
		SPM_dt_Prv				   *const 		data_sminfo,
		uint8                      *const 		metadataPtr
	);
«IF Spm_ExistMultipleVariantConfigured(spm) == false -»	
extern boolean Spm_GetHBFrameNeedsToBeSentOverThisVLAN(const uint16 vlanIndex);
«ENDIF-»	

#endif /* SUM_SPM_CFG_H */

