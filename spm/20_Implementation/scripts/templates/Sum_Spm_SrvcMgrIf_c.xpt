struct Spm_SrvcMgrIf_RAM_SubStruct Spm_SrvcMgrIf_RAM  = {
   /* struct element:'spmPrfStsMgr_SpmSrvcMgrIf_RAM.spmSrvcLstToSnd' (modeled as:'spmSrvcLstToSnd.spmPrfStsMgr_SpmSrvcMgrIf') */
   {«FOREACH spm.spmConfigSet.spmPowPrf AS pp SEPARATOR ", "»0U«ENDFOREACH»},
   /* struct element:'spmPrfStsMgr_SpmSrvcMgrIf_RAM.spmSrvLstToPublish_len' (modeled as:'spmSrvLstToPublish_len.spmPrfStsMgr_SpmSrvcMgrIf') */
   0U,
   /* struct element:'spmPrfStsMgr_SpmSrvcMgrIf_RAM.isChanged' (modeled as:'isChanged.spmPrfStsMgr_SpmSrvcMgrIf') */
   FALSE,
   /* substruct: spmPrfStsMgr_SpmSrvcMgrIf_RAM.spmSrvLst (modeled as:'spmSrvLst.spmPrfStsMgr_SpmSrvcMgrIf') */
   {
«FOREACH spm.spmConfigSet.spmPowPrf.sortBy(e|e.spmSrvcAndInstID * 256 + e.spmProfNumber) AS pp ITERATOR pos SEPARATOR "\t,\n" -»
      {
         /* struct element:'spmPrfStsMgr_SpmSrvcMgrIf_RAM.spmSrvLst[«pos.counter0»].pp_sID' (modeled as:'pp_sID.spmSrvLst.spmPrfStsMgr_SpmSrvcMgrIf') */
         «pp.spmSrvcAndInstID / 65536»U,
         /* struct element:'spmPrfStsMgr_SpmSrvcMgrIf_RAM.spmSrvLst[«pos.counter0»].is_active' (modeled as:'is_active.spmSrvLst.spmPrfStsMgr_SpmSrvcMgrIf') */
         FALSE
      }
