                            <ARRAY-VALUE-SPECIFICATION>
                              <ELEMENTS>
«FOREACH spm.spmConfigSet.spmPgttEntries.spmVariantCfg AS variant ITERATOR v-»
                                <ARRAY-VALUE-SPECIFICATION>
                                  <SHORT-LABEL>variant_«v.counter0»</SHORT-LABEL>
                                  <ELEMENTS>
«FOREACH variant.spmVariantIntermediateDstAddr AS itm-»
                                    <NUMERICAL-VALUE-SPECIFICATION>
                                      <SHORT-LABEL>intermediateNode_«Spm_ComputeIpAddr(itm)»</SHORT-LABEL>
                                      <VALUE>«Spm_ComputeIpAddr(itm)»</VALUE>
                                    </NUMERICAL-VALUE-SPECIFICATION>
«ENDFOREACH-»
                                  </ELEMENTS>
                                </ARRAY-VALUE-SPECIFICATION>
«ENDFOREACH-»
                              </ELEMENTS>
                            </ARRAY-VALUE-SPECIFICATION>
«ENDIF-»
                            <NUMERICAL-VALUE-SPECIFICATION>
                              <SHORT-LABEL>wdvc_«WkngDvc.shortName»_trgSize</SHORT-LABEL>
                              <VALUE>«spm.spmConfigSet.spmPgttEntries.spmTrgDvc.size»</VALUE>
                            </NUMERICAL-VALUE-SPECIFICATION>
                            <ARRAY-VALUE-SPECIFICATION>
                              <SHORT-LABEL>Trgt_trgDvc</SHORT-LABEL>
«FOREACH spm.spmConfigSet.spmPgttEntries.spmTrgDvc.sortBy(e|Spm_ComputeIpAddr( e.spmTrgDvcID.first() ) ) AS TargetRef ITERATOR target-»
                              <ELEMENTS>
                                <RECORD-VALUE-SPECIFICATION>
                                  <SHORT-LABEL>«TargetRef.shortName»_listIPsize</SHORT-LABEL>
