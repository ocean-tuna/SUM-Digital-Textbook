                                      <VALUE>«TargetRef.spmTrgDvcPowerOnDeviceWaitTimeBetweenOffandOnSequence»</VALUE>
                                    </NUMERICAL-VALUE-SPECIFICATION>
                                    <ARRAY-VALUE-SPECIFICATION>
                                      <SHORT-LABEL>«TargetRef.shortName»_WkUpVariantSeq</SHORT-LABEL>
«FOREACH spm.spmConfigSet.spmPgttEntries.spmVariantCfg AS variant ITERATOR v-»
«LET TargetRef.spmTrgDvcVariantHndlng.select(h | h.spmTrgDvcVariantRef == variant) AS varHndlng-»
                                      <ELEMENTS>
                                        <RECORD-VALUE-SPECIFICATION>
                                          <SHORT-LABEL>«TargetRef.shortName»_wkUpVariantSeq_«v.counter0»</SHORT-LABEL>
                                          <FIELDS>
                                            <NUMERICAL-VALUE-SPECIFICATION>
                                              <SHORT-LABEL>«TargetRef.shortName»_wkUpVariantSeq_«v.counter0»_Len</SHORT-LABEL>
«IF varHndlng.size > 0 && varHndlng.first().spmWkUpSeqRef != null -»
                                              <VALUE>«varHndlng.first().spmWkUpSeqRef.spmWkUpStep.size»</VALUE>
«ELSE -»
«IF TargetRef.spmTrgDvcVariantHndlng.size == 1 && TargetRef.spmTrgDvcVariantHndlng.first().spmWkUpSeqRef != null -»
                                              <VALUE>«TargetRef.spmTrgDvcVariantHndlng.first().spmWkUpSeqRef.spmWkUpStep.size»</VALUE>
«ELSE -»
                                              <VALUE>0</VALUE>
«ENDIF-»
«ENDIF-»
                                            </NUMERICAL-VALUE-SPECIFICATION>
                                            <ARRAY-VALUE-SPECIFICATION>
                                              <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»</SHORT-LABEL>
«IF varHndlng.size > 0 && varHndlng.first().spmWkUpSeqRef != null -»
«FOREACH varHndlng.first().spmWkUpSeqRef.spmWkUpStep.sortBy(e|e.spmStepID) AS Step ITERATOR i-»
                                              <ELEMENTS>
                                                <RECORD-VALUE-SPECIFICATION>
                                                  <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_itms</SHORT-LABEL>
                                                  <FIELDS>
                                                  <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_type</SHORT-LABEL>
                                                      <VALUE>«Spm_GetIntFromCmdType(Step.spmCommandType)»</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                    <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_com</SHORT-LABEL>
                                                      <VALUE>«Step.spmCommandValue»</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                    <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_dly</SHORT-LABEL>
                                                      <VALUE>«Step.spmSeqStepDly»</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                  </FIELDS>
                                                </RECORD-VALUE-SPECIFICATION>
                                              </ELEMENTS>
«ENDFOREACH-»
«ELSE -»
«IF TargetRef.spmTrgDvcVariantHndlng.size == 1 && TargetRef.spmTrgDvcVariantHndlng.first().spmWkUpSeqRef != null -»
«FOREACH TargetRef.spmTrgDvcVariantHndlng.first().spmWkUpSeqRef.spmWkUpStep.sortBy(e|e.spmStepID) AS Step ITERATOR i-»
                                              <ELEMENTS>
                                                <RECORD-VALUE-SPECIFICATION>
                                                  <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_itms</SHORT-LABEL>
                                                  <FIELDS>
                                                  <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_type</SHORT-LABEL>
                                                      <VALUE>«Spm_GetIntFromCmdType(Step.spmCommandType)»</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                    <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_com</SHORT-LABEL>
                                                      <VALUE>«Step.spmCommandValue»</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                    <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_«i.counter0»_dly</SHORT-LABEL>
                                                      <VALUE>«Step.spmSeqStepDly»</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                  </FIELDS>
                                                </RECORD-VALUE-SPECIFICATION>
                                              </ELEMENTS>
«ENDFOREACH-»
«ELSE -»
                                              <ELEMENTS>
                                                <RECORD-VALUE-SPECIFICATION>
                                                  <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_0_itms</SHORT-LABEL>
                                                  <FIELDS>
                                                    <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_0_type</SHORT-LABEL>
                                                      <VALUE>0</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                    <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_0_com</SHORT-LABEL>
                                                      <VALUE>0</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                    <NUMERICAL-VALUE-SPECIFICATION>
                                                      <SHORT-LABEL>from_«WkngDvc.shortName»_to_«TargetRef.shortName»_wkUpPath_v«v.counter0»_0_dly</SHORT-LABEL>
                                                      <VALUE>0</VALUE>
                                                    </NUMERICAL-VALUE-SPECIFICATION>
                                                  </FIELDS>
                                                </RECORD-VALUE-SPECIFICATION>
                                              </ELEMENTS>
«ENDIF-»
«ENDIF -»
                                            </ARRAY-VALUE-SPECIFICATION>
                                          </FIELDS>
                                        </RECORD-VALUE-SPECIFICATION>
                                      </ELEMENTS>
«ENDLET-»
«ENDFOREACH-»
                                    </ARRAY-VALUE-SPECIFICATION>
