                                      <SHORT-LABEL>«TargetRef.shortName»_timeout</SHORT-LABEL>
                                      <VALUE>«TargetRef.spmTrgDvcDtcTimeOut»</VALUE>
                                    </NUMERICAL-VALUE-SPECIFICATION>
