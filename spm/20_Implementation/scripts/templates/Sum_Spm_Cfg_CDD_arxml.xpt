  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>SumSpm</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>SwComponent</SHORT-NAME>
          <ELEMENTS>
            <COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE>
              <SHORT-NAME>SPM</SHORT-NAME>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="Master">
                    <SD>true</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>

                <R-PORT-PROTOTYPE UUID="b63f7ce4-eb20-4959-94d8-40fa7a68b256">
                  <SHORT-NAME>RP_SUSD_SPM_PerExec</SHORT-NAME>
                   <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUSD_PermitExecution</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>

                <R-PORT-PROTOTYPE UUID="b63f7ce4-eb20-4959-94d8-40fa7a68b257">
                  <SHORT-NAME>RP_SUSD_SPM_VehiclePowerMode</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUSD_VehiclePowerMode</REQUIRED-INTERFACE-TREF>
                  <REQUIRED-COM-SPECS>
                    <NONQUEUED-RECEIVER-COM-SPEC>
                    <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/SUSD_VehiclePowerMode/VehiclePowerMode</DATA-ELEMENT-REF>
                    <HANDLE-NEVER-RECEIVED>true</HANDLE-NEVER-RECEIVED>
                    </NONQUEUED-RECEIVER-COM-SPEC>
                  </REQUIRED-COM-SPECS>
                </R-PORT-PROTOTYPE>

              «IF Spm_IsLowVoltPrioServiceConfigured(spm.spmConfigSet.spmLowVoltagePowerInfo)-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSFM_SPM_LowVoltSwActPrioReqAvailability</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/RxMonitoredSignal_Av</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>

                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_Com_Spm_LowVoltSwActPrioReq</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/SPM_LowVoltSwActPrioReq</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>

                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SPM_NvmService_LowVoltageActivationPriority</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_NvM/PortInterfaces/NvMService</REQUIRED-INTERFACE-TREF>
				        </R-PORT-PROTOTYPE>
				       «ENDIF-»

                <P-PORT-PROTOTYPE UUID="5a9bd8cf-580f-43b9-8815-827b9e8a67b3">
                  <SHORT-NAME>PP_SPM_SUSD_ShutDown</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SPM_ShutdownPermission</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>

                <P-PORT-PROTOTYPE UUID="17a5586b-c733-4d03-b34b-4456d7c96c75">
                  <SHORT-NAME>PP_SPM_RequestProfile</SHORT-NAME>
                  <PROVIDED-COM-SPECS>
                    <SERVER-COM-SPEC>
                      <OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/PortInterfaces/CS_SPM_ProfileRequest/SPM_ActivateProfile</OPERATION-REF>
                      <QUEUE-LENGTH>«Spm_GetLocalRequestsQueueLength(spm)»</QUEUE-LENGTH>
                    </SERVER-COM-SPEC>
                  </PROVIDED-COM-SPECS>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/PortInterfaces/CS_SPM_ProfileRequest</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>

                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_RequestProfile_Deact</SHORT-NAME>
                  <!-- [$Satisfies $DDS_SPM 0031] -->
                  <PROVIDED-COM-SPECS>
                    <SERVER-COM-SPEC>
                      <OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/PortInterfaces/CS_SPM_ProfileRequest/SPM_DeactivateProfile</OPERATION-REF>
                      <QUEUE-LENGTH>«Spm_GetLocalRequestsQueueLength(spm)»</QUEUE-LENGTH>
                    </SERVER-COM-SPEC>
                  </PROVIDED-COM-SPECS>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/PortInterfaces/CS_SPM_ProfileRequest</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«FOREACH spm.spmGeneral.spmVLANCom AS vlan -»
<!-- BEGIN: Modified at scope of GMSUM-9873 / GMSUM-10878 -->
				<!-- Port for PwrMgr heartbeat communication -->
					<!-- Transmission -->
				«IF vlan.spmVLANComPwrMgrHeartbeat != null && vlan.spmVLANComPwrMgrHeartbeat.spmPwrMgrHeartbeatTxSendRecvIntRef_Foreign != null -»
				<P-PORT-PROTOTYPE UUID="da437e5d-e485-401e-bb66-154a62def443">
                  <SHORT-NAME>PP_SPM_«vlan.shortName»_PwrMgrHeartbeatTx</SHORT-NAME>

                  <PROVIDED-COM-SPECS>
                	<NONQUEUED-SENDER-COM-SPEC>
                  		<SENDER-INTENT>WILL-SEND</SENDER-INTENT>
                	</NONQUEUED-SENDER-COM-SPEC>
              	  </PROVIDED-COM-SPECS>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«vlan.spmVLANComPwrMgrHeartbeat.spmPwrMgrHeartbeatTxSendRecvIntRef_Foreign.toString()»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
				«ENDIF -»
				<!-- Reception -->
        «IF Spm_PwrMgrHeartbeatRxIsConfigured(vlan) -»
          «FOREACH  vlan.spmVLANComPwrMgrHeartbeat.spmPwrMgrHeartbeatRxSendRecvIntRef AS hbRx ITERATOR i-»
				      <R-PORT-PROTOTYPE UUID="691dbeee-36f5-4839-9d15-31f24409d671"> 
                <SHORT-NAME>RP_SPM_«vlan.shortName»_PwrMgrHeartbeatRx«i.counter0»</SHORT-NAME>
                <REQUIRED-COM-SPECS>
                  <QUEUED-RECEIVER-COM-SPEC>
                    <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">«hbRx.toString()»/«Spm_GetNameVarDataProtoTypeFromNamingConv(hbRx.toString())»</DATA-ELEMENT-REF>
                    «REM»<DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">«vlan.spmVLANComPwrMgrHeartbeat.spmHbRxAbsPth»/«vlan.shortName»_PwrMgrHeartbeatRx_Evt/«vlan.shortName»_PwrMgrHeartbeatRx_Evt</DATA-ELEMENT-REF>«ENDREM»   
                    <QUEUE-LENGTH>«Spm_GetPmHeartbeatFrameQueueLength(spm)»</QUEUE-LENGTH>
                  </QUEUED-RECEIVER-COM-SPEC>
                </REQUIRED-COM-SPECS>
                «REM»<REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«vlan.spmVLANComPwrMgrHeartbeat.spmHbRxAbsPth»/«vlan.shortName»_PwrMgrHeartbeatRx_Evt</REQUIRED-INTERFACE-TREF>«ENDREM»
                <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«hbRx.toString()»</REQUIRED-INTERFACE-TREF>
              </R-PORT-PROTOTYPE>
				  «ENDFOREACH -»
        «ENDIF -»
				<!-- Port for SwrMgr Info communication -->
        <!-- Transmission -->
				«IF vlan.spmVLANComSwrMgrInfo != null && vlan.spmVLANComSwrMgrInfo.spmSwMgrInfoTxSendRecvIntRef_Foreign != null -»
				<P-PORT-PROTOTYPE UUID="da437e5d-e485-401e-bb66-154a62def443">
                  <SHORT-NAME>PP_SPM_«vlan.shortName»_SwMgrInfoTx</SHORT-NAME>
                  <PROVIDED-COM-SPECS>
                	<NONQUEUED-SENDER-COM-SPEC>
                  		<SENDER-INTENT>WILL-SEND</SENDER-INTENT>
                	</NONQUEUED-SENDER-COM-SPEC>
              	  </PROVIDED-COM-SPECS>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«vlan.spmVLANComSwrMgrInfo.spmSwMgrInfoTxSendRecvIntRef_Foreign.toString()»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
				«ENDIF -»
					<!-- Reception -->
				«IF vlan.spmVLANComSwrMgrInfo != null && vlan.spmVLANComSwrMgrInfo.spmSwMgrInfoRxSendRecvIntRef_Foreign != null -»
				<R-PORT-PROTOTYPE UUID="691dbeee-36f5-4839-9d15-31f24409d671">
                  <SHORT-NAME>RP_SPM_«vlan.shortName»_SwMgrInfoRx</SHORT-NAME>
                  <REQUIRED-COM-SPECS>
                  	<QUEUED-RECEIVER-COM-SPEC>
                  		<DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">«vlan.spmVLANComSwrMgrInfo.spmSwMgrInfoRxSendRecvIntRef_Foreign.toString()»</DATA-ELEMENT-REF>
                  		<QUEUE-LENGTH>«Spm_GetSmFrameQueueLength(spm)»</QUEUE-LENGTH>
                  	</QUEUED-RECEIVER-COM-SPEC>
                  </REQUIRED-COM-SPECS>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«vlan.spmVLANComSwrMgrInfo.spmSwMgrInfoRxSendRecvIntRef_Foreign.toString()»</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
				«ENDIF -»
				<!-- Port for PwrMgr wakeup (ETH) Info communication -->
					<!-- Transmission -->
				«IF vlan.spmVLANComPwrMgrWakeupFrames != null && vlan.spmVLANComPwrMgrWakeupFrames.spmPwrMgrWakeupTxSendRecvIntRef_Foreign != null -»
				<P-PORT-PROTOTYPE UUID="da437e5d-e485-401e-bb66-154a62def443">
                  <SHORT-NAME>PP_SPM_«vlan.shortName»_PwrMgrWakeupTx</SHORT-NAME>
                  <PROVIDED-COM-SPECS>
                	<NONQUEUED-SENDER-COM-SPEC>
                  		<SENDER-INTENT>WILL-SEND</SENDER-INTENT>
                	</NONQUEUED-SENDER-COM-SPEC>
              	  </PROVIDED-COM-SPECS>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«vlan.spmVLANComPwrMgrWakeupFrames.spmPwrMgrWakeupTxSendRecvIntRef_Foreign.toString()»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
				«ENDIF -»
					<!-- Reception -->
				«IF vlan.spmVLANComPwrMgrWakeupFrames != null && vlan.spmVLANComPwrMgrWakeupFrames.spmPwrMgrWakeupRxSendRecvIntRef_Foreign != null -»
				<R-PORT-PROTOTYPE UUID="691dbeee-36f5-4839-9d15-31f24409d671">
                  <SHORT-NAME>RP_SPM_«vlan.shortName»_PwrMgrWakeupRx</SHORT-NAME>
                  <REQUIRED-COM-SPECS>
                  	<QUEUED-RECEIVER-COM-SPEC>
                  		<DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">«vlan.spmVLANComPwrMgrWakeupFrames.spmPwrMgrWakeupRxSendRecvIntRef_Foreign.toString()»/«Spm_GetNameVarDataProtoTypeFromNamingConv(vlan.spmVLANComPwrMgrWakeupFrames.spmPwrMgrWakeupRxSendRecvIntRef_Foreign.toString())»</DATA-ELEMENT-REF>
                  		<QUEUE-LENGTH>«Spm_GetEthWakeupUniFrameQueueLength(spm)»</QUEUE-LENGTH>
                  	</QUEUED-RECEIVER-COM-SPEC>
                  </REQUIRED-COM-SPECS>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«vlan.spmVLANComPwrMgrWakeupFrames.spmPwrMgrWakeupRxSendRecvIntRef_Foreign.toString()»</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
				«ENDIF -»
<!-- END: Modified at scope of GMSUM-9873 / GMSUM-10878 -->
        <!-- Port for PwrMgr wakeup Mutlticast(ETH) Info communication -->
					<!-- Reception -->
				«IF vlan.spmVLANComPwrMgrWakeupFramesMulticast != null && vlan.spmVLANComPwrMgrWakeupFramesMulticast.spmPwrMgrWakeupRxSendRecvIntMulticastRef_Foreign != null -»
				<R-PORT-PROTOTYPE UUID="691dbeee-36f5-4839-9d15-31f24409d671">
          <SHORT-NAME>RP_SPM_«vlan.shortName»_PwrMgrWakeupRx_Multicast</SHORT-NAME>
          <REQUIRED-COM-SPECS>
          	<QUEUED-RECEIVER-COM-SPEC>
          		<DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">«vlan.spmVLANComPwrMgrWakeupFramesMulticast.spmPwrMgrWakeupRxSendRecvIntMulticastRef_Foreign.toString()»/«Spm_GetNameVarDataProtoTypeFromNamingConv(vlan.spmVLANComPwrMgrWakeupFramesMulticast.spmPwrMgrWakeupRxSendRecvIntMulticastRef_Foreign.toString())»</DATA-ELEMENT-REF>
          		<QUEUE-LENGTH>«Spm_GetEthWakeupMultiFrameQueueLength(spm)»</QUEUE-LENGTH>
          	</QUEUED-RECEIVER-COM-SPEC>
          </REQUIRED-COM-SPECS>
          <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">«vlan.spmVLANComPwrMgrWakeupFramesMulticast.spmPwrMgrWakeupRxSendRecvIntMulticastRef_Foreign.toString()»</REQUIRED-INTERFACE-TREF>
        </R-PORT-PROTOTYPE>
				«ENDIF -»
«ENDFOREACH -»

                <!-- [$Satisfies $DDS_SPM 0625] -->
«IF GetDIDE0DDIsConfigured(spm.spmGeneral)-»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_DCM_DID_E0DD_ActivationProfileActivationStatus</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«GetDidE0DDData(spm.spmGeneral)»</PROVIDED-INTERFACE-TREF>
			          </P-PORT-PROTOTYPE>
«ENDIF-»
                <P-PORT-PROTOTYPE UUID="b5a26a65-bedc-4828-b421-3b00b6d3b7d7">
                  <SHORT-NAME>PP_SPM_SSFM_GetDTCId</SHORT-NAME>
                  <PROVIDED-COM-SPECS>
                    <SERVER-COM-SPEC>
                      <OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/GM_SUM/Interfaces/SPM_GetDTCIdentifier/GetDTCIdentifier</OPERATION-REF>
                      <QUEUE-LENGTH>«Spm_GetLocalRequestsQueueLength(spm)»</QUEUE-LENGTH>
                    </SERVER-COM-SPEC>
                  </PROVIDED-COM-SPECS>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SPM_GetDTCIdentifier</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>

                <P-PORT-PROTOTYPE UUID="f3651c72-b27b-4c39-a171-9e7de1a9e65e">
                  <SHORT-NAME>PP_SPM_SrvcMgr_Notif</SHORT-NAME>
                  <!-- [$Satisfies $DDS_SPM 0417] -->
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SPM_ServiceActivationStatusNotification</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
				<!-- BswM interfaces -->
«FOREACH spm.spmConfigSet.spmPowPrf.spmComIPduGroupEvnt_Tx.toSet() AS pduGr -»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_BswM_ComIpduGroup_«pduGr.shortName»</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/PortInterfaces/SPM_ComIpduGroup</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDFOREACH -»
«FOREACH spm.spmConfigSet.spmPowPrf.spmComIPduGroupEvnt_Rx.toSet() AS pduGr -»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_BswM_ComIpduGroup_«pduGr.shortName»</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/PortInterfaces/SPM_ComIpduGroup</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDFOREACH»
				<P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_SerDatMon_LoNInd</SHORT-NAME>
                  <!-- Aligned at specification SDV-8217 v27.27.174.0p1
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/PortInterfaces/SR_SPM_LossOfNodeIndic</PROVIDED-INTERFACE-TREF>
                  -->
                  <!-- Aligned at specification SDV-8217 older version -->
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SPM_LossOfNodeIndication</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                 <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SPM_SrvcMgr_ActivateSrvc</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SrvcMgr_SPM_ActivateServices</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>

                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SUSD_SPM_UpdateRecord</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SUSD_SPM_UpdateRecord</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>

«IF Spm_ExistMultipleVariantConfigured(spm) == true -»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SPM_GetDeviceVariantInfo</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SWC_GetDeviceVariantInfo</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ENDIF-»

                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_RequestStatusProfileState</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/PortInterfaces/CS_SPM_RequestStatusProfileState</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_ProfileActivationPermission</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/PortInterfaces/CS_SPM_ProfileActivationPermission</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_SUSD_ActivityRecordCmd</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SPM_SUSD_ActivityRecordCmd</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>

           		<!-- [$DDS_SPM 0629: Definition of Port that handles interface for DID 0xE0DE with Dcm][$Satisfies $SRS_SPM 0227] -->
«IF spm.spmGeneral.spmDiagnostic != null -»
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
				<R-PORT-PROTOTYPE>
				  <SHORT-NAME>RP_SPM_Dcm_E0DE_Write</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_NvM/PortInterfaces/NvMService</REQUIRED-INTERFACE-TREF>
				</R-PORT-PROTOTYPE>
«ENDIF -»
«IF GetDIDE0DFIsConfigured(spm.spmGeneral)-»
				<R-PORT-PROTOTYPE>
				  <SHORT-NAME>RP_SPM_Dcm_E0DF_Write</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_NvM/PortInterfaces/NvMService</REQUIRED-INTERFACE-TREF>
				</R-PORT-PROTOTYPE>
«ENDIF -»
«IF spm.spmGeneral.spmDiagnostic.spmDID0xE0DEDcmRef != null -»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_Dcm_DataDidE0DE</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«spm.spmGeneral.spmDiagnostic.spmDID0xE0DEDcmRef.dcmDspDidSignal.first().dcmDspDidDataRef.shortName»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDIF -»
«IF spm.spmGeneral.spmDiagnostic.spmDID0xE0DFDcmRef != null -»
                <!-- [$DDS_SPM 0630: Definition of Port that handles interface for DID 0xE0DF with Dcm][$Satisfies $SRS_SPM 0228] -->
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_Dcm_DataDidE0DF</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«spm.spmGeneral.spmDiagnostic.spmDID0xE0DFDcmRef.dcmDspDidSignal.first().dcmDspDidDataRef.shortName»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDIF -»
«ENDIF -»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SPM_BswM_CommunicationReady</SHORT-NAME>
                  <REQUIRED-COM-SPECS>
                    <MODE-SWITCH-RECEIVER-COM-SPEC>
                      <SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>true</SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>
                    </MODE-SWITCH-RECEIVER-COM-SPEC>
                  </REQUIRED-COM-SPECS>
                  <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/PortInterfaces/SPM_PI_CommuincationReady</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_SPM_SrvcMgr_SdLearningStatusIndication</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SPM_SDLearningStatusIndication</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
              </PORTS>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR UUID="2d9a01a2-640e-40e3-8cf7-e9667df7abc3">
                  <SHORT-NAME>SumSpm_IB</SHORT-NAME>
		  		  <!-- DataType mapping set -->
                  <DATA-TYPE-MAPPING-REFS>
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/Infrastructure/DTMS_SPM_SrvcPduGroup</DATA-TYPE-MAPPING-REF>
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/PortInterfaces/SystemDataTypeMappingSets</DATA-TYPE-MAPPING-REF>
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/Infrastructure/DTMS_SPM_CommunicationReady</DATA-TYPE-MAPPING-REF>     
                  «IF Spm_IsLowVoltPrioServiceConfigured(spm.spmConfigSet.spmLowVoltagePowerInfo)-»  
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">«spm.spmConfigSet.spmLowVoltagePowerInfo.spmLowVoltSwActPrioReqDataTypeMappingSet»</DATA-TYPE-MAPPING-REF>
                  «ENDIF -»
                  </DATA-TYPE-MAPPING-REFS>
                  <EVENTS>
