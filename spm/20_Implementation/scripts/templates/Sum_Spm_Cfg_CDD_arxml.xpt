                      <INIT-VALUE>
                        <RECORD-VALUE-SPECIFICATION>
                          <SHORT-LABEL>wdvc_«WkngDvc.shortName»</SHORT-LABEL>
                          <FIELDS>
«IF Spm_ReturnSizeIntermediateList(spm) > 0-»
                            <NUMERICAL-VALUE-SPECIFICATION>
                              <SHORT-LABEL>wdvc_«WkngDvc.shortName»_IntermediateNodeIPSize</SHORT-LABEL>
