                                    <NUMERICAL-VALUE-SPECIFICATION>
                                      <SHORT-LABEL>«WkngDvc.shortName»_trgSize</SHORT-LABEL>
                                      <VALUE>«TargetRef.spmTrgDvcID.size»</VALUE>
                                    </NUMERICAL-VALUE-SPECIFICATION>
                                    <ARRAY-VALUE-SPECIFICATION>
                                      <ELEMENTS>
«FOREACH TargetRef.spmTrgDvcID AS itm-»
                                        <NUMERICAL-VALUE-SPECIFICATION>
                                          <SHORT-LABEL>«TargetRef.shortName»_trgdvcitem_«Spm_ComputeIpAddr(itm)»</SHORT-LABEL>
                                          <VALUE>«Spm_ComputeIpAddr(itm)»</VALUE>
                                        </NUMERICAL-VALUE-SPECIFICATION>
«ENDFOREACH-»
                                      </ELEMENTS>
                                    </ARRAY-VALUE-SPECIFICATION>
