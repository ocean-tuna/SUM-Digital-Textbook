«LET spm.spmConfigSet.spmPgttEntries.spmWkngDvc AS WkngDvc-»
                    <PARAMETER-DATA-PROTOTYPE>
                      <SHORT-NAME>TrgDvcs_«WkngDvc.shortName»</SHORT-NAME>
