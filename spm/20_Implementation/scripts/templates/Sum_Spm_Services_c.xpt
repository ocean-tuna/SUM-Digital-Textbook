/**
 * @brief Function to perform the validation and triggering of the selective wake-up
 *		  after an deactivation request
 *
 * @param[in]  ApplicationInterfaceID: ID corresponding to a particular profile
 * @param[out] ProfileState: The state of the requested profile
 *
 * @return E_OK     : Profile has been found and the state is retrieved
 * @return E_NOT_OK : The profile could not be found
 */
/* [$Satisfies $DDS_SPM 0541] */
/*PRQA S 1503 2 # This function will be called by an extern module. */
FUNC(Std_ReturnType, SPM_CODE) SPM_GetProfileState(uint16 ApplicationInterfaceID,
                                                   uint8 * ProfileState){
	Std_ReturnType retVal = E_NOT_OK;
/* Corner Case handling: SPM without profile configuration */
#if SPM_CONTAINS_PP
	sint16 profileIndex;

	profileIndex = Spm_GetPowProfIndexFromAppID(ApplicationInterfaceID);
	if(profileIndex != SPM_INVALID){
		*ProfileState = SPM_PrfStsMgr_RAM[(uint8)profileIndex].sm;
		retVal = E_OK;
	}
#else
	((void)ApplicationInterfaceID);

#endif

	return retVal;
}
