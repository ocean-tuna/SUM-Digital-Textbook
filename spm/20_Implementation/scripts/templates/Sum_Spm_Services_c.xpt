/**
 * @brief Function to read current status of the profile activation permission
 *
 * This function allows SWCs to check if a power profile can be activated locally
 * based on its ApplicationInterfaceID.
 *
 * @param[in]  ApplicationInterfaceID: ID corresponding to a particular profile
 * @param[out] PermissionStatus: TRUE - Activation allowed, FALSE - Activation not allowed
 *
 * @return E_OK     : Profile has been found and permission status is retrieved
 * @return E_NOT_OK : The profile could not be found
 */
/* [$Satisfies $DDS_SPM 0542] */
/*PRQA S 1503 2 # This function will be called by an extern module. */
FUNC(Std_ReturnType, SPM_CODE) SPM_GetProfileActivationPermission(uint16 ApplicationInterfaceID,
                                                                  boolean *PermissionStatus){
	Std_ReturnType retVal = E_NOT_OK;

/* Corner Case handling: SPM without profile configuration */
#if SPM_CONTAINS_PP
	sint16 profileIndex;

	profileIndex = Spm_GetPowProfIndexFromAppID(ApplicationInterfaceID);
	if(profileIndex != SPM_INVALID){
		*PermissionStatus = Spm_Get_ActivationAvailabilityForLocalRequest((uint8)profileIndex);
		retVal = E_OK;
	} else {
		*PermissionStatus = FALSE;
	}
#else
	*PermissionStatus = FALSE;
	((void)ApplicationInterfaceID);
#endif

	return retVal;
}
#define SPM_STOP_SEC_CODE
#include "SPM_MemMap.h"

#define SPM_START_SEC_CODE
#include "SPM_MemMap.h"
/**
 * @brief Function to allow SM to inhibit activation of Power Profile during an active Learning Session.
 *        This is needed in order to reduce the traffic over the ETH network when a new learning session start.
 *
 * @param  learningStatus: ID referring to the current Learning Session status
 *
 *
 * @return E_OK     : request accepted after validation
 * @return E_NOT_OK : request not accepted after the validation
 */
/* [$Satisfies $DDS_SPM 0653] */
/*PRQA S 1503 2 # This function will be called by an extern module. */
FUNC(Std_ReturnType, SPM_CODE)
Runnable_SPM_SdLearningStatusIndication(VAR(SPM_SDLearningStatus, AUTOMATIC) learningStatus) {
	Std_ReturnType retVal = E_OK;
    uint8 i;
	SPM_SDLearningStatus previousLearningStatus = Rte_IrvRead_RE_SPM_SrvcMgr_SdLearningStatusIndication_Spm_Learning_Status();

    /* If receive a new Learning Session status == SUM_LRNG_PENDING while before we were on a state
	 * != SUM_LRNG_PENDING, then it means a new Learning Session has started and we have to reject Activations.
	 */
	if( (SUM_LRNG_PENDING == learningStatus) && (SUM_LRNG_PENDING != previousLearningStatus) )
	{
		/* If status is SUM_LRNG_PENDING we set the IRV immediately to avoid Activations from concurrent thread */
		/* [$Satisfies $DDS_SPM 0654] */
		Rte_IrvWrite_RE_SPM_SrvcMgr_SdLearningStatusIndication_Spm_Learning_Status((learningStatus));
		for(i = 0u; i < SPM_CONF_POW_PRF_NUM; i++){
			Spm_SendDeactivationRequestForEachRequester(i, (uint8)Spm_REJECTED_PROFILE_BLOCKED);
		}

		/*  HNLDR: Update Profile Status by Profile Status Manager. */
		Spm_DequeueReqActionHandler();

		/* HNDLR: Start Deactivation Path. */
		Spm_FSMManger();

		/* Handler function for sending the Req Prof Activation Packet; */
		Spm_SoftwMgr_PopulateSMFrame();
	}
	/* The new Learning Session status is != SUM_LRNG_PENDING, but before we were in a SUM_LRNG_PENDING state,
	 * it means the Learning session has ended.
	 */
	else if( (SUM_LRNG_PENDING == previousLearningStatus) && (SUM_LRNG_PENDING != learningStatus) ) {
		/*
		 * This transition means that a running Learning Session has completed, therefore we ask SD for remote TargetDevices IPs
		 * in case they got updated.
		 */
		SPM_PM_Init_ProfilesStructs();
		/* If we are transitioning from SUM_LRNG_PENDING to any other state that allows PwrPrf Activation,
		 * then we have to wait until we updated TargetDevices IPs before updating the IRV. This is
		 * because we want to avoid dealing with Activations until TrgDevIPs have been updated.
		*/
		Rte_IrvWrite_RE_SPM_SrvcMgr_SdLearningStatusIndication_Spm_Learning_Status((learningStatus));
	}
	else {
		/* We just update the Learning Session status for consistency but is not a critical transition*/
		Rte_IrvWrite_RE_SPM_SrvcMgr_SdLearningStatusIndication_Spm_Learning_Status((learningStatus));
	}

	return retVal;
}
#define SPM_STOP_SEC_CODE
#include "SPM_MemMap.h"

/**
 * @brief Dispatches a power profile request to the software manager and manages its dependencies.
 *
 * This function uses a Breadth-First Search (BFS) algorithm to traverse and enqueue power profile
 * requests and their dependencies to the software manager's queue. It starts from the root power
 * profile specified by the profileID and traverses through its dependencies, enqueuing each one.
 * It also updates the request status based on the success of the enqueue operation.
 *
 * @param[in] profileID   The ID of the power profile for which the request is being made.
 * @param[in] TrgDvcIP    The IP address of the target device making the request.
 * @param[in] reqCode     The request code specifying the type of power profile request.
 * @param[out] retVal     Pointer to a variable where the function will store the result of the request
 *                        dispatch operation (E_OK for success, E_NOT_OK for failure).
 *
 * @note The `visited` array is used to prevent cycles in the graph traversal, and the `queue` is used
 * 		 to manage the BFS algorithm. The function modifies the pointed `retVal` to reflect the success
 * 		 or failure of the request dispatch.
 *
 * @retval None This function does not have a return value; it communicates the result through the
 *              `retVal` output parameter.
 */
void Spm_prv_prfReqDispatcher(
    /* IN  */ uint8  profileIndx,
    /* IN  */ uint32 TrgDvcIP,
    /* IN  */ uint8 reqCode,
    /* OUT */ Std_ReturnType * const retVal
) {
    Std_ReturnType retVal_loc = E_OK;
    uint16 i;
    boolean visited[SPM_CONF_POW_PRF_NUM];

    /* Create a queue used by the BFS. */
    SpmPrfDepLstType queue[SPM_CONF_POW_PRF_NUM];
    uint32 front = 0u;
    uint32 rear = 0u;
    uint32 indexDep;
    struct SPM_ProfileReqItm Sum_Spm_PwrPrf_Item;

    for (i = 0u; i < SPM_CONF_POW_PRF_NUM; i++) {
        visited[i] = FALSE;
    }

    /* Set the Root PowProf index as visited and enqueue its index. */
    visited[profileIndx] = TRUE;
    queue[rear].prfDepType = SPM_PRF_DEP_ACT_AND_CONS;
    queue[rear].prfIndex = profileIndx;
    rear++;

    while (front != rear) {

        /* Add the TrgDvcIP as requester. */
        Sum_Spm_PwrPrf_Item.TrgDvcIpRequester = TrgDvcIP;
        Sum_Spm_PwrPrf_Item.reqDependencyType = queue[front].prfDepType;
        /* Update Profile Map. Reduce amount of cyclic research for the current profile. */
        Sum_Spm_PwrPrf_Item.posOfPrfInCfgArray = queue[front].prfIndex;
        /* If the first Power Profile is the root (front == 0), set the MSB to 1. Otherwise, keep only the request type (LSB), since going to extrapolate informations about the Power Profile dependencies. */
		Sum_Spm_PwrPrf_Item.reqCode = reqCode | (uint8)(((front == 0u) ? 1u : 0u) << 7u);

        /* IF enqueue operation to Software Manager fail, THEN it cannot tale in charge the request. Reply with a fail */
        if( !SPM_EnqueueRequest(&Sum_Spm_RequestQueue, Sum_Spm_PwrPrf_Item) ) {
            retVal_loc = E_NOT_OK;
            break;
        }

        /* Iterate over all the PowProf dependencies of this PowProf and enqueue them. */
        for (indexDep = 0; indexDep < SpmPowPrf_Cfg_WrpTable[queue[front].prfIndex].powPrf_data->PrfDepLstSize; indexDep++) {

            if (!visited[SpmPowPrf_Cfg_WrpTable[queue[front].prfIndex].powPrf_data->PrfDepLst[indexDep].prfIndex]) {
                visited[SpmPowPrf_Cfg_WrpTable[queue[front].prfIndex].powPrf_data->PrfDepLst[indexDep].prfIndex] = TRUE;
                queue[rear].prfIndex = (SpmPowPrf_Cfg_WrpTable[queue[front].prfIndex].powPrf_data->PrfDepLst[indexDep]).prfIndex;
                queue[rear].prfDepType = (SpmPowPrf_Cfg_WrpTable[queue[front].prfIndex].powPrf_data->PrfDepLst[indexDep]).prfDepType;
                rear++;
            }
        }

        /* Enqueue a PowProf Index */
        front++;
    }

    *(retVal) = retVal_loc;
}

/* EOF */

«ENDFILE-»
«ENDDEFINE-»