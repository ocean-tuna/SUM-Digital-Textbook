/**
 * @brief The function populates the Record struct to forward to the SUSD.
 *
 * @param[in]  recordId	enum that describes the RxID value.
 * @param[in]  lastByteVal	value of the last byte  CanId or SrcIp address. (Valid only for RID 0x26)
 * @param[out] current_status	Boolean indicating the:
 *                           	*   status of the local or remote requests for RID 0x02 and 0x20
 *						   		*  Spm_OwnWakeUpBit status, TRUE if the bit in the WUF is asserted, FALSE otherwise; for RID 0x26
 */
static void Spm_E0D7_Sender(boolean current_status, RID_Enum recordId, uint8 lastByteVal)
{
	RecordIdType record;

	/* [$Satisfies $DDS_SPM 0605] *//* [$Satisfies $DDS_SPM 0606] */
	record.RID = recordId;
	record.state = current_status;
	/* The record wake-up reason field contains a valid value for RID 0x26. For the other RIDs, set to 0, as it is not used */
	record.RWR = lastByteVal;

	/* [$Satisfies $DDS_SPM 0600] *//* [$Satisfies $DDS_SPM 0601] *//* [$Satisfies $DDS_SPM 0603]*//* [$Satisfies $DDS_SPM 0602] *//* [$Satisfies $DDS_SPM 0604] */
	/* Forward the necessary information, for the DID 0xE0D7, to the SUSD */
	(void)Rte_Call_RP_SUSD_SPM_UpdateRecord_UpdateRecord(&record);
}

/**
 * @brief Check if the presence of local/remote request has changed since last
 * 		   time, as part of DID E0D7; if so, notify SUSD with the new status.
 */
static void Spm_E0D7_Checker(boolean(*get_status)(void), boolean* last_status, RID_Enum recordId, uint8 lastByteVal)
{
	boolean current_status;

	current_status = get_status();
	if (current_status != *last_status)
	{
		Spm_E0D7_Sender(current_status, recordId, lastByteVal);
		*last_status = current_status;
	}
}

/**
 * @brief Handles part of DID E0D7: communicating to the SUSD the presence of
 *        any local/remote requests.
 *        The Requester Lists of each Power Profile are the sole source of truth
 *        for this DID, so all handlers that modify them must come first.
 */
/* PRQA S 1532 1 # Defined here for modularity reason */
void Spm_E0D7_RequestsHandler(void)
{
	/* [$Satisfies $DDS_SPM 0605] */
	static boolean Is0x20Sent = FALSE;
	static boolean Is0x02Sent = FALSE;

	/* Manage the status of Local Requests. */
	Spm_E0D7_Checker(Spm_CheckLocalRequestPresence, &Is0x20Sent, LOCALLY_ACTIVE_AP, 0u);

	/* Manage the status of Remote Requests. */
	Spm_E0D7_Checker(Spm_CheckRemoteRequestPresence, &Is0x02Sent, REMOTE_PN_AP_ACTIVE_NO_LOCAL_PN_AP_ACTIVE, 0u);

}


/**
 * @brief Handles 0x26 of DID E0D7: communicating to the SUSD the status of the own wakeup frame bit.
 *
 * @param[in] lastRequesterId: uint8: value of the last byte CanId or SrcIp address.
 */
/* PRQA S 1532 1 # Defined here for modularity reason */
void Spm_E0D7_LastRequesterIdHandler(uint8 lastRequesterId)
{
    /* [$Satisfies $DDS_SPM 0605] */
    /* static variables updated used as gatekeepers to evaluate whether the RID (0x26)
       needs to be updated or not. */
    static boolean Is0x26Sent = FALSE;
    static uint8 last_lastRequesterId = 0u;
    boolean current_status = Spm_GetOwnwakeUpBit();
    if ((current_status != Is0x26Sent) || (lastRequesterId != last_lastRequesterId))
    {
        Spm_E0D7_Sender(current_status, WUF_RECEIVED_NO_PN_ACTIVE, lastRequesterId);
        Is0x26Sent = current_status;
        last_lastRequesterId = lastRequesterId;
    }
}

/**
 * @brief Retrieves the SrcIP w.r.t. the VLAN id.
 *
 * This function return the value of the SrcIP corresponding to the input VLAN id.
 * It is assumed that the VLAN id is present since it is checked at configuration time.
 *
 * @return The value of the SrcIP.
 */
/* [$Satisfies $DDS_SPM 0047] */
/* PRQA S 1532 1 # Defined here for modularity reason						                    */
uint32 Spm_Get_SrcIpFromVLANId(const uint32 VlanID){

	uint32 ret_SrcIp = 0u;
	uint8 i;

	/* PRQA S 2877 1 # This loop will never be executed more than once for configuration reason. */
	for(i = 0u; i < (uint8)SUM_SPM_NUMBER_OF_NET_CONF; i++){
		if(SPM_NetworkInfo_Wrap[i].SPM_NetInfo->VlanID == VlanID){
			ret_SrcIp = SPM_NetworkInfo_Wrap[i].SPM_NetInfo->SrcIP;
		}
	}
	return ret_SrcIp;
}

#define SPM_START_SEC_CODE
#include "SPM_MemMap.h"
/**
 * @brief Retrieves the DTC (Diagnostic Trouble Code) identifier for a given IP address.
 *
 * This function iterates through the configured working devices and uses a binary search algorithm
 * to find the corresponding DTC code value for a device with the specified IP address.
 * The DTC code is then stored in the provided output parameter `dtcCodeValue`.
 *
 * @param[in]  ipAddress     The IP address of the device for which the DTC identifier is to be retrieved.
 * @param[out] dtcCodeValue  Pointer to a variable where the function will store the DTC code value if found.
 *
 * @note The binary search is performed within each row entry of this configuration table.
 *
 */
/* [$Satisfies $DDS_SPM 0413] */
 /*PRQA S 1503 1*/ //This function will be called by an extern module.
void SPM_GetDTCIdentifier(uint32 ipAddress,
                          uint16 * dtcCodeValue)
{
	sint16 indexTrgDvc;
	*dtcCodeValue = 0x00u;

	indexTrgDvc = Spm_GetIndexTrgDvcFromIP(ipAddress);

	if(indexTrgDvc != SPM_INVALID){
		*dtcCodeValue = SPM_GET_PGTT_INST_TRGDVC_DTCID(indexTrgDvc);
	}
}
#define SPM_STOP_SEC_CODE
#include "SPM_MemMap.h"

/**
 * @brief Function needed to retrieve the index of the PowerProfile corresponding to that SoftwID and ProfileNumber.
 *
 * @param[in] SoftwareID SoftwareID to find.
 * @param[in] ProfileNumber ProfileNumber to find.
 *
 * @return -1: ApplicationInterfaceID not found
 *         indexOfThePowerProfile: Otherwise
 */
/* PRQA S 1532 2 # Defined here for modularity reason						                    */
/* [$Satisfies $DDS_SPM 0025] */
sint16 Spm_GetPowProfIndexFromSwIDProfNumber(const uint32 SoftwareID, const uint8 ProfileNumber){

	uint8 i;
	sint16 ret = SPM_INVALID;

	for(i = 0u; i < SPM_CONF_POW_PRF_NUM; i++){
		if( (SPM_GET_SW_ID_FROM_CONF(i) == SoftwareID) && (SPM_GET_POW_PROF_NUMBER_FROM_CONF(i) == ProfileNumber) ){
			ret = (sint16)i;
			break;
		}
	}

	return ret;
}

/**
 * @brief Function needed to retrieve the index of the PowerProfile corresponding to that ServiceID and ProfileNumber.
 *
 * @param[in] ServiceID ServiceID to find.
 * @param[in] ProfileNumber ProfileNumber to find.
 *
 * @return index of the profile. This function can not fail since it is called after pre-check over the existence of the profile.
 */
/* PRQA S 1532 2 # Defined here for modularity reason						                    */
boolean Spm_GetPowProfIndexFromProfIDProfNumber(const uint16 ServiceID, const uint8 ProfileNumber, uint16* index){

	uint8 i;
	boolean ret = FALSE;

	for(i = 0u; i < SPM_CONF_POW_PRF_NUM; i++){
		/* ServiceID are the 16 MSB of the ID stored.*/
		if( ((SPM_GET_SW_ID_FROM_CONF(i) >> 16u) == ServiceID) && (SPM_GET_POW_PROF_NUMBER_FROM_CONF(i) == ProfileNumber) ){
			ret = TRUE;
			*index = i;
			break;
		}
	}

	return ret;
}

/**
 * @brief Function needed to retrieve the index of the PowerProfile corresponding to that AppApplicationInterfaceID
 *
 * @param  ApplicationInterfaceID: ID corresponding to a particular profile
 *
 * @return -1: ApplicationInterfaceID not found
 *         indexOfThePowerProfile: Otherwise
 */
sint16 Spm_GetPowProfIndexFromAppID( /* IN */const uint16 ApplicationInterfaceID ) {
	uint8 i = 0u;
	sint16 ret_s16 = SPM_INVALID;
	boolean p_hasAppIfId_b;

	do {

		p_hasAppIfId_b = (SPM_GET_APP_ID_FROM_CONF(i) != NULL_PTR) && (*SPM_GET_APP_ID_FROM_CONF(i) == ApplicationInterfaceID);

		if( p_hasAppIfId_b == TRUE ) {
			ret_s16 = (sint16)i;
		}

		i += 1u;

	} while( (i < SPM_CONF_POW_PRF_NUM) && (ret_s16 == SPM_INVALID) );

	return ret_s16;
}

#define SPM_START_SEC_CODE
#include "SPM_MemMap.h"
/**
 * @brief Function to perform the validation and triggering of the selective wake-up
 *		  after an activation request
 *
 * @param  ApplicationInterfaceID: ID corresponding to a particular profile
 *
 *
 * @return E_OK     : request accepted after validation
 * @return E_NOT_OK : request don't accepted after the validation
 */
/*PRQA S 1503 3 */ //This function will be called by an extern module.
/* [$Satisfies $DDS_SPM 0012] *//* [$Satisfies $DDS_SPM 0024] *//* [$Satisfies $DDS_SPM 0540] */
FUNC(Std_ReturnType, SPM_CODE)
SPM_ActivateProfile(VAR(uint16, AUTOMATIC) ApplicationInterfaceID) {
	Std_ReturnType retVal = E_NOT_OK;

/* Corner Case handling: SPM without profile configuration */
#if SPM_CONTAINS_PP

	sint16 PowProfIndex;

	/* Check if last deactivation request were for the current ApplicationInterfaceID. */
	if(
		(Rte_IrvRead_RE_SPM_ActivateProfile_Spm_LastDeactReqFlag() == FALSE) ||
		/* Reaching the bellow condition implicitly indicates the LastDeactReqFlag is TRUE */
		(Rte_IrvRead_RE_SPM_ActivateProfile_Spm_LastDeactReqID() != ApplicationInterfaceID)
	){
		/* Record the latest ApplicationInterfaceID requested. */
		Rte_IrvWrite_RE_SPM_ActivateProfile_Spm_LastActReqID((ApplicationInterfaceID));
		Rte_IrvWrite_RE_SPM_ActivateProfile_Spm_LastActReqFlag((TRUE));
		{
			/* Get pointer to the ProfileID of the corresponding Application Interface ID. */
			PowProfIndex = Spm_GetPowProfIndexFromAppID(ApplicationInterfaceID);

			/* [$Satisfies $DDS_SPM 0037] */
			/* PRQA S 3415 1 # No side effect since it is a getter function. */
			if ((PowProfIndex != SPM_INVALID) && (Spm_Get_ActivationAvailabilityForLocalRequest((uint8)PowProfIndex) == TRUE)) {
«IF GetDIDE0DEIsConfigured(spm.spmGeneral)-»
				/* Service ID needed are the 16 MSB of the ID received. */
				(void)Spm_HandleLocalActivationRequest((uint16)(SPM_GET_SW_ID_FROM_CONF(PowProfIndex) >> 16u), SPM_GET_POW_PROF_NUMBER_FROM_CONF(PowProfIndex) );
«ENDIF-»
				Spm_prv_prfReqDispatcher((uint8)PowProfIndex, 0u, SPM_ACT_REQ, &retVal);
			}
		}
		/* Clear the latest ApplicationInterfaceID requested. */
		Rte_IrvWrite_RE_SPM_ActivateProfile_Spm_LastActReqFlag((FALSE));
	}
	#else
	((void)ApplicationInterfaceID);

	#endif

	return retVal;
}
#define SPM_STOP_SEC_CODE
#include "SPM_MemMap.h"

#define SPM_START_SEC_CODE
#include "SPM_MemMap.h"
/**
 * @brief Function to perform the validation and triggering of the selective wake-up
 *		  after an deactivation request
 *
 * @param  ApplicationInterfaceID: ID corresponding to a particular profile
 *
 *
 * @return E_OK     : request accepted after validation
 * @return E_NOT_OK : request don't accepted after the validation
 */
/* [$Satisfies $DDS_SPM 0034] *//* [$Satisfies $DDS_SPM 0031] *//* [$Satisfies $DDS_SPM 0540] *//* [$Satisfies $DDS_SPM 0652] */
/*PRQA S 1503 2 # This function will be called by an extern module. */
FUNC(Std_ReturnType, SPM_CODE)
SPM_DeactivateProfile(VAR(uint16, AUTOMATIC) ApplicationInterfaceID) {
	Std_ReturnType retVal = E_NOT_OK;

/* Corner Case handling: SPM without profile configuration */
#if SPM_CONTAINS_PP

	sint16 PowProfIndex;

	/* Check if last activation request were for the current ApplicationInterfaceID. */
	if(
		(Rte_IrvRead_RE_SPM_DeactivateProfile_Spm_LastActReqFlag() == FALSE) ||
		/* Reaching the bellow condition implicitly indicates the LastActReqFlag is TRUE */
		(Rte_IrvRead_RE_SPM_DeactivateProfile_Spm_LastActReqID() != ApplicationInterfaceID)
	)
	{
		/* Reject request if SPM is not in running state */
		if (Spm_GetState() != Spm_Running) {
			retVal = E_NOT_OK;
		}
		else
		{
			/* Record the latest ApplicationInterfaceID requested. */
			Rte_IrvWrite_RE_SPM_DeactivateProfile_Spm_LastDeactReqID((ApplicationInterfaceID));
			Rte_IrvWrite_RE_SPM_DeactivateProfile_Spm_LastDeactReqFlag((TRUE));
			{
				/* Get pointer to the ProfileID of the corresponding Application Interface ID. */
				PowProfIndex = Spm_GetPowProfIndexFromAppID(ApplicationInterfaceID);

				if ((PowProfIndex != SPM_INVALID) && (SPM_GET_LOC_ACT_ALLOWED_FROM_CONF(PowProfIndex) == TRUE)) {
					Spm_prv_prfReqDispatcher((uint8)PowProfIndex, 0u, SPM_DEA_REQ, &retVal);
				}
			}
			/* Clear the latest ApplicationInterfaceID requested. */
			Rte_IrvWrite_RE_SPM_DeactivateProfile_Spm_LastDeactReqFlag((FALSE));
		}
	}
	#else
	((void)ApplicationInterfaceID);

	#endif

	return retVal;

}
