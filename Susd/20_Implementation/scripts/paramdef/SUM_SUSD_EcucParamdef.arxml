											</ECUC-FLOAT-PARAM-DEF>
											<!-- PARAMETER DEFINITION: SUSD_C_UnderVoltage_hysteresis -->
											<ECUC-FLOAT-PARAM-DEF>
												<SHORT-NAME>SUSD_C_UnderVoltage_hysteresis</SHORT-NAME>
												<DESC>
													<L-2 L="EN">The hysteresis for the under voltage range in volts</L-2>
												</DESC>
												<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
												<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
