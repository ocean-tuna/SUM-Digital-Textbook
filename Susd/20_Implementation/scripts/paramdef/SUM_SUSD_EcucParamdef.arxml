    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>ASW_SUM_SUSD</SHORT-NAME>
            <ELEMENTS>
                <!-- Module Definition: SUSD -->
                <ECUC-MODULE-DEF>
                    <SHORT-NAME>SUSD</SHORT-NAME>
                    <DESC>
                        <L-2 L="EN">Configuration of the SUSD (Start Up Shut Down) module.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <CONTAINERS>
                        <!-- Container Definition: SUSDConfigSet -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF>
                            <SHORT-NAME>SUSDConfigSet</SHORT-NAME>
                            <DESC>
                                <L-2 L="EN">This container contains the configuration parameters and sub containers of the SUSD module supporting multiple configuration sets.</L-2>
                            </DESC>
                            <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                            <PARAMETERS>
                                <!-- PARAMETER DEFINITION: SUSD_C_DisableNVMWrite_Voltage -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_DisableNVMWrite_Voltage</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">A calibration parameter SUSD indicates to SW-Cs to disable any NVM write processes, if the battery voltage is below this value</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                    <MAX>9</MAX>
                                    <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_PerToVoltageConvFactor -->
                                <ECUC-FLOAT-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_PerToVoltageConvFactor</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">A calibration parameter for Percentage to Voltage Conversion Factor</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>26.5</DEFAULT-VALUE>
                                    <MAX>26.5</MAX>
                                    <MIN>0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputStuckHi_Enable -->
                                <ECUC-BOOLEAN-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputStuckHi_Enable</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration enables the Run Crank Stuck High Diagnostic if set to true else disables</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputStuckHi_FailCount -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputStuckHi_FailCount</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration defines the maximum value of the fault maturation’s failure counter for Run Crank Input Stuck High</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>16</DEFAULT-VALUE>
                                    <MAX>65535</MAX>
                                    <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputStuckHi_SampleCount -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputStuckHi_SampleCount</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration defines the maximum value of the fault maturation’s sample counter for Run Crank Input Stuck High</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>20</DEFAULT-VALUE>
                                    <MAX>65535</MAX>
                                    <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputStuckLow_Enable -->
                                <ECUC-BOOLEAN-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputStuckLow_Enable</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration enables the Run Crank Stuck Low Diagnostic if set to true else disables</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputStuckLow_FailCount -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputStuckLow_FailCount</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration defines the maximum value of the fault maturation’s failure counter for Run Crank Input Stuck Low</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>16</DEFAULT-VALUE>
                                    <MAX>65535</MAX>
                                    <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputStuckLow_SampleCount -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputStuckLow_SampleCount</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration defines the maximum value of the fault maturation’s sample counter for Run Crank Input Stuck Low</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>20</DEFAULT-VALUE>
                                    <MAX>65535</MAX>
                                    <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputThresholdHigh -->
                                <ECUC-FLOAT-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputThresholdHigh</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration parameter is used for Run Crank Input High(RunCrank Active High) determination based on this threshold voltage</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>5</DEFAULT-VALUE>
                                    <MAX>26.5</MAX>
                                    <MIN>0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputThresholdLow -->
                                <ECUC-FLOAT-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputThresholdLow</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration parameter is used for Run Crank Input Low(RunCrank Active Low) determination based on this threshold voltage</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>2</DEFAULT-VALUE>
                                    <MAX>26.5</MAX>
                                    <MIN>0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInput_DebounceTime -->
                                <ECUC-FLOAT-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInput_DebounceTime</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in sec, Duration used for Analog or Digital Run Crank Input(Low/High) Determination.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>0.03</DEFAULT-VALUE>
                                    <MAX>10.0</MAX>
                                    <MIN>0.0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_RunCrankInputType -->
                                <ECUC-BOOLEAN-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunCrankInputType</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This calibration is used to determine the Run Crank Input Type(DISCRETE/ANALOG),default DISCRETE</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>true</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                            </PARAMETERS>
                            <SUB-CONTAINERS>
                                <!-- Container Definition: SUSD_SWCInfo -->
                                <ECUC-PARAM-CONF-CONTAINER-DEF>
                                    <SHORT-NAME>SUSD_C_SWCInfo</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This container contains the Configuration Parameters for Calibration Prameters of SUM SUSD</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                    <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                                    <PARAMETERS>
                                        <!-- PARAMETER DEFINITION: SUSD_SWCName -->
                                        <ECUC-STRING-PARAM-DEF>
                                            <SHORT-NAME>SUSD_SWCName</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="EN">String to indicate the SWC name for interface to map the ports in SWC-D</L-2>
                                            </DESC>
                                            <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                            <ORIGIN>GM_ECUC</ORIGIN>
                                        </ECUC-STRING-PARAM-DEF>
                                        <!-- PARAMETER DEFINITION: SUSD_C_ShutdownPermControl -->
                                        <ECUC-BOOLEAN-PARAM-DEF>
                                            <SHORT-NAME>SUSD_C_ShutdownPermControl</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="EN">A boolean calibration parameter for each shutdown permission interface to control the processing of its permissions</L-2>
                                            </DESC>
                                            <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                            <IMPLEMENTATION-CONFIG-CLASSES>
                                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                    <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            </IMPLEMENTATION-CONFIG-CLASSES>
                                            <ORIGIN>GM_ECUC</ORIGIN>
                                            <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                            <DEFAULT-VALUE>1</DEFAULT-VALUE>
                                        </ECUC-BOOLEAN-PARAM-DEF>
                                    </PARAMETERS>
									<REFERENCES>
										<ECUC-REFERENCE-DEF>
										<!-- [$Satisfies $SDD_SUSD 173] -->
										 <SHORT-NAME>SUSD_BatteryVoltageRangeRef</SHORT-NAME>
										 <DESC>
										   <L-2 L="EN">Reference to a battery voltage range"</L-2>
										 </DESC>
										 <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
										 <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
										 <IMPLEMENTATION-CONFIG-CLASSES>
										   <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											 <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
											 <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
										   </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
										   <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
											 <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
											 <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
										   </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
										 </IMPLEMENTATION-CONFIG-CLASSES>
										 <ORIGIN>GM_ECUC</ORIGIN>
										 <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/ASW_SUM_SUSD/SUSD/SUSDConfigSet/SUSD_BatteryVoltageRange/SUSD_C_BatteryVoltageRange</DESTINATION-REF>
										</ECUC-REFERENCE-DEF>
									<ECUC-REFERENCE-DEF>
                                    <SHORT-NAME>SUSD_SWCs_SpecificWkSrcId</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This parameter defines the identifier of this wakeup source.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_EcuM/EcucModuleDefs/EcuM/EcuMConfiguration/EcuMCommonConfiguration/EcuMWakeupSource</DESTINATION-REF>
									</ECUC-REFERENCE-DEF>     
									</REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
								<ECUC-PARAM-CONF-CONTAINER-DEF>
                                    <SHORT-NAME>SUSD_C_SUMsInfo</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This container contains the Configuration Parameters for Calibration Prameters of SUM SUSD</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                    <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                                    <PARAMETERS>
                                        <!-- PARAMETER DEFINITION: SUSD_SWCName -->
                                        <ECUC-ENUMERATION-PARAM-DEF>
                                    <SHORT-NAME>SUSD_SUMsName</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This parameter defines the type of SUM component that SUSD will interface with, such as SUM_SPM, SUM_LNM, SUM_SSFM-SSM, SUM_SSFM-ERRH, SUM_SSC, SUM_PNC, SUM_DIAG, SUM_TCS, SUM_SRVMGR, or SUM_SOH.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <IMPLEMENTATION-CONFIG-CLASSES>
                                    <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                                    </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                      <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                                      <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                    </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN></ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>NOT_Applicable</SYMBOLIC-NAME-VALUE>
									 <LITERALS>
                                        <ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_SPM</SHORT-NAME>
                                            <LONG-NAME>
                                                <L-4 L="EN">NOT_Applicable</L-4>
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
                                        <ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_LNM</SHORT-NAME>
                                            <LONG-NAME>
                                                <L-4 L="EN">With_OBD</L-4>
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
                                        <ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_SSFM_ERRH</SHORT-NAME>
                                            <LONG-NAME>
                                                <L-4 L="EN">With_Cybersecurity</L-4>
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
										<ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_SSFM_SSM</SHORT-NAME>
                                            <LONG-NAME>
                                                <L-4 L="EN">With_Cybersecurity</L-4>
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
                                        <ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_SSC</SHORT-NAME>
                                            <LONG-NAME>
                                                <L-4 L="EN">Without_Cybersecurity</L-4>
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
										<ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_PNC</SHORT-NAME>
                                            <LONG-NAME>                                           
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
										<ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_DIAG</SHORT-NAME>
                                            <LONG-NAME>
                                                <L-4 L="EN">Diagnostics Manager</L-4>
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
										<ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>SUM_TCS</SHORT-NAME>
                                            <LONG-NAME>
                                            </LONG-NAME>
                                            <ORIGIN></ORIGIN>
