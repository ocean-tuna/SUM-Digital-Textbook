                                    </PARAMETERS>
									<REFERENCES>
                                        <ECUC-REFERENCE-DEF>
                                            <SHORT-NAME>Sum_SUSD_E0D7NvMBlockRef</SHORT-NAME>
                                            <DESC>
                                              <L-2 L="EN">Reference to NvM Block Descriptor of DID E0D7 Data</L-2>
                                            </DESC>
                                            <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                            <IMPLEMENTATION-CONFIG-CLASSES>
                                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                                <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            </IMPLEMENTATION-CONFIG-CLASSES>
                                            <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_NvM/EcucModuleDefs/NvM/NvMBlockDescriptor</DESTINATION-REF>
                                        </ECUC-REFERENCE-DEF>
                                        <ECUC-REFERENCE-DEF>
                                            <SHORT-NAME>Sum_SUSD_FirstBootPostFlashNvMBlockRef</SHORT-NAME>
                                            <DESC>
                                              <L-2 L="EN">Reference to NvM Block Descriptor of First Boot Post-Flash Flag</L-2>
                                            </DESC>
                                            <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                            <IMPLEMENTATION-CONFIG-CLASSES>
                                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                                <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            </IMPLEMENTATION-CONFIG-CLASSES>
                                            <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_NvM/EcucModuleDefs/NvM/NvMBlockDescriptor</DESTINATION-REF>
                                        </ECUC-REFERENCE-DEF>
                                        <ECUC-REFERENCE-DEF>
                                            <SHORT-NAME>Sum_SUSD_E0D7_MonitorDisabled_NvMBlockRef</SHORT-NAME>
                                            <DESC>
                                              <L-2 L="EN">Reference to NvM Block Descriptor of DID 0xE0D7 Monitor Disabled flag</L-2>
                                            </DESC>
                                            <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                            <IMPLEMENTATION-CONFIG-CLASSES>
                                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                                <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            </IMPLEMENTATION-CONFIG-CLASSES>
                                            <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_NvM/EcucModuleDefs/NvM/NvMBlockDescriptor</DESTINATION-REF>
                                        </ECUC-REFERENCE-DEF>
                                        <ECUC-REFERENCE-DEF>
                                            <SHORT-NAME>Sum_SUSD_LIN_WakeupSource</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="EN">List of the LIN WakeUpSources in EcuM.</L-2>
                                            </DESC>
                                            <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                            <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                            <IMPLEMENTATION-CONFIG-CLASSES>
                                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                    <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            </IMPLEMENTATION-CONFIG-CLASSES>
                                            <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_EcuM/EcucModuleDefs/EcuM/EcuMConfiguration/EcuMCommonConfiguration/EcuMWakeupSource</DESTINATION-REF>
                                        </ECUC-REFERENCE-DEF>
                                        <ECUC-REFERENCE-DEF>
                                            <SHORT-NAME>Sum_SUSD_ECU_WakeupSource</SHORT-NAME>
                                            <DESC>
                                                <L-2 L="EN">List of the Record 0x01 WakeUpSources in EcuM.</L-2>
                                            </DESC>
                                            <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                            <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                            <IMPLEMENTATION-CONFIG-CLASSES>
                                                <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                                    <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                                    <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                                </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            </IMPLEMENTATION-CONFIG-CLASSES>
                                            <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                                            <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_EcuM/EcucModuleDefs/EcuM/EcuMConfiguration/EcuMCommonConfiguration/EcuMWakeupSource</DESTINATION-REF>
                                        </ECUC-REFERENCE-DEF>
									</REFERENCES>
                                </ECUC-PARAM-CONF-CONTAINER-DEF>
                            </SUB-CONTAINERS>
                        </ECUC-PARAM-CONF-CONTAINER-DEF>
                        <!-- Container Definition: SUSDGeneral -->
                        <ECUC-PARAM-CONF-CONTAINER-DEF>
                            <SHORT-NAME>SUSDGeneral</SHORT-NAME>
                            <DESC>
                                <L-2 L="EN">General configuration parameters of the SUSD.</L-2>
                            </DESC>
                            <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                            <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                            <PARAMETERS>
                                <!-- PARAMETER DEFINITION: SUSD_t_Shutdown_Refresh -->
                                <ECUC-FLOAT-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_Shutdown_Refresh</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in sec, for which a SW-C with a ShutdownPermission interface, shall refresh its signal for that interface</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>0.1</DEFAULT-VALUE>
                                    <MAX>0.5</MAX>
                                    <MIN>0.001</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_t_Force_Shutdown_Wait -->
                                <ECUC-FLOAT-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_Force_Shutdown_Wait</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in sec(greater than zero), for which SUSD shall wait before requesting Shutdown from BswM, after indicating to all SW-Cs with PermitExecution interface to Shutdown.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>0</DEFAULT-VALUE>
                                    <MAX>65.535</MAX>
                                    <MIN>0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_t_Battery_Periodicity -->
								<!-- [$Satisfies $SDD_SUSD 139] -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_Battery_Periodicity</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in msec, for the periodicity of notifying SW-C of changes to the Battery Monitors. </L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>100</DEFAULT-VALUE>
                                    <MAX>500</MAX>
                                    <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_t_VehiclePowerMode_Periodicity -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_VehiclePowerMode_Periodicity</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in msec, for the periodicity of notifying SW-C of changes to the Vehicle Power Mode. </L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>100</DEFAULT-VALUE>
                                    <MAX>500</MAX>
                                    <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-FLOAT-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_ResetExecution_Periodicity</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in msec, for the periodicity of Reset Execution and Running Reset Timer. </L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>1.0</DEFAULT-VALUE>
                                    <MAX>65.535</MAX>
                                    <MIN>1.0</MIN>
                                </ECUC-FLOAT-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUM_SUSD_RESETExecution_TIMER_Thresh_Init -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUM_SUSD_RESETExecution_TIMER_Thresh_Init</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Initial value of the Calibration parameter SUM_SUSD_RESETExecution_TIMER_Thresh. </L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>10</DEFAULT-VALUE>
                                    <MAX>10</MAX>
                                    <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_t_RunCrank_Periodicity -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_RunCrank_Periodicity</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in msec, for the periodicity of notifying SW-C of changes to the Run Crank.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>100</DEFAULT-VALUE>
                                    <MAX>500</MAX>
                                    <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_t_Wakeup_Periodicity -->
								<!-- [$Satisfies $SDD_SUSD 140] -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_Wakeup_Periodicity</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in msec, for the periodicity of Wake up polling.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>100</DEFAULT-VALUE>
                                    <MAX>500</MAX>
                                    <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_t_AppManager_Periodicity -->
								<!-- [$Satisfies $SDD_SUSD 141] -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_t_AppManager_Periodicity</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in msec, for the periodicity of AppStateManager.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>100</DEFAULT-VALUE>
                                    <MAX>500</MAX>
                                    <MIN>1</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: SusdInitFuncPeriodicity -->
                              <ECUC-FLOAT-PARAM-DEF>
                                  <SHORT-NAME>SusdInitFuncPeriodicity</SHORT-NAME>
                                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <MIN>1.0</MIN>
                                  <MAX>5000.0</MAX>
                                  <DEFAULT-VALUE>1000.0</DEFAULT-VALUE>
                                  <DESC>
                                      <L-2 L="EN">Period in milliseconds that configures the runnable init function periodicity. This parameter is required when SusdGenerateInitRunnable is set to TRUE.</L-2>
                                  </DESC>
                              </ECUC-FLOAT-PARAM-DEF>
                              <!-- PARAMETER DEFINITION: SusdGenerateInitRunnable -->
                              <ECUC-BOOLEAN-PARAM-DEF>
                                <!-- [$Satisfies $SDD_SUSD 245] -->
                                  <SHORT-NAME>SusdGenerateInitRunnable</SHORT-NAME>
                                  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                  <DEFAULT-VALUE>False</DEFAULT-VALUE>
                                  <DESC>
                                      <L-2 L="EN">The parameter shall generate SUSD init runnable if it is configured as TRUE. Otherwise the SUSD_Init() function shall be called by a BswM action list during startup</L-2>
                                  </DESC>
                              </ECUC-BOOLEAN-PARAM-DEF>

                                <!-- PARAMETER DEFINITION: SUSD_C_RunningResetWaitTime -->
                                <ECUC-INTEGER-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_RunningResetWaitTime</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">Time in msec, for the serial data wait time after running reset occurs before going Fail-Soft state.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>625</DEFAULT-VALUE>
                                    <MAX>65535</MAX>
                                    <MIN>0</MIN>
                                </ECUC-INTEGER-PARAM-DEF>
                                <ECUC-BOOLEAN-PARAM-DEF>
                                    <SHORT-NAME>SUSD_Battery_State_of_Charge_Supported</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">True if the ECU has an input which monitors the vehicle battery state of charge.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_PowerMode_Slave_Available -->
                                <ECUC-BOOLEAN-PARAM-DEF>
                                    <SHORT-NAME>SUSD_PowerModing_Slave_Supported</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">true if the ECU is not the Power Mode Master,false if the ECU is the Power Mode Master.true: Enabled false: Disabled.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_RunCrankInput_Available -->
                                <ECUC-BOOLEAN-PARAM-DEF>
                                    <SHORT-NAME>SUSD_RunCrankPlausibility_Supported</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">true if the RunCrank Input is available from one of the software component,false if the RunCrank Input is not available from any of the software component.true: Enabled false: Disabled.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <DEFAULT-VALUE>false</DEFAULT-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_C_DefaultShutdownState -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                    <SHORT-NAME>SUSD_C_DefaultShutdownState</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">The default ECU operation state when shutting down: {Off or Sleep}.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                    <LITERALS>
                                        <ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>Off</SHORT-NAME>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
                                        <ECUC-ENUMERATION-LITERAL-DEF>
                                            <SHORT-NAME>Sleep</SHORT-NAME>
                                        </ECUC-ENUMERATION-LITERAL-DEF>
                                    </LITERALS>
                                </ECUC-ENUMERATION-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_VPM_ASIL_A_Supported -->
                                <ECUC-BOOLEAN-PARAM-DEF>
                                    <SHORT-NAME>SUSD_VPM_ASIL_A_Supported</SHORT-NAME>
                                    <DESC>
                                        <L-2 L="EN">This parameter shall control the determination of Vehicle Power Mode at ASIL A or QM level. If set to False, then VPM shall be calculated without Failed Safety signals.</L-2>
                                    </DESC>
                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                    <IMPLEMENTATION-CONFIG-CLASSES>
                                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                    </IMPLEMENTATION-CONFIG-CLASSES>
                                    <ORIGIN>GM_ECUC</ORIGIN>
                                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                                </ECUC-BOOLEAN-PARAM-DEF>
                                <!-- PARAMETER DEFINITION: SUSD_VPM_Security_Supported -->
                                <ECUC-ENUMERATION-PARAM-DEF>
                                    <SHORT-NAME>SUSD_VPM_Security_Supported</SHORT-NAME>
                                    <DESC>
