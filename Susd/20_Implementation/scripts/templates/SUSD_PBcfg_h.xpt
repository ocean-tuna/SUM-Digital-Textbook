#ifndef SUM_SUSD_PBCFG_H
#define SUM_SUSD_PBCFG_H

/*****************************************************************************************************
*                                        Includes
*****************************************************************************************************/
#include "SUM_SUSD_Types.h"

/***************************************************************************************************
 * Extern declarations
 ***************************************************************************************************
*/

 /* PRQA S 3447 EOF */
/* The Calibration Functions for Under,Over voltage hysteresis and Shutdown
        Permission Control for every SWC */
«IF sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0-»
    extern CONST (SUSD_SWCRteInterfaces, RTE_CONST) SUSD_GaaRteSWCInterface[«sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size»];
«ENDIF-»

«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported) -»
    extern FUNC(Impl_PerToVoltage_0_26p5, RTE_CODE) Rte_CData_SUSD_PDP_PercentageToVolConvFactor(void);
    extern FUNC(boolean, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputStuckHi_Enable(void);
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputStuckHi_FailCount(void);
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputStuckHi_SampleCount(void);
    extern FUNC(boolean, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputStuckLow_Enable(void);
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputStuckLow_FailCount(void);
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputStuckLow_SampleCount(void);
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputThresholdHigh(void);
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInputThresholdLow(void);
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_RunCrankInput_DebounceTime(void);
    extern FUNC(RunCrankInputType, RTE_CODE) Rte_CData_SUSD_PDP_SUSD_C_RunCrankInputType(void);
«ENDIF -»
«IF (sUSD.sUSDGeneral.sUSD_DisNvMWriteAvailable == true)-»
    extern FUNC(uint8, RTE_CODE) Rte_CData_SUSD_PDP_SUSD_C_DisableNVMWrite_Voltage(void);
«ENDIF-»

«FOREACH this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo AS SWCInfo »
    extern FUNC(Impl_SUSD_C_VoltageHysteresis, RTE_CODE) Rte_CData_SUSD_PDP_SUSD_C_OverVoltage_hysteresis_«SWCInfo.sUSD_SWCName»(void);
    extern FUNC(Impl_SUSD_C_VoltageHysteresis, RTE_CODE) Rte_CData_SUSD_PDP_SUSD_C_UnderVoltage_hysteresis_«SWCInfo.sUSD_SWCName»(void);

    extern FUNC(boolean, RTE_CODE) Rte_CData_SUSD_PDP_SUSD_C_ShutdownPermControl_«SWCInfo.sUSD_SWCName»(void);
«ENDFOREACH-»
«IF (sUSD.sUSDGeneral.sUSD_PowerModing_Slave_Supported == true)-»
    extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_SUSD_C_RunningResetWaitTime(void);
«ENDIF -»
#endif /* SUM_SUSD_PBCFG_H */

extern FUNC(uint8, RTE_CODE) Rte_CData_SUSD_PDP_k_AR_Active_Delay(void);
extern FUNC(uint16, RTE_CODE) Rte_CData_SUSD_PDP_k_AR_Init_Delay(void);

/********************************** END OF FILE ******************************************************/

«ENDFILE»
