/* SUM module specific wakeup masks based on functional requirements */
#define SUSD_WAKEUP_MASK_SUM_PNC         (SUSD_CAN_WAKEUP_MASK)                                        /* SUM_PNC=0: Only CAN wakeups */
#define SUSD_WAKEUP_MASK_SUM_LNM         (SUSD_LIN_WAKEUP_MASK)                                        /* SUM_LNM=1: Only LIN wakeups */
#define SUSD_WAKEUP_MASK_SUM_SSFM_ERRH   (SUSD_GLOBAL_WAKEUP_MASK | SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK) 	/* SUM_SSFM-ERRH=2 */
#define SUSD_WAKEUP_MASK_SUM_SOH         (SUSD_GLOBAL_WAKEUP_MASK | SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK) 		/* SUM_SOH=3 */
#define SUSD_WAKEUP_MASK_SUM_TCS         (SUSD_GLOBAL_WAKEUP_MASK | SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK)  		/* SUM_TCS=4 */
#define SUSD_WAKEUP_MASK_SUM_SSC         (SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK)									/* SUM_SSC=5 */
#define SUSD_WAKEUP_MASK_SUM_SSFM_SSM    (SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK) 							/* SUM_SSFM-SSM=6 */
#define SUSD_WAKEUP_MASK_SUM_SRVMGR      (SUSD_GLOBAL_WAKEUP_MASK | SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK) /* SUM_SRVCMGR=7 */
#define SUSD_WAKEUP_MASK_SUM_SPM         (SUSD_GLOBAL_WAKEUP_MASK | SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK)   /* SUM_SPM=8  */
#define SUSD_WAKEUP_MASK_SUM_DIAG        (SUSD_GLOBAL_WAKEUP_MASK | SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK )  /* SUM_DIAG=9  */
#define SUSD_WAKEUP_MASK_SWC             (SUSD_GLOBAL_WAKEUP_MASK | SUSD_CAN_WAKEUP_MASK | SUSD_ETH_WAKEUP_MASK | SUSD_LIN_WAKEUP_MASK)  /* ALL wakeups */



/* Number of Wakeup Sources of interest to this system. This includes:
** - the Global Wakeup Sources, i.e. bits 0-15 of the Wakeup Status;
** - the Wakeup Sources configured for SUMs;
** - the Wakeup Sources configured for SWCs.                                  */
#define NO_OF_WAKEUPSRCS (uint32) «sUSD.sUSDWakeUpRelation.sUSD_WakeupSourceId
            .union(sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMs_SpecificWkSrcId)
            .union(sUSD.sUSDConfigSet.sUSD_C_SWCInfo.sUSD_SWCs_SpecificWkSrcId)
            .toSet().size»u 

#define SUSD_SUM_PERMEXE  «this.sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e|e.sUSD_PermitExecution == true).size»u
#define SUSD_SUM_SHUTPERM «this.sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e|e.sUSD_ShutdownPermission == true).size»u
#define SUSD_SWC_SHUTPERM «this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo.select(e|e.sUSD_C_ShutdownPermControl == true).size»u

#define NO_OF_SUMS (uint32) «sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.size»u

/* Number of SWCs components configured for ShutdownPermControl,Under/Over Voltage hysteresis */
#define NO_OF_SWCS (uint32) «sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size»u
«IF sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0-»
#define EXISTS_SWC STD_ON
«ELSE-»
#define EXISTS_SWC STD_OFF
«ENDIF-»
#define NO_OF_VOLTRANGE (uint32)«sUSD.sUSDConfigSet.sUSD_BatteryVoltageRange.sUSD_C_BatteryVoltageRange.size + 1»u /* include a default range from 9V to 16V */



#define ALL_WAKEUPS_DISABLED 0u
#define WAKEUPS_ENABLED 1u
#define INITIAL_WAKEUP_STATUS 2u

«IF (sUSD.sUSDGeneral.sUSD_Battery_State_of_Charge_Supported == true) -»
#define SOC_OK (BatteryStateOfChargeType) 0u
#define SOC_LOW (BatteryStateOfChargeType) 1u

#define SUSD_BSWM_ENABLE_WAKEUPS  (uint8)0u
#define SUSD_BSWM_DISABLE_WAKEUPS (uint8)1u

#define SUSD_VEHICLE_BATTERY_STATE_OF_CHARGE_SUPPORTED STD_ON

«ELSE-»

#define SUSD_VEHICLE_BATTERY_STATE_OF_CHARGE_SUPPORTED STD_OFF

«ENDIF-»

«IF (sUSD.sUSDGeneral.susdGenerateInitRunnable == true)-»
#define SUSD_RUNNABLE_INIT_SUPPORTED STD_ON

«ELSE-»

#define SUSD_RUNNABLE_INIT_SUPPORTED STD_OFF

«ENDIF-»
/* Satisfies: [$SDD_SUSD 003] */
/* Time in sec, for which a SW-C with a ShutdownPermission interface, shall refresh its signal for that interface
   Considering the maximum value allowed as 0.5s, the maximum count for this timer may not exceed 65535 */
#define SUSD_T_SHUTDOWN_REFRESH (uint16) «IF
((sUSD.sUSDGeneral.sUSD_t_Shutdown_Refresh/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0))-(sUSD.sUSDGeneral.sUSD_t_Shutdown_Refresh/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0)).extractMantissaFrmFloatValue())>=0.5 »      «(sUSD.sUSDGeneral.sUSD_t_Shutdown_Refresh/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0)).extractMantissaFrmFloatValue()+1»
«ELSE-»
«(sUSD.sUSDGeneral.sUSD_t_Shutdown_Refresh/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0)).extractMantissaFrmFloatValue()»
«ENDIF-»

/* Satisfies: [$SDD_SUSD 004] */
/* Time in sec(greater than or equal to zero), for which SUSD shall wait before requesting Shutdown from BswM, after indicating to all
   SW-Cs with PermitExecution interface to Shutdown. Considering the maximum value allowed as 65.535s, the maximum count for this timer may not exceed 65535 */
#define SUSD_T_FORCE_SHUTDOWN_WAIT  (uint16) «IF
((sUSD.sUSDGeneral.sUSD_t_Force_Shutdown_Wait/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0))-(sUSD.sUSDGeneral.sUSD_t_Force_Shutdown_Wait/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0)).extractMantissaFrmFloatValue())>=0.5 »      «(sUSD.sUSDGeneral.sUSD_t_Force_Shutdown_Wait/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0)).extractMantissaFrmFloatValue()+1»
«ELSE-»
«(sUSD.sUSDGeneral.sUSD_t_Force_Shutdown_Wait/(sUSD.sUSDGeneral.sUSD_t_AppManager_Periodicity / 1000.0)).extractMantissaFrmFloatValue()»
«ENDIF-»

/* Satisfies: [$SDD_SUSD 005] */
/* The default ECU operation state when shutting down: {Off or Sleep}. */
#define SUSD_C_DEFAULTSHUTDOWNSTATE (CurrentECUOperatingModeType) «sUSD.sUSDGeneral.sUSD_C_DefaultShutdownState == "Off" ? "SUM_SHUTDOWN" : "SUM_SLEEP"»

/* Pre compile option to check if ECU is Power Moding Slave or Power Moding Master*/
#define SUSD_POWERMODING_SLAVE_SUPPORT «sUSD.sUSDGeneral.sUSD_PowerModing_Slave_Supported == true ? "STD_ON" : "STD_OFF"»

/* Pre compile option to check if Run crank input is available*/
#define SUSD_RUNCRANKPLAUSIBILITY_SUPPORT «sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported == true ? "STD_ON" : "STD_OFF"»


«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported) -»
/* Macro for Run Crank Periodicity in msec */
#define SUSD_RUNCRANK_PERIODICITY «sUSD.sUSDGeneral.sUSD_t_RunCrank_Periodicity»u
«ENDIF -»

/* Macro to control the determination of Vehicle Power Mode at ASIL A or QM level.
If set to STD_OFF, then VPM shall be calculated without Failed Safety signals.*/
#define SUSD_VPM_ASIL_A_SUPPORT «sUSD.sUSDGeneral.sUSD_VPM_ASIL_A_Supported == true ? "STD_ON" : "STD_OFF"»

/* Macro to control the determination of Vehicle Power Mode with or without Cybersecurity.
If set to STD_OFF, then VPM shall be calculated without Failed Security signals.*/
#define SUSD_VPM_SECURITY_SUPPORT «sUSD.sUSDGeneral.sUSD_VPM_Security_Supported»

/* Macro to determine the initial value of System Power Mode when a valid
 * System Power Mode has not been received yet. */
#define SUSD_VPM_SPM_INITIAL «sUSD.sUSDGeneral.sUSD_VPM_SPM_Initial»

/* Macro to determine the initial value of System Backup Power Mode when a
 * valid System Backup Power Mode has not been received yet. */
#define SUSD_VPM_SBPM_INITIAL «sUSD.sUSDGeneral.sUSD_VPM_SBPM_Initial»

/* Macro to support ECU Operating State DID as User Optional */
#define SUSD_ECU_OPERATING_STATE_DID_SUPPORT «sUSD.sUSDGeneral.sUSD_ECUOpStateDIDSupported == true ? "STD_ON" : "STD_OFF"»

#define SUSD_SINGLEPORT_SUPPORTED «Susd_Ssfm_IsSinglePortSupported(sSFM) == true? "STD_ON" : "STD_OFF"»

/* Reset execution periodicity in micro-second precision */
#define SUSD_RESET_EXECUTION_PERIOD «extractMantissaFrmFloatValue(1000.0 * sUSD.sUSDGeneral.sUSD_t_ResetExecution_Periodicity)»u

/*
  The maximum possible value is set to 10ms (in us precision) based on the requirement. Please note that, this value cannot be more than 65535.
  In order to have values more than 65535 (65 msec), the SUM_SUSD_RESETExecution_TIMER and the corresponding NvM block should be changed to uint32.
*/
#define SUSD_MAX_RESETEXECUTION_TIMER ((10u * 1000u) + 1u)

/* Periodicity of the Activity Records handler (in milliseconds) */
#define SUSD_AR_PERIODICITY «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_AR_Periodicity.toInteger()»

/* Macros for DID 0xF089*/
/* DID 0xF089 length size in byte(s)*/
#define DID_F089_LEN 6u
/* Macro for check read function DID 0xF089 configured parameter*/
«IF isDIDCheckReadFuncConfigured(sUSD.sUSDConfigSet.sUSDDiagReferences.did_F089_Reference.dcmDspDidSignal.get(0).dcmDspDidDataRef)-»
#define DID_F089_CHECKREADFUNC  STD_ON
«ELSE-»
#define DID_F089_CHECKREADFUNC  STD_OFF
«ENDIF-»

/* Macro introduced only for testing purpose */
/* Indicates if SPM (System Power Manager) module is configured in the root container */
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»
#define SUSD_SPM_MODULE_SUPPORT STD_ON
«ELSE-»
#define SUSD_SPM_MODULE_SUPPORT STD_OFF
«ENDIF-»
/*
 ******************************************************************************
 * Configuration Typedefs. - For SUSD Internal Use
 ******************************************************************************
 */
/* Structure to store the ECU Wakeup Detection Records */
typedef struct
{
  /* ECU Wakeup Detection Record Id  */
  uint8 ECUWakeupDetectionRecordId[4];

  /* Time Stamp of occurrence of the wake up source */
  uint8 TimeStampOfOccurence[5];

} SUSD_ECUWakeupDetectionRecord;

typedef struct
{
    /* Pointer to the RAM block */
    P2VAR(SUSD_ECUWakeupDetectionRecord, TYPEDEF, RTE_APPL_DATA) NvmRamBlock;
    /* Function pointer to the NvM_GetErrorStatus RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmGetErrorStatus_fp) (CONSTP2VAR(NvM_RequestResultType, AUTOMATIC, RTE_APPL_DATA) RequestResultPtr);
    /* Function pointer to the NvM_SetRamBlockStatus RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmSetRamBlockStatus_fp) (VAR(boolean, AUTOMATIC) BlockChanged);
    /* Function pointer to the NvM_WriteBlock RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmWriteBlock_fp) (VAR(NvM_Rb_ConstVoidPtr, AUTOMATIC) SrcPtr);
} Susd_GenericNvmAccessType;

typedef struct
{
    /* Pointer to the RAM block */
    P2VAR(uint8, TYPEDEF, RTE_APPL_DATA) NvmRamBlock;
    /* Function pointer to the NvM_GetErrorStatus RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmGetErrorStatus_fp) (CONSTP2VAR(NvM_RequestResultType, AUTOMATIC, RTE_APPL_DATA) RequestResultPtr);
    /* Function pointer to the NvM_SetRamBlockStatus RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmSetRamBlockStatus_fp) (VAR(boolean, AUTOMATIC) BlockChanged);
    /* Function pointer to the NvM_WriteBlock RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmWriteBlock_fp) (VAR(NvM_Rb_ConstVoidPtr, AUTOMATIC) SrcPtr);
} Susd_GenericNvmAccessType_uint8;

typedef struct
{
    /* Pointer to the RAM block */
    P2VAR(uint16, TYPEDEF, RTE_APPL_DATA) NvmRamBlock;
    /* Function pointer to the NvM_GetErrorStatus RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmGetErrorStatus_fp) (CONSTP2VAR(NvM_RequestResultType, AUTOMATIC, RTE_APPL_DATA) RequestResultPtr);
    /* Function pointer to the NvM_SetRamBlockStatus RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmSetRamBlockStatus_fp) (VAR(boolean, AUTOMATIC) BlockChanged);
    /* Function pointer to the NvM_WriteBlock RTE API */
    P2FUNC(Std_ReturnType, TYPEDEF, Susd_RteCallNvmWriteBlock_fp) (VAR(NvM_Rb_ConstVoidPtr, AUTOMATIC) SrcPtr);
} Susd_GenericNvmAccessType_uint16;

typedef struct
{
  /* Satisfies: [$SDD_SUSD 135] */
  /* Mapping of SWC with the wakeup to indicate the Permit Execution */
  P2FUNC(Std_ReturnType, TYPEDEF, SWCPermitExecutionInterface) (VAR(SUSD_SWC_ExecutionStatusType, AUTOMATIC)data);

  /* Index of SWC */
  const uint16 SWC_Index;

}SUSD_SWCToVoltRangeReferenceType;

typedef struct
{
	/* Mapping of interface with the limit for normal/over/under voltage to indicate same for each voltage range */
	P2FUNC(Std_ReturnType, TYPEDEF, SWCBattVolt_Range_MintoMax) (VAR(OperatingRangeType, AUTOMATIC)data);

	/* Calibrated value for Under Voltage Limit for each range */
	P2FUNC(uint16, TYPEDEF, SWC_UnderVoltageHysteresis) ();

	/* Calibrated value for Over Voltage Limit for each range */
	P2FUNC(uint16, TYPEDEF, SWC_OverVoltageHysteresis) ();

	/* The minimum voltage in range  */
	const uint16	BatteryVoltageMin;

	/* The maximum voltage in range  */
	const uint16 	BatteryVoltageMax;

	/*Number of SWCs reference to this voltage range */
	const uint16  NumberOfSWCs;

	/*Pointer to the SWCs-VoltageRange mapping */
	const SUSD_SWCToVoltRangeReferenceType* SWCRangeMapping;

}SUSD_BatteryVoltageRangeType;

«FOREACH sUSD.sUSDConfigSet.sUSD_C_SUMsInfo AS sum-»
«IF sum.sUSD_ShutdownPermission == true-»
#define «sum.sUSD_SUMsName» (uint8)«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»u
«ENDIF-»
«ENDFOREACH-»



/***************************************************************************************************
 * Extern declarations
 ***************************************************************************************************
 */
/* Access Function Pointers for NVM Blocks. */
/* PRQA S 3449 4 # These declarations are guarded against the defining Translation Unit to avoid extern+initializer warnings */
#ifndef SUM_SUSD_CFG_C
extern const Susd_GenericNvmAccessType susd_NVMECUWakeUpDetectionRecordsBlock_FP;
extern const Susd_GenericNvmAccessType_uint16 susd_NvMServiceRESET_ExecutionTimerBlock_FP;
extern const Susd_GenericNvmAccessType_uint8 susd_NvMService_E0D7Block_FP;
extern const Susd_GenericNvmAccessType_uint8 susd_NvMService_FirstBootPostFlashBlock_FP;
#endif /* SUM_SUSD_CFG_C */
extern const SUSD_BatteryVoltageRangeType SUSD_BatteryVoltageThreshold[«sUSD.sUSDConfigSet.sUSD_BatteryVoltageRange.sUSD_C_BatteryVoltageRange.size + 1»];

/* Variable used to store DID E0D7 Data */
extern VAR(uint8, RTE_CODE) «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7NvMBlockRef.nvMRamBlockDataAddress-»[];
/* Variable used to store First Boot Post Flash flag */
extern VAR(uint8, RTE_CODE) «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_FirstBootPostFlashNvMBlockRef.nvMRamBlockDataAddress-»;
/* Variable used to store DID E0D7 Monitor Disabled flag */
extern VAR(boolean, RTE_CODE) «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7_MonitorDisabled_NvMBlockRef.nvMRamBlockDataAddress-»;
#endif /* SUM_SUSD_CFG_H */
/********************************** END OF FILE ******************************************************/

«ENDFILE»
«ENDDEFINE»
