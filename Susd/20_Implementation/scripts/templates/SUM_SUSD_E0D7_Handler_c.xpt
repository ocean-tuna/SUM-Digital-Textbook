/***********************************************************************************

  Function name :   Sum_SUSD_ActivityRecords_Active_Handler
  Description   :   Handler function for the "Active" state of DID 0xE0D7
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   See in code comments
 ************************************************************************************/
 /* Satisfies: [$SDD_SUSD 212] [$SDD_SUSD 213] [$SDD_SUSD 217] [$SDD_SUSD 218] [$SDD_SUSD 219] [$SDD_SUSD 220] [$SDD_SUSD 221] [$SDD_SUSD 222] [$SDD_SUSD 223] [$SDD_SUSD 224] [$SDD_SUSD 242] */
#define SUSD_START_SEC_CODE
#include "SUSD_MemMap.h"
static void Sum_SUSD_ActivityRecords_Active_Handler(void)
{
  /* On entering Active, if in_process == Invalid, initialize it from Sum_SUSD_AR_ActiveSubState */
  if (Sum_SUSD_E0D7_active_substate_in_process == Sum_SUSD_AR_SubState_Invalid)
  {
    Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_ActiveSubState;
  }
  /* Update the Activity Records using the substate information */
  Sum_SUSD_Update_ActivityRecords();
  /* Increment Total Activity Timer for DID 0xE0D7 */
  Sum_SUSD_IncrementTAT();
  /* if the ECU input voltage is below 10V for 10s */
  if (Sum_SUSD_AR_VoltageUnder10_Timer >= 10000u)
  {
    /* Disable monitoring for DID */
    SUSD_MonitorDisabled = TRUE;
	
	/* Transition to "Disabled" state for DID 0xE0D7 */
	SUSD_E0D7_State = Sum_SUSD_AR_State_Disabled;
  /* Whenever E0D7 exits Active to Disabled, reset in_process to Invalid */
  Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_SubState_Invalid;

«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»
	/*Inform SPM ActivityRecordCmd*/
	/* [$Satisfies $SDD_SUSD 249] */
	(void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_StopUpdate);
«ENDIF-»
    /* Sync the DID struct with its corresponding NVRam block */
    Sum_SUSD_flush_E0D7_to_NVRam_Block();
    /* Write everything to NV RAM: Monitor Disabled + whole DID */
    /* [$Satisfies $SDD_SUSD 250] */
    (void) Rte_Call_SUSD_RP_NvMService_E0D7_MonitorDisabled_WriteBlock((const void *) &«sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7_MonitorDisabled_NvMBlockRef.nvMRamBlockDataAddress-»);
    /* [$Satisfies $SDD_SUSD 250] */
    (void) Rte_Call_SUSD_RP_NvMService_DID_E0D7_WriteBlock((const void *) «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7NvMBlockRef.nvMRamBlockDataAddress-»);

  }
  else {

    /* If Vehicle Power Mode is equal to "Propulsion" (monitoring for DID must be enabled at this point) */
    if (LastDeterminedVPM == SUM_PMS_PROPULSION)
    {
      /* Transition to "Inactive" state for DID 0xE0D7 */
      SUSD_E0D7_State = Sum_SUSD_AR_State_Inactive;
      /* Whenever E0D7 exits Active to Inactive, reset in_process to Invalid */
      Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_SubState_Invalid;
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»	  
	  /*Inform SPM ActivityRecordCmd*/
	  /* [$Satisfies $SDD_SUSD 249] */
	  (void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_StopUpdate);
«ENDIF-»
    }
	/* Update IRV before starting NvM write or DID clear to ensure SPM is aware and prevent interruption during longer SPM operations.*/
	/* If the ECU has been in the "Active" state continuously for 3600 seconds */
    if ((Sum_SUSD_GetCurrentTAT() - Sum_SUSD_GetNvM_TAT()) > 3600u)
    {
      /* Sync the DID struct with its corresponding NVRam block */
      Sum_SUSD_flush_E0D7_to_NVRam_Block();
      /* Write to NvM */
      /* [$Satisfies $SDD_SUSD 250] */
      (void) Rte_Call_SUSD_RP_NvMService_DID_E0D7_WriteBlock((const void *) «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7NvMBlockRef.nvMRamBlockDataAddress-»);
    }
  }
}
