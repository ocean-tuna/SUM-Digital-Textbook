#include "SUSD_MemMap.h"

/***********************************************************************************

  Function name :   Sum_SUSD_ActivityRecords_Disabled_Handler
  Description   :   Handler function for the "Disabled" state of DID 0xE0D7
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   [$Satisfies $SDD_SUSD 242]
 ************************************************************************************/
/* Satisfies:  [$SDD_SUSD 187] [$SDD_SUSD 193] */
#define SUSD_START_SEC_CODE
#include "SUSD_MemMap.h"
static void Sum_SUSD_ActivityRecords_Disabled_Handler(void)
{
  /* If (ECU input voltage > 12V for 10s AND Vehicle Power Mode = Propulsion for 60s) */
  if ((Sum_SUSD_AR_VoltageOver12_Timer >= 10000u)  && (Sum_SUSD_AR_Propulsion_Timer >= 60000u))
  {
    SUSD_MonitorDisabled = FALSE;
    /* Transition to state "Inactive" for the DID 0xE0D7 state machine */
    SUSD_E0D7_State = Sum_SUSD_AR_State_Inactive;
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»	  
	  /*Inform SPM ActivityRecordCmd*/
	  /* [$Satisfies $SDD_SUSD 249] */
	  (void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_StopUpdate);
«ENDIF-»
  }
}
