/*
 ***************************************************************************************************
 * Defines
 ***************************************************************************************************
 */
/* Maximum admittable value for DID E0D7 TAT field (in ms) */
#define TAT_MAX_VALUE_MS 0x3E7FFFFFC18u
/*
 ***************************************************************************************************
 * Type definitions
 ***************************************************************************************************
 */
/*
 ***************************************************************************************************
 * Variables
 ***************************************************************************************************
 */
 
/* Current state for DID 0xE0D7 */
static Sum_SUSD_AR_StateType SUSD_E0D7_State = Sum_SUSD_AR_State_Wakeup;
/* Timer variable that measures how long the input voltage is less than 10V (in milliseconds, logic threshold for DID 0xE0D7 is 10s) */
static uint16 Sum_SUSD_AR_VoltageUnder10_Timer = 0u;
/* Timer variable that measures how long the input voltage is greater than 12V (in milliseconds, logic threshold for DID 0xE0D7 is 10s) */
static uint16 Sum_SUSD_AR_VoltageOver12_Timer = 0u;
/* Timer variable that measures how long the Vehicle Power Mode is equal to "Propulsion" (in milliseconds, logic threshold for DID 0xE0D7 is 60s) */
static uint32 Sum_SUSD_AR_Propulsion_Timer = 0u;
/* Timer variable that measures the Active delay timer, i.e. how long the DID 0xE0D7 has been in "Inactive" state (in milliseconds, logic threshold for DID 0xE0D7 is 255s for calibratable value k_AR_Active_Delay) */
static uint32 Sum_SUSD_AR_ActiveDelay_Timer = 0u;
/* Variable to hold the last determined Vehicle Power Mode */
static SUM_VehiclePowerMode_Signal_States LastDeterminedVPM;
/* Keeps the accumulated Total Activity Timer (TAT) gap in ms, recorded in the DID only when it exceeds one second (TAT is measured in seconds in the DID) */
static uint64 Sum_SUSD_E0D7_TAT_in_ms = 0u;
/* RxID cumulative activity timer gaps in ms. These gaps are incremented every time the RxID is currently active.
   Gaps are needed because the DID timing fields are measured in seconds.
   When gaps exceed one second, the time increment is recorded in the RxCAT and RxTAT fields of the 
   corresponding RxID activity record. There is one timer gap for every RxID */
static uint16 Sum_SUSD_E0D7_Cumulative_Timer_Gaps_in_ms[NUM_RxIDS];
/* "On-entry" flags to track whether the specific activity record handler has just been entered:
   Every active RxID handler might have just been invoked ("on_entry" set to TRUE) or be in an iteration
   of its execution on a specific RxID ("on_entry" set to FALSE, otherwise referred    to as "during" being TRUE) */
static boolean Sum_SUSD_E0D7_on_entry_flags[NUM_RxIDS] = {TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE};

/* Holds the state of each RxID. Each state can hold the status from different sources at different bit positions. */
static uint8 Sum_SUSD_RxID_Active[NUM_RxIDS];
static uint8 Sum_SUSD_RxID_Reason[NUM_RxIDS];
/* Holds the previous reason for each RxID, used to capture RxLAR at the moment of deactivation */
static uint8 Sum_SUSD_RxID_PrevReason[NUM_RxIDS];
/* The calculated active sub-state based on the activity of RxIDs */
static Sum_SUSD_AR_ActiveSubStateType Sum_SUSD_AR_ActiveSubState;
/* Lookup table: RxID enum index -> index in Activity_Records[] */ /* PRQA S 3218 1 # This variable will be accessed in other functions */
static uint8 Susd_RxID_to_Index_Map[NUM_RxIDS];
/* Holds the active substate to be processed for DID 0xE0D7 "Active" state */
static Sum_SUSD_AR_ActiveSubStateType Sum_SUSD_E0D7_active_substate_in_process;
/* Variable tracking the next free position in Activity Records array for DID 0xE0D7 */
uint8 Susd_Activity_Records_NextFreeIndex = 0u;
/* Struct for DID E0D7 data */
Susd_DID_E0D7_Type Susd_DID_E0D7 = {0};
/*
 ***************************************************************************************************
 * Functions
 ***************************************************************************************************
 */

static void Sum_SUSD_ActivityRecords_Initialization_WakeUp_Handler(void);
static void Sum_SUSD_ActivityRecord_ToActive_Handler(void);
static void Sum_SUSD_ActivityRecords_Active_Handler(void);
static void Sum_SUSD_ActivityRecords_Disabled_Handler(void);
static void Sum_SUSD_ActivityRecords_Inactive_Handler(void);
static void Sum_SUSD_ActivityRecordUpdated(const RecordIdType * RecordId, Sum_SUSD_AR_SourceType Source);
static void Sum_SUSD_IncrementTWC(void);
static void Sum_SUSD_IncrementTAT(void);
static uint32 Sum_SUSD_GetCurrentTAT(void);
static uint32 Sum_SUSD_GetNvM_TAT(void);
