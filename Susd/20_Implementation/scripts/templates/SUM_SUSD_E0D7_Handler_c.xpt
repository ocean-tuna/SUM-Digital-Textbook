/***********************************************************************************

  Function name :   Sum_SUSD_ActivityRecords_Inactive_Handler
  Description   :   Handler function for the "Inactive" state of DID 0xE0D7
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 195] [$SDD_SUSD 196] [$SDD_SUSD 197] [$SDD_SUSD 198] */
#define SUSD_START_SEC_CODE
#include "SUSD_MemMap.h"
static void Sum_SUSD_ActivityRecords_Inactive_Handler(void)
{
  const uint32 active_delay_threshold_ms = (uint32)Rte_CData_SUSD_PDP_k_AR_Active_Delay() * (uint32)1000u;
  /* Check if last determined Vehicle Power Mode is not "Propulsion" */
  if (LastDeterminedVPM != SUM_PMS_PROPULSION)
  {
    /* Increment Sum_SUSD_AR_ActiveDelay_Timer */
    Sum_SUSD_AR_ActiveDelay_Timer += (uint32) SUSD_AR_PERIODICITY;
    /* If the delay exceeds the calibratable "active delay" threshold */

    if ((Sum_SUSD_AR_ActiveDelay_Timer > active_delay_threshold_ms)«IF isPNCShutdownConfigured(sUSD.sUSDConfigSet)» ||
        (SUSD_GaaSUMShutdownPermission[SUM_PNC] == ENABLESHUTDOWN)«ENDIF»)
    {
      «IF isPNCShutdownConfigured(sUSD.sUSDConfigSet)»
      /* Transition to state "Active" only when timer expired */
      if (Sum_SUSD_AR_ActiveDelay_Timer > active_delay_threshold_ms)
      {
        /* Transition to state "Active" for the DID 0xE0D7 state machine */
        SUSD_E0D7_State = Sum_SUSD_AR_State_Active;
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»        
        /*Inform SPM ActivityRecordCmd*/
        /* [$Satisfies $SDD_SUSD 249] */
        (void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_UpdateRecord);
«ENDIF-»
      }
      «ELSE»
      /* Transition to state "Active" for the DID 0xE0D7 state machine */
      SUSD_E0D7_State = Sum_SUSD_AR_State_Active;
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»          
      /*Inform SPM ActivityRecordCmd*/
      /* [$Satisfies $SDD_SUSD 249] */
      (void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_UpdateRecord);
«ENDIF-»
      «ENDIF»
      /* Clear DID 0xE0D7 */
      Sum_SUSD_ActivityRecord_Clear();
    }
  }
  else {
    /* Reset Sum_SUSD_AR_ActiveDelay_Timer */
    Sum_SUSD_AR_ActiveDelay_Timer = 0u;
  }
}
#define SUSD_STOP_SEC_CODE
#include "SUSD_MemMap.h"

/***********************************************************************************
  Function name :   SUSD_PNC_UpdateRecord
  Description   :   Function Runnable for managing the activity record notification from PNC.
  Parameter in  :   const RecordIdType * RecordId - Activity Record Information
  Parameter out :   None
  Return value  :   Std_ReturnType - error code
  Remarks       :   None
 ************************************************************************************/
