/* Satisfies: [$SDD_SUSD 204] */
FUNC(Std_ReturnType, SUSD_CODE) SUSD_PNC_UpdateRecord(const RecordIdType * RecordId){
    Sum_SUSD_ActivityRecordUpdated(RecordId, Sum_SUSD_AR_PNC);
    return E_OK;
}

