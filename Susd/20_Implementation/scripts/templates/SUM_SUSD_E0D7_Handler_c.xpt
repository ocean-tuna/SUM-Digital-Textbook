static void Sum_SUSD_AR_Substate_0x21_0x25_Handler(void);
static void Sum_SUSD_Generic_Active_RxID_Handler(SUSD_RecordIDType RxID);
static void Sum_SUSD_AR_Substate_OnEntry_Handler(SUSD_RecordIDType RxID);
static void Sum_SUSD_AR_Substate_During_Handler(SUSD_RecordIDType RxID);
static void Sum_SUSD_E0D7_FlushOnResetRequest(void);

/***********************************************************************************

  Function name :   RE_Sum_SUSD_ActivityRecords_Handler
  Description   :   Function Runnable for managing the state of DID 0xE0D7
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 228] [$SDD_SUSD 178] [$SDD_SUSD 179] [$SDD_SUSD 180] [$SDD_SUSD 189] [$SDD_SUSD 190] [$SDD_SUSD 191] [$SDD_SUSD 192] [$SDD_SUSD 214] [$SDD_SUSD 215] [$SDD_SUSD 216] */
#define SUSD_START_SEC_CODE /* PRQA S 5087 EOF */
#include "SUSD_MemMap.h"
/* PRQA S 1503 3 # When the SUSD is integrated, this Runnable will be called by RTE */
FUNC(void, SUSD_CODE) RE_Sum_SUSD_ActivityRecords_Handler(void)//Scheduled in the OS
{
  /* Variable to hold the current Vehicle Battery Voltage (in dV) */
  Impl_SUSD_VehcleBatryVlg VehicleBatteryVoltage;
  /* Check SUSD init state */
  if(SUSD_GetInitState() == E_OK)
  {
    /* Read Vehicle Battery Voltage */
    /* [$Satisfies $SDD_SUSD 248] */
    (void) Rte_Read_RP_SUSD_VehicleBatteryVoltage_VehicleVoltage(&VehicleBatteryVoltage);
    /* Retrieve the last determined Vehicle Power Mode */
    LastDeterminedVPM = SUSD_VehiclePowerMode;
    /* Apply voltage timers update logic*/
    if (VehicleBatteryVoltage > (uint16) 120u)
    {
      Sum_SUSD_AR_VoltageOver12_Timer += (uint16) SUSD_AR_PERIODICITY;
      Sum_SUSD_AR_VoltageUnder10_Timer = (uint16) 0u;
    }
    else if (VehicleBatteryVoltage >= (uint16) 100u)
    {
      Sum_SUSD_AR_VoltageOver12_Timer = (uint16) 0u;
      Sum_SUSD_AR_VoltageUnder10_Timer = (uint16) 0u;
    }
    else
    {
      Sum_SUSD_AR_VoltageOver12_Timer = (uint16) 0u;
      Sum_SUSD_AR_VoltageUnder10_Timer += (uint16) SUSD_AR_PERIODICITY;
    }
    /* Apply Vehicle Power Mode timer update logic */
    if (LastDeterminedVPM == SUM_PMS_PROPULSION)
    {
      Sum_SUSD_AR_Propulsion_Timer += (uint32) SUSD_AR_PERIODICITY;
    }
    else
    {
      Sum_SUSD_AR_Propulsion_Timer = (uint32) 0u;
    }  
    /* Run state machine for DID 0xE0D7 */
    switch (SUSD_E0D7_State) {
      case Sum_SUSD_AR_State_Wakeup:
        Sum_SUSD_ActivityRecords_Initialization_WakeUp_Handler();
        break;
      case Sum_SUSD_AR_State_ToActive:
        Sum_SUSD_ActivityRecord_ToActive_Handler();
        break;
      case Sum_SUSD_AR_State_Active:
        Sum_SUSD_ActivityRecords_Active_Handler();
        break;
      case Sum_SUSD_AR_State_Disabled:
        Sum_SUSD_ActivityRecords_Disabled_Handler();
        break;
      case Sum_SUSD_AR_State_Inactive:
        Sum_SUSD_ActivityRecords_Inactive_Handler();
        break;
      default:
        /* Do nothing */
        break;
    }  
    /* Flush DID E0D7 to NvM on diagnostic reset or reprogramming request */
    Sum_SUSD_E0D7_FlushOnResetRequest();      
  }
}
#define SUSD_STOP_SEC_CODE
#include "SUSD_MemMap.h"

/***************************************************************************************

  Function name :   Sum_SUSD_ActivityRecords_Initialization_WakeUp_Handler
  Description   :   Handler function for the "Initialization/Wakeup" state of DID 0xE0D7
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   None
 ***************************************************************************************/
/* Satisfies: [$SDD_SUSD 178] [$SDD_SUSD 180] [$SDD_SUSD 181] [$SDD_SUSD 183] [$SDD_SUSD 184] [$SDD_SUSD 185] [$SDD_SUSD 186] */
#define SUSD_START_SEC_CODE
#include "SUSD_MemMap.h"
static void Sum_SUSD_ActivityRecords_Initialization_WakeUp_Handler(void)
{
  /* Check if first boot after flash */
  if (Sum_SUSD_isFirstBootAfterFlash() == TRUE)
  {
    /* Clear DID 0xE0D7 */
    Sum_SUSD_ActivityRecord_Clear();
    /* Reset Sum_SUSD_AR_ActiveDelay_Timer */
    Sum_SUSD_AR_ActiveDelay_Timer = 0u;
    /* Enable monitoring for DID 0xE0D7 */
    SUSD_MonitorDisabled = FALSE;
  }
  /* If monitoring for DID 0xE0D7 is disabled */
  if (SUSD_MonitorDisabled == TRUE)
  {
    /* Transition to "Disabled" state for DID 0xE0D7 */
    SUSD_E0D7_State = Sum_SUSD_AR_State_Disabled;
  }
  else {
    /* Increment DID Total Wakeup Counter */
    Sum_SUSD_IncrementTWC();
    /* If Vehicle Power Mode is not "Propulsion" */
    if (LastDeterminedVPM != SUM_PMS_PROPULSION)
    {
      /* Transition to "Initialization to Active Check" state for the DID 0xE0D7 state machine */
      SUSD_E0D7_State = Sum_SUSD_AR_State_ToActive;
    }
    else {
      /* Transition to "Inactive" state for the DID 0xE0D7 state machine */
      SUSD_E0D7_State = Sum_SUSD_AR_State_Inactive;
    }    
  }
}
#define SUSD_STOP_SEC_CODE
#include "SUSD_MemMap.h"

/***********************************************************************************

  Function name :   Sum_SUSD_ActivityRecord_ToActive_Handler
  Description   :   Handler function for the "Initialization to Active Check" state of DID 0xE0D7
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 199] [$SDD_SUSD 200] [$SDD_SUSD 201] [$SDD_SUSD 202] [$SDD_SUSD 203] */
#define SUSD_START_SEC_CODE
#include "SUSD_MemMap.h"
static void Sum_SUSD_ActivityRecord_ToActive_Handler(void)
{
  /* Detected wakeup source */
  SUSD_RecordIDType source;
  /* Indicates whether we're waiting on local PN/AP activations (assumed false when the wakeup source is not yet known) */
  static boolean waiting_on_local_PN_AP_WUF_activations  = FALSE;
  
  /* If the state machine has just transitioned into the "Initialization to Active Check" state */
  if (waiting_on_local_PN_AP_WUF_activations  == FALSE)
  {
    /* Match wakeup source with RxID 0x02 and 0x03 */
    source = Sum_SUSD_Match_0x02_0x03_WakeupSource();
    /* In case of RxID = 0x02 or 0x03, update DID with wakeup information and transition to "Active" state */
    if ((source == RxID_REMOTE_PN_AP_ACTIVE_NO_LOCAL_PN_AP_ACTIVE) || (source == RxID_PRIVATE_NETWORK_ACTIVE))
    {
      Sum_SUSD_UpdateWakeupActivityRecord(source);
      SUSD_E0D7_State = Sum_SUSD_AR_State_Active;
      /* Update substate to process */
      if (source == RxID_REMOTE_PN_AP_ACTIVE_NO_LOCAL_PN_AP_ACTIVE)
      {
        Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_SubState_0x02;
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»
		    /*Inform SPM ActivityRecordCmd*/
        /* [$Satisfies $SDD_SUSD 249] */
        (void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_UpdateRecord);
«ENDIF-»
      }
      else
      {
        Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_SubState_0x03;
      }      
       
    }
    /* Else, wakeup source = Record 0x01/0x20-0x25 criteria */
    else
    {
      /* We must wait on local PN/AP activations (the Init Delay Timer is implicitly started here) */
      waiting_on_local_PN_AP_WUF_activations  = TRUE;
    }
  }
  /* Else: we are waiting for local PN/AP activations within k_AR_Init_Delay ms */
  else
  {
    /* Timer variable to measure the init delay for local PN/AP activations (in milliseconds, logic threshold for DID 0xE0D7 is 2550ms for calibratable value k_AR_Init_Delay) */
    static uint16 Sum_SUSD_AR_InitDelay_Timer = 0u;
    /* Increment Sum_SUSD_AR_InitDelay_Timer */
    Sum_SUSD_AR_InitDelay_Timer += (uint16) SUSD_AR_PERIODICITY;
    /* If the time delay hasn't exceeded the calibratable "init delay" threshold */
    if (Sum_SUSD_AR_InitDelay_Timer <= Rte_CData_SUSD_PDP_k_AR_Init_Delay())
    {
      /* Tracks the appearance of local PNs/APs activations */
      boolean local_activation = FALSE;
      /* Counts the local PN activations */
      uint8 local_PN_activations_ctr = 0u;
      /* Match a local AP activation */
      source = Sum_SUSD_Match_0x20_WakeupSource();
      if (source == RxID_LOCALLY_ACTIVE_AP)
      {
        /* Update DID with wakeup information for Record 0x20. In this case, the active substate will be Sum_SUSD_AR_SubState_0x20 */
        Sum_SUSD_UpdateWakeupActivityRecord(source);
        local_activation = TRUE;
        Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_SubState_0x20;
      }
      /* Match all possible local PN activations, in order of enumeration (their activation criteria must have been met at the same time) */
      source = Sum_SUSD_Match_0x21_0x25_WakeupSource();
      while (source != RxID_NO_RECORD)
      {
        local_PN_activations_ctr++;
        /* Update DID with wakeup information for the locally activated PN */
        Sum_SUSD_UpdateWakeupActivityRecord(source);
        /* Get next active local PN (if any) */
        source = Sum_SUSD_Match_0x21_0x25_WakeupSource();   
      }
      /* Remember if there has been a local PN activation */
      if (local_PN_activations_ctr > 0u)
      {
        local_activation = TRUE;
        /* In this case, the active substate ought to be Sum_SUSD_AR_SubState_0x21-0x25 */
        Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_SubState_0x21_0x25;
      }
      if (local_activation == TRUE)
      {
        /* Transition to "Active" state for DID 0xE0D7 */
        SUSD_E0D7_State = Sum_SUSD_AR_State_Active; 
		
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»
		    /*Inform SPM ActivityRecordCmd*/
        /* [$Satisfies $SDD_SUSD 249] */
        (void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_UpdateRecord);
«ENDIF-»
        /* Stop Init Delay Timer */
        Sum_SUSD_AR_InitDelay_Timer = 0u;
		
        /* For next wakeup, restart source analysis from scratch */
        waiting_on_local_PN_AP_WUF_activations  = FALSE;  
      }
      else
      {
        Sum_SUSD_Match_0x26_WakeupSource(&Sum_SUSD_AR_InitDelay_Timer, &waiting_on_local_PN_AP_WUF_activations);
      }
      /* Implicit "else": return(), keep checking for local activations within k_AR_Init_Delay ms */
    }
    /* Else: no local PN/AP activation occurred within k_AR_Init_Delay ms, wakeup source must be Record 0x01 criteria */
    else
    {
      /* Update DID with wakeup information and transition to "Active" state */      
      Sum_SUSD_UpdateWakeupActivityRecord(RxID_NO_PN_ACTIVE_NO_PRIVATE_NETWORK_ACTIVE);
      /* In this case, the active substate will be Sum_SUSD_AR_SubState_0x01 */
      SUSD_E0D7_State = Sum_SUSD_AR_State_Active;
«IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»
		  /*Inform SPM ActivityRecordCmd*/
      /* [$Satisfies $SDD_SUSD 249] */
      (void) Rte_Call_RP_SUSD_SPM_ActivityRecordCmd_ActivityRecordCmd(SUM_ARC_UpdateRecord);
«ENDIF-»
      Sum_SUSD_E0D7_active_substate_in_process = Sum_SUSD_AR_SubState_0x01;
	  /* Initialize Sum_SUSD_AR_ActiveSubState to sync with Sum_SUSD_E0D7_active_substate_in_process */
      Sum_SUSD_AR_ActiveSubState = Sum_SUSD_AR_SubState_0x01;
      /* For next wakeup, restart wakeup source analysis from scratch */
      waiting_on_local_PN_AP_WUF_activations  = FALSE;
    }
  }
}
