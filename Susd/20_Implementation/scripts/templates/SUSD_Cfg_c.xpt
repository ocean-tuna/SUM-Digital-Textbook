			«FOREACH this.sUSD.sUSDConfigSet.sUSD_BatteryVoltageRange.sUSD_C_BatteryVoltageRange AS voltRange»
				«IF (voltRange.getReferrers().size > 0)-»
/* PRQA S 1504 3 */ /* This struct is generated, it can be used in the multiple file and can not be turned into static as well as moved to static code */
const SUSD_SWCToVoltRangeReferenceType SWC_«voltRange.shortName»_Mapping[«voltRange.getReferrers().size»] =
{
					«FOREACH Susd_SWCToVoltRangeRefList(this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo, voltRange.shortName) AS Swc ITERATOR j SEPARATOR ','»
	{
		&Rte_Write_PP_«Swc.sUSD_SWCName»_SUSD_PermitExecution_SUSD_SWC_ExecutionStatus,

						«FOREACH this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo.sortBy(e|e.sUSD_SWCName) AS Swc_Info ITERATOR i-»
							«IF (Swc_Info.sUSD_SWCName == Swc.sUSD_SWCName)-»
		/* SWC Index */
		«i.counter0»
							«ENDIF-»
						«ENDFOREACH-»
	}
					«ENDFOREACH-»
};
				«ENDIF-»
			«ENDFOREACH-»

			«IF (Susd_SWCNoVoltRangeRefList(this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo).size > 0)»
/* PRQA S 1504 3 */ /* This struct is generated, it can be used in the multiple file and can not be turned into static as well as moved to static code */
const SUSD_SWCToVoltRangeReferenceType SWC_Default9To16V_Mapping[«Susd_SWCNoVoltRangeRefList(this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo).size»] =
{
				«FOREACH Susd_SWCNoVoltRangeRefList(this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo) AS Swc ITERATOR j SEPARATOR ','»
	{
		&Rte_Write_PP_«Swc.sUSD_SWCName»_SUSD_PermitExecution_SUSD_SWC_ExecutionStatus,

					«FOREACH this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo.sortBy(e|e.sUSD_SWCName) AS Swc_Info ITERATOR i-»
						«IF (Swc_Info.sUSD_SWCName == Swc.sUSD_SWCName)-»
		/* SWC Index */
		«i.counter0»
						«ENDIF-»
					«ENDFOREACH-»
	}
				«ENDFOREACH-»
};
			«ENDIF-»

/* Normal voltage range with resolution of 0.1 V */
/* PRQA S 1531 3 */ /* This struct is generated, it can be used in the multiple file and can not be turned into static as well as moved to static code */
const SUSD_BatteryVoltageRangeType SUSD_BatteryVoltageThreshold[«sUSD.sUSDConfigSet.sUSD_BatteryVoltageRange.sUSD_C_BatteryVoltageRange.size + 1»] =
{
	{
		/* Default voltage range for 9V to 16V */
		/* Port interface for battery voltage range, normal, over or undervoltage */
		&Rte_Write_PP_SUSD_DefaultBatteryVoltage_MintoMax_9Vto16V_OperatingRange,

		/* Under Voltage hysteresis */
		&Rte_CData_SUSD_C_DefaultUnderVoltage_hysteresis,

		/* Over Voltage hysteresis */
		&Rte_CData_SUSD_C_DefaultOverVoltage_hysteresis,

		/* Min range */
		90,

		/* Max range */
		160,

		/* Number of SWCs reference to this voltage range */
		«Susd_SWCNoVoltRangeRefList(this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo).size»,

		/* Pointer to SWCs mapping */
				«IF(Susd_SWCNoVoltRangeRefList(this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo).size > 0)-»
		SWC_Default9To16V_Mapping
				«ELSE-»
		NULL_PTR
				«ENDIF-»
	},
			«FOREACH this.sUSD.sUSDConfigSet.sUSD_BatteryVoltageRange.sUSD_C_BatteryVoltageRange AS voltRange ITERATOR i SEPARATOR ','»
	{
		/* Port interface for battery voltage range, normal, over or undervoltage */
		&Rte_Write_PP_SUSD_BatteryVoltage_MintoMax_«voltRange.shortName»_OperatingRange,

		/* Under Voltage hysteresis */
		&Rte_CData_SUSD_C_UnderVoltage_hysteresis_«voltRange.shortName»,

		/* Over Voltage hysteresis */
		&Rte_CData_SUSD_C_OverVoltage_hysteresis_«voltRange.shortName»,

		/* Min range */
		«(voltRange.sUSD_C_BatteryVoltageRange_Min*10).toInteger()»,

		/* Max range */
		«(voltRange.sUSD_C_BatteryVoltageRange_Max*10).toInteger()»,

		/* Number of SWCs reference to this voltage range */
		«voltRange.getReferrers().size»,

				«IF (voltRange.getReferrers().size > 0)-»
		/* Pointer to SWCs mapping */
		SWC_«voltRange.shortName»_Mapping
				«ELSE-»
		NULL_PTR
				«ENDIF-»
	}
			«ENDFOREACH-»
};

