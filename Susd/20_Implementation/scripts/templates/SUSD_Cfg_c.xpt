/* Variable used to store DID E0D7 Data */
/* [$Satisfies $SDD_SUSD 236] */
/* [$Satisfies $SDD_SUSD 250] */
/* PRQA S 1531 1 # This variable can be used in the multiple file and can not be turned into static as well as moved to static code */
VAR(uint8, RTE_CODE) «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7NvMBlockRef.nvMRamBlockDataAddress-»[SUSD_E0D7_MAX_LENGTH];

/* Variable used to store First Boot Post Flash flag */
/* [$Satisfies $SDD_SUSD 237] */
/* [$Satisfies $SDD_SUSD 250] */
/* PRQA S 1504 1 # Implicitly used by NvM, need to have external linkage */
