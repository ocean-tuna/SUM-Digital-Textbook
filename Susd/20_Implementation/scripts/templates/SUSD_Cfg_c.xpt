/* PRQA S 1531 1 # This variable can be used in the multiple file and can not be turned into static as well as moved to static code */
VAR(boolean, RTE_CODE) «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7_MonitorDisabled_NvMBlockRef.nvMRamBlockDataAddress-»;

/* Satisfies: [$SDD_SUSD 007] */
/* Constant array containing the link between the EcuM Wakeup source and the corresponding ComM channel Bus Type */
/* PRQA S 1533 1 */ /* This struct is generated and can not be turned into static and moved to static code */
CONST (uint32, RTE_CONST) SUSD_GaaWakeupSourcesArray[NO_OF_WAKEUPSRCS] =
{
	«LET 1 AS int-»
    «LET sUSD.sUSDWakeUpRelation.sUSD_WakeupSourceId
      .union(sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMs_SpecificWkSrcId)
      .union(sUSD.sUSDConfigSet.sUSD_C_SWCInfo.sUSD_SWCs_SpecificWkSrcId)
      .toSet().sortBy(e|e.ecuMWakeupSourceId) AS allWakeupSources-»
		«FOREACH allWakeupSources AS WakeupSource SEPARATOR ','»
			«REM» For bit 31 (0x80000000), xpt produces a 64-bit value, so managed manually. «ENDREM-»
			«IF int.shiftLeftOperand(WakeupSource.ecuMWakeupSourceId).Hex() != "0xFFFFFFFF80000000"-»
        		«int.shiftLeftOperand(WakeupSource.ecuMWakeupSourceId).Hex()»u
			«ELSE-»
        		0x80000000u
			«ENDIF-»
		«ENDFOREACH-»
	«ENDLET-»
	«ENDLET-»
};

/* Satisfies: [$SDD_SUSD 008], [$SDD_SUSD 009], [$SDD_SUSD 010], [$SDD_SUSD 011], [$SDD_SUSD 012],
   [$SDD_SUSD 013], [$SDD_SUSD 014] */
/* Function pointers to RTE interface API with SUM for Permit Execution Interface */
/* PRQA S 1531 1 */ /* This struct is generated, it can be used in the multiple files and cannot be turned into static as well as moved to static code */
CONST (PermitExecutionInterface, RTE_CONST) SUSD_GaaSUM_PermitExec_Interface[SUSD_SUM_PERMEXE] =
{
		«FOREACH sUSD.sUSDConfigSet.sUSD_C_SUMsInfo AS sum-»
			«IF sum.sUSD_PermitExecution == true-»
	&Rte_Write_PP_«sum.sUSD_SUMsName»_SUSD_PermitExecution_SUSD_SWC_ExecutionStatus,
			«ENDIF-»
		«ENDFOREACH-»
};

/* Function pointers to RTE interface API with SUM for Shutdown Permission Interface */
/* PRQA S 1531 1 */ /* This struct is generated, it can be used in the multiple files and cannot be turned into static as well as moved to static code */
CONST (SUMShutdownPermInterface, RTE_CONST) SUSD_GaaSUM_ShutdwnPer_Interface[SUSD_SUM_SHUTPERM] =
{
		«FOREACH sUSD.sUSDConfigSet.sUSD_C_SUMsInfo AS sum-»
			«IF sum.sUSD_ShutdownPermission == true-»
	&Rte_Read_RP_«sum.sUSD_SUMsName»_SUSD_ShutdownPermission_SUSD_UserRequest,
			«ENDIF-»
		«ENDFOREACH-»
};

