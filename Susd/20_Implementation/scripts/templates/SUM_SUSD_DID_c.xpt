/***********************************************************************************

  Function name :   RE_ReadData_DID_E0D7
  Syntax        :   RE_ReadData_DID_E0D7(«IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,«ENDIF-» CONSTP2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
  Description   :   Provides the data for DID 0xE0D7 upon request from DCM.
                    The function fills the output buffer with:
                    - Total Activity Timer (TAT)
                    - Total Wakeup Counter (TWC)
                    - A sequence of Activity Records, each containing:
                      - Record ID (RxID)
                      - Wakeup Reason (RxWR)
                      - Last Active Reason (RxLAR)
                      - Current Activity Timer (RxCAT)
                      - Total Activity Timer (RxTAT)
                      - Wakeup Counter (RxWC)
                    The function adds padding bytes with a value of 0,
                    if the number of activity records is 0 or 1.
                    The function uses the global Susd_DID_E0D7 structure,
                    assumed to be previously initialized or restored from NvM.
«IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»  Parameter in  :   OpStatus    - Operation status from DCM (ignored) «ENDIF-»
  Parameter out :   Data        - Pointer to buffer to be filled with DID data
  Return value  :   E_OK
  Remarks       :   [$Satisfies $SDD_SUSD 230]
***********************************************************************************/
/* PRQA S 1532 1 # When the SUSD is integrated, this function may be called by RTE*/
FUNC(Std_ReturnType, SUSD_CODE) RE_ReadData_DID_E0D7(
    «IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,«ENDIF-»
    P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
    «IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»
    /* OpStatus argument ignored in this case. Following cast to avoid compiler warning. */
    /* PRQA S 3469 1 */ /* unused param */
        SUM_PARAM_UNUSED(OpStatus);
    «ENDIF-»
    {
		uint16 index = 0u;
		uint8 i;
        uint16 paddingLen_u8;

		/* TAT */
		SUSD_SERIALIZE_E0D7_U32(Susd_DID_E0D7.TAT, Data, index);
		index += 4u;

		/* TWC */
		SUSD_SERIALIZE_E0D7_U16(Susd_DID_E0D7.TWC, Data, index);
		index += 2u;

		/* Activity Records */
		for (i = 0; i < Susd_Activity_Records_NextFreeIndex; i++) {
			Data[index] = (uint8)Susd_DID_E0D7.Activity_Records[i].RxID;
			index += 1u;

			Data[index] = Susd_DID_E0D7.Activity_Records[i].RxWR;
			index += 1u;

			Data[index] = Susd_DID_E0D7.Activity_Records[i].RxLAR;
			index += 1u;

			SUSD_SERIALIZE_E0D7_U16(Susd_DID_E0D7.Activity_Records[i].RxCAT, Data, index);
			index += 2u;

			SUSD_SERIALIZE_E0D7_U32(Susd_DID_E0D7.Activity_Records[i].RxTAT, Data, index);
			index += 4u;

			SUSD_SERIALIZE_E0D7_U16(Susd_DID_E0D7.Activity_Records[i].RxWC, Data, index);
			index += 2u;
		}
		/* DID E0D7 always returns a minimum of 28 bytes.
		   Add padding bytes if the number of activity records is 0 or 1. */
		if(Susd_Activity_Records_NextFreeIndex < SUSD_ACTIVITY_RECORDS_MIN_NUMBER)
		{
		    /* For activity record number 0:
		       - 6 bytes (TAT + TWC) are populated in the buffer,
		       - 22 padding bytes are required to align the data  */
		    /* For activity record number 1:
		       - 17 bytes (TAT + TWC + 11 bytes of 1 activity record) are populated in the buffer,
		       - 11 padding bytes are required to align the data  */

		    paddingLen_u8 =  SUSD_E0D7_MIN_LENGTH - index;
		    for (i = 0; i < paddingLen_u8; i++) {
		        /* Data padded with 0 */
			    Data[index] = 0x00;
			    index += 1u;
		    }
		}
    }

    return E_OK;
}

/***********************************************************************************
  Function name :   RE_ReadDataLength_DID_E0D7
  Syntax        :   RE_ReadDataLength_DID_E0D7(«IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,«ENDIF-»
                                               P2VAR(uint16, AUTOMATIC, RTE_APPL_DATA) DataLength)
  Description   :   Provides the total length (in bytes) of the data corresponding
                    to DID 0xE0D7, to be used by the DCM.
                    The total length includes:
                    - Fixed part: Total Activity Timer (4 bytes) + Total Wakeup Counter (2 bytes)
                    - Variable part: zero or more Activity Records (11 bytes each)
                    The number of records is given by Susd_Activity_Records_NextFreeIndex.
«IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»  Parameter in  :   OpStatus    - Operation status from DCM (ignored) «ENDIF-»
  Parameter out :   DataLength  - Pointer to variable where the total data length will be stored
                    Data length constraints: Minimum = 28 bytes, Maximum = 182 bytes.
  Return value  :   E_OK
  Remarks       :   [$Satisfies $SDD_SUSD 231]
***********************************************************************************/
/* PRQA S 1503 1 # When the SUSD is integrated, this function may be called by RTE*/
FUNC(Std_ReturnType, SUSD_CODE) RE_ReadDataLength_DID_E0D7(
    «IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,«ENDIF-»
    P2VAR(uint16, AUTOMATIC, RTE_APPL_DATA) DataLength)
{
    «IF Susd_IsDIDE0D7AsyncCS(sUSD.sUSDConfigSet.sUSDDiagReferences)-»
    /* OpStatus argument ignored in this case. Following cast to avoid compiler warning. */
    /* PRQA S 3469 1 */ /* unused param */
        SUM_PARAM_UNUSED(OpStatus);
    «ENDIF-»
    {
        /* Initialize to the minimum number of Activity Records */
    	uint16 number_of_itm_in_ac_u16 = SUSD_ACTIVITY_RECORDS_MIN_NUMBER;

    	if((Susd_Activity_Records_NextFreeIndex > number_of_itm_in_ac_u16) &&
    	    (Susd_Activity_Records_NextFreeIndex < SUSD_ACTIVITY_RECORDS_MAX_NUMBER))
    	{
    	    number_of_itm_in_ac_u16 = (uint16)Susd_Activity_Records_NextFreeIndex;
    	}
        else if(Susd_Activity_Records_NextFreeIndex >= SUSD_ACTIVITY_RECORDS_MAX_NUMBER)
    	{
    	    number_of_itm_in_ac_u16 = SUSD_ACTIVITY_RECORDS_MAX_NUMBER;
    	}
    	else {
    	     /* activity records should be SUSD_ACTIVITY_RECORDS_MIN_NUMBER */
    	}

    	/* TAT (4) + TWC (2) fixed part + (number of Activity Records * 11 byte for each records )*/
    	*DataLength = 6u + (11u * number_of_itm_in_ac_u16);
    }

    return E_OK;
}

/***********************************************************************************
  Function name :   RE_ReadData_DID_F088
  Syntax        :   RE_ReadData_DID_F088(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                               P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
  Description   :   Provides 4 control module input voltage in unit of dV
  Parameter in  :   OpStatus    - Operation status from DCM (ignored)
  Parameter out :   Data        - Pointer to variable where the data will be stored
  Return value  :   E_OK
  Remarks       :   [$Satisfies $SDD_SUSD 240]
***********************************************************************************/
/* PRQA S 1503 1 # When the SUSD is integrated, this function may be called by RTE*/
FUNC(Std_ReturnType, SUSD_CODE) RE_ReadData_DID_F088(
    VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
    P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
    if(Rte_Read_RP_SUSD_SWC_ControlModuleInputPower1_CMInputVoltage(&(Data[0])) != E_OK){
        Data[0] = 0x00u; /* Default value if read fails */
    }
    if(Rte_Read_RP_SUSD_SWC_ControlModuleInputPower2_CMInputVoltage(&(Data[1])) != E_OK){
        Data[1] = 0x00u; /* Default value if read fails */
    }
    if(Rte_Read_RP_SUSD_SWC_ControlModuleInputPower3_CMInputVoltage(&(Data[2])) != E_OK){
        Data[2] = 0x00u; /* Default value if read fails */
    }
    if(Rte_Read_RP_SUSD_SWC_ControlModuleInputPower4_CMInputVoltage(&(Data[3])) != E_OK){
        Data[3] = 0x00u; /* Default value if read fails */
    }
	/* PRQA S 3469 1 */ /* unused parameter */
    SUM_PARAM_UNUSED(OpStatus);

    return E_OK;
}

«IF isDIDCheckReadFuncConfigured(sUSD.sUSDConfigSet.sUSDDiagReferences.did_F089_Reference.dcmDspDidSignal.get(0).dcmDspDidDataRef)-»
/***********************************************************************************
  Function name :	RE_DID_F089_ConditionCheckRead
  Syntax        :   FUNC(Std_ReturnType, SUSD_CODE) RE_DID_F089_ConditionCheckRead(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) ErrorCode)
  Description   :   Runnable for condition check read operation for DID 0xF089
  Parameter in  :   OpStatus - Operation status from DCM (unused)
  Parameter out :   ErrorCode - response code indicating success/failure
  Return value  :   E_OK  Success , E_NOT_OK  Unsuccess
 ************************************************************************************/
/* PRQA S 1503 3*/ /* This function will be called by DCM */
/* Satisfies: [$SDD_SUSD 002] [$SDD_SUSD 244] */
FUNC(Std_ReturnType, SUSD_CODE) RE_DID_F089_ConditionCheckRead(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) ErrorCode)
{

		 /* Total Swcs number consisting of SWC and SUM modules */
    	static uint32 totalSwc = (uint32)(NO_OF_SWCS + SUSD_SUM_SHUTPERM);
    	Std_ReturnType retVal;
		/* PRQA S 3469 1 */ /* unused parameter */
	    SUM_PARAM_UNUSED(OpStatus);

        /* Total number of SWC and SUM modules must be less or equal 48 (DID is 6 bytes length)*/
        /* PRQA S 2880 8*/ /* PRQA S 2741 1*//* Depends on project configuration */
        if ( totalSwc <= (DID_F089_LEN * 8u))
        {
            *ErrorCode = DCM_POS_RESP;
             retVal = E_OK;
        }
        else
        {
            *ErrorCode = DCM_E_REQUESTOUTOFRANGE;
            retVal = E_NOT_OK;
        }
	return retVal;
}
«ENDIF-»

/***********************************************************************************
  Function name :	SetToOneShutdownStatus
  Description   :   Function that allows to set to 1 the bit corresponding to the current SWC/SUM. 1 means that the Shutdown prohibit is active (shutdown not allowed)
  Parameter in  :   Data - Pointer to the data buffer, bitpos - Bit position to set
  Parameter out :   None
  Return value  :   void
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SetToOneShutdownStatus ( P2VAR(uint8, AUTOMATIC,RTE_APPL_DATA) Data, VAR(uint8, AUTOMATIC) bitpos)
{

    uint8 bytePosition, bitPosition;
    bytePosition = (uint8)(bitpos / 8u);
	bitPosition = (uint8) (bitpos % 8u);
	Data[bytePosition] |= 1u << (7u - bitPosition);

}

/***********************************************************************************
  Function name :	RE_DID_F089_ReadData
  Syntax        :   FUNC(Std_ReturnType, SUSD_CODE) RE_DID_F089_ReadData(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
  Description   :   Runnable for condition read operation for DID 0xF089 which allows to set, in the Data buffer, the shutdown permission status of SWC and SUM modules.
                    The function fills the output buffer with:
                     1 Shutdown prohibit is active (shutdown not allowed)
                     0 Shutdown prohibit is not active (shutdown allowed)
  Parameter in  :   OpStatus - Operation status from DCM (unused)
  Parameter out :   ErrorCode - response code indicating success/failure
  Return value  :   E_OK  Success , E_NOT_OK  Unsuccess
 ************************************************************************************/
/* PRQA S 1503 2*/ /* This function will be called by DCM */
/* Satisfies: [$SDD_SUSD 002] [$SDD_SUSD 244] */
FUNC(Std_ReturnType, SUSD_CODE) RE_DID_F089_ReadData(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
    uint8 i, index;
    Std_ReturnType retVal = E_OK;
    /* Total Swcs number consisting of SWC and SUM modules */
    static uint32 totalSwc = (uint32)(NO_OF_SWCS + SUSD_SUM_SHUTPERM);
    /* Counters to tracking the number of SUM modules and SWC, if configured */
«IF NumOfSwcConfigured(sUSD.sUSDConfigSet) >= 1-»
    uint32 SWCindex = 0;
«ENDIF-»
    uint8 SUMindex = 0;
    /* PRQA S 3469 1 */ /* unused parameter */
	SUM_PARAM_UNUSED(OpStatus);

	/* PRQA S 2995 1 */ /* totalSwc value depends on the configuration */
    if ((Data != NULL_PTR) && (totalSwc <= (DID_F089_LEN * 8u)))
    {
        /* Initialize the Data array received*/
        for (i= SUSD_ZERO; i < DID_F089_LEN; i++)
        {
            Data[i]= 0u;
        }

        /* Iteration on TotalSWC swc+sum*/
        for (index = SUSD_ZERO; index < totalSwc; index++)
        {
            /* Consider at first the SUM configured and after the SWCs, if configured */
            if ( SUMindex < SUSD_SUM_SHUTPERM )
            {
                /* Check if the shutdown interface exists and if the shutdown permission is enabled for SUM */
                if(SUSD_GaaSUMShutdownPermission[SUMindex] != ENABLESHUTDOWN)
                {
                    SetToOneShutdownStatus(Data,index);
                }

                SUMindex++;
            }
«IF NumOfSwcConfigured(sUSD.sUSDConfigSet) >= 1-»
            else if ( SWCindex != NO_OF_SWCS) /* Processing Swcs */
            {
                /* Check if shutdown interface exists and if the shutdown permission is enabled for SWC */
                if((SUSD_GaaRteSWCInterface[SWCindex].SWCShutdownPermInterface != NULL_PTR) && (SUSD_GaaSWCShutdownPermission[SWCindex] != ENABLESHUTDOWN))
                {
                    SetToOneShutdownStatus(Data,index);
                }

                SWCindex++;
            }
«ENDIF-»
            else
            {
                /*Nothing to do*/
            }
        }

    }
    else
    {
        /* Data buffer is NULL or totalSWC = Swc + SUM exceeds 48 bits */
        retVal = E_NOT_OK;
    }

    return retVal;
}

/***********************************************************************************
  Function name :   SUSD_E0D7_Populate_On_Startup
  Description   :   Update the unmarshalled version of the DID 0xE0D7 NVRam mirror block after reading on startup
  Parameter in  :
  Parameter out :
  Return value  :   void
 ************************************************************************************/
/* PRQA S 1532 1 # For simmetry with serialization functions */
FUNC(void, SUSD_CODE) SUSD_E0D7_Populate_On_Startup(void)
{
    uint8 const *ptr = «sUSD.sUSDConfigSet.sum_SUSD_ActivityRecords.sum_SUSD_E0D7NvMBlockRef.nvMRamBlockDataAddress»;
    uint8 i = 0u;

    /* TAT */
    /* PRQA S 3469 1 # For simmetry with serialization function-like macros */
    Susd_DID_E0D7.TAT = SUSD_BE_BYTES_TO_UINT32(ptr);
    ptr += 4;

    /* TWC */
    /* PRQA S 3469 1 # For simmetry with serialization function-like macros */
    Susd_DID_E0D7.TWC = SUSD_BE_BYTES_TO_UINT16(ptr);
    ptr += 2;

    /* Activity Records */
    /* PRQA S 3469 2 # For simmetry with serialization function-like macros */
    /* PRQA S 1881 1 # The usage of the enum is strictly controlled and within the bounds */
    while (*ptr != RxID_NO_RECORD)
    {
        /* PRQA S 4342 1 # The usage of the enum is strictly controlled and within the bounds */
        Susd_DID_E0D7.Activity_Records[i].RxID = (SUSD_RecordIDType)(*ptr);
        ptr += 1;
        Susd_DID_E0D7.Activity_Records[i].RxWR = *ptr;
        ptr += 1;
        Susd_DID_E0D7.Activity_Records[i].RxLAR = *ptr;
        ptr += 1;
        /* RxCAT is not restored from NvM but reset to 0 on startup (current session timer) */
        Susd_DID_E0D7.Activity_Records[i].RxCAT = 0u;
        ptr += 2;
        /* PRQA S 3469 1 # For simmetry with serialization function-like macros */
        Susd_DID_E0D7.Activity_Records[i].RxTAT = SUSD_BE_BYTES_TO_UINT32(ptr);
        ptr += 4;
        /* PRQA S 3469 1 # For simmetry with serialization function-like macros */
        Susd_DID_E0D7.Activity_Records[i].RxWC = SUSD_BE_BYTES_TO_UINT16(ptr);
        ptr += 2;

        i++;
    }
}

/***********************************************************************************
  Function name :   SUSD_E0D7_Reset_RxTAT_For_PowerOn
  Description   :   Resets the RxTAT field to 0 for all activity records after a
                    power-on/off cycle. SUSD_E0D7_Populate_On_Startup() restores
                    all NvM fields unconditionally at startup; this function corrects
                    RxTAT when the wakeup source confirms power-on (not an ECU reset).
                    RxTAT is a per-key-cycle timer and must start at 0 each new cycle.
  Parameter in  :   None
  Parameter out :   None
  Return value  :   void
 ***********************************************************************************/
/* PRQA S 1532 1 # Called from SUM_SUSD.c once the wakeup source is confirmed as power-on */
FUNC(void, SUSD_CODE) SUSD_E0D7_Reset_RxTAT_For_PowerOn(void)
{
    uint8 i;
    for (i = 0u; i < NUM_RxIDS; i++)
    {
        Susd_DID_E0D7.Activity_Records[i].RxTAT = 0u;
    }
}

