/***********************************************************************************

  Function name :   SUSD_Dcm_Wakeup_Source_Reason
  Syntax        :   FUNC(Std_ReturnType, SUSD_CODE) SUSD_Dcm_Wakeup_Source_Reason(CONSTP2VAR(uint32, AUTOMATIC, RTE_APPL_DATA) Data)
  Description   :   Function for Wakeup reason through DID
  Parameter in  :   None
  Parameter out :   Data
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 049] [$SDD_SUSD 002]*/
/* PRQA S 1503 1 # When the SUSD is integrated, this function may be called by RTE */
FUNC(Std_ReturnType, SUSD_CODE) SUSD_Dcm_Wakeup_Source_Reason(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                                              P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
    Std_ReturnType Status;
    /* PRQA S 3415 1 # side effects are can be ignored as if data is null ptr no need of checking init state. */
    if ((Data!=NULL_PTR)&&(SUSD_GetInitState() == E_OK))
    {
        switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
                /* Type casting of SUSD_GddValidatedWakeupSrc to uint8 to get one byte into *Data for complete four bytes */
				*Data = (uint8)((SUSD_GddValidatedWakeupSrc & SUSD_MASKBITS_24TO31) >> 24);
				(*(Data+1)) = (uint8)((SUSD_GddValidatedWakeupSrc & SUSD_MASKBITS_16TO23) >> 16);
				(*(Data+2)) = (uint8)((SUSD_GddValidatedWakeupSrc & SUSD_MASKBITS_8TO15) >> 8); /*PRQA S 0488 EOF */
				(*(Data+3)) = (uint8)(SUSD_GddValidatedWakeupSrc);
                break;

            default:
                /*Do nothing*/
                break;
        }
        Status = E_OK;
    }
    else
    {
        Status = E_NOT_OK;
    }
    return(Status);
}

