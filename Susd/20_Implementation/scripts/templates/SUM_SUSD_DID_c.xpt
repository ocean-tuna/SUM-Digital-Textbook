/***********************************************************************************

  Function name :   SUSD_Dcm_ECU_Operating_State
  Synatx        :   FUNC(Std_ReturnType, SUSD_CODE) SUSD_Dcm_ECU_Operating_State(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                                             P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
  Description   :   Function for ECU Operating State through DID
  Parameter in  :   OpStatus
  Parameter out :   Data
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 043] */
/* PRQA S 1503 1 # When the SUSD is integrated, this function may be called by RTE*/
FUNC(Std_ReturnType, SUSD_CODE) SUSD_Dcm_ECU_Operating_State(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                                             P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
    Std_ReturnType Status;
    /* PRQA S 3415 1 # side effects are can be ignored as if data is null ptr no need of checking init state. */
    if ((Data!=NULL_PTR)&&(SUSD_GetInitState() == E_OK))
    {
        switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
                *Data = (uint8)SUSD_GddASM_CurrentMode;
                break;
            default:
                 /*Do nothing*/
                break;
        }
        Status = E_OK;
    }
    else
    {
        Status = E_NOT_OK;
    }
    return(Status);
}

