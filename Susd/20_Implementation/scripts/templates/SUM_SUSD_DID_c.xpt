/***********************************************************************************

  Function name :   SUSD_Dcm_Active_Wakeup_Sources
  Syntax        :   FUNC(Std_ReturnType, SUSD_CODE) SUSD_Dcm_Active_Wakeup_Sources(CONSTP2VAR(uint32, AUTOMATIC, RTE_APPL_DATA) Data)
  Description   :   Function for active wakeup sources through DID
  Parameter in  :   None
  Parameter out :   Data
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 051] [$SDD_SUSD 002]*/
/* PRQA S 1503 2 # When the SUSD is integrated, this function may be called by RTE */
/* PRQA S 3408 2 # External linkage done for cantata. */
FUNC(Std_ReturnType, SUSD_CODE) SUSD_Dcm_Active_Wakeup_Sources(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                                               P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
  Std_ReturnType Status;
  uint32 LulData = 0;
  uint8 Luccount;
  uint8 Luccount1;
  uint32 LucMaskbit = 1;

  if (Data!=NULL_PTR)
  {
    switch (OpStatus)
    {
      case DCM_INITIAL:
      case DCM_PENDING:
        for(Luccount = SUSD_ZERO; Luccount < NO_OF_WAKEUPSRCS;  Luccount++)
        {
          for(Luccount1 = SUSD_ZERO; Luccount1 < 32u; Luccount1++)
          {
        	if((Luccount1<10u)||(Luccount1>15u))
        	{
               if((SUSD_GaaWakeUpSources[Luccount] & LucMaskbit) == LucMaskbit)
               {
                 LulData = (LulData | LucMaskbit);
               }
        	}
        	LucMaskbit = LucMaskbit << SUSD_ONE;
          }
          LucMaskbit = 1;
        }

     Data[0] = (uint8)((LulData & SUSD_MASKBITS_24TO31) >> 24);
   	 Data[1]= (uint8)((LulData & SUSD_MASKBITS_16TO23) >> 16);
   	 Data[2]= (uint8)((LulData & SUSD_MASKBITS_8TO15) >> 8);
   	 Data[3]= (uint8)(LulData & 0xFFu);
      break;
  default:
	  /*Do nothing*/
      break;
  }
     Status=E_OK;
  }
  else
  {
     Status = E_NOT_OK;
  }

  return Status;
}

