#define SUSD_SERIALIZE_E0D7_U32(src, dst, pos)	\
do { \
	(dst)[(pos)] = (uint8)((src) >> 24U); \
	(dst)[(pos) + 1u] = (uint8)((src) >> 16U); \
	(dst)[(pos) + 2u] = (uint8)((src) >> 8U); \
	(dst)[(pos) + 3u] = (uint8)(src); \
} while(0);

#define SUSD_SERIALIZE_E0D7_U16(src, dst, pos)	\
do { \
	(dst)[(pos)] = (uint8)((src) >> 8U); \
	(dst)[(pos) + 1u] = (uint8)(src); \
} while(0);

/* b is expected to be of type uint8 * */
/* PRQA S 3472 1 # For simmetry with serialization function-like macros */
#define SUSD_BE_BYTES_TO_UINT32(b) \
    ( ((uint32)(b)[0] << 24) | \
      ((uint32)(b)[1] << 16) | \
      ((uint32)(b)[2] << 8)  | \
      ((uint32)(b)[3]) )

/* b is expected to be of type uint8 * */
/* PRQA S 3472 1 # For simmetry with serialization function-like macros */
#define SUSD_BE_BYTES_TO_UINT16(b) \
    ( ((uint16)(b)[0] << 8) | \
      ((uint16)(b)[1]) )

