/******************************************************************************
  Function name :   SUSD_Dcm_Read_F09E_ECUWakeupDetRec_Data
  Description   :   Function called by the DCM when a UDS 0x22 (ReadDataByIdentifier) 
                    message for DID 0xF09E is received by the ECU and read permission 
                    is granted by a previous call to SUSD_Dcm_CndChkRead_F09E_ECUWakeupDetRec_Data().
                    The binding of this C function to the DCM is defined in the 
                    RTE/DCM configuration.

                    It fills a 100-byte output buffer with SUSD_NO_OF_WAKEUPDETRECS 
                    (10) records, each 10 bytes wide, according to the following
                    layout:
                    Byte 0    : Record Id (1-based index);
                    Bytes 1-2 : ECUWakeupDetectionRecordId bits 16-31 (big-endian)
                                => ECU-specific/supplier wakeup sources (EcuM bits 16-31);
                    Bytes 3-4 : ECUWakeupDetectionRecordId bits 0-15 (big-endian)
                                => Global wakeup sources (EcuM bits 0-15);
                    Bytes 5-9 : TimeStampOfOccurence (5 bytes, as stored).

                    ECUWakeupDetectionRecordId is a uint32 stored little-endian as uint8[4]:
                    [0]=bits 0-7, [1]=bits 8-15, [2]=bits 16-23, [3]=bits 24-31.
                    The DID output is big-endian (most significant byte first), so the
                    array is written in reverse order: [3],[2],[1],[0].
  Parameter in  :   OpStatus - DCM operation status (DCM_INITIAL / DCM_PENDING / others)
  Parameter out :   Data     - Pointer to 100-byte output buffer (must not be NULL)
  Return value  :   E_OK     - Data pointer valid; buffer filled successfully
                    E_NOT_OK - Data pointer is NULL
******************************************************************************/
«REM» Satisfies: [$SDD_SUSD 152] [$SDD_SUSD 002] «ENDREM-»
/* PRQA S 1503 1 # When the SUSD is integrated, this function may be called by RTE */
FUNC(Std_ReturnType, SUSD_CODE) SUSD_Dcm_Read_F09E_ECUWakeupDetRec_Data(
  VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
    Std_ReturnType Status;
    uint8 record_index;

    if(Data != NULL_PTR)
    {
        switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
                /* Iterate over all SUSD_NO_OF_WAKEUPDETRECS (10) detection records.
                ** Each record occupies exactly 10 bytes in the output buffer.
                ** Base offset into Data for record N: record_index * 10u. */
                for (record_index = 0u; record_index < SUSD_NO_OF_WAKEUPDETRECS; record_index++)
                {
                    /* Byte 0: Record Id — 1-based (record 0 => value 1, ..., record 9 => value 10). */
                    *(Data + ((uint8)(record_index * 10u)     )) = record_index + 1u;
                    /* ECUWakeupDetectionRecordId[] was written in little-endian from WakeupSrc in SUSD_ActivatedWakeupSource(). */
                    /* So, [3] stores the MSB (EcuM bits 24-31) and [2] stores bits 16-23: ECU-specific Wakeup Sources. */
                    *(Data + ((uint8)(record_index * 10u) + 1u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].ECUWakeupDetectionRecordId[3];
                    *(Data + ((uint8)(record_index * 10u) + 2u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].ECUWakeupDetectionRecordId[2];
                    /* Bytes 0-1: Global Wakeup Sources (EcuM bits 0-15). */
                    *(Data + ((uint8)(record_index * 10u) + 3u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].ECUWakeupDetectionRecordId[1];
                    *(Data + ((uint8)(record_index * 10u) + 4u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].ECUWakeupDetectionRecordId[0];
                    /* TimeStampOfOccurence[] was born as uint8[5] in SUSD_ActivatedWakeupSource(), so it can be copied directly. */ 
                    *(Data + ((uint8)(record_index * 10u) + 5u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].TimeStampOfOccurence[0];
                    *(Data + ((uint8)(record_index * 10u) + 6u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].TimeStampOfOccurence[1];
                    *(Data + ((uint8)(record_index * 10u) + 7u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].TimeStampOfOccurence[2];
                    *(Data + ((uint8)(record_index * 10u) + 8u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].TimeStampOfOccurence[3];
                    *(Data + ((uint8)(record_index * 10u) + 9u)) = SUSD_ECUWakeupDetectionRecordsArray[record_index].TimeStampOfOccurence[4];
                }
                break;
            default:
                /* Here if DCM_CANCEL or DCM_FORCE_RCRRP_OK.
                ** Rreturn E_OK by Autosar standard. */
                break;
        }

        Status = E_OK;
    }
    else
    {
        Status = E_NOT_OK;
    }

    return Status;
}

/***********************************************************************************

