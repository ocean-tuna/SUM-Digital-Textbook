        switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
                 *Data = (uint8)(SUSD_GucVehicleBattVoltage >> 8u);
                 *(Data+1) = (uint8)(SUSD_GucVehicleBattVoltage);
                break;
            default:
                /*Do nothing*/
                break;
        }
        Status = E_OK;
    }
    else
    {
        Status = E_NOT_OK;
    }
    return Status;
}

