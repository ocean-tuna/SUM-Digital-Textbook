/* The Calibration Functions for Under,Over voltage hysteresis and Shutdown
    Permission Control for every SWC */
«IF sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0-»
  CONST (SUSD_SWCRteInterfaces, RTE_CONST) SUSD_GaaRteSWCInterface[«sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size»] =
  {
    «FOREACH this.sUSD.sUSDConfigSet.sUSD_C_SWCInfo.sortBy(e|e.sUSD_SWCName) AS SWCInfo ITERATOR i SEPARATOR ','»
      /* SUSD_C_SWCInfo_«i.counter1» - «SWCInfo.sUSD_SWCName»*/
      {
        /* SWC Permit Execution Interface */
        «IF (sUSD.sUSDGeneral.sUSD_PermitExecAvailable == true)-»
          &Rte_Write_PP_«SWCInfo.sUSD_SWCName»_SUSD_PermitExecution_SUSD_SWC_ExecutionStatus,
        «ELSE-»
          NULL_PTR,
        «ENDIF-»

        /* SWC Shutdown Permission Interface */
        «IF (SWCInfo.sUSD_C_ShutdownPermControl == true )-»
          &Rte_Read_RP_«SWCInfo.sUSD_SWCName»_SUSD_ShutdownPermission_SUSD_UserRequest,

          /* blShutdownPermControl */
          &Rte_CData_SUSD_PDP_SUSD_C_ShutdownPermControl_«SWCInfo.sUSD_SWCName»
        «ELSE-»
          NULL_PTR,

          NULL_PTR
        «ENDIF-»
      }
    «ENDFOREACH-»
  };
«ENDIF-»

«FOREACH this.sUSD.sUSDConfigSet.sUSD_BatteryVoltageRange.sUSD_C_BatteryVoltageRange AS voltRange »
  FUNC(Impl_SUSD_C_VoltageHysteresis, RTE_CODE) Rte_CData_SUSD_C_OverVoltage_hysteresis_«voltRange.shortName»(void);
  FUNC(Impl_SUSD_C_VoltageHysteresis, RTE_CODE) Rte_CData_SUSD_C_UnderVoltage_hysteresis_«voltRange.shortName»(void);
«ENDFOREACH-»
FUNC(Impl_SUSD_C_VoltageHysteresis, RTE_CODE) Rte_CData_SUSD_C_DefaultOverVoltage_hysteresis(void);
FUNC(Impl_SUSD_C_VoltageHysteresis, RTE_CODE) Rte_CData_SUSD_C_DefaultUnderVoltage_hysteresis(void);

