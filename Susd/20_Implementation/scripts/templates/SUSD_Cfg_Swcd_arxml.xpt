          <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
          <INDIRECT-API>false</INDIRECT-API>
          <PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_SUSD/SUSD/PP_SUSD_«sUSD.sUSDConfigSet.sUSDDiagReferences.did_F089_Reference.dcmDspDidSignal.get(0).shortName-»</PORT-REF>
        </PORT-API-OPTION>
«IF !SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»                      
        <PORT-API-OPTION>
          <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
           «IF SUSD_IsE2EConfigured(sUSD.sUSDGeneral, "PrimaryPowerMode") || SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
          <ERROR-HANDLING>TRANSFORMER-ERROR-HANDLING</ERROR-HANDLING>
          «ENDIF-»
          <INDIRECT-API>false</INDIRECT-API>
          <PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_Com_SUSD_VeVSM_e_PrimaryPowerMode</PORT-REF>
        </PORT-API-OPTION>
        <PORT-API-OPTION>
          <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
          «IF SUSD_IsE2EConfigured(sUSD.sUSDGeneral, "BackupPowerMode") || SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
          <ERROR-HANDLING>TRANSFORMER-ERROR-HANDLING</ERROR-HANDLING>
          «ENDIF-» 
          <INDIRECT-API>false</INDIRECT-API>
          <PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_Com_SUSD_VeVSM_e_BackupPowerMode</PORT-REF>
        </PORT-API-OPTION>    
«ELSE-»  
        <PORT-API-OPTION>
          <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
          «IF SUSD_IsE2EConfigured(sUSD.sUSDGeneral, "PrimaryPowerMode") || SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
          <ERROR-HANDLING>TRANSFORMER-ERROR-HANDLING</ERROR-HANDLING>
          «ENDIF-»
          <INDIRECT-API>false</INDIRECT-API>
          <PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_Com_SUSD_PrimaryPowerMode_BackupPowerMode</PORT-REF>
        </PORT-API-OPTION> 
«ENDIF-»     
              </PORT-API-OPTIONS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Runnable_Sum_SUSD_ActivityRecords_Handler</SHORT-NAME>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>DRPA_SUSD_VehicleBatteryVoltage</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_SUSD_VehicleBatteryVoltage</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/SUM_SUSD/VehicleBatteryVoltage/VehicleVoltage</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <SERVER-CALL-POINTS>
                    <SYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>SUSD_FirstBootPostFlash_Flag_WriteBlock</SHORT-NAME>
                        <OPERATION-IREF>
                          <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_NvMService_FirstBootPostFlash_Flag</CONTEXT-R-PORT-REF>
                          <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_NvM/PortInterfaces/NvMService/WriteBlock</TARGET-REQUIRED-OPERATION-REF>
                        </OPERATION-IREF>
                    </SYNCHRONOUS-SERVER-CALL-POINT>
                    <SYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>SUSD_E0D7_MonitorDisabled_WriteBlock</SHORT-NAME>
                        <OPERATION-IREF>
                          <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_NvMService_E0D7_MonitorDisabled</CONTEXT-R-PORT-REF>
                          <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_NvM/PortInterfaces/NvMService/WriteBlock</TARGET-REQUIRED-OPERATION-REF>
                        </OPERATION-IREF>
                    </SYNCHRONOUS-SERVER-CALL-POINT>
                    «IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»
                    <SYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>SSCP_SUSD_SPM_ActivityRecordCmd_Reset</SHORT-NAME>
                      <OPERATION-IREF>
                      <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_SUSD_SPM_ActivityRecordCmd</CONTEXT-R-PORT-REF>
                      <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/GM_SUM/Interfaces/SPM_SUSD_ActivityRecordCmd/ActivityRecordCmd</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
                    </SYNCHRONOUS-SERVER-CALL-POINT>
                    <SYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>SSCP_SUSD_SPM_ActivityRecordCmd_NvMStore</SHORT-NAME>
                      <OPERATION-IREF>
                      <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_SUSD_SPM_ActivityRecordCmd</CONTEXT-R-PORT-REF>
                      <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/GM_SUM/Interfaces/SPM_SUSD_ActivityRecordCmd/ActivityRecordCmd</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
                    </SYNCHRONOUS-SERVER-CALL-POINT>
                    <SYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>SSCP_SUSD_SPM_ActivityRecordCmd_UpdateRecord</SHORT-NAME>
                      <OPERATION-IREF>
                      <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_SUSD_SPM_ActivityRecordCmd</CONTEXT-R-PORT-REF>
                      <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/GM_SUM/Interfaces/SPM_SUSD_ActivityRecordCmd/ActivityRecordCmd</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
