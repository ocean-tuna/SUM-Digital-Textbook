                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_SUSD/SUSD/PP_SUSD_«sUSD.sUSDConfigSet.sUSDDiagReferences.did_E0D7_Reference.dcmDspDidSignal.get(0).shortName-»</PORT-REF>
                </PORT-API-OPTION>
                «FOREACH {1, 2, 3, 4} AS PORT_NUMBER-»
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_SUSD_SWC_ControlModuleInputPower«PORT_NUMBER»</PORT-REF>
                </PORT-API-OPTION>
                «ENDFOREACH-»
                <PORT-API-OPTION>
