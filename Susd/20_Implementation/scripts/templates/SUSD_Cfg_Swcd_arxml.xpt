                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SOH")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/SOH_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_TCS")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/TCS_SUSD_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SSC")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/SSC_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SRVMGR")-»
