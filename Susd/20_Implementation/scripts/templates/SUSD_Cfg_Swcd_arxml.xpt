                      <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_SUSD_SPM_ActivityRecordCmd</CONTEXT-R-PORT-REF>
                      <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/GM_SUM/Interfaces/SPM_SUSD_ActivityRecordCmd/ActivityRecordCmd</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
