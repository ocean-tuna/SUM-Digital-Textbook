 «REM» [$Satisfies $SDD_SUSD 001] «ENDREM-»
«REM» [$Satisfies $SDD_SUSD 248][$Satisfies $SDD_SUSD 249] «ENDREM-»
-->
<AR-PACKAGES>
    <!-- ImplementationDataTypes -->
    <AR-PACKAGE>
      <SHORT-NAME>SUM_SUSD</SHORT-NAME>
	  «REM» [$Satisfies $SDD_SUSD 143] «ENDREM-»
      <ELEMENTS>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>ResetStatus</SHORT-NAME>
          <CATEGORY>TYPE_REFERENCE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</IMPLEMENTATION-DATA-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        «IF (sUSD.sUSDGeneral.sUSD_Battery_State_of_Charge_Supported == true) -»
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>BatteryStateOfChargeType</SHORT-NAME>
          <CATEGORY>TYPE_REFERENCE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</IMPLEMENTATION-DATA-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>BswMDisablingEnablingWakeupType</SHORT-NAME>
          <CATEGORY>TYPE_REFERENCE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</IMPLEMENTATION-DATA-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        «ENDIF-»
        «IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported) -»
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>RunCrankPlausibility</SHORT-NAME>
          <CATEGORY>TYPE_REFERENCE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</IMPLEMENTATION-DATA-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        «ENDIF-»
        <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>ReprogrammingStatus</SHORT-NAME>
          <CATEGORY>TYPE_REFERENCE</CATEGORY>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</IMPLEMENTATION-DATA-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </IMPLEMENTATION-DATA-TYPE>
        «IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported) -»
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RunCrankActive_Inv</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>VDPRunCrankActive_Inv</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RunCrankInput</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>VDPInput</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RunCrankInput_Inv</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>VDPInputInv</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RunCrankInputVoltage</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>VDPInputVoltage</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/float32</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RunCrankInputStuckHighDiagnostic_FA</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>HighDiagFA</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RunCrankInputStuckLowDiagnostic_FA</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>LowDiagFA</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        «ENDIF-»
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>VehicleBatteryVoltage</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>VehicleVoltage</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/SUM_SUSD/APDT_SUSD_VehcleBatryVlg</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>BatteryVoltage_Actual</SHORT-NAME>
            <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>ActualVoltage</SHORT-NAME>
                  <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/SUM_SUSD/APDT_SUSD_VehcleBatryVlg</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        «IF (sUSD.sUSDGeneral.sUSD_Battery_State_of_Charge_Supported == true) -»
        <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>VehicleBatteryStateOfCharge</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>BatteryStateOfCharge</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/BatteryStateOfChargeType</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        «ENDIF-»
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>SUSD_ShutdownPermission</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>SUSD_UserRequest</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/GM_SUM/ImplementationDataTypes/SUSD_UserRequestType</TYPE-TREF>
              <INIT-VALUE>
                <TEXT-VALUE-SPECIFICATION>
                  <SHORT-LABEL>SUSD_UserRequest_InitValue</SHORT-LABEL>
                  <VALUE>0xFF</VALUE>
                </TEXT-VALUE-SPECIFICATION>
              </INIT-VALUE>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        «IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported) -»
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>RunCrankActive</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>RunCrankPlausibilityData</SHORT-NAME>
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/RunCrankPlausibility</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>RunCrankInputDiscreteActive</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>VDPDiscreteActive</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>RunCrankInputPercentage</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>VDPPercentage</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/Impl_RunCrankInputPercentage_0_1</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
        «ENDIF -»
«IF !SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»  
        <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>VeVSM_e_PrimaryPowerMode_interface</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>VeVSM_e_PrimaryPowerModeRxSignal</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
«IF SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«SUSD_GetImplementationDataTypePath(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_PMM_Ref)»</TYPE-TREF>
«ELSE -»
«IF sUSD.sUSDGeneral.sum_SUSD_Sig_PrimaryPowerMode_Ref.metaType.toString().contains("ComSignal")-»
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«sUSD.sUSDGeneral.sum_SUSD_Sig_PrimaryPowerMode_Ref.comSignalType.toLowerCase()»</TYPE-TREF>
«ELSE -»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/RxSignal_PrimaryPowerMode_GroupSignal</TYPE-TREF>
«ENDIF-»
«ENDIF-»
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>          
        <SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>VeVSM_e_BackupPowerMode_interface</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>VeVSM_e_BackupPowerModeRxSignal</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
«IF SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«SUSD_GetImplementationDataTypePath(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_BPMM_Ref)»</TYPE-TREF>
«ELSE -»
«IF sUSD.sUSDGeneral.sum_SUSD_Sig_BackupPowerMode_Ref.metaType.toString().contains("ComSignal")-»
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«sUSD.sUSDGeneral.sum_SUSD_Sig_BackupPowerMode_Ref.comSignalType.toLowerCase()»</TYPE-TREF>
«ELSE -»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/RxSignal_BackupPowerMode_GroupSignal</TYPE-TREF>
«ENDIF-»
«ENDIF-»
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>
«ELSE-» 
        <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PrimaryPowerMode_BackupPowerMode_interface</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>PrimaryPowerMode_BackupPowerMode_RxSignal</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
«IF SUSD_IsPMMGroupSignal(sUSD.sUSDGeneral)-»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/RxSignal_PrimaryPowerMode_BackupPowerMode_GroupSignal</TYPE-TREF>
«ELSE -»
«IF SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«SUSD_GetImplementationDataTypePath(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_PMM_Ref)»</TYPE-TREF>
«ELSE -»
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«sUSD.sUSDGeneral.sum_SUSD_Sig_PrimaryPowerMode_Ref.comSignalType.toLowerCase()»</TYPE-TREF>
«ENDIF-»
«ENDIF-»
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>  
«ENDIF-»
«IF !SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»  
«REM»Generate PrimaryPowerMode signal types for signal-based (non-service-based) ComGroupSignal configuration«ENDREM-»
«IF SUSD_IsPMMGroupSignal(sUSD.sUSDGeneral) && !SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
  		<IMPLEMENTATION-DATA-TYPE>
	        <SHORT-NAME>RxSignal_PrimaryPowerMode_GroupSignal</SHORT-NAME>
	        <LONG-NAME>
	            <L-4 L="EN">PrimaryPowerModeRxSignal</L-4>
	        </LONG-NAME>
	        <CATEGORY>STRUCTURE</CATEGORY>
	        <SUB-ELEMENTS>
«FOREACH sUSD.sUSDGeneral.sum_SUSD_Sig_PrimaryPowerMode_Ref.parent.comGroupSignal AS single_signal-»
	         <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	            <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
	            <CATEGORY>TYPE_REFERENCE</CATEGORY>
	            <SW-DATA-DEF-PROPS>
	                <SW-DATA-DEF-PROPS-VARIANTS>
	                    <SW-DATA-DEF-PROPS-CONDITIONAL>
	        «IF single_signal.comSignalType == "UINT8_N"-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ELSE-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ENDIF-»
	                    </SW-DATA-DEF-PROPS-CONDITIONAL>
	                 </SW-DATA-DEF-PROPS-VARIANTS>
	            </SW-DATA-DEF-PROPS>
              </IMPLEMENTATION-DATA-TYPE-ELEMENT>
«ENDFOREACH-»
			</SUB-ELEMENTS>
         </IMPLEMENTATION-DATA-TYPE>
«ENDIF-»
«REM»Generate BackupPowerMode signal types for signal-based (non-service-based) ComGroupSignal configuration«ENDREM-»
«IF SUSD_IsBPMMGroupSignal(sUSD.sUSDGeneral) && !SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
  		<IMPLEMENTATION-DATA-TYPE>
	        <SHORT-NAME>RxSignal_BackupPowerMode_GroupSignal</SHORT-NAME>
	        <LONG-NAME>
	            <L-4 L="EN">BackupPowerModeRxSignal</L-4>
	        </LONG-NAME>
	        <CATEGORY>STRUCTURE</CATEGORY>
	        <SUB-ELEMENTS>
«FOREACH sUSD.sUSDGeneral.sum_SUSD_Sig_BackupPowerMode_Ref.parent.comGroupSignal AS single_signal-»
	         <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	            <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
	            <CATEGORY>TYPE_REFERENCE</CATEGORY>
	            <SW-DATA-DEF-PROPS>
	                <SW-DATA-DEF-PROPS-VARIANTS>
	                    <SW-DATA-DEF-PROPS-CONDITIONAL>
	        «IF single_signal.comSignalType == "UINT8_N"-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ELSE-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ENDIF-»
	                    </SW-DATA-DEF-PROPS-CONDITIONAL>
	                 </SW-DATA-DEF-PROPS-VARIANTS>
	            </SW-DATA-DEF-PROPS>
              </IMPLEMENTATION-DATA-TYPE-ELEMENT>
«ENDFOREACH-»
            </SUB-ELEMENTS>
      </IMPLEMENTATION-DATA-TYPE>
«ENDIF-»
«ELSE-»
«IF SUSD_IsPMMGroupSignal(sUSD.sUSDGeneral)-»
«REM»Generate combined signal types when both signals reference the same group signal«ENDREM-»
  		<IMPLEMENTATION-DATA-TYPE>
	        <SHORT-NAME>RxSignal_PrimaryPowerMode_BackupPowerMode_GroupSignal</SHORT-NAME>
	        <LONG-NAME>
	            <L-4 L="EN">PrimaryPowerMode_BackupPowerMode_RxSignal</L-4>
	        </LONG-NAME>
	        <CATEGORY>STRUCTURE</CATEGORY>
	        <SUB-ELEMENTS>
«FOREACH sUSD.sUSDGeneral.sum_SUSD_Sig_PrimaryPowerMode_Ref.parent.comGroupSignal AS single_signal-»

	         <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	            <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
	            <CATEGORY>TYPE_REFERENCE</CATEGORY>
	            <SW-DATA-DEF-PROPS>
	                <SW-DATA-DEF-PROPS-VARIANTS>
	                    <SW-DATA-DEF-PROPS-CONDITIONAL>
	        «IF single_signal.comSignalType == "UINT8_N"-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SUSD/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ELSE-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ENDIF-»
	                    </SW-DATA-DEF-PROPS-CONDITIONAL>
	                 </SW-DATA-DEF-PROPS-VARIANTS>
	            </SW-DATA-DEF-PROPS>
              </IMPLEMENTATION-DATA-TYPE-ELEMENT>
            
«ENDFOREACH-»
            </SUB-ELEMENTS>
      </IMPLEMENTATION-DATA-TYPE>
«ENDIF-»
«ENDIF-»
«REM»Generate unified UINT8_N implementation data types for all signals (PMM and BPMM)«ENDREM-»
«FOREACH SUSD_CollectAllUint8NLengths(sUSD.sUSDGeneral) AS sigSize-»
		        <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>IMPL_LenNByte«sigSize»</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/SUM_SUSD/Bytes«sigSize»</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
            </IMPLEMENTATION-DATA-TYPE>
      
           <SW-BASE-TYPE>
              <SHORT-NAME>Bytes«sigSize»</SHORT-NAME>
              <CATEGORY>FIXED_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
              <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
              <MEM-ALIGNMENT>8</MEM-ALIGNMENT>
              <NATIVE-DECLARATION>Bytes_«sigSize»</NATIVE-DECLARATION>
           </SW-BASE-TYPE>

		    <IMPLEMENTATION-DATA-TYPE>
          <SHORT-NAME>Bytes_«sigSize»</SHORT-NAME>
          <CATEGORY>STRUCTURE</CATEGORY>
          <SUB-ELEMENTS>
            <IMPLEMENTATION-DATA-TYPE-ELEMENT>
              <SHORT-NAME>Array_«sigSize»</SHORT-NAME>
              <CATEGORY>ARRAY</CATEGORY>
              <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
              <SUB-ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>ArrayElement</SHORT-NAME>
                  <CATEGORY>TYPE_REFERENCE</CATEGORY>
                  <ARRAY-SIZE>«sigSize»</ARRAY-SIZE>
                  <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                  <SW-DATA-DEF-PROPS>
