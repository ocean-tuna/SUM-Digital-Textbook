                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Runnable_AppStateManager</SHORT-NAME>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  «FOREACH this.sUSD.sUSDConfigSet.sUSD_C_SUMsInfo AS SUMsInfo-»
                  «IF (SUMsInfo.sUSD_ShutdownPermission == true)-»
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>DRPA_SUSD_ShutdownPermission_«SUMsInfo.sUSD_SUMsName»</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/SUM_SUSD/SUSD/RP_«SUMsInfo.sUSD_SUMsName»_SUSD_ShutdownPermission</PORT-PROTOTYPE-REF>
                          «IF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_PNC")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/PNC_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_LNM")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/LNM_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SSFM_ERRH")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/ERRH_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SOH")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/SOH_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_TCS")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/TCS_SUSD_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SSC")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/SSC_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SSFM_SSM")-»
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/GM_SUM/Interfaces/SSM_ShutdownPermission/SUSD_UserRequest</TARGET-DATA-PROTOTYPE-REF>
                          «ELSEIF (SUMsInfo.sUSD_SUMsName.toString() == "SUM_SRVMGR")-»
