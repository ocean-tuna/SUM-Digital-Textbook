                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_SUSD/SUSD/PP_SUSD_«sUSD.sUSDConfigSet.sUSDDiagReferences.did_F088_Reference.dcmDspDidSignal.get(0).shortName-»</PORT-REF>
                </PORT-API-OPTION>
                «IF Susd_IsSpmConfigured(sUSD.sUSDConfigSet) -»
                <PORT-API-OPTION>
