      «ENDIF-»
      «IF SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
      SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.«SUSD_GetImplementationDataTypeElementName(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_BPMM_Ref)»;
      «ELSEIF SUSD_IsBPMMGroupSignal(sUSD.sUSDGeneral)-»
      SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.RxSignal_«sUSD.sUSDGeneral.sum_SUSD_Sig_BackupPowerMode_Ref.shortName»;
      «ELSE-»
      SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData;
      «ENDIF-»
      LastSystemBackupPowerModeReceived = SUSD_VehiclePowerMode;
    }
    else
