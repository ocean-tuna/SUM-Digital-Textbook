{
  SUSD_GblDiagResetRequest = Status;
}

«IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.select(e|e.sUSD_C_ShutdownPermControl == true).size > 0) -»
/***********************************************************************************
  Function name :   SUSD_SetShutdownEnableBit_SWC
  Description   :   Sets the shutdown enable bit to 1 for the specified SWC module
  Parameter in  :   swcIndex - Index of the SWC module
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_SetShutdownEnableBit_SWC(uint32 swcIndex)
{
  /* PRQA S 3120 2 # 64 is the number of bits per uint64 element in the bit array */
  uint32 arrayIndex = swcIndex / 64u;
  uint32 bitPosition = swcIndex % 64u;
  Gblshutdownenablecnt[arrayIndex] |= ((uint64)1u << bitPosition);
}
«ENDIF-»
«IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.select(e|e.sUSD_C_ShutdownPermControl == true).size > 0) -»
/***********************************************************************************
  Function name :   SUSD_ClearShutdownEnableBit_SWC
  Description   :   Clears the shutdown enable bit to 0 for the specified SWC module
  Parameter in  :   swcIndex - Index of the SWC module
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_ClearShutdownEnableBit_SWC(uint32 swcIndex)
{
  /* PRQA S 3120 2 # 64 is the number of bits per uint64 element in the bit array */
  uint32 arrayIndex = swcIndex / 64u;
  uint32 bitPosition = swcIndex % 64u;
  Gblshutdownenablecnt[arrayIndex] &= ~((uint64)1u << bitPosition);
}
«ENDIF-»

/***********************************************************************************
  Function name :   SUSD_SetShutdownEnableBit_SUM
  Description   :   Sets the shutdown enable bit to 1 for the specified SUM module
  Parameter in  :   sumIndex - Index of the SUM module
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_SetShutdownEnableBit_SUM(uint8 sumIndex)
{
  GblSUMshutdownenablecnt |= ((uint16)1u << sumIndex);
}

/***********************************************************************************
  Function name :   SUSD_ClearShutdownEnableBit_SUM
  Description   :   Clears the shutdown enable bit to 0 for the specified SUM module
  Parameter in  :   sumIndex - Index of the SUM module
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_ClearShutdownEnableBit_SUM(uint8 sumIndex)
{
  GblSUMshutdownenablecnt &= ~((uint16)1u << sumIndex);
}

«IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
«FOREACH sUSD.sUSDConfigSet.sUSD_C_SWCInfo AS swc ITERATOR swc_iter-»
«IF swc.sUSD_C_ShutdownPermControl == true-»
/***********************************************************************************
  Function name :   RE_«swc.sUSD_SWCName»_ShutdownPermission
  Description   :   Function used to restart the Shutdown Refresh timer for «swc.sUSD_SWCName»
                    upon reception of new data
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 148]*/
/* PRQA S 1503 1 # When the SUSD is integrated, this function may be called by RTE*/
FUNC(void, SUSD_CODE) RE_«swc.sUSD_SWCName»_ShutdownPermission(void)
{
  /* Rte interfaces */
  P2CONST(SUSD_SWCRteInterfaces, AUTOMATIC,AUTOMATIC) LpRteInterface;
  /* Point to the array of structures containing the SWC interfaces */
  LpRteInterface = &SUSD_GaaRteSWCInterface[SUSD_ZERO];
  /*Refresh the Refresh Timer*/
  SUSD_GaaShutdownTimer[«swc_iter.counter0»] = SUSD_T_SHUTDOWN_REFRESH;

  if(TRUE == (LpRteInterface[«swc_iter.counter0»].ShutdownPermControl)())
  {
    /* Invoke Rte Read to read the Shutdown Value from that SWC */
    (*(LpRteInterface[«swc_iter.counter0»].SWCShutdownPermInterface))(&SUSD_GaaSWCShutdownPermission[«swc_iter.counter0»]);
    
    if(ENABLESHUTDOWN == SUSD_GaaSWCShutdownPermission[«swc_iter.counter0»])
    {
      /* When Shutdown is indicated Reset the timers and set bit */
      SUSD_GaaShutdownTimer[«swc_iter.counter0»] = SUSD_ZERO;
      SUSD_SetShutdownEnableBit_SWC(«swc_iter.counter0»);
    }
  }
   
}

«ENDIF-»
«ENDFOREACH-»
«ENDIF-»

«FOREACH sUSD.sUSDConfigSet.sUSD_C_SUMsInfo AS sum-»
«IF sum.sUSD_ShutdownPermission == true-»
/***********************************************************************************
  Function name :   RE_«sum.sUSD_SUMsName»_ShutdownPermission
  Description   :   Function used to restart the Shutdown Refresh timer for «sum.sUSD_SUMsName»
                    upon reception of new data
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 148]*/
/* PRQA S 1503 1 # When the SUSD is integrated, this function may be called by RTE*/
FUNC(void, SUSD_CODE) RE_«sum.sUSD_SUMsName»_ShutdownPermission(void)
{
  /*Refresh the Refresh Timer*/
  SUSD_GaaSUMShutdownTimer[«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»] = SUSD_T_SHUTDOWN_REFRESH;

  /* Invoke Rte Read to read the SHutdown Value from that SWC */
  SUSD_GaaSUM_ShutdwnPer_Interface[«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»]((SUSD_UserRequestType*)&SUSD_GaaSUMShutdownPermission[«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»]);
  
  if(ENABLESHUTDOWN == SUSD_GaaSUMShutdownPermission[«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»])
  {
    /* When Shutdown is indicated Reset the timers and set bit */
    SUSD_GaaSUMShutdownTimer[«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»] = SUSD_ZERO;
    SUSD_SetShutdownEnableBit_SUM(«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»);
  }
«IF sum.sUSD_SUMsName == "SUM_SPM"-»
  /*For the SPM we have to set the Bit also if the SUSD_GaaSUMShutdownPermission is 254 Ready for Shoutdown*/
  if(READYFORSHUTDOWN == SUSD_GaaSUMShutdownPermission[«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»])
  {
    /*For the SPM also if the Interface is 254 Ready to Shutdown we have to process the information */
     SUSD_SetShutdownEnableBit_SUM(«sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.indexOf(sum)»);
  }
«ENDIF-»
}
«ENDIF-»
«ENDFOREACH-»

/***********************************************************************************
  Function name :   Processing_SUSD_Shutdown_Refresh_Timer
  Description   :   Centralized function to process shutdown refresh timers for both 
                    SUM and SWC modules. Decrements active timers and forces 
                    Enable Shutdown status when timers expire.
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 148]*/
/* PRQA S 1532 1 # This Function can be used in the multiple file and can not be turned into static as well as moved to static code */
FUNC(void, SUSD_CODE) Processing_SUSD_Shutdown_Refresh_Timer(void)
{
  «LET sUSD.sUSDConfigSet.sUSD_C_SWCInfo.select(e|e.sUSD_C_ShutdownPermControl == true).size AS swcShutdownPermCount-»
  «IF (swcShutdownPermCount > 0)-»
  uint32 i;
  «ELSE-»
  uint8 i;
  «ENDIF-»

  «IF (swcShutdownPermCount > 0)-»
  /* Process SWC Shutdown Refresh Timers */
  /* PRQA S 2877 1 # This is called only once due to configuration */
  for(i = SUSD_ZERO; i < NO_OF_SWCS; i++)
  {
    /* Check if timer expired */
    if(SUSD_GaaShutdownTimer[i] == SUSD_ZERO)
    {
      /* Timer expired - override SWC response and force Enable Shutdown */
      SUSD_GaaSWCShutdownPermission[i] = ENABLESHUTDOWN;
      /* Set bit to 1 when forcing Enable Shutdown */
      SUSD_SetShutdownEnableBit_SWC(i);
    }
    else 
    {
      /* Clear bit to 1 when forcing Enable Shutdown */
      if(SUSD_GaaWaitGlobalForceShutdownTimer != SUSD_ZERO)
      {
        SUSD_ClearShutdownEnableBit_SWC(i);
      }
      /* Decrement wait shutdown timer if active */
      SUSD_GaaShutdownTimer[i]--;
    }
  }
  «ENDIF-»
  «ENDLET-»

  /* Process SUM Shutdown Refresh Timers */
  for(i = SUSD_ZERO; i < SUSD_SUM_SHUTPERM; i++)
  {
    /* Check if timer expired */
    if(SUSD_GaaSUMShutdownTimer[i] == SUSD_ZERO)
    {
      /* Timer expired - override SUM response and force Enable Shutdown */
      SUSD_GaaSUMShutdownPermission[i] = ENABLESHUTDOWN;
      /* Set bit to 1 when forcing Enable Shutdown */
      SUSD_SetShutdownEnableBit_SUM((uint8)i);
    }
    else 
    {
      /* Clear bit to 1 when forcing Enable Shutdown */
      if(SUSD_GaaWaitGlobalForceShutdownTimer != SUSD_ZERO)
      {
        SUSD_ClearShutdownEnableBit_SUM((uint8)i);
      }
      /* Decrement shutdown timer if active */
      SUSD_GaaSUMShutdownTimer[i]--;  
    }
  }
}


/***********************************************************************************
  Function name :   Processing_SUSD_Shutdown_GloabalWait_Force_Timer
  Description   :   Centralized function to process shutdown Wait Global Force Timer for both 
                    SUM and SWC modules. Decrements active timers and forces 
                    Enable Shutdown status when timers expire.
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 148]*/
/* PRQA S 1532 1 # This Function can be used in the multiple file and can not be turned into static as well as moved to static code */
FUNC(void, SUSD_CODE) Processing_SUSD_Shutdown_GloabalWait_Force_Timer(void)
{
  uint8 SUM_ShutdownIter;
  uint32 SWC_ShutdownIter;
  boolean SUM_AllnoPermitEx = TRUE;
  boolean SWC_AllnoPermitEx = TRUE; 

  «IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
   /*Check if there is some SWC that still have the permit Execution */
  for (SWC_ShutdownIter = 0; SWC_ShutdownIter < NO_OF_SWCS; SWC_ShutdownIter++ )
  {
    if ((uint8)(SUSD_GaaSWCPermitExecution[SWC_ShutdownIter] & (uint8)0x01) != (uint8)0)
    {
      SWC_AllnoPermitEx = FALSE;
    }
  } 
  «ENDIF-»
  
  /*Check if there is some SUM that still have the permit Execution */
  for (SUM_ShutdownIter = 0; SUM_ShutdownIter < SUSD_SUM_PERMEXE; SUM_ShutdownIter++ )
  {
    if ((uint8)(SUSD_GaaSUMPermitExecution[SUM_ShutdownIter] & (uint8)0x01) != (uint8)0)
    {
      SUM_AllnoPermitEx = FALSE;
    }
  }

  /* If all SUM and SWC do not have Permit Execution, decrease the global wait force timer.
     Do NOT decrement when the counter is already zero (prevents underflow). If any
     module has permit execution, restore the configured value. */
  if ((SUM_AllnoPermitEx == TRUE) && (SWC_AllnoPermitEx == TRUE))
  {
    if (SUSD_GaaWaitGlobalForceShutdownTimer > SUSD_ZERO)
    {
      SUSD_GaaWaitGlobalForceShutdownTimer--;
    }
    /* else: timer is already zero - keep it at zero so expiration handling runs below */
  }
  else /* in other case restore the Config Value */
  {
    SUSD_GaaWaitGlobalForceShutdownTimer = SUSD_T_FORCE_SHUTDOWN_WAIT;
  }
  /*When this timer expired set all the Flag and array to force the Enable shutdown*/
  if (SUSD_GaaWaitGlobalForceShutdownTimer == SUSD_ZERO)
  {
    for (SUM_ShutdownIter = 0; SUM_ShutdownIter < SUSD_SUM_PERMEXE; SUM_ShutdownIter++ )
    {
       /* Timer expired - override SUM response and force Enable Shutdown */
      SUSD_GaaSUMShutdownPermission[SUM_ShutdownIter] = ENABLESHUTDOWN;
      /* Set bit to 1 when forcing Enable Shutdown */
      SUSD_SetShutdownEnableBit_SUM((uint8)SUM_ShutdownIter);
    }
«IF NumOfSwcConfigured(sUSD.sUSDConfigSet) >= 1-»
    for (SWC_ShutdownIter = 0; SWC_ShutdownIter < NO_OF_SWCS; SWC_ShutdownIter++ )
    {
         /* Timer expired - override SUM response and force Enable Shutdown */
          SUSD_GaaSWCShutdownPermission[SWC_ShutdownIter] = ENABLESHUTDOWN;
«IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.select(e|e.sUSD_C_ShutdownPermControl == true).size > 0) -»
          /* Set bit to 1 when forcing Enable Shutdown */
          SUSD_SetShutdownEnableBit_SWC((uint8)SWC_ShutdownIter);
«ENDIF-»
    }
«ENDIF-»
  }
}



/***********************************************************************************

  Function name :   SUSD_SUM_PermitExecution
  Description   :   Function to handle the Permit Execution interface from SUM
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 133] [$SDD_SUSD 147]*/
/* PRQA S 1532 1 # This Function can be used in the multiple file and can not be turned into static as well as moved to static code */
FUNC(void, SUSD_CODE) SUSD_SUM_PermitExecution(void)
{
  /* Local variable to loop SUM to load timer on reset */
  uint8 LucSUMCount;
  static boolean SumSpmBit1SetOnce = FALSE;
  «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SPM")-»
  /*if bit 0 is 1, set bit 1 only once*/
  if((((SUSD_GaaSUMPermitExecution[SUM_SPM] & (uint8)0x01) == (uint8)0x01)) &&
      (SumSpmBit1SetOnce == FALSE))
  {
    SUSD_GaaSUMPermitExecution[SUM_SPM] = (SUSD_GaaSUMPermitExecution[SUM_SPM] | (uint8)0x02);
    SumSpmBit1SetOnce = TRUE;
  }
  «ENDIF-»

  «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_PNC")-»
  /* Check hardware availability */
  if(TRUE == SUSD_GblPnHwAvailable)
  {
    /* Set bit 3 in case PN hardware is supported by the ECU */
    SUSD_GaaSUMPermitExecution[SUM_PNC] = (SUSD_GaaSUMPermitExecution[SUM_PNC] | (uint8)0x04);
  }
  «ENDIF-»
  «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_LNM")-»
  /* Check hardware availability */
  if(TRUE == SUSD_GblLinHwAvailable)
  {
    /* Set bit 3 in case LIN hardware is supported by the ECU */
    SUSD_GaaSUMPermitExecution[SUM_LNM] = (SUSD_GaaSUMPermitExecution[SUM_LNM] | (uint8)0x04);
  }
  «ENDIF-»
  for(LucSUMCount = SUSD_ZERO; LucSUMCount < SUSD_SUM_PERMEXE; LucSUMCount++)
  {
      /* Rte API to indicate the Permit Execution to all SUMs with the bit information */
      (void)SUSD_GaaSUM_PermitExec_Interface[LucSUMCount](SUSD_GaaSUMPermitExecution[LucSUMCount]);
  }
  /* If Diagnostic Reprogramming request or Reset Request or SOH Reset Request */
  if((SUM_REPREQ_ACTIVE == SUSD_GblDiagReprgRequest) || (SUM_RESREQ_ACTIVE == SUSD_GblDiagResetRequest))
  {
    /* Satisfies: [$SDD_SUSD 146]*/
    SUSD_SUM_PermitExecutionDiagReprgmRstReq();
  }
  else
  {
    SUSD_SUM_PermitExecutionToSUMsWithBitInfo();
  }
  
}

/***********************************************************************************

  Function name :   SUSD_SUM_PermitExecutionDiagReprgmRstReq
  Description   :   Function to handle the Permit Execution interface from SUM
                :   for Diagnostic reprogram/reset or SOH Reset Request
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_SUM_PermitExecutionDiagReprgmRstReq(void)
{

  uint8 SUM_counter;
  uint8 SUM_limit = SUSD_SUM_PERMEXE;
  const uint8 SUM_disabling_order[SUSD_SUM_PERMEXE]={
    
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SSFM_ERRH") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SSFM_ERRH").first().sUSD_PermitExecution == true-»
    SUM_SSFM_ERRH,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_LNM") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_LNM").first().sUSD_PermitExecution == true-»
    SUM_LNM,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_PNC") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_PNC").first().sUSD_PermitExecution == true-»
    SUM_PNC,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SOH") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SOH").first().sUSD_PermitExecution == true-»
    SUM_SOH,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SSFM_SSM") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SSFM_SSM").first().sUSD_PermitExecution == true-»
    SUM_SSFM_SSM,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SSC") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SSC").first().sUSD_PermitExecution == true-»
    SUM_SSC,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_TCS") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_TCS").first().sUSD_PermitExecution == true-»
    SUM_TCS,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SRVMGR") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SRVMGR").first().sUSD_PermitExecution == true-»
    SUM_SRVMGR,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SPM") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SPM").first().sUSD_PermitExecution == true-»
    SUM_SPM,
    «ENDIF-»
    «IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_DIAG") && 
    sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_DIAG").first().sUSD_PermitExecution == true-»
    SUM_DIAG
    «ENDIF-»
    };

  for(SUM_counter=0u;SUM_counter<SUM_limit;SUM_counter++)
  {
		/*If a reset request occurred*/
		if(SUM_RESREQ_ACTIVE == SUSD_GblDiagResetRequest)
		{
			/* Satisfies: [$SDD_SUSD 168] */
			/* Satisfies: [$SDD_SUSD 038] */
			/*Set the shutdown target bit and reset all the other bits including the reset bit*/
			SUSD_GaaSUMPermitExecution[SUM_disabling_order[SUM_counter]]=NOT_OFF;
		}
		else
		{
			/* Satisfies: [$SDD_SUSD 168] */
			/* Satisfies: [$SDD_SUSD 038] */
			/*Reset all te bits including the reset bit*/
			SUSD_GaaSUMPermitExecution[SUM_disabling_order[SUM_counter]] = SUSD_ZERO;
		}
		/* Rte API to indicate the Permit Execution to SUM_SOH with the bit information */
		SUSD_GaaSUM_PermitExec_Interface[SUM_disabling_order[SUM_counter]](SUSD_GaaSUMPermitExecution[SUM_disabling_order[SUM_counter]]);
  }

  

  /* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
  if((Rte_IrvRead_Runnable_AppStateManager_SUM_SUSD_RESETExecution_TIMER_started()==FALSE)
	  &&(SUSD_GblDiagResetRequest==SUM_RESREQ_ACTIVE))
  {
	  /* Satisfies: [$SDD_SUSD 169] */
	  Rte_IrvWrite_Runnable_AppStateManager_SUM_SUSD_RESETExecution_TIMER_started((TRUE));
  }
}

/***********************************************************************************

  Function name :   SUSD_SUM_PermitExecutionToSUMsWithBitInfo
  Description   :   Function to handle the Permit Execution interface for SUM
                :   with bit information
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 134]*/
