/***********************************************************************************

  Function name :   SUSD_CheckVehicleBatteryVoltageState
  Description   :   Check if the battery voltage is in a specific state
  Parameter in  :   UpperLimit - upper boundary of battery voltage
  	  	  	  	  	LowerLimit - lower boundary of battery voltage
  	  	  	  	  	CurrentVoltage - current battery voltage
  	  	  	  	  	PrevState -  battery voltage state
  	  	  	  	  	State - state to check: SUSD_IN_RANGE(0), SUSD_OUT_OF_RANGE_LOW(1), SUSD_OUT_OF_RANGE_HIGH(2)
  Parameter out :   OutState
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_CheckVehicleBatteryVoltageState(uint16 UpperLimit, uint16 LowerLimit,
																  uint16 CurrentVoltage, uint16* OutState, uint16 State)
{
	switch (State) {
		case SUSD_OUT_OF_RANGE_HIGH:
			if(CurrentVoltage > UpperLimit)
			{
				*OutState = (uint16)SUSD_OUT_OF_RANGE_HIGH;
			}
			break;
		case SUSD_OUT_OF_RANGE_LOW:
			if(CurrentVoltage < LowerLimit)
			{
				*OutState = (uint16)SUSD_OUT_OF_RANGE_LOW;
			}
			break;
		default:
			/* SUSD_IN_RANGE */
			if((CurrentVoltage >= LowerLimit)&&(CurrentVoltage <= UpperLimit))
			{
				*OutState = (uint16)SUSD_IN_RANGE;
			}
			break;
	}
}



