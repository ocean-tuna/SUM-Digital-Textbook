/***********************************************************************************

  Function name :   Manage_SUM_SUSD_RESETExecution_TIMER
  Description   :   Function for managing the determination of the type of reset
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* PRQA S 1532 1 # This Function can be used in the multiple files and cannot be turned into static as well as moved to static code  */
FUNC(void, SUSD_CODE) Manage_SUM_SUSD_RESETExecution_TIMER(void)
		{
	/* Satisfies: [$SDD_SUSD 169] */
	static boolean write_cnt_at_shutdown_start = FALSE;

	/*If SUSD wants to write SUM_SUSD_RESETExecution_TIMER into NvM*/
	/* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
	if((Rte_IrvRead_Runnable_Manage_SUM_SUSD_RESETExecution_TIMER_NvMWrite_SUM_SUSD_RESETExecution_TIMER_started())==TRUE)
	{
		/*Check if it already started writing the final value of SUM_SUSD_RESETExecution_TIMER into NvM*/
		if(write_cnt_at_shutdown_start == FALSE)
		{
			/*If not*/
			/*Increase SUM_SUSD_RESETExecution_TIMER*/
			SUM_SUSD_RESETExecution_TIMER += (SUM_SUSD_RESETExecution_TIMER > SUSD_MAX_RESETEXECUTION_TIMER) ? 0u : SUSD_RESET_EXECUTION_PERIOD;

			/* Check if the initial writing of SUM_SUSD_RESETExecution_TIMER is still pending */
			if (E_PENDING == Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER)
			{
				Susd_NvmGetErrorStatus_uint16(&susd_NvMServiceRESET_ExecutionTimerBlock_FP, &Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER);
			}
			/* If the initial writing of SUM_SUSD_RESETExecution_TIMER is not pending */
			if (E_PENDING != Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER)
			{
				/*Communicate that SUM_SUSD_RESETExecution_TIMER has changed*/
				if(E_OK==susd_NvMServiceRESET_ExecutionTimerBlock_FP.Susd_RteCallNvmSetRamBlockStatus_fp(TRUE))
				{
					/*Start writing SUM_SUSD_RESETExecution_TIMER into NvM*/
					/* [$Satisfies $SDD_SUSD 250] */
					Susd_NvmWriteBlock_uint16(&susd_NvMServiceRESET_ExecutionTimerBlock_FP, &Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER);
					/*Update the flag to communicate that the final writing of SUM_SUSD_RESETExecution_TIMER has been started*/
					write_cnt_at_shutdown_start = TRUE;
				}
			}
			else
			{
				/*Do Nothing*/
			}
		}
		else
		{
			/*Check if the final writing of SUM_SUSD_RESETExecution_TIMER into NvM is still pending*/
			Susd_NvmGetErrorStatus_uint16(&susd_NvMServiceRESET_ExecutionTimerBlock_FP, &Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER);
			/*If the final writing of SUM_SUSD_RESETExecution_TIMER into NvM is not pending*/
			if(E_PENDING != Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER)
			{
				/*Set Go_to_Reset to TRUE*/
				Rte_IrvWrite_Runnable_Manage_SUM_SUSD_RESETExecution_TIMER_Go_to_reset((TRUE));
				/*Update SUSD_GddASM_CurrentMode*/
				SUSD_GddASM_CurrentMode = SUM_RESET;

				if(SUSD_GddASM_CurrentMode != Rte_Mode_RP_SUSD_CurrentECUOperatingModePort_CurrentMode())
				{
					/* Indicate the state to BswM to reset the ECU */
					(void)Rte_Switch_PP_SUSD_ECUOperatingModeReq_ECUOperatingMode(SUSD_GddASM_CurrentMode);
				}
			}
		}
	}
	/*If SUM_SUSD_RESETExecution_TIMER has already been started*/
	/* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
	else if((Rte_IrvRead_Runnable_Manage_SUM_SUSD_RESETExecution_TIMER_SUM_SUSD_RESETExecution_TIMER_started())==TRUE)
	{
		/*Increment SUM_SUSD_RESETExecution_TIMER*/
		SUM_SUSD_RESETExecution_TIMER += (SUM_SUSD_RESETExecution_TIMER > SUSD_MAX_RESETEXECUTION_TIMER) ? 0u : SUSD_RESET_EXECUTION_PERIOD;

		/*Check if there is an NvM writing pending*/
		Susd_NvmGetErrorStatus_uint16(&susd_NvMServiceRESET_ExecutionTimerBlock_FP, &Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER);
		/*If there is no NvM writing pending*/
		if (E_PENDING != Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER)
		{
			/*Communicate that SUM_SUSD_RESETExecution_TIMER has changed*/
			(void)susd_NvMServiceRESET_ExecutionTimerBlock_FP.Susd_RteCallNvmSetRamBlockStatus_fp(TRUE);
		}
	}
	else
	{
		/*Do nothing*/
	}
}
«IF (sUSD.sUSDGeneral.sUSD_PowerModing_Slave_Supported)-» 
/***********************************************************************************

  Function name :   Manage_SUM_SUSD_RunningResetWait_TIMER
  Description   :   Function for handling wait time after running reset occurs
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* PRQA S 1532 1 # This Function can be used in the multiple files and cannot be turned into static as well as moved to static code  */
FUNC(void, SUSD_CODE) Manage_SUM_SUSD_RunningResetWait_TIMER(void)
{
  /* Satisfies: [$SDD_SUSD 149] [$SDD_SUSD 176] */
  static uint32 elapsed_time;
  /* Check if wakeup flag is set after reset occurs */
   if (WakeupAfterReset == TRUE)
   { 
      /* Check if the elapsed time is over the wait time */
      if (elapsed_time >= RunningResetWaitTime)
      {
        /* Set the timer expired flag*/
        TimerExpired = TRUE;
        elapsed_time = 0u;
      }
      else
      {
        elapsed_time += SUSD_RESET_EXECUTION_PERIOD;
      }
   }
}
«ENDIF-»
/***********************************************************************************

  Function name :   SUSD_Init
  Description   :   Initialization routine of SUM_SUSD module. It shall initialize all interfaces to default values.
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
 /* Satisfies: [$SDD_SUSD 019], [$SDD_SUSD 110], [$SDD_SUSD 111] */
/* include MemMap.h required here to occupy the space in memory for the described macro*/
/* PRQA S 1532 2 # Function defined here for modularity reason */
/* PRQA S 1503 1 # When the SUSD is integrated, this runnable will be called */
FUNC(void, SUSD_CODE) SUSD_Init(void)
{
  «IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
  uint32 LulShutdownPermInterfaceCount;
  «ENDIF-»
  uint32 LddPermitExeInterfaceCount;
  /* Local Variable used to initialize Shutdown Permission */
  uint8 LucShutdownPermCount;
      
  /* Read the current value of the First Boot Post Flash Flag from NVM */
  uint8 Sum_SUSD_FirstBootAfterFlash = SUSD_ReadFirstBootAfterFlash_Flag();

  /* Check if this is the first boot after flashing */
  if(Sum_SUSD_FirstBootAfterFlash != SUSD_FIRST_BOOT_VALID_FLAG)
  {
    /* Set internal flag indicating first boot after flash */
    isFirstBootAfterFlash = TRUE;

    /* Write validation flag to NVM to indicate boot has occurred */
    SUSD_WriteFirstBootAfterFlash_Flag(SUSD_FIRST_BOOT_VALID_FLAG);
    
  }

  /* Update the unmarshalled version of the DID 0xE0D7 NVRam mirror block after reading on startup */
  SUSD_E0D7_Populate_On_Startup();

  /* Initialize the RxID-to-index map and next free index from DID 0xE0D7 */
  SUSD_Init_RxID_Index_Map();

  /* Initialize the active substate for DID 0xE0D7 */
  SUSD_E0D7_Init_ActiveSubState();

	if(SUSD_GetInitState() == E_NOT_OK)
	{
	
	«IF (sUSD.sUSDGeneral.sUSD_PowerModing_Slave_Supported)-» 
		/* variable to store NvM Get Error Status API return value */
		Std_ReturnType LucRet_Sts;
		/* variable to store Nvm Get Error Status value */
		NvM_RequestResultType LucNvMErSts;
	«ENDIF-»
		/* Initialize Diagnostic Reprogramming request to inactive by default */
		SUSD_GblDiagReprgRequest = SUM_REPREQ_INACTIVE;

		/* Clear wakeup sources */
		SUSD_GddValidatedWakeupSrc = SUSD_ZERO;
	«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported)-»
		/* Set Run Crank Active to INACTIVE by default */
		SUSD_RunCrankActive = SUSD_INACTIVE;
		/* Set Run Crank Active invalidity to TRUE by default */
		SUSD_RunCrankActiveInv = TRUE;
	«ENDIF-»

		/* Initialize Diagnostic Reset request to inactive by default */
		SUSD_GblDiagResetRequest = SUM_RESREQ_INACTIVE;

	«IF (sUSD.sUSDGeneral.sUSD_PowerModing_Slave_Supported)-» 
    /* Get running reset wait time */
    RunningResetWaitTime = (uint32)1000u * (uint32)Rte_CData_SUSD_PDP_SUSD_C_RunningResetWaitTime(); // Store in micro-seconds precision
		/* check get error status */
		LucRet_Sts = Rte_Call_RP_NvMService_VehPowerMode_GetErrorStatus(&LucNvMErSts);
		/* As per Design review discussion with GM,read VPM value from NvM if request is OK else VPM is SUM_PMS_OFF */
		if ((LucRet_Sts == E_OK) && ((LucNvMErSts == NVM_REQ_OK) || (LucNvMErSts == NVM_REQ_BLOCK_SKIPPED)))
		{
			/* Set VPM as read from NvM */
			/* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
			SUSD_VehiclePowerMode = *Rte_Pim_VehiclePowerMode_State();
		}
		else
		{
			/* Vehicle Power mode state as OFF */
			SUSD_VehiclePowerMode = SUM_PMS_OFF;
		}
		/* Set initially invalidity to true, when valid power mode is available then set to false */
		SUSD_VehiclePowerModeInv = TRUE;

		/* Indicate Vehicle Power Mode to SWCs */
		/* [$Satisfies $SDD_SUSD 248] */
		(void) Rte_Write_PP_SUSD_VehiclePowerMode_VehiclePowerMode(SUSD_VehiclePowerMode);
		
		/* Indicate Vehicle Power Mode Invalidity to SWCs */
		/* [$Satisfies $SDD_SUSD 248] */
		(void) Rte_Write_PP_SUSD_VehiclePowerMode_Inv_VehiclePowerMode_Inv(SUSD_VehiclePowerModeInv);
	«ENDIF-»

		/* Set vehicle Battery Voltage to 12 volts by default */
		SUSD_GucVehicleBattVoltage = (uint8) SUSD_INIT_VOLTAGE;

		«IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
		/* Initializing the Permit Execution to default value for the number of SW-Cs configured for this interface */
		for (LddPermitExeInterfaceCount = SUSD_ZERO ; LddPermitExeInterfaceCount < NO_OF_SWCS ;
				LddPermitExeInterfaceCount++)
		{
			SUSD_GaaSWCPermitExecution[LddPermitExeInterfaceCount] = (SUSD_SWC_ExecutionStatusType) SUSD_ZERO;
		}
		«ENDIF-»
		/* Initializing the Permit Execution to default value for the 8 SUMs configured for this interface */
		for (LddPermitExeInterfaceCount = SUSD_ZERO ; LddPermitExeInterfaceCount < SUSD_SUM_PERMEXE ;
				LddPermitExeInterfaceCount++)
		{
			SUSD_GaaSUMPermitExecution[LddPermitExeInterfaceCount] = (SUSD_SWC_ExecutionStatusType) SUSD_ZERO;
		}
    /*Set The wait Global Force Timer to the Configured valua at Init*/
    SUSD_GaaWaitGlobalForceShutdownTimer = SUSD_T_FORCE_SHUTDOWN_WAIT;

	  
    «IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.select(e|e.sUSD_C_ShutdownPermControl == true).size > 0) -»
	  /* Initialize SWC shutdown enable bit array to all 1s (Enable Shutdown) */
	  {
      uint32 arraySize = SUSD_SWC_SHUTDOWN_BIT_ARRAY_SIZE;
	    uint32 i;
      /* PRQA S 2877 20 # Loop designed for scalability with multiple SWC array elements */
	    for (i = SUSD_ZERO; i < arraySize; i++)
	    {
	      Gblshutdownenablecnt[i] = 0xFFFFFFFFFFFFFFFFULL;
	    }
	  }
    «ENDIF-»
    «IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
		/* Initializing the Shutdown Permission to default value for the number of SW-Cs configured for this interface */
		for (LulShutdownPermInterfaceCount = SUSD_ZERO ; LulShutdownPermInterfaceCount < NO_OF_SWCS ;
				LulShutdownPermInterfaceCount++)
		{
			SUSD_GaaSWCShutdownPermission[LulShutdownPermInterfaceCount] = ENABLESHUTDOWN;

			SUSD_GaaShutdownTimer[LulShutdownPermInterfaceCount] = SUSD_T_SHUTDOWN_REFRESH;

		}
    «ENDIF-»

    /* Initialize SUM shutdown enable bit array to all 1s (Enable Shutdown) */
	  GblSUMshutdownenablecnt = 0xFFFFU;

		/* Initializing the Shutdown Permission to default value for the 4 SUMs configured for this interface */
		for (LucShutdownPermCount = SUSD_ZERO ; LucShutdownPermCount < SUSD_SUM_SHUTPERM ; LucShutdownPermCount++)
		{
			SUSD_GaaSUMShutdownPermission[LucShutdownPermCount] = ENABLESHUTDOWN;

			SUSD_GaaSUMShutdownTimer[LucShutdownPermCount] = SUSD_T_SHUTDOWN_REFRESH;

		}
	«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported)-»
		/* Clear the accumulated counter for run crank input stuck high diagnostic Enable Criteria */
		SUSD_RunCrankStuckHighDiagnostic_EnabledCount = SUSD_ZERO;
		/*clear the accumulated counter for Failure Criteria */
		SUSD_RunCrankStuckHighDiagnostic_FailCount = SUSD_ZERO;

		/* Clear the accumulated counter for run crank input stuck low diagnostic Enable Criteria */
		SUSD_RunCrankStuckLowDiagnostic_EnabledCount = SUSD_ZERO;
		/*clear the accumulated counter for Failure Criteria */
		SUSD_RunCrankStuckLowDiagnostic_FailCount = SUSD_ZERO;
	«ENDIF-»

		/* Initialization of Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER */
		Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER=0u;
		/*Reset Go_to_reset*/
		/* PRQA S 3432 1 # This runnable is invoked so the argument will follow the AUTOSAR specification */
		Rte_IrvWrite_Runnable_Manage_SUM_SUSD_RESETExecution_TIMER_Go_to_reset(FALSE);
		/* Initialization of ASM of SUSD */
		SUSD_GddASM_CurrentMode = SUM_INIT;
		
		/* set init state to done */
		SUSD_SetInitState();
	}
}

/***********************************************************************************

  Function name :   SUSD_UpdatedWakeupSource
  Description   :   Indication from BswM on successful activation or deactivation of the wakeup source
  Parameter in  :   WakeupSrc
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 147] [$SDD_SUSD 166] [$SDD_SUSD 205] [$SDD_SUSD 239]*/
/* PRQA S 1503 1 # When the SUSD is integrated, this runnable will be called */
FUNC(void, SUSD_CODE) SUSD_UpdatedWakeupSource(uint32 WakeupStatus)
{
  /*Counter to check the previous status of wakeups*/
  uint8 WakeupCounter;
  /*Previous status of wakeup*/
  uint32 Prev_WakeupStatus;
  /*Variable to store the position of the wakeup that has changed*/
  uint32 WakeupSrc;
  /*Variable used to check the least significant bit which has been changed*/
  uint32 Wakeup_mask;
  /*Variable used to keep track of the number of right-shifts which have been performed*/
  uint8 n_shift;
  /*Variable used to verify whether the bit, that was changed, has been found*/
  boolean bit_found;

  uint8 SrcArrayIndex;
  
	if(SUSD_GetInitState() == E_OK)
	{
    Sum_SUSD_AR_LINRecord_Handler(WakeupStatus);
    Sum_SUSD_AR_ECURecord_Handler(WakeupStatus);

	  Prev_WakeupStatus=0u;

	  /*Find the previous status of wakeups*/
	  for(WakeupCounter=0;WakeupCounter<Luccount;WakeupCounter++)
	  {
		 Prev_WakeupStatus|=SUSD_GaaWakeUpSources[WakeupCounter] ;
	  }
	  /*Check which bit has changed*/
	  if(Prev_WakeupStatus!=WakeupStatus)
	  {
		/*Compute an array whose ones are located in the position of the changed bits*/
		WakeupSrc = WakeupStatus^Prev_WakeupStatus;

		n_shift=0;

		bit_found=FALSE;

		Wakeup_mask=WakeupSrc;

		WakeupSrc=0u;

		while((bit_found==FALSE)&&(n_shift<32u))
		{
			if((Wakeup_mask&0x1u)==0x1u)
			{
				/*Store in WakeupSrc the least significant bit which changed*/
				WakeupSrc=(uint32)1u<<n_shift;
				for(SrcArrayIndex=0;(SrcArrayIndex<NO_OF_WAKEUPSRCS)&&(bit_found==FALSE);SrcArrayIndex++)
				{
					/* Match the wakeup source with the list configured */
					if((SUSD_GaaWakeupSourcesArray[SrcArrayIndex] & WakeupSrc)!= SUSD_ZERO)
					{
						bit_found=TRUE;
					}
				}
				if(bit_found==FALSE)
				{
				   WakeupSrc=0u;
				   n_shift++;
				   Wakeup_mask=Wakeup_mask>>1;
				}
			}
			else
			{
			  n_shift++;
			  Wakeup_mask=Wakeup_mask>>1;
			}
		}
		
		SUSD_ActDeact_WakeupSource(WakeupSrc,WakeupStatus);

	  }
	}
}

/***********************************************************************************

  Function name :   SUSD_ActDeact_WakeupSource
  Description   :   To activation or deactivation of the wakeup source
  Parameter in  :   WakeupSrc
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_ActDeact_WakeupSource(uint32 WakeupSrc , uint32 WakeupStatus)
{
	if(WakeupSrc!=0u)
	{
		/*Two different conditions if the wakeup was activated or deactivated*/
		if((WakeupSrc&WakeupStatus)!= 0u)
		{
			SUSD_ActivatedWakeupSource(WakeupSrc);
		}
		else
		{
			SUSD_DeactivatedWakeupSource(WakeupSrc);
		}
	}
}

/***********************************************************************************

  Function name :   SUSD_ActivatedWakeupSource
  Description   :   Function used to find the activated Wakeup source,
                    update SUSD_GaaWakeUpSources,
                    activate the wakeup bits and
                    keep track of the number of currently active wakeups
  Parameter in  :   WakeupSrc
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_ActivatedWakeupSource(uint32 WakeupSrc)
{
  /*Variable needed to identify the first iteration*/
  static boolean first_iteration=TRUE;
  /* Variable to read the time of occurrence of wakeup from TCS */
  TimeSyncMessageType LucTimeValue;
  /* Variable used for looping to store the time of occurrence */
  uint8 LucTmValcnt;

  SUSD_ECUWakeupDetectionRecord Data;


  if(first_iteration==TRUE)
  {

     /* Copy the wakeup source for DID info on current wakeup source */
     SUSD_GddValidatedWakeupSrc = WakeupSrc;

     /* Manage the interface with SOH and reset SUM_SUSD_RESETExecution_TIMER*/
     Manage_Initial_SUM_SUSD_RESETExecution_TIMER(WakeupSrc);
     
     /* On a power-on/off cycle (WakeupAfterReset == FALSE), reset RxTAT to 0 for all
        activity records. SUSD_E0D7_Populate_On_Startup() restores NvM data unconditionally
        at startup, but RxTAT is a per-key-cycle timer and must be 0 at each new key cycle.
        On an ECU reset within the same key cycle (WakeupAfterReset == TRUE), RxTAT is
        left as restored from NvM so it correctly accumulates across the reset. */
     if (WakeupAfterReset == FALSE)
     {
         SUSD_E0D7_Reset_RxTAT_For_PowerOn();
     }

     /*Reset the flag to indicate that the first iteration occurred*/
     first_iteration=FALSE;

     /* Get the time from TCS to store the time of occurence of wakeup */
     (void)Rte_Read_RP_TCS_SUSD_Clock_GlobalTime(&LucTimeValue);

     /* Store the wakeup source ID and TimeStamp*/
     Data.ECUWakeupDetectionRecordId[0] = (uint8)WakeupSrc;
     Data.ECUWakeupDetectionRecordId[1] = (uint8)(WakeupSrc >> 8u);
     Data.ECUWakeupDetectionRecordId[2] = (uint8)(WakeupSrc >> 16u);
     Data.ECUWakeupDetectionRecordId[3] = (uint8)(WakeupSrc >> 24u);

     for(LucTmValcnt = SUSD_ZERO; LucTmValcnt < SUSD_FIVE; LucTmValcnt++)
     {
        /* Store the time of occurrence in big-endian format */
        Data.TimeStampOfOccurence[LucTmValcnt] = (uint8)((LucTimeValue >> ((SUSD_FIVE - 1u - LucTmValcnt) * 8u)) & 0xFFu);
     }

     /*Update the ECU Wakeup Detection Records based on validated wakeup source*/
     SUSD_ECUWakeupDetectionRecordsUpdate(&Data);
  }

  /*Set Wakeup bits in the PermitExecution interfaces*/
  SUSD_SetWakeupbits(WakeupSrc);

  /*Check Local count is within limits - number of wakeup sources */
  if(Luccount < NO_OF_WAKEUPSRCS)
  {
	/* Store the wakeup source ID*/
	SUSD_GaaWakeUpSources[Luccount]  = WakeupSrc;
    /*Increment counter*/
    Luccount++;
  }
  else
  {
    Luccount = NO_OF_WAKEUPSRCS;
  }
}

/***********************************************************************************

  Function name :   Manage_Initial_SUM_SUSD_RESETExecution_TIMER
  Description   :   Function used to manage the interface which communicates the
                    type of reset to the SOH. It is also used to reset
                    SUM_SUSD_RESETExecution_TIMER and it into NvM.
  Parameter in  :   WakeupSrc
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/

static FUNC(void, SUSD_CODE) Manage_Initial_SUM_SUSD_RESETExecution_TIMER(uint32 WakeupSrc)
{

	static SUSD_SOH_ResetOccurredType LastResetType = LAST_RESET_INVALID;;

	/* Satisfies: [$SDD_SUSD 169] */
	/*If the WakeupSrc is among the ones indicated in the specs, and the timer value is below the threshold*/
    if((WakeupSrc==ECUM_WKSOURCE_RESET)||
   	    (WakeupSrc==ECUM_WKSOURCE_INTERNAL_RESET)||
		(WakeupSrc==ECUM_WKSOURCE_INTERNAL_WDG)||
		(WakeupSrc==ECUM_WKSOURCE_EXTERNAL_WDG))

	{

    	/* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
    	if((1000u * Rte_CData_SUM_SUSD_RESETExecution_TIMER_Thresh()) >= (*susd_NvMServiceRESET_ExecutionTimerBlock_FP.NvmRamBlock))
    	{
			  /*Tell SOH that it was an immediate Reset*/
			LastResetType=SUSDResetOccurred_ImmediateResetOccurred;
    	}
    	else
    	{
    		 /*Tell SOH that it was a delayed Reset*/
    		LastResetType=SUSDResetOccurred_DelayedResetOccurred;
    	}
«IF (sUSD.sUSDGeneral.sUSD_PowerModing_Slave_Supported)-»       
    	WakeupAfterReset = TRUE;
«ENDIF-»     
	}
    else
    {
        /*Tell SOH default*/
    	LastResetType=SUSDResetOccurred_Default;
    }
    /* [$Satisfies $SDD_SUSD 248] */
    (void)Rte_Write_PP_SUSD_SOH_ResetOccurred_SUSDResetOccurred(LastResetType);
    /*Reset SUM_SUSD_RESETExecution_TIMER*/
    SUM_SUSD_RESETExecution_TIMER=0x0000;
    /*For the sake of completeness, check if there is any other NvM writing pending*/
	if (E_PENDING == Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER)
	{
		Susd_NvmGetErrorStatus_uint16(&susd_NvMServiceRESET_ExecutionTimerBlock_FP, &Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER);
	}
	/*If there is no other NvM writing pending*/
	if (E_PENDING != Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER)
	{
	  /*Communicate that SUM_SUSD_RESETExecution_TIMER has changed*/
	  if(E_OK==susd_NvMServiceRESET_ExecutionTimerBlock_FP.Susd_RteCallNvmSetRamBlockStatus_fp(TRUE))
	  {
		/*Start writing SUM_SUSD_RESETExecution_TIMER into NvM*/
		/* [$Satisfies $SDD_SUSD 250] */
		Susd_NvmWriteBlock_uint16(&susd_NvMServiceRESET_ExecutionTimerBlock_FP, &Susd_LastRequestResult_SUM_SUSD_RESETExecution_TIMER);
	  }
	}
}

/***********************************************************************************

  Function name :   SUSD_DeactivatedWakeupSource
  Description   :   Function used to find the deactivated Wakeup source,
                    update SUSD_GaaWakeUpSources,
                    deactivate the wakeup bits and
                    keep track of the number of currently active wakeups
  Parameter in  :   WakeupSrc
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_DeactivatedWakeupSource(uint32 WakeupSrc)
{
  /*Flag used to check when the wakeup source, which has been deactivated, is found*/
  boolean Wakeupfound;
  /* Variable used for looping through the wakeup sources configured */
  uint8 Lulwakeupsrccount;
  /*Index*/
  uint8 SrcArrayIndex;

  Wakeupfound=FALSE;

  for(Lulwakeupsrccount = SUSD_ZERO; (Lulwakeupsrccount < NO_OF_WAKEUPSRCS)&&(Wakeupfound==FALSE); Lulwakeupsrccount++)
  {
    /*If the wakeup source stored in the array is equal to the deactivated wakeup source*/
    if(SUSD_GaaWakeUpSources[Lulwakeupsrccount]  == WakeupSrc)
    {
      Wakeupfound=TRUE;
	  /*Reset the data stored in the array related to this source*/
	  SUSD_GaaWakeUpSources[Lulwakeupsrccount] =0u;

	  if(Luccount>1u)
	  {
	    /*Reorganize the array*/
	    for (SrcArrayIndex=Lulwakeupsrccount;SrcArrayIndex<(Luccount-1u);SrcArrayIndex++)
	    {
	      SUSD_GaaWakeUpSources[SrcArrayIndex] =SUSD_GaaWakeUpSources[(SrcArrayIndex+1u)] ;

	    }
	    SUSD_GaaWakeUpSources[SrcArrayIndex] =0u;

        Luccount--;
      }
      else
      {
        Luccount = SUSD_ZERO;
      }


	  /*Reset Wakeup bits*/
	  SUSD_ResetWakeupbits();

	}
  }
}



/***********************************************************************************

  Function name :   SUSD_SetWakeupbits
  Description   :   Function used to set the wakeup bits in the PermitExecution Interfaces
  Parameter in  :   WakeupSrc
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_SetWakeupbits(uint32 WakeupSrc)
{
    uint8 i;
    boolean WakeupBitSet = FALSE;

    NoActiveWakeup = WAKEUPS_ENABLED;
    
    /* Set wakeup bits for all relevant SUM modules.
    ** SUSD_SUM_PERMEXE doesn't exceed 32 by configuration. */
    for (i = 0u; i < SUSD_SUM_PERMEXE; i++)
    {
        if ((SUSD_GaaSUMWakeupMasks[i] & WakeupSrc) != 0u)
        {
            /* Check if the bit for this module is not already set */
            if (((SUSD_ModuleWakeupBits & ((uint32)1u << i))) == 0u)
            {
                /* This wakeup source is relevant for this SUM module */
                SUSD_GaaSUMPermitExecution[i] = (SUSD_GaaSUMPermitExecution[i] | (uint8)0x01);
                
                /* Set the corresponding bit in the global wakeup bits variable */
                SUSD_ModuleWakeupBits |= ((uint32)1u << i);
                
                /* Mark that at least one wakeup bit was set */
                WakeupBitSet = TRUE;
            }
        }
    }
    /* Execute permit execution only if at least one wakeup bit was set */
    if (WakeupBitSet != FALSE)
    {
        /* Permit Execution interface to be invoked after wakeup validation */
        SUSD_SUM_PermitExecution();
    }

    /* Set wakeup bits for all relevant SWCs. 
    ** SUSD_SWCModuleWakeupBits doesn't exceed 32 by configuration. */
    WakeupBitSet = FALSE;
    for (i = 0u; i < NO_OF_SWCS; i++)
    {
        if ((SUSD_GaaSWCWakeupMasks[i] & WakeupSrc) != 0u)
        {
            if (((SUSD_SWCModuleWakeupBits & ((uint32)1u << i))) == 0u)
            {
              SUSD_SWCModuleWakeupBits |= ((uint32)1u << i);
              WakeupBitSet = TRUE;
            }
        }
    }
    /* Execute permit execution only if at least one wakeup bit was set */
    if (WakeupBitSet != FALSE)
    {
        /* SWC-specific wakeup without a matching SUM - still update SWC permit execution */
        SUSD_SWC_PermitExecution();
    }
}

/***********************************************************************************

  Function name :   SUSD_ResetWakeupbits
  Description   :   Function used to reset the wakeup bits in the PermitExecution Interfaces
  Parameter in  :   WakeupSrc
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_ResetWakeupbits(void)
{
  uint8 i;
	boolean WakeupBitReset = FALSE;

	/* Build AnySimilarWakeup. */
	SUSD_CheckSimilarWakeups();

	/* Loop on all the SUM modules. */
	for (i = 0; i < SUSD_SUM_PERMEXE; i++)
	{
    /* If current SUM is active and no relevant wakeup source: reset wakeup bit. */
		if ((((SUSD_ModuleWakeupBits & ((uint32)1u << i))) != 0u) && ((SUSD_GaaSUMWakeupMasks[i] & AnySimilarWakeup) == 0u))
		{
      /* Reset when no similar wakeup is active for this SUM module */
      SUSD_GaaSUMPermitExecution[i] &= (uint8)0xFE;
      
      /* Clear the corresponding bit in the global wakeup bits variable */
      SUSD_ModuleWakeupBits &= ~((uint32)1u << i);
      
      /* Mark that at least one wakeup bit was reset */
      WakeupBitReset = TRUE;
    }
	}
	/* Execute permit execution only if at least one wakeup bit was reset */
	if (WakeupBitReset == TRUE)
	{
		/* Permit Execution interface to be invoked after wakeup validation */
		SUSD_SUM_PermitExecution();
	}

  /* SWCs. */
  WakeupBitReset = FALSE;
  /* Loop on all the SWC modules. */
  for (i = 0u; i < NO_OF_SWCS; i++)
  {
    if (((SUSD_SWCModuleWakeupBits & ((uint32)1u << i)) != 0u) && ((SUSD_GaaSWCWakeupMasks[i] & AnySimilarWakeup) == 0u))
    {
      /* Reset SWC wakeup bit. */
      SUSD_SWCModuleWakeupBits &= ~((uint32)1u << i);
      /* Mark that at least one wakeup bit was reset. */
      WakeupBitReset = TRUE;
    }
  }
  /* Execute permit execution only if at least one wakeup bit was reset */
  if (WakeupBitReset == TRUE)
  {
    SUSD_SWC_PermitExecution();
  }

  if((SUSD_ModuleWakeupBits == SUSD_ZERO) && (SUSD_SWCModuleWakeupBits == SUSD_ZERO)) 
  {
    NoActiveWakeup = ALL_WAKEUPS_DISABLED;
  }
}

/***********************************************************************************

  Function name :   SUSD_CheckSimilarWakeups
  Description   :   Function used to check if there active wakeups related to different
                    types of wakeup sources
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_CheckSimilarWakeups(void)
{
  uint32 i;

  AnySimilarWakeup = SUSD_ZERO;

  for (i = 0u; i < Luccount; i++)
  {
    switch (SUSD_GaaWakeUpSources[i])
    {
      case ECUM_WKSOURCE_POWER:
      case ECUM_WKSOURCE_RESET:
      case ECUM_WKSOURCE_INTERNAL_RESET:
      case ECUM_WKSOURCE_INTERNAL_WDG:
      case ECUM_WKSOURCE_EXTERNAL_WDG:
        AnySimilarWakeup |= SUSD_GLOBAL_WAKEUP_MASK;
        break;

      case ECUM_WKSOURCE_NETWORK_1_CAN:
      case ECUM_WKSOURCE_NETWORK_2_CAN:
        AnySimilarWakeup |= SUSD_CAN_WAKEUP_MASK;
        break;

      case ECUM_WKSOURCE_NETWORK_1_ETH:
      case ECUM_WKSOURCE_NETWORK_2_ETH:
        AnySimilarWakeup |= SUSD_ETH_WAKEUP_MASK;
        break;

      case ECUM_WKSOURCE_LIN:
        AnySimilarWakeup |= SUSD_LIN_WAKEUP_MASK;
        break;

      default:
        /* Ungrouped wakeup source. */
        AnySimilarWakeup |= SUSD_GaaWakeUpSources[i];
        break;
    }
  }
}


/***********************************************************************************
  Function name :   SUSD_DiagnosticReprogrammingRequest
  Description   :   Notification from BswM for Diagnostic Reprogramming request to support jump to
                    bootloader request received from diagnostic tester.
