        )
    {
      /* Read the backup vehicle power mode */
        «IF SUSD_IsE2EConfigured(sUSD.sUSDGeneral, "BackupPowerMode") || SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
