#elif((SUSD_VPM_ASIL_A_SUPPORT == STD_ON) || (SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity) || (SUSD_VPM_SECURITY_SUPPORT == With_OBD))
    static SUM_VehiclePowerMode_Signal_States LastSystemBackupPowerModeReceived = SUSD_VPM_SBPM_INITIAL;

# if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    boolean SystemBackupPowerModeFsI = FALSE;
# endif
