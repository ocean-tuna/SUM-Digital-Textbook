static FUNC(boolean, SUSD_CODE) SUSD_PrimaryPowerModeStrategy(void)
{
    boolean rv;
    SignalStatusType Signal_Availability = SUM_SSM_SIGNAL_STATUS_UNINITIALIZED;
#if (SUSD_SINGLEPORT_SUPPORTED == STD_OFF)
#if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    boolean Signal_FsFA = FALSE;
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
    boolean Signal_FcFA = FALSE;
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
    boolean Signal_FoFA = FALSE;
#endif
#else
    boolean Signal_FxFA = FALSE;
#endif

    «IF SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-» 
    /* Read the signal availability for primary vehicle power and backup vehicle power mode from SSM */
    (void) Rte_Read_RP_SUSD_SystemPowerMode_BackupPowerMode_Av_SignalAvailability(&Signal_Availability);
    «ELSE-»
    /* Read the signal availability for primary vehicle power mode from SSM */
    (void) Rte_Read_RP_SUSD_SystemPowerMode_Av_SignalAvailability(&Signal_Availability);
    «ENDIF-»

#if (SUSD_SINGLEPORT_SUPPORTED == STD_OFF)
#if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    /* Read System Power Mode Failed Safety Fault Active from SSM */
    «IF SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»
    (void) Rte_Read_RP_SUSD_SystemPowerMode_BackupPowerMode_FsFA_DTC_STATUS_FSFA(&Signal_FsFA);
    «ELSE-» 
    (void) Rte_Read_RP_SUSD_SystemPowerMode_FsFA_DTC_STATUS_FSFA(&Signal_FsFA);
    «ENDIF-»
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
    /* Read System Power Mode Failed Security Fault Active from SSM */
    «IF SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»
    (void) Rte_Read_RP_SUSD_SystemPowerMode_BackupPowerMode_FcFA_DTC_STATUS_FCFA(&Signal_FcFA);
    «ELSE-»
    (void) Rte_Read_RP_SUSD_SystemPowerMode_FcFA_DTC_STATUS_FCFA(&Signal_FcFA);
    «ENDIF-»
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
    /* Read System Power Mode Failed Continuous Operation Fault Active from SSM */
    «IF SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»
    (void) Rte_Read_RP_SUSD_SystemPowerMode_BackupPowerMode_FoFA_DTC_STATUS_FOFA(&Signal_FoFA);
    «ELSE-»
    (void) Rte_Read_RP_SUSD_SystemPowerMode_FoFA_DTC_STATUS_FOFA(&Signal_FoFA);
    «ENDIF-»
#endif
#else
    /* PRQA S 4404 EOF # enum is casted to bool,confirmed condition is checked */
    «IF SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»
    (void) Rte_Read_RP_SUSD_SystemPowerMode_BackupPowerMode_FxFA_DTC_STATUS_FXFA(&Signal_FxFA);
    «ELSE-»
    (void) Rte_Read_RP_SUSD_SystemPowerMode_FxFA_DTC_STATUS_FXFA(&Signal_FxFA);
    «ENDIF-»
#endif
    rv = (Signal_Availability == SUM_SSM_SIGNAL_STATUS_AVAILABLE);
#if (SUSD_SINGLEPORT_SUPPORTED == STD_OFF)
#if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    rv = ((rv == TRUE) && (Signal_FsFA == FALSE));
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
    rv = ((rv == TRUE) && (Signal_FcFA == FALSE));
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
    rv = ((rv == TRUE) && (Signal_FoFA == FALSE));
#endif
#else
    rv = ((rv == TRUE) && (Signal_FxFA == FALSE));
#endif
    return rv;
}

