        (void)Rte_Read_RP_Com_SUSD_PrimaryPowerMode_BackupPowerMode_PrimaryPowerMode_BackupPowerMode_RxSignal(&eventData);
          «ELSE-»
        (void)Rte_Read_RP_Com_SUSD_VeVSM_e_PrimaryPowerMode_VeVSM_e_PrimaryPowerModeRxSignal(&eventData);
          «ENDIF-»
        «ENDIF-»
        «IF SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
        SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.«SUSD_GetImplementationDataTypeElementName(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_PMM_Ref)»;
        «ELSEIF SUSD_IsPMMGroupSignal(sUSD.sUSDGeneral)-»
        SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.RxSignal_«sUSD.sUSDGeneral.sum_SUSD_Sig_PrimaryPowerMode_Ref.shortName»;
        «ELSE-»
        SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData;
        «ENDIF-»
        LastSystemPowerModeReceived = SUSD_VehiclePowerMode;
    }
    else
    {
        SUSD_VehiclePowerMode = LastSystemPowerModeReceived;
    }
#else
    /* Read the vehicle power mode */
      «IF SUSD_IsE2EConfigured(sUSD.sUSDGeneral, "PrimaryPowerMode") || SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
        «IF SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»
      (void)Rte_Read_RP_Com_SUSD_PrimaryPowerMode_BackupPowerMode_PrimaryPowerMode_BackupPowerMode_RxSignal(&eventData, &rteTransformerError);
        «ELSE-»
      (void)Rte_Read_RP_Com_SUSD_VeVSM_e_PrimaryPowerMode_VeVSM_e_PrimaryPowerModeRxSignal(&eventData, &rteTransformerError);
        «ENDIF-»
      «ELSE-»
        «IF SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-»
      (void)Rte_Read_RP_Com_SUSD_PrimaryPowerMode_BackupPowerMode_PrimaryPowerMode_BackupPowerMode_RxSignal(&eventData);
        «ELSE-»
      (void)Rte_Read_RP_Com_SUSD_VeVSM_e_PrimaryPowerMode_VeVSM_e_PrimaryPowerModeRxSignal(&eventData);
        «ENDIF-»
      «ENDIF-»
      «IF SUSD_IsPMMServiceBased(sUSD.sUSDGeneral)-»
      SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.«SUSD_GetImplementationDataTypeElementName(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_PMM_Ref)»;
      «ELSEIF SUSD_IsPMMGroupSignal(sUSD.sUSDGeneral)-»
      SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.RxSignal_«sUSD.sUSDGeneral.sum_SUSD_Sig_PrimaryPowerMode_Ref.shortName»;
      «ELSE-»
      SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData;
      «ENDIF-»
#endif

    SUSD_VehiclePowerModeInv = FALSE;
}
