static VAR(uint32, RTE_CODE) AnySimilarWakeup;

/* Global SUM module wakeup masks array - maps SUM enum to wakeup mask */
/* This array defines which wakeup sources are relevant for each SUM module */
static const uint32 SUSD_GaaSUMWakeupMasks[SUSD_SUM_PERMEXE] = {
  «LET 1 AS int-»                                                                                                                                             
  «FOREACH sUSD.sUSDConfigSet.sUSD_C_SUMsInfo AS sum -»
    «IF sum.sUSD_PermitExecution == true-»
      SUSD_WAKEUP_MASK_«sum.sUSD_SUMsName-»
      «FOREACH sum.sUSD_SUMs_SpecificWkSrcId AS wkSrc-»
        «REM» For bit 31 (0x80000000), xpt produces a 64-bit value, so managed manually. «ENDREM-»
        «IF int.shiftLeftOperand(wkSrc.ecuMWakeupSourceId).Hex() != "0xFFFFFFFF80000000"»
          | «int.shiftLeftOperand(wkSrc.ecuMWakeupSourceId).Hex() -»u
        «ELSE»
          | 0x80000000u
        «ENDIF -»
      «ENDFOREACH»,
    «ENDIF-»
  «ENDFOREACH-»
  «ENDLET-»
};

/* Global SWC wakeup masks array - maps SWC index to wakeup mask. */
/* This array defines which wakeup sources are relevant for each SWC. */
static const uint32 SUSD_GaaSWCWakeupMasks[NO_OF_SWCS] = {
  «LET 1 AS int-»
  «FOREACH sUSD.sUSDConfigSet.sUSD_C_SWCInfo AS swc -»
    «REM» Same base mask for each SWC. «ENDREM-»
    SUSD_WAKEUP_MASK_SWC
    «FOREACH swc.sUSD_SWCs_SpecificWkSrcId AS wkSrc-»
      «REM» For bit 31 (0x80000000), xpt produces a 64-bit value, so managed manually. «ENDREM-»
      «IF int.shiftLeftOperand(wkSrc.ecuMWakeupSourceId).Hex() != "0xFFFFFFFF80000000"»
        | «int.shiftLeftOperand(wkSrc.ecuMWakeupSourceId).Hex() -»u
      «ELSE»
        | 0x80000000u
      «ENDIF -»
    «ENDFOREACH»,
  «ENDFOREACH-»
  «ENDLET-»
};

