{

«IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SOH") && 
  sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SOH").first().sUSD_PermitExecution == true-»
  /* Set bit 4 if ECU reset is requested */
  SUSD_GaaSUMPermitExecution[SUM_SOH] = (SUSD_GaaSUMPermitExecution[SUM_SOH] | (uint8)0x40);
  /* Rte API to indicate the Permit Execution to SUM_SOH with the bit information */
  SUSD_GaaSUM_PermitExec_Interface[SUM_SOH](SUSD_GaaSUMPermitExecution[SUM_SOH]);
