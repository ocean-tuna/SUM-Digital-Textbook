static FUNC(boolean, SUSD_CODE) SUSD_PowerModeBackupStrategy1(void)
{
    boolean rv;
    SignalStatusType Signal_Availability = SUM_SSM_SIGNAL_STATUS_UNINITIALIZED;
#if (SUSD_SINGLEPORT_SUPPORTED == STD_OFF)
#if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    boolean Signal_FsFA = FALSE;
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
    boolean Signal_FcFA = FALSE;
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
    boolean Signal_FoFA = FALSE;
#endif
#else
    boolean Signal_FxFA = FALSE;
#endif

  /* Read the signal availability for back up vehicle power mode from SSM */
    (void) Rte_Read_RP_SUSD_SystemBackupPowerMode_Av_SignalAvailability(&Signal_Availability);



#if (SUSD_SINGLEPORT_SUPPORTED == STD_OFF)
#if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    /* Read System Power Mode Failed Safety Fault Active from SSM */
    (void) Rte_Read_RP_SUSD_SystemBackupPowerMode_FsFA_DTC_STATUS_FSFA(&Signal_FsFA);
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
    /* Read System Power Mode Failed Security Fault Active from SSM */
    (void) Rte_Read_RP_SUSD_SystemBackupPowerMode_FcFA_DTC_STATUS_FCFA(&Signal_FcFA);
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
    /* Read System Power Mode Failed Continuous Operation Fault Active from SSM */
    (void) Rte_Read_RP_SUSD_SystemBackupPowerMode_FoFA_DTC_STATUS_FOFA(&Signal_FoFA);
#endif
#else
        /* Read System Power Mode Failed Single Port Fault Active from SSFM */
        (void) Rte_Read_RP_SUSD_SystemBackupPowerMode_FxFA_DTC_STATUS_FXFA(&Signal_FxFA);

#endif
    rv = (Signal_Availability == SUM_SSM_SIGNAL_STATUS_AVAILABLE);
#if (SUSD_SINGLEPORT_SUPPORTED == STD_OFF)
#if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    rv = ((rv == TRUE) && (Signal_FsFA == FALSE));
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
    rv = ((rv == TRUE) && (Signal_FcFA == FALSE));
#endif
#if(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
    rv = ((rv == TRUE) && (Signal_FoFA == FALSE));
#endif
#else
    rv = ((rv == TRUE) && (Signal_FxFA == FALSE));
#endif
    return rv;
}

static FUNC(void, SUSD_CODE) SUSD_SetSystemBackupPowerMode(void)
{
  «IF SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
    «SUSD_GetImplementationDataTypeName(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_BPMM_Ref)» eventData;
  «ELSEIF SUSD_IsBPMMGroupSignal(sUSD.sUSDGeneral)-»
