  SUSD_GaaSUMPermitExecution[SUM_LNM] = (SUSD_GaaSUMPermitExecution[SUM_LNM] | (uint8)0x40);
  /* Rte API to indicate the Permit Execution to SUM_LNM with the bit information */
  SUSD_GaaSUM_PermitExec_Interface[SUM_LNM](SUSD_GaaSUMPermitExecution[SUM_LNM]);
«ENDIF»
«IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_PNC") && 
  sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_PNC").first().sUSD_PermitExecution == true-»
  SUSD_GaaSUMPermitExecution[SUM_PNC] = (SUSD_GaaSUMPermitExecution[SUM_PNC] | (uint8)0x40);
  /* Rte API to indicate the Permit Execution to SUM_PNC with the bit information */
  SUSD_GaaSUM_PermitExec_Interface[SUM_PNC](SUSD_GaaSUMPermitExecution[SUM_PNC]);
«ENDIF»
«IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SSFM_SSM") && 
  sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SSFM_SSM").first().sUSD_PermitExecution == true-»
  SUSD_GaaSUMPermitExecution[SUM_SSFM_SSM] = (SUSD_GaaSUMPermitExecution[SUM_SSFM_SSM] | (uint8)0x40);
  /* Rte API to indicate the Permit Execution to SUM_SSFM_SSM with the bit information */
  SUSD_GaaSUM_PermitExec_Interface[SUM_SSFM_SSM](SUSD_GaaSUMPermitExecution[SUM_SSFM_SSM]);
«ENDIF»
«IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SSC") && 
  sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SSC").first().sUSD_PermitExecution == true-»
  SUSD_GaaSUMPermitExecution[SUM_SSC] = (SUSD_GaaSUMPermitExecution[SUM_SSC] | (uint8)0x40);
  /* Rte API to indicate the Permit Execution to SUM_SSC with the bit information */
  SUSD_GaaSUM_PermitExec_Interface[SUM_SSC](SUSD_GaaSUMPermitExecution[SUM_SSC]);
«ENDIF»
«IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SRVMGR") && 
  sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SRVMGR").first().sUSD_PermitExecution == true-»
  SUSD_GaaSUMPermitExecution[SUM_SRVMGR] = (SUSD_GaaSUMPermitExecution[SUM_SRVMGR] | (uint8)0x40);
  /* Rte API to indicate the Permit Execution to SUM_SRVMGR with the bit information */
  SUSD_GaaSUM_PermitExec_Interface[SUM_SRVMGR](SUSD_GaaSUMPermitExecution[SUM_SRVMGR]);
«ENDIF»
«IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_TCS") && 
  sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_TCS").first().sUSD_PermitExecution == true-»
  SUSD_GaaSUMPermitExecution[SUM_TCS] = (SUSD_GaaSUMPermitExecution[SUM_TCS] | (uint8)0x40);
  SUSD_GaaSUM_PermitExec_Interface[SUM_TCS](SUSD_GaaSUMPermitExecution[SUM_TCS]);
«ENDIF»
«IF sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.sUSD_SUMsName.contains("SUM_SPM") && 
  sUSD.sUSDConfigSet.sUSD_C_SUMsInfo.select(e| e.sUSD_SUMsName == "SUM_SPM").first().sUSD_PermitExecution == true-»
  SUSD_GaaSUMPermitExecution[SUM_SPM] = (SUSD_GaaSUMPermitExecution[SUM_SPM] | (uint8)0x40);
  /* Rte API to indicate the Permit Execution to SUM_SPM with the bit information */
  SUSD_GaaSUM_PermitExec_Interface[SUM_SPM](SUSD_GaaSUMPermitExecution[SUM_SPM]);
«ENDIF»
}

/*******************************************************************************
  Function name :   SUSD_SWC_PermitExecution
  Description   :   Function to handle the Permit Execution interface from SW-C
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
*******************************************************************************/
/* PRQA S 1532 1 # This function will be called only from anoother file in case of EXISTS_SWC is ON. */
FUNC(void, SUSD_CODE) SUSD_SWC_PermitExecution(void)
{
«IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
  /* Rte interfaces */
  P2CONST(SUSD_SWCRteInterfaces, AUTOMATIC,AUTOMATIC) LpRteInterface;
  /* varaible to loop number of SW-Cs */
  uint32 i;

  LpRteInterface = &SUSD_GaaRteSWCInterface[SUSD_ZERO];
  for(i = SUSD_ZERO; i < NO_OF_SWCS; i++)
  {
    /* The SWC*/
    if ((SUSD_SWCModuleWakeupBits & ((uint32)1u << i)) != SUSD_ZERO)
    {
      /* Wakeup has been received: set bit 1. */
      SUSD_GaaSWCPermitExecution[i] |= (uint8)0x01;
    }
    else
    {
      /* Wakeup has been reset: reset bit to 0. */
      SUSD_GaaSWCPermitExecution[i] &= (uint8)0xFE;
    }

    if(TRUE == SUSD_GblSWCHwAvailable)
    {
      /* Hw is ready -  Set bit 2 */
      SUSD_GaaSWCPermitExecution[i] = (SUSD_GaaSWCPermitExecution[i] | (uint8)0x04);
    }

    «IF (sUSD.sUSDGeneral.sUSD_PowerModing_Slave_Supported)-»
    if(SUM_PMS_OFF == SUSD_VehiclePowerMode)
    {
      SUSD_GaaSWCPermitExecution[i] = (SUSD_GaaSWCPermitExecution[i] & ((uint8)0xF7));
    }
    else
    {
      SUSD_GaaSWCPermitExecution[i] = (SUSD_GaaSWCPermitExecution[i] | (uint8)0x08);
    }
    «ENDIF-»

    /* If Diagnostic Reprogramming request or Reset Request or SOH Reset Request */
    if((SUM_REPREQ_ACTIVE == SUSD_GblDiagReprgRequest) || (SUM_RESREQ_ACTIVE == SUSD_GblDiagResetRequest))
    {
      /*If a reset request occurred*/
      if(SUM_RESREQ_ACTIVE == SUSD_GblDiagResetRequest)
      {
        /*Set the shutdown target bit and reset all the other bits including the reset bit*/
        /* Satisfies: [$SDD_SUSD 168] */
        /* Satisfies: [$SDD_SUSD 038] */
        SUSD_GaaSWCPermitExecution[i] = NOT_OFF;
      }
      else
      {
        /*Reset all the bits including the reset bit*/
        /* Satisfies: [$SDD_SUSD 168] */
        /* Satisfies: [$SDD_SUSD 038] */
        SUSD_GaaSWCPermitExecution[i] = SUSD_ZERO;
      }
    }
    else
    {
      SUSD_GaaSWCPermitExecution[i] = (SUSD_GaaSWCPermitExecution[i] | (uint8)0x40);
    }

  «IF (sUSD.sUSDGeneral.sUSD_PermitExecAvailable == true)-»
  /* Rte Interface API to indicate the SW-C about the wakeup */
  (LpRteInterface[i].SWCPermitExecutionInterface)(SUSD_GaaSWCPermitExecution[i]);
  «ENDIF-»
  }
}
«ENDIF-»


/***********************************************************************************

  Function name :   SUSD_SWC_VehicleBatteryVoltage
  Description   :   Function to handle Battery Voltage Monitoring
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/*Satisfies: [$SDD_SUSD 138]*/
/* PRQA S 1532 1 # This Function can be used in the multiple file and can not be turned into static as well as moved to static code */
FUNC(void, SUSD_CODE) SUSD_SWC_VehicleBatteryVoltage(void)
{
  /* Battery Voltage Threshold */
  P2CONST(SUSD_BatteryVoltageRangeType, AUTOMATIC,AUTOMATIC) LpVoltThreshold;

  /* Variable to loop through the number of ranges configured for Battery Voltage */
  uint32 LulCount;
  /* Variable to store maximum voltage range */
  Impl_SUSD_C_VoltageHysteresis LulMaxVolRange;
  /* Variable to store minimum voltage range */
  Impl_SUSD_C_VoltageHysteresis LulMinVolRange;
  /*Variable used to store the Vehicle Battery Voltage current state */
  uint16 curState;

  LpVoltThreshold = &SUSD_BatteryVoltageThreshold[SUSD_ZERO];

  /* Read the Battery Voltage value from SW-C in volts */
  (void)Rte_Read_RP_SUSD_VehicleBatteryVoltage_VehicleVoltage(&SUSD_GucVehicleBattVoltage);

  /* loop through all Ranges */
  for (LulCount = SUSD_ZERO; LulCount < NO_OF_VOLTRANGE; LulCount++)
  {
    /* Read Maximum voltage with hysteresis */
    LulMaxVolRange = (LpVoltThreshold[LulCount].SWC_OverVoltageHysteresis() + LpVoltThreshold[LulCount].BatteryVoltageMax);

    /* Read Minimum voltage with hysteresis */
    LulMinVolRange = (LpVoltThreshold[LulCount].BatteryVoltageMin - (LpVoltThreshold[LulCount].SWC_UnderVoltageHysteresis()));

    curState = SUSD_GucBatteryVoltageStatus[LulCount];
    switch (curState){
    	case SUSD_OUT_OF_RANGE_HIGH:
    		SUSD_CheckVehicleBatteryVoltageState(LulMaxVolRange, LulMinVolRange, SUSD_GucVehicleBattVoltage, &curState, SUSD_IN_RANGE);
    		SUSD_CheckVehicleBatteryVoltageState(LulMaxVolRange, LulMinVolRange, SUSD_GucVehicleBattVoltage, &curState, SUSD_OUT_OF_RANGE_LOW);
    	break;
    	case SUSD_OUT_OF_RANGE_LOW:
    		SUSD_CheckVehicleBatteryVoltageState(LulMaxVolRange, LulMinVolRange, SUSD_GucVehicleBattVoltage, &curState, SUSD_IN_RANGE);
    		SUSD_CheckVehicleBatteryVoltageState(LulMaxVolRange, LulMinVolRange, SUSD_GucVehicleBattVoltage, &curState, SUSD_OUT_OF_RANGE_HIGH);
    	break;
    	default:
    		SUSD_CheckVehicleBatteryVoltageState(LulMaxVolRange, LulMinVolRange, SUSD_GucVehicleBattVoltage, &curState, SUSD_OUT_OF_RANGE_HIGH);
    		SUSD_CheckVehicleBatteryVoltageState(LulMaxVolRange, LulMinVolRange, SUSD_GucVehicleBattVoltage, &curState, SUSD_OUT_OF_RANGE_LOW);
    	break;
    }
    SUSD_GucBatteryVoltageStatus[LulCount] = curState;
  }

  SUSD_SWC_VehicleBatteryVoltageAllSWC();
}

/***********************************************************************************

  Function name :   SUSD_SWC_VehicleBatteryVoltageAllSWC
  Description   :   Function to check for all SW-Cs configured for battery voltage
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 015] [$SDD_SUSD 142]*/
static FUNC(void, SUSD_CODE) SUSD_SWC_VehicleBatteryVoltageAllSWC(void)
{
  BattVltgSnsrStsEnum LucBattVltgSnsrSts = Battery_Voltage_Uninitialized;
  
  /* Battery Voltage Threshold */
  P2CONST(SUSD_BatteryVoltageRangeType, AUTOMATIC,AUTOMATIC) LpVoltThreshold;
  /* Variable to loop through the number of ranges configured for Battery Voltage */
  uint32 LulCount;

  /* Variable to loop through the number of SWCs which refer to a Battery Voltage */
  «IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
  uint32 LulCount1;
  «ENDIF-»

  /* point to structure containing Rte interfaces */
  LpVoltThreshold = &SUSD_BatteryVoltageThreshold[SUSD_ZERO];


  /* Indicate actual Voltage */
  /* [$Satisfies $SDD_SUSD 248] */
  (void)Rte_Write_PP_SUSD_BatteryVoltage_Actual_ActualVoltage(SUSD_GucVehicleBattVoltage);

  /* Check for all SW-Cs configured for battery voltage */
  for(LulCount =  SUSD_ZERO; LulCount < NO_OF_VOLTRANGE; LulCount++)
  {
    /* Indicate Over, Under and normal Voltage */
    (*(LpVoltThreshold[LulCount].SWCBattVolt_Range_MintoMax))((uint8)SUSD_GucBatteryVoltageStatus[LulCount]);

    «IF (sUSD.sUSDConfigSet.sUSD_C_SWCInfo.size > 0)-»
    /* battery voltage bit in Permit Execution to indicate that the inappropriate Battery voltage
             level/s relevant to this SW-C is active */
	/* Check if Reprogramming or Reset Request is active do not update PermitExecution  */		 
    if(((LpVoltThreshold[LulCount].SWCRangeMapping) != NULL_PTR) &&((SUM_REPREQ_INACTIVE == SUSD_GblDiagReprgRequest) && (SUM_RESREQ_INACTIVE == SUSD_GblDiagResetRequest)))
    {
      if(SUSD_GucBatteryVoltageStatus[LulCount] == (uint16)SUSD_IN_RANGE)
      {
          /* Set bit 5 in permit execution to indicate appropriate Battery voltage level/s relevant to this SW-C is active */
    	  for(LulCount1 = SUSD_ZERO; LulCount1 < LpVoltThreshold[LulCount].NumberOfSWCs; LulCount1++)
    	  {
    	       uint16 Swc_index = LpVoltThreshold[LulCount].SWCRangeMapping[LulCount1].SWC_Index;
    		   SUSD_GaaSWCPermitExecution[Swc_index] = (SUSD_GaaSWCPermitExecution[Swc_index] | ((SUSD_SWC_ExecutionStatusType)0x20));
    		   /* Rte Interface API to indicate the SW-C about the battery voltage */
    		   (LpVoltThreshold[LulCount].SWCRangeMapping[LulCount1].SWCPermitExecutionInterface)(SUSD_GaaSWCPermitExecution[Swc_index]);
    	  }
      }
      else
      {
        /* Clear bit 5 in permit execution to indicate appropriate Battery voltage level/s relevant to this SW-C is not active */
		for(LulCount1 = SUSD_ZERO; LulCount1 < LpVoltThreshold[LulCount].NumberOfSWCs; LulCount1++)
		{
		   uint16 Swc_index = LpVoltThreshold[LulCount].SWCRangeMapping[LulCount1].SWC_Index;
		   SUSD_GaaSWCPermitExecution[Swc_index] = (SUSD_GaaSWCPermitExecution[Swc_index] & ((SUSD_SWC_ExecutionStatusType)0xDF));
		   /* Rte Interface API to indicate the SW-C about the battery voltage */
		   (LpVoltThreshold[LulCount].SWCRangeMapping[LulCount1].SWCPermitExecutionInterface)(SUSD_GaaSWCPermitExecution[Swc_index]);
		}
      }
    }
    «ENDIF-»
  }
  /* check Disable NvM functionalities */
  /*Satisfies: [$SDD_SUSD 246]*/
  /* Read Battery Voltage Sensor Status */
  (void)Rte_Read_RP_SUSD_BattVltgSnsrStsAvl_BattVltgSnsrStsEnum(&LucBattVltgSnsrSts);
  /*Satisfies: [$SDD_SUSD 247]*/
  /* PRQA S 1891 1 # voltage is multiplied by 10 to check conditions*/
  if(((Rte_CData_SUSD_PDP_SUSD_C_DisableNVMWrite_Voltage()*10u) <= SUSD_GucVehicleBattVoltage)
      && (LucBattVltgSnsrSts == Battery_Voltage_Available))
  {
    /* voltage level OK and sensor status available: write NVM allowed */
    /* [$Satisfies $SDD_SUSD 248] */
    (void)Rte_Write_PP_SUSD_BatteryVoltage_DisableNVMWrite_DisableWriteData(0u);
  }
  else
  {
    /* voltage level too low or sensor not available: do not write NVM */
    /* [$Satisfies $SDD_SUSD 248] */
    (void)Rte_Write_PP_SUSD_BatteryVoltage_DisableNVMWrite_DisableWriteData(1u);
  }
}

#if(SUSD_VEHICLE_BATTERY_STATE_OF_CHARGE_SUPPORTED == STD_ON)
/***********************************************************************************

  Function name :   SUSD_BswM_VehicleBatteryStateOfCharge
  Description   :   Function to check the vehicle battery state of charge and send the mode request to BswM
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* PRQA S 1532 1 # This Function can be used in the multiple file and can not be turned into static as well as moved to static code */
FUNC(void, SUSD_CODE) SUSD_BswM_VehicleBatteryStateOfCharge(void)
{
	/* Satisfies: [$SDD_SUSD 167]*/
	BatteryStateOfChargeType BatteryCharge;
	(void)Rte_Read_RP_SUSD_BatteryStateOfCharge_BatteryStateOfCharge(&BatteryCharge);
	if(BatteryCharge==SOC_LOW)
	{
       (void)Rte_Switch_PP_SUSD_BatteryCharge_DisableWkups_BatteryChargeDisableWkups(SUSD_BSWM_DISABLE_WAKEUPS);
	}
	else
	{
	   (void)Rte_Switch_PP_SUSD_BatteryCharge_DisableWkups_BatteryChargeDisableWkups(SUSD_BSWM_ENABLE_WAKEUPS);
	}

}
#endif

/***********************************************************************************

  Function name :   SUSD_HardwareReady
  Description   :   Function to be filled by integrator when there is Hardware ready and initialized
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* PRQA S 1503 1 # When the SUSD is integrated, this runnable will be called */
FUNC(void, SUSD_CODE) SUSD_HardwareReady(void)
{
  /* To be set to true when the hardware related to PN is ready */
  SUSD_GblPnHwAvailable = TRUE;
  /* To be set to true when the hardware related to LIN is ready */
  SUSD_GblLinHwAvailable = TRUE;
  /* To be set to true when the hardware required by SW-C is ready */
  SUSD_GblSWCHwAvailable = TRUE;

  /*Update also the Permit Execution Logic*/
  SUSD_SUM_PermitExecution();
  SUSD_SWC_PermitExecution();

}

