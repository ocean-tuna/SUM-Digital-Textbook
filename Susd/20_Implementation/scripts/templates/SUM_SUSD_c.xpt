/***********************************************************************************

  Function name :   SUSD_ECUWakeupDetectionRecordsUpdate
  Description   :   Function to handle ECU Wakeup Detection Records Update
  Parameter in  :   Wakeup Detection Record
  Parameter out :   None
  Return value  :   None
  Remarks       :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 162] [$SDD_SUSD 163] [$SDD_SUSD 164] [$SDD_SUSD 165]*/
static FUNC(void, SUSD_CODE) SUSD_ECUWakeupDetectionRecordsUpdate(const SUSD_ECUWakeupDetectionRecord *Data)
{
    /* Variable to iterate on ECU Wakeup Detection Records */
    uint32  ECUWakeupDetRec;
    /* Count of ECU Wakeup Detection Records */
    uint32 ECUWakeupDetRecCount = SUSD_NO_OF_WAKEUPDETRECS-1u;

    /*Find the currently stored count of ECU Wakeup Detection Records*/
    for(ECUWakeupDetRec = SUSD_ZERO; ECUWakeupDetRec < SUSD_NO_OF_WAKEUPDETRECS; ECUWakeupDetRec++)
    {
        if(    (SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[0] == 0u)
            && (SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[1] == 0u)
            && (SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[2] == 0u)
            && (SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[3] == 0u))
        {
            ECUWakeupDetRecCount = ECUWakeupDetRec;
            break;
        }
    }

    /* When the next source is captured record 1 will move to record 2 and so on.
     * When the 11th record is captured the last record 10 will be pushed out.*/
    for(ECUWakeupDetRec = ECUWakeupDetRecCount; ECUWakeupDetRec > 0u; ECUWakeupDetRec--)
    {
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[0] = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].ECUWakeupDetectionRecordId[0];
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[1] = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].ECUWakeupDetectionRecordId[1];
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[2] = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].ECUWakeupDetectionRecordId[2];
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].ECUWakeupDetectionRecordId[3] = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].ECUWakeupDetectionRecordId[3];

        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].TimeStampOfOccurence[0]    = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].TimeStampOfOccurence[0];
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].TimeStampOfOccurence[1]    = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].TimeStampOfOccurence[1];
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].TimeStampOfOccurence[2]    = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].TimeStampOfOccurence[2];
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].TimeStampOfOccurence[3]    = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].TimeStampOfOccurence[3];
        SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec].TimeStampOfOccurence[4]    = SUSD_ECUWakeupDetectionRecordsArray[ECUWakeupDetRec-1u].TimeStampOfOccurence[4];
    }

    /* Each time the ECU awakens the SUM_SUSD will capture the source of the wake up and
     * store the wakeups in a first in first out order starting with record 1. */
    SUSD_ECUWakeupDetectionRecordsArray[0].ECUWakeupDetectionRecordId[0] = Data->ECUWakeupDetectionRecordId[0];
    SUSD_ECUWakeupDetectionRecordsArray[0].ECUWakeupDetectionRecordId[1] = Data->ECUWakeupDetectionRecordId[1];
    SUSD_ECUWakeupDetectionRecordsArray[0].ECUWakeupDetectionRecordId[2] = Data->ECUWakeupDetectionRecordId[2];
    SUSD_ECUWakeupDetectionRecordsArray[0].ECUWakeupDetectionRecordId[3] = Data->ECUWakeupDetectionRecordId[3];

    SUSD_ECUWakeupDetectionRecordsArray[0].TimeStampOfOccurence[0]    = Data->TimeStampOfOccurence[0];
    SUSD_ECUWakeupDetectionRecordsArray[0].TimeStampOfOccurence[1]    = Data->TimeStampOfOccurence[1];
    SUSD_ECUWakeupDetectionRecordsArray[0].TimeStampOfOccurence[2]    = Data->TimeStampOfOccurence[2];
    SUSD_ECUWakeupDetectionRecordsArray[0].TimeStampOfOccurence[3]    = Data->TimeStampOfOccurence[3];
    SUSD_ECUWakeupDetectionRecordsArray[0].TimeStampOfOccurence[4]    = Data->TimeStampOfOccurence[4];

    /*Update the ECU Wakeup Detection Records NVM Block*/
    /* [$Satisfies $SDD_SUSD 250] */
    Susd_NvmWriteBlock(&susd_NVMECUWakeUpDetectionRecordsBlock_FP, &Susd_LastRequestResult_ECUWakeUpDetectionRecords);
}

