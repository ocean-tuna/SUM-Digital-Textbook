    if (
# if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
        (SystemBackupPowerModeFsI == FALSE)
# endif
# if((SUSD_VPM_ASIL_A_SUPPORT == STD_ON) && (SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity) || (SUSD_VPM_ASIL_A_SUPPORT == STD_ON) && (SUSD_VPM_SECURITY_SUPPORT == With_OBD))
        &&
# endif
# if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
        (SystemBackupPowerModeFcI == FALSE)
# elif(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
        (SystemBackupPowerModeFoI == FALSE)
