# endif

# if(SUSD_VPM_ASIL_A_SUPPORT == STD_ON)
    /*Read System Backup Power Mode Failed Safety Indication from SSM */
    (void) Rte_Read_RP_SUSD_SystemBackupPowerMode_FsI_FsI_Safety(&SystemBackupPowerModeFsI);
# endif
# if(SUSD_VPM_SECURITY_SUPPORT == With_Cybersecurity)
    /*Read System Backup Power Mode Failed Security Indication from SSM */
        (void) Rte_Read_RP_SUSD_SystemBackupPowerMode_FcI_FcI_Security(&SystemBackupPowerModeFcI);

# endif
# if(SUSD_VPM_SECURITY_SUPPORT == With_OBD)
