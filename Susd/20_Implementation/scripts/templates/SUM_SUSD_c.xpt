        SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.«SUSD_GetImplementationDataTypeElementName(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_BPMM_Ref)»;
        «ELSEIF SUSD_IsBPMMGroupSignal(sUSD.sUSDGeneral)-»
        SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.RxSignal_«sUSD.sUSDGeneral.sum_SUSD_Sig_BackupPowerMode_Ref.shortName»;
        «ELSE-»
        SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData;
        «ENDIF-»
        LastSystemBackupPowerModeReceived = SUSD_VehiclePowerMode;
    }
    else
    {
        SUSD_VehiclePowerMode = LastSystemBackupPowerModeReceived;
    }
#else
  /* Read the backup vehicle power mode */
    «IF SUSD_IsE2EConfigured(sUSD.sUSDGeneral, "BackupPowerMode") || SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
    (void)Rte_Read_RP_Com_SUSD_VeVSM_e_BackupPowerMode_VeVSM_e_BackupPowerModeRxSignal(&eventData, &rteTransformerError);
    «ELSE-»
    (void)Rte_Read_RP_Com_SUSD_VeVSM_e_BackupPowerMode_VeVSM_e_BackupPowerModeRxSignal(&eventData);
    «ENDIF-»
    «IF SUSD_IsBPMMServiceBased(sUSD.sUSDGeneral)-»
    SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.«SUSD_GetImplementationDataTypeElementName(sUSD.sUSDGeneral.sum_SUSD_ServiceBased_BPMM_Ref)»;
    «ELSEIF SUSD_IsBPMMGroupSignal(sUSD.sUSDGeneral)-»
    SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData.RxSignal_«sUSD.sUSDGeneral.sum_SUSD_Sig_BackupPowerMode_Ref.shortName»;
    «ELSE-»
    SUSD_VehiclePowerMode = (SUM_VehiclePowerMode_Signal_States)eventData;
    «ENDIF-»
#endif
    SUSD_VehiclePowerModeInv = FALSE;
}
«ENDIF-»
«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported)-»
static FUNC(void, SUSD_CODE) SUSD_SetRunCrankPowerMode(void)
{
    /* Power Mode Backup Strategy 2
     * Vehicle power mode based on Run Crank */
    if (SUSD_RunCrankActiveInv == FALSE)
    {
        /* RunCrankActive is valid */
        if (SUSD_RunCrankActive == TRUE)
        {
            SUSD_VehiclePowerMode = SUM_PMS_PROPULSION;
        }
        else
        {
            SUSD_VehiclePowerMode = SUM_PMS_OFF;
        }
        SUSD_VehiclePowerModeInv = FALSE;
    }
}
«ENDIF-»

/***********************************************************************************

  Function name :   SUSD_ClearRunningResetEvent
  Description   :   Function to update the PMS_Confirmed, WakeupAfterReset and TimerExpired flags after running reset occurs
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_ClearRunningResetEvent(void)
{
    WakeupAfterReset = FALSE;
    TimerExpired = FALSE;
}
/***********************************************************************************

  Function name :   SUSD_PowerModeStrategyHandler
  Description   :   Function to handle Power Mode Strategy functionality
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_PowerModeStrategyHandler(void)
{
      «IF !SUSD_IsSameSignalReference(sUSD.sUSDGeneral)-» 
    if (SUSD_PowerModeBackupStrategy1() == TRUE)
    {
        SUSD_SetSystemBackupPowerMode();
        SUSD_ClearRunningResetEvent();
    }
    «ENDIF-»

    if (SUSD_PrimaryPowerModeStrategy() == TRUE)
    {
        SUSD_SetSystemPowerMode();
        SUSD_ClearRunningResetEvent();
    }  

}

/***********************************************************************************

  Function name :   SUSD_VehiclePowerModeHandler
  Description   :   Function to handle Vehicle Power Mode functionality
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_VehiclePowerModeHandler(void)
{
    /* Always process all signals to save previously received signal values */  
«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported)-»
    SUSD_SetRunCrankPowerMode();
«ENDIF-»

    SUSD_PowerModeStrategyHandler();
}

/***********************************************************************************

  Function name :   SUSD_VehiclePowerMode
  Description   :   Function to handle Power Mode Slave functionality
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 106] [$SDD_SUSD 107] [$SDD_SUSD 108] [$SDD_SUSD 109] [$SDD_SUSD 149] [$SDD_SUSD 175]*/
/* PRQA S 1532 1 # This Function can be used in the multiple file and can not be turned into static as well as moved to static code */
FUNC(void, SUSD_CODE) SUSD_VehiclePowerModeDetermination(void)
{
    /* Store the current VPM before determining the new one */
    SUM_VehiclePowerMode_Signal_States LastDeterminedVPM = SUSD_VehiclePowerMode;
    /* Set VPM invalidity to TRUE. If a valid VPM is determined by the functions
     * below, they will take care to set its invalidity to FALSE. */
    SUSD_VehiclePowerModeInv = TRUE;
    /* Check wakeup flag after running reset occurs */
    if (WakeupAfterReset == TRUE)
    {
      if (TimerExpired == TRUE)
      {
«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported)-»
        SUSD_SetRunCrankPowerMode();
«ENDIF-»
        SUSD_ClearRunningResetEvent();
      }
      else
      {
          SUSD_PowerModeStrategyHandler();
      }
    }
    else
    {
      SUSD_VehiclePowerModeHandler();
    }

    /* If the VPM has changed, save it to NvM */
    if (LastDeterminedVPM != SUSD_VehiclePowerMode)
    {
        /* save Vehicle Power Mode State */
    	/* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
        *Rte_Pim_VehiclePowerMode_State() = SUSD_VehiclePowerMode;
        /* Set RAM Block status changed */
        /* [$Satisfies $SDD_SUSD 250] */
        (void) Rte_Call_RP_NvMService_VehPowerMode_SetRamBlockStatus(TRUE);
        /* request NvM to store Vehicle Power Mode State in Non-Volatile Memory */
        /* [$Satisfies $SDD_SUSD 250] */
        (void) Rte_Call_RP_NvMService_VehPowerMode_WriteBlock(&SUSD_VehiclePowerMode);
        /* save the latest Vehicle Power Mode value */
        LastDeterminedVPM = SUSD_VehiclePowerMode;
    }

    /* Indicate Vehicle Power Mode to SWCs */
    /* [$Satisfies $SDD_SUSD 248] */
    (void) Rte_Write_PP_SUSD_VehiclePowerMode_VehiclePowerMode(LastDeterminedVPM);
    /* Indicate Vehicle Power Mode Invalidity to SWCs */
    /* [$Satisfies $SDD_SUSD 248] */
    (void) Rte_Write_PP_SUSD_VehiclePowerMode_Inv_VehiclePowerMode_Inv(SUSD_VehiclePowerModeInv);
}
«ENDIF-»

«IF (sUSD.sUSDGeneral.sUSD_RunCrankPlausibility_Supported)-»

/* Satisfies: [$SDD_SUSD 112] [$SDD_SUSD 113] */
static FUNC(void, SUSD_CODE) SUSD_RunCrankActiveDetermination(void)
{
    static RunCrankPlausibility LastValidPrimRunCrankReceived = SUSD_INACTIVE;
    static RunCrankPlausibility LastValidSecRunCrankReceived = SUSD_INACTIVE;

    SignalStatusType SignalAvailability = SUM_SSM_SIGNAL_STATUS_UNINITIALIZED;
    RunCrankPlausibility SignalInvalidity = TRUE;
    RunCrankPlausibility SignalFoFA = TRUE;
    RunCrankPlausibility SignalFoI = TRUE;
  
    SUSD_RunCrankActiveInv=TRUE;
    /*The Run/Crank Active will be filled with the Run/Crank input
     * only if the debouncing has been completed. Otherwise, its invalidity
     * is kept equal to TRUE.
     */
    if(SUSD_DebouncingCompleted==TRUE)
    {
		  SUSD_RunCrankActive = SUSD_RunCrankInput;
		  SUSD_RunCrankActiveInv = SUSD_RunCrankInputInv;
    }

    /*Run Crank Active Determination using Backup Power Mode Master state */
    /* Read the signal availability for Secondary Run/Crank Command Active from SSM */
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_Av_SignalAvailability(&SignalAvailability);
    /* Read the signal invalidity for Secondary Run/Crank Command Active from SSC */
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_Inv_VDPSecInv(&SignalInvalidity);
    /* Read the signal Failed Continuous Operation Fault Active for Secondary Run/Crank Command Active from SSM */
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_FoFA_DTC_STATUS_FOFA(&SignalFoFA);

    if ((SignalInvalidity == FALSE) && (SignalAvailability == SUM_SSM_SIGNAL_STATUS_AVAILABLE ) && (SignalFoFA == FALSE))
    {
        /* Read the signal Failed Continuous Operation Indication for Secondary Run/Crank Command Active from SSM */
        (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_FoI_ContnOperation(&SignalFoI);

        /* NOTE:
         * If the signal has Failed Continuos Operation Indication active, we reason that this cannot be the first
         * time we receive the signal. Therefore, we assume that LastValidSecRunCrankReceived has been initialised
         * with the last known valid signal received.
         */
        if (SignalFoI == FALSE)
        {
            (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_VDPSecActive(&SUSD_RunCrankActive);
            LastValidSecRunCrankReceived = SUSD_RunCrankActive;
        }
        else
        {
            SUSD_RunCrankActive = LastValidSecRunCrankReceived;
        }
        SUSD_RunCrankActiveInv = FALSE;
    }

    /* Run/Crank Active determination using Power Mode Master state */
    /* Read the signal availability for Primary Run/Crank Command Active from SSM */
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_Av_SignalAvailability(&SignalAvailability);
    /* Read the signal invalidity for Primary Run/Crank Command Active from SSC */
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_Inv_VDPPrimInv(&SignalInvalidity);
    /* Read the signal Failed Continuous Operation Fault Active for Primary Run/Crank Command Active from SSM */
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_FoFA_DTC_STATUS_FOFA(&SignalFoFA);

    if ((SignalInvalidity == FALSE) && (SignalAvailability == SUM_SSM_SIGNAL_STATUS_AVAILABLE ) && (SignalFoFA == FALSE))
    {

        /* Read the signal Failed Continuous Operation Indication for Primary Run/Crank Command Active from SSM */
        (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_FoI_ContnOperation(&SignalFoI);

        /* NOTE:
         * If the signal has Failed Continuos Operation Indication active, we reason that this cannot be the first
         * time we receive the signal. Therefore, we assume that LastValidPrimRunCrankReceived has been initialised
         * with the last known valid signal received.
         */
        if (SignalFoI == FALSE)
        {
            (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_VDPPrimActive(&SUSD_RunCrankActive);
            LastValidPrimRunCrankReceived = SUSD_RunCrankActive;
        }
        else
        {
            SUSD_RunCrankActive = LastValidPrimRunCrankReceived;
        }
        SUSD_RunCrankActiveInv = FALSE;
    }

    /* We have finally determined Run/Crank Active and its validity: notify SWCs */
    /* [$Satisfies $SDD_SUSD 248] */
    (void) Rte_Write_PP_SUSD_RunCrankActive_SWC_RunCrankPlausibilityData(SUSD_RunCrankActive);
    /* [$Satisfies $SDD_SUSD 248] */
    (void) Rte_Write_PP_SUSD_RunCrankActive_Inv_SWC_VDPRunCrankActive_Inv(SUSD_RunCrankActiveInv);
}

/***********************************************************************************

  Function name :   SUSD_RunCrankPlausibility
  Description   :   Function for Run Crank functionality
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* PRQA S 1532 1 # This Function can be used in the multiple file and can not be turned into static as well as moved to static code */
FUNC(void, SUSD_CODE) SUSD_RunCrankPlausibility(void)
{
    /* Initially set invalidity to true, when valid Run/Crank is available then set to false */
    SUSD_RunCrankActiveInv = TRUE;

    /* Always process all signals to save previously received signal values */
    SUSD_RunCrankInputDiscreteAnalog();

    SUSD_RunCrankInputValidity();

    SUSD_RunCrankActiveDetermination();

    /* Perform Run/Crank Stuck High/Low diagnostics */
    SUSD_RunCrankStuckHighDiagnosticCriteria();
    SUSD_RunCrankStuckLowDiagnosticCriteria();
}

/* Satisfies: [$SDD_SUSD 118] [$SDD_SUSD 062]*/
static FUNC(uint16, SUSD_CODE) SUSD_RunCrankInputVoltage(void)
{
    uint8 InputPercentageValue = SUSD_ZERO;

    (void) Rte_Read_RP_SUSD_RunCrankInputPercentage_VDPPercentage(&InputPercentageValue);

    /* Obtain the current Input Voltage value using the current Run Crank Input Percentage value
     * and the Percentage to Voltage Conversion Factor calibration value */
    return (uint16) ((InputPercentageValue * Rte_CData_SUSD_PDP_PercentageToVolConvFactor()) / 100u);
}

/* This macro determines the current Run/Crank input value based on the binary
 * value (Low/High) of the last N samples, where N is the minimum value for which
 * N * SUSD_RUNCRANK_PERIODICITY >= Rte_CData_SUSD_PDP_RunCrankInput_DebounceTime().
 * If the last N samples were equal (all Low or all High), the Run/Crank input
 * value is determined to be that same state (Low or High respectively).
 * When the current sample interrupts the sequence of equal samples, the count
 * for the value of the current sample is started, and the count for the other
 * value is reset.
 * The macro also signals when the debouncing has been completed.
 * NOTE: There is no risk of integer overflow.
 * SUSD_RUNCRANK_PERIODICITY is limited to a maximum of 500 (ms).
 * Since __STATES_COUNTER[__SAMPLE_STATE] will increase by increments of 1,
 * it follows that ((__STATES_COUNTER[__SAMPLE_STATE]) * SUSD_RUNCRANK_PERIODICITY)
 * will increase by increments of 500.
 * This means that ((__STATES_COUNTER[__SAMPLE_STATE]) * SUSD_RUNCRANK_PERIODICITY)
 * will overshoot the value of K_RunCrankInput_DebounceTime by a maximum of 499
 * before __STATES_COUNTER[__SAMPLE_STATE] stops increasing.
 * K_RunCrankInput_DebounceTime is in turn limited to a maximum of 10000 (ms).
 * This means that ((__STATES_COUNTER[__SAMPLE_STATE]) * SUSD_RUNCRANK_PERIODICITY)
 * will always be in the range [500, 10500), and therefore will never overflow an uint16.
 */
/* Satisfies: [$SDD_SUSD 071] */
static FUNC(void, SUSD_CODE) Runcrak_Count_input_sample(uint16* State_Couter,boolean Sample_State)
{
	boolean State_var;
    if ((((State_Couter)[(Sample_State)]) * SUSD_RUNCRANK_PERIODICITY) >= Rte_CData_SUSD_PDP_RunCrankInput_DebounceTime())
    {
        (State_var) = (Sample_State);
        SUSD_RunCrankInput = (State_var);
        SUSD_DebouncingCompleted = TRUE;\
        /* [$Satisfies $SDD_SUSD 248] */
        (void) Rte_Write_PP_SUSD_RunCrankInput_SWC_VDPInput(SUSD_RunCrankInput);\
    }
    else
    {
        (State_Couter)[(Sample_State)]++;
        (State_Couter)[SUSD_ONE - (Sample_State)] = SUSD_ZERO;
        SUSD_DebouncingCompleted = FALSE;
    }
}

/***********************************************************************************

  Function name :   SUSD_RunCrankInputDiscreteAnalog
  Description   :   Function to handle RunCrank Input Discrete and Analog Type
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 062] [$SDD_SUSD 069] [$SDD_SUSD 070] [$SDD_SUSD 071]
 * [$SDD_SUSD 072] [$SDD_SUSD 114] [$SDD_SUSD 115] [$SDD_SUSD 116] [$SDD_SUSD 117] */
static FUNC(void, SUSD_CODE) SUSD_RunCrankInputDiscreteAnalog(void)
{
    /* Discrete input */
    boolean InputDiscreteValue = SUSD_LOW;

    /* Count occurrences of High/Low state for Run/Crank Input
     * NOTE: Since the ECU will always be reset after changing calibration parameters,
     * we can use a single data structure to count both Analog/Discrete state counts
     * without fear of mixing the two up. */
    static uint16 StateCount[SUSD_TWO] = {SUSD_ZERO, SUSD_ZERO};

    switch (Rte_CData_SUSD_PDP_SUSD_C_RunCrankInputType()) {
        case SUSD_DISCRETE: /*Run Crank Active Determination based on Discrete Run Crank Input */
            /* Obtain the current input value */
            (void) Rte_Read_RP_SUSD_RunCrankInputDiscreteActive_VDPDiscreteActive(&InputDiscreteValue);
            /* If we have counted the currently active value consecutively for enough cycles, the input is determined */
            Runcrak_Count_input_sample(StateCount,InputDiscreteValue);
            break;
        case SUSD_ANALOG: 
            /*Run Crank Active Determination based on Analog Run Crank Input */
			SUSD_RunCrankInputAnalog(StateCount);			
            break;
        default: /* Do nothing: RunCrankInputType is either DISCRETE or ANALOG */
            break;
    }
}

/***********************************************************************************

  Function name :   SUSD_RunCrankInputValidity
  Description   :   Function for RunCrank Input Validity
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 119] [$SDD_SUSD 125] [$SDD_SUSD 131] */
static FUNC(void, SUSD_CODE) SUSD_RunCrankInputValidity(void)
{
    boolean StuckLow_FA = FALSE;
    boolean StuckHigh_FA = FALSE;

    /*Read Run/Crank Input Stuck Low Diagnostic Fault Active from ERRH*/
    (void) Rte_Read_RP_RunCrankInputStuckLow_FA_StatusReq_FA_LowStatus_DTC_Confirm(&StuckLow_FA);
    /*Read Run/Crank Input Stuck High Diagnostic Fault Active from ERRH*/
    (void) Rte_Read_RP_RunCrankInputStuckHigh_FA_StatusReq_FA_HighStatus_DTC_Confirm(&StuckHigh_FA);

    /* Indicate to SWCs */
    (void) Rte_Write_PP_RunCrankInputStuckLowDiag_FA_LowDiagFA(StuckLow_FA);
    (void) Rte_Write_PP_RunCrankInputStuckHighDiag_FA_HighDiagFA(StuckHigh_FA);

    SUSD_RunCrankInputInv = ((StuckLow_FA == TRUE) || (StuckHigh_FA == TRUE));

    /* Notify SWCs */
    /* [$Satisfies $SDD_SUSD 248] */
    (void) Rte_Write_PP_SUSD_RunCrankInput_Inv_SWC_VDPInputInv(SUSD_RunCrankInputInv);
}

static FUNC(boolean, SUSD_CODE) SUSD_BatteryVoltageInRange(void)
{
    static boolean VoltageInRange = FALSE;
    Impl_SUSD_VehcleBatryVlg BatteryVoltage = SUSD_ZERO;
	
    /* Read the Battery Voltage value from SW-C in volts */
    (void) Rte_Read_RP_SUSD_VehicleBatteryVoltage_VehicleVoltage(&BatteryVoltage);
	
    /* Check for Controller Voltage In Range with hysteresis of 0.5 V when going low */
	if ((BatteryVoltage >= (uint16)SUSD_CONTROLLER_VOLTAGE_THRESHOLD)
		|| ((VoltageInRange == TRUE) && (BatteryVoltage >= (uint16)(SUSD_CONTROLLER_VOLTAGE_THRESHOLD - SUSD_CONTROLLER_VOLTAGE_HYSTERESIS_LOW))))
	{
        VoltageInRange = TRUE;
    }
    else
    {
        VoltageInRange = FALSE;
    }

    return VoltageInRange;
}

/***********************************************************************************

  Function name :   SUSD_RunCrankStuckHighDiagnosticCriteria
  Description   :   Function for RunCrank Input Stuck High Diagnostic
                    Enable/Failure Criteria
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 063] [$SDD_SUSD 064] [$SDD_SUSD 065] [$SDD_SUSD 120]
 * [$SDD_SUSD 121] [$SDD_SUSD 122] [$SDD_SUSD 123] [$SDD_SUSD 124] */
static FUNC(void, SUSD_CODE) SUSD_RunCrankStuckHighDiagnosticCriteria(void)
{
    boolean RunCrankCondition = FALSE;

    /*Variables to read Power Mode Master parameters*/
    boolean PrimaryRunCrank = SUSD_LOW;
    boolean PrimaryRunCrankInvalidity = TRUE;
    SignalStatusType PrimaryRunCrankAvailability = SUM_SSM_SIGNAL_STATUS_UNINITIALIZED;
    boolean PrimaryRunCrankFoFA = TRUE;

    /*Variables to read Backup Power Mode Master parameters*/
    boolean SecondaryRunCrank = SUSD_LOW;
    boolean SecondaryRunCrankInvalidity = TRUE;
    SignalStatusType SecondaryRunCrankAvailability = SUM_SSM_SIGNAL_STATUS_UNINITIALIZED;
    boolean SecondaryRunCrankFoFA = TRUE;

    /* Since we are operating with hysteresis, we need to run this function
     * every cycle even if we do not need the condition to enable diagnostic
     * (i.e. if RunCrankInputStuckHi_Enable were FALSE) */
    boolean BatteryVoltageInRange = SUSD_BatteryVoltageInRange();

    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_VDPPrimActive(&PrimaryRunCrank);
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_Inv_VDPPrimInv(&PrimaryRunCrankInvalidity);
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_Av_SignalAvailability(&PrimaryRunCrankAvailability);
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_FoFA_DTC_STATUS_FOFA(&PrimaryRunCrankFoFA);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_VDPSecActive(&SecondaryRunCrank);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_Inv_VDPSecInv(&SecondaryRunCrankInvalidity);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_Av_SignalAvailability(&SecondaryRunCrankAvailability);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_FoFA_DTC_STATUS_FOFA(&SecondaryRunCrankFoFA);

    /* Compute the Run/Crank enable condition.
     * If the Primary Run/Crank is good, its value determines the condition.
     * If the Primary Run/Crank is not good and the Secondary is, its value determines the condition.
     */
    if ((SecondaryRunCrankInvalidity == FALSE) && (SecondaryRunCrankAvailability == SUM_SSM_SIGNAL_STATUS_AVAILABLE) && (SecondaryRunCrankFoFA == FALSE))
    {
        RunCrankCondition = (SecondaryRunCrank == SUSD_LOW);
    }

    if ((PrimaryRunCrankInvalidity == FALSE) && (PrimaryRunCrankAvailability == SUM_SSM_SIGNAL_STATUS_AVAILABLE) && (PrimaryRunCrankFoFA == FALSE))
    {
        RunCrankCondition = (PrimaryRunCrank == SUSD_LOW);
    }

    /* The Run Crank Input Stuck High diagnostics shall be enabled when all the following conditions are TRUE */
    if ((Rte_CData_SUSD_PDP_RunCrankInputStuckHi_Enable() == TRUE)
            && (BatteryVoltageInRange == TRUE)
            && (RunCrankCondition == TRUE))
    {
        /* Run Crank Input Stuck High diagnostics is enabled */
        SUSD_RunCrankStuckHighDiagnostic_EnabledCount++;

        if (SUSD_RunCrankInput == SUSD_HIGH)
        {
            /* Run Crank Input Stuck High diagnostic has failed */
            SUSD_RunCrankStuckHighDiagnostic_FailCount++;
        }
    }

    /*check whether the diagnostic services permitting the setting of DTCs */
    if (Rte_Mode_RP_SUSD_ControlDTCSetting_ControlDTCSetting() == RTE_MODE_MDG_ControlDTCSetting_SUM_ENABLEDTCSETTING)
    {
        if (SUSD_RunCrankStuckHighDiagnostic_FailCount >= (uint32) Rte_CData_SUSD_PDP_RunCrankInputStuckHi_FailCount())
        {
            (void) Rte_Write_PP_RunCrankInputStuckHighDiagStatus_HighStatus((uint8) SUSD_DIAGNOSTIC_FAILED);
            SUSD_RunCrankStuckHighDiagnostic_EnabledCount = SUSD_ZERO;
            SUSD_RunCrankStuckHighDiagnostic_FailCount = SUSD_ZERO;
        }
        else if (SUSD_RunCrankStuckHighDiagnostic_EnabledCount >= (uint32) Rte_CData_SUSD_PDP_RunCrankInputStuckHi_SampleCount())
        {
            (void) Rte_Write_PP_RunCrankInputStuckHighDiagStatus_HighStatus((uint8) SUSD_DIAGNOSTIC_PASSED);
            SUSD_RunCrankStuckHighDiagnostic_EnabledCount = SUSD_ZERO;
            SUSD_RunCrankStuckHighDiagnostic_FailCount = SUSD_ZERO;
        }
        else
        {
            (void) Rte_Write_PP_RunCrankInputStuckHighDiagStatus_HighStatus((uint8) SUSD_DIAGNOSTIC_NO_STATUS_TO_REPORT);
        }
    }
}

/***********************************************************************************

  Function name :   SUSD_RunCrankStuckLowDiagnosticCriteria
  Description   :   Function for RunCrank Input Stuck Low Diagnostic
                    Enable/Failure Criteria
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
/* Satisfies: [$SDD_SUSD 066] [$SDD_SUSD 067] [$SDD_SUSD 068] [$SDD_SUSD 126]
 * [$SDD_SUSD 127] [$SDD_SUSD 128] [$SDD_SUSD 129] [$SDD_SUSD 130]*/
static FUNC(void, SUSD_CODE) SUSD_RunCrankStuckLowDiagnosticCriteria(void)
{
    boolean RunCrankCondition = FALSE;

    /*Variables to read Power Mode Master parameters*/
    boolean PrimaryRunCrank = SUSD_LOW;
    boolean PrimaryRunCrankInvalidity = TRUE;
    SignalStatusType PrimaryRunCrankAvailability = SUM_SSM_SIGNAL_STATUS_UNINITIALIZED;
    boolean PrimaryRunCrankFoFA = TRUE;

    /*Variables to read Backup Power Mode Master parameters*/
    boolean SecondaryRunCrank = SUSD_LOW;
    boolean SecondaryRunCrankInvalidity = TRUE;
    SignalStatusType SecondaryRunCrankAvailability = SUM_SSM_SIGNAL_STATUS_UNINITIALIZED;
    boolean SecondaryRunCrankFoFA = TRUE;

    boolean BatteryVoltageInRange = SUSD_BatteryVoltageInRange();

    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_VDPPrimActive(&PrimaryRunCrank);
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_Inv_VDPPrimInv(&PrimaryRunCrankInvalidity);
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_Av_SignalAvailability(&PrimaryRunCrankAvailability);
    (void) Rte_Read_RP_SUSD_PrimaryRunCrankCmdActive_FoFA_DTC_STATUS_FOFA(&PrimaryRunCrankFoFA);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_VDPSecActive(&SecondaryRunCrank);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_Inv_VDPSecInv(&SecondaryRunCrankInvalidity);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_Av_SignalAvailability(&SecondaryRunCrankAvailability);
    (void) Rte_Read_RP_SUSD_SecondaryRunCrankCmdActive_FoFA_DTC_STATUS_FOFA(&SecondaryRunCrankFoFA);

    /* Compute the Run/Crank enable condition.
     * If the Primary Run/Crank is good, its value determines the condition.
     * If the Primary Run/Crank is not good and the Secondary is, its value determines the condition.
     */
    if ((SecondaryRunCrankInvalidity == FALSE) && (SecondaryRunCrankAvailability == SUM_SSM_SIGNAL_STATUS_AVAILABLE) && (SecondaryRunCrankFoFA == FALSE))
    {
        RunCrankCondition = (SecondaryRunCrank == SUSD_HIGH);
    }

    if ((PrimaryRunCrankInvalidity == FALSE) && (PrimaryRunCrankAvailability == SUM_SSM_SIGNAL_STATUS_AVAILABLE) && (PrimaryRunCrankFoFA == FALSE))
    {
        RunCrankCondition = (PrimaryRunCrank == SUSD_HIGH);
    }

    /* The Run Crank Input Stuck High diagnostics shall be enabled when all the following conditions are TRUE */
    if ((Rte_CData_SUSD_PDP_RunCrankInputStuckLow_Enable() == TRUE)
            && (BatteryVoltageInRange == TRUE)
            && (RunCrankCondition == TRUE))
    {
        /* Run Crank Input Stuck Low diagnostics is enabled */
        SUSD_RunCrankStuckLowDiagnostic_EnabledCount++;

        if (SUSD_RunCrankInput == SUSD_LOW)
        {
            /* Run Crank Input Stuck Low diagnostic has failed */
            SUSD_RunCrankStuckLowDiagnostic_FailCount++;
        }
    }

    /*check whether the diagnostic services permitting the setting of DTCs */
    if (Rte_Mode_RP_SUSD_ControlDTCSetting_ControlDTCSetting() == RTE_MODE_MDG_ControlDTCSetting_SUM_ENABLEDTCSETTING)
    {
        if (SUSD_RunCrankStuckLowDiagnostic_FailCount >= (uint32) Rte_CData_SUSD_PDP_RunCrankInputStuckLow_FailCount())
        {
            (void) Rte_Write_PP_RunCrankInputStuckLowDiagStatus_LowStatus((uint8) SUSD_DIAGNOSTIC_FAILED);
            SUSD_RunCrankStuckLowDiagnostic_EnabledCount = SUSD_ZERO;
            SUSD_RunCrankStuckLowDiagnostic_FailCount = SUSD_ZERO;
        }
        else if (SUSD_RunCrankStuckLowDiagnostic_EnabledCount >= (uint32) Rte_CData_SUSD_PDP_RunCrankInputStuckLow_SampleCount())
        {
            (void) Rte_Write_PP_RunCrankInputStuckLowDiagStatus_LowStatus((uint8) SUSD_DIAGNOSTIC_PASSED);
            SUSD_RunCrankStuckLowDiagnostic_EnabledCount = SUSD_ZERO;
            SUSD_RunCrankStuckLowDiagnostic_FailCount = SUSD_ZERO;
        }
        else
        {
            (void) Rte_Write_PP_RunCrankInputStuckLowDiagStatus_LowStatus((uint8) SUSD_DIAGNOSTIC_NO_STATUS_TO_REPORT);
        }
    }
}

/***********************************************************************************

  Function name :   SUSD_RunCrankInputAnalog
  Description   :   Function to handle RunCrank Input Analog Type
                    Enable/Failure Criteria
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
 ************************************************************************************/
static FUNC(void, SUSD_CODE) SUSD_RunCrankInputAnalog(uint16 *StateCount)
{
	/* Analog input */
    uint16 InputVoltageValue;
	static boolean AnalogState = SUSD_LOW;
	InputVoltageValue = SUSD_RunCrankInputVoltage();
	if (InputVoltageValue < Rte_CData_SUSD_PDP_RunCrankInputThresholdLow())
	{
		/* Low state is determined for this sample */
		Runcrak_Count_input_sample(StateCount,SUSD_LOW);
    	AnalogState = SUSD_LOW;
	}
	else if (InputVoltageValue >= Rte_CData_SUSD_PDP_RunCrankInputThresholdHigh())
	{
		/* High state is determined for this sample */
		Runcrak_Count_input_sample(StateCount,SUSD_HIGH);
    	AnalogState = SUSD_HIGH;
	}
	else
	{
		/* We are in the dead band between the Low and High thresholds.
		 * Retain previous state, but reset both value counts. */
		SUSD_RunCrankInput = AnalogState;
		/* [$Satisfies $SDD_SUSD 248] */
		(void) Rte_Write_PP_SUSD_RunCrankInput_SWC_VDPInput(SUSD_RunCrankInput);
		StateCount[SUSD_LOW] = SUSD_ZERO;
		StateCount[SUSD_HIGH] = SUSD_ZERO;
	}
}

