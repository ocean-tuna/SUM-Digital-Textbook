/***********************************************************************************

  Function name :   Runnable_DID_F1B0_ReadData
  Description   :	Handles the reading of diagnostic data for DID F1B0
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   Satisfies: [$Satisfies $SDD_DIAG 108]
 ************************************************************************************/

#define SUM_DIAG_START_SEC_CODE
#include "SUM_DIAG_MemMap.h"
/* PRQA S 1503 # This function is mapped to a task configured within OS. */
FUNC(Std_ReturnType, SUM_DIAG_CODE) Runnable_DID_F1B0_ReadData(
    VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
	uint8 * Data){
    Std_ReturnType retValue = E_NOT_OK;

    if (SUM_DIAG_permit_execution != FALSE)
    {
        switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
                /* Set Data to DIAG_ECUADDRESS */
                *Data = DIAG_ECUADDRESS;
                retValue = E_OK;
                break;
            default:
                /* Do Nothing */
                break;
        }
    }
    else
    {
        /* Do Nothing */
    }

    return retValue;
}
#define SUM_DIAG_STOP_SEC_CODE
#include "SUM_DIAG_MemMap.h"

«IF (diag.diagGeneral.sum_Diag_EnableDID_E0CC == true)-»
/***********************************************************************************

  Function name :   Runnable_Diag_DID_E0CC_ReadData
  Description   :	Handles the reading of diagnostic data for DID E0CC (Service Discovery Learning Table Status)
  Parameter in  :   None
  Parameter out  :   None
  Return value  :   Std_ReturnType
  Remarks       :   [$Satisfies $SDD_DIAG 120][$Satisfies $SDD_DIAG 121][$Satisfies $SDD_DIAG 122]
 ************************************************************************************/

#define SUM_DIAG_START_SEC_CODE
#include "SUM_DIAG_MemMap.h"
/* PRQA S 1503 # This function is mapped to a task configured within OS. */
FUNC(Std_ReturnType, SUM_DIAG_CODE) Runnable_Diag_DID_E0CC_ReadData(
    VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
	uint8 * Data){
    Std_ReturnType retValue = E_NOT_OK;

    if (SUM_DIAG_permit_execution != FALSE)
    {
        switch (OpStatus)
        {
            case DCM_INITIAL:
            case DCM_PENDING:
                /* Set Data to 0x05 (Not Supported) - indicates CAN-only ECU without SrvcMgr */
                *Data = 0x05u;
                retValue = E_OK;
                break;
            default:
                /* Do Nothing */
                break;
        }
    }
    else
    {
        /* Do Nothing */
    }

    return retValue;
}
