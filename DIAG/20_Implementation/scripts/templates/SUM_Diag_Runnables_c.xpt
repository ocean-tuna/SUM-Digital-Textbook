/***********************************************************************************

  Function name :   Runnable_OTA_PSF
  Description   :	It implements Automatic Disabling of DTCs when OTA PSF is SET in
                    in-vehicle ECUs, and stores the OTA PSF value in the the mirror RAM block
  Parameter in  :   None
  Parameter out :   None
  Return value  :   None
  Remarks       :   Satisfies: [$Satisfies $SDD_DIAG 013][$Satisfies $SDD_DIAG 028][$Satisfies $SDD_DIAG 029]
                               [$Satisfies $SDD_DIAG 030][$Satisfies $SDD_DIAG 031][$Satisfies $SDD_DIAG 032]
                               [$Satisfies $SDD_DIAG 099][$Satisfies $SDD_DIAG 100][$Satisfies $SDD_DIAG 101]
                               [$SDD_DIAG 107][$SDD_DIAG 035]
 ************************************************************************************/
#define SUM_DIAG_START_SEC_CODE
#include "SUM_DIAG_MemMap.h"
FUNC(void, SUM_DIAG_CODE) Runnable_OTA_PSF (void) /* PRQA S 1503 # This function is mapped to a periodic task configured within OS. */
{
	«IF Diag_IsRmtProgActvAuthGroupSignal(diag.diagGeneral)»
    static RxSignal_BSPMP_RmtProgmActvAuth_GroupSignal signal_group = {0};
    «ELSEIF Diag_IsOTAServiceBased(diag.diagGeneral)-»
    static «Diag_GetImplementationDataTypeName(diag.diagGeneral.dIAG_ServiceBased_OTA_Ref)» srv_signal;
    Rte_TransformerError transformerError;
    «ENDIF»
    static boolean ota_psf_Sigdata;
    boolean ota_psf_data;
    Std_ReturnType ret_value;
    boolean SUM_DIAG_stored_ota_psf;
    SignalStatusType sig_status;
    Std_ReturnType ret_val_av, ret_val_fa;
    boolean fault_active;

    SUM_DIAG_stored_ota_psf = getOtaPsf();

    if (SUM_DIAG_permit_execution != FALSE)
    {
        ret_val_av = Rte_Read_SUM_DIAG_RP_SSFM_DIAG_BSPMP_RmtProgmActvAuth_Av_SignalAvailability(&sig_status);
    «IF (!Diag_SsfmIsSinglePortSupported(sSFM))-»
		ret_val_fa = Rte_Read_SUM_DIAG_RP_SSFM_DIAG_BSPMP_RmtProgmActvAuth_FsFA_DTC_STATUS_FSFA(&fault_active);
	«ELSE-»
		ret_val_fa = Rte_Read_SUM_DIAG_RP_SSFM_DIAG_BSPMP_RmtProgmActvAuth_FxFA_DTC_STATUS_FXFA(&fault_active);
	«ENDIF-»

		/* Check the signal availability and if there is no FxFA or FsFa from SSFM  */ /* PRQA S 3415 3 # side effects can be ignored */
		if ((E_OK == ret_val_av) && (sig_status == SIG_STATUS_AVAILABLE) && (ret_val_fa == E_OK) && (fault_active == FALSE))
		{
	«IF Diag_IsRmtProgActvAuthGroupSignal(diag.diagGeneral)-»
			/* Reception of the OTA-PSF flag via the Com Signal Group */
			ret_value = Rte_Read_SUM_DIAG_RP_Com_DIAG_BSPMP_RmtProgmActvAuth_RmtProgmActvAuthRxSignal(&signal_group);
			ota_psf_Sigdata = signal_group.RxSignal_«diag.diagGeneral.dIAG_BSPMP_RmtProgmActvAuthRef.shortName»;
	«ELSEIF Diag_IsOTAServiceBased(diag.diagGeneral)-»
			ret_value = Rte_Read_SUM_DIAG_RP_Com_DIAG_BSPMP_RmtProgmActvAuth_RmtProgmActvAuthRxSignal(&srv_signal, &transformerError);
			ota_psf_Sigdata = srv_signal.«Diag_GetImplementationDataTypeElementName(diag.diagGeneral.dIAG_ServiceBased_OTA_Ref)»;
	«ELSE-»
			/* Reception of the OTA-PSF flag via the Com Signal */
			ret_value = Rte_Read_SUM_DIAG_RP_Com_DIAG_BSPMP_RmtProgmActvAuth_RmtProgmActvAuthRxSignal(&ota_psf_Sigdata);
	«ENDIF-»
			if (ret_value == E_OK)
			{
				/* Reception of the precondition from a Swc */
				(void)Rte_Read_OTA_PSF_Precondition_VDP_ota_psf(&ota_psf_data);

				/* Ota_psf_Sigdata value is written to NvM taking into account the precondition */
				if( (SUM_DIAG_stored_ota_psf != ota_psf_Sigdata) && (SUM_DIAG_stored_ota_psf == FALSE) && (ota_psf_data == TRUE))
				{
					setOtaPsf(ota_psf_Sigdata);
					(void)Rte_Call_EnableCondition_OTA_PSF_SetEnableCondition(FALSE);
					(void)ProcessOTAWrite();
					/* Send the Ota flag value to the SSFM and Swc */
                    (void)Rte_Write_SUM_DIAG_PP_DIAG_SWC_RmtPrgmOtaPsf_Status_DIAG_RemoteProgrammingOtaPsf(TRUE); //ota psf value true
				}

				else if((SUM_DIAG_stored_ota_psf != ota_psf_Sigdata) && (SUM_DIAG_stored_ota_psf == TRUE))
				{
					setOtaPsf(ota_psf_Sigdata);
					(void)Rte_Call_EnableCondition_OTA_PSF_SetEnableCondition(TRUE);
					(void)ProcessOTAWrite();
					/* Send the Ota flag value to the SSFM and Swc */
                    (void)Rte_Write_SUM_DIAG_PP_DIAG_SWC_RmtPrgmOtaPsf_Status_DIAG_RemoteProgrammingOtaPsf(FALSE); // ota psf value false
				}
				else
				{
					/*No changes */
					(void)Rte_Write_SUM_DIAG_PP_DIAG_SWC_RmtPrgmOtaPsf_Status_DIAG_RemoteProgrammingOtaPsf(SUM_DIAG_stored_ota_psf);
				}
			}
		}
		else
        {
            /* If fault active update the port with default value 0 */
            (void)Rte_Write_SUM_DIAG_PP_DIAG_SWC_RmtPrgmOtaPsf_Status_DIAG_RemoteProgrammingOtaPsf(FALSE);
        }
    }

}

