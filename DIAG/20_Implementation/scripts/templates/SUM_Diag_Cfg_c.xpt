#include "SUM_Diag.h"
#include "Rte_SUM_DIAG.h"
#include "SUM_Diag_Cfg.h"

VAR(Diag_NormalCommStatus_Channel_Type, RTE_DATA) Diag_NormalCommStatus_Channel[DIAG_NUMBER_OF_CHANNELS] =
{
«FOREACH diag.diagConfigSet.commChannels.commChannel.commChannelRef AS channelRef-»
	{ SUM_DiagNormalCom_Enable, Rte_Mode_SUM_DIAG_BswM_CommunicationMode_«channelRef.shortName»_SUM_COMM_MODE, Rte_Write_SUM_DIAG_PP_DIAG_DisableNormalComm_Ch«channelRef.comMChannelId»_NormalComMode },
«ENDFOREACH»};

«IF (diag.diagGeneral.mecStorageInHsm != true)-»
«LET diag.diagGeneral.dIAG_MEC_NvMRef AS mec_NvMBlockDescRef-»
/* RAM mirror to NvM block */
/*PRQA S 1504 2 # The variable can be reused in the other modules */
/* PRQA S 3408 1 # The variable is declared in other modules */
uint8 «mec_NvMBlockDescRef.nvMRamBlockDataAddress» = MEC_INITIAL_VALUE;
/* PRQA S 1531 1 # This object can be used in other translation units and is defined here for template needs */
uint8 * const MEC_RamBlockPtr = &«mec_NvMBlockDescRef.nvMRamBlockDataAddress»;
«ENDLET-»
«ENDIF-»

«LET diag.diagGeneral.dIAG_OTA_PSF_NvMRef AS ota_psf_NvMBlockDescRef-»
/* RAM mirror to NvM block */
/*PRQA S 1504 2 # The variable can be reused in the other modules */
/* PRQA S 3408 1 # The variable is declared in other modules */
boolean «ota_psf_NvMBlockDescRef.nvMRamBlockDataAddress»;
/* PRQA S 1531 1 # This object can be used in other translation units and is defined here for template needs */
boolean * const OTA_PSF_RamBlockPtr = &«ota_psf_NvMBlockDescRef.nvMRamBlockDataAddress»;
«ENDLET-»

«ENDFILE»
«ENDDEFINE»
