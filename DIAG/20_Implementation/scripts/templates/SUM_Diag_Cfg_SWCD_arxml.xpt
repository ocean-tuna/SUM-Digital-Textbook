		<SENDER-RECEIVER-INTERFACE>
          <SHORT-NAME>BSPMP_RmtProgmActvAuth_Signal</SHORT-NAME>
          <IS-SERVICE>false</IS-SERVICE>
          <DATA-ELEMENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>RmtProgmActvAuthRxSignal</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
		          <SW-DATA-DEF-PROPS>
		            <SW-DATA-DEF-PROPS-VARIANTS>
		              <SW-DATA-DEF-PROPS-CONDITIONAL>
		                <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
		              </SW-DATA-DEF-PROPS-CONDITIONAL>
		            </SW-DATA-DEF-PROPS-VARIANTS>
		          </SW-DATA-DEF-PROPS>
«IF diag.diagGeneral.dIAG_BSPMP_RmtProgmActvAuthRef.metaType.toString().contains("ComSignal")-»
	«IF Diag_IsOTAServiceBased(diag.diagGeneral)-»
			  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«Diag_GetImplementationDataTypePath(diag.diagGeneral.dIAG_ServiceBased_OTA_Ref)-»</TYPE-TREF>
	«ELSE -»
              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«diag.diagGeneral.dIAG_BSPMP_RmtProgmActvAuthRef.comSignalType.toLowerCase()»</TYPE-TREF>
	«ENDIF-»
«ELSE -»
			  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_DIAG/Component/RxSignal_BSPMP_RmtProgmActvAuth_GroupSignal</TYPE-TREF>
«ENDIF-»
            </VARIABLE-DATA-PROTOTYPE>
          </DATA-ELEMENTS>
        </SENDER-RECEIVER-INTERFACE>


		<MODE-SWITCH-INTERFACE>
		  <SHORT-NAME>DIAG_BswM_Dcm_CommunicationMode_CurrentState</SHORT-NAME>
		  <IS-SERVICE>false</IS-SERVICE>
		  <MODE-GROUP>
			<SHORT-NAME>SUM_COMM_MODE</SHORT-NAME>
			<TYPE-TREF DEST="MODE-DECLARATION-GROUP">/SUM_DIAG/Component/MDG_BswM_CommunicationMode</TYPE-TREF>
		  </MODE-GROUP>
		</MODE-SWITCH-INTERFACE>
        <MODE-DECLARATION-GROUP>
          <SHORT-NAME>MDG_BswM_CommunicationMode</SHORT-NAME>
          <CATEGORY>EXPLICIT_ORDER</CATEGORY>
          <INITIAL-MODE-REF DEST="MODE-DECLARATION">/SUM_DIAG/Component/MDG_BswM_CommunicationMode/NORMAL_COM_ENABLED</INITIAL-MODE-REF>
          <MODE-DECLARATIONS>
            <MODE-DECLARATION>
              <SHORT-NAME>NORMAL_COM_ENABLED</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <VALUE>0</VALUE>
            </MODE-DECLARATION>
            <MODE-DECLARATION>
              <SHORT-NAME>NORMAL_COM_DISABLED</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <VALUE>1</VALUE>
            </MODE-DECLARATION>
          </MODE-DECLARATIONS>
          <ON-TRANSITION-VALUE>255</ON-TRANSITION-VALUE>
        </MODE-DECLARATION-GROUP>
		<DATA-TYPE-MAPPING-SET>
		  <SHORT-NAME>Communication_Mode_DTMS</SHORT-NAME>
		  <MODE-REQUEST-TYPE-MAPS>
			<MODE-REQUEST-TYPE-MAP>
			  <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</IMPLEMENTATION-DATA-TYPE-REF>
			  <MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP">/SUM_DIAG/Component/MDG_BswM_CommunicationMode</MODE-GROUP-REF>
			</MODE-REQUEST-TYPE-MAP>
		  </MODE-REQUEST-TYPE-MAPS>
		</DATA-TYPE-MAPPING-SET>
«REM» Implementation Data Type and Base Type for Com Group Signal «ENDREM»
«IF Diag_IsRmtProgActvAuthGroupSignal(diag.diagGeneral) && !Diag_IsOTAServiceBased(diag.diagGeneral)-»
  		<IMPLEMENTATION-DATA-TYPE>
	        <SHORT-NAME>RxSignal_BSPMP_RmtProgmActvAuth_GroupSignal</SHORT-NAME>
	        <LONG-NAME>
	            <L-4 L="EN">RmtProgActvAuthRxSignal</L-4>
	        </LONG-NAME>
	        <CATEGORY>STRUCTURE</CATEGORY>
	        <SUB-ELEMENTS>
«FOREACH diag.diagGeneral.dIAG_BSPMP_RmtProgmActvAuthRef.parent.comGroupSignal AS single_signal-»
	         <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	            <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
	            <CATEGORY>TYPE_REFERENCE</CATEGORY>
	            <SW-DATA-DEF-PROPS>
	                <SW-DATA-DEF-PROPS-VARIANTS>
	                    <SW-DATA-DEF-PROPS-CONDITIONAL>
	        «IF single_signal.comSignalType == "UINT8_N"-»
	        				<IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_DIAG/Component/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ELSE-»
	                        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ENDIF-»
	                    </SW-DATA-DEF-PROPS-CONDITIONAL>
	                 </SW-DATA-DEF-PROPS-VARIANTS>
	            </SW-DATA-DEF-PROPS>
              </IMPLEMENTATION-DATA-TYPE-ELEMENT>
«ENDFOREACH-»
			</SUB-ELEMENTS>
         </IMPLEMENTATION-DATA-TYPE>

«FOREACH Diag_SignalLenghtList(diag.diagGeneral.dIAG_BSPMP_RmtProgmActvAuthRef.parent.comGroupSignal) AS sigSize-»
		<IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>IMPL_LenNByte«sigSize»</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/SUM_DIAG/Component/Bytes«sigSize»</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
         </IMPLEMENTATION-DATA-TYPE>

           <SW-BASE-TYPE>
              <SHORT-NAME>Bytes«sigSize»</SHORT-NAME>
              <CATEGORY>FIXED_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
              <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
              <MEM-ALIGNMENT>8</MEM-ALIGNMENT>
              <NATIVE-DECLARATION>Bytes_«sigSize»</NATIVE-DECLARATION>
           </SW-BASE-TYPE>

           <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>Bytes_«sigSize»</SHORT-NAME>
              <CATEGORY>STRUCTURE</CATEGORY>
              <SUB-ELEMENTS>
              	<IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>Array_«sigSize»</SHORT-NAME>
                  <CATEGORY>ARRAY</CATEGORY>
                  <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                  <SUB-ELEMENTS>
	                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	                  <SHORT-NAME>ArrayElement</SHORT-NAME>
	                  <CATEGORY>TYPE_REFERENCE</CATEGORY>
	                  <ARRAY-SIZE>«sigSize»</ARRAY-SIZE>
	                  <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
	                  <SW-DATA-DEF-PROPS>
	                    <SW-DATA-DEF-PROPS-VARIANTS>
	                      <SW-DATA-DEF-PROPS-CONDITIONAL>
	                        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</IMPLEMENTATION-DATA-TYPE-REF>
	                      </SW-DATA-DEF-PROPS-CONDITIONAL>
	                    </SW-DATA-DEF-PROPS-VARIANTS>
	                  </SW-DATA-DEF-PROPS>
	       			</IMPLEMENTATION-DATA-TYPE-ELEMENT>
	       		   </SUB-ELEMENTS>
	       		 </IMPLEMENTATION-DATA-TYPE-ELEMENT>
	       	   </SUB-ELEMENTS>
	       	</IMPLEMENTATION-DATA-TYPE>
«ENDFOREACH-»
«ENDIF-»
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
«ENDFILE»
«ENDDEFINE»
