<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
  <AR-PACKAGE>
  <SHORT-NAME>SwcImplementations</SHORT-NAME>
  <ELEMENTS>
    <SWC-IMPLEMENTATION>
      <SHORT-NAME>IMPL_SUM_DIAG</SHORT-NAME>
      <CODE-DESCRIPTORS>
        <CODE>
          <SHORT-NAME>Code</SHORT-NAME>
          <ARTIFACT-DESCRIPTORS>
            <AUTOSAR-ENGINEERING-OBJECT>
              <SHORT-LABEL>AutosarEngineeringObject</SHORT-LABEL>
              <CATEGORY>SWSRC</CATEGORY>
            </AUTOSAR-ENGINEERING-OBJECT>
          </ARTIFACT-DESCRIPTORS>
        </CODE>
      </CODE-DESCRIPTORS>
      <PROGRAMMING-LANGUAGE>C</PROGRAMMING-LANGUAGE>
      <RESOURCE-CONSUMPTION>
       <SHORT-NAME>Diag_ResourceConsumption_0</SHORT-NAME>
        <MEMORY-SECTIONS>
          <MEMORY-SECTION>
            <SHORT-NAME>CODE</SHORT-NAME>
          </MEMORY-SECTION>
        </MEMORY-SECTIONS>
      </RESOURCE-CONSUMPTION>
      <BEHAVIOR-REF DEST="SWC-INTERNAL-BEHAVIOR">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB</BEHAVIOR-REF>
    </SWC-IMPLEMENTATION>
  </ELEMENTS>
  </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>SUM_DIAG</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Component</SHORT-NAME>
          <ELEMENTS>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SUM_DIAG</SHORT-NAME>
«REM» [$Satisfies $SDD_DIAG 070] «ENDREM-»
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>DIAG_ECUResetRequest</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_ECUResetRequest</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>DIAG_ShutdownPermission</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_ShutdownPermission</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
				<P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_DID_F1A0_ManufacturersEnableCounter</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«diag.diagGeneral.dIAG_DID_F1A0_MEC_Reference.shortName»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«IF (diag.diagGeneral.dIAG_DID_F1B0_Reference != null)-»
				        <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_DID_F1B0</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«diag.diagGeneral.dIAG_DID_F1B0_Reference.shortName»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDIF-»
«IF (diag.diagGeneral.sum_Diag_EnableDID_E0CC == true)-»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_DID_E0CC_ServiceDiscoveryLearningTableStatus</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«diag.diagGeneral.dIAG_DID_E0CC_Reference.shortName»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDIF-»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>DIAG_SetInitialReflashFlag</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_SSC_InitialReflashFlag</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«FOREACH diag.diagConfigSet.commChannels.commChannel.commChannelRef AS channelRef-»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_DisableNormalComm_Ch«channelRef.comMChannelId»</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_DisableNormalComm</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDFOREACH»
«FOREACH diag.diagConfigSet.commChannels.commChannel.commChannelRef.shortName AS channel_name-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>BswM_CommunicationMode_«channel_name»</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/SUM_DIAG/Component/DIAG_BswM_Dcm_CommunicationMode_CurrentState</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ENDFOREACH»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>SUSD_DIAG_PermitExecution</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUSD_PermitExecution</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>SUSD_Vehicle_Power_Mode</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUSD_VehiclePowerMode</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
				<R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSFM_DIAG_BSPMP_RmtProgmActvAuth_Av</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/RxMonitoredSignal_Av</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
				  <R-PORT-PROTOTYPE>
                  <SHORT-NAME>SSC_DIAG_ReadMemorySecurityVerification</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SSC_DIAG_ReadMemorySecurityVerification</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                   <P-PORT-PROTOTYPE>
                  <SHORT-NAME>DIAG_GetEcuAddress</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SSC_DIAG_GetECUAddress</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«IF (diag.diagGeneral.mecStorageInHsm == true)-»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_ReadMEC</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/DIAG_ReadMEC</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_HSM_SecureDataStore</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/HSM_SecureDataStore</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_DemService_U19A392</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dem/PortInterfaces/DiagnosticMonitor</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ELSE-»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_SSC_GetMEC</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_GetMEC</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_SSFM_GetMEC</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_GetMEC</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDIF-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>BswM_DiagSession</SHORT-NAME>
                  <REQUIRED-COM-SPECS>
                    <MODE-SWITCH-RECEIVER-COM-SPEC>
                      <SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>true</SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>
                    </MODE-SWITCH-RECEIVER-COM-SPEC>
                  </REQUIRED-COM-SPECS>
                  <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/BswM_Modes/DIAG_BswM_DiagSession</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>Dcm_SessionCtrlType</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DCMServices</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
				<R-PORT-PROTOTYPE>
                  <SHORT-NAME>OTA_PSF_Precondition</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/SUM_DIAG/Component/OTA_PSF_Preconditions</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
				<R-PORT-PROTOTYPE>
                  <SHORT-NAME>EnableCondition_OTA_PSF</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dem/PortInterfaces/EnableCondition</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>DIAG_RequestHandler</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/ServiceRequestNotification</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«IF (diag.diagGeneral.mecStorageInHsm != true)-»
				<R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_NvMService_MECBlock</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_NvM/PortInterfaces/NvMService</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ENDIF-»
				<R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_DcmService_GetSecurityLevel</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DCMServices</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
				<R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_NvMService_OTABlock</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_NvM/PortInterfaces/NvMService</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«IF (diag.diagGeneral.mecStorageInHsm != true)-»
				<P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_SOH_GetMEC</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_GetMEC</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«ENDIF-»
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>DIAG_SOH_DiagSessionRequest</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_SOH_DiagSessionRequest</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_DIAG_SSC_InitialReflashFlag_WrtStatus</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/DIAG_SSC_InitialReflashFlag_WrtStatus</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
  	            <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SUSD_DIAG_BatteryVoltage_DisableNVMWrite</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/BatteryVoltage_DisableNVMWrite</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«REM» [$Satisfies $SDD_DIAG 097] «ENDREM-»
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_DIAG_BswM_controlDTCSetting</SHORT-NAME>
                  <REQUIRED-COM-SPECS>
                    <MODE-SWITCH-RECEIVER-COM-SPEC>
                      <ENHANCED-MODE-API>true</ENHANCED-MODE-API>
                      <MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/GM_SUM/Interfaces/SUM_ControlDTCSetting/ControlDTCSetting</MODE-GROUP-REF>
                      <SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>true</SUPPORTS-ASYNCHRONOUS-MODE-SWITCH>
                    </MODE-SWITCH-RECEIVER-COM-SPEC>
                  </REQUIRED-COM-SPECS>
                  <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/GM_SUM/Interfaces/SUM_ControlDTCSetting</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_Com_DIAG_BSPMP_RmtProgmActvAuth</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/SUM_DIAG/Component/BSPMP_RmtProgmActvAuth_Signal</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PP_DIAG_SWC_RmtPrgmOtaPsf_Status</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_RmtPrgmOtaPsf</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
            «IF (!Diag_SsfmIsSinglePortSupported(sSFM))-»
                <R-PORT-PROTOTYPE>
	              <SHORT-NAME>RP_SSFM_DIAG_BSPMP_RmtProgmActvAuth_FsFA</SHORT-NAME>
	              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SignalGroup_FsFA</REQUIRED-INTERFACE-TREF>
	            </R-PORT-PROTOTYPE>
            «ELSE-»
	            <R-PORT-PROTOTYPE>
	              <SHORT-NAME>RP_SSFM_DIAG_BSPMP_RmtProgmActvAuth_FxFA</SHORT-NAME>
	              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SignalGroup_FxFA</REQUIRED-INTERFACE-TREF>
	            </R-PORT-PROTOTYPE>
            «ENDIF-»
              </PORTS>
              <INTERNAL-BEHAVIORS>
                <SWC-INTERNAL-BEHAVIOR>
                  <SHORT-NAME>SUM_DIAG_IB</SHORT-NAME>
                  <DATA-TYPE-MAPPING-REFS>
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/SUM_DIAG/Component/Communication_Mode_DTMS</DATA-TYPE-MAPPING-REF>
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/BswM_Modes/DiagSession_DTMS</DATA-TYPE-MAPPING-REF>
					<DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/BswM_Modes/DTCSetting_DTMS</DATA-TYPE-MAPPING-REF>
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/BswM_Modes/DTMS_ECUM_MODE</DATA-TYPE-MAPPING-REF>
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/GM_SUM/Infrastructure/DTMS_ControlDTCSetting</DATA-TYPE-MAPPING-REF>
                    «IF Diag_IsOTAServiceBased(diag.diagGeneral)-»
                    <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">«diag.diagGeneral.dIAG_ServiceBased_OTA_DataTypeMappingSet»</DATA-TYPE-MAPPING-REF>
                    «ENDIF-»
                  </DATA-TYPE-MAPPING-REFS>
                  <AR-TYPED-PER-INSTANCE-MEMORYS>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>TesterSourceAddress</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>Ecu_Address</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                  </AR-TYPED-PER-INSTANCE-MEMORYS>
                  <EVENTS>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_Main</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_DIAG_Main</START-ON-EVENT-REF>
                      <PERIOD>«diag.diagGeneral.dIAG_TE_Main_Period / 1000.0»</PERIOD>
                    </TIMING-EVENT>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_Shutdown_Permission</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_Shutdown_Permission</START-ON-EVENT-REF>
                      <PERIOD>«diag.diagGeneral.dIAG_TE_Shutdown_Permission_Period / 1000.0»</PERIOD>
                    </TIMING-EVENT>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_BswM_ModeUser</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_BswM_ModeUser</START-ON-EVENT-REF>
                      <PERIOD>«diag.diagGeneral.dIAG_TE_BswM_ModeUser_Period / 1000.0»</PERIOD>
                    </TIMING-EVENT>
                    <TIMING-EVENT>
                      <SHORT-NAME>TE_MEC_Handler</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_MEC_Handler</START-ON-EVENT-REF>
                      <PERIOD>«diag.diagGeneral.dIAG_TE_MEC_Handler_Period / 1000.0»</PERIOD>
                    </TIMING-EVENT>
					<TIMING-EVENT>
                      <SHORT-NAME>TE_OTA_PSF</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_OTA_PSF</START-ON-EVENT-REF>
                      <PERIOD>«diag.diagGeneral.dIAG_TE_OTA_PSF_Period / 1000.0»</PERIOD>
                    </TIMING-EVENT>
                    <SWC-MODE-SWITCH-EVENT>
                      <SHORT-NAME>MSE_SwitchedToDefault</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_SwitchedToDefaultSession</START-ON-EVENT-REF>
		              <ACTIVATION>ON-ENTRY</ACTIVATION>
                      <MODE-IREFS>
                      <MODE-IREF>
                         <CONTEXT-PORT-REF DEST="R-PORT-PROTOTYPE">/SUM_DIAG/Component/SUM_DIAG/BswM_DiagSession</CONTEXT-PORT-REF>
                         <CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/BswM_Modes/DIAG_BswM_DiagSession/SUM_DIAG_SESSION</CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF>
                         <TARGET-MODE-DECLARATION-REF DEST="MODE-DECLARATION">/BswM_Modes/MDG_BswM_DiagSession/DEFAULT_SESSION</TARGET-MODE-DECLARATION-REF>
                       </MODE-IREF>
                       </MODE-IREFS>
                    </SWC-MODE-SWITCH-EVENT>
                    <OPERATION-INVOKED-EVENT>
                      <SHORT-NAME>OIE_RequestHandler_Indication</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_RequestHandler_Indication</START-ON-EVENT-REF>
                      <OPERATION-IREF>
                        <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_DIAG/Component/SUM_DIAG/DIAG_RequestHandler</CONTEXT-P-PORT-REF>
                        <TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_Dcm/PortInterfaces/ServiceRequestNotification/Indication</TARGET-PROVIDED-OPERATION-REF>
                      </OPERATION-IREF>
                    </OPERATION-INVOKED-EVENT>
                    <OPERATION-INVOKED-EVENT>
                      <SHORT-NAME>OIE_RequestHandler_Confirmation</SHORT-NAME>
                      <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/Runnable_RequestHandler_Confirmation</START-ON-EVENT-REF>
                      <OPERATION-IREF>
                        <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_DIAG/Component/SUM_DIAG/DIAG_RequestHandler</CONTEXT-P-PORT-REF>
                        <TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_Dcm/PortInterfaces/ServiceRequestNotification/Confirmation</TARGET-PROVIDED-OPERATION-REF>
                      </OPERATION-IREF>
                    </OPERATION-INVOKED-EVENT>
                    <OPERATION-INVOKED-EVENT>
					  <SHORT-NAME>OIE_ConditionCheckRead</SHORT-NAME>
					  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/ConditionCheckRead</START-ON-EVENT-REF>
					  <OPERATION-IREF>
						<CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_DIAG/Component/SUM_DIAG/PP_DIAG_DID_F1A0_ManufacturersEnableCounter</CONTEXT-P-PORT-REF>
						<TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_Dcm/PortInterfaces/DataServices_«diag.diagGeneral.dIAG_DID_F1A0_MEC_Reference.shortName»/ConditionCheckRead</TARGET-PROVIDED-OPERATION-REF>
					  </OPERATION-IREF>
                    </OPERATION-INVOKED-EVENT>
					<OPERATION-INVOKED-EVENT>
					  <SHORT-NAME>OIE_ReadData</SHORT-NAME>
					  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/ReadData</START-ON-EVENT-REF>
					  <OPERATION-IREF>
						<CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_DIAG/Component/SUM_DIAG/PP_DIAG_DID_F1A0_ManufacturersEnableCounter</CONTEXT-P-PORT-REF>
						<TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_Dcm/PortInterfaces/DataServices_«diag.diagGeneral.dIAG_DID_F1A0_MEC_Reference.shortName»/ReadData</TARGET-PROVIDED-OPERATION-REF>
					  </OPERATION-IREF>
					</OPERATION-INVOKED-EVENT>
					<OPERATION-INVOKED-EVENT>
					  <SHORT-NAME>OIE_WriteData</SHORT-NAME>
					  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/SUM_DIAG/Component/SUM_DIAG/SUM_DIAG_IB/WriteData</START-ON-EVENT-REF>
					  <OPERATION-IREF>
						<CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/SUM_DIAG/Component/SUM_DIAG/PP_DIAG_DID_F1A0_ManufacturersEnableCounter</CONTEXT-P-PORT-REF>
						<TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_Dcm/PortInterfaces/DataServices_«diag.diagGeneral.dIAG_DID_F1A0_MEC_Reference.shortName»/WriteData</TARGET-PROVIDED-OPERATION-REF>
					  </OPERATION-IREF>
					</OPERATION-INVOKED-EVENT>
«IF (diag.diagGeneral.dIAG_DID_F1B0_Reference != null)-»
					<OPERATION-INVOKED-EVENT>
					  <SHORT-NAME>OIE_F1B0_ReadData</SHORT-NAME>
