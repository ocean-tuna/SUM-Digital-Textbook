<workflow>
	<!-- include of properties files with global settings -->
    <property file="oaw.properties"/>

  <!-- Property file containing model package and generator version info -->
	<property file="Diag_Workflow.properties"/>
   <!-- Property file containing model and editor version info -->
   	  <property file="model_tool_version.properties"/>

	<!-- generate Diag_Cfg.h -->
	 <component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<!--<fileEncoding value="ISO-8859-1"/>-->
		 <metaModel id="mm"
			class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<globalVarDef name="gen_ver" value="'${gen_ver}'"/>
		<globalVarDef name="model_ver" value="'${model_ver}'"/>
		<expand value="SUM_Diag_Cfg_h::Root FOR model" />
		<outlet path='${OutputDir}' />
	</component>

	<!-- generate Diag_Cfg.c -->
	 <component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<!--<fileEncoding value="ISO-8859-1"/>-->
		 <metaModel id="mm"
			class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<globalVarDef name="gen_ver" value="'${gen_ver}'"/>
		<globalVarDef name="model_ver" value="'${model_ver}'"/>
		<expand value="SUM_Diag_Cfg_c::Root FOR model" />
		<outlet path='${OutputDir}' />
	</component>

	<!-- generate Diag_Cfg_SWCD.arxml -->
	 <component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<!--<fileEncoding value="ISO-8859-1"/>-->
		 <metaModel id="mm"
			class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<globalVarDef name="gen_ver" value="'${gen_ver}'"/>
		<globalVarDef name="model_ver" value="'${model_ver}'"/>
		<expand value="SUM_Diag_Cfg_SWCD_arxml::Root FOR model" />
		<outlet path='${OutputDir}' />
	</component>

	<!-- generate SUM_Diag_Runnables.c -->
	 <component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<!--<fileEncoding value="ISO-8859-1"/>-->
		 <metaModel id="mm"
			class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<globalVarDef name="gen_ver" value="'${gen_ver}'"/>
		<globalVarDef name="model_ver" value="'${model_ver}'"/>
		<expand value="SUM_Diag_Runnables_c::Root FOR model" />
		<outlet path='${OutputDir}' />
	</component>

	<!-- generate SUM_Diag_Services.c -->
	 <component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<!--<fileEncoding value="ISO-8859-1"/>-->
		 <metaModel id="mm"
			class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<globalVarDef name="gen_ver" value="'${gen_ver}'"/>
		<globalVarDef name="model_ver" value="'${model_ver}'"/>
		<expand value="SUM_Diag_Services_c::Root FOR model" />
		<outlet path='${OutputDir}' />
	</component>

</workflow>