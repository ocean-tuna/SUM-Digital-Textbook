<?xml version="1.0" encoding="UTF-8"?>
<BUILD-ACTION-MANIFEST xsi:schemaLocation="http://bosch.com/schema/buildActionManifest/r1.0 BuildActionManifest_1-0-2.xsd" xmlns="http://bosch.com/schema/buildActionManifest/r1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <SHORT-NAME>RB_Manifest</SHORT-NAME>
  <BUILD-ACTIONS>
    <BUILD-ACTION>
      <SHORT-NAME>Diag_Validate</SHORT-NAME>
      <CATEGORY>VALIDATOR</CATEGORY>
      <INVOCATION>
        <SDGS>
          <SDG>
            <SD GID="VARIANT">1</SD>
            <SD GID="ACTION_ATTRIBUTE_singleExecutable">true</SD>
            <SD GID="STOP_ON_ERROR">true</SD>
            <SD GID="INPUT_VALIDATION1">true</SD>
          </SDG>
        </SDGS>
      </INVOCATION>
      <FOLLOW-UP-ACTION-REFS>
        <FOLLOW-UP-ACTION-REF DEST="BUILD-ACTION">/RB_Manifest/Diag_Generator</FOLLOW-UP-ACTION-REF>
      </FOLLOW-UP-ACTION-REFS>
      <INPUT-DATAS>
        <BUILD-ACTION-IO-ELEMENT>
          <CATEGORY>ARTIFACT</CATEGORY>
          <SDGS>
            <SDG>
              <SD GID="USED_ACTION_ROLE">PROCESSOR</SD>
            </SDG>
          </SDGS>
          <ENGINEERING-OBJECTS>
            <BUILD-ENGINEERING-OBJECT>
              <SHORT-LABEL>Diag_Validate</SHORT-LABEL>
              <CATEGORY>CONFWF</CATEGORY>
              <DOMAIN>CUBAS</DOMAIN>
              <FILE-TYPE>oaw</FILE-TYPE>
            </BUILD-ENGINEERING-OBJECT>
          </ENGINEERING-OBJECTS>
        </BUILD-ACTION-IO-ELEMENT>
        <BUILD-ACTION-IO-ELEMENT>
          <CATEGORY>AR_OBJECT</CATEGORY>
          <ECUC-DEFINITION-REF DEST="ECUC-DEFINITION-ELEMENT">/AUTOSAR_Diag_Diag/EcucModuleDefs/Diag</ECUC-DEFINITION-REF>
        </BUILD-ACTION-IO-ELEMENT>
      </INPUT-DATAS>
      <REQUIRED-ENVIRONMENT-REF DEST="BUILD-ACTION-ENVIRONMENT">/RB_Manifest/com_bosch_configfw_bfwaction_oaw</REQUIRED-ENVIRONMENT-REF>
    </BUILD-ACTION>
    <BUILD-ACTION>
      <SHORT-NAME>Diag_Generator</SHORT-NAME>
      <CATEGORY>GENERATOR</CATEGORY>
      <INVOCATION>
        <SDGS>
          <SDG>
            <SD GID="VARIANT">1</SD>
            <SD GID="ACTION_ATTRIBUTE_singleExecutable">true</SD>
            <SD GID="STOP_ON_ERROR">true</SD>
          </SDG>
        </SDGS>
      </INVOCATION>
      <PREDECESSOR-ACTION-REFS>
        <PREDECESSOR-ACTION-REF DEST="BUILD-ACTION">/RB_Manifest/Diag_Validate</PREDECESSOR-ACTION-REF>
      </PREDECESSOR-ACTION-REFS>
      <CREATED-DATAS>
        <BUILD-ACTION-IO-ELEMENT>
          <CATEGORY>ARTIFACT</CATEGORY>
          <SDGS>
            <SDG>
              <SD GID="ROLE_PROVIDER_TYPE">MDF</SD>
              <SD GID="USED_ACTION_ROLE">DEFAULT_OUT</SD>
            </SDG>
          </SDGS>
          <ENGINEERING-OBJECTS>
            <BUILD-ENGINEERING-OBJECT>
              <SHORT-LABEL>SUM_Diag_*</SHORT-LABEL>
              <CATEGORY>PJTHDR</CATEGORY>
              <DOMAIN>CUBAS</DOMAIN>
              <FILE-TYPE>h</FILE-TYPE>
            </BUILD-ENGINEERING-OBJECT>
          </ENGINEERING-OBJECTS>
        </BUILD-ACTION-IO-ELEMENT>
        <BUILD-ACTION-IO-ELEMENT>
          <CATEGORY>ARTIFACT</CATEGORY>
          <SDGS>
            <SDG>
              <SD GID="ROLE_PROVIDER_TYPE">MDF</SD>
              <SD GID="USED_ACTION_ROLE">DEFAULT_OUT</SD>
            </SDG>
          </SDGS>
          <ENGINEERING-OBJECTS>
            <BUILD-ENGINEERING-OBJECT>
              <SHORT-LABEL>SUM_Diag_*</SHORT-LABEL>
              <CATEGORY>PJTSWCD</CATEGORY>
              <DOMAIN>CUBAS</DOMAIN>
              <FILE-TYPE>arxml</FILE-TYPE>
            </BUILD-ENGINEERING-OBJECT>
          </ENGINEERING-OBJECTS>
        </BUILD-ACTION-IO-ELEMENT>
        <BUILD-ACTION-IO-ELEMENT>
          <CATEGORY>ARTIFACT</CATEGORY>
          <SDGS>
            <SDG>
              <SD GID="ROLE_PROVIDER_TYPE">MDF</SD>
              <SD GID="USED_ACTION_ROLE">DEFAULT_OUT</SD>
            </SDG>
          </SDGS>
          <ENGINEERING-OBJECTS>
            <BUILD-ENGINEERING-OBJECT>
              <SHORT-LABEL>SUM_Diag_*</SHORT-LABEL>
              <CATEGORY>PJTSRC</CATEGORY>
              <DOMAIN>CUBAS</DOMAIN>
              <FILE-TYPE>c</FILE-TYPE>
            </BUILD-ENGINEERING-OBJECT>
          </ENGINEERING-OBJECTS>
        </BUILD-ACTION-IO-ELEMENT>
      </CREATED-DATAS>
      <INPUT-DATAS>
        <BUILD-ACTION-IO-ELEMENT>
          <CATEGORY>ARTIFACT</CATEGORY>
          <SDGS>
            <SDG>
              <SD GID="USED_ACTION_ROLE">PROCESSOR</SD>
            </SDG>
          </SDGS>
          <ENGINEERING-OBJECTS>
            <BUILD-ENGINEERING-OBJECT>
              <SHORT-LABEL>Diag_Generate</SHORT-LABEL>
              <CATEGORY>CONFWF</CATEGORY>
              <DOMAIN>CUBAS</DOMAIN>
              <FILE-TYPE>oaw</FILE-TYPE>
            </BUILD-ENGINEERING-OBJECT>
          </ENGINEERING-OBJECTS>
        </BUILD-ACTION-IO-ELEMENT>
        <BUILD-ACTION-IO-ELEMENT>
          <CATEGORY>AR_OBJECT</CATEGORY>
          <ECUC-DEFINITION-REF DEST="ECUC-DEFINITION-ELEMENT">/AUTOSAR_Diag_Diag/EcucModuleDefs/Diag</ECUC-DEFINITION-REF>
        </BUILD-ACTION-IO-ELEMENT>
      </INPUT-DATAS>
      <REQUIRED-ENVIRONMENT-REF DEST="BUILD-ACTION-ENVIRONMENT">/RB_Manifest/com_bosch_configfw_bfwaction_oaw</REQUIRED-ENVIRONMENT-REF>
    </BUILD-ACTION>
  </BUILD-ACTIONS>
</BUILD-ACTION-MANIFEST>
