                          <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                          <INIT-VALUE>
                          <NUMERICAL-VALUE-SPECIFICATION>
                            <VALUE>«Responder.lNM_Internal_Electronic_Failure_Supported»</VALUE>
                          </NUMERICAL-VALUE-SPECIFICATION>
                          </INIT-VALUE>
                      </PARAMETER-DATA-PROTOTYPE>
                  «ENDFOREACH-»
                «ENDFOREACH-»
                «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
                  «FOREACH Network.lNM_Responders AS Responder -»
                    «IF Responder.lNM_Responder_Device_Not_Configured_Supported == true -»
                <PARAMETER-DATA-PROTOTYPE>
                  <SHORT-NAME>LNM_Config_Retries_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                  <INIT-VALUE>
                    <NUMERICAL-VALUE-SPECIFICATION>
                      <VALUE>«Responder.lNM_Config_Retries -»</VALUE>
                    </NUMERICAL-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </PARAMETER-DATA-PROTOTYPE>
                    «ENDIF -»
                  «ENDFOREACH -»
                «ENDFOREACH -»
                «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
					      <PARAMETER-DATA-PROTOTYPE>
                  <SHORT-NAME>LNM_C_DTC_«Network.shortName -»_LINBusOff</SHORT-NAME>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                  <INIT-VALUE>
                  <NUMERICAL-VALUE-SPECIFICATION>
                    <VALUE>«Network.lNM_C_DTC_LINBusOff ? 1 : 0»</VALUE>
                  </NUMERICAL-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </PARAMETER-DATA-PROTOTYPE>
                «ENDFOREACH -»
                <PARAMETER-DATA-PROTOTYPE>
                  <SHORT-NAME>LNM_C_DTC_LostCommWithLinResp</SHORT-NAME>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                  <INIT-VALUE>
                    <NUMERICAL-VALUE-SPECIFICATION>
                      <VALUE>«lNM.lNM_General.lNM_C_DTC_LostCommWithLinResp_Enabled ? 1 : 0-»</VALUE>
                    </NUMERICAL-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </PARAMETER-DATA-PROTOTYPE>
<!-- Satisfies: [$SDD_LNM 515] -->
				«FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
				<PARAMETER-DATA-PROTOTYPE>
                  <SHORT-NAME>LNM_C_PreSleepDelay_«Network.shortName -»</SHORT-NAME>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-WRITE</SW-CALIBRATION-ACCESS>
                        <SW-IMPL-POLICY>STANDARD</SW-IMPL-POLICY>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                  <INIT-VALUE>
                    <NUMERICAL-VALUE-SPECIFICATION>
                      <VALUE>«Network.lNM_C_PreSleepDelay -»</VALUE>
                    </NUMERICAL-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </PARAMETER-DATA-PROTOTYPE>
				«ENDFOREACH -»
              </SHARED-PARAMETERS>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
        <SWC-IMPLEMENTATION>
	      <SHORT-NAME>SwcImplementation_IB_LNM</SHORT-NAME>
	       <CODE-DESCRIPTORS>
	        <CODE>
	          <SHORT-NAME>Code_LNM</SHORT-NAME>
	          <ARTIFACT-DESCRIPTORS>
	            <AUTOSAR-ENGINEERING-OBJECT>
	              <SHORT-LABEL>AEO1</SHORT-LABEL>
	              <CATEGORY>SWSRC</CATEGORY>
	            </AUTOSAR-ENGINEERING-OBJECT>
	          </ARTIFACT-DESCRIPTORS>
	        </CODE>
	      </CODE-DESCRIPTORS>
	      <PROGRAMMING-LANGUAGE>C</PROGRAMMING-LANGUAGE>
	      <BEHAVIOR-REF DEST="SWC-INTERNAL-BEHAVIOR">/LNM/SUM_LNM/IB_LNM</BEHAVIOR-REF>
        </SWC-IMPLEMENTATION>
      </ELEMENTS>
	  <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Interfaces</SHORT-NAME>
		    <ELEMENTS>
		      «IF lNM.lNM_General.cyberFill_Supported != false -»
		      <SENDER-RECEIVER-INTERFACE>
                <SHORT-NAME>CyberFill</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <DATA-ELEMENTS>
                  <VARIABLE-DATA-PROTOTYPE>
                    <SHORT-NAME>DataElements_VariableDataPrototype</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                  </VARIABLE-DATA-PROTOTYPE>
                </DATA-ELEMENTS>
              </SENDER-RECEIVER-INTERFACE>
              «ENDIF -»
              «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
              <SENDER-RECEIVER-INTERFACE>
                <SHORT-NAME>LNM_ActivationSignal</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <DATA-ELEMENTS>
                  <VARIABLE-DATA-PROTOTYPE>
                    <SHORT-NAME>ActivationSignal</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                  </VARIABLE-DATA-PROTOTYPE>
                </DATA-ELEMENTS>
              </SENDER-RECEIVER-INTERFACE>
              <SENDER-RECEIVER-INTERFACE>
                <SHORT-NAME>LNM_ScheduleSignal_boolean</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <DATA-ELEMENTS>
                  <VARIABLE-DATA-PROTOTYPE>
                    <SHORT-NAME>ScheduleSignal</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                  </VARIABLE-DATA-PROTOTYPE>
                </DATA-ELEMENTS>
              </SENDER-RECEIVER-INTERFACE>
              <SENDER-RECEIVER-INTERFACE>
                <SHORT-NAME>LNM_ScheduleSignal_uint8</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <DATA-ELEMENTS>
                  <VARIABLE-DATA-PROTOTYPE>
                    <SHORT-NAME>ScheduleSignal</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                  </VARIABLE-DATA-PROTOTYPE>
                </DATA-ELEMENTS>
              </SENDER-RECEIVER-INTERFACE>
              <SENDER-RECEIVER-INTERFACE>
                <SHORT-NAME>LNM_ScheduleSignal_uint16</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <DATA-ELEMENTS>
                  <VARIABLE-DATA-PROTOTYPE>
                    <SHORT-NAME>ScheduleSignal</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                  </VARIABLE-DATA-PROTOTYPE>
                </DATA-ELEMENTS>
              </SENDER-RECEIVER-INTERFACE>
              «ENDIF -»
              «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
                «IF Network.lNM_MSCL_Strategy.matches("Evaluation") == true -»
                  «FOREACH Network.lNM_Responders AS Responder -»
              <PARAMETER-INTERFACE>
                <SHORT-NAME>LNM_«Network.shortName -»_«Responder.shortName -»_ResponderPresent</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <PARAMETERS>
                  <PARAMETER-DATA-PROTOTYPE>
                    <SHORT-NAME>«Network.shortName -»_«Responder.shortName -»_ResponderPresent</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                  </PARAMETER-DATA-PROTOTYPE>
                </PARAMETERS>
              </PARAMETER-INTERFACE>
                  «ENDFOREACH -»
                «ENDIF -»
              «ENDFOREACH -»
              <SENDER-RECEIVER-INTERFACE>
                <SHORT-NAME>LNM_APINFO2</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <DATA-ELEMENTS>
                  <VARIABLE-DATA-PROTOTYPE>
                    <SHORT-NAME>APINFO2</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                    <INIT-VALUE>
                      <NUMERICAL-VALUE-SPECIFICATION>
                        <VALUE>0</VALUE>
                      </NUMERICAL-VALUE-SPECIFICATION>
                    </INIT-VALUE>
                  </VARIABLE-DATA-PROTOTYPE>
                </DATA-ELEMENTS>
              </SENDER-RECEIVER-INTERFACE>
              <SENDER-RECEIVER-INTERFACE>
                <SHORT-NAME>LNM_APINFO4</SHORT-NAME>
                <IS-SERVICE>false</IS-SERVICE>
                <DATA-ELEMENTS>
                  <VARIABLE-DATA-PROTOTYPE>
                    <SHORT-NAME>APINFO4</SHORT-NAME>
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                    <INIT-VALUE>
                      <NUMERICAL-VALUE-SPECIFICATION>
                        <VALUE>0</VALUE>
                      </NUMERICAL-VALUE-SPECIFICATION>
                    </INIT-VALUE>
                  </VARIABLE-DATA-PROTOTYPE>
                </DATA-ELEMENTS>
              </SENDER-RECEIVER-INTERFACE>
              <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>LNM_APINFO3</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>APINFO3</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                  <INIT-VALUE>
                    <NUMERICAL-VALUE-SPECIFICATION>
                      <VALUE>0</VALUE>
                    </NUMERICAL-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
			</ELEMENTS>
		</AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>

</AUTOSAR>



«ENDFILE»
«ENDDEFINE»