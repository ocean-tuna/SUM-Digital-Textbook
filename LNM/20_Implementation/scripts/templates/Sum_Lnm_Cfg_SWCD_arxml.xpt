  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>LNM</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>SUM_LNM</SHORT-NAME>
          <PORTS>
            <!-- Satisfies: [$SDD_LNM 497] [$SDD_LNM 498] [$SDD_LNM 499] [$SDD_LNM 500] -->
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_SUSD_ShutdownPermission</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/LNM_ShutdownPermission</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
	        «IF lNM.lNM_General.cyberFill_Supported != false -»
	        <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_Cyberfill</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LNM/Interfaces/CyberFill</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
	        «ENDIF -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_SUSD_LNM_PermitExecution</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUSD_PermitExecution</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_WdgM_LNM_LocalSupervision</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_WdgM/PortInterfaces/WdgM_LocalSupervision</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
            «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
            «IF Network.lNM_ActivationSignalType.matches("Rule") == false -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_LNM_ActivationSignal_«Network.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LNM/Interfaces/LNM_ActivationSignal</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            «ENDIF -»
              «IF Network.lNM_ActivationSignalType.matches("Com") == true -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_LNM_ActivationSignal_Av_«Network.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/RxMonitoredSignal_Av</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
              «ENDIF -»
            «ENDIF -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_LNM_BswM_LinSM_CurrentState_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/LNM/Interfaces/LNM_CurrentComMode_LNMNetwork_«Network.lNM_Network_ID-»</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_LNM_BswM_LinSM_CurrentSchedule_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/LNM/Interfaces/LNM_CurrentSchedule_LNMNetwork_«Network.lNM_Network_ID -»</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_BswM_ComM_RequestComMode_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/LNM/Interfaces/LNM_RequestComMode_LNMNetwork_«Network.lNM_Network_ID-»</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_BswM_LinSM_ScheduleRequest_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/LNM/Interfaces/LNM_RequestSchedule_LNMNetwork_«Network.lNM_Network_ID -»</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            «ENDFOREACH -»
            «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
            «FOREACH lNM.lNM_Arbitration.lNM_Inputs.lNM_ScheduleSignal AS ScheduleSignal -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_LNM_ScheduleSignal_«ScheduleSignal.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LNM/Interfaces/LNM_ScheduleSignal_«ScheduleSignal.lNM_ScheduleSignalType -»</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
              «IF ScheduleSignal.lNM_ScheduleSignalSource.matches("Com") == true -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_LNM_ScheduleSignal_Av_«ScheduleSignal.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/RxMonitoredSignal_Av</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
              «ENDIF -»
            «ENDFOREACH -»
            «ENDIF -»
            «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
              «IF Network.lNM_MSCL_Strategy.matches("Evaluation") == true -»
                «FOREACH Network.lNM_Responders AS Responder -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_LNM_Cal_«Network.shortName -»_«Responder.shortName -»_ResponderPresent</SHORT-NAME>
			  <REQUIRED-COM-SPECS>
                <PARAMETER-REQUIRE-COM-SPEC>
                  <INIT-VALUE>
                    <NUMERICAL-VALUE-SPECIFICATION>
                      <SHORT-LABEL>NumericalValueSpecification_0</SHORT-LABEL>
                      <VALUE>0</VALUE>
                    </NUMERICAL-VALUE-SPECIFICATION>
                  </INIT-VALUE>
                  <PARAMETER-REF DEST="PARAMETER-DATA-PROTOTYPE">/LNM/Interfaces/LNM_«Network.shortName -»_«Responder.shortName -»_ResponderPresent/«Network.shortName -»_«Responder.shortName -»_ResponderPresent</PARAMETER-REF>
                </PARAMETER-REQUIRE-COM-SPEC>
              </REQUIRED-COM-SPECS>
              <REQUIRED-INTERFACE-TREF DEST="PARAMETER-INTERFACE">/LNM/Interfaces/LNM_«Network.shortName -»_«Responder.shortName -»_ResponderPresent</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
                «ENDFOREACH -»
              «ENDIF -»
            «ENDFOREACH -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_NvM_MSCL</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_NvM/PortInterfaces/NvMService</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_«Network.shortName -»_LNM_SSM_MSCL</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/LNM_SSM_MSCL_LIN</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            «ENDFOREACH -»
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_Dcm_DID_MSCL</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«lNM.lNM_General.lNM_DID_F1BE_Reference.dcmDspDidSignal.get(0).dcmDspDidDataRef.shortName -»</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
              «FOREACH Network.lNM_Responders AS Responder -»
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_ERRH_NodeStatusIdx_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/LNM_ERRH_NodeStatusId</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_SSM_LNM_NodeTimeout_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SSM_LNM_NodeTimeout</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
                «IF Responder.lNM_Internal_Electronic_Failure_Supported == true -»
                  «IF Responder.lNM_IEF_APINFO2_Supported == true -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_COM_LNM_APINFO2_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LNM/Interfaces/LNM_APINFO2</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
                  «ENDIF -»
                  «IF Responder.lNM_IEF_APINFO4_Supported == true -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_COM_LNM_APINFO4_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LNM/Interfaces/LNM_APINFO4</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
                  «ENDIF -»
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_ERRH_IntElectFault_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/LNM_ERRH_IntElectFault</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
                «ENDIF -»
                «IF Responder.lNM_Responder_Device_Not_Configured_Supported == true -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_COM_LNM_APINFO3_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LNM/Interfaces/LNM_APINFO3</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_ERRH_NotConfigured_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/LNM_ERRH_NotConfigured</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
                «ENDIF -»
              «ENDFOREACH -»
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>PP_LNM_ERRH_LossCommBus_«Network.shortName -»</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/LNM_ERRH_LossCommBus</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            «ENDFOREACH -»
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RP_SUSD_LNM_VehiclePowerMode</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUSD_VehiclePowerMode</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>IB_LNM</SHORT-NAME>
              <DATA-TYPE-MAPPING-REFS>
                <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/LNM/Interfaces/LNM_DataTypeMappingSet</DATA-TYPE-MAPPING-REF>
              </DATA-TYPE-MAPPING-REFS>
              <EVENTS>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_MainFunction</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_MainFunction</START-ON-EVENT-REF>
                  <PERIOD>«lNM.lNM_General.lNM_MainFunction_Period -»</PERIOD>
                </TIMING-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_NetworkStatus</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_NetworkStatus</START-ON-EVENT-REF>
                  <PERIOD>«lNM.lNM_General.lNM_NetworkStatus_Period -»</PERIOD>
                </TIMING-EVENT>
                «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
                «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
                «IF Network.lNM_ActivationSignalType.matches("Rule") == false -»
                <DATA-RECEIVED-EVENT>
                  <SHORT-NAME>DRE_Activation_«Network.shortName -»</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_Activation_«Network.shortName -»</START-ON-EVENT-REF>
                  <DATA-IREF>
                    <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_LNM_ActivationSignal_«Network.shortName -»</CONTEXT-R-PORT-REF>
                    <TARGET-DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/LNM/Interfaces/LNM_ActivationSignal/ActivationSignal</TARGET-DATA-ELEMENT-REF>
                  </DATA-IREF>
                </DATA-RECEIVED-EVENT>
                «ELSE -»
                «FOREACH sum_Lnm_ActivationRuleSignalsExceptVPM(Network) AS Signal -»
                <DATA-RECEIVED-EVENT>
                  <SHORT-NAME>DRE_Activation_«Signal.shortName -»</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_Activation_«Network.shortName -»</START-ON-EVENT-REF>
                  <DATA-IREF>
                    <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_LNM_ScheduleSignal_«Signal.shortName -»</CONTEXT-R-PORT-REF>
                    <TARGET-DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/LNM/Interfaces/LNM_ScheduleSignal_«Signal.lNM_ScheduleSignalType -»/ScheduleSignal</TARGET-DATA-ELEMENT-REF>
                  </DATA-IREF>
                </DATA-RECEIVED-EVENT>
                «ENDFOREACH -»
                «ENDIF -»
                «ENDFOREACH -»
                «ENDIF -»
                <TIMING-EVENT>
                  <SHORT-NAME>TE_ScheduleManagement</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_ScheduleManagement</START-ON-EVENT-REF>
                  <PERIOD>«lNM.lNM_General.lNM_ScheduleManagement_Period -»</PERIOD>
                </TIMING-EVENT>
                <OPERATION-INVOKED-EVENT>
                  <SHORT-NAME>OIE_DID_MSCL_CheckRead</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_DID_MSCL_CheckRead</START-ON-EVENT-REF>
                  <OPERATION-IREF>
                    <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/LNM/SUM_LNM/PP_LNM_Dcm_DID_MSCL</CONTEXT-P-PORT-REF>
                    <TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_Dcm/PortInterfaces/DataServices_«lNM.lNM_General.lNM_DID_F1BE_Reference.dcmDspDidSignal.get(0).dcmDspDidDataRef.shortName -»/ConditionCheckRead</TARGET-PROVIDED-OPERATION-REF>
                  </OPERATION-IREF>
                </OPERATION-INVOKED-EVENT>
                <OPERATION-INVOKED-EVENT>
                  <SHORT-NAME>OIE_DID_MSCL_ReadData</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_DID_MSCL_ReadData</START-ON-EVENT-REF>
                  <OPERATION-IREF>
                    <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/LNM/SUM_LNM/PP_LNM_Dcm_DID_MSCL</CONTEXT-P-PORT-REF>
                    <TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/AUTOSAR_Dcm/PortInterfaces/DataServices_«lNM.lNM_General.lNM_DID_F1BE_Reference.dcmDspDidSignal.get(0).dcmDspDidDataRef.shortName -»/ReadData</TARGET-PROVIDED-OPERATION-REF>
                  </OPERATION-IREF>
                </OPERATION-INVOKED-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>TE_NetworkFaultManager</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_NetworkFaultManager</START-ON-EVENT-REF>
                  <PERIOD>«lNM.lNM_General.lNM_NetworkFaultManager_Period -»</PERIOD>
                </TIMING-EVENT>
                «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
                  «FOREACH Network.lNM_Responders AS Responder -»
                    «IF Responder.lNM_Internal_Electronic_Failure_Supported == true -»
                      «IF Responder.lNM_IEF_APINFO2_Supported == true -»
                <DATA-RECEIVED-EVENT>
                  <SHORT-NAME>DRE_APINFO2_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_APINFO2_«Network.shortName -»_«Responder.shortName -»</START-ON-EVENT-REF>
                  <DATA-IREF>
                    <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_COM_LNM_APINFO2_«Network.shortName -»_«Responder.shortName -»</CONTEXT-R-PORT-REF>
                    <TARGET-DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/LNM/Interfaces/LNM_APINFO2/APINFO2</TARGET-DATA-ELEMENT-REF>
                  </DATA-IREF>
                </DATA-RECEIVED-EVENT>
                      «ENDIF -»
                    «ENDIF -»
                    «IF Responder.lNM_Responder_Device_Not_Configured_Supported == true -»
                <DATA-RECEIVED-EVENT>
                  <SHORT-NAME>DRE_APINFO3_«Network.shortName -»_«Responder.shortName -»</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/Runnable_APINFO3_«Network.shortName -»_«Responder.shortName -»</START-ON-EVENT-REF>
                  <DATA-IREF>
                    <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_COM_LNM_APINFO3_«Network.shortName -»_«Responder.shortName -»</CONTEXT-R-PORT-REF>
                    <TARGET-DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/LNM/Interfaces/LNM_APINFO3/APINFO3</TARGET-DATA-ELEMENT-REF>
                  </DATA-IREF>
                </DATA-RECEIVED-EVENT>
                    «ENDIF -»
                  «ENDFOREACH -»
                «ENDFOREACH -»
                «IF lNM.lNM_General.lnmGenerateInitRunnable == true -»
                <TIMING-EVENT>
                  <SHORT-NAME>TE_InitFunction</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/LNM/SUM_LNM/IB_LNM/RE_Lnm_Init</START-ON-EVENT-REF>
                  <PERIOD>«lNM.lNM_General.lnmInitFuncPeriodicity/1000»</PERIOD>
                </TIMING-EVENT>
                «ENDIF -»
              </EVENTS>
              <EXPLICIT-INTER-RUNNABLE-VARIABLES>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>LNM_VehiclePowerModeRunOrPropulsion</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </EXPLICIT-INTER-RUNNABLE-VARIABLES>
              <PORT-API-OPTIONS>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="P-PORT-PROTOTYPE">/LNM/SUM_LNM/PP_LNM_SUSD_ShutdownPermission</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_SUSD_LNM_PermitExecution</PORT-REF>
                </PORT-API-OPTION>
                «IF lNM.lNM_General.cyberFill_Supported != false -»
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="P-PORT-PROTOTYPE">/LNM/SUM_LNM/PP_LNM_Cyberfill</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_WdgM_LNM_LocalSupervision</PORT-REF>
                </PORT-API-OPTION>
                «ENDIF -»
                «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
                «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
                  «IF Network.lNM_ActivationSignalType.matches("Com") == true -»
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_LNM_ActivationSignal_Av_«Network.shortName -»</PORT-REF>
                </PORT-API-OPTION>
                  «ENDIF -»
                  «IF Network.lNM_ActivationSignalType.matches("Rule") == false -»
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_LNM_ActivationSignal_«Network.shortName -»</PORT-REF>
                </PORT-API-OPTION>
                  «ENDIF -»
                «ENDIF -»
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_LNM_BswM_LinSM_CurrentState_LNMNetwork_«Network.lNM_Network_ID -»</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="P-PORT-PROTOTYPE">/LNM/SUM_LNM/PP_LNM_BswM_ComM_RequestComMode_LNMNetwork_«Network.lNM_Network_ID -»</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
                  <ENABLE-TAKE-ADDRESS>true</ENABLE-TAKE-ADDRESS>
                  <INDIRECT-API>false</INDIRECT-API>
                  <PORT-REF DEST="R-PORT-PROTOTYPE">/LNM/SUM_LNM/RP_LNM_BswM_LinSM_CurrentSchedule_LNMNetwork_«Network.lNM_Network_ID -»</PORT-REF>
                </PORT-API-OPTION>
                <PORT-API-OPTION>
