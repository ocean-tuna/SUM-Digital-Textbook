«IMPORT bsw»
«IMPORT bsw::LNMModule»

«EXTENSION templates::mathlib»
«EXTENSION org::eclipse::xtend::util::stdlib::io»

«DEFINE LnmArxml FOR Autosar»
<!--Satisfies: [$SDD_LNM 509]-->
«IF lNM.lNM_General.sum_Lnm_ConfGen_Enabled == false -»
«FILE "Sum_Lnm_SWCD.arxml"-»
<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
 <!--
 ******************************************************************************
 * BEGIN: Banner
 ******************************************************************************
 *                                 ETAS GmbH
 *                      D-70469 Stuttgart, Borsigstr. 24
 ******************************************************************************
 *
 * COPYRIGHT RESERVED, 2020 ETAS GmbH. All rights reserved.
 * The reproduction, distribution and utilization of this document as well as
 * the communication of its contents to others without explicit authorization
 * is prohibited. Offenders will be held liable for the payment of damages.
 * All rights reserved in the event of the grant of a patent, utility model or
 * design.
 ******************************************************************************
 *    Administrative Information (automatically filled in)
 ******************************************************************************
 * Project     : GM SUM
 * Component   : SUM_LNM
 * Date        : Jun 26, 2026
 * Revision    : 8.0.1_rc
 * Description : LNM SWCD Interface source file
 ******************************************************************************
 * END: Banner
 ******************************************************************************
-->
<AR-PACKAGES>
    <AR-PACKAGE>
        <SHORT-NAME>LNM</SHORT-NAME>
        <AR-PACKAGES>
		    <AR-PACKAGE>
			  <SHORT-NAME>Interfaces</SHORT-NAME>
				<ELEMENTS>
					<MODE-DECLARATION-GROUP>
					  <SHORT-NAME>LNM_ComModeType</SHORT-NAME>
					  <CATEGORY>EXPLICIT_ORDER</CATEGORY>
					  <INITIAL-MODE-REF DEST="MODE-DECLARATION">/LNM/Interfaces/LNM_ComModeType/NOCOMM</INITIAL-MODE-REF>
					  <MODE-DECLARATIONS>
						<MODE-DECLARATION>
						  <SHORT-NAME>NOCOMM</SHORT-NAME>
						  <VALUE>0</VALUE>
						</MODE-DECLARATION>
						<MODE-DECLARATION>
						  <SHORT-NAME>FULLCOMM</SHORT-NAME>
						  <VALUE>1</VALUE>
						</MODE-DECLARATION>
					  </MODE-DECLARATIONS>
					</MODE-DECLARATION-GROUP>
					<DATA-TYPE-MAPPING-SET>
					  <SHORT-NAME>LNM_DataTypeMappingSet</SHORT-NAME>
					  <MODE-REQUEST-TYPE-MAPS>
						<MODE-REQUEST-TYPE-MAP>
						  <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_PlatformTypes/ImplementationDataTypes/uint8</IMPLEMENTATION-DATA-TYPE-REF>
						  <MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP">/LNM/Interfaces/LNM_ComModeType</MODE-GROUP-REF>
						</MODE-REQUEST-TYPE-MAP>
						«FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
						<MODE-REQUEST-TYPE-MAP>
						  <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_PlatformTypes/ImplementationDataTypes/uint8</IMPLEMENTATION-DATA-TYPE-REF>
						  <MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP">/LNM/Interfaces/LNM_SchHandleType_LNMNetwork_«Network.lNM_Network_ID -»</MODE-GROUP-REF>
						</MODE-REQUEST-TYPE-MAP>
						«ENDFOREACH -»
					  </MODE-REQUEST-TYPE-MAPS>
					</DATA-TYPE-MAPPING-SET>
					«FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
					<MODE-SWITCH-INTERFACE>
					  <SHORT-NAME>LNM_CurrentComMode_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
					  <IS-SERVICE>false</IS-SERVICE>
					  <MODE-GROUP>
						<SHORT-NAME>CurrentMode_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
						<TYPE-TREF DEST="MODE-DECLARATION-GROUP">/LNM/Interfaces/LNM_ComModeType</TYPE-TREF>
					  </MODE-GROUP>
					</MODE-SWITCH-INTERFACE>
					<MODE-SWITCH-INTERFACE>
					  <SHORT-NAME>LNM_RequestComMode_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
					  <IS-SERVICE>false</IS-SERVICE>
					  <MODE-GROUP>
						<SHORT-NAME>RequestMode_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
						<TYPE-TREF DEST="MODE-DECLARATION-GROUP">/LNM/Interfaces/LNM_ComModeType</TYPE-TREF>
					  </MODE-GROUP>
					</MODE-SWITCH-INTERFACE>
					<MODE-DECLARATION-GROUP>
					  <SHORT-NAME>LNM_SchHandleType_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
					  <CATEGORY>EXPLICIT_ORDER</CATEGORY>
					  <INITIAL-MODE-REF DEST="MODE-DECLARATION">/LNM/Interfaces/LNM_SchHandleType_LNMNetwork_«Network.lNM_Network_ID -»/NULL_SCHEDULE</INITIAL-MODE-REF>
					  <MODE-DECLARATIONS>
						<MODE-DECLARATION>
						  <SHORT-NAME>NULL_SCHEDULE</SHORT-NAME>
						  <VALUE>0</VALUE>
						</MODE-DECLARATION>
						«IF ((Network.lNM_ScheduleManagement != null) && (Network.lNM_ScheduleManagement.lNM_ScheduleStates != null)) -»
						«FOREACH Network.lNM_ScheduleManagement.lNM_ScheduleStates.lNM_ScheduleState AS Schedule -»
						<MODE-DECLARATION>
						  <SHORT-NAME>«Schedule.shortName -»</SHORT-NAME>
						  <VALUE>«Schedule.lNM_ScheduleRef.linSMScheduleIndex -»</VALUE>
						</MODE-DECLARATION>
						«ENDFOREACH -»
						«ENDIF -»
					  </MODE-DECLARATIONS>
					</MODE-DECLARATION-GROUP>
					<MODE-SWITCH-INTERFACE>
					  <SHORT-NAME>LNM_CurrentSchedule_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
					  <IS-SERVICE>false</IS-SERVICE>
					  <MODE-GROUP>
						<SHORT-NAME>CurrentSchedule_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
						<TYPE-TREF DEST="MODE-DECLARATION-GROUP">/LNM/Interfaces/LNM_SchHandleType_LNMNetwork_«Network.lNM_Network_ID -»</TYPE-TREF>
					  </MODE-GROUP>
					</MODE-SWITCH-INTERFACE>
					<MODE-SWITCH-INTERFACE>
					  <SHORT-NAME>LNM_RequestSchedule_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
					  <IS-SERVICE>false</IS-SERVICE>
					  <MODE-GROUP>
						<SHORT-NAME>RequestSchedule_LNMNetwork_«Network.lNM_Network_ID -»</SHORT-NAME>
						<TYPE-TREF DEST="MODE-DECLARATION-GROUP">/LNM/Interfaces/LNM_SchHandleType_LNMNetwork_«Network.lNM_Network_ID -»</TYPE-TREF>
					  </MODE-GROUP>
					</MODE-SWITCH-INTERFACE>
					«ENDFOREACH -»
				</ELEMENTS>
			</AR-PACKAGE>
		</AR-PACKAGES>
	</AR-PACKAGE>
</AR-PACKAGES>
</AUTOSAR>
«ENDFILE»
«ENDIF»
«ENDDEFINE»