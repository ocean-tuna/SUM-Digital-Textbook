/*****************************************************************************************
 * Header Includes *
 *****************************************************************************************/
#include "Rte_SUM_LNM.h"
#include "SUM_LNM_PBCfg.h"
#include "SUM_LNM_Types.h"

/*****************************************************************************************
 * Declaration of private Functions *
 *****************************************************************************************/
«FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i -»
static FUNC(boolean, SUM_LNM_CODE) LNM_Get_Cal_ResponderPresent_«Network.shortName -»(VAR(uint8,AUTOMATIC) responder_index);
«ENDFOREACH -»


/*****************************************************************************************
 * Definition of Functions *
 *****************************************************************************************/

 /******************************************************************************
* Function name: LNM_Get_MSCL_ChannelEnable
* Description: Get Channel enable calibration parameter for the selected network
* Parameters: network_index
* Return value: cal_value
 ******************************************************************************/
 /* PRQA S 3469 25 # The function like macros is used. This is necessary to get value via RTE variable */
FUNC(boolean, SUM_LNM_CODE) LNM_Get_MSCL_ChannelEnable(VAR(uint8,AUTOMATIC) network_index)
{
    VAR(boolean,AUTOMATIC) cal_value = FALSE;

    switch(network_index)
    {
        «FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i -»
        case (uint8)«i.counter0 -»:
            cal_value = Rte_CData_LNM_C_Channel_Enable_«Network.shortName -»();
            break;
        «ENDFOREACH -»
        default:
            /*Nothing to do*/
            break;
    }

    return cal_value;
}

/******************************************************************************
* Function name: LNM_Get_Cal_ResponderPresent
* Description: Get Responder Present calibration parameter for the selected responder
* Parameters: network_index, responder_index
* Return value: cal_value
 ******************************************************************************/
/* PRQA S 1532 1 # The functions are invoked by runnables or other functions in external file */
FUNC(boolean, SUM_LNM_CODE) LNM_Get_Cal_ResponderPresent(VAR(uint8,AUTOMATIC) network_index, VAR(uint8,AUTOMATIC) responder_index)
{
    VAR(boolean,AUTOMATIC) cal_value = FALSE;

    switch(network_index)
    {
        «FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i -»
        case (uint8)«i.counter0 -»:
            cal_value = LNM_Get_Cal_ResponderPresent_«Network.shortName -»(responder_index);
            break;
        «ENDFOREACH -»
        default:
            /*Nothing to do*/
            break;
    }

    return cal_value;
}

«FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i -»
/******************************************************************************
* Function name: LNM_Get_Cal_ResponderPresent_«Network.shortName »
* Description: Get Responder Present calibration parameter for the selected responder 
*              of the network.
* Parameters: responder_index
* Return value: cal_value
 ******************************************************************************/
static FUNC(boolean, SUM_LNM_CODE) LNM_Get_Cal_ResponderPresent_«Network.shortName -»(VAR(uint8,AUTOMATIC) responder_index)
{
    VAR(boolean,AUTOMATIC) cal_value = FALSE;

    switch(responder_index)
    {
        «IF Network.lNM_Responders.size > 0 -»
        /* PRQA S 3469 «Network.lNM_Responders.size * 3 - 1 -» # The function like macros is used. This is necessary to get value via RTE variable */
        «ENDIF-»
        «FOREACH Network.lNM_Responders AS Responder ITERATOR j -»
        case (uint8)«j.counter0 -»:
            «IF Network.lNM_MSCL_Strategy.matches("Calibration") -»
            cal_value = Rte_CData_LNM_C_«Network.shortName -»_«Responder.shortName -»_ResponderPresent();
            «ELSE -»
            cal_value = Rte_Prm_RP_LNM_Cal_«Network.shortName -»_«Responder.shortName -»_ResponderPresent_«Network.shortName -»_«Responder.shortName -»_ResponderPresent();
            «ENDIF -»
            break;
        «ENDFOREACH -»
        default:
            /*Nothing to do*/
            break;
    }

    return cal_value;
}

«ENDFOREACH -»
/********************************** END OF FILE ******************************************************/

«ENDFILE»
«ENDDEFINE»
