<workflow>
  <!-- Property file containing model package and generator version info -->
	<property file="LNM_workflow.properties" />

    <!-- generate LNM_PBCfg.c -->
	<component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<fileEncoding value="ISO-8859-1"/>
		<globalVarDef name="AutosarVersion" value="'${AutosarVersion}'"/>
		<globalVarDef name="FileName" value="'LNM_PBCfg.c'"/>
		<metaModel id="mm" class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<expand value="LNM_PBCfg_c::LnmPBCfg FOR model" />
	</component>

    <!-- generate LNM_PBCfg.h -->
	<component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<fileEncoding value="ISO-8859-1"/>
		<globalVarDef name="AutosarVersion" value="'${AutosarVersion}'"/>
		<globalVarDef name="FileName" value="'LNM_PBCfg.h'"/>
		<metaModel id="mm" class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<expand value="LNM_PBCfg_h::LnmPBCfgH FOR model" />
	</component>

    <!-- generate LNM_Cfg.c -->
	<component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<fileEncoding value="ISO-8859-1"/>
		<globalVarDef name="AutosarVersion" value="'${AutosarVersion}'"/>
		<globalVarDef name="FileName" value="'LNM_Cfg.c'"/>
		<metaModel id="mm" class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<expand value="LNM_Cfg_c::LnmCfg FOR model" />
	</component>
    <!-- generate LNM_Cfg.h -->
	<component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<fileEncoding value="ISO-8859-1"/>
		<globalVarDef name="AutosarVersion" value="'${AutosarVersion}'"/>
		<globalVarDef name="FileName" value="'LNM_Cfg.h'"/>
		<metaModel id="mm" class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<expand value="LNM_Cfg_h::LnmCfgH FOR model" />
	</component>

   <!-- generate Sum_Lnm_Cfg_SWCD.arxml -->
	<component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<fileEncoding value="ISO-8859-1"/>
		<globalVarDef name="AutosarVersion" value="'${AutosarVersion}'"/>
		<globalVarDef name="FileName" value="'Sum_Lnm_Cfg_SWCD.arxml'"/>
		<metaModel id="mm" class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<expand value="Sum_Lnm_Cfg_SWCD_arxml::LnmArxml FOR model" />
	</component>
	
	<!-- generate Sum_Lnm_SWCD.arxml -->
	<component class="com.bosch.oawtypesystem.actions.BCTCodeGenerator">
		<fileEncoding value="ISO-8859-1"/>
		<globalVarDef name="AutosarVersion" value="'${AutosarVersion}'"/>
		<globalVarDef name="FileName" value="'Sum_Lnm_SWCD.arxml'"/>
		<metaModel id="mm" class="com.bosch.oawtypesystem.metamodel.cubec.CubecConfMetaModel" />
		<expand value="Sum_Lnm_SWCD_arxml::LnmArxml FOR model" />
	</component>

</workflow>
