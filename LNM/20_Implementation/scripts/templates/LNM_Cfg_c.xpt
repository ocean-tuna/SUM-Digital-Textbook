«IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
«FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i-»

/******************************************************************************
* Function name: LNM_Activation_«Network.shortName»
* Description: Activation / Deactivation request of LIN channel «Network.shortName»
* Parameters in:
* Return value:
* Remarks for:
* Satisfies: [$SDD_LNM 020]
 ******************************************************************************/
«IF Network.lNM_ActivationSignalType.matches("Rule") == true && 
    sum_Lnm_ActivationRuleIncludesVPM(Network.sum_LNM_Rule_ref) == true -»
/*PRQA S 1505 1 # Runnable implementation that can also be called by another module*/
«ELSE -»
/*PRQA S 1503 1 # Runnable implementation to be called by another module*/
«ENDIF -»
FUNC(void, SUM_LNM_CODE) LNM_Activation_«Network.shortName -»(void)
{
    «IF Network.lNM_ActivationSignalType.matches("Rule") == false -»
    VAR(uint8,AUTOMATIC) activation_signal_status;
    «IF Network.lNM_ActivationSignalType.matches("Com") == true -»
    VAR(uint8,AUTOMATIC) activation_signal_av;
    «ENDIF -»
    VAR(Std_ReturnType,AUTOMATIC) ret;

    «ENDIF -»
    «IF Network.lNM_ActivationSignalType.matches("Rule") == true -»
    LNM_Network_Status[«i.counter0 -»].activation_requested = TRUE;
    LNM_Network_Status[«i.counter0 -»].activation_rule = LNM_Network_Info[«i.counter0 -»].LNM_GetActivationRule();
    «ELSE -»
    /* Read the activation signal status that generated the function call */
    ret = LNM_Network_Info[«i.counter0 -»].LNM_GetActivationSignal(&activation_signal_status);
    if(ret == LNM_E_OK )
    {
        «IF Network.lNM_ActivationSignalType.matches("Com") == true -»
        /* Satisfies: [$SDD_LNM 021] */
        /* Com activation signal: check the availability of the signal */
        ret = LNM_Network_Info[«i.counter0 -»].LNM_GetActivationSignal_Av(&activation_signal_av);
        if(ret == LNM_E_OK)
        {
            if(activation_signal_av == LNM_SIGNAL_AVAILABLE)
            {
                /* Set the flags that manage activation and deactivation criteria */
                LNM_Network_Status[«i.counter0 -»].activation_requested = TRUE;
                LNM_Network_Status[«i.counter0 -»].activation_signal = activation_signal_status;
            }
        }
        «ELSE -»
        /* Set the flags that manage activation and deactivation criteria */
        LNM_Network_Status[«i.counter0 -»].activation_requested = TRUE;
        LNM_Network_Status[«i.counter0 -»].activation_signal = activation_signal_status;
        «ENDIF -»
    }
    «ENDIF -»
}
«ENDFOREACH -»

«IF (sum_Lnm_ExistsRuleWithVPM(lNM)) -» 
/******************************************************************************
* Function name: LNM_Activation_Rule_VPM
* Description: Function that triggers evaluation of rules for the LIN channels with 
               vehicle power mode as part of the activation/deactivation rule.
* Parameters in:
* Return value:
* Remarks for:
* Satisfies: [$SDD_LNM 020]
 ******************************************************************************/
 /* PRQA S 1532 1 # Function invoked by other functions in external file */
FUNC(void, SUM_LNM_CODE) LNM_Activation_Rule_VPM (void)
{
  «FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i-»
  «IF Network.lNM_ActivationSignalType.matches("Rule") == true -»
  «IF sum_Lnm_ActivationRuleIncludesVPM(Network.sum_LNM_Rule_ref) -»
  LNM_Activation_«Network.shortName -»();
  «ENDIF -»
  «ENDIF -»
  «ENDFOREACH -»
}

«ENDIF -»
