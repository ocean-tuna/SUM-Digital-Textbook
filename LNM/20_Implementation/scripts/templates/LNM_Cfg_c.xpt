«FOREACH lNM.lNM_Arbitration.lNM_Inputs.lNM_ScheduleSignal AS ScheduleSignal -»
«IF ScheduleSignal.lNM_ScheduleSignalSource.matches("VPM") == false -»
/******************************************************************************
* Function name: LNM_Get_ScheduleSignal_«ScheduleSignal.shortName »
* Description: Functions that returns the value of the schedule signal.
*              The return value is used to signal if an error occurred during
*              the execution of the function
* Parameters in: The schedule signal must be provided as a pointe input.
*                It will be written by the function
* Return value: boolean error status
* Remarks for:
* Satisfies: [$SDD_LNM 031]
 ******************************************************************************/
static FUNC(boolean, SUM_LNM_CODE) LNM_Get_ScheduleSignal_«ScheduleSignal.shortName -»(P2VAR(«ScheduleSignal.lNM_ScheduleSignalType -», AUTOMATIC, RTE_APPL_DATA) schedule_signal)
{
    VAR(Std_ReturnType,AUTOMATIC) status;
    VAR(boolean,AUTOMATIC) rv = FALSE;
    «IF ScheduleSignal.lNM_ScheduleSignalSource.matches("Com") == true -»
    VAR(uint8,AUTOMATIC) schedule_signal_av;
    «ENDIF -»


    «IF ScheduleSignal.lNM_ScheduleSignalSource.matches("Com") == true -»
    /* Satisfies: [$SDD_LNM 032] */
	/* Read signal availability */
    status = Rte_Read_RP_LNM_ScheduleSignal_Av_«ScheduleSignal.shortName -»_SignalAvailability(&schedule_signal_av);
    if(status == LNM_E_OK)
    {
        if(schedule_signal_av == LNM_SIGNAL_AVAILABLE)
        {
            /* Signal is available. Possible to proceed */
            rv = TRUE;
        }
    }

    if(rv == TRUE)
    {
        /* Reset to FALSE rv. It must be set to TRUE only if schedule signal is correctly read */
        rv = FALSE;
    «ENDIF -»
   	    /* Read the activation signal */
   	    status = Rte_Read_RP_LNM_ScheduleSignal_«ScheduleSignal.shortName -»_ScheduleSignal(schedule_signal);
	    if(status == LNM_E_OK)
	    {
	        /* Schedule signal read success */
	        rv = TRUE;
	    }
	«IF ScheduleSignal.lNM_ScheduleSignalSource.matches("Com") == true -»
    }
    «ENDIF -»

    return rv;
}

«ENDIF -»
«ENDFOREACH -»

«FOREACH lNM.lNM_Arbitration.lNM_Conditions.lNM_Condition AS Condition -»
/******************************************************************************
* Function name: LNM_CheckCondition_«Condition.shortName »
* Description: Functions that checks the selected enable condition
* Parameters in:
* Return value: boolean: TRUE  -> Condition satified
*                        FALSE -> Condition not satisfied
* Remarks for:
 ******************************************************************************/
static FUNC(boolean, SUM_LNM_CODE) LNM_CheckCondition_«Condition.shortName -»(void)
{
    VAR(boolean,AUTOMATIC) rv = FALSE;
    
    «IF Condition.lNM_InputRef.metaType.toString().matches("bsw::LNMModule::LNM_ScheduleSignal") == true -»
    «IF Condition.lNM_InputRef.lNM_ScheduleSignalSource.matches("VPM") == true -»
    SUM_VehiclePowerMode_Signal_States PowerMode;
    «ELSE -»
    VAR(boolean,AUTOMATIC) status;
    VAR(«Condition.lNM_InputRef.lNM_ScheduleSignalType -»,AUTOMATIC) schedule_signal = 0u;
    «ENDIF -»
    «ENDIF -»

    /* Get the value of the input signal */
    «IF Condition.lNM_InputRef.metaType.toString().matches("bsw::LNMModule::LNM_ScheduleSignal") == true -»
    
    «IF Condition.lNM_InputRef.lNM_ScheduleSignalSource.matches("VPM") == true -»
    if (E_OK == Rte_Read_RP_SUSD_LNM_VehiclePowerMode_VehiclePowerMode(&(PowerMode)))
    {
        if (PowerMode  «Condition.lNM_CompareOperator -» («Condition.lNM_InputRef.lNM_ScheduleSignalType -») «Condition.lNM_CompareValue -»u ) 
        {
            rv = TRUE;
        }
    }
    «ELSE -»
    status = LNM_Get_ScheduleSignal_«Condition.lNM_InputRef.shortName -»(&schedule_signal);
    if(status == TRUE)
    {
        /* Input has been correctly processed. Evaluate the condition */
        if(schedule_signal «Condition.lNM_CompareOperator -» («Condition.lNM_InputRef.lNM_ScheduleSignalType -»)«Condition.lNM_CompareValue -»u)
        {
            rv = TRUE;
        }
    }
    «ENDIF -»
    «ENDIF -»

    return rv;
}
«ENDFOREACH -»

«FOREACH lNM.lNM_Arbitration.lNM_Rules.lNM_Rule AS Rule -»
/******************************************************************************
* Function name: LNM_CheckRule_«Rule.shortName »
* Description: Functions that checks the selected rule
* Parameters in:
* Return value: boolean: TRUE  -> Rule satified
*                        FALSE -> Rule not satisfied
* Remarks for:
 ******************************************************************************/
static FUNC(boolean, SUM_LNM_CODE) LNM_CheckRule_«Rule.shortName -»(void)
{
    «FOREACH Rule.lNM_ConditionRef AS Ref ITERATOR i -»
    VAR(boolean,AUTOMATIC) clause_«i.counter0 -»;
    «ENDFOREACH -»

    /* Read each condition / rule */
    «FOREACH Rule.lNM_ConditionRef AS Ref ITERATOR i -»
      «IF Ref.metaType.toString().matches("bsw::LNMModule::LNM_Condition") == true -»
    clause_«i.counter0 -» = LNM_CheckCondition_«Ref.shortName -»();
      «ELSE -»
    clause_«i.counter0 -» = LNM_CheckRule_«Ref.shortName -»();
      «ENDIF -»
    «ENDFOREACH -»

    /* Rule evaluation */
    return (clause_0«FOREACH Rule.lNM_ConditionRef.withoutFirst() AS Ref ITERATOR i -» «Rule.lNM_LogicOperator -» clause_«i.counter0 + 1-»«ENDFOREACH-»);
}

«ENDFOREACH -»
«ENDIF -»

«FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i -»
/******************************************************************************
* Function name: LNM_ScheduleManagement_«Network.shortName »
* Description: Functions that executes schedule FSM of the network
* Parameters in:
* Return value:
* Remarks for:
* Satisfies: [$SDD_LNM 030] [$SDD_LNM 032] [$SDD_LNM 511] [$SDD_LNM 512] [$SDD_LNM 515]
 ******************************************************************************/
static FUNC(void, SUM_LNM_CODE) LNM_ScheduleManagement_«Network.shortName -»(void)
{		
«IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
	VAR(boolean,AUTOMATIC) rule_status;

    switch(LNM_Network_Status[«i.counter0 -»].current_schedule_state)
    {
        case «Network.lNM_ScheduleManagement.lNM_ScheduleStates.lNM_SleepState.shortName -»_«Network.shortName -»:
            /*Reserved for any actions for the sleep schedule*/
            break;

        case «Network.lNM_ScheduleManagement.lNM_ScheduleStates.lNM_StartState.shortName -»_«Network.shortName -»:
            «FOREACH Network.lNM_ScheduleManagement.lNM_ScheduleTransitions.lNM_ScheduleTransition AS Transition -»
              «IF Transition.lNM_StartStateRef.shortName.matches(Network.lNM_ScheduleManagement.lNM_ScheduleStates.lNM_StartState.shortName) -»
            rule_status = LNM_CheckRule_«Transition.lNM_TransitionRuleRef.shortName -»();
                «IF Transition.lNM_EndStateRef.metaType.toString().matches("bsw::LNMModule::LNM_ScheduleState") == true -»
				if(rule_status == TRUE)
				{
				/* Transition to «Transition.lNM_EndStateRef.shortName -» state */
				LNM_Network_Status[«i.counter0 -»].current_schedule_state = «Transition.lNM_EndStateRef.shortName -»_«Network.shortName -»;
                LNM_Network_Status[«i.counter0 -»].schedule_request_success = FALSE;
                LNM_Network_Status[«i.counter0 -»].desired_schedule = «Transition.lNM_EndStateRef.lNM_ScheduleRef.linSMScheduleIndex -»u;
				LNM_Network_Status[«i.counter0 -»].presleep_timer_started = FALSE;
				}
                «ELSE -»
				«IF Network.lNM_C_PreSleepDelay != 0 -»
				if((rule_status == TRUE) && (LNM_Network_Status[«i.counter0 -»].presleep_timer_started == FALSE))
				{
					/* Start pre-sleep timer */
					LNM_Network_Status[«i.counter0 -»].presleep_timer_started = TRUE;
					/* PRQA S 3469 1 # Configuration value, generated, in future can be used by other modules */
					LNM_Network_Status[«i.counter0 -»].presleep_timer = Rte_CData_LNM_C_PreSleepDelay_«Network.shortName -»(); 
					LNM_Network_Status[«i.counter0 -»].presleep_timer *= 1000u; /*Convert to us*/
				}
				«ELSE -»
				if(rule_status == TRUE)
				{
				LNM_Network_Status[«i.counter0 -»].current_schedule_state = LNM_SLEEP_SCHEDULE_STATE;								
				/* Request NO_COMMUNICATION of the channel */
				LNM_Network_Info[«i.counter0 -»].LNM_RequestComMode(LNM_NO_COMMUNICATION);
				/* Any additional actions upon transitioning to sleep can be added here */
				}
				«ENDIF -»
                «ENDIF -»
              «ENDIF -»
            «ENDFOREACH -»
            break;

        «FOREACH Network.lNM_ScheduleManagement.lNM_ScheduleStates.lNM_ScheduleState AS ScheduleState -»
        case «ScheduleState.shortName -»_«Network.shortName -»:
            «FOREACH Network.lNM_ScheduleManagement.lNM_ScheduleTransitions.lNM_ScheduleTransition AS Transition -»
              «IF Transition.lNM_StartStateRef.shortName.matches(ScheduleState.shortName) -»
            rule_status = LNM_CheckRule_«Transition.lNM_TransitionRuleRef.shortName -»();
            
                «IF Transition.lNM_EndStateRef.metaType.toString().matches("bsw::LNMModule::LNM_ScheduleState") == true -»
				if(rule_status == TRUE)
				{
				/* Transition to «Transition.lNM_EndStateRef.shortName -» state */
				LNM_Network_Status[«i.counter0 -»].current_schedule_state = «Transition.lNM_EndStateRef.shortName -»_«Network.shortName -»;
                LNM_Network_Status[«i.counter0 -»].schedule_request_success = FALSE;
                LNM_Network_Status[«i.counter0 -»].desired_schedule = «Transition.lNM_EndStateRef.lNM_ScheduleRef.linSMScheduleIndex -»u;
				LNM_Network_Status[«i.counter0 -»].presleep_timer_started = FALSE;
				}
                «ELSE -»
				«IF Network.lNM_C_PreSleepDelay != 0 -»
				if((rule_status == TRUE) && (LNM_Network_Status[«i.counter0 -»].presleep_timer_started == FALSE))
				{				
					/* Start pre-sleep timer */
					LNM_Network_Status[«i.counter0 -»].presleep_timer_started = TRUE;
					/* PRQA S 3469 1 # Configuration value, generated, in future can be used by other modules */
					LNM_Network_Status[«i.counter0 -»].presleep_timer = Rte_CData_LNM_C_PreSleepDelay_«Network.shortName -»(); 
					LNM_Network_Status[«i.counter0 -»].presleep_timer *= 1000u; /*Convert to us*/
				}
				«ELSE -»
				if(rule_status == TRUE)
				{
				LNM_Network_Status[«i.counter0 -»].current_schedule_state = LNM_SLEEP_SCHEDULE_STATE;								
				/* Request NO_COMMUNICATION of the channel */
				LNM_Network_Info[«i.counter0 -»].LNM_RequestComMode(LNM_NO_COMMUNICATION);
				/* Any additional actions upon transitioning to sleep can be added here */
				}
				«ENDIF -»
                «ENDIF -»
            
              «ENDIF -»
            «ENDFOREACH -»
            break;

        «ENDFOREACH -»
        default:
            /*Nothing to do*/
            break;
    }
	/* Schedule requests management */
	LNM_ScheduleTable_Request(«i.counter0 -»);
	
	/* Call the pre-sleep timer management function */
    LNM_PreSleep_Timer_Management(«i.counter0 -»);

«ELSE -» /* User function case */
    /* Get required schedule from user function */
    LNM_Network_Status[«i.counter0 -»].desired_schedule = LNM_GetRequiredSchedule(«Network.sum_LNM_LinSMNetworkId_ref.linSmNetworkIndex -»);

    /* Check whether the desired schedule has been successfully activated */
    LNM_Network_Status[«i.counter0 -»].schedule_request_success = FALSE;
	
	/* Schedule requests management */
	LNM_ScheduleTable_Request(«i.counter0 -»);
«ENDIF -»
}
«ENDFOREACH -»

«FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i -»
  «FOREACH Network.lNM_Responders AS Responder ITERATOR j -»
    «IF Responder.lNM_Internal_Electronic_Failure_Supported == true -»
      «IF Responder.lNM_IEF_APINFO2_Supported == true -»
/******************************************************************************
* Function name: LNM_APINFO2_«Network.shortName -»_«Responder.shortName »
* Description: APINFO2 notification. Updates the counter for IEF DTC
* Parameters in:
* Return value:
* Remarks for:
* Satisfies: [$SDD_LNM 081]
 ******************************************************************************/
 /*PRQA S 1503 1 # Runnable implementation to be called by another module*/
FUNC(void, SUM_LNM_CODE) LNM_APINFO2_«Network.shortName -»_«Responder.shortName -»(void)
{
    VAR(Std_ReturnType,AUTOMATIC) rv;
    VAR(boolean,AUTOMATIC) apinfo2;

    if(LNM_GlobalStatus == LNM_RUNNING)
    {
        /* Check that the responder is present in the network */
        if((LNM_Network_Status[«i.counter0 -»u].MSCL & ((uint16)LNM_RESPONDER_PRESENT << LNM_Network_Info[«i.counter0 -»u].LNM_Responders[«j.counter0 -»u].LNM_MSCL_Index)) != LNM_ZERO)
        {
            /* Read the reset notification */
            rv = LNM_Network_Info[«i.counter0 -»u].LNM_Responders[«j.counter0 -»u].LNM_IEF_APINFO2(&apinfo2);
            if(rv == LNM_E_OK)
            {
                /* Update counters */
                if(apinfo2 == ERROR_EVENT_INACTIVE)
                {
                    /* Reset counter to 0 if no reset has been notified */
                    LNM_Network_Info[«i.counter0 -»u].LNM_Responder_Status[«j.counter0 -»u].ief_reset_counter = LNM_ZERO;
                }
                else
                {
                    /* A reset has been notified. Increment the counter */
                    if(LNM_Network_Info[«i.counter0 -»u].LNM_Responder_Status[«j.counter0 -»u].ief_reset_counter < LNM_Network_Info[«i.counter0 -»u].LNM_Responders[«j.counter0 -»u].LNM_APINFO2_Threshold)
                    {
                        LNM_Network_Info[«i.counter0 -»u].LNM_Responder_Status[«j.counter0 -»u].ief_reset_counter++;
                    }
                }
            }
        }
    }
}

      «ENDIF -»
    «ENDIF -»
  «ENDFOREACH -»
«ENDFOREACH -»

«FOREACH lNM.lNM_Networks.lNMNetwork AS Network ITERATOR i -»
  «FOREACH Network.lNM_Responders AS Responder ITERATOR j -»
    «IF Responder.lNM_Responder_Device_Not_Configured_Supported == true -»
/******************************************************************************
* Function name: LNM_APINFO3_«Network.shortName -»_«Responder.shortName -»
* Description: APINFO3 notification. Monitors Responder Not Configured DTC
* Parameters in:
* Return value:
* Remarks for:
* Satisfies: [$SDD_LNM 090] [$SDD_LNM 091] [$SDD_LNM 092]
 ******************************************************************************/
 /*PRQA S 1503 1 # Runnable implementation to be called by another module*/
FUNC(void, SUM_LNM_CODE) LNM_APINFO3_«Network.shortName -»_«Responder.shortName -»(void)
{
    VAR(Std_ReturnType,AUTOMATIC) rv;
    VAR(boolean,AUTOMATIC) apinfo3;
    VAR(uint8,AUTOMATIC) event_status = ERROR_EVENT_INACTIVE;
    VAR(uint8,AUTOMATIC) max_retries;

    /* Check if the LNM is allowed to execute its functions */
    if(LNM_GlobalStatus == LNM_RUNNING)
    {
        /* Read calibration parameter max retries */
		/* PRQA S 3469 1 # The function like macros is used. This is necessary to get value via RTE variable */
        max_retries = Rte_CData_LNM_Config_Retries_«Network.shortName -»_«Responder.shortName -»();

        /* Check that the responder is present in the network */
        if((LNM_Network_Status[«i.counter0 -»u].MSCL & ((uint16)LNM_RESPONDER_PRESENT << LNM_Network_Info[«i.counter0 -»u].LNM_Responders[«j.counter0 -»u].LNM_MSCL_Index)) != LNM_ZERO)
        {
            /* Read APINFO3 */
            rv = LNM_Network_Info[«i.counter0 -»u].LNM_Responders[«j.counter0 -»u].LNM_NotConfigured_APINFO3(&apinfo3);
            if(rv == LNM_E_OK)
            {
                /* Update counters */
                if(apinfo3 == ERROR_EVENT_INACTIVE)
                {
                    /* No retries needs to be done. Event is passed */
                    LNM_Network_Info[«i.counter0 -»u].LNM_Responder_Status[«j.counter0 -»u].not_configured_counter = LNM_ZERO;
                }
                else
                {
                    /* Not configured responder. Update counter of retries before setting DTC  */
                    if(LNM_Network_Info[«i.counter0 -»u].LNM_Responder_Status[«j.counter0 -»u].not_configured_counter <= max_retries)
                    {
                        LNM_Network_Info[«i.counter0 -»u].LNM_Responder_Status[«j.counter0 -»u].not_configured_counter++;
                    }
                }

                max_retries++;
                if(LNM_Network_Info[«i.counter0 -»u].LNM_Responder_Status[«j.counter0 -»u].not_configured_counter == max_retries)
                {
                    event_status = LNM_ERROR_EVENT_ACTIVE;
                }

                /* Report test result to ERRH */
                (void) LNM_Network_Info[«i.counter0 -»u].LNM_Responders[«j.counter0 -»u].LNM_ERRH_NotConfigured(event_status);
            }
        }
    }
}
    «ENDIF -»
  «ENDFOREACH -»
«ENDFOREACH -»

«FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
  «FOREACH Network.lNM_Responders AS Responder -»
  
/******************************************************************************
