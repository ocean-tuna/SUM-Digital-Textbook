* Description: LNM getter function to access C_DTCProcess_Ief_«Network.shortName -»_«Responder.shortName -»
* Parameters in: void
* Return value: boolean
 ******************************************************************************/ 
static boolean Sum_LNM_Errh_Get_C_DTCProcess_Ief_«Network.shortName -»_«Responder.shortName -»(void)
{
    /*PRQA S 3469 1 # RTE generated function*/
    return  Rte_CData_Sum_LNM_Errh_C_DTCProcess_Ief_«Network.shortName -»_«Responder.shortName -»();
}  
  «ENDFOREACH -»
«ENDFOREACH -»

