 «FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
static LNM_Responder_Status_Type LNM_Responder_Status_«Network.shortName -»[LNM_NUMBER_OF_RESPONDERS_NETWORK_«Network.shortName -»];
«ENDFOREACH -»

«FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
static LNM_Responder_Info_Type LNM_Responder_Info_«Network.shortName -»[LNM_NUMBER_OF_RESPONDERS_NETWORK_«Network.shortName -»] =
{
    «FOREACH Network.lNM_Responders AS Responder -»
    /* Responder «Responder.shortName -» configuration */
    {
        /* LNM_MSCL_Index */
        «IF Responder.lNM_MSCL_ByteIndex.matches("MSCL_BYTE_1") -»
        «Responder.lNM_MSCL_BitIndex -»u,
        «ELSE -»
        «Responder.lNM_MSCL_BitIndex + 8 -»u,
        «ENDIF -»
        /* LNM_LoCWithDevice_Timer */
        «Responder.lNM_LossOfComm_withDevice_Timer -»u,
        /* LNM_LoCWithDevice_LNM_ERRH_NodeId */
        &Rte_Write_PP_LNM_ERRH_NodeStatusIdx_«Network.shortName -»_«Responder.shortName -»_NodeStatusId,
        /* LNM_LoCWithDevice_LNM_ERRH_NodeTimer */
        &Rte_Write_PP_LNM_ERRH_NodeStatusIdx_«Network.shortName -»_«Responder.shortName -»_NodeStatusTimer,
        /* LNM_LoCWithDevice_SSM_LNM_NodeTimeout */
        &Rte_Read_RP_SSM_LNM_NodeTimeout_«Network.shortName -»_«Responder.shortName -»_NodeTimeout,
        /* LNM_IEF_Supported */
        &Sum_LNM_Errh_Get_C_DTCProcess_Ief_«Network.shortName -»_«Responder.shortName -»,
        /* LNM_IEF_LNM_ERRH_IntElectFault */
        «IF Responder.lNM_Internal_Electronic_Failure_Supported == true -»
        &Rte_Write_PP_LNM_ERRH_IntElectFault_«Network.shortName -»_«Responder.shortName -»_IntElectFault,
        «ELSE -»
        NULL_PTR,
        «ENDIF -»
        /* LNM_IEF_APINFO2 */
        «IF Responder.lNM_Internal_Electronic_Failure_Supported == true -»
          «IF Responder.lNM_IEF_APINFO2_Supported == true -»
        &Rte_Read_RP_COM_LNM_APINFO2_«Network.shortName -»_«Responder.shortName -»_APINFO2,
          «ELSE -»
        NULL_PTR,
          «ENDIF -»
        «ELSE -»
        NULL_PTR,
        «ENDIF -»
        /* LNM_IEF_APINFO4 */
        «IF Responder.lNM_Internal_Electronic_Failure_Supported == true -»
          «IF Responder.lNM_IEF_APINFO4_Supported == true -»
        &Rte_Read_RP_COM_LNM_APINFO4_«Network.shortName -»_«Responder.shortName -»_APINFO4,
          «ELSE -»
        NULL_PTR,
          «ENDIF -»
        «ELSE -»
        NULL_PTR,
        «ENDIF -»
        /* LNM_APINFO2_Threshold */
        «IF Responder.lNM_Internal_Electronic_Failure_Supported == true -»
          «IF Responder.lNM_IEF_APINFO2_Supported == true -»
        «Responder.lNM_IEF_Reset_Threshold -»u,
          «ELSE -»
        0u,
          «ENDIF -»
        «ELSE -»
        0u,
        «ENDIF -»
        «IF Responder.lNM_Responder_Device_Not_Configured_Supported == true -»
        /* LNM_NotConfigured_APINFO3 */
        &Rte_Read_RP_COM_LNM_APINFO3_«Network.shortName -»_«Responder.shortName -»_APINFO3,
        /* LNM_ERRH_NotConfigured */
        &Rte_Write_PP_LNM_ERRH_NotConfigured_«Network.shortName -»_«Responder.shortName -»_NotConfigured,
        «ELSE -»
        /* LNM_NotConfigured_APINFO3 */
        NULL_PTR,
        /* LNM_ERRH_NotConfigured */
        NULL_PTR,
        «ENDIF -»
    },
    «ENDFOREACH -»
};
«ENDFOREACH -»

const LNM_Network_Info_Type LNM_Network_Info[LNM_NUMBER_OF_NETWORKS] =
{
«FOREACH lNM.lNM_Networks.lNMNetwork AS Network -»
    /* «Network.shortName -» configuration*/
    {
        /* LNM_Responders */
        LNM_Responder_Info_«Network.shortName -»,
        /* LNM_ScheduleManager */
        &LNM_ScheduleManagement_«Network.shortName -»,
        /* LNM_ScheduleRequest */
        &Rte_Switch_PP_LNM_BswM_LinSM_ScheduleRequest_LNMNetwork_«Network.lNM_Network_ID -»_RequestSchedule_LNMNetwork_«Network.lNM_Network_ID -»,
        /* LNM_GetCurrentSchedule */
        &Rte_Mode_RP_LNM_BswM_LinSM_CurrentSchedule_LNMNetwork_«Network.lNM_Network_ID -»_CurrentSchedule_LNMNetwork_«Network.lNM_Network_ID -»,
        /* LNM_GetNetworkStatus */
        &Rte_Mode_RP_LNM_BswM_LinSM_CurrentState_LNMNetwork_«Network.lNM_Network_ID -»_CurrentMode_LNMNetwork_«Network.lNM_Network_ID -»,
        «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
        «IF Network.lNM_ActivationSignalType.matches("Rule") == true -»
        /* LNM_ActivationTypeIsRule */
        TRUE,
        /* LNM_GetActivationRule */
        &LNM_CheckRule_«Network.sum_LNM_Rule_ref.shortName -»,
        /* LNM_GetActivationSignal */
        NULL_PTR,
        «ELSE -»
        /* LNM_ActivationTypeIsRule */
        FALSE,
        /* LNM_GetActivationRule */
        NULL_PTR,
        /* LNM_GetActivationSignal */
        &Rte_Read_RP_LNM_ActivationSignal_«Network.shortName -»_ActivationSignal,
        «ENDIF -»
        «ELSE -»
        /* LNM_ActivationTypeIsRule */
        FALSE,
        /* LNM_GetActivationRule */
        NULL_PTR,
        /* LNM_GetActivationSignal */
        NULL_PTR,
        «ENDIF -»
        /* LNM_GetActivationSignal_Av */
        «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
        «IF Network.lNM_ActivationSignalType.matches("Com") == true -»
        &Rte_Read_RP_LNM_ActivationSignal_Av_«Network.shortName -»_SignalAvailability,
        «ELSE -»
        NULL_PTR,
        «ENDIF -»
        «ELSE -»
        NULL_PTR,
        «ENDIF -»
        /* LNM_RequestComMode */
        &Rte_Switch_PP_LNM_BswM_ComM_RequestComMode_LNMNetwork_«Network.lNM_Network_ID -»_RequestMode_LNMNetwork_«Network.lNM_Network_ID -»,
        /* LNM_isComActivationSignal */
        «IF Network.lNM_ActivationSignalType.matches("Com") == true -»
        TRUE,
        «ELSE -»
        FALSE,
        «ENDIF -»
        «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == false -»
        /* LNM_ActivationMask */
        «Network.lNM_ActivationMask -»u,
        /* LNM_DeactivationMask */
        «Network.lNM_DeactivationMask -»u,
        «ELSE -»
        /* Default LNM_ActivationMask */
        254u,
        /* Default LNM_DeactivationMask */
        254,
        «ENDIF -»
        /* LNM_ResponderNumber */
        «Network.lNM_Responders.size -»u,
        /* LNM_MSCL_SSM_Notification */
        &Rte_Write_PP_«Network.shortName -»_LNM_SSM_MSCL_MSCL,
        /* LNM_Network_ID */
        «Network.lNM_Network_ID -»u,
        /* LNM_ERRH_LossCommBus */
        &Rte_Write_PP_LNM_ERRH_LossCommBus_«Network.shortName -»_LossCommBus,
        /* LNM_Responder_Status */
        LNM_Responder_Status_«Network.shortName -»,
        «IF lNM.lNM_General.sum_Lnm_ScheduleChannelUserFuncs_Enabled == true -»
        /* LinSM Network ID mapping to LNM Newtwork ID */
        «Network.sum_LNM_LinSMNetworkId_ref.linSmNetworkIndex -»u,
        /* ComM Channel ID mapping to LNM Newtwork ID */
        «Network.sum_LNM_LinSMNetworkId_ref.linSMComMNetworkHandleRef.comMChannelId -»u,
        «ELSE -»
        /* Fixed LinSM Network ID if the user function callbacks not used */
        0u,
        /* Fixed ComM Channel Network ID if the user function callbacks not used */
        0u,
        «ENDIF -»
        /* LNM_Get_LINBusOff_DTCEnable */
        &LNM_Get_C_DTC_«Network.shortName -»_LINBusOff,
    },
«ENDFOREACH -»
};

