			          <!-- LNM_DeactivationMask -->
					  <ECUC-INTEGER-PARAM-DEF>
                        <SHORT-NAME>LNM_DeactivationMask</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Deactivation bit mask to select relevant bits for channel deactivation</L-2>
                        </DESC>
                        <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <IMPLEMENTATION-CONFIG-CLASSES>
                          <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                          </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        </IMPLEMENTATION-CONFIG-CLASSES>
                        <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                        <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        <MAX>255</MAX>
                        <MIN>0</MIN>
                      </ECUC-INTEGER-PARAM-DEF>
                      <!-- LNM_C_DTC_LINBusOff  -->
                      <ECUC-BOOLEAN-PARAM-DEF>
                        <SHORT-NAME>LNM_C_DTC_LINBusOff</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Parameter that enables the DTC for LIN Bus off.</L-2>
                        </DESC>
                        <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                        <IMPLEMENTATION-CONFIG-CLASSES>
                          <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                            <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                          </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        </IMPLEMENTATION-CONFIG-CLASSES>
                        <ORIGIN>GM_ECUC</ORIGIN>
                        <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                        <DEFAULT-VALUE>false</DEFAULT-VALUE>
                      </ECUC-BOOLEAN-PARAM-DEF>
					  <!-- LNM_C_PreSleepDelay  -->
					  <ECUC-INTEGER-PARAM-DEF>
                      <SHORT-NAME>LNM_C_PreSleepDelay</SHORT-NAME>
                      <DESC>
                        <L-2 L="EN">Calibration parameter for Time in ms, indicates the delay from the instance the schedule switching criteria is satisfied to transition from a RUN_ONCE or a RUN_CONTINUOUS FULL_COMM state to a NO_COMM state, until the transition to the NULL schedule occurs when the SLEEP command is issued.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                      <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                      <IMPLEMENTATION-CONFIG-CLASSES>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                          <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                        </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>25</DEFAULT-VALUE>
                      <MAX>4000</MAX>
                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
