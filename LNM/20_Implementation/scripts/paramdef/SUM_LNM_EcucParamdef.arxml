<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 autosar_4-0-3.xsd">
    <AR-PACKAGES>
      <AR-PACKAGE>
        <SHORT-NAME>ASW_SUM_LNM</SHORT-NAME>
        <ELEMENTS>
          <!-- Module Definition: LNM -->
          <ECUC-MODULE-DEF UUID="ECUC:a2cd582b-3dfc-4ed4-a2e2-2689961a7bd6">
            <SHORT-NAME>LNM</SHORT-NAME>
            <DESC>
              <L-2 L="EN">Configuration of the LNM (Lin Network Manager) module.</L-2>
            </DESC>
            <ADMIN-DATA>
              <DOC-REVISIONS>
                <DOC-REVISION>
                  <REVISION-LABEL>4.2.2</REVISION-LABEL>
                  <ISSUED-BY>AUTOSAR</ISSUED-BY>
                  <DATE>2010-12-03</DATE>
                </DOC-REVISION>
              </DOC-REVISIONS>
            </ADMIN-DATA>
            <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
            <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
            <REFINED-MODULE-DEF-REF DEST="ECUC-MODULE-DEF">/AUTOSAR/EcucDefs/LNM</REFINED-MODULE-DEF-REF>
            <SUPPORTED-CONFIG-VARIANTS>
              <SUPPORTED-CONFIG-VARIANT>VARIANT-POST-BUILD</SUPPORTED-CONFIG-VARIANT>
            </SUPPORTED-CONFIG-VARIANTS>
            <CONTAINERS>
              <!-- Container Definition: LNM_General -->
              <ECUC-PARAM-CONF-CONTAINER-DEF>
                <SHORT-NAME>LNM_General</SHORT-NAME>
                <DESC>
                  <L-2 L="EN">General configuration parameters of SUM_LNM.</L-2>
                </DESC>
                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
                <PARAMETERS>
                  <!-- PARAMETER DEFINITION: LNM_MainFunction_Period -->
                  <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0d223c34-88b4-4953-b63d-178406689302">
                    <SHORT-NAME>LNM_MainFunction_Period</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Time in sec, for the periodicity of the MainFunction runnable</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>GM_ECUC</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>0.1</DEFAULT-VALUE>
                    <MAX>0.2</MAX>
                    <MIN>0.001</MIN>
                  </ECUC-FLOAT-PARAM-DEF>
				  <!-- PARAMETER DEFINITION: LNM_NetworkStatus_Period  -->
                  <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0d223c34-88b4-4953-b63d-178406689302">
                    <SHORT-NAME>LNM_NetworkStatus_Period</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Time in sec, for the periodicity of the NetworkStatus</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>GM_ECUC</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>0.1</DEFAULT-VALUE>
                    <MAX>0.2</MAX>
                    <MIN>0.001</MIN>
                  </ECUC-FLOAT-PARAM-DEF>
				  <!-- PARAMETER DEFINITION: LNM_ScheduleManagement_Period  -->
                  <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0d223c34-88b4-4953-b63d-178406689302">
                    <SHORT-NAME>LNM_ScheduleManagement_Period</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Time in sec, for the periodicity of the ScheduleManagement</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>GM_ECUC</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>0.1</DEFAULT-VALUE>
                    <MAX>0.2</MAX>
                    <MIN>0.001</MIN>
                  </ECUC-FLOAT-PARAM-DEF>
	              <!-- PARAMETER DEFINITION: LNM_NetworkFaultManager_Period  -->
                  <ECUC-FLOAT-PARAM-DEF UUID="ECUC:0d223c34-88b4-4953-b63d-178406689302">
                    <SHORT-NAME>LNM_NetworkFaultManager_Period</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Time in sec, for the periodicity of the NetworkFaultManager</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>GM_ECUC</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>0.1</DEFAULT-VALUE>
                    <MAX>0.2</MAX>
                    <MIN>0.001</MIN>
                  </ECUC-FLOAT-PARAM-DEF>
				  <!-- PARAMETER DEFINITION: LNM_PermitExecution_Mask -->
				  <ECUC-INTEGER-PARAM-DEF>
                    <SHORT-NAME>LNM_PermitExecution_Mask</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Mask that is checked by SUM_LNM to execute its functions</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>GM_ECUC</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>254</DEFAULT-VALUE>
                  </ECUC-INTEGER-PARAM-DEF>
				  <!-- LNM_TWuDelay_Commander -->
				  <ECUC-INTEGER-PARAM-DEF>
                    <SHORT-NAME>LNM_TWuDelay_Commander</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Delay in millisecond before schedule activation when wakeup has been requested by the Commander</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
		  	        <DEFAULT-VALUE>100</DEFAULT-VALUE>
                    <MAX>200</MAX>
                    <MIN>0</MIN>
                  </ECUC-INTEGER-PARAM-DEF>
				  <!-- LNM_TWuDelay_Responder -->
				  <ECUC-INTEGER-PARAM-DEF>
                    <SHORT-NAME>LNM_TWuDelay_Responder</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Delay in millisecond before schedule activation when wakeup has been requested by the Responder</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
		  	        <DEFAULT-VALUE>100</DEFAULT-VALUE>
                    <MAX>200</MAX>
                    <MIN>0</MIN>
                  </ECUC-INTEGER-PARAM-DEF>
				  <!-- LNM_WupTxRetries_Commander -->
			      <ECUC-INTEGER-PARAM-DEF>
                    <SHORT-NAME>LNM_WupTxRetries_Commander</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Init value of calibration parameter. Number of retries before notification of Loss of Communication with Bus, when transitioning from NO COMM to FULL COMM</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
					<DEFAULT-VALUE>10</DEFAULT-VALUE>
                    <MAX>255</MAX>
                    <MIN>0</MIN>
                  </ECUC-INTEGER-PARAM-DEF>
                  <!-- PARAMETER DEFINITION: CyberFill_Supported -->
                  <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>CyberFill_Supported</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Enable the CyberFill value support</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>GM_ECUC</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                   </ECUC-BOOLEAN-PARAM-DEF>
				  <!-- PARAMETER DEFINITION: LNM_CyberFill Value  -->
		          <ECUC-INTEGER-PARAM-DEF>
                    <SHORT-NAME>LNM_CyberFillValue</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">CyberFill value provided by SUM_LNM at initialization time</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>GM_ECUC</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>0</DEFAULT-VALUE>
                  </ECUC-INTEGER-PARAM-DEF>
                  <!-- PARAMETER DEFINITION: LnmGenerateInitRunnable -->
                  <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>LnmGenerateInitRunnable</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">The configuration parameter is used to allow the generation of a periodic runnable to run function Runnable_Lnm_Init one time.
                       If TRUE the Lnm should generate the periodic runnable to execute init() function one time otherwise, the init() function is called by a BswM action list during startup.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>GM_ECUC</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                   </ECUC-BOOLEAN-PARAM-DEF>
                   <!-- PARAMETER DEFINITION: LnmInitFuncPeriodicity -->
                  <ECUC-FLOAT-PARAM-DEF>
                    <SHORT-NAME>LnmInitFuncPeriodicity</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Specifies time in milisecond, for the periodicity of the runnable RE_Lnm_Init. Float values are supported. This parameter is required when LnmGenerateInitRunnable is set to TRUE.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>GM_ECUC</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>1000.0</DEFAULT-VALUE>
                    <MAX>5000.0</MAX>
                    <MIN>1.0</MIN>
                  </ECUC-FLOAT-PARAM-DEF>
				  <!-- PARAMETER DEFINITION: Sum_Lnm_ConfGen_Enabled -->
				  <!-- Satisfies: [$SDD_LNM 510] -->
                  <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>Sum_Lnm_ConfGen_Enabled</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">If false it's enabling the generation of Sum_Lnm_SWCD.arxml, if true the ConfGen will generate that file.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>GM_ECUC</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                   </ECUC-BOOLEAN-PARAM-DEF>
				  <!-- PARAMETER DEFINITION: Sum_Lnm_ScheduleChannelUserFuncs_Enabled -->
                  <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>Sum_Lnm_ScheduleChannelUserFuncs_Enabled</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Enable the use of user functions for changing the Schedule Table and Channel State for the LIN network.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>GM_ECUC</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>false</DEFAULT-VALUE>
                   </ECUC-BOOLEAN-PARAM-DEF>
				  <!-- PARAMETER DEFINITION: lNM_C_DTC_LostCommWithLinResp_Enabled -->
                  <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>lNM_C_DTC_LostCommWithLinResp_Enabled</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Initial value for the calibration parameter controlling whether to enable the Lost Communication with LIN Responder Device DTC. Setting this parameter to true will let LNM aggregate the DTC.</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                      <ORIGIN>GM_ECUC</ORIGIN>
                      <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                      <DEFAULT-VALUE>true</DEFAULT-VALUE>
                   </ECUC-BOOLEAN-PARAM-DEF>
				</PARAMETERS>
				<REFERENCES>
		  	      <ECUC-REFERENCE-DEF>
                    <SHORT-NAME>LNM_DID_F1BE_Reference</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Reference to the Dcm service for DID F1BE</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>ETAS:1.1.0:2015-07-15</ORIGIN>
                    <DESTINATION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR_Dcm/EcucModuleDefs/Dcm/DcmConfigSet/DcmDsp/DcmDspDid</DESTINATION-REF>
                  </ECUC-REFERENCE-DEF>
				</REFERENCES>
              </ECUC-PARAM-CONF-CONTAINER-DEF>
			  <!-- Container Definition: LNM_Arbitration -->
              <ECUC-PARAM-CONF-CONTAINER-DEF>
                <SHORT-NAME>LNM_Arbitration</SHORT-NAME>
                <DESC>
                  <L-2 L="EN">Configuration for LNM arbitration</L-2>
                </DESC>
                <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
				<SUB-CONTAINERS>
				  <!-- LNM_Inputs -->
                  <ECUC-PARAM-CONF-CONTAINER-DEF>
				    <SHORT-NAME>LNM_Inputs</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">Configuration of LNM inputs</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
			        <SUB-CONTAINERS>
				      <!-- LNM_ScheduleSignal -->
                      <ECUC-PARAM-CONF-CONTAINER-DEF>
				        <SHORT-NAME>LNM_ScheduleSignal</SHORT-NAME>
                        <DESC>
                          <L-2 L="EN">Configuration of LNM schedule signal</L-2>
                        </DESC>
                        <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                        <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                        <MULTIPLE-CONFIGURATION-CONTAINER>false</MULTIPLE-CONFIGURATION-CONTAINER>
						<PARAMETERS>
                          <!-- LNM_ScheduleSignalSource -->
                          <ECUC-ENUMERATION-PARAM-DEF>
                          <SHORT-NAME>LNM_ScheduleSignalSource</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Source definition of the schedule signal</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <IMPLEMENTATION-CONFIG-CLASSES>
                            <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                            </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>ETAS:1.0.0:2015-05-04</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>SWC</DEFAULT-VALUE>
                          <LITERALS>
                            <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>SWC</SHORT-NAME>
                              <ORIGIN>ETAS:v1.0.0:2015-05-04</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
	                        <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>Com</SHORT-NAME>
                              <ORIGIN>ETAS:v1.0.0:2015-05-04</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
	                        <ECUC-ENUMERATION-LITERAL-DEF>
                              <SHORT-NAME>VPM</SHORT-NAME>
                              <ORIGIN>ETAS:v1.0.0:2015-05-04</ORIGIN>
                            </ECUC-ENUMERATION-LITERAL-DEF>
                          </LITERALS>
                          </ECUC-ENUMERATION-PARAM-DEF>
						  <!-- LNM_ScheduleSignalType -->
                          <ECUC-ENUMERATION-PARAM-DEF>
                          <SHORT-NAME>LNM_ScheduleSignalType</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Definition of the schedule signal type</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <IMPLEMENTATION-CONFIG-CLASSES>
                            <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                              <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                            </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                            <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
