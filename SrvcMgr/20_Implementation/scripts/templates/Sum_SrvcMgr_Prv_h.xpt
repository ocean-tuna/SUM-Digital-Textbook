#ifndef SUM_SRVCMGR_PRV_H
#define SUM_SRVCMGR_PRV_H

/* The RTE will generate a E_PENDING for every service, instead, we want a generic one.  They
*  are all 10, so just define as 10 */
#ifndef E_PENDING
#define E_PENDING   (10u)
#endif

/*
 *	ROOT LIBRARY
 */
/* Platform types header inclusion */
