#ifndef SUM_SRVCMGR_TYPES_H
#define SUM_SRVCMGR_TYPES_H

/*
 **********************************************************************************************************************************************************
 *	Macros
 **********************************************************************************************************************************************************
 */

/** @brief Macro to define code shutdown enable to be provided to SUSD */
#define SUM_SRVCMGR_ENABLE_SHUTDOWN 					(uint8)0xFFu
/** @brief Macro to check for Reset bit(bit 6) in Permit execution to enable/disable shutdown */
#define SUM_SRVCMGR_RESETBIT_MASK 						(uint8)0xBFu
/** @brief Macro addresses the Permit Execution value has passed the masking operation */
#define SUM_SRVCMGR_EXEC_MASKING_PASSED					(uint8)0xFFu
/** @brief Macro addresses the SRVCMGR module as uninitialized */
#define SUM_SRVCMGR_UNINIT								(boolean)0x00
/** @brief Macro addresses the SRVCMGR module as initialized */
#define SUM_SRVCMGR_INIT								(boolean)0x01u

/*
 **********************************************************************************************************************************************************
 * Enum
 **********************************************************************************************************************************************************
 */

/** @brief Enum for SRVCMGR Execution Status values */
typedef enum Sum_SrvcMgr_ExecutionStatusType
{
	SUM_SrvcMgr_Run_Mode      = 0x00u ,
	SUM_SrvcMgr_Init_and_Shutdown_Mode = 0x01u,
	SUM_SrvcMgr_Prepare_to_Shutdown = 0x02u,
	SUM_SrvcMgr_Invalid_Mode  = 0xffu
} Sum_SrvcMgr_ExecutionStatus;

#endif
/* EOF */
