/**
 * @brief           SrvcMgr runnable to handle DTC clear request from SSFM
 *
 * @details         This function is triggered when a clear DTC confirmation DRE event occurs.
 *                  It retrieves the current learning table state and incomplete learning reasons,
 *                  then calls the helper function to update the U19A6_57 DTC status accordingly.
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
/* PRQA S 1503 1 # This function will be called by RTE */
FUNC(void, SUM_SrvcMgr_CODE) Runnable_SSFM_ClearDiagReq(void)
{
	tableStateType CurrentTableState;
	incompleteLearningReasonsType IncompleteLearningReasons;
	Std_ReturnType retrieveRet;

	/* Get the current learning table state */
	/* PRQA S 3469 1 # This function will be defined in BSW */
	Sd_GetLearningTableState(&CurrentTableState);

	/* Retrieve incomplete learning reasons */
	/* PRQA S 3469 1 # This function will be defined in BSW */
	retrieveRet = Sd_RetrieveIncompleteLearningReasons(&IncompleteLearningReasons);

	/* Check if retrieval was successful */
	if (retrieveRet == E_OK)
	{
		/* Handle U19A6_57 DTC status based on learning table state */
		Sum_SrvcMgr_prv_HandleU19A6_57Status(CurrentTableState, &IncompleteLearningReasons);
	}

    /* DTC U19A6 54 : test pass/fail criteria. */
    Sum_SrvcMgr_prv_HandleU19A6_54Status(CurrentTableState);
}

/**
 * @brief    SrvcMgr helper function to make sure that the new element is added to the buffer is unique
 *
 * @param    serviceId input id need to add to check duplication and then add to buffer
 * @param    missingServiceIds buffer of missing serID - target buffer to add and de-dupicate
 * @param    numOfMissingServices - number of serID in target buffer
 * @return   void
 */
/* PRQA S 1505 1 # Here for modularity and MISRA compliance */
static FUNC(void, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_AddMissingServiceId(uint16 serviceId,
		                                                                uint16 *missingServiceIds,
                                                                        uint16 *numOfMissingServices)
{
	/*[$Satisfies $DDS_SrvcMgr 010]*/
    uint16 i;
    boolean alreadyExists = FALSE;
    /* Check for duplicate */
    for (i = 0u; i < *numOfMissingServices; i++)
    {
        if (missingServiceIds[i] == serviceId)
        {
            alreadyExists = TRUE;
            break;
        }
    }
    /* Add new ServiceId if not exists and space is available */
    if ((alreadyExists == FALSE) &&
        (*numOfMissingServices < SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED))
    {
        missingServiceIds[*numOfMissingServices] = serviceId;
        (*numOfMissingServices)++;
    }
}

/**
 * @brief           SrvcMgr runnable to handle SDMissingMessage from SSFM
 *
 * @details         This function is triggered when a SDMissingMessage DRE event occurs.
 *                  It will put all SDMissingMessages onto an buffer.
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          void
 */
/* PRQA S 1503 1 # This function will be called by RTE */
FUNC(void, SUM_SrvcMgr_CODE) Runnable_SrvcMgr_SSFM_SDMissingMessage(void)
{
	/*[$Satisfies $DDS_SrvcMgr 010]*/
    Std_ReturnType ret;
    uint32 serviceid;
    /* Read service Id from Port, implement a function to add it to the buffer if it doesn't already exist */
    ret = Rte_Read_SUM_SrvcMgr_RP_SSFM_SrvcMgr_SDMissingMessage_SSFM_ServiceId(&serviceid);
    if((ret == E_OK) && (Sum_SrvcMgr_Ssfm_num_Of_Missing_Services <= SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED))
    {
        Sum_SrvcMgr_prv_AddMissingServiceId(
            (uint16)serviceid,
            Sum_SrvcMgr_Ssfm_MissingServiceIds,
            &Sum_SrvcMgr_Ssfm_num_Of_Missing_Services);
    }
}

