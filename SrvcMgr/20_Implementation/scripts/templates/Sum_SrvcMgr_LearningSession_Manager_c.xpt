    P2VAR(Dcm_StartDataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName»Type, AUTOMATIC, RTE_APPL_DATA) DataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName»,
    P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) ErrorCode
) {
    /* PRQA S 2981 2 */ /* The initialization in this case is useful in order to avoid undesired returned values */
    Std_ReturnType ret = E_NOT_OK;
