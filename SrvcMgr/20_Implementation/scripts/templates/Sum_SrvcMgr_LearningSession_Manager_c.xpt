«IF srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref != null -»
«REM»[$Satisfies $DDS_SrvcMgr 009]«ENDREM-»
/**
 * @brief Handle the RID 0654 learning session based on the current status.
 *
 * This function checks the current status of the learning session
 *
 * @param DataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName» A pointer to a variable where the result of the learning session is stored.
 * @param ErrorCode A pointer to a variable where the error of the Dcm error code is stored.
 * @return The return status.
 */
/* PRQA S 1505 1 # Here for modularity */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_CheckLearningTableWriteStatus(
    P2VAR(Dcm_StartDataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName»Type, AUTOMATIC, RTE_APPL_DATA) DataOut,
    P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) ErrorCode
                                        ) {

	Std_ReturnType ret = E_PENDING;
    learningSessionStatusType learningStatus = NOT_STARTED;

    /* Get the status of learning session */
    /* PRQA S 0432 2 # The enum type learningSessionStatusType is compatible with macros defined in the sum_common */
    /* PRQA S 3469 1 # This function will be defined in BSW */
    Sd_GetLearningSessionStatus(&learningStatus);

    switch (learningStatus) {
        case PENDING:
            /* Operation is still pending; waiting for the final status */
            break;
        case SUCCESSFUL:
            /* Learning has completed successfully */
            *DataOut = SRVCMGR_LEARNINGSESSION_COMPLETE;
            ret = E_OK;
            break;
        case FAILED:
            /* Learning session failed */
            *DataOut = SRVCMGR_LEARNINGSESSION_FAIL;
            ret = E_OK;
            break;
        default:
            /* Learning session status is NOT_STARTED or an unknown value */
            *ErrorCode = DCM_E_GENERALREJECT;
            ret = E_NOT_OK;
            break;
    }

    return ret;
}

/**
 * @brief			Helper function to forward the learning table state to SPM module.
 *
 * @param[in]		LearningTableState Current state of the learning table
 * @param[inout]	void
 * @param[out]		void
 * @return			None
 */

static FUNC(void, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_Send_SPM_SDLearningStatusIndication(CONST(uint8, AUTOMATIC) LearningSessionStatus)
{
    switch (LearningSessionStatus)
    {
        case (uint8)SRVCMGR_LEARNINGSESSION_PENDING:
            (void)Rte_Call_RP_SrvcMgr_SPM_SdLearningStatusIndication_SPM_SDLearningStatusIndication((uint8)SUM_LRNG_PENDING);
            break;

        case (uint8)SRVCMGR_LEARNINGSESSION_SUCCESS:
            (void)Rte_Call_RP_SrvcMgr_SPM_SdLearningStatusIndication_SPM_SDLearningStatusIndication((uint8)SUM_LRNG_SUCCESSFUL);
            break;

        case (uint8)SRVCMGR_LEARNINGSESSION_FAIL:
            (void)Rte_Call_RP_SrvcMgr_SPM_SdLearningStatusIndication_SPM_SDLearningStatusIndication((uint8)SUM_LRNG_FAILED);
            break;

        default:
            /* do nothing. */
            break;
    }

    return;
}

/**
