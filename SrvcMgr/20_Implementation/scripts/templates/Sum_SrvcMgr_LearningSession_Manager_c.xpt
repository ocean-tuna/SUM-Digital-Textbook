/**
 * @brief           SrvcMgr runnable DID 0xE0CD Client Incomplete Learning Table ReadData
 *
 * @param[in]       OpStatus The operation status, indicating the current phase of the service operation.
 * @param[inout]    Data Pointer to variable that store the Number of Missing Services + Service IDs missing.
 * @return          Std_ReturnType
 *                  - E_OK: The API returns E_OK.
 *                  - E_NOT_OK: The API returns E_NOT_OK. */
/* PRQA S 1503 1 # Called directly by O.S. */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Runnable_SrvcMgr_DID_E0CD_ReadData(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
	/*[$Satisfies $DDS_SrvcMgr 010]*/
    Std_ReturnType ret = E_NOT_OK;
    incompleteLearningReasonsType srvcmgr_incompleteLearning;
    uint16 i, totalServices;
    uint16 tempData[SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED];
    static uint16 remainingSize;
    switch (OpStatus)
	{
		case DCM_INITIAL:
		case DCM_PENDING:
			/* Get Learning Table Status by calling API from Sd */
			/* PRQA S 3469 1 # This function will be defined in BSW */
			ret = Sd_RetrieveIncompleteLearningReasons(&srvcmgr_incompleteLearning);
            if((ret == E_OK) && (srvcmgr_incompleteLearning.num_Of_Missing_Services <= SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED)){
                Data[0u] = (uint8)(srvcmgr_incompleteLearning.num_Of_Missing_Services >> 8u);
                Data[1u] = (uint8)(srvcmgr_incompleteLearning.num_Of_Missing_Services & 0xFFu);
                for(i = 0; i < srvcmgr_incompleteLearning.num_Of_Missing_Services; i++){
                    Data[(i*2u) + 2u] = (uint8)(srvcmgr_incompleteLearning.service_id[i] >> 8u);
                    Data[(i*2u) + 3u] = (uint8)(srvcmgr_incompleteLearning.service_id[i] & 0xFFu);
                    /* Copy SD service IDs to tempData */
                    tempData[i] = srvcmgr_incompleteLearning.service_id[i];
                }
                /*[$Satisfies $DDS_SrvcMgr 010]*/
                /* totalServices in DID Data after adding all missing sd service id, before adding ssfm missing sd service id */
                totalServices = srvcmgr_incompleteLearning.num_Of_Missing_Services;
                /* Determine how many SSFM services can be added */
                remainingSize = SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED - srvcmgr_incompleteLearning.num_Of_Missing_Services;
                if (Sum_SrvcMgr_Ssfm_num_Of_Missing_Services < remainingSize)
                {
                    remainingSize = Sum_SrvcMgr_Ssfm_num_Of_Missing_Services;
                }
                /* Merge SSFM services into tempData (deduplicated) */
                for (i = 0u; i < remainingSize; i++)
                {
                    Sum_SrvcMgr_prv_AddMissingServiceId(
                            Sum_SrvcMgr_Ssfm_MissingServiceIds[i],
                            tempData,
                            &totalServices);
                }
                /* Copy SD service IDs (ssfm) from tempData */
                for (i = srvcmgr_incompleteLearning.num_Of_Missing_Services; i < totalServices; i++)
                {
                    Data[(i*2u) + 2u] = (uint8)(tempData[i] >> 8u);
                    Data[(i*2u) + 3u] = (uint8)(tempData[i] & 0xFFu);
                }
                /* Update the number of service */
                Data[0u] = (uint8)(totalServices >> 8u);
                Data[1u] = (uint8)(totalServices & 0xFFu);
            }else{
                ret = E_NOT_OK;
            }
			break;
		default:
			/* Nothing to do */
			break;
	}
	return ret;
}

/**
 * @brief           SrvcMgr runnable DID 0xE0CD Client Incomplete Learning Table CheckRead
 *
 * @param[in]       OpStatus The operation status, indicating the current phase of the service operation.
 * @param[inout]    ErrorCode A pointer to a variable where any error code will be stored in case of failure.
 * @return          Std_ReturnType
 *                  - E_OK: The status of the learning table is LEARNING_INCOMPLETE.
 *                  - E_NOT_OK: The status of the learning table is NOT LEARNING_INCOMPLETE */
/* PRQA S 1503,3206 2 # Called directly by O.S and don't have any requirement for NRC so we not need return the value of ErrorCode */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Runnable_SrvcMgr_DID_E0CD_CheckRead(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) ErrorCode)
{
    /*[$Satisfies $DDS_SrvcMgr 010]*/
	Std_ReturnType ret = E_NOT_OK;
    tableStateType LearningTableSts;
    incompleteLearningReasonsType srvcmgr_incompleteLearning;
	/* No specific condition to be checked. */
	switch (OpStatus)
	{
		case DCM_INITIAL:
		case DCM_PENDING:
			/* PRQA S 3469 1 # This function will be defined in BSW */
			Sd_GetLearningTableState(&LearningTableSts);
            if (LearningTableSts == LEARNING_INCOMPLETE)
            {
            	/* PRQA S 3469 1 # This function will be defined in BSW */
                ret = Sd_RetrieveIncompleteLearningReasons(&srvcmgr_incompleteLearning);
                if ((srvcmgr_incompleteLearning.num_Of_Missing_Services <= SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED) && (ret == E_OK))
                {
					/*the learning table is LEARNING_INCOMPLETE*/
                }
                else
                {
                    ret = E_NOT_OK;
                }
            }
            else if (LearningTableSts == LEARNING_COMPLETED)
            {
                /*The learning table is LEARNING_COMPLETED*/
                ret = E_OK;
            }
            else
            {
                /*if learning table is neither LEARNING_INCOMPLETE nor LEARNING_COMPLETED*/
                /* it might be Cleared, Updating, or All Services Learned */
                *ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
                ret = E_NOT_OK;
            }
            break;
        default:
			/* Nothing to do */
			break;
	}
	return ret;
}

/**
 * @brief           SrvcMgr runnable DID 0xE0CD Client Incomplete Learning Table ReadDataLength
 *
 * @param[in]       OpStatus The operation status, indicating the current phase of the service operation.
 * @param[out]      Data Pointer to variable that stores the data length in byte of the ReadData data (number of Missing Services + missing Service IDs).
 * @return          Std_ReturnType
 *                  - E_OK: The status of the learning table is LEARNING_INCOMPLETE.
 *                  - E_NOT_OK: The status of the learning table is NOT LEARNING_INCOMPLETE */
/* PRQA S 1503 1 # Called directly by O.S. */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Runnable_SrvcMgr_DID_E0CD_ReadDataLength(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(uint16, AUTOMATIC, RTE_APPL_DATA) DataLength)
{
	/*[$Satisfies $DDS_SrvcMgr 010]*/
    Std_ReturnType ret = E_NOT_OK;
    incompleteLearningReasonsType srvcmgr_incompleteLearning;
    uint16 i, totalServices;
    uint16 tempData[SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED];
    static uint16 remainingSize;
    switch (OpStatus)
	{
		case DCM_INITIAL:
		case DCM_PENDING:
			/* Get Learning Table Status by calling API from Sd */
			/* PRQA S 3469 1 # This function will be defined in BSW */
			ret = Sd_RetrieveIncompleteLearningReasons(&srvcmgr_incompleteLearning);
            if((ret == E_OK) && (srvcmgr_incompleteLearning.num_Of_Missing_Services <= SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED)){
            	/* totalServices in DID Data after adding all missing sd service id, before adding ssfm missing sd service id */
                totalServices = srvcmgr_incompleteLearning.num_Of_Missing_Services;
                /* Copy SD service IDs to tempData */
                for (i = 0; i < totalServices; i++)
                {
                    tempData[i] = srvcmgr_incompleteLearning.service_id[i];
                }
                /*[$Satisfies $DDS_SrvcMgr 010]*/
                /* Determine how many SSFM services can be added */
                remainingSize = SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED - totalServices;
                if (Sum_SrvcMgr_Ssfm_num_Of_Missing_Services < remainingSize)
                {
                    remainingSize = Sum_SrvcMgr_Ssfm_num_Of_Missing_Services;
                }
                /* Merge SSFM services into tempData (deduplicated) */
                for (i = 0; i < remainingSize; i++)
                {
                    Sum_SrvcMgr_prv_AddMissingServiceId(
                        Sum_SrvcMgr_Ssfm_MissingServiceIds[i],
                        tempData,
                        &totalServices);
                }
                /* Calculate final DataLength in bytes */
                *DataLength = (uint16)((totalServices * 2u) + 2u);
            }else{
                ret = E_NOT_OK;
            }
			break;
		default:
			/* Nothing to do */
			break;
	}
	return ret;
}

/**
 * @brief           SrvcMgr runnable DID 0xE0CE Server Incomplete Learning Table ReadData
 *
 * @param[in]       OpStatus The operation status, indicating the current phase of the service operation.
 * @param[inout]    Data Pointer to variable that store the Number of Missing Services + [Service ID missing|Event Group Id|DTC Id] for each missing event group..
 * @return          Std_ReturnType
 *                  - E_OK: The API returns E_OK.
 *                  - E_NOT_OK: The API returns E_NOT_OK. */
/* PRQA S 1503 1 # Called directly by O.S. */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Runnable_SrvcMgr_DID_E0CE_ReadData(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
	/*[$Satisfies $DDS_SrvcMgr 011]*/
    Std_ReturnType ret = E_NOT_OK;
    incompleteLearningReasonsType srvcmgr_incompleteLearning;
    uint16 i;
    uint16 srvcmgr_dtcValue;

    switch (OpStatus)
	{
		case DCM_INITIAL:

		case DCM_PENDING:
			/* Get Learning Table Status by calling API from Sd */
			/* PRQA S 3469 1 # This function will be defined in BSW */
			ret = Sd_RetrieveIncompleteLearningReasons(&srvcmgr_incompleteLearning);
            if((ret == E_OK) && (srvcmgr_incompleteLearning.num_Of_Missing_EventGroups <= SUM_SRVCMGR_MAX_NUMBER_OF_SERVICES_NOT_LEARNED))
            {
                Data[0u] = (uint8)(srvcmgr_incompleteLearning.num_Of_Missing_EventGroups >> 8u);
                Data[1u] = (uint8)(srvcmgr_incompleteLearning.num_Of_Missing_EventGroups & 0xFFu);

                /* Iterate for all the missing event groups and copy their IDs (service_id and event_group_id)*/
                for(i = 0; i < srvcmgr_incompleteLearning.num_Of_Missing_EventGroups; i++)
                {

                    ret = Sum_SrvcMgr_pub_RetrieveDtcIdValue(srvcmgr_incompleteLearning.entry_array[i].service_id,&srvcmgr_dtcValue);

                    if (ret == E_OK)
                    {
                        /* Service ID */
                        Data[(i*6u) + 2u] = (uint8)(srvcmgr_incompleteLearning.entry_array[i].service_id >> 8u);
                        Data[(i*6u) + 3u] = (uint8)(srvcmgr_incompleteLearning.entry_array[i].service_id & 0xFFu);
                        /* Event Group ID */
                        Data[(i*6u) + 4u] = (uint8)(srvcmgr_incompleteLearning.entry_array[i].event_group_id >> 8u);
                        Data[(i*6u) + 5u] = (uint8)(srvcmgr_incompleteLearning.entry_array[i].event_group_id & 0xFFu);
                        /* Dtc ID */
                        Data[(i*6u) + 6u] = (uint8)( srvcmgr_dtcValue >> 8u);
                        Data[(i*6u) + 7u] = (uint8)( srvcmgr_dtcValue & 0xFFu);
                    }
                    else
                    {
                        /* Incomplete information. So returns E_NOT_OK*/
                        ret = E_NOT_OK;
                        break;
                    }

                }
            }
            else
            {
                ret = E_NOT_OK;
            }

			break;
		default:
			/* Nothing to do */
			break;
	}
	return ret;
}

/**
 * @brief           SrvcMgr runnable DID 0xE0CE Server Incomplete Learning Table CheckRead
 *
 * @param[in]       OpStatus The operation status, indicating the current phase of the service operation.
 * @param[inout]    ErrorCode A pointer to a variable where any error code will be stored in case of failure.
