    «IF SrvcMgr_IsPropSysActvGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    RxSignal_PropSysActv_GroupSignal signal_group_psa;
    «ELSEIF SrvcMgr_IsPSAServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    «SrvcMgr_GetImplementationDataTypeName(srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_PropSysActv_Ref)-» srv_signal_psa;
    «ENDIF-»

    «IF SrvcMgr_IsVehSpdAvgDrvnGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    RxSignal_VehSpdAvgDrvn_GroupSignal signal_group_vehspeed;
    «ELSEIF SrvcMgr_IsVehSpdAvgDrvnServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    «SrvcMgr_GetImplementationDataTypeName(srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_VehSpdAvgDrvn_Ref)-» srv_signal_vehspeed;
    «ENDIF-»
    «ELSE -»
    «IF SrvcMgr_IsPropSysActvGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    RxSignal_VeActvProp_YeDrvnVeh_GroupSignal signal_group;
    «ELSEIF SrvcMgr_IsPSAServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    «SrvcMgr_GetImplementationDataTypeName(srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_PropSysActv_Ref)-» srv_signal;
    «ENDIF-»
    «ENDIF-»

    /* Fault status variables for SSFM fault indication */
«IF SrvcMgr_IsSameSignalReference(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    boolean fault_VSAD_PSA_active ;
«ELSE-»
    boolean fault_VSAD_active ;
    boolean fault_PSA_active ;
«ENDIF-»


    /*[$Satisfies $DDS_SrvcMgr 017]*//*[$Satisfies $DDS_SrvcMgr 009]*//*[$Satisfies $DDS_SrvcMgr 018]*/
    switch (OpStatus) {
        case DCM_INITIAL:
        case DCM_PENDING:
            /* Read PropSysActv and VehicleSpeed signals */
            ret = Sum_SrvcMgr_prv_ReadPropSysActvAndVehicleSpeed(«IF !SrvcMgr_IsSameSignalReference(srvcMgr.sum_SrvcMgr_ConfigSet)-»«IF SrvcMgr_IsPropSysActvGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»&signal_group_psa,«ELSEIF SrvcMgr_IsPSAServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»&srv_signal_psa,«ENDIF-»&srvcmgr_PropSysActv,«IF SrvcMgr_IsVehSpdAvgDrvnGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»&signal_group_vehspeed,«ELSEIF SrvcMgr_IsVehSpdAvgDrvnServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»&srv_signal_vehspeed,«ENDIF-»&srvcmgr_VehicleSpeed«ELSE-»«IF SrvcMgr_IsPropSysActvGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»&signal_group,«ELSEIF SrvcMgr_IsPSAServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»&srv_signal,«ENDIF-»&srvcmgr_PropSysActv,&srvcmgr_VehicleSpeed«ENDIF-»);

            /* Read fault status from SSFM (IDOC-1092) */
            if (ret == E_OK)
            {
            «IF Susd_Ssfm_IsSinglePortSupported(srvcMgr.sum_SrvcMgr_ConfigSet.eRootContainer.sSFM)-»
            «IF SrvcMgr_IsSameSignalReference(srvcMgr.sum_SrvcMgr_ConfigSet)-»
                /* FxFA mode (same signal/service): single port covers both VSAD and PSA */
                ret = Rte_Read_RP_SSFM_SrvcMgr_FxFA_VSAD_PSA_DTC_STATUS_FXFA(&fault_VSAD_PSA_active);
            «ELSE-»
                /* FxFA mode: separate FxFA ports for VSAD and PSA */
                ret = Rte_Read_RP_SSFM_SrvcMgr_FxFA_VSAD_DTC_STATUS_FXFA(&fault_VSAD_active);
                if (ret == E_OK)
                {
                    ret = Rte_Read_RP_SSFM_SrvcMgr_FxFA_PSA_DTC_STATUS_FXFA(&fault_PSA_active);
                }
            «ENDIF-»
            «ELSE-»
            «IF SrvcMgr_IsSameSignalReference(srvcMgr.sum_SrvcMgr_ConfigSet)-»
                /* FsFA mode (same signal/service): single port covers both VSAD and PSA */
                ret = Rte_Read_RP_SSFM_SrvcMgr_FsFA_VSAD_PSA_DTC_STATUS_FSFA(&fault_VSAD_PSA_active);
            «ELSE-»
                /* FsFA mode: separate FsFA ports for VSAD and PSA */
                ret = Rte_Read_RP_SSFM_SrvcMgr_FsFA_VSAD_DTC_STATUS_FSFA(&fault_VSAD_active);
                if (ret == E_OK)
                {
                    ret = Rte_Read_RP_SSFM_SrvcMgr_FsFA_PSA_DTC_STATUS_FSFA(&fault_PSA_active);
                }
            «ENDIF-»
            «ENDIF-»
            }

            /* Enable condition for RID:
             *   (Vehicle Speed Average Driven <= 3 km/h)
             *   AND (Vehicle Speed Failed Safety Fault Active == FALSE)
             *   AND (Propulsion System Active == FALSE)
             *   AND (Propulsion System Active Failed Safety Fault Active == FALSE) */
«IF SrvcMgr_IsSameSignalReference(srvcMgr.sum_SrvcMgr_ConfigSet)-»
            if((ret == E_OK) &&
               (srvcmgr_VehicleSpeed <= (float32)3.0) &&
               (fault_VSAD_PSA_active == FALSE) &&
               (srvcmgr_PropSysActv == FALSE))
«ELSE-»
            if((ret == E_OK) &&
               (srvcmgr_VehicleSpeed <= (float32)3.0) &&
               (fault_VSAD_active == FALSE) &&
               (srvcmgr_PropSysActv == FALSE) &&
               (fault_PSA_active == FALSE))
«ENDIF-»
            {
                if (OpStatus == DCM_INITIAL)
                {
                    /* Needed to inform SPM that a Learning Session will start. */
                    Sum_SrvcMgr_prv_Send_SPM_SDLearningStatusIndication((uint8)SRVCMGR_LEARNINGSESSION_PENDING);
                    /* Initial DCM status: Trigger clearing learning table entries */
                    /* PRQA S 3469 1 # This function will be defined in BSW */
                    if (E_OK == Sd_ClearLearningTable()) {
                        ret = E_PENDING; /* Entry clearing requested */
                        Sum_SrvcMgr_LearningSessionReq = TRUE;
                        Sum_Srvcmgr_SetClientSrvcRequestedRemoteSrvcAvailable();
                        /* Clear the sd missing learning serviceid buffer from ssfm */
                        Sum_SrvcMgr_Ssfm_num_Of_Missing_Services = 0;
                    } else {
                        /* Failed to trigger clearing table entries */
                        ret = E_NOT_OK;
                        *ErrorCode = DCM_E_GENERALREJECT;
                        /* Needed to inform SPM that a Learning Session is finished. */
                        Sum_SrvcMgr_prv_Send_SPM_SDLearningStatusIndication((uint8)SRVCMGR_LEARNINGSESSION_FAIL);
                    }
                }
                else /* DCM_PENDING */
                {
                    /* PENDING DCM status: Check Learning Table Write Status */
                    ret = Sum_SrvcMgr_prv_CheckLearningTableWriteStatus(DataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName», ErrorCode);
                    /* Signal that the learning session request has been completed */
                    if ((ret == E_OK) || (ret == E_NOT_OK)) {
                        Sum_SrvcMgr_LearningSessionReq = FALSE;

                        if( (ret == E_OK) && (SRVCMGR_LEARNINGSESSION_COMPLETE == *DataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0654_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName»)){
                            Sum_SrvcMgr_prv_Send_SPM_SDLearningStatusIndication((uint8)SRVCMGR_LEARNINGSESSION_SUCCESS);
                        }else{
                            Sum_SrvcMgr_prv_Send_SPM_SDLearningStatusIndication((uint8)SRVCMGR_LEARNINGSESSION_FAIL);
                        }

                        /* Perform the necessary operations for the Dtcs after RID 0x0654 execution */
                        /* PRQA S 3469 2 # This function will be defined in BSW */
                        Sd_GetLearningTableState(&CurrentTableState);

                        /* DTC U19A6 87: Let's initialize the LearningTableStatus with status NONE so that we can send the message only when status */
                        /* has been set to something different */
                        Sum_SrvcMgr_prv_HandleU19A6_87Status(CurrentTableState, RID_0654_END);

                        /* DTC U19A6 57 status *//* PRQA S 3469 1 # This function will be defined in BSW */
                        retrieveRet = Sd_RetrieveIncompleteLearningReasons(&IncompleteLearningReasons);
                        if (retrieveRet == E_OK)
                        {
                            /* Handle U19A6_57 DTC status */
                            Sum_SrvcMgr_prv_HandleU19A6_57Status(CurrentTableState, &IncompleteLearningReasons);
                        }

                        /* DTC U19A6 54 : test pass/fail criteria. */
                        Sum_SrvcMgr_prv_HandleU19A6_54Status(CurrentTableState);
                    }

                }
            }
            else
            {
                /* enable condition not met */
                ret = E_NOT_OK;
                *ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
            }
            break;

        default:
            /* Handle unsupported DCM status */
            break;
    }
    return ret;
}
