«IF srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref != null -»

/**
 * @brief           SrvcMgr function that valued Routine Signal #3 and #4
 *
 * @param[in]       srvcmgr_OptionRecordTwo Control Option #2
 * @param[in]       srvcmgr_OptionRecordThree Control Option #3
 * @param[out]      srvcmgr_RoutineStatusOne Pointer to Routine Status Signal #3
 * @param[out]      srvcmgr_RoutineStatusTwo Pointer to Routine Status Signal #4
 * @param[out]      srvcmgr_local_currentDataLength Pointer to the variable that store the value of the length in byte of the Routine Status Signal #4
 * @param[in]       srvcmgr_local_tableContentType Pointer to the struct that contains the Learning Table content
 * @param[out]      srvcmgr_local_ErrorCode A pointer to a variable where any error code will be stored in case of failure
 * @return          Std_ReturnType
 *                  -E_OK if the Control Option #2, Control Option #3 and the number of Client/Server Services are coherently between each other.
 *                  -E_NOT_OK if the start_of_range is greater than end_of_range (contained in Control Option #3) and return DCM_E_CONDITIONSNOTCORRECT.*/
/* PRQA S 1505 1 # Here for modularity */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_RetrieveRecordRid0x0612(VAR(Dcm_StartDataIn_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineIn.dcmDspStartRoutineInSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 8).shortName»Type, AUTOMATIC) srvcmgr_OptionRecordTwo,
                                                                               VAR(Dcm_StartDataIn_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineIn.dcmDspStartRoutineInSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 16).shortName»Type, AUTOMATIC) srvcmgr_OptionRecordThree,
                                                                               P2VAR(Dcm_StartDataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 8).shortName»Type, AUTOMATIC, RTE_APPL_DATA) srvcmgr_RoutineStatusTwo,
                                                                               P2VAR(Dcm_StartDataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 24).shortName»Type, AUTOMATIC, RTE_APPL_DATA) srvcmgr_RoutineStatusThree,
                                                                               P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) srvcmgr_RoutineStatusFour,
                                                                               P2VAR(uint16, AUTOMATIC, RTE_APPL_DATA) srvcmgr_local_currentDataLength,
                                                                               const tableContentType * srvcmgr_local_tableContentType,
                                                                               P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) srvcmgr_local_ErrorCode)
{
    Std_ReturnType ret = E_NOT_OK;
    uint16 srvcmgr_startofrange = (uint16)((srvcmgr_OptionRecordThree & 0xFFFF0000u) >> 16); 	/* Lowest value of service IDs to retrieve */
    uint16 srvcmgr_endofrange = (uint16)(srvcmgr_OptionRecordThree & 0xFFFFu); 					/* Highest value of service IDs to retrieve */
    uint16 offset_srvr_packet = 0x00u;
    uint16 offset_clnt_packet;
    uint16 srvcmgr_counter;
    uint16 i;
    uint16 numOfOutputIDs = 0x00u;

    if(srvcmgr_endofrange >= srvcmgr_startofrange){
        if( srvcmgr_OptionRecordTwo ==  (uint8)SUM_SrvcMgr_Client_Table){
            ret = E_OK;
            *srvcmgr_RoutineStatusThree = srvcmgr_OptionRecordThree;
			«IF (sd.sdConfig.sdInstance.sdClientService.size > 0) »
            for(srvcmgr_counter = 0u; srvcmgr_counter < srvcmgr_local_tableContentType->num_Of_Entries_In_Client_Section; srvcmgr_counter++){
                if( (srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].service_ident.service_id >= srvcmgr_startofrange)
            			&& (srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].service_ident.service_id <= srvcmgr_endofrange) ){
					/* Each Client Data retrieved has the same size of SUM_SRVCMGR_SIZE_CLIENT_SERVICE_ROUTINE_STATUS. So it is multiplied by numOfOutputIDs*/
            		offset_clnt_packet = numOfOutputIDs * (uint16)SUM_SRVCMGR_SIZE_CLIENT_SERVICE_ROUTINE_STATUS;
            		srvcmgr_RoutineStatusFour[offset_clnt_packet] = (uint8)(srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].service_ident.service_id >> 8u);
            		srvcmgr_RoutineStatusFour[offset_clnt_packet + 1u] = (uint8)(srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].service_ident.service_id & 0xFFu);
                    srvcmgr_RoutineStatusFour[offset_clnt_packet + 2u] = (uint8)(srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].service_ident.service_instance_id >> 8u);
            		srvcmgr_RoutineStatusFour[offset_clnt_packet + 3u] = (uint8)(srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].service_ident.service_instance_id & 0xFFu);
					srvcmgr_RoutineStatusFour[offset_clnt_packet + 4u] = (uint8)srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].service_ident.major_version;
					srvcmgr_RoutineStatusFour[offset_clnt_packet + 5u] = (uint8)((srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].address.ip_address[0] & 0xFF000000u) >> 24u);
                    srvcmgr_RoutineStatusFour[offset_clnt_packet + 6u] = (uint8)((srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].address.ip_address[0] & 0xFF0000u) >> 16u);
                    srvcmgr_RoutineStatusFour[offset_clnt_packet + 7u] = (uint8)((srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].address.ip_address[0] & 0xFF00u) >> 8u);
                    srvcmgr_RoutineStatusFour[offset_clnt_packet + 8u] = (uint8)(srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].address.ip_address[0] & 0xFFu);
                    srvcmgr_RoutineStatusFour[offset_clnt_packet + 9u] = (uint8)(srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].address.port_num >> 8u);
					srvcmgr_RoutineStatusFour[offset_clnt_packet + 10u] = (uint8)(srvcmgr_local_tableContentType->entry_c_array[srvcmgr_counter].address.port_num & 0xFFu);
					numOfOutputIDs++;
            	}
            }
			«ENDIF-»
            *srvcmgr_local_currentDataLength = numOfOutputIDs * SUM_SRVCMGR_SIZE_CLIENT_SERVICE_ROUTINE_STATUS;
           	*srvcmgr_RoutineStatusTwo = numOfOutputIDs;
        }else{
            ret = E_OK;
            *srvcmgr_RoutineStatusThree = srvcmgr_OptionRecordThree;
            /* Each Server Service retrieved has a size of SUM_SRVCMGR_BASE_SIZE_SERVER_SERVICE + num_Of_Subscribers*SUM_SRVCMGR_SIZE_ADDRESS_TYPE.
            where SUM_SRVCMGR_BASE_SIZE_SERVER_SERVICE = sum of the size of the type of : service_id service_instance_id, major_version, event_group_id, num_Of_Subscribers
            where SUM_SRVCMGR_SIZE_ADDRESS_TYPE = sum of the size of the type of : ip_address, port_num
            */
			«IF (sd.sdConfig.sdInstance.sdServerService.size > 0) »
            for(srvcmgr_counter = 0u; srvcmgr_counter < srvcmgr_local_tableContentType->num_Of_Entries_In_Server_Section; srvcmgr_counter++){
                if( (srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].service_ident.service_id >= srvcmgr_startofrange)
                		&& (srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].service_ident.service_id <= srvcmgr_endofrange) ){

                    srvcmgr_RoutineStatusFour[offset_srvr_packet] = (uint8)(srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].service_ident.service_id >> 8u);
					srvcmgr_RoutineStatusFour[offset_srvr_packet + 1u] = (uint8)srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].service_ident.service_id;
                    srvcmgr_RoutineStatusFour[offset_srvr_packet + 2u] = (uint8)(srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].service_ident.service_instance_id >> 8u);
					srvcmgr_RoutineStatusFour[offset_srvr_packet + 3u] = (uint8)srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].service_ident.service_instance_id;
					srvcmgr_RoutineStatusFour[offset_srvr_packet + 4u] = (uint8)srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].service_ident.major_version;
                    srvcmgr_RoutineStatusFour[offset_srvr_packet + 5u] = (uint8)(srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].event_group_id >> 8u);
					srvcmgr_RoutineStatusFour[offset_srvr_packet + 6u] = (uint8)srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].event_group_id;
					srvcmgr_RoutineStatusFour[offset_srvr_packet + 7u] = (uint8)srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].num_Of_Subscribers;
					offset_srvr_packet += SUM_SRVCMGR_BASE_SIZE_SERVER_SERVICE;

					/* The following is needed to append at the end of the actual buffer the ip_address and the port_num knowing the num_Of_Subscribers. */
					for(i = 0u; i < srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].num_Of_Subscribers; i++)
					{
                        srvcmgr_RoutineStatusFour[offset_srvr_packet + (uint16)(i*SUM_SRVCMGR_SIZE_ADDRESS_TYPE)] = (uint8)((srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].address[i].ip_address[0] & 0xFF000000u) >> 24u);
						srvcmgr_RoutineStatusFour[offset_srvr_packet + (uint16)(i*SUM_SRVCMGR_SIZE_ADDRESS_TYPE) + 1u] = (uint8)((srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].address[i].ip_address[0] & 0xFF0000u) >> 16u);
						srvcmgr_RoutineStatusFour[offset_srvr_packet + (uint16)(i*SUM_SRVCMGR_SIZE_ADDRESS_TYPE) + 2u] = (uint8)((srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].address[i].ip_address[0] & 0xFF00u) >> 8u);
						srvcmgr_RoutineStatusFour[offset_srvr_packet + (uint16)(i*SUM_SRVCMGR_SIZE_ADDRESS_TYPE) + 3u] = (uint8)srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].address[i].ip_address[0];
						srvcmgr_RoutineStatusFour[offset_srvr_packet + (uint16)(i*SUM_SRVCMGR_SIZE_ADDRESS_TYPE) + 4u] = (uint8)(srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].address[i].port_num >> 8u);
                        srvcmgr_RoutineStatusFour[offset_srvr_packet + (uint16)(i*SUM_SRVCMGR_SIZE_ADDRESS_TYPE) + 5u] = (uint8)srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].address[i].port_num ;
					}
                	numOfOutputIDs++;
                    /* PRQA S 1891 1 # The variable offset_srvr_packet represents (after the last iteration) the length of the packet that can be till 4085 -> uint16 is necessary */
                    offset_srvr_packet += SUM_SRVCMGR_SIZE_ADDRESS_TYPE*srvcmgr_local_tableContentType->entry_s_array[srvcmgr_counter].num_Of_Subscribers;
                }

             }
			«ENDIF-»
            *srvcmgr_local_currentDataLength = offset_srvr_packet;
			*srvcmgr_RoutineStatusTwo = numOfOutputIDs;
        }
    }else{
        *srvcmgr_local_ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
    }
    return ret;
}

/**
 * @brief           SrvcMgr function that valued Routine Signal #1 and #2
 *
 * @param[in]       srvcmgr_OptionRecordOne Control Option #1
 * @param[in]       srvcmgr_OptionRecordTwo Control Option #2
 * @param[out]      srvcmgr_RoutineStatusOne Pointer to Routine Status Signal #1
 * @param[out]      srvcmgr_RoutineStatusTwo Pointer to Routine Status Signal #2
 * @param[in]       srvcmgr_local_tableContentType Pointer to the struct that contains the Learning Table content
 * @param[out]      srvcmgr_local_ErrorCode A pointer to a variable where any error code will be stored in case of failure
 * @return          Std_ReturnType
 *                  -E_OK if the Control Option #1 and Control Option #2 are coherent each other
 *                  -E_NOT_OK if the Control Option #1 and Control Option #2 are NOT coherent each other. srvcmgr_local_ErrorCode will assume therefore DCM_E_CONDITIONSNOTCORRECT. */
/* PRQA S 1505 1 # Here for modularity */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_ReportFirstTwoSignalOutRid0x0612(VAR(Dcm_StartDataIn_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineIn.dcmDspStartRoutineInSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName»Type, AUTOMATIC) srvcmgr_OptionRecordOne,
                                                                                        VAR(Dcm_StartDataIn_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineIn.dcmDspStartRoutineInSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 8).shortName»Type, AUTOMATIC) srvcmgr_OptionRecordTwo,
                                                                                        P2VAR(Dcm_StartDataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName»Type, AUTOMATIC, RTE_APPL_DATA) srvcmgr_RoutineStatusOne,
                                                                                        P2VAR(Dcm_StartDataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.shortName»_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 8).shortName»Type, AUTOMATIC, RTE_APPL_DATA) srvcmgr_RoutineStatusTwo,
                                                                                        const tableContentType * srvcmgr_local_tableContentType,
                                                                                        P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) srvcmgr_local_ErrorCode)
{
    Std_ReturnType ret = E_NOT_OK;

    /* Check if there is consistency between the Control Option received and Routine Status #1 and #2 are valued accordingly. */
    if((srvcmgr_OptionRecordOne + srvcmgr_OptionRecordTwo) == 0x01u){
       *srvcmgr_RoutineStatusTwo = srvcmgr_local_tableContentType->num_Of_Entries_In_Client_Section;
       *srvcmgr_RoutineStatusOne = 0x00u;
       ret = E_OK;
    }else{
        if(((srvcmgr_OptionRecordOne + srvcmgr_OptionRecordTwo) == 0x02u) && (srvcmgr_OptionRecordOne != 0x01u))
        {
            *srvcmgr_RoutineStatusTwo = srvcmgr_local_tableContentType->num_Of_Entries_In_Server_Section;
            *srvcmgr_RoutineStatusOne = 0x01u;
            ret = E_OK;
        }else{
            /* If the Control Options are not consistent, the Error Code is DCM_E_CONDITIONSNOTCORRECT and this function return E_NOT_OK. */
            *srvcmgr_local_ErrorCode = DCM_E_CONDITIONSNOTCORRECT;
        }
    }
    return ret;
}

/**
 * @brief           SrvcMgr runnable RID 0x0612 Retrieve Learning Table Content
 *
 * @param[in]       DataIn_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineIn.dcmDspStartRoutineInSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName» Control Option #1
 * @param[in]       DataIn_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineIn.dcmDspStartRoutineInSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 8).shortName» Control Option #2
 * @param[in]       DataIn_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineIn.dcmDspStartRoutineInSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 16).shortName» Control Option #3
 * @param[in]       OpStatus The operation status, indicating the current phase of the service operation.
 * @param[out]      DataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 0).shortName» Pointer to  Routine Status Signal #1
 * @param[out]      DataOut_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref.dcmDspStartRoutine.dcmDspStartRoutineOut.dcmDspStartRoutineOutSignal.selectFirst(e|e.dcmDspRoutineSignalPos == 8).shortName» Pointer to  Routine Status Signal #2
