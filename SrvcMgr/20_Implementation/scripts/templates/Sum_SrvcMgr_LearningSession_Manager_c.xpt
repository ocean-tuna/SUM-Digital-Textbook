«ELSEIF SrvcMgr_IsPSAServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»
        *srvcmgr_PropSysActv = (boolean)(srv_signal_psa->«SrvcMgr_GetImplementationDataTypeElementName(srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_PropSysActv_Ref)» != 0u);
«ELSE-»
«IF  srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_PropSysActv_Ref.comSignalType == "UINT8"-»
        *srvcmgr_PropSysActv = (boolean)(signal_PropSysActv != 0u);
«ENDIF-»
«ENDIF-»
«IF  SrvcMgr_IsVehSpdAvgDrvnGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»
        /* Reception of the Vehicle Speed signal via the Com Signal Group */
        «IF SrvcMgr_IsE2EConfigured(srvcMgr.sum_SrvcMgr_ConfigSet, "VehSpdAvgDrvn")-»
        ret = Rte_Read_RP_Com_SrvcMgr_YeVSPR_v_DrvnVehicle_YeVSPR_v_DrvnVehicleRxSignal(signal_group_vehspeed, &transformerError_speed);
        «ELSE-»
        ret = Rte_Read_RP_Com_SrvcMgr_YeVSPR_v_DrvnVehicle_YeVSPR_v_DrvnVehicleRxSignal(signal_group_vehspeed);
        «ENDIF-»
        if (ret == E_OK)
        {
            *srvcmgr_VehicleSpeed = signal_group_vehspeed->RxSignal_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_VehSpdAvgDrvn_Ref.shortName»;
        }
«ELSEIF SrvcMgr_IsVehSpdAvgDrvnServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»
        /* Read Vehicle Speed signal from RTE port (Service-Based) */
        ret = Rte_Read_RP_Com_SrvcMgr_YeVSPR_v_DrvnVehicle_YeVSPR_v_DrvnVehicleRxSignal(srv_signal_vehspeed, &transformerError_speed);
        if (ret == E_OK)
        {
            *srvcmgr_VehicleSpeed = srv_signal_vehspeed->«SrvcMgr_GetImplementationDataTypeElementName(srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_VehSpdAvgDrvn_Ref)»;
        }
«ELSE-»
        /* Read Vehicle Speed signal from RTE port RP_Com_SrvcMgr_YeVSPR_v_DrvnVehicle */
        ret = Rte_Read_RP_Com_SrvcMgr_YeVSPR_v_DrvnVehicle_YeVSPR_v_DrvnVehicleRxSignal(srvcmgr_VehicleSpeed);
«ENDIF-»
    }
«ELSE -»
«IF SrvcMgr_IsPropSysActvGroupSignal(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    /* Reception of the PropSysActv and VehicleSpeed signals via the Com Signal Group */
    «IF SrvcMgr_IsE2EConfigured(srvcMgr.sum_SrvcMgr_ConfigSet, "PropSysActv")-»
    ret = Rte_Read_RP_Com_SrvcMgr_VeActvProp_YeDrvnVeh_VeActvProp_YeDrvnVeh_RxSignal(signal_group, &transformerError);
    «ELSE-»
    ret = Rte_Read_RP_Com_SrvcMgr_VeActvProp_YeDrvnVeh_VeActvProp_YeDrvnVeh_RxSignal(signal_group);
    «ENDIF-»
    if (ret == E_OK)
    {
        *srvcmgr_PropSysActv = (boolean)(signal_group->RxSignal_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_PropSysActv_Ref.shortName» != 0u);
        *srvcmgr_VehicleSpeed = signal_group->RxSignal_«srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_VehSpdAvgDrvn_Ref.shortName»;
    }
«ELSEIF SrvcMgr_IsPSAServiceBased(srvcMgr.sum_SrvcMgr_ConfigSet)-»
    /* Read PropSysActv signal from RTE port (Service-Based) */
    ret = Rte_Read_RP_Com_SrvcMgr_VeActvProp_YeDrvnVeh_VeActvProp_YeDrvnVeh_RxSignal(srv_signal, &transformerError);
    if (ret == E_OK)
    {
        *srvcmgr_PropSysActv = (boolean)(srv_signal->«SrvcMgr_GetImplementationDataTypeElementName(srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_PropSysActv_Ref)» != 0u);
        /* Read Vehicle Speed signal from RTE port (Service-Based) */
        *srvcmgr_VehicleSpeed = srv_signal->«SrvcMgr_GetImplementationDataTypeElementName(srvcMgr.sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_VehSpdAvgDrvn_Ref)»;
    }
«ENDIF-»
«ENDIF-»
    return ret;
}


 /**
 * @brief           SrvcMgr runnable DID 0xE0CC Data Service Discovery Learning Table ReadData
 *
 * @param[in]       void
 * @param[inout]    void
 * @param[out]      void
 * @return          Std_ReturnType */
/* PRQA S 1503 1 # When the SSFM is integrated, this runnable will be called */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Runnable_SrvcMgr_DID_E0CC_ReadData(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
	/*[$Satisfies $DDS_SrvcMgr 007]*/
	tableStateType LearningTableSts;
	switch (OpStatus)
	{
		case DCM_INITIAL:
		case DCM_PENDING:
			/* Get Learning Table Status by calling API from Sd */
			/* PRQA S 3469 1 # This function will be defined in BSW */
			Sd_GetLearningTableState(&LearningTableSts);
			*Data = (uint8)LearningTableSts;
			break;
		default:
			/* Nothing to do */
			break;
	}
	return E_OK;
}

