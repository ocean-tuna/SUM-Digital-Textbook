FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Runnable_SrvcMgr_DID_E0CC_CheckRead(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus, P2VAR(Dcm_NegativeResponseCodeType, AUTOMATIC, RTE_APPL_DATA) ErrorCode)
