/**
* @brief			Function to retrieve the Dtc value
*
* @param serviceId		The Service ID for which the DTC value is to be retrieved. Must be a valid configured Service ID.
* @param dtcValue		Pointer to a variable where the retrieved DTC value will be stored. Must not be NULL.
* @return			Std_ReturnType: E_OK, if the DTC value was successfully retrieved, Otherwise E_NOT_OK.
*/
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_RetrieveDtcIdValue (CONST(uint16, AUTOMATIC) serviceId, P2VAR(uint16, AUTOMATIC, RTE_APPL_DATA) dtcValue)
{
	/* PRQA S 2981 2 */ /* Initialisation is useful for verifying the correctness of the operations performed. */
    Std_ReturnType retVal = E_NOT_OK;
    uint32 ipAddress;
    uint16 srvcmgr_srvcIndexInConfigArray;
    uint16 srvcmgr_InstanceId;
    uint8 srvcmgr_MajorVersion;
    /* Initialize the dtcValue variable*/
    *dtcValue = 0x0000u;

    /* Check the value of SdEnableExtendedLearningTableFormat calib parameter. */
    if(Sum_SrvcMgr_pub_GetSdEnableExtendedLearningTableFormat() == FALSE)
    {
        /* If False, the major Version and Instance id is zero. So no need to search the Service Index.*/
        retVal = Sd_GetNodeAddress(serviceId, 0u, 0u, &ipAddress);
    }
    else
    {
        /* Obtain the index by searching the Service ID in the SrvcMgr_SrvcInfo configuration array. */
        retVal = Sum_SrvcMgr_pub_isIdConfigured(serviceId, SUM_SrvcMgr_SearchService, &srvcmgr_srvcIndexInConfigArray);

        if (retVal == E_OK)
        {
            /* Retrieve the InstanceId and MajorVersion for this Serviceid*/
            srvcmgr_InstanceId= Sum_SrvcMgr_pub_GetSrvcInstanceId(srvcmgr_srvcIndexInConfigArray);
            srvcmgr_MajorVersion= Sum_SrvcMgr_pub_GetSrvcMajorVersion(srvcmgr_srvcIndexInConfigArray);
            retVal = Sd_GetNodeAddress(serviceId,srvcmgr_InstanceId,srvcmgr_MajorVersion,&ipAddress);
        }
        else
        {
            /* Nothing to do. Returns E_NOT_OK */
        }
    }

    if (retVal == E_OK)
    {
        /* Retrieve the DTC id from the SPM module */
        (void) Rte_Call_SUM_SrvcMgr_RP_SPM_SrvcMgr_GetDTCIdentifier_GetDTCIdentifier(ipAddress,dtcValue);
    }


    return retVal;
}

/**
 * @brief			Function to update  the InstanceId and MajorVersion to 0 for each configured Service
 *
 * @return			void
 */
FUNC(void, SUM_SrvcMgr_CODE) Sum_SrvcMgr_UpdateMajorVersionAndInstanceId(void)
{
    uint16 i;
    for (i = 0; i < SUM_SRVCMGR_NUMBER_OF_SRVC_CONFIGURED; i++)
    {	
        
        SrvcMgr_SrvcInfo[i].SrvcMgr_SrvcInstanceId = 0u;
        SrvcMgr_SrvcInfo[i].SrvcMgr_SrvcMajorVersion = 0u;
    }
}

