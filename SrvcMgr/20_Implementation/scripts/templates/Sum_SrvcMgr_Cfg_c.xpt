«IF sd.sdConfig.sdServiceGroup.size > 0 -»
static FUNC(uint16, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_GetSrvcGrpId(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index);
«ENDIF-»
static FUNC(uint16, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_GetSrvcId(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index);

typedef P2FUNC(uint16, TYPEDEF, (Sum_SrvcMgr_prv_GetIdType_fp)) (CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index);
