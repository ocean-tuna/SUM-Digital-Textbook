 */
FUNC(boolean, SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_IsClientSrvc(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index){
    return SrvcMgr_SrvcInfo[Sum_SrvcMgr_prv_Index].SrvcMgr_isClientSrvc;
}

«IF sd.sdConfig.sdServiceGroup.size > 0 -»
