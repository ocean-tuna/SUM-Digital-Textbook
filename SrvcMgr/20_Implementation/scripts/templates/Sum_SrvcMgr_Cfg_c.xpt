FUNC(P2CONST(uint16, AUTOMATIC, RTE_APPL_DATA), SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_GetListofSrvcsInsideSrvcGrp(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index){
    return SrvcMgr_SrvcGrpInfo[Sum_SrvcMgr_prv_Index].SrvcMgr_ListOfSrvcs;
}
«ENDIF-»

/**
 * @brief Check if a ID (Service or Service Group) is configured in the SD container.
 *
 * Perform the binary search algorithm to search if a ID is configured in the SD container.
 *
 * @param Sum_SrvcMgr_prv_IndexTarget: Id of the Service or Service Group that is needed to be find.
 * @param Sum_SrvcMgr_prv_CommandSearch: Command used to understand if the ID to find is a Service or a Service Group.
 * @param Sum_SrvcMgr_prv_IndexSrvcInTheArray: if the ID is find, this pointer will assume the value of that Service's index in the conf array.
 * @return Std_ReturnType:
 *               E_OK: the Service ID is find;
 *               E_NOT_OK: Otherwise;
 */
/*PRQA S 3206 2 # If No Service Group are present, the input parameter Sum_SrvcMgr_prv_CommandSearch is not used. */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_isIdConfigured(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_IndexTarget,
                                                                      CONST(Sum_SrvcMgr_SearchCommand, AUTOMATIC) Sum_SrvcMgr_prv_CommandSearch,
                                                                      P2VAR(uint16, TYPEDEF, RTE_APPL_DATA)Sum_SrvcMgr_prv_IndexSrvcInTheArray){
    uint16 Sum_SrvcMgr_prv_IntervalMid;
    sint32 Sum_SrvcMgr_prv_IntervalLowerLimit = 0x00;
    sint32 Sum_SrvcMgr_prv_IntervalUpperLimit;
    Std_ReturnType ret_value = E_NOT_OK;
    Sum_SrvcMgr_prv_GetIdType_fp Sum_SrvcMgr_prv_GetId;

    «IF sd.sdConfig.sdServiceGroup.size > 0 -»
    if(Sum_SrvcMgr_prv_CommandSearch == SUM_SrvcMgr_SearchService){
        Sum_SrvcMgr_prv_IntervalUpperLimit = (sint32)((sint32)SUM_SRVCMGR_NUMBER_OF_SRVC_CONFIGURED - 0x01);
        Sum_SrvcMgr_prv_GetId = Sum_SrvcMgr_prv_GetSrvcId;
    }else{
        Sum_SrvcMgr_prv_IntervalUpperLimit = (sint32)((sint32)SUM_SRVCMGR_NUMBER_OF_SRVCGRP_CONFIGURED - 0x01);
        Sum_SrvcMgr_prv_GetId = Sum_SrvcMgr_prv_GetSrvcGrpId;
    }
    «ELSE-»
    Sum_SrvcMgr_prv_IntervalUpperLimit = (sint32)((sint32)SUM_SRVCMGR_NUMBER_OF_SRVC_CONFIGURED - 0x01);
    Sum_SrvcMgr_prv_GetId = Sum_SrvcMgr_prv_GetSrvcId;
    «ENDIF-»

    while((Sum_SrvcMgr_prv_IntervalLowerLimit <= Sum_SrvcMgr_prv_IntervalUpperLimit) && (ret_value == E_NOT_OK)){
        Sum_SrvcMgr_prv_IntervalMid = ((uint16)Sum_SrvcMgr_prv_IntervalLowerLimit + (((uint16)Sum_SrvcMgr_prv_IntervalUpperLimit - (uint16)Sum_SrvcMgr_prv_IntervalLowerLimit) / 0x02u));

        if(Sum_SrvcMgr_prv_GetId(Sum_SrvcMgr_prv_IntervalMid) == Sum_SrvcMgr_prv_IndexTarget){
            ret_value = E_OK;
            *Sum_SrvcMgr_prv_IndexSrvcInTheArray = Sum_SrvcMgr_prv_IntervalMid;
        }else{
            if(Sum_SrvcMgr_prv_IndexTarget > Sum_SrvcMgr_prv_GetId(Sum_SrvcMgr_prv_IntervalMid) ){
                Sum_SrvcMgr_prv_IntervalLowerLimit = (sint32)((sint32)Sum_SrvcMgr_prv_IntervalMid + 0x01);
    	    }else{
                Sum_SrvcMgr_prv_IntervalUpperLimit = (sint32)((sint32)Sum_SrvcMgr_prv_IntervalMid - 0x01);
            }
        }
    }

    return ret_value;
}

/**
 * @brief Set the Status Calibration for a given Service Id.
 *
 *
 * @param Sum_SrvcMgr_prv_Index: Id of the Service that is necessary to set the status.
 * @param Sum_SrvcMgr_prv_State: State to be set for the Service Id instance.
 * @return boolean:
 *               TRUE: the Status is properly set;
 *               FALSE: the Status is not set since the Id instance is not find;
 */
 /*PRQA S 1503 1*/ //This function will be used in future development.
FUNC(boolean, SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_SetSrvcCalibrationState(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index, CONST(Sum_SrvcMgr_CalibrationState, AUTOMATIC) Sum_SrvcMgr_prv_State){
    boolean ret = FALSE;
    uint16 i;
    for(i = 0; ((i < SUM_SRVCMGR_NUMBER_OF_SRVC_CONFIGURED) && (ret == FALSE)); i++){
        if(Sum_SrvcMgr_prv_Index == SrvcMgr_SrvcInfo[i].SrvcMgr_SrvcId){
            SrvcMgr_SrvcInfo[i].SrvcMgr_CalibrationState = Sum_SrvcMgr_prv_State;
            ret = TRUE;
        }
    }
    return ret;
}

/**
 * @brief Get SrvcMgr_CalibrationState of the Service at index Sum_SrvcMgr_prv_SrvcIndexInTheConfArray in the SrvcMgr_SrvcInfo.
 *
 * @param Sum_SrvcMgr_prv_SrvcIndexInTheConfArray: index in the conf array of the Service which we are looking for.
 * @return Sum_SrvcMgr_CalibrationState:
 *               - SUM_SrvcMgr_CalibrationON: the Service is calibrated;
 *               - SUM_SrvcMgr_CalibrationOFF: the Service is NOT calibrated;
 */
FUNC(Sum_SrvcMgr_CalibrationState, SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_GetSrvcCalibrationState(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_SrvcIndexInTheConfArray)
{
    return SrvcMgr_SrvcInfo[Sum_SrvcMgr_prv_SrvcIndexInTheConfArray].SrvcMgr_CalibrationState;
}

/**
 * @brief Check if the Service at index Sum_SrvcMgr_prv_SrvcIndexInTheConfArray in the SrvcMgr_SrvcInfo array has a
 *  SrvcMgr_SrvcClientSdConsumedEventGroupInfo associated.
 *
 * @param Sum_SrvcMgr_prv_SrvcIndexInTheConfArray: index in the conf array of the Service which we are looking for.
 * @return boolean:
 *               - TRUE: the Service has a struct SrvcMgr_SrvcClientSdConsumedEventGroupInfo associated (that means that Service has at least one SdConsumedEventGroup associated);
 *               - FALSE: Otherwise;
 */
FUNC(boolean, SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_HasServiceConsumedEventGroup(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_SrvcIndexInTheConfArray)
{
    boolean ret;
    if(SrvcMgr_SrvcInfo[Sum_SrvcMgr_prv_SrvcIndexInTheConfArray].SrvcMgr_SrvcClientSdConsumedEventGroupInfo == NULL_PTR){
        ret = FALSE;
    }else{
        ret = TRUE;
    }
    return ret;
}

/**
 * @brief Return the pointer to the struct SrvcMgr_SrvcClientSdConsumedEventGroupInfo of the SrvcMgr_SrvcInfo's
 * member at Sum_SrvcMgr_prv_SrvcIndexInTheConfArray index.
 *
 * @param Sum_SrvcMgr_prv_SrvcIndexInTheConfArray: index in the conf array of the Service which we are looking for.
 * @return const SrvcMgr_SrvcClientSdConsumedEventGroupInfoType *:
 *               - return pointer to the struct SrvcMgr_SrvcClientSdConsumedEventGroupInfo of the SrvcMgr_SrvcInfo's
 *                 member of Sum_SrvcMgr_prv_SrvcIndexInTheConfArray index;
 */
FUNC(P2CONST(SrvcMgr_SrvcClientSdConsumedEventGroupInfoType, AUTOMATIC, RTE_APPL_DATA), SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_GetSrvcClientSdConsumedEventGroupInfo(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_SrvcIndexInTheConfArray)
{
    return SrvcMgr_SrvcInfo[Sum_SrvcMgr_prv_SrvcIndexInTheConfArray].SrvcMgr_SrvcClientSdConsumedEventGroupInfo;
}


/**
 * @brief Check if a service belongs to a Service Group.
 *
 * This function checks if the service at the given index references any SdServiceGroup.
 * According to AUTOSAR [SWS_Sd_00746], services that belong to a service group must only
 * be controlled via Sd_ServiceGroupStart/Stop, not via Sd_ServerServiceSetState/Sd_ClientServiceSetState.
 *
 * @param Sum_SrvcMgr_prv_Index: Index of the service in the configuration array.
 * @return TRUE if service belongs to a service group, FALSE otherwise.
 */
static FUNC(boolean, SUM_SrvcMgr_CODE) Sum_SrvcMgr_pub_BelongsToServiceGroup(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index)
{
    return (SrvcMgr_SrvcInfo[Sum_SrvcMgr_prv_Index].SrvcMgr_SrvcsGrpAssociatedInfo != NULL_PTR);
}

/**
 * @brief Start or Stop Service Groups associated with a service.
 *
 * This function starts or stops all Service Groups to which the service belongs.
 * According to AUTOSAR [SWS_Sd_00746] and [SD_GM_0028], services belonging to a 
 * service group must only be controlled via Sd_ServiceGroupStart/Stop.
 *
 * @param Index_of_SrvID: Index of the service in the configuration array.
 * @param Sum_SrvcMgr_prv_ActivationCommand: TRUE to start service groups, FALSE to stop.
 */
FUNC(Std_ReturnType, SUM_SrvcMgr_CODE) Sum_SrvcMgr_ConfigureServiceGroupActivation(CONST(uint16, AUTOMATIC) Index_of_SrvID, CONST(boolean, AUTOMATIC) Sum_SrvcMgr_prv_ActivationCommand)
{
	Std_ReturnType retVal = E_NOT_OK;
	uint16 Sd_loop;

	if(Sum_SrvcMgr_pub_BelongsToServiceGroup(Index_of_SrvID) == TRUE)
	{
		for(Sd_loop = 0U; Sd_loop < SrvcMgr_SrvcInfo[Index_of_SrvID].SrvcMgr_SrvcsGrpAssociatedInfo->SrvcMgr_NumberOfSrvcGrps; Sd_loop++)
		{
			if(Sum_SrvcMgr_prv_ActivationCommand == TRUE)
			{
				/* Activate: Start the service group */
				Sd_ServiceGroupStart(SrvcMgr_SrvcInfo[Index_of_SrvID].SrvcMgr_SrvcsGrpAssociatedInfo->SrvcMgr_ListOfSrvcGrps[Sd_loop]);
			}
			else
			{
				/* Deactivate: Stop the service group */
				Sd_ServiceGroupStop(SrvcMgr_SrvcInfo[Index_of_SrvID].SrvcMgr_SrvcsGrpAssociatedInfo->SrvcMgr_ListOfSrvcGrps[Sd_loop]);
			}
		}
		retVal = E_OK;
	}

	return retVal;
}

