«FOREACH sd.sdConfig.sdServiceGroup AS servicegroup-»
«LET servicegroup.sdServiceGroupHandleId AS GroupId-»
«LET servicegroup.shortName AS NameGroup-»
    «IF (sd.sdConfig.sdInstance.sdClientService.sdServiceGroupRef.shortName.contains(NameGroup) || sd.sdConfig.sdInstance.sdServerService.sdServiceGroupRef.shortName.contains(NameGroup)) == true-»
/* Represent the Service Ids associated to the Service Group «servicegroup.shortName» */
static const uint16 Sum_SrvcMgr_prv_ListOfSrvcsIdOfsrvcGrpId_«NameGroup»[] = {
        «FOREACH sd.sdConfig.sdInstance AS SdInstance-»
            «FOREACH SdInstance.sdClientService AS SdService-»
                «FOREACH SdService.sdServiceGroupRef AS GroupRef -»
                    «IF GroupId == GroupRef.sdServiceGroupHandleId -»
    «SdService.sdClientServiceId»u,
                    «ENDIF-»
                «ENDFOREACH-»
            «ENDFOREACH-»
        «FOREACH SdInstance.sdServerService AS SdService-»
            «FOREACH SdService.sdServiceGroupRef AS GroupRef -»
                «IF GroupId == GroupRef.sdServiceGroupHandleId -»
    «SdService.sdServerServiceId»u,
                «ENDIF-»
            «ENDFOREACH-»
        «ENDFOREACH-»
        «ENDFOREACH-»
};
    «ENDIF-»
«ENDLET-»
«ENDLET-»
«ENDFOREACH-»

«IF sd.sdConfig.sdServiceGroup.size > 0 -»
/* Each member represent a Service Group instance. */
static const SUM_SrvcMgr_SrvcGrpType SrvcMgr_SrvcGrpInfo[] =
{
    «FOREACH sd.sdConfig.sdServiceGroup.sortBy(e | e.sdServiceGroupHandleId) AS servicegroup-»
        «LET servicegroup.sdServiceGroupHandleId AS GroupId-»
        «LET servicegroup.shortName AS NameGroup-»
    {
        /* Service Group Id */
        «GroupId»u,
        «IF (sd.sdConfig.sdInstance.sdClientService.sdServiceGroupRef.shortName.contains(NameGroup) || sd.sdConfig.sdInstance.sdServerService.sdServiceGroupRef.shortName.contains(NameGroup)) == true-»
        /* List of Service IDs associated with this Service Group */
        Sum_SrvcMgr_prv_ListOfSrvcsIdOfsrvcGrpId_«NameGroup»,
        /* Total number of Services associated with this Service Group */
		«(sd.sdConfig.sdInstance.sdClientService.collect(e | e.sdServiceGroupRef.shortName.contains(NameGroup))).select(e | e == true).size + (sd.sdConfig.sdInstance.sdServerService.collect(e | e.sdServiceGroupRef.shortName.contains(NameGroup))).select(e | e == true).size»u
        «ELSE-»
        /* No Services associated with this Service Group */
        NULL_PTR,
        0x00u
        «ENDIF-»
    },
        «ENDLET-»
        «ENDLET-»
    «ENDFOREACH-»
};
«ENDIF-»

«FOREACH sd.sdConfig.sdInstance AS SdInstance-»
    «FOREACH SdInstance.sdClientService AS SdService-»
        «LET SdService.sdConsumedEventGroup AS Event-»
        «IF Event.size > 0-»
/* Represents the List of SdConsumedEventGroupHandleId of SdConsumedEventGroups associated to the Client Service «SdService.shortName». */
static const uint16 SrvcMgr_ListOfSdConsumedEventGroup_by_«SdService.shortName»[] =
{
            «FOREACH Event.sdConsumedEventGroupHandleId AS EventId-»
            «EventId-»u,
            «ENDFOREACH-»

};
        «ENDIF-»
        «ENDLET-»
    «ENDFOREACH-»
«ENDFOREACH-»

«FOREACH sd.sdConfig.sdInstance AS SdInstance-»
	«FOREACH SdInstance.sdClientService AS SdService-»
        «LET SdService.sdConsumedEventGroup AS Event-»
        «IF Event.size > 0-»
/* Informations related the SdConsumedEventGroups of the Client Service «SdService.shortName». */
static const SrvcMgr_SrvcClientSdConsumedEventGroupInfoType SrvcMgr_SrvcClientSdConsumedEventGroupInfo_«SdService.shortName» =
{
    /* Total number of SdConsumedEventGroups configured */
    «Event.size»u,
    /* The HandleIds list by which the BswM can identify this EventGroup */
    SrvcMgr_ListOfSdConsumedEventGroup_by_«SdService.shortName»
};
        «ENDIF-»
		«ENDLET-»
	«ENDFOREACH-»
«ENDFOREACH-»


«FOREACH sd.sdConfig.sdInstance AS SdInstance-»
    «FOREACH SdInstance.sdClientService AS SdService-»
        «LET SdService.sdServiceGroupRef AS GroupIdRef-»
        «IF GroupIdRef.size > 0-»
/* Represents a list of the Service Groups IDs to which the Client Service «SdService.shortName» is associated. */
static const uint16 Sum_SrvcMgr_prv_ListOfSrvcGrpIdsOfSrvcId_«SdService.sdClientServiceId»[] =
{
            «FOREACH SdService.sdServiceGroupRef AS GroupIdServices-»
        «GroupIdServices.sdServiceGroupHandleId»u,
            «ENDFOREACH-»
};
        «ENDIF-»
        «ENDLET-»
    «ENDFOREACH-»
    «FOREACH SdInstance.sdServerService AS SdService-»
        «LET SdService.sdServiceGroupRef AS GroupIdRef-»
        «IF GroupIdRef.size > 0-»
/* Represents a list of the Service Groups IDs to which the Server Service «SdService.shortName» is associated. */
static const uint16 Sum_SrvcMgr_prv_ListOfSrvcGrpIdsOfSrvcId_«SdService.sdServerServiceId»[] =
{
        «FOREACH SdService.sdServiceGroupRef AS GroupIdServices-»
        «GroupIdServices.sdServiceGroupHandleId»u,
        «ENDFOREACH-»
};
        «ENDIF-»
        «ENDLET-»
    «ENDFOREACH-»
«ENDFOREACH-»

«FOREACH sd.sdConfig.sdInstance AS SdInstance-»
    «FOREACH SdInstance.sdClientService AS SdService-»
        «LET SdService.sdServiceGroupRef AS GroupIdRef-»
        «IF GroupIdRef.size > 0-»
/** Information about the Services Group referenced by the Client Service. */
static const SrvcMgr_SrvcsGrpAssociatedToSrvcInfoType SrvcMgr_SrvcsGrpAssociatedToSrvc_«SdService.shortName-» =
{
	/* Total number of Service Group(s) */
    «GroupIdRef.size»u,
    /* List of Service Group Id(s) */
    Sum_SrvcMgr_prv_ListOfSrvcGrpIdsOfSrvcId_«SdService.sdClientServiceId»
};
        «ENDIF-»
        «ENDLET-»
    «ENDFOREACH-»
    «FOREACH SdInstance.sdServerService AS SdService-»
        «LET SdService.sdServiceGroupRef AS GroupIdRef-»
        «IF GroupIdRef.size > 0-»
/** Information about the Services Group referenced by the Server Service. */
static const SrvcMgr_SrvcsGrpAssociatedToSrvcInfoType SrvcMgr_SrvcsGrpAssociatedToSrvc_«SdService.shortName-» =
{
	/* Total number of Service Group(s) */
    «GroupIdRef.size-»u,
     /* List of Service Group Id(s) */
    Sum_SrvcMgr_prv_ListOfSrvcGrpIdsOfSrvcId_«SdService.sdServerServiceId»
};
        «ENDIF-»
        «ENDLET-»
    «ENDFOREACH-»
«ENDFOREACH-»

/*PRQA S 3678 2*/ //The following array is not declared as CONST since the member SrvcMgr_CalibrationState can be set at startup.
/* Each member represent a Service instance. */
static SUM_SrvcMgr_SrvcInfoType SrvcMgr_SrvcInfo[] =
{
«FOREACH SrvcMgr_CreateListOfAllService(sd.sdConfig.sdInstance.sdClientService, sd.sdConfig.sdInstance.sdServerService) AS Srvc-»
  {
    /* Service Id */
    «Srvc.getProperty("id")»u,
    /* Service Istance ID */
    «Srvc.getProperty("ServiceIstanceId")»u,
    /* Service Major Version */
    «Srvc.getProperty("ServiceMajorVers")»u,
    /* HandleId used by BswM to identify the Service Instance */
    «Srvc.getProperty("HandleId")»u,
     /* Information of the Services Group to which this Service is associated */
    «IF Srvc.getProperty("GroupIdRefSize") > 0-»
    &SrvcMgr_SrvcsGrpAssociatedToSrvc_«Srvc.getProperty("ServiceName")-»,
    «ELSE-»
    NULL_PTR,
    «ENDIF-»
     /* Information about the SdConsumedEventGroups of a Client Service */
    «IF (Srvc.getProperty("IsClient") == "true" && Srvc.getProperty("CnsmdEvntGrp") > 0) -»
    &SrvcMgr_SrvcClientSdConsumedEventGroupInfo_«Srvc.getProperty("ServiceName")»,
    «ELSE-»
    NULL_PTR,
    «ENDIF-»
    /* Flag to represent if the Service is a Client (T) or a Server Service (F)*/
    «IF (Srvc.getProperty("IsClient") == "true")-»
    TRUE,
    «ELSE-»
    FALSE,
    «ENDIF-»
    /* Calibration state of the Service */
    SUM_SrvcMgr_CalibrationON
  },
«ENDFOREACH-»
};

/**
 * @brief Returns the ID value of the Service corresponding to Sum_SrvcMgr_prv_Index, present in the SrvcMgr_SrvcInfo.
 */
static FUNC(uint16, SUM_SrvcMgr_CODE) Sum_SrvcMgr_prv_GetSrvcId(CONST(uint16, AUTOMATIC) Sum_SrvcMgr_prv_Index){
    return SrvcMgr_SrvcInfo[Sum_SrvcMgr_prv_Index].SrvcMgr_SrvcId;
}

