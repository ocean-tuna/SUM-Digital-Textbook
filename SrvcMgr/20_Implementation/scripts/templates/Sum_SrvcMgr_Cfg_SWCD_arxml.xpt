                    <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/SUM_SrvcMgr/PortInterfaces/SrvcMgr_CalibrationController/E_NOT_OK</POSSIBLE-ERROR-REF>
                    <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/SUM_SrvcMgr/PortInterfaces/SrvcMgr_CalibrationController/E_OK</POSSIBLE-ERROR-REF>
                  </POSSIBLE-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
              <POSSIBLE-ERRORS>
                <APPLICATION-ERROR>
                  <SHORT-NAME>E_OK</SHORT-NAME>
                  <ERROR-CODE>0</ERROR-CODE>
                </APPLICATION-ERROR>
                <APPLICATION-ERROR>
                  <SHORT-NAME>E_NOT_OK</SHORT-NAME>
                  <ERROR-CODE>1</ERROR-CODE>
                </APPLICATION-ERROR>
              </POSSIBLE-ERRORS>
            </CLIENT-SERVER-INTERFACE>
            <CLIENT-SERVER-INTERFACE>
              <SHORT-NAME>SrvcMgr_ServiceCalibrationOff</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SrvcMgr_DisableService</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>serviceId</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-ERROR-REFS>
                    <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/SUM_SrvcMgr/PortInterfaces/SrvcMgr_ServiceCalibrationOff/E_OK</POSSIBLE-ERROR-REF>
                    <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/SUM_SrvcMgr/PortInterfaces/SrvcMgr_ServiceCalibrationOff/E_NOT_OK</POSSIBLE-ERROR-REF>
                  </POSSIBLE-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>SrvcMgr_DisableServiceGroup</SHORT-NAME>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>serviceGroupId</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
                  </ARGUMENTS>
                  <POSSIBLE-ERROR-REFS>
                    <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/SUM_SrvcMgr/PortInterfaces/SrvcMgr_ServiceCalibrationOff/E_OK</POSSIBLE-ERROR-REF>
                    <POSSIBLE-ERROR-REF DEST="APPLICATION-ERROR">/SUM_SrvcMgr/PortInterfaces/SrvcMgr_ServiceCalibrationOff/E_NOT_OK</POSSIBLE-ERROR-REF>
                  </POSSIBLE-ERROR-REFS>
                </CLIENT-SERVER-OPERATION>
              </OPERATIONS>
              <POSSIBLE-ERRORS>
                <APPLICATION-ERROR>
                  <SHORT-NAME>E_OK</SHORT-NAME>
                  <ERROR-CODE>0</ERROR-CODE>
                </APPLICATION-ERROR>
                <APPLICATION-ERROR>
                  <SHORT-NAME>E_NOT_OK</SHORT-NAME>
                  <ERROR-CODE>1</ERROR-CODE>
                </APPLICATION-ERROR>
              </POSSIBLE-ERRORS>
            </CLIENT-SERVER-INTERFACE>
«IF !SrvcMgr_IsSameSignalReference(sum_SrvcMgr_ConfigSet)-»            
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>VePSAR_b_PropSysActv</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>VePSAR_b_PropSysActvRxSignal</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
«IF SrvcMgr_IsPSAServiceBased(sum_SrvcMgr_ConfigSet)-»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«SrvcMgr_GetImplementationDataTypePath(sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_PropSysActv_Ref)»</TYPE-TREF>
«ELSE -»
«IF sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_PropSysActv_Ref.metaType.toString().contains("ComSignal")-»
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_PropSysActv_Ref.comSignalType.toLowerCase()»</TYPE-TREF>
«ELSE -»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SrvcMgr/PortInterfaces/RxSignal_PropSysActv_GroupSignal</TYPE-TREF>
«ENDIF-»
«ENDIF-»
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>YeVSPR_v_DrvnVehicle</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>YeVSPR_v_DrvnVehicleRxSignal</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
«IF SrvcMgr_IsVehSpdAvgDrvnServiceBased(sum_SrvcMgr_ConfigSet)-»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«SrvcMgr_GetImplementationDataTypePath(sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_VehSpdAvgDrvn_Ref)»</TYPE-TREF>
«ELSE -»                  
«IF sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_VehSpdAvgDrvn_Ref.metaType.toString().contains("ComSignal")-»
                    <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_VehSpdAvgDrvn_Ref.comSignalType.toLowerCase()»</TYPE-TREF>
«ELSE -»
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SrvcMgr/PortInterfaces/RxSignal_VehSpdAvgDrvn_GroupSignal</TYPE-TREF>
«ENDIF-»
«ENDIF-»
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
«ELSE -»
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>VeActvProp_YeDrvnVeh</SHORT-NAME>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>VeActvProp_YeDrvnVeh_RxSignal</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <SW-CALIBRATION-ACCESS>READ-ONLY</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
«IF !SrvcMgr_IsPropSysActvGroupSignal(sum_SrvcMgr_ConfigSet)-»
			                <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">«SrvcMgr_GetImplementationDataTypePath(sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_ServiceBased_PropSysActv_Ref)»</TYPE-TREF>
«ELSE -»                  
			              <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SrvcMgr/PortInterfaces/RxSignal_VeActvProp_YeDrvnVeh_GroupSignal</TYPE-TREF>
«ENDIF-»                            
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
«ENDIF-»
«IF !SrvcMgr_IsSameSignalReference(sum_SrvcMgr_ConfigSet)-»  
«REM»Generate PropSysActv signal types for signal-based (non-service-based) ComGroupSignal configuration«ENDREM-»
«IF SrvcMgr_IsPropSysActvGroupSignal(sum_SrvcMgr_ConfigSet) && !SrvcMgr_IsPSAServiceBased(sum_SrvcMgr_ConfigSet)-»
  		<IMPLEMENTATION-DATA-TYPE>
	        <SHORT-NAME>RxSignal_PropSysActv_GroupSignal</SHORT-NAME>
	        <LONG-NAME>
	            <L-4 L="EN">PropSysActvRxSignal</L-4>
	        </LONG-NAME>
	        <CATEGORY>STRUCTURE</CATEGORY>
	        <SUB-ELEMENTS>
«FOREACH sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_PropSysActv_Ref.parent.comGroupSignal AS single_signal-»
	         <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	            <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
	            <CATEGORY>TYPE_REFERENCE</CATEGORY>
	            <SW-DATA-DEF-PROPS>
	                <SW-DATA-DEF-PROPS-VARIANTS>
	                    <SW-DATA-DEF-PROPS-CONDITIONAL>
	        «IF single_signal.comSignalType == "UINT8_N"-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SrvcMgr/PortInterfaces/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ELSE-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ENDIF-»
	                    </SW-DATA-DEF-PROPS-CONDITIONAL>
	                 </SW-DATA-DEF-PROPS-VARIANTS>
	            </SW-DATA-DEF-PROPS>
              </IMPLEMENTATION-DATA-TYPE-ELEMENT>
«ENDFOREACH-»
			</SUB-ELEMENTS>
         </IMPLEMENTATION-DATA-TYPE>
«ENDIF-»
«REM»Generate VehSpdAvgDrvn signal types for signal-based (non-service-based) ComGroupSignal configuration«ENDREM-»
«IF SrvcMgr_IsVehSpdAvgDrvnGroupSignal(sum_SrvcMgr_ConfigSet) && !SrvcMgr_IsVehSpdAvgDrvnServiceBased(sum_SrvcMgr_ConfigSet)-»
  		<IMPLEMENTATION-DATA-TYPE>
	        <SHORT-NAME>RxSignal_VehSpdAvgDrvn_GroupSignal</SHORT-NAME>
	        <LONG-NAME>
	            <L-4 L="EN">DrvnVehicleRxSignal</L-4>
	        </LONG-NAME>
	        <CATEGORY>STRUCTURE</CATEGORY>
	        <SUB-ELEMENTS>
«FOREACH sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_VehSpdAvgDrvn_Ref.parent.comGroupSignal AS single_signal-»
	         <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	            <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
	            <CATEGORY>TYPE_REFERENCE</CATEGORY>
	            <SW-DATA-DEF-PROPS>
	                <SW-DATA-DEF-PROPS-VARIANTS>
	                    <SW-DATA-DEF-PROPS-CONDITIONAL>
	        «IF single_signal.comSignalType == "UINT8_N"-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SrvcMgr/PortInterfaces/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ELSE-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ENDIF-»
	                    </SW-DATA-DEF-PROPS-CONDITIONAL>
	                 </SW-DATA-DEF-PROPS-VARIANTS>
	            </SW-DATA-DEF-PROPS>
              </IMPLEMENTATION-DATA-TYPE-ELEMENT>
«ENDFOREACH-»
			</SUB-ELEMENTS>
         </IMPLEMENTATION-DATA-TYPE>

«ENDIF-»

«ELSE-»
«IF SrvcMgr_IsPropSysActvGroupSignal(sum_SrvcMgr_ConfigSet)-»
«REM»Generate combined signal types when both signals reference the same group signal«ENDREM-»
  		<IMPLEMENTATION-DATA-TYPE>
	        <SHORT-NAME>RxSignal_VeActvProp_YeDrvnVeh_GroupSignal</SHORT-NAME>
	        <LONG-NAME>
	            <L-4 L="EN">VeActvProp_YeDrvnVeh_RxSignal</L-4>
	        </LONG-NAME>
	        <CATEGORY>STRUCTURE</CATEGORY>
	        <SUB-ELEMENTS>
«FOREACH sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Sig_PropSysActv_Ref.parent.comGroupSignal AS single_signal-»

	         <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	            <SHORT-NAME>RxSignal_«single_signal.shortName»</SHORT-NAME>
	            <CATEGORY>TYPE_REFERENCE</CATEGORY>
	            <SW-DATA-DEF-PROPS>
	                <SW-DATA-DEF-PROPS-VARIANTS>
	                    <SW-DATA-DEF-PROPS-CONDITIONAL>
	        «IF single_signal.comSignalType == "UINT8_N"-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/SUM_SrvcMgr/PortInterfaces/IMPL_LenNByte«single_signal.comSignalLength»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ELSE-»
	                    <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/«single_signal.comSignalType.toLowerCase()»</IMPLEMENTATION-DATA-TYPE-REF>
	        «ENDIF-»
	                    </SW-DATA-DEF-PROPS-CONDITIONAL>
	                 </SW-DATA-DEF-PROPS-VARIANTS>
	            </SW-DATA-DEF-PROPS>
              </IMPLEMENTATION-DATA-TYPE-ELEMENT>
            
«ENDFOREACH-»
            </SUB-ELEMENTS>
      </IMPLEMENTATION-DATA-TYPE>
«ENDIF-»
«ENDIF-»
«REM»Generate unified UINT8_N implementation data types for all signals (PSA and VehSpeed)«ENDREM-»
«FOREACH SrvcMgr_CollectAllUint8NLengths(sum_SrvcMgr_ConfigSet) AS sigSize-»
		<IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>IMPL_LenNByte«sigSize»</SHORT-NAME>
              <CATEGORY>VALUE</CATEGORY>
              <SW-DATA-DEF-PROPS>
                <SW-DATA-DEF-PROPS-VARIANTS>
                  <SW-DATA-DEF-PROPS-CONDITIONAL>
                    <BASE-TYPE-REF DEST="SW-BASE-TYPE">/SUM_SrvcMgr/PortInterfaces/Bytes«sigSize»</BASE-TYPE-REF>
                  </SW-DATA-DEF-PROPS-CONDITIONAL>
                </SW-DATA-DEF-PROPS-VARIANTS>
              </SW-DATA-DEF-PROPS>
         </IMPLEMENTATION-DATA-TYPE>

           <SW-BASE-TYPE>
              <SHORT-NAME>Bytes«sigSize»</SHORT-NAME>
              <CATEGORY>FIXED_LENGTH</CATEGORY>
              <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
              <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
              <MEM-ALIGNMENT>8</MEM-ALIGNMENT>
              <NATIVE-DECLARATION>Bytes_«sigSize»</NATIVE-DECLARATION>
           </SW-BASE-TYPE>

           <IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>Bytes_«sigSize»</SHORT-NAME>
              <CATEGORY>STRUCTURE</CATEGORY>
              <SUB-ELEMENTS>
              	<IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>Array_«sigSize»</SHORT-NAME>
                  <CATEGORY>ARRAY</CATEGORY>
                  <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                  <SUB-ELEMENTS>
	                <IMPLEMENTATION-DATA-TYPE-ELEMENT>
	                  <SHORT-NAME>ArrayElement</SHORT-NAME>
	                  <CATEGORY>TYPE_REFERENCE</CATEGORY>
	                  <ARRAY-SIZE>«sigSize»</ARRAY-SIZE>
	                  <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
	                  <SW-DATA-DEF-PROPS>
	                    <SW-DATA-DEF-PROPS-VARIANTS>
	                      <SW-DATA-DEF-PROPS-CONDITIONAL>
	                        <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</IMPLEMENTATION-DATA-TYPE-REF>
	                      </SW-DATA-DEF-PROPS-CONDITIONAL>
	                    </SW-DATA-DEF-PROPS-VARIANTS>
	                  </SW-DATA-DEF-PROPS>
	       			</IMPLEMENTATION-DATA-TYPE-ELEMENT>
	       		   </SUB-ELEMENTS>
	       		 </IMPLEMENTATION-DATA-TYPE-ELEMENT>
	       	   </SUB-ELEMENTS>
	       	</IMPLEMENTATION-DATA-TYPE>
«ENDFOREACH-»
          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
«ENDFILE»
«ENDDEFINE»
