                  <SHORT-NAME>RP_SSFM_SrvcMgr_FsFA_VSAD_PSA</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SignalGroup_FsFA</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
