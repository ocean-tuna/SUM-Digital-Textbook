                </P-PORT-PROTOTYPE>
«IF Susd_Ssfm_IsSinglePortSupported(sum_SrvcMgr_ConfigSet.eRootContainer.sSFM)-»
«IF SrvcMgr_IsSameSignalReference(sum_SrvcMgr_ConfigSet)-»
                <!-- FxFA (single-port mode, same signal/service): one port for VSAD+PSA (IDOC-1092) -->
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSFM_SrvcMgr_FxFA_VSAD_PSA</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SignalGroup_FxFA</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
«ELSE-»
                <!-- FxFA (single-port mode, different signals): separate ports for VSAD and PSA (IDOC-1092) -->
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSFM_SrvcMgr_FxFA_VSAD</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SignalGroup_FxFA</REQUIRED-INTERFACE-TREF>
