                    </SERVER-COM-SPEC>
                  </PROVIDED-COM-SPECS>
                  <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«GetFirstDidE0CCDataRef(sum_SrvcMgr_ConfigSet)»</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
«IF sum_SrvcMgr_ConfigSet.sum_SrvcMgr_DcmReferences.sum_SrvcMgr_Rid_0612_Ref != null -»
