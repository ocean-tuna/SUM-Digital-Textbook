«ENDIF-»                                
                <R-PORT-PROTOTYPE> 
                  <SHORT-NAME>RP_SPM_SrvcMgr_GetDTCIdentifier</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SPM_GetDTCIdentifier</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>RP_SSFM_SrvcMgr_SDMissingMessage</SHORT-NAME>
