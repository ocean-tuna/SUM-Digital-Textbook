@startuml Srvcmgr_FlowDiagram_DisableServiceGroup
start
    if (There is at least one Service Group configured?) then (yes)
        if (Service_Group_ID match with one configured in the Sd?) then (yes)
            if(The Service Group has at least one service associated?) then (yes)
                :Sd_ServiceGroupStop(Service_Group_ID);
                if(Sd_CalibrateServicesOff(List_OfServiceAssociated, Number_OfServiceAssociated) == E_OK?) then(yes)
                    #palegreen: return E_OK;
                else (no)
                    #pink:return E_NOT_OK;
                endif
            else (no)
                #pink:return E_NOT_OK;
            endif
        else (no)
        #pink:return E_NOT_OK;
        endif
    else (no)
    #pink:return E_NOT_OK;
    endif
@enduml