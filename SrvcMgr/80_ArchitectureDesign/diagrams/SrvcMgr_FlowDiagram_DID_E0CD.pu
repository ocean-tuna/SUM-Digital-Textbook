@startuml Srvcmgr_LearningSession_DID_E0CD
start
group SrvcMgr_DID_E0CD_ConditionCheckRead
    :Sd_GetLearningTableState(&LearningState);
    if (LearningState == LEARNING_INCOMPLETE) then (yes)
        :ret = Sd_RetrieveIncompleteLearningReasons(&IncompleteLrng);
        if (ret == E_OK and IncompleteLrng.Num_Of_Missing_Services <= 400) then (yes)          
            #palegreen:E_OK;    
        else (no)
            #pink:E_NOK;
        endif         
    else (no)
        if (LearningState == LEARNING_COMPLETED) then (yes)
            #palegreen:E_OK;
        else (no)
            #pink:E_NOK;
        endif;
    endif        
end group
stop 

start
group SrvcMgr_DID_E0CD_ReadDataLength
    :ret = Sd_RetrieveIncompleteLearningReasons(&IncompleteLrng);
    if (ret == E_OK) then (yes)
        if (IncompleteLrng.Num_Of_Missing_Services <= 400) then (yes)
            : *DataLength = LengthOfDidData;
            note left
             Data related to
             client section
            end note
            #palegreen:E_OK;    
        else (no)
            #pink:E_NOK;
        endif
    else (no)
        #pink:E_NOK;
    endif
end group
stop

start
group SrvcMgr_DID_E0CD_ReadData
    :ret = Sd_RetrieveIncompleteLearningReasons(&IncompleteLrng);
    if (ret == E_OK) then (yes)
        if (IncompleteLrng.Num_Of_Missing_Services <= 400) then (yes)
            : *Data = IncompleteLrng and sd missing from ssfm; (first 400 services);
            note left
             Data related to
             client section
            end note
            #palegreen:E_OK;    
        else (no)
            #pink:E_NOK;
        endif
    else (no)
        #pink:E_NOK;
    endif
end group
stop
@enduml
