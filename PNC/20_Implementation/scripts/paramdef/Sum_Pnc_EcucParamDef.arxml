						</ECUC-ENUMERATION-PARAM-DEF>
                          <!-- [$Satisfies $SDD_PNC 102] -->
                          <ECUC-FLOAT-PARAM-DEF>
	                          <SHORT-NAME>PNC_t_RemoteSignals_Periodicity</SHORT-NAME>
	                          <DESC>
	                           <L-2 L="EN">Specifies Time in msec, for the periodicity of polling for changes to Activation Signals</L-2>
	                          </DESC>
	                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
	                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
	                          <SCOPE>LOCAL</SCOPE>
