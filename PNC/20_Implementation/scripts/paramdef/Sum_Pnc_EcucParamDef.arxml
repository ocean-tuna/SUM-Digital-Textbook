	                          <DEFAULT-VALUE>12.50</DEFAULT-VALUE>
	                          <MAX>100.00</MAX>
	                          <MIN>1.00</MIN>
                          </ECUC-FLOAT-PARAM-DEF>
                          <!-- [$Satisfies $SDD_PNC 101] [$Satisfies $SDD_PNC 102]-->
                          <ECUC-FLOAT-PARAM-DEF>
                          <SHORT-NAME>PNC_t_MainFunction_Periodicity</SHORT-NAME>
                          <DESC>
                           <L-2 L="EN">Specifies Time in msec, for the periodicity of polling for changes to PNC state changes. Float values are supported</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <IMPLEMENTATION-CONFIG-CLASSES>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>12.50</DEFAULT-VALUE>
                          <MAX>100.00</MAX>
                          <MIN>1.00</MIN>
                          </ECUC-FLOAT-PARAM-DEF>
                          <!-- [$Satisfies $SDD_PNC 102] -->
                          <ECUC-FLOAT-PARAM-DEF>
                          	<SHORT-NAME>PNC_t_PNsPNsStatusMonitoring_Periodicity</SHORT-NAME>
                          	<DESC>
                          		<L-2 L="EN">Time in msec, for the periodicity of monitoring for changes to the PN status</L-2>
                          	</DESC>
                          	<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          	<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          	<SCOPE>LOCAL</SCOPE>
                          	<IMPLEMENTATION-CONFIG-CLASSES>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>12.5</DEFAULT-VALUE>
                          <MAX>100.00</MAX>
                          <MIN>1.00</MIN>
                          </ECUC-FLOAT-PARAM-DEF>

                          <ECUC-FLOAT-PARAM-DEF>
                          	<SHORT-NAME>Shutdown_permission_SUSD_Periodicity</SHORT-NAME>
                          	<DESC>
                          		<L-2 L="EN">Time in msec, for the periodicity of "Shutdown_permission_SUSD" runnable.</L-2>
                          	</DESC>
                          	<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          	<UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          	<SCOPE>LOCAL</SCOPE>
                          	<IMPLEMENTATION-CONFIG-CLASSES>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>10.0</DEFAULT-VALUE>
                          <MAX>100.00</MAX>
                          <MIN>1.00</MIN>
                          </ECUC-FLOAT-PARAM-DEF>

                          <ECUC-INTEGER-PARAM-DEF>
                          <SHORT-NAME>PNC_t_Activation_Req_Timer</SHORT-NAME>
                          <DESC>
                              <L-2 L="EN">Time in msec, to verify PN Activation after mode request (for retry purpose)</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <IMPLEMENTATION-CONFIG-CLASSES>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>10</DEFAULT-VALUE>
                          <MAX>100</MAX>
                          <MIN>1</MIN>
                          </ECUC-INTEGER-PARAM-DEF>
                          <ECUC-INTEGER-PARAM-DEF>
                          <SHORT-NAME>PNC_PermitExecution_Mask</SHORT-NAME>
                          <DESC>
                              <L-2 L="EN">Mask that can be OR'd with the value supplied by PermitExecution to set any "don't care" bits to '1'.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <IMPLEMENTATION-CONFIG-CLASSES>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>190</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                          </ECUC-INTEGER-PARAM-DEF>

                          <ECUC-INTEGER-PARAM-DEF>
                          <SHORT-NAME>Number_of_Retries</SHORT-NAME>
                          <DESC>
                              <L-2 L="EN">Number_of_Retries.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <IMPLEMENTATION-CONFIG-CLASSES>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>1</DEFAULT-VALUE>
                          <MAX>50</MAX>
                          <MIN>0</MIN>
                          </ECUC-INTEGER-PARAM-DEF>
<!-- [$Satisfies $SDD_PNC 079] -->
                          <ECUC-INTEGER-PARAM-DEF>
                          <SHORT-NAME>SUM_PN_Coordinator_Node_ID</SHORT-NAME>
                          <DESC>
                              <L-2 L="EN">ECU ID (part of NM PDU) associated with CGM that is used for deadline monitoring control (used with SUM_PN_n_DM_Timer). Value in DECIMAL.</L-2>
                          </DESC>
                          <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                          <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                          <SCOPE>LOCAL</SCOPE>
                          <IMPLEMENTATION-CONFIG-CLASSES>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                              <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                                  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                                  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                              </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                          </IMPLEMENTATION-CONFIG-CLASSES>
                          <ORIGIN>AUTOSAR_ECUC</ORIGIN>
                          <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                          <DEFAULT-VALUE>69</DEFAULT-VALUE>
                          <MAX>255</MAX>
                          <MIN>0</MIN>
                          </ECUC-INTEGER-PARAM-DEF>

                    <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>AR_GMSUM_4_2_X_SUPPORT</SHORT-NAME>
                    <LONG-NAME>
                      <L-4 L="EN">AR_GMSUM_4_2_X_SUPPORT</L-4>
                    </LONG-NAME>
                    <DESC>
                      <L-2 L="EN">This parameter is used to distinguish between the AR ComM V4.0.3 and V4.1.1and above. If AR ComM V4.0.3 is used, ComMPncId will be configured in range of 0-47, for V4.1.1 and above, range is 8-63 </L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <ORIGIN>RB:0.1.0:2015-12-05</ORIGIN>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>1</DEFAULT-VALUE>
                  </ECUC-BOOLEAN-PARAM-DEF>

                  <ECUC-BOOLEAN-PARAM-DEF>
                    <SHORT-NAME>PncGenerateInitRunnable</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">It allows the generation of a periodic runnable that calls the initialization function SUM_PNC_Init only the first time it is invoked</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>false</DEFAULT-VALUE>
                  </ECUC-BOOLEAN-PARAM-DEF>

                  <ECUC-FLOAT-PARAM-DEF>
                    <SHORT-NAME>PncInitFuncPeriodicity</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN">It is used to specify the periodicity, in milliseconds, of the initialization runnable entity Runnable_Pnc_Init</L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <DEFAULT-VALUE>1000.0</DEFAULT-VALUE>
                    <MAX>5000.0</MAX>
                    <MIN>1.0</MIN>
                  </ECUC-FLOAT-PARAM-DEF>

                  <!-- Satisfies [$SDD_PNC 103] -->
					<ECUC-BOOLEAN-PARAM-DEF>
					  <SHORT-NAME>ComMPncIdLongRangeSupport</SHORT-NAME>
					  <DESC>
						<L-2>This parameter is used to distinguish the range values that can be assigned to ComMPncId. If it is true the first comMPncId starts from 0, otherwise it starts from 16 </L-2>
					  </DESC>
					  <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
					  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
					  <IMPLEMENTATION-CONFIG-CLASSES>
						<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
						  <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
						  <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
						</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
						<ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
						  <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
						  <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
						</ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
					  </IMPLEMENTATION-CONFIG-CLASSES>
					  <DEFAULT-VALUE>true</DEFAULT-VALUE>
					</ECUC-BOOLEAN-PARAM-DEF>

                </PARAMETERS>
                  <REFERENCES>
                    <ECUC-REFERENCE-DEF>
                      <SHORT-NAME>SSFMConfigSet_Ref</SHORT-NAME>
                      <LONG-NAME>
                        <L-4 L="EN">SSFMConfigSet_Ref</L-4>
                      </LONG-NAME>
                      <DESC>
                        <L-2 L="EN">Reference to the SSFMConfigSet container of the SSFM.</L-2>
                      </DESC>
                      <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
