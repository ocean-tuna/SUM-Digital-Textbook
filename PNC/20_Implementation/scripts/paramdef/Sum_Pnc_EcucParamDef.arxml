                      <MIN>0</MIN>
                    </ECUC-INTEGER-PARAM-DEF>
					<ECUC-ENUMERATION-PARAM-DEF>
                    <SHORT-NAME>PartialNetworkName</SHORT-NAME>
                    <DESC>
                      <L-2 L="EN"> Name of the Partial Network. Among the possible choices:
                      	0x21= All Nodes,
						0x22= Wireless Charging,
						0x23= Short Duration Event,
						0x24= Diagnose Mechatronics.
						0x25=SDV2 Any Diagnose CAN PN
					 </L-2>
                    </DESC>
                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                    <IMPLEMENTATION-CONFIG-CLASSES>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>PRE-COMPILE</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-PRE-COMPILE</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                      <ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                        <CONFIG-CLASS>POST-BUILD</CONFIG-CLASS>
                        <CONFIG-VARIANT>VARIANT-POST-BUILD</CONFIG-VARIANT>
                      </ECUC-IMPLEMENTATION-CONFIGURATION-CLASS>
                    </IMPLEMENTATION-CONFIG-CLASSES>
                    <SYMBOLIC-NAME-VALUE>false</SYMBOLIC-NAME-VALUE>
                    <LITERALS>
                      <ECUC-ENUMERATION-LITERAL-DEF>
                        <SHORT-NAME>All Nodes</SHORT-NAME>
                      </ECUC-ENUMERATION-LITERAL-DEF>
                      <ECUC-ENUMERATION-LITERAL-DEF>
                        <SHORT-NAME>Wireless Charging</SHORT-NAME>
                      </ECUC-ENUMERATION-LITERAL-DEF>
                      <ECUC-ENUMERATION-LITERAL-DEF>
                        <SHORT-NAME>Short Duration Event</SHORT-NAME>
                      </ECUC-ENUMERATION-LITERAL-DEF>
                      <ECUC-ENUMERATION-LITERAL-DEF>
                        <SHORT-NAME>Diagnose Mechatronics Ethernet</SHORT-NAME>
                      </ECUC-ENUMERATION-LITERAL-DEF>
                      <ECUC-ENUMERATION-LITERAL-DEF>
                        <SHORT-NAME>Any Diagnose CAN PN</SHORT-NAME>
                      </ECUC-ENUMERATION-LITERAL-DEF>
                    </LITERALS>
                	</ECUC-ENUMERATION-PARAM-DEF>
