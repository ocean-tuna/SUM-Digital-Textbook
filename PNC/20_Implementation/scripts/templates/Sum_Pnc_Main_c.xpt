/*******************************************************************************
 * Function name    : Get_DIAG_DisableNormalCommunicationMode
 * Description      : Returns Enable/Disable normal Communcaion mode from DIAG
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 [$Satisfies $SDD_PNC 003] [$Satisfies $SDD_PNC 022] [$Satisfies $SDD_PNC 115]
 [$Satisfies $SDD_PNC 116]
 ******************************************************************************/
static FUNC(boolean, PNC_CODE)Get_DIAG_DisableNormalCommunicationMode(void)
{
  static uint8 SUM_PNC_DisableNormalComm;
  uint8 Loc_Index;
  /* update channel status as 0x00 Normal Communications Mode Enabled */
  boolean Ret_Val_NormalMode = FALSE;

  for(Loc_Index = 0; Loc_Index < NUMBER_OF_PNC_TOTAL_CHANNELS; Loc_Index++)
  {
	(void)PNC_GaaSUM_PNC_DisableNormalComm_Interface[Loc_Index](&SUM_PNC_DisableNormalComm);
	if(SUM_PNC_DisableNormalComm == SUM_DiagNormalCom_Disable)
	{
	/* update channel status as 0x01 Normal Communications Mode Disabled, if ANY of the channels is disabled */
		Ret_Val_NormalMode = TRUE;
	}
  }

  return Ret_Val_NormalMode;
}
