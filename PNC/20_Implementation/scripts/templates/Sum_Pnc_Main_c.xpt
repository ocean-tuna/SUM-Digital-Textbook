#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : PNC_Ack_Activation
 * Description      : Function to
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 [$Satisfies $SDD_PNC 025]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Status_PNC_Ack_Activation(void)
{
   /*Criteria_Struct to store result */
   boolean Loc_Activation_criteria;
   boolean ARxPDUEnable;

   /*Activation criteria for sensor signals for current partial network is fetched by calling Activation_Sensor API*/
    Activation_Sensor();


    if((SUM_PNC_Criteria_Sensor_Act[SUM_PNC_PNC_Number] == TRUE) ||
       (SUM_PNC_Criteria_Signal_Act[SUM_PNC_PNC_Number] == TRUE))
	{
		Loc_Activation_criteria = TRUE;
	}
	else
	{
		Loc_Activation_criteria = FALSE;
	}
    /* [$Satisfies $SDD_PNC 029] */
    if((SUM_COMM_FULL_COMMUNICATION == PNC_ComM_Current_ModeUSer()) &&
       ((  PNC_BswM_ComM_Current_PNC_ModeUSer() != SUM_PNC_NO_COMMUNICATION )) &&
       ((  PNC_BswM_ComM_Current_PNC_ModeUSer() != SUM_PNC_PREPARE_SLEEP )) &&
       (Loc_Activation_criteria == TRUE))
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State = SUM_PDUGRP_START;
        SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup = START;

        (void)PNC_BswM_ComM_Pdugroupswitch_RxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State);
        Set_Alarm(PNC_ALARM_ACTIVE,SUM_PNC_PNC_Number);
        ARxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsRxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup);
        (void)PNC_Active_RxPDU_Enable(ARxPDUEnable);

        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_TX_ENABLE;
	    /* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
    else if(((PNC_BswM_ComM_Current_PNC_ModeUSer() == SUM_PNC_NO_COMMUNICATION)||(PNC_BswM_ComM_Current_PNC_ModeUSer() == SUM_PNC_PREPARE_SLEEP) ) && ( SUM_GaaPNC[SUM_PNC_PNC_Number].Flag_Counter_PNC_t_Activation_Req_Timer == PNC_TIMER_EXPIRED))
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Flag_Counter_PNC_t_Activation_Req_Timer = PNC_TIMER_INVALID;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_MONITOR_ACTIVATION;
    }
    /* [$Satisfies $SDD_PNC 029] */
    else if((Loc_Activation_criteria == FALSE) &&
            (PNC_BswM_Current_PNC_Mode_Req(SUM_PNC_NO_COMMUNICATION) == E_OK))
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State = SUM_PNC_NO_COMMUNICATION;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_ENABLE_CHECK;
    }
    else
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_ACK_ACTIVATION;
		/* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : Status_PNC_Tx_Enable
 * Description      : Function to
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 [$Satisfies $SDD_PNC 026]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Status_PNC_Tx_Enable(void)
{
    boolean ATxPDUEnable;
	/* [$Satisfies $SDD_PNC 029] */
    if(SUM_GaaPNC[SUM_PNC_PNC_Number].Flag_Counter_Sum_Active == PNC_TIMER_EXPIRED)
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Flag_Counter_Sum_Active = PNC_TIMER_INVALID;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State = SUM_PDUGRP_START;
        SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup = START;
        Set_Alarm(PNC_REPEAT_MESSAGE_TIME , SUM_PNC_PNC_Number);

        (void)PNC_BswM_ComM_Pdugroupswitch_TxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State);
        ATxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsTxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup);
        (void)PNC_Active_TxPDU_Enable(ATxPDUEnable);

        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_LOCALLY_ACTIVE;

«IF isUsingUDP(pNC.pNCConfigSet) == false -»
		PNC_Update_Local_DID_Bit();
«ENDIF -»
		/* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = 0;

«IF IsPDUDisableFeatureEnabled(pNC)-»
        /* Since PNC_BswM_ComM_Pdugroupswitch_TxReq(SUM_PDUGRP_START) has been called, disable those PDUs of the group that are calibrated as disabled */
        	 /* Those PDUs are known thanks to R-ports SUM_C_Disable_Tx */
        PNC_BswM_DisableSinglePDU_TxReq();
«ENDIF-»
    }
    /* [$Satisfies $SDD_PNC 030] [$Satisfies $SDD_PNC 052] */
    else if(SUM_GaaPNC[SUM_PNC_PNC_Number].Flag_Counter_Sum_Passive == PNC_TIMER_EXPIRED)
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Flag_Counter_Sum_Passive = PNC_TIMER_INVALID;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State = SUM_PDUGRP_START;
        SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup = START;

        (void)PNC_BswM_ComM_Pdugroupswitch_TxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State);
        ATxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsTxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup);
        (void)PNC_Active_TxPDU_Enable(ATxPDUEnable);

        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_REMOTELY_ACTIVE;
«IF isUsingUDP(pNC.pNCConfigSet) == false -»
		PNC_Update_Remote_DID_Bit();
«ENDIF -»
		/* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;

«IF IsPDUDisableFeatureEnabled(pNC)-»
        /* Since PNC_BswM_ComM_Pdugroupswitch_TxReq(SUM_PDUGRP_START) has been called, disable those PDUs of the group that are calibrated as disabled */
        	 /* Those PDUs are known thanks to R-ports SUM_C_Disable_Tx */
        PNC_BswM_DisableSinglePDU_TxReq();
«ENDIF-»
    }
    else
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_TX_ENABLE;
	    /* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

«IF IsPDUDisableFeatureEnabled(pNC)-»
#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : PNC_BswM_DisableSinglePDU_TxReq
 * Description      : Function to...
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 * [$Satisfies $SDD_PNC 117] [$Satisfies $SDD_PNC 118] [$Satisfies $SDD_PNC 119]
 ******************************************************************************/
static FUNC(void, PNC_CODE) PNC_BswM_DisableSinglePDU_TxReq(void)
{
	uint8 i;
    boolean pduDisabled = TRUE;
    Std_ReturnType rteStatus;

	/* Disable PDUs according to the infos from SSFM */
	for (i=0u; i < PNC_SSFM_NO_OF_DISABLEPDUS; i++)
	{
		/* Read the status of the PDU from the SSFM */
		rteStatus = Pnc_TxMessagePdu_Configuration[i].Pnc_RteReadSumCDisable_MessagePdu_fp(&pduDisabled);

		/* If read ok and PDU disabled, invoke BswM to disable the PDU */
		if((rteStatus==RTE_E_OK) && (pduDisabled))
		{
			/* Invoke BswM to disable PDUs */
			(void) Pnc_TxMessagePdu_Configuration[i].FP_Rte_Switch_SUM_BswM_DisablePdu(RTE_MODE_MDG_DisablePdu_PDU_DISABLE_REQ);
		}
	}
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"
«ENDIF-»

