/*******************************************************************************
 * Function name    : PNC_Enable_Check
 * Description      : Function to
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 [$Satisfies $SDD_PNC 023] [$Satisfies $SDD_PNC 051]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Status_PNC_Enable_Check(void)
{

	/*Criteria_Struct to store result */
	boolean Loc_Activation_criteria;
    boolean Remote_Activation_criteria;
    /*Flag to store if mode request is in progress for NO_COMMUNICATION */
    boolean Waiting_Loc_No_Comm;
	/*Current PNC Mode User*/
    uint8 Loc_PNC_ComM_Current_PNC_ModeUSer;
    boolean ARxPDUEnable;

	 /*Activation criteria for sensor signals for current partial network is fetched by calling Activation_Sensor API*/
	  Activation_Sensor();
	 /* PRQA S 4558 EOF */

	if((SUM_PNC_Criteria_Sensor_Act[SUM_PNC_PNC_Number] == TRUE) ||
       (SUM_PNC_Criteria_Signal_Act[SUM_PNC_PNC_Number] == TRUE))
    {
	   Loc_Activation_criteria = TRUE;
	   Remote_Activation_criteria = FALSE;
    }
	else if(SUM_PNC_Criteria_NM_Act_Remote[SUM_PNC_PNC_Number] == TRUE)
	{
	  Loc_Activation_criteria = FALSE;
	  Remote_Activation_criteria = TRUE;
	}
	else
	{
	  Loc_Activation_criteria = FALSE;
      Remote_Activation_criteria = FALSE;
	}

	Loc_PNC_ComM_Current_PNC_ModeUSer = PNC_BswM_ComM_Current_PNC_ModeUSer();

    /* Checking if Mode request is in progress for NO_COMMUNICATION. */
    /* [$Satisfies $SDD_PNC 029] */
	if(SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State == SUM_PNC_NO_COMMUNICATION)
    {
        if((Loc_PNC_ComM_Current_PNC_ModeUSer == SUM_PNC_NO_COMMUNICATION) ||
           (Remote_Activation_criteria == TRUE))
        {
            /* Reset the requested state in order to remove the block for transition
               to PNC_TX_ENABLE to remotely activate the PN */
            SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State = SUM_PNC_INVALID;
            Waiting_Loc_No_Comm = FALSE;
        }
        else
        {
            Waiting_Loc_No_Comm = TRUE;
        }
    }
    else
    {
        Waiting_Loc_No_Comm = FALSE;
    }



	/* PRQA S 3415 EOF */
	/* [$Satisfies $SDD_PNC 030] [$Satisfies $SDD_PNC 052] */
    if((Loc_Activation_criteria == FALSE) &&
       (Waiting_Loc_No_Comm == FALSE) &&
       ((Loc_PNC_ComM_Current_PNC_ModeUSer != SUM_PNC_NO_COMMUNICATION) &&
        (Loc_PNC_ComM_Current_PNC_ModeUSer != SUM_PNC_PREPARE_SLEEP)) &&
       (Get_DIAG_DisableNormalCommunicationMode()== FALSE))
    {
      SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_TX_ENABLE;

	  SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State = SUM_PDUGRP_START;
	  SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup = START;

	  (void)PNC_BswM_ComM_Pdugroupswitch_RxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State);
      ARxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsRxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup);
	  (void)PNC_Active_RxPDU_Enable(ARxPDUEnable);
	  Set_Alarm(PNC_ALARM_PASSIVE , SUM_PNC_PNC_Number);
	  /* Clear the Shut down permission */
	  SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
    /* [$Satisfies $SDD_PNC 029] [$Satisfies $SDD_PNC 054] */
    else if((Loc_Activation_criteria == TRUE) &&
            (PNC_BswM_Current_PNC_Mode_Req(SUM_PNC_REQUESTED) == E_OK))
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State = SUM_PNC_REQUESTED;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_MONITOR_ACTIVATION;
        /* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
   }
   else
   {
       SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_ENABLE_CHECK;
   }
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : PNC_Monitor_Activation
 * Description      : Function to
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 [$Satisfies $SDD_PNC 024]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Status_PNC_Monitor_Activation(void)
{
	/*Criteria_Struct to store result */
	boolean Loc_Activation_criteria;

/*Activation criteria for sensor signals for current partial network is fetched by calling Activation_Sensor API*/
    Activation_Sensor();

    if((SUM_PNC_Criteria_Sensor_Act[SUM_PNC_PNC_Number] == TRUE) ||
       (SUM_PNC_Criteria_Signal_Act[SUM_PNC_PNC_Number] == TRUE))
	{
		Loc_Activation_criteria = TRUE;
	}
	else
	{
		Loc_Activation_criteria = FALSE;
	}

    /* [$Satisfies $SDD_PNC 029] */
    if((Loc_Activation_criteria == FALSE) &&
       (PNC_BswM_Current_PNC_Mode_Req(SUM_PNC_NO_COMMUNICATION) == E_OK))
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State = SUM_PNC_NO_COMMUNICATION;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_ENABLE_CHECK;
    }
    /* [$Satisfies $SDD_PNC 029] */
    else if(PNC_BswM_Current_PNC_Mode_Req(SUM_PNC_REQUESTED) == E_OK)
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State = SUM_PNC_REQUESTED;
        Set_Alarm(PNC_ALARM_ACT_REQ,SUM_PNC_PNC_Number);
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_ACK_ACTIVATION;
		/* Clear the Shut down permission */
		SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
    else
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_MONITOR_ACTIVATION;
	    /* Clear the Shut down permission */
	    SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
}
