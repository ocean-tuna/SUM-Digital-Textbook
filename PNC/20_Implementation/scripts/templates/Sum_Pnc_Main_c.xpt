/*******************************************************************************
 * Function name    : Set_Alarm
 * Description      : Timer
 * Parameter in     : Alarm_Value,SUM_PNC_PNC_Number
 * Parameter out    : None
 * Return value     : void
 [$Satisfies $SDD_PNC 004] [$Satisfies $SDD_PNC 036]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Set_Alarm(VAR(uint8, AUTOMATIC) Alarm_Value, VAR(uint8, AUTOMATIC) PNC_Number)
{
    if (Alarm_Value == PNC_ALARM_ACTIVE)
    {
        SUM_GaaPNC[PNC_Number].Flag_Counter_Sum_Active = PNC_TIMER_INIT;
    }
    else if (Alarm_Value == PNC_ALARM_PASSIVE)
    {
        SUM_GaaPNC[PNC_Number].Flag_Counter_Sum_Passive = PNC_TIMER_INIT;
    }
    else if (Alarm_Value == PNC_ALARM_ACT_REQ)
    {
        SUM_GaaPNC[PNC_Number].Flag_Counter_PNC_t_Activation_Req_Timer = PNC_TIMER_INIT;
    }
    else if (Alarm_Value == PNC_REPEAT_MESSAGE_TIME)
    {
        SUM_GaaPNC[PNC_Number].Counter_Repeat_Msg_Time_Timer = (uint16)((SUM_PNC_Cfg[PNC_Number].Repeat_Message_Time) / PNC_T_PNsPNsSTATUSMONITORING_PERIODICITY);
    }
    else
    {
        /* error */
    }
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : Activation_Sensor
 * Description      : Updates the Activation_criteria i.e True/False
 * Parameter in     : None
 * Parameter out    : None
 * Return value     : void
 [$Satisfies $SDD_PNC 011]
 ******************************************************************************/
/* PRQA S 1505 EOF # Functions are public and can be used in external modules */
FUNC(void, PNC_CODE) Activation_Sensor(void)
{
    VAR(Criteria_Struct, AUTOMATIC) Activation_Criteria_out = {FALSE, FALSE};
    VAR(uint8, AUTOMATIC) Loc_Index;
    /* Activation criteria */
    VAR(boolean, AUTOMATIC) AtLeastOneActivated = FALSE;
    /* Temporary buffers for activation and deactivation */
    VAR(uint8, AUTOMATIC) TempActivationBuffer[SUM_PNC_MAX_SENSORS];
    VAR(uint8, AUTOMATIC) TempDeactivationBuffer[SUM_PNC_MAX_SENSORS];
    VAR(uint8, AUTOMATIC) TempActivationCount = 0U;
    VAR(uint8, AUTOMATIC) TempDeactivationCount = 0U;

    /* Process each sensor in the Partial Network */
    for (Loc_Index = 0U; Loc_Index < SUM_PNC_Cfg[SUM_PNC_PNC_Number].Number_of_PNC_Activation_Sensors; Loc_Index++)
    {
        /* Check if the sensor is successfully processed */
        if (PNC_GaaPNC_C_ProcessPN[Loc_Index]() == TRUE)
        {
            /* Fetch the activation and deactivation criteria for this sensor */
            SUM_PNC_Cfg[SUM_PNC_PNC_Number].ptr_PNC_GaaSUM_Activation_sensor_Rte_Call_Interface[Loc_Index](&Activation_Criteria_out);

            /* Activation Criteria */
            if (Activation_Criteria_out.ActCriteria_local == TRUE)
            {
                TempActivationBuffer[TempActivationCount] = Loc_Index;
                TempActivationCount++;
                AtLeastOneActivated = TRUE; /* At least one sensor is activated */
            }
            else
            {
                /* Sensor not active - mark for removal from history */
                TempDeactivationBuffer[TempDeactivationCount] = Loc_Index;
                TempDeactivationCount++;
            }
        }
    }

    SUM_PNC_Criteria_Sensor_Act[SUM_PNC_PNC_Number] = AtLeastOneActivated;

    /* Update the main buffer for activation */
    if (TempActivationCount > 0U)
    {
        SUM_PNC_Update_LocalActivation_History(TempActivationBuffer, TempActivationCount, SUM_PNC_PNC_Number);
    }

    /* Remove the sensors for deactivation */
    if (TempDeactivationCount > 0U)
    {
        SUM_PNC_Update_LocalDeactivation_History(TempDeactivationBuffer, TempDeactivationCount, SUM_PNC_PNC_Number);
    }

}
#define SUM_PNC_STOP_SEC_CODE
