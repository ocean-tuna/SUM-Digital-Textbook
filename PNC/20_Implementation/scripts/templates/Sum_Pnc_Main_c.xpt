/*******************************************************************************
 * Function name    :  PNC_Active_RxPDU_Enable
 * Description      :  Sends Notification from SUM_PNC that RxPDU groups for
                       PN<n> are stopped or started.
 * Parameter in     :  void
 * Parameter out    :  RxPDUgroup
 * Return value     :  Std_ReturnType
 [$Satisfies $SDD_PNC 016] [$Satisfies $SDD_PNC 035]  [$Satisfies $SDD_PNC 109]
[$Satisfies $SDD_PNC 110]
 ******************************************************************************/
FUNC(Std_ReturnType, PNC_CODE) PNC_Active_RxPDU_Enable
(VAR(PDUgroup, AUTOMATIC) ARxPDUEnable)
{
    uint8 Loc_Retries_Idx;
    Std_ReturnType RetVal;

    RetVal = PNC_GaaSUM_PNC_Active_RxPDU_Enable[SUM_PNC_PNC_Number](ARxPDUEnable);
    if(RetVal != RTE_E_OK)
    {
        for(Loc_Retries_Idx = 0; ((Loc_Retries_Idx < NO_OF_RETRIES)  && (RetVal != RTE_E_OK)); Loc_Retries_Idx++)
        {
            RetVal=PNC_GaaSUM_PNC_Active_RxPDU_Enable[SUM_PNC_PNC_Number](ARxPDUEnable);
        }
    }
    return RetVal;
}

