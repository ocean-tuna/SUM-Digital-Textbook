/*******************************************************************************

  Function name :   PNC_Update_Local_DID_Bit
  Description   :   Sets or clears the local DID bit for the current PN.
                    Sets the local bit when the PN is in PNC_LOCALLY_ACTIVE mode;
                    clears it when the PN deactivation state is LOCAL_DEACTIVE.
  Parameter in  :   None
  Parameter out :   None
  Return value  :   void
  Remarks       :   None
  [$Satisfies $SDD_PNC 058]
 ******************************************************************************/
static FUNC(void, PNC_CODE) PNC_Update_Local_DID_Bit(void)
{
    uint8 BitPosition;
    uint8 ByteIndex;

    ByteIndex = SUM_PNC_Cfg[SUM_PNC_PNC_Number].DID_Bit_Position / 8u;
    BitPosition = SUM_PNC_Cfg[SUM_PNC_PNC_Number].DID_Bit_Position % 8u;

    if(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode == PNC_LOCALLY_ACTIVE)
    {
        SUM_PNC_DID_INFO_Local[ByteIndex] |= (1U << BitPosition); /* PRQA S 4397 EOF */
        SUM_PNC_DID_INFO_Remote[ByteIndex] &= (~(1U << BitPosition));
    }
    else if(SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DeActState == LOCAL_DEACTIVE)
    {
        SUM_PNC_DID_INFO_Local[ByteIndex] &= (~(1U << BitPosition));
        SUM_PNC_DID_INFO_Remote[ByteIndex] &= (~(1U << BitPosition));
    }
    else
    {
        /* Do Nothing */
    }
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************

  Function name :   PNC_Update_Remote_DID_Bit
  Description   :   Sets or clears the remote DID bit for the current PN.
                    Sets the remote bit when the PN is in PNC_REMOTELY_ACTIVE mode
                    and a new NM activation with remote criteria is confirmed;
                    clears it when the PN deactivation state is REMOTE_DEACTIVE.
  Parameter in  :   None
  Parameter out :   None
  Return value  :   void
  Remarks       :   None
  [$Satisfies $SDD_PNC 060]
 ******************************************************************************/
static FUNC(void, PNC_CODE) PNC_Update_Remote_DID_Bit(void)
{
    uint8 i;
    uint8 BitPosition;
    uint8 ByteIndex;
 
    for (i = 0u; i < NUMBER_OF_PNC_PARTIAL_NETWORKS; i++)
    {
        ByteIndex = SUM_PNC_Cfg[i].DID_Bit_Position / 8u;
        BitPosition = SUM_PNC_Cfg[i].DID_Bit_Position % 8u;
 
        if((SUM_GaaPNC[i].Current_PNC_Mode == PNC_REMOTELY_ACTIVE) &&
           (SUM_PNC_NM_NewActivation[i] == TRUE) &&
           (SUM_PNC_Criteria_NM_Act_Remote[i] == TRUE))
        {
            SUM_PNC_DID_INFO_Remote[ByteIndex] |= (1U << BitPosition); /* PRQA S 4397 EOF */
            SUM_PNC_DID_INFO_Local[ByteIndex] &= (~(1U << BitPosition));
        }
    }
    if(SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DeActState == REMOTE_DEACTIVE)
    {
        ByteIndex = SUM_PNC_Cfg[SUM_PNC_PNC_Number].DID_Bit_Position / 8u;
        BitPosition = SUM_PNC_Cfg[SUM_PNC_PNC_Number].DID_Bit_Position % 8u;

        SUM_PNC_DID_INFO_Remote[ByteIndex] &= (~(1U << BitPosition));
        SUM_PNC_DID_INFO_Local[ByteIndex] &= (~(1U << BitPosition));
    }
    else
    {
        /* Do Nothing */
    }
   
}
