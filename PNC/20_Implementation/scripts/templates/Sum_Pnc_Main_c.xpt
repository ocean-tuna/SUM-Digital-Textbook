/*******************************************************************************
 * Function name    : Status_PNC_Locally_Active
 * Description      : Function to
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
[$Satisfies $SDD_PNC 027] [$Satisfies $SDD_PNC 029] [$Satisfies $SDD_PNC 042]
[$Satisfies $SDD_PNC 048]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Status_PNC_Locally_Active(void)
{
	boolean Loc_Activation_criteria;
	uint8 Loc_PNC_ComM_Current_PNC_ModeUSer;
    boolean ARxPDUEnable;
    boolean ATxPDUEnable;

    /* Activation criteria for sensor signals for current partial network is fetched by calling Activation_Sensor API */
    Activation_Sensor();

    if ((SUM_PNC_Criteria_Sensor_Act[SUM_PNC_PNC_Number] == TRUE) ||
        (SUM_PNC_Criteria_Signal_Act[SUM_PNC_PNC_Number] == TRUE))
    {
        Loc_Activation_criteria = TRUE;
    }
    else
    {
        Loc_Activation_criteria = FALSE;
    }

    Loc_PNC_ComM_Current_PNC_ModeUSer = PNC_BswM_ComM_Current_PNC_ModeUSer();

    /* [$Satisfies $SDD_PNC 046] */
    if ((Loc_Activation_criteria == FALSE)
        && (SUM_GaaPNC[SUM_PNC_PNC_Number].Counter_Repeat_Msg_Time_Timer == 0u))
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_State = SUM_PNC_NO_COMMUNICATION;
        (void) PNC_BswM_Current_PNC_Mode_Req(SUM_PNC_NO_COMMUNICATION);
        SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State = SUM_PNC_NO_COMMUNICATION;

        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_REMOTELY_ACTIVE;
«IF isUsingUDP(pNC.pNCConfigSet) == false -»
		PNC_Update_Remote_DID_Bit();
«ENDIF -»
        /*Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
    /* [$Satisfies $SDD_PNC 049] */
    else if ((Loc_PNC_ComM_Current_PNC_ModeUSer == SUM_PNC_PREPARE_SLEEP)
             || (Loc_PNC_ComM_Current_PNC_ModeUSer == SUM_PNC_NO_COMMUNICATION))
    {

        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State = SUM_PDUGRP_STOP;
        SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup = STOP;
        SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup = STOP;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State = SUM_PDUGRP_STOP;
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_ENABLE;

        (void) PNC_BswM_ComM_Pdugroupswitch_RxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State); //com
        (void) PNC_BswM_ComM_Pdugroupswitch_TxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State); //com
        ARxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsRxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup);
        (void) PNC_Active_RxPDU_Enable(ARxPDUEnable); //ssfm
        ATxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsTxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup);
        (void) PNC_Active_TxPDU_Enable(ATxPDUEnable); //SWCs
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_ENABLE_CHECK;
        /* Update the DID bits as this PN is getting deactivated */
        SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DeActState = LOCAL_DEACTIVE;
«IF isUsingUDP(pNC.pNCConfigSet) == false -»
		PNC_Update_Local_DID_Bit();
«ENDIF -»
    }
    else
    {
        /* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : Status_PNC_Remotely_Active
 * Description      : Function to
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 [$Satisfies $SDD_PNC 028] [$Satisfies $SDD_PNC 030] [$Satisfies $SDD_PNC 042]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Status_PNC_Remotely_Active(void)
{
    boolean Loc_Activation_criteria;
    uint8 Loc_PNC_ComM_Current_PNC_ModeUSer;
    boolean ARxPDUEnable;
    boolean ATxPDUEnable;

    /* [$Satisfies $SDD_PNC 081] Deadline monitoring management */
    PNC_DeadlineMonitoring(SUM_PNC_PNC_Number);

«IF isUsingUDP(pNC.pNCConfigSet) == false -»
    /* Update remote DID bit if a new NM activation was received for this PN while already remotely active */
    PNC_Update_Remote_DID_Bit();
«ENDIF -»

    /* Activation criteria for sensor signals for current partial network is fetched by calling Activation_Sensor API */
    Activation_Sensor();
    if ((SUM_PNC_Criteria_Sensor_Act[SUM_PNC_PNC_Number] == TRUE) ||
        (SUM_PNC_Criteria_Signal_Act[SUM_PNC_PNC_Number] == TRUE))
    {
        Loc_Activation_criteria = TRUE;
    }
    else
    {
        Loc_Activation_criteria = FALSE;
    }

    Loc_PNC_ComM_Current_PNC_ModeUSer = PNC_BswM_ComM_Current_PNC_ModeUSer();

    /* [$Satisfies $SDD_PNC 047] */
    if (Loc_Activation_criteria == TRUE)
    {
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_State = SUM_PNC_REQUESTED;
        (void) PNC_BswM_Current_PNC_Mode_Req(SUM_PNC_REQUESTED);
        SUM_GaaPNC[SUM_PNC_PNC_Number].Requested_PNC_State = SUM_PNC_REQUESTED;

        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_LOCALLY_ACTIVE;
«IF isUsingUDP(pNC.pNCConfigSet) == false -»
		PNC_Update_Local_DID_Bit();
«ENDIF -»
        /* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;

        /* [$Satisfies $SDD_PNC 084] Request to BswM to enable Deadline Monitoring */
        (void)SUM_PNC_Cfg[SUM_PNC_PNC_Number].ptr_Switch_DM_Mode(PNC_DM_ENABLE);

        /* [$Satisfies $SDD_PNC 071] Reset default state to DM_ACTIVE state */
        SUM_GaaPNC[SUM_PNC_PNC_Number].DM_Status = PNC_DM_ACTIVE;
    }
    /* [$Satisfies $SDD_PNC 050] */
    else if ((Loc_PNC_ComM_Current_PNC_ModeUSer == SUM_PNC_PREPARE_SLEEP)
             || (Loc_PNC_ComM_Current_PNC_ModeUSer == SUM_PNC_NO_COMMUNICATION))
    {

        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State = SUM_PDUGRP_STOP;
        SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup = STOP;
        SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup = STOP;
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State = SUM_PDUGRP_STOP;
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_ENABLE;

        (void) PNC_BswM_ComM_Pdugroupswitch_RxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupRX_State);
        (void) PNC_BswM_ComM_Pdugroupswitch_TxReq(SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PduGroupTX_State);
        ARxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsRxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].RxPDUgroup);
        (void) PNC_Active_RxPDU_Enable(ARxPDUEnable);

        ATxPDUEnable = (SUM_PNC_Cfg[SUM_PNC_PNC_Number].IsTxEnabled == FALSE) ? (STOP) : (SUM_GaaPNC[SUM_PNC_PNC_Number].TxPDUgroup);
        (void) PNC_Active_TxPDU_Enable(ATxPDUEnable);
        SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode = PNC_ENABLE_CHECK;
        /* Update the DID bits as this PN is getting deactivated */
        SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DeActState = REMOTE_DEACTIVE;
«IF isUsingUDP(pNC.pNCConfigSet) == false -»
		PNC_Update_Remote_DID_Bit();
«ENDIF -»

        /* [$Satisfies $SDD_PNC 084] Request to BswM to enable Deadline Monitoring */
        (void)SUM_PNC_Cfg[SUM_PNC_PNC_Number].ptr_Switch_DM_Mode(PNC_DM_ENABLE);

        /* [$Satisfies $SDD_PNC 071] Reset default state to DM_ACTIVE state */
        SUM_GaaPNC[SUM_PNC_PNC_Number].DM_Status = PNC_DM_ACTIVE;
    }
    else
    {
        /* Clear the Shut down permission */
        SUM_PNC_Shutdown_Permission[SUM_PNC_PNC_Number] = SHUTDOWN_DISABLE;
    }
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : Check_DTC_Allowed_Timer
 * Description      : Function to
 * Parameter in     : void
 * Parameter out    : None
 * Return value     : None
 * [$Satisfies $SDD_PNC 111] [$Satisfies $SDD_PNC 112]
 ******************************************************************************/
FUNC(void, PNC_CODE) Check_DTC_Allowed_Timer(void)
{
    SUM_PNC_DTC_AllowedType dtc_allowed;

	/* Transition from PN_IDLE to PN_ACTIVE or Staying in PN_ACTIVE *//* [$Satisfies $SDD_PNC 106] */
	if(((SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode == PNC_LOCALLY_ACTIVE )||(SUM_GaaPNC[SUM_PNC_PNC_Number].DM_Status == PNC_DM_ACTIVE)))
	{
	    /* [$Satisfies $SDD_PNC 088] */
		if(SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DTC_Timer < PNC_MAIN_FUNCTION_PERIOD)
		{
		    /* [$Satisfies $SDD_PNC 091] */
			dtc_allowed = DTC_Allowed;
		}
		else
		{
		    /* [$Satisfies $SDD_PNC 093] */
			dtc_allowed = DTC_Might_Be_Allowed;
			SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DTC_Timer-=PNC_MAIN_FUNCTION_PERIOD;
		}

	}else /* Staying in PN_IDLE */
	{
	    /* [$Satisfies $SDD_PNC 087] [$Satisfies $SDD_PNC 089] */
		SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DTC_Timer = SUM_PNC_Cfg[SUM_PNC_PNC_Number].ptr_SUM_PN_DTC_TIMER_Default_Value();
		/* [$Satisfies $SDD_PNC 092] */
		dtc_allowed = DTC_Not_Allowed;
	}

	SUM_PNC_Cfg[SUM_PNC_PNC_Number].ptr_SUM_PN_DTC_Allowed(dtc_allowed);
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

/*
 *******************************************************************************
 * Runnable Functions
 *******************************************************************************
 */
#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"
/*******************************************************************************
 * Function name    : Activation_Signal_In
 * Description      : Updates Activation_criteria True/False
 * Parameter in     : None
 * Parameter out    : Activation_Criteria
 * Return value     : void
 [$Satisfies $SDD_PNC 009] [$Satisfies $SDD_PNC 053]
 ******************************************************************************/
FUNC(void, PNC_CODE) Activation_Signal_In(void)
{
    VAR(Criteria_Struct, AUTOMATIC) Activation_Criteria_out = {FALSE, FALSE};
    VAR(Criteria_Struct, AUTOMATIC) Activation_SigStat_out = {FALSE, FALSE};
    VAR(uint8, AUTOMATIC) Loc_Index;
    VAR(uint8, AUTOMATIC) PN_Index;
	/* Activation criteria */
    VAR(boolean, AUTOMATIC) AtLeastOneActivated;

    /* Temporary buffers for activation and deactivation */
    uint8 TempActivationBuffer[SUM_PNC_MAX_SIGNALS];
    uint8 TempDeactivationBuffer[SUM_PNC_MAX_SIGNALS];
    uint8 TempActivationCount;
    uint8 TempDeactivationCount;

    /* Iterate through all Partial Networks */
    for (PN_Index = 0U; PN_Index < NUMBER_OF_PNC_PARTIAL_NETWORKS; PN_Index++)
    {
        TempActivationCount = 0U; /* Reset activation buffer for each PN */
        TempDeactivationCount = 0U; /* Reset deactivation buffer for each PN */
        AtLeastOneActivated = FALSE;
		if(PNC_GaaPNC_C_ProcessPN[PN_Index]() == TRUE)
		{
			/* Iterate through all signals in the current PN */
			for (Loc_Index = 0U; Loc_Index < SUM_PNC_Cfg[PN_Index].Number_of_PNC_Activation_Signals; Loc_Index++)
			{
				/* Fetch activation and deactivation criteria for this signal */
				SUM_PNC_Cfg[PN_Index].ptr_PNC_GaaSUM_Activation_Signals_Interface[Loc_Index](&Activation_Criteria_out);
				/* Fetch signal status for the corresponding signal (same index) */
				SUM_PNC_Cfg[PN_Index].ptr_PNC_GaaSUM_Activation_Signals_Status_Interface[Loc_Index](&Activation_SigStat_out);

				/* Valid activation: both signal value AND its signal status must be TRUE */
				if ((Activation_Criteria_out.ActCriteria_local == TRUE) &&
				    (Activation_SigStat_out.ActCriteria_SigStat == TRUE))
				{
					TempActivationBuffer[TempActivationCount] =
					    Loc_Index + SUM_PNC_Cfg[PN_Index].Number_of_PNC_Activation_Sensors;
					TempActivationCount++;
					AtLeastOneActivated = TRUE; /* At least one signal is activated */
				}
				else
				{
					/* Signal not active - mark for removal from history */
					TempDeactivationBuffer[TempDeactivationCount] =
					    Loc_Index + SUM_PNC_Cfg[PN_Index].Number_of_PNC_Activation_Sensors;
					TempDeactivationCount++;
				}
			}
			/* Update activation state */
			SUM_PNC_Criteria_Signal_Act[PN_Index] = AtLeastOneActivated;
		}
        /*  Update the main buffer for activation to main buffer */
        if (TempActivationCount > 0U)
        {
            SUM_PNC_Update_LocalActivation_History(TempActivationBuffer, TempActivationCount, PN_Index);
        }

        /*Remove the signals for deactivation from main buffer */
        if (TempDeactivationCount > 0U)
        {
            SUM_PNC_Update_LocalDeactivation_History(TempDeactivationBuffer, TempDeactivationCount, PN_Index);
        }
    }

}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"


#define SUM_PNC_START_SEC_CODE
