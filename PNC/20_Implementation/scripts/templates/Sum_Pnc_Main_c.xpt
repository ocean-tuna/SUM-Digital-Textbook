/* [$Satisfies $SDD_PNC  073] */
/*******************************************************************************
 * Function name    : PNC_NM_Frame_Indication
 * Description      : This function implements the NM callback needed for deadline
 *                    monitoring. Sets the timer of requested PN by the PN Coordinator ECU
 * Parameter in     : NetworkHandle
 * Parameter out    : void
 * Return value     : None
 ******************************************************************************/
FUNC(void, NM_CODE) PNC_NM_Frame_Indication(CONST(NetworkHandleType, AUTOMATIC) NetworkHandle)
{
    VAR(uint8,AUTOMATIC) NM_Frame[PNC_NM_FRAME_LENGTH];
    VAR(Std_ReturnType,AUTOMATIC) rv;
    VAR(uint8,AUTOMATIC) i;
    VAR(uint8,AUTOMATIC) byte_index, bit_index;
    VAR(uint8,AUTOMATIC) NM_NewlyActivated[NUMBER_OF_PNC_PARTIAL_NETWORKS];
    VAR(uint8,AUTOMATIC) NM_NewlyActivatedCount = 0U;
    VAR(uint8,AUTOMATIC) NM_Deactivated[NUMBER_OF_PNC_PARTIAL_NETWORKS];
    VAR(uint8,AUTOMATIC) NM_DeactivatedCount = 0U;


    /* Read the content of the latest NM Frame received */
#if(PNC_ETHERNET_SUPPORT == STD_OFF)
    rv = CanNm_GetPduData(NetworkHandle, NM_Frame);
#else
    rv = UdpNm_GetPduData(NetworkHandle, NM_Frame);
#endif

    if(rv == E_OK)
    {
        /* [$Satisfies $SDD_PNC 074] Check PN Coordinator ID to process NM Frame */
        if(NM_Frame[PNC_ECU_ID_BYTE_INDEX] == PNC_PN_COORDINATOR_ID)
        {
            for(i = 0; i < NUMBER_OF_PNC_PARTIAL_NETWORKS; i++)
            {
                /* Compute the corresponding NM frame bit */
                byte_index = PNC_USER_DATA_INDEX_START + (SUM_PNC_Cfg[i].DID_Bit_Position / PNC_BYTE_LENGTH);
                bit_index = SUM_PNC_Cfg[i].DID_Bit_Position % PNC_BYTE_LENGTH;

                /* [$Satisfies $SDD_PNC 075] Check if the partial network has been requested remotely */
                if(((NM_Frame[byte_index] >> bit_index) & (uint8)PNC_PN_REQUESTED) != 0u)
                {
                    /* [$Satisfies $SDD_PNC 076] Reset the timer for the PN */
                    SUM_GaaPNC[i].DM_Timer = SUM_PNC_Cfg[i].DM_Max_Timer;
                    /* Check if the PN Name is not configured as IDS to update the NM criteria and WR accordingly */
                    if (SUM_PNC_Cfg[i].PN_Name != 0u)
                    {
                        if (SUM_PNC_Criteria_NM_Act_Remote[i] == FALSE)
                        {
                            NM_NewlyActivated[NM_NewlyActivatedCount] = SUM_PNC_Cfg[i].PN_Name;
                            NM_NewlyActivatedCount++;
                            SUM_PNC_NM_NewActivation[i] = TRUE;
                        }
                        SUM_PNC_Criteria_NM_Act_Remote[i] = TRUE;
                    }
                }
                else
                {
                    if ((SUM_PNC_Cfg[i].PN_Name != 0u) && (SUM_PNC_Criteria_NM_Act_Remote[i] == TRUE))
                    {
                        NM_Deactivated[NM_DeactivatedCount] = SUM_PNC_Cfg[i].PN_Name;
                        NM_DeactivatedCount++;
                    }
                    SUM_PNC_Criteria_NM_Act_Remote[i] = FALSE;
                }
            }
            if (NM_DeactivatedCount > 0U)
            {
                SUM_PNC_Update_NM_Deactivation_History(NM_Deactivated, NM_DeactivatedCount);
            }
            if (NM_NewlyActivatedCount > 0U)
            {
                SUM_PNC_Update_NM_Activation_History(NM_NewlyActivated, NM_NewlyActivatedCount);
            }
        }
    }
}

#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"

/*******************************************************************************
 * Function name    : PNC_DeadlineMonitoring
 * Description      : Function that implements the deadline monitoring
 *                    finite state machine.
 * Parameter in     : PN_index
 * Parameter out    : void
 * Return value     : None
 ******************************************************************************/
/* [$Satisfies $SDD_PNC 081] */
FUNC(void, PNC_CODE) PNC_DeadlineMonitoring(uint8 PN_index)
{
    /* Deadline Monitoring FSM */
    if(SUM_GaaPNC[PN_index].DM_Status == PNC_DM_ACTIVE)
    {
        /* Check timer status */
        if(SUM_GaaPNC[PN_index].DM_Timer < PNC_MAIN_FUNCTION_PERIOD)
        {
            /* [$Satisfies $SDD_PNC 077] Timer elapsed. Disable deadline monitoring */
            SUM_GaaPNC[PN_index].DM_Status = PNC_DM_INACTIVE;

            /* [$Satisfies $SDD_PNC 078] Request to BswM to disable Deadline Monitoring */
            (void)SUM_PNC_Cfg[PN_index].ptr_Switch_DM_Mode(PNC_DM_DISABLE);
			 /* [$Satisfies $SDD_PNC 105] */
			SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DTC_Timer = SUM_PNC_Cfg[SUM_PNC_PNC_Number].ptr_SUM_PN_DTC_TIMER_Default_Value();

			SUM_PNC_Criteria_NM_Act_Remote[PN_index] = FALSE;
			SUM_PNC_DM_Timer_Elapsed[PN_index] = TRUE;
			if (SUM_PNC_Cfg[PN_index].PN_Name != 0u)
			{
				SUM_PNC_Update_NM_Deactivation_History(&SUM_PNC_Cfg[PN_index].PN_Name, 1U);
			}

        }
        else
        {
            /* [$Satisfies $SDD_PNC 072] Update timers */
            SUM_GaaPNC[PN_index].DM_Timer -= PNC_MAIN_FUNCTION_PERIOD;
        }
    }
    else
    {
        /* PNC_DM_INACTIVE state */
        if(SUM_GaaPNC[PN_index].DM_Timer >= PNC_MAIN_FUNCTION_PERIOD)
        {
            /* [$Satisfies $SDD_PNC 083] NM Frame notification arrived. Request to BswM to enable Deadline Monitoring */
            (void)SUM_PNC_Cfg[PN_index].ptr_Switch_DM_Mode(PNC_DM_ENABLE);

            /* [$Satisfies $SDD_PNC 082] Transition to DM_ACTIVE state */
            SUM_GaaPNC[PN_index].DM_Status = PNC_DM_ACTIVE;
        }
    }
}

/*******************************************************************************
 * Function name    : SUM_PNC_Handle_Generic_RID_Logic
 * Description      : Generic function to handle both Diag PN and Remote PN RID logic
 * Parameter in     : RID, ActiveMode
 * Parameter out    : RecordIdInfo
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 128]*/
static FUNC(void, PNC_CODE) SUM_PNC_Handle_Generic_RID_Logic(VAR(RID_Enum, AUTOMATIC) RID,
                                                             VAR(PNC_Modes, AUTOMATIC) ActiveMode,
                                                             P2VAR(RecordIdType, AUTOMATIC, AUTOMATIC) RecordIdInfo)
{
    uint8 PN_Index;
    boolean AnyPnActive = FALSE;
    uint8 FirstActiveWakeupReason = 0x00U;
    boolean FirstActiveFound = FALSE;

    /* Static variables to track previous states for change detection */
    static boolean Previous_PN_Active_State[NUMBER_OF_PNC_PARTIAL_NETWORKS];
    uint8 NewlyActivatedWakeupReason = 0x00U;
    boolean NewActivationDetected = FALSE;
    boolean CurrentPnActive;
    uint8 CurrentPnWakeupReason = 0U;

    /* Initialize output structure */
    RecordIdInfo->RID = RID;
    RecordIdInfo->RWR = 0x00U;
    RecordIdInfo->state = FALSE;

    /* Loop through all PNs to check if any with specified RID is active */
    for (PN_Index = 0U; PN_Index < NUMBER_OF_PNC_PARTIAL_NETWORKS; PN_Index++)
    {
        if ((SUM_PNC_Cfg[PN_Index].PN_Name == SPM_PNC_LOC_DIAG_RID) ||
            (RID == SPM_PNC_REMOTE_RID))
        {
            /* Check current state regardless of what it is */
            if (ActiveMode == PNC_REMOTELY_ACTIVE)
            {
                /* Remote PN is only considered active when both
                   mode is REMOTELY_ACTIVE AND the NM activation criterion is still TRUE.
                   When DM timer elapses, criteria goes FALSE immediately so state=FALSE
                   is correctly reported to SUSD even before mode transitions. */
                CurrentPnActive = (SUM_GaaPNC[PN_Index].Current_PNC_Mode == ActiveMode)
                                  && (SUM_PNC_Criteria_NM_Act_Remote[PN_Index] == TRUE);
            }
            else
            {
                CurrentPnActive = (SUM_GaaPNC[PN_Index].Current_PNC_Mode == ActiveMode);
            }

            /* Get the actual wakeup reason for this specific PN */
            if (ActiveMode == PNC_LOCALLY_ACTIVE)
            {
                CurrentPnWakeupReason = SUM_PNC_Local_WR[PN_Index];
            }
            else
            {
                if (SUM_PNC_Cfg[PN_Index].PN_Name != 0u)
                {
                    CurrentPnWakeupReason = SUM_PNC_NM_WR;
                }
            }
            if (CurrentPnActive == TRUE)
            {
                AnyPnActive = TRUE;

                /* Check if this PN just became active (change from deactive to active) */
                if (Previous_PN_Active_State[PN_Index] == FALSE)
                {
                    /* This PN just became active - use its wakeup reason (first newly activated found) */
                    if (NewActivationDetected == FALSE)
                    {
                        NewlyActivatedWakeupReason = CurrentPnWakeupReason;
                        NewActivationDetected = TRUE;
                    }
                }

                /* Store first active wakeup reason as fallback (for multiple active simultaneously) */
                if (FirstActiveFound == FALSE)
                {
                    FirstActiveWakeupReason = CurrentPnWakeupReason;
                    FirstActiveFound = TRUE;
                }

            }

            /* Always update previous state for ALL PNs with this RID */
            Previous_PN_Active_State[PN_Index] = CurrentPnActive;
        }
    }

	/* Handle result calculation and state management for RID processing */
	SUM_PNC_AnyPnActive_Update(RID, AnyPnActive, NewActivationDetected, NewlyActivatedWakeupReason,
	    FirstActiveWakeupReason, RecordIdInfo, Previous_PN_Active_State);
}

/*******************************************************************************
 * Function name    : SUM_PNC_AnyPnActive_Update
 * Description      : Helper function to handle result calculation and state management for RID processing
 * Parameter in     : RID, AnyPnActive, NewActivationDetected, NewlyActivatedWakeupReason, FirstActiveWakeupReason, Previous_PN_Active_State
 * Parameter out    : RecordIdInfo
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 129]*/
static FUNC(void, PNC_CODE) SUM_PNC_AnyPnActive_Update(VAR(RID_Enum, AUTOMATIC) RID,
                                                       VAR(boolean, AUTOMATIC) AnyPnActive,
                                                       VAR(boolean, AUTOMATIC) NewActivationDetected,
                                                       VAR(uint8, AUTOMATIC) NewlyActivatedWakeupReason,
                                                       VAR(uint8, AUTOMATIC) FirstActiveWakeupReason,
                                                       P2VAR(RecordIdType, AUTOMATIC, AUTOMATIC) RecordIdInfo,
                                                       P2VAR(boolean, AUTOMATIC, AUTOMATIC) Previous_PN_Active_State)
{
    uint8 PN_Index;

    /* Set final result based on findings */
    if (AnyPnActive == TRUE)
    {
        RecordIdInfo->state = TRUE;

        /* Priority: Newly activated > First active */
        if (NewActivationDetected == TRUE)
        {
            RecordIdInfo->RWR = NewlyActivatedWakeupReason;
        }
        else
        {
            RecordIdInfo->RWR = FirstActiveWakeupReason;
        }
    }
    else
    {
        RecordIdInfo->state = FALSE;
        RecordIdInfo->RWR = SUM_PNC_INVALID_REASON;

        /* Reset all previous states when all are inactive */
        for (PN_Index = 0U; PN_Index < NUMBER_OF_PNC_PARTIAL_NETWORKS; PN_Index++)
        {
            if (SUM_PNC_Cfg[PN_Index].PN_Name == RID)
            {
                Previous_PN_Active_State[PN_Index] = FALSE;
            }
        }
    }
}

/*******************************************************************************
 * Function name    : SUM_PNC_Handle_RecordInfo_Update
 * Description      : Generic function to handle record info update with dedicated tracking
 * Parameter in     : RecordIdInfo, PreviousRecordIdInfo
 * Parameter out    : None
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 127]*/
static FUNC(void, PNC_CODE) SUM_PNC_Handle_RecordInfo_Update(
    P2CONST(RecordIdType, AUTOMATIC, AUTOMATIC) RecordIdInfo,
    P2VAR(RecordIdType, AUTOMATIC, AUTOMATIC) PreviousRecordIdInfo)
{
    /* Compare against dedicated variable to ensure consistent tracking */
    if ((RecordIdInfo->RWR != PreviousRecordIdInfo->RWR) ||
        (RecordIdInfo->state != PreviousRecordIdInfo->state))
    {
        /* Notify only if there's a change */
        (void)Rte_Call_RP_PNC_SUSD_RecordInfo_UpdateRecord(RecordIdInfo);

        /* Update the last notified state to the current state */
        *PreviousRecordIdInfo = *RecordIdInfo;
    }
}

/*******************************************************************************
 * Function name    : SUM_PNC_SUSD_RecordInfo_Update
 * Description      : Function to update record info to support DID E0D7
 * Parameter in     : RID, Wakeup reason
 * Parameter out    : None
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 120] [$Satisfies $SDD_PNC 121] [$Satisfies $SDD_PNC 125] [$Satisfies $SDD_PNC 126]*/
static FUNC(void, PNC_CODE) SUM_PNC_SUSD_RecordInfo_Update(VAR(RID_Enum, AUTOMATIC) RID,
                                                       VAR(uint8, AUTOMATIC) WakeupReason)
{
    /* Static variable to store the last notified state for each PNC */
    static RecordIdType Previous_RecordIdInfo[NUMBER_OF_PNC_PARTIAL_NETWORKS];

    /* Dedicated static variable for Diag PN (RID 0x25) state tracking */
    static RecordIdType Previous_DiagPN_RecordIdInfo[NUMBER_OF_PNC_PARTIAL_NETWORKS];

    /* Dedicated static variable for Remote PN RID state tracking */
    static RecordIdType Previous_RemotePN_RecordIdInfo[NUMBER_OF_PNC_PARTIAL_NETWORKS];

    /* Local variable to hold the current RecordInfo */
    RecordIdType RecordIdInfo;

    /* Initialize the RecordIdInfo structure */
    RecordIdInfo.RID = RID;
    RecordIdInfo.RWR = 0x0U;
    RecordIdInfo.state = FALSE;

    /* Check if the PN name is configured within range */
    if (RID != SUM_PNC_LOCAL_NAME_OUTRANGE)
    {
        /* Special handling for RID 0x25 (Diag PN) */
        if (RID == SPM_PNC_LOC_DIAG_RID)
        {
            /* Use generic function for Diag PN logic */
            SUM_PNC_Handle_Generic_RID_Logic(RID, PNC_LOCALLY_ACTIVE, &RecordIdInfo);

            /* Use generic function to handle update */
            SUM_PNC_Handle_RecordInfo_Update(&RecordIdInfo, &Previous_DiagPN_RecordIdInfo[SUM_PNC_PNC_Number]);
        }
        /* Special handling for Remote PNC RID */
        else if (RID == SPM_PNC_REMOTE_RID)
        {
            /* Use generic function for Remote PN RID logic */
            SUM_PNC_Handle_Generic_RID_Logic(RID, PNC_REMOTELY_ACTIVE, &RecordIdInfo);

            /* Use generic function to handle update */
            SUM_PNC_Handle_RecordInfo_Update(&RecordIdInfo, &Previous_RemotePN_RecordIdInfo[SUM_PNC_PNC_Number]);
        }
        else
        {
            /* Regular PN handling (Local PN from 0x21 to 0x24) */

            /* Check if the PNC is locally active */
            if (SUM_GaaPNC[SUM_PNC_PNC_Number].Current_PNC_Mode == PNC_LOCALLY_ACTIVE)
            {
                /* If locally active, update the RecordInfo with the wakeup reason and active state */
                RecordIdInfo.RWR = WakeupReason;
                RecordIdInfo.state = TRUE;
            }
            else if (SUM_GaaPNC[SUM_PNC_PNC_Number].PN_DeActState == LOCAL_DEACTIVE)
            {
                /* If locally deactivated, reset the wakeup reason and state */
                RecordIdInfo.RWR = 0x00U;
                RecordIdInfo.state = FALSE;
            }
            else
            {
                /* do nothing */
            }
            /* Compare the current RecordInfo with the last notified state for regular PNs */
            if ((RecordIdInfo.RID != Previous_RecordIdInfo[SUM_PNC_PNC_Number].RID) ||
                (RecordIdInfo.RWR != Previous_RecordIdInfo[SUM_PNC_PNC_Number].RWR) ||
                (RecordIdInfo.state != Previous_RecordIdInfo[SUM_PNC_PNC_Number].state))
            {
                /* Notify only if there's a change */
                (void)Rte_Call_RP_PNC_SUSD_RecordInfo_UpdateRecord(&RecordIdInfo);

                /* Update the last notified state to the current state */
                Previous_RecordIdInfo[SUM_PNC_PNC_Number] = RecordIdInfo;
            }
        }
    }
}

/*******************************************************************************
 * Function name    : SUM_PNC_Update_LocalActivation_History
 * Description      : Updates the unified local activation history for a Partial Network (PN).
 *                    Handles activation by adding sensor/signal reason (with offset for signals).
 *                    Also updates the last wake-up reason in SUM_PNC_Local_WR.
 * Parameter in     : TempActivationBuffer, TempActivationCount, PN_Index
 * Parameter out    : None
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 002] [$Satisfies $SDD_PNC 120] [$Satisfies $SDD_PNC 121] [$Satisfies $SDD_PNC 123] [$Satisfies $SDD_PNC 130]*/
/* PRQA S 3673 3 # can not be const because of generation depends on config   */
static FUNC(void, PNC_CODE) SUM_PNC_Update_LocalActivation_History(P2VAR(uint8,AUTOMATIC,AUTOMATIC)TempActivationBuffer,
								VAR(uint8, AUTOMATIC) TempActivationCount,
								VAR(uint8, AUTOMATIC) PN_Index)
{
	«IF (GetPN_RecordID_Type(pNC)== 2) -»

    VAR(uint8, AUTOMATIC) BitMask = 0U;
	VAR(uint8, AUTOMATIC) ActivationIndex ;

    /* Iterate through TempActivationBuffer and set the corresponding bits */
    for (ActivationIndex = 0U; ActivationIndex < TempActivationCount; ActivationIndex++)
    {
        BitMask |= (1U << TempActivationBuffer[ActivationIndex]); /* Set the bit for the sensor/signal */
    }

    /* Update the global bit-mapped buffer */
    SUM_PNC_Local_WR[PN_Index] |= BitMask; /* Combine with existing active sources */

	«ELSEIF (GetPN_RecordID_Type(pNC)== 1) -»
	VAR(uint8, AUTOMATIC) ActivationIndex1;
	VAR(uint8, AUTOMATIC) ActivationIndex2;
	VAR(boolean, AUTOMATIC) ReasonExists;
	VAR(uint8, AUTOMATIC) MaxLocalSources;
	MaxLocalSources =
	    SUM_PNC_Cfg[PN_Index].Number_of_PNC_Activation_Sensors +
	    SUM_PNC_Cfg[PN_Index].Number_of_PNC_Activation_Signals;

    /*Add TempActivationBuffer entries to the main buffer */
    for (ActivationIndex1 = 0U; ActivationIndex1 < TempActivationCount; ActivationIndex1++)
    {
		ReasonExists = FALSE;
        /* Check if the entry already exists in the main buffer */
        for (ActivationIndex2 = 0U; ActivationIndex2 < SUM_PNC_LocalActReasonCount[PN_Index]; ActivationIndex2++)
        {
            if (SUM_PNC_LocalActReason[PN_Index][ActivationIndex2] == TempActivationBuffer[ActivationIndex1])
            {
                ReasonExists = TRUE; /* Entry already exists, skip it */
                break;
            }
        }

        /* Append the entry if it does not exist */
        if ((ReasonExists == FALSE) && (SUM_PNC_LocalActReasonCount[PN_Index] < MaxLocalSources))
        {
            SUM_PNC_LocalActReason[PN_Index][SUM_PNC_LocalActReasonCount[PN_Index]] = TempActivationBuffer[ActivationIndex1];
            SUM_PNC_LocalActReasonCount[PN_Index]++;
        }
    }

    /*Update the Last Active Source */
    SUM_PNC_Local_WR[PN_Index] = SUM_PNC_LocalActReason[PN_Index][0U]; /* First entry in the main buffer */

	«ELSE»
	(void)TempActivationBuffer;
	(void)TempActivationCount;
	(void)PN_Index;
	«ENDIF»
}

/*******************************************************************************
 * Function name    : SUM_PNC_Update_LocalDeactivation_History
 * Description      : Function to remove deactivated sensor/signal from unified local history
 * Parameter in     : TempDeactivationBuffer, TempDeactivationCount and PN_Index
 * Parameter out    : None
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 123] [$Satisfies $SDD_PNC 131]*/
static FUNC(void, PNC_CODE) SUM_PNC_Update_LocalDeactivation_History(P2CONST(uint8,AUTOMATIC,AUTOMATIC) TempDeactivationBuffer,
									VAR(uint8, AUTOMATIC) TempDeactivationCount,
									VAR(uint8, AUTOMATIC) PN_Index)
{

	«IF (GetPN_RecordID_Type(pNC)== 2) -»

    VAR(uint8, AUTOMATIC) BitMask = 0U;
	VAR(uint8, AUTOMATIC) DeactivationIndex;

    /* Iterate through TempDeactivationBuffer and clear the corresponding bits */
    for (DeactivationIndex = 0U; DeactivationIndex < TempDeactivationCount; DeactivationIndex++)
    {
        BitMask |= (1U << TempDeactivationBuffer[DeactivationIndex]); /* Create a mask for the deactivated sources */
    }

    /* Update the global bit-mapped buffer */
    SUM_PNC_Local_WR[PN_Index] &= ~BitMask; /* Clear the bits for deactivated sources */

	«ELSEIF (GetPN_RecordID_Type(pNC)== 1) -»
    VAR(uint8, AUTOMATIC) MainIndex ;
    VAR(uint8, AUTOMATIC) FillPosition = 0U;
    VAR(uint8, AUTOMATIC) TempIndex ;
	VAR(boolean, AUTOMATIC) IsDeactivated ;
    /*  Remove TempDeactivationBuffer entries from the main buffer */
    for (MainIndex = 0U; MainIndex < SUM_PNC_LocalActReasonCount[PN_Index]; MainIndex++)
    {
		IsDeactivated = FALSE;

        /* Check if the current entry exists in TempDeactivationBuffer */
        for (TempIndex = 0U; TempIndex < TempDeactivationCount; TempIndex++)
        {
            if (SUM_PNC_LocalActReason[PN_Index][MainIndex] == TempDeactivationBuffer[TempIndex])
            {
                IsDeactivated = TRUE;
                break;
            }
        }

        /* Retain entries not marked for deactivation */
        if (IsDeactivated == FALSE)
        {
            SUM_PNC_LocalActReason[PN_Index][FillPosition] = SUM_PNC_LocalActReason[PN_Index][MainIndex];
            FillPosition++;
        }
    }

    /* Update the active reason count */
    SUM_PNC_LocalActReasonCount[PN_Index] = FillPosition;

    /* Update the Last Active Source */
    if (FillPosition > 0U)
    {
        SUM_PNC_Local_WR[PN_Index] = SUM_PNC_LocalActReason[PN_Index][0U];
    }
    else
    {
        SUM_PNC_Local_WR[PN_Index] = SUM_PNC_INVALID_REASON; /* Reset if no sources remain */
    }
	«ELSE»
	(void)TempDeactivationBuffer;
	(void)TempDeactivationCount;
	(void)PN_Index;
	«ENDIF»
}
/*******************************************************************************
 * Function name    : SUM_PNC_SortReasonBuffer
 * Description      : Sorts a buffer of uint8 PN names in ascending order
 *                    using insertion sort (in-place).
 *                    Ascending order ensures the first element is the minimum,
 *                    which is used as the wakeup reason (WR).
 * Parameter in     : Count - number of valid entries in Buffer
 * Parameter in/out : Buffer - array to sort in-place
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 134]*/
static FUNC(void, PNC_CODE) SUM_PNC_SortReasonBuffer(
    P2VAR(uint8, AUTOMATIC, AUTOMATIC) Buffer,
    VAR(uint8, AUTOMATIC) Count)
{
    VAR(uint8, AUTOMATIC) SortIndex;
    VAR(uint8, AUTOMATIC) InsertIndex;
    VAR(uint8, AUTOMATIC) TempReason;

    for (SortIndex = 1U; SortIndex < Count; SortIndex++)
    {
        TempReason = Buffer[SortIndex];
        for (InsertIndex = SortIndex;
             (InsertIndex > 0U) && (Buffer[InsertIndex - 1U] > TempReason);
             InsertIndex--)
        {
            Buffer[InsertIndex] = Buffer[InsertIndex - 1U];
        }
        Buffer[InsertIndex] = TempReason;
    }
}

/*******************************************************************************
 * Function name    : SUM_PNC_MergeReasonIntoNMList
 * Description      : Appends a single PN name to the global NM activation
 *                    history list if it is not already present and the list
 *                    has remaining capacity. Has no effect otherwise.
 * Parameter in     : Reason - PN name to add
 * Parameter out    : None
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 135]*/
static FUNC(void, PNC_CODE) SUM_PNC_MergeReasonIntoNMList(
    VAR(uint8, AUTOMATIC) Reason)
{
    VAR(uint8, AUTOMATIC) Index;
    VAR(boolean, AUTOMATIC) ReasonExists = FALSE;

    for (Index = 0U; Index < SUM_PNC_NM_ActReasonCount; Index++)
    {
        if (SUM_PNC_NM_ActReason[Index] == Reason)
        {
            ReasonExists = TRUE;
            break;
        }
    }
    if ((ReasonExists == FALSE) && (SUM_PNC_NM_ActReasonCount < (uint8)NUMBER_OF_PNC_PARTIAL_NETWORKS))
    {
        SUM_PNC_NM_ActReason[SUM_PNC_NM_ActReasonCount] = Reason;
        SUM_PNC_NM_ActReasonCount++;
    }
}

/*******************************************************************************
 * Function name    : SUM_PNC_Update_NM_Activation_History
 * Description      : Merges newly activated NM PN names into the global NM
 *                    activation history list in ascending (sorted) order.
 *                    Duplicates and entries that exceed the list capacity are
 *                    silently discarded.
 *                    SUM_PNC_NM_WR is set to the list head, which is the
 *                    minimum active PN name due to the ascending sort.
 * Parameter in     : NewReasons - array of newly activated PN names
 *                    Count      - number of entries in NewReasons
 * Parameter out    : None
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 124] [$Satisfies $SDD_PNC 132]*/
static FUNC(void, PNC_CODE) SUM_PNC_Update_NM_Activation_History(
    P2CONST(uint8, AUTOMATIC, AUTOMATIC) NewReasons,
    VAR(uint8, AUTOMATIC) Count)
{
    VAR(uint8, AUTOMATIC) ActivationIndex;
    VAR(uint8, AUTOMATIC) SortedReasons[NUMBER_OF_PNC_PARTIAL_NETWORKS];

    /* Copy input to a local buffer so the callers array is not modified */
    for (ActivationIndex = 0U; ActivationIndex < Count; ActivationIndex++)
    {
        SortedReasons[ActivationIndex] = NewReasons[ActivationIndex];
    }

    /* Sort ascending so WR (list head) will be the minimum PN name */
    SUM_PNC_SortReasonBuffer(SortedReasons, Count);

    /* Merge each sorted entry into the global list (dedup + capacity enforced inside) */
    for (ActivationIndex = 0U; ActivationIndex < Count; ActivationIndex++)
    {
        SUM_PNC_MergeReasonIntoNMList(SortedReasons[ActivationIndex]);
    }

    /* Update WR to the list head (minimum active PN name) */
    if (SUM_PNC_NM_ActReasonCount > 0U)
    {
        SUM_PNC_NM_WR = SUM_PNC_NM_ActReason[0U];
    }
}

/*******************************************************************************
 * Function name    : SUM_PNC_Update_NM_Deactivation_History
 * Description      : Removes deactivated NM PN names from the global NM
 *                    activation history list.
 *                    Updates SUM_PNC_NM_WR to the new list head.
 * Parameter in     : RemovedReasons, Count
 * Parameter out    : None
 * Return value     : None
 ******************************************************************************/
/*[$Satisfies $SDD_PNC 124] [$Satisfies $SDD_PNC 133]*/
static FUNC(void, PNC_CODE) SUM_PNC_Update_NM_Deactivation_History(
    P2CONST(uint8, AUTOMATIC, AUTOMATIC) RemovedReasons,
    VAR(uint8, AUTOMATIC) Count)
{
    VAR(uint8, AUTOMATIC) MainIndex;
    VAR(uint8, AUTOMATIC) FillPosition = 0U;
    VAR(uint8, AUTOMATIC) TempIndex;
    VAR(boolean, AUTOMATIC) IsDeactivated;
    VAR(uint8, AUTOMATIC) MinReason;
    VAR(uint8, AUTOMATIC) Idx;

    for (MainIndex = 0U; MainIndex < SUM_PNC_NM_ActReasonCount; MainIndex++)
    {
        IsDeactivated = FALSE;
        for (TempIndex = 0U; TempIndex < Count; TempIndex++)
        {
            if (SUM_PNC_NM_ActReason[MainIndex] == RemovedReasons[TempIndex])
            {
                IsDeactivated = TRUE;
                break;
            }
        }
        if (IsDeactivated == FALSE)
        {
            SUM_PNC_NM_ActReason[FillPosition] = SUM_PNC_NM_ActReason[MainIndex];
            FillPosition++;
        }
    }

    SUM_PNC_NM_ActReasonCount = FillPosition;

    if (FillPosition > 0U)
    {
        SUM_PNC_NM_WR = SUM_PNC_NM_ActReason[0U];
    }
    else
    {
        /* Last PN(s) went inactive: WR = lowest of the deactivating PNs */
        MinReason = RemovedReasons[0U];
        for (Idx = 1U; Idx < Count; Idx++)
        {
            if (RemovedReasons[Idx] < MinReason)
            {
                MinReason = RemovedReasons[Idx];
            }
        }
        SUM_PNC_NM_WR = MinReason;
    }
}

#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

/********************************** END OF FILE *******************************/
«ENDFILE»
«ENDDEFINE»