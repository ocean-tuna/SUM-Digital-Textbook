/*******************************************************************************
 * Function name    : Shutdown_permission_SUSD
 * Description      : Requests SUSD for shutdown permission of a Partial Network
 * Parameter in     : void
 * Parameter out    : void
 * Return value     : void
  [$Satisfies $SDD_PNC 012] [$Satisfies $SDD_PNC 002] [$Satisfies $SDD_PNC 040]
  [$Satisfies $SDD_PNC 007] [$Satisfies $SDD_PNC 113]
 *******************************************************************************/
FUNC(void, PNC_CODE) Shutdown_permission_SUSD(void)
{
   static uint8 PNC_Alive_count = SHUTDOWN_DISABLE;
   uint8 Loc_Index;
   uint8 Loc_ShutdownPermission_Flag = 0;

   if(Permit_Execution_SUSD() == TRUE)
   {
	  /* Check shutdown for all the PNs */
     for(Loc_Index = 0;Loc_Index < NUMBER_OF_PNC_PARTIAL_NETWORKS  ;Loc_Index++)
     {
	  if(PNC_GaaPNC_C_ProcessPN[Loc_Index]()== TRUE)
	  {
		  if ((SUM_PNC_Shutdown_Permission[Loc_Index] == SHUTDOWN_ENABLE))
		  {
			  Loc_ShutdownPermission_Flag++;
		  }
		  else
		  {
			  /* Do Nothing */
		  }
	  }
	  else
	  {
	  Loc_ShutdownPermission_Flag++; /* Increment the Shutdown flag for all the disabled PN to have the proper shutdown of the PNC. If a PN is disabled, then SUM_PNC will not request shutdown at all */
	  }
	 }
	 /* If all the Partial networks are updated with shutdown flag or Ecu reset bit is FALSE*/
	 if((Loc_ShutdownPermission_Flag ==  NUMBER_OF_PNC_PARTIAL_NETWORKS))
	 {
	   Loc_ShutdownPermission_Flag = SHUTDOWN_ENABLE;
	/* Invoke Shutdown permission to SUSD */
	 (void)Rte_Write_PP_ShutdownPermission_SUSD_UserRequest(Loc_ShutdownPermission_Flag);
	 }
	 else
	 {
	   /* Invoke Shutdown permission to SUSD */
	   (void)Rte_Write_PP_ShutdownPermission_SUSD_UserRequest(PNC_Alive_count);
	   PNC_Alive_count ++;

	   if(PNC_Alive_count > 3u)
	   {
	   /* Reset alive count value to 0 */
	   PNC_Alive_count = SHUTDOWN_DISABLE;
	   }
     }

   }
   else
   {
		Loc_ShutdownPermission_Flag = SHUTDOWN_ENABLE;
	    /* Invoke Shutdown permission to SUSD */
	    (void)Rte_Write_PP_ShutdownPermission_SUSD_UserRequest(Loc_ShutdownPermission_Flag);
	    /* Reset alive count value to 0 */
	    PNC_Alive_count = SHUTDOWN_DISABLE;
   }
}

