/*******************************************************************************
 * Function name    : SUM_PNC_Init
 * Description      : Initialization function for PNC module
 * Parameter in     : PNC_ConfigPtr
 * Parameter out    : None
 * Return value     : void
 [$Satisfies $SDD_PNC 020] [$Satisfies $SDD_PNC 041]
 ******************************************************************************/
/* PRQA S 1503 EOF # Functions/runnables to be called by external modules */
FUNC(void, PNC_CODE) SUM_PNC_Init(void) /* PRQA S 1532 */ /* This function might be called by another modules */
{
    /* Local variables declaration */
    uint8 Loc_Index;

    /* Looping for all partial networks */
    for (Loc_Index = 0; Loc_Index < NUMBER_OF_PNC_PARTIAL_NETWORKS; Loc_Index++)
    {
        /* Initialization of counter arrays and flag arrays for timers */
        SUM_GaaPNC[Loc_Index].Counter_Sum_Active = 0;
        SUM_GaaPNC[Loc_Index].Counter_Sum_Passive = 0;
        SUM_GaaPNC[Loc_Index].Counter_PNC_t_Activation_Req_Timer = 0;
        SUM_GaaPNC[Loc_Index].Counter_Repeat_Msg_Time_Timer = 0;
        SUM_GaaPNC[Loc_Index].Flag_Counter_Sum_Active = PNC_TIMER_INVALID;
        SUM_GaaPNC[Loc_Index].Flag_Counter_Sum_Passive = PNC_TIMER_INVALID;
        SUM_GaaPNC[Loc_Index].Flag_Counter_PNC_t_Activation_Req_Timer = PNC_TIMER_INVALID;
        SUM_GaaPNC[Loc_Index].PN_DeActState = 0;
        /* The initial mode for all SUM_PNC shall assume no active PN, and stopped PDU groups */
        SUM_GaaPNC[Loc_Index].Current_PNC_State = SUM_PNC_NO_COMMUNICATION;
        SUM_GaaPNC[Loc_Index].Requested_PNC_State = SUM_PNC_INVALID;
        SUM_GaaPNC[Loc_Index].Current_ComMChannel_State = SUM_COMM_NO_COMMUNICATION;
        SUM_GaaPNC[Loc_Index].Current_PduGroupTX_State = SUM_PDUGRP_STOP;
        SUM_GaaPNC[Loc_Index].Current_PduGroupRX_State = SUM_PDUGRP_STOP;
        SUM_GaaPNC[Loc_Index].Current_PNC_Mode = PNC_ENABLE_CHECK;
        /* [$Satisfies $SDD_PNC 070] */
        SUM_GaaPNC[Loc_Index].DM_Timer = SUM_PNC_Cfg[Loc_Index].DM_Max_Timer;
        SUM_GaaPNC[Loc_Index].DM_Status = PNC_DM_ACTIVE;
        /* [$Satisfies $SDD_PNC 087] */
        SUM_GaaPNC[Loc_Index].PN_DTC_Timer = SUM_PNC_Cfg[Loc_Index].ptr_SUM_PN_DTC_TIMER_Default_Value();
        /* [$Satisfies $SDD_PNC 092] */
        SUM_PNC_Cfg[Loc_Index].ptr_SUM_PN_DTC_Allowed(DTC_Not_Allowed);

		«IF (GetPN_RecordID_Type(pNC)== 1) -»
		SUM_PNC_Local_WR[Loc_Index] = 0xFFu;
		«ENDIF»
         SUM_PNC_Criteria_NM_Act_Remote[Loc_Index] = FALSE;
         SUM_PNC_NM_NewActivation[Loc_Index] = FALSE;
         SUM_PNC_DM_Timer_Elapsed[Loc_Index] = FALSE;

    }

	/* Initialize NM activation history list */
	SUM_PNC_NM_ActReasonCount = 0U;
	SUM_PNC_NM_WR = 0xFFu;
	SUM_PNC_RemoteSUSDPending = FALSE;

}
