/*******************************************************************************
 * Function name    : Permit_Execution_SUSD
 * Description      : Receives response from SUSD regarding whether to shutdown
 *                    a partial network or not
 * Parameter in     : void
 * Parameter out    : void
 * Return value     : boolean
  [$Satisfies $SDD_PNC 002] [$Satisfies $SDD_PNC 007] [$Satisfies $SDD_PNC 040]
  [$Satisfies $SDD_PNC 021]
 ******************************************************************************/
FUNC(boolean, PNC_CODE) Permit_Execution_SUSD(void)
{
  static uint8 SUM_PNC_PermitExecution_state;
  boolean RetVal_PermitExecution = FALSE;

 /* Invoke RTE Read call to get the permit execution status*/
  (void)Rte_Read_RP_PermitExecution_SUSD_SWC_ExecutionStatus(&SUM_PNC_PermitExecution_state);

  /*Verify WakeUp bit by comparing SUM_PNC_PermitExecution_state with Mask value*/
  if((SUM_PNC_PermitExecution_state | PNC_PermitExecution_Mask )==0xFFu)
  {
    RetVal_PermitExecution = TRUE;
  }
  return RetVal_PermitExecution;
}

