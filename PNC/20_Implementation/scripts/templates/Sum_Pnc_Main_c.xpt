/*******************************************************************************
 * Function name    : Handling_PNC_State
 * Description      : Set Shut down and PNC Status
 * Parameter in     : PNC_Number
 * Parameter out    : void
 * Return value     : None
 * [$Satisfies $SDD_PNC 004 [$Satisfies $SDD_PNC 120] [$Satisfies $SDD_PNC 121]
 ******************************************************************************/
static FUNC(void, PNC_CODE) Handling_PNC_State(uint8 PNC_Number)
{
    /* Shut down PN by default */
    SUM_PNC_Shutdown_Permission[PNC_Number] = SHUTDOWN_ENABLE;

    Check_DTC_Allowed_Timer();

    switch (SUM_GaaPNC[PNC_Number].Current_PNC_Mode)
    {
        case PNC_ENABLE_CHECK:
        {
            Status_PNC_Enable_Check();
            break;
        }
        case PNC_MONITOR_ACTIVATION:
        {
            Status_PNC_Monitor_Activation();
            break;
        }
        case PNC_ACK_ACTIVATION:
        {
            Status_PNC_Ack_Activation();
            break;
        }
        case PNC_TX_ENABLE:
        {
            Status_PNC_Tx_Enable();
            break;
        }
        case PNC_LOCALLY_ACTIVE:
        {
            Status_PNC_Locally_Active();
	        SUM_PNC_SUSD_RecordInfo_Update(SUM_PNC_Cfg[PNC_Number].PN_Name,SUM_PNC_Local_WR[PNC_Number]);
            break;
        }
        case PNC_REMOTELY_ACTIVE:
        {
            Status_PNC_Remotely_Active();
            if ((SUM_PNC_Cfg[PNC_Number].PN_Name != 0u) && ((SUM_PNC_NM_NewActivation[PNC_Number] == TRUE) || (SUM_PNC_DM_Timer_Elapsed[PNC_Number] == TRUE) || (SUM_GaaPNC[PNC_Number].Current_PNC_Mode != PNC_REMOTELY_ACTIVE)))
            {
               SUM_PNC_NM_NewActivation[PNC_Number] = FALSE;
               SUM_PNC_DM_Timer_Elapsed[PNC_Number] = FALSE;
               SUM_PNC_RemoteSUSDPending = TRUE;
            }
            break;
        }
        default:
            /* Nothing to do */
            break;
    } /* End of Switch case */
}
#define SUM_PNC_STOP_SEC_CODE
#include "SUM_PNC_MemMap.h"

#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"

/*******************************************************************************
 * Function name    : UpdateCountersActiveTimer
 * Description      : Updating Counters for Sum Active Timer
 * Parameter in     : PN_Index
 * Parameter out    : void
 * Return value     : None
 * [$Satisfies $SDD_PNC 004]
 ******************************************************************************/
static FUNC(void, PNC_CODE) UpdateCountersActiveTimer(uint8 PN_Index)
{
    if (SUM_GaaPNC[PN_Index].Flag_Counter_Sum_Active == PNC_TIMER_INIT)
    {
        if (((uint32)SUM_GaaPNC[PN_Index].Counter_Sum_Active) < (((uint32)SUM_PNC_ACTIVE_SYNCH_TIME) / PNC_T_PNsPNsSTATUSMONITORING_PERIODICITY))
        {
            SUM_GaaPNC[PN_Index].Counter_Sum_Active++;
        }
        else
        {
            SUM_GaaPNC[PN_Index].Counter_Sum_Active = 0;
            SUM_GaaPNC[PN_Index].Flag_Counter_Sum_Active = PNC_TIMER_EXPIRED;
        }
    }
}
