/*******************************************************************************
  Function name :   PNC_DataServicesPN_DID_F08B_Info_Local
  Description   :   Function for ECU Operating State through DID
  Parameter in  :   OpStatus
  Parameter out :   Data
  Return value  :   Std_ReturnType
  Remarks       :   None
  [$Satisfies $SDD_PNC 058]
 ******************************************************************************/
FUNC(Std_ReturnType, SUM_PNC_CODE)
PNC_DataServicesPN_DID_F08B_Info_Local(VAR(Dcm_OpStatusType, AUTOMATIC) OpStatus,
                                 P2VAR(uint8, AUTOMATIC, RTE_APPL_DATA) Data)
{
	switch (OpStatus)
		{
		case DCM_INITIAL:
		case DCM_PENDING:
			   Data[0] = SUM_PNC_DID_INFO_Local[0];
			   Data[1] = SUM_PNC_DID_INFO_Local[1];
			   Data[2] = SUM_PNC_DID_INFO_Local[2];
			   Data[3] = SUM_PNC_DID_INFO_Local[3];
			   Data[4] = SUM_PNC_DID_INFO_Local[4];
			   Data[5] = SUM_PNC_DID_INFO_Local[5];
			#if (DID_INFO == 0x07)
			   Data[6] = SUM_PNC_DID_INFO_Local[6];
			#endif

	        break;
	  	default:
	  	    /* Nothing to do */
	  		break;
		}

    return(E_OK);
}
