#define SUM_PNC_START_SEC_CODE
#include "SUM_PNC_MemMap.h"

/*******************************************************************************
 * Function name    : SUM_PNC_Mainfunction
 * Description      : Manages all the PNs which ECU is a part of, this API is
					  cyclically invoked.
 * Parameter in     : void
 * Parameter out    : void
 * Return value     : None
 [$Satisfies $SDD_PNC 008] [$Satisfies $SDD_PNC 045] [$Satisfies $SDD_PNC 047]
 [$Satisfies $SDD_PNC 048] [$Satisfies $SDD_PNC 049] [$Satisfies $SDD_PNC 034]
 [$Satisfies $SDD_PNC 050] [$Satisfies $SDD_PNC 051] [$Satisfies $SDD_PNC 052]
 [$Satisfies $SDD_PNC 053] [$Satisfies $SDD_PNC 054]
 ******************************************************************************/
 FUNC(void, PNC_CODE) SUM_PNC_Mainfunction (void)
 {
    /* Loc_PN_Index represents the partial network index */
    uint8 Loc_PN_Index;

	/* Variable to check permit execution */
    boolean Permit_Exec;

    Permit_Exec = Permit_Execution_SUSD();

    if (Permit_Exec == TRUE) /* Permit execution has to be evaluated outside the loop as it is common to all PNs and to save run-time of the ECU */
    {
        /* Looping to get each partial network */
        for (Loc_PN_Index = 0; Loc_PN_Index < NUMBER_OF_PNC_PARTIAL_NETWORKS; Loc_PN_Index++)
        {
            if (PNC_GaaPNC_C_ProcessPN[Loc_PN_Index]() == TRUE)
            {
                /* Start PN Processing */
                SUM_PNC_PNC_Number = Loc_PN_Index;

                /* Set the PNC Status */
                Handling_PNC_State(SUM_PNC_PNC_Number);

                /* Updating Counters for Sum Active Timer */
                /* [$Satisfies $SDD_PNC 004] */
                UpdateCountersActiveTimer(Loc_PN_Index);

                /* Updating Counters for Sum Passive Timer */
                /* [$Satisfies $SDD_PNC 036] [$Satisfies $SDD_PNC 038] */
                UpdateCountersPassiveTimer(Loc_PN_Index);

                /* Updating Counters for Activation Req timer */
                /* [$Satisfies $SDD_PNC 038] [$Satisfies $SDD_PNC 039] */
                UpdateCountersActivationRegTimer(Loc_PN_Index);

                /* Updating Counters for Repeat Message Time Timer */
                if (SUM_GaaPNC[Loc_PN_Index].Counter_Repeat_Msg_Time_Timer > 0u)
                {
                    SUM_GaaPNC[Loc_PN_Index].Counter_Repeat_Msg_Time_Timer--;
                }
                else
                {
                    SUM_GaaPNC[Loc_PN_Index].Counter_Repeat_Msg_Time_Timer = 0;
                }
            }
            else
            {
                /* Do not process if PNC_ProcessPN is False*/
            }
        }/* End of For Looping for all PNs*/
    if (SUM_PNC_RemoteSUSDPending == TRUE)
    {
        SUM_PNC_SUSD_RecordInfo_Update(SPM_PNC_REMOTE_RID, SUM_PNC_NM_WR);
        SUM_PNC_RemoteSUSDPending = FALSE;
    }
    }
    else
    {
        /* Do not process if Permit execution is False*/
    }
}
