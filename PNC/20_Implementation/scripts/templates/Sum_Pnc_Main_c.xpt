/*******************************************************************************
 * Function name    : PNC_ComM_Current_ModeUSer
 * Description      : Fetches current ComM mode from PNC BswM mode user
 * Parameter in     : None
 * Parameter out    : None
 * Return value     : ComMChannel_State
 [$Satisfies $SDD_PNC 018] [$Satisfies $SDD_PNC 032]
 ******************************************************************************/
FUNC(ComMChannel_State, PNC_CODE) PNC_ComM_Current_ModeUSer(void)
{
  uint8 Loc_Channels;
  boolean Loc_Flag;
  ComMChannel_State Loc_ComMChannel_State;
  ComMChannel_State Loc_ComMChannel_State_old;
  Loc_ComMChannel_State = SUM_COMM_NO_COMMUNICATION ;
  Loc_ComMChannel_State_old = SUM_COMM_NO_COMMUNICATION ;

  Loc_Flag = FALSE;
  Loc_Channels = 0;


  do{
      if((Loc_Channels < SUM_PNC_Cfg[SUM_PNC_PNC_Number].Number_of_Channels))
      {

        Loc_ComMChannel_State  =SUM_PNC_Cfg[SUM_PNC_PNC_Number].ptr_PNC_GaaSUM_Bswm_ComM_Current_ModeUser_Interface[Loc_Channels]();
        if (Loc_Flag)
        {
        Loc_ComMChannel_State = ((Loc_ComMChannel_State > Loc_ComMChannel_State_old) ? (Loc_ComMChannel_State) : (Loc_ComMChannel_State_old));
        }
        else
        {
        Loc_ComMChannel_State_old = Loc_ComMChannel_State ;
        }
        Loc_Flag = TRUE;
      }
      Loc_Channels++;
    }while(Loc_Channels < NUMBER_OF_PNC_TOTAL_CHANNELS);

	SUM_GaaPNC[SUM_PNC_PNC_Number].Current_ComMChannel_State = Loc_ComMChannel_State;

    return  SUM_GaaPNC[SUM_PNC_PNC_Number].Current_ComMChannel_State;

}

