«ENDFOREACH-»
«FOREACH pNC.pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara ITERATOR i-»
extern Rte_Switch_PNC_BswMPduGroupSwitchTxReq_Interface «PartialNWPara.comM_PNC_Ref.shortName »_GaaSUM_BswM_ComM_Pdugroupswitch_TxReq[«PartialNWPara.comM_PNC_Ref.comMChannelPerPnc.size-»];
«ENDFOREACH-»
extern Rte_Read_PNC_DisableNormalComm_DIAG_Interface PNC_GaaSUM_PNC_DisableNormalComm_Interface[NUMBER_OF_PNC_TOTAL_CHANNELS];
extern Rte_mode_Bswm_ComM_Current_PNC_ModeUser_MDG_PNC_State_Interface PNC_GaaSUM_Bswm_ComM_Current_PNC_ModeUser_Interface[NUMBER_OF_PNC_PARTIAL_NETWORKS]; /* PRQA S 3447 EOF */
extern Rte_mode_Bswm_ComM_Current_ModeUser_MDG_ComMChannel_State_Interface PNC_GaaSUM_Bswm_ComM_Current_ModeUser_Interface[NUMBER_OF_PNC_TOTAL_CHANNELS];
extern Rte_Switch_Bswm_ComM_Current_ModeReq_PNC_State_Interface PNC_GaaSUM_Bswm_ComM_Current_ModeReq_Interface[NUMBER_OF_PNC_PARTIAL_NETWORKS];

