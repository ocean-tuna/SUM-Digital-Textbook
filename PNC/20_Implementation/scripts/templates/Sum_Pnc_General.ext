Integer PNC_getPNNumber(ComMPnc this):
let PN_Number = (this.comMPncId):
    PN_Number
;

Boolean IsPDUDisableFeatureEnabled(PNC cfg):
	if cfg.pNCGeneral.sSFMConfigSet_Ref != null then
	(
		if cfg.pNCGeneral.sSFMConfigSet_Ref.sum_Ssfm_C_SsmDisable_Tx_PDU != null then
		(
			if cfg.pNCGeneral.sSFMConfigSet_Ref.sum_Ssfm_C_SsmDisable_Tx_PDU.size > 0 then
			(
				true
			)
			else
				false
		)
		else
			false
	)
	else
		false
;

Integer GetNoOfDisablePDUs(PNC cfg):
	if IsPDUDisableFeatureEnabled(cfg) then
		cfg.pNCGeneral.sSFMConfigSet_Ref.sum_Ssfm_C_SsmDisable_Tx_PDU.size
	else
		0
;

boolean isUsingUDP(PNCConfigSet cfg):
	if cfg.sUM_PNC_PARTIAL_NETWORK_PARAMETER.repeat_Message_Time_Ref.collect(e|e.metaType).toSet().selectFirst(e|true).metaType.toString().contains("Udp") then
		true
	else
		false
;

boolean validateNMConfigured(PNCConfigSet cfg):
	if cfg.sUM_PNC_PARTIAL_NETWORK_PARAMETER.repeat_Message_Time_Ref.collect(e|e.metaType).toSet().size  == 1 then
		true
	else
		false
;

Integer GetPartialNetworkID(SUM_PNC_PARTIAL_NETWORK_PARAMETER cfg):
    if cfg.partialNetworkName == "All Nodes" then
        33
    else if cfg.partialNetworkName == "Wireless Charging" then
        34
    else if cfg.partialNetworkName == "Short Duration Event" then
        35
    else if cfg.partialNetworkName == "Diagnose Mechatronics Ethernet" then
        36
    else if cfg.partialNetworkName == "Any Diagnose CAN PN" then
        37
    else
        0
;

Integer GetPN_RecordID_Type(PNC cfg):
    if cfg.pNCGeneral.sum_PNC_Local_RecordID_Type == "Enumerated" then
        1
    else if cfg.pNCGeneral.sum_PNC_Local_RecordID_Type == "BitMapped" then
        2
    else
        0
;