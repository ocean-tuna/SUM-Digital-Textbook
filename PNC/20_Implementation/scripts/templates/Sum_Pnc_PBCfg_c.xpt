/* Post Build Calibration parameters */

#include "Rte_SUM_PNC.h"
#include "Sum_Pnc.h"
#include "Sum_Pnc_PBCfg.h"

 /*
 *******************************************************************************
 * Function Prototypes
 *******************************************************************************
 */
«FOREACH pNC.pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PN_Nos ITERATOR i -»
static FUNC(boolean, RTE_CODE) PNC_Rte_CData_PNC_C_ProcessPN_«PN_Nos.comM_PNC_Ref.shortName -»(void);
«ENDFOREACH-»

 /*
 *******************************************************************************
 * Functions
 *******************************************************************************
 */
«FOREACH pNC.pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PN_Nos ITERATOR i -»
/**
 * \name PNC_Rte_CData_PNC_C_ProcessPN_«PN_Nos.comM_PNC_Ref.shortName -»
 *
 * \breif        Wrapper for Rte_CData_PNC_C_ProcessPN_«PN_Nos.comM_PNC_Ref.shortName -»()
 * \param[in]    none
 * \param[out]   none
 * \return       boolean
 */
static FUNC(boolean, RTE_CODE) PNC_Rte_CData_PNC_C_ProcessPN_«PN_Nos.comM_PNC_Ref.shortName -»(void)
{
	return Rte_CData_PNC_C_ProcessPN_«PN_Nos.comM_PNC_Ref.shortName -»(); /* PRQA S 3469 # The function like macros is used. This is necessary to get value via RTE variable */
}
«ENDFOREACH-»

/* PRQA S 1532 EOF */ /* This function might be called by another modules */
«FOREACH pNC.pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PNC_PN_CFG ITERATOR i-»
/**
 * \name       PNC_Rte_CData_SUM_PN_DTC_TIMER_«PNC_PN_CFG.comM_PNC_Ref.shortName -»
 *
 * \brief      Wrapper for Rte_CData_SUM_PN_DTC_TIMER_«PNC_PN_CFG.comM_PNC_Ref.shortName » returning it in microseconds time unit
 * \param[in]  none
 * \param[out] none
 * \return     uint32
 */
FUNC(uint32, RTE_CODE) PNC_Rte_CData_SUM_PN_DTC_TIMER_«PNC_PN_CFG.comM_PNC_Ref.shortName -»(void)
{
	/*
     * RTE returns calibration parameter in milliseconds according to Periodicity Configuration
     * Parameter (GB8002 Specification); this value shall be converted because
     * PNC static code works in microseconds time base
     */
    uint32 ret;

    ret = ((Rte_CData_SUM_PN_DTC_TIMER_«PNC_PN_CFG.comM_PNC_Ref.shortName »()) * (conversion_factor)); /* PRQA S 3469 # The function like macros is used. This is necessary to get value via RTE variable */

	return ret;
}
«ENDFOREACH-»


FP_PNC_pCdata_Type PNC_GaaPNC_C_ProcessPN[NUMBER_OF_PNC_PARTIAL_NETWORKS]= /* PRQA S 1531 # This object can be used in other file */
{
«FOREACH pNC.pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PN_Nos ITERATOR i -»
	&PNC_Rte_CData_PNC_C_ProcessPN_«PN_Nos.comM_PNC_Ref.shortName -»,
«ENDFOREACH-»
};


