            <AR-PACKAGE>
              <SHORT-NAME>Components</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-SW-COMPONENT-TYPE>
                  <SHORT-NAME>SUM_PNC</SHORT-NAME>
                  <PORTS>
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara ITERATOR i-»
                    «FOREACH 0.upTo(PartialNWPara.number_of_PNC_Activation_Sensors - 1) AS k ITERATOR j»
                     <R-PORT-PROTOTYPE>
                      <SHORT-NAME>RP_Act_Sensor_CS«j.counter0-»_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                      <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/PNC_Activation_sensor_«j.counter0-»_«PartialNWPara.comM_PNC_Ref.shortName -»</REQUIRED-INTERFACE-TREF>
                    </R-PORT-PROTOTYPE>
                    «ENDFOREACH-»
                    «ENDFOREACH-»
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara ITERATOR i-»
                    «FOREACH 0.upTo(PartialNWPara.number_of_PNC_Activation_Signals - 1) AS k ITERATOR j»
                    <R-PORT-PROTOTYPE>
                      <SHORT-NAME>RP_Act_Signal_«j.counter0-»_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                      <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/PNC_Activation_signal_«j.counter0-»_«PartialNWPara.comM_PNC_Ref.shortName -»</REQUIRED-INTERFACE-TREF>
                    </R-PORT-PROTOTYPE>
                    «ENDFOREACH-»
                    «ENDFOREACH-»
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara ITERATOR i-»
                    «FOREACH 0.upTo(PartialNWPara.number_of_PNC_Activation_Signals - 1) AS k ITERATOR j»
                    <R-PORT-PROTOTYPE>
                      <SHORT-NAME>RP_Act_Signals_Status_«j.counter0-»_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                      <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/PNC_Activation_Signals_Status_«j.counter0-»_«PartialNWPara.comM_PNC_Ref.shortName -»</REQUIRED-INTERFACE-TREF>
                    </R-PORT-PROTOTYPE>
                    «ENDFOREACH-»
                    «ENDFOREACH-»
                    <!--[$Satisfies $SDD_PNC 043]-->
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara ITERATOR i-»
                    <R-PORT-PROTOTYPE>
                        <SHORT-NAME>RP_Bswm_ComM_Current_PNC_ModeUser_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                        <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/RB/GM_SUM/Interfaces/PNC_BswM_ComM_CurrentPNCModeUser_«PartialNWPara.comM_PNC_Ref.shortName -»</REQUIRED-INTERFACE-TREF>
                    </R-PORT-PROTOTYPE>
                    «ENDFOREACH-»

                    «FOREACH pNCGeneral.comM_PNC_Channel.comM_Channel_Ref AS network ITERATOR k-»
                    <R-PORT-PROTOTYPE>
                        <SHORT-NAME>RP_ComM_Current_ModeUser_Ch«network.comMChannelId-»</SHORT-NAME>
                        <REQUIRED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/RB/GM_SUM/Interfaces/PNC_ComM_CurrentModeUser_«network.comMChannelId-»</REQUIRED-INTERFACE-TREF>
                     </R-PORT-PROTOTYPE>
                     «ENDFOREACH-»



					 «FOREACH pNCGeneral.comM_PNC_Channel.comM_Channel_Ref AS network ITERATOR k-»
           <!--[$Satisfies $SDD_PNC 115] [$Satisfies $SDD_PNC 116]-->
						<R-PORT-PROTOTYPE>
						<SHORT-NAME>RP_DIAG_DisableNormalComm_Ch«network.comMChannelId-»</SHORT-NAME>
						  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/DIAG_DisableNormalComm</REQUIRED-INTERFACE-TREF>
						</R-PORT-PROTOTYPE>
					«ENDFOREACH-»


                     <R-PORT-PROTOTYPE>
                        <SHORT-NAME>RP_PermitExecution</SHORT-NAME>
                        <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUSD_PermitExecution</REQUIRED-INTERFACE-TREF>
                     </R-PORT-PROTOTYPE>

                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara ITERATOR i-»
                    <!--[$Satisfies $SDD_PNC 107] [$Satisfies $SDD_PNC 108]-->
                    <P-PORT-PROTOTYPE>
                        <SHORT-NAME>PP_Active_TxPDU_Enable_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                        <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/PNC_ActiveTxPDUEnable</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                     «ENDFOREACH-»
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara ITERATOR i-»
                    <!--[$Satisfies $SDD_PNC 109] [$Satisfies $SDD_PNC 110]-->
                    <P-PORT-PROTOTYPE>
                        <SHORT-NAME>PP_Active_RxPDU_Enable_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                        <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/PNC_ActiveRxPDUEnable</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDFOREACH-»
                    <!--[$Satisfies $SDD_PNC 113]-->
                    <P-PORT-PROTOTYPE>
                    <SHORT-NAME>PP_ShutdownPermission</SHORT-NAME>
                    <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/PNC_ShutdownPermission</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «IF isUsingUDP(pNCConfigSet) == false -»
                    «IF pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER.number_of_PNC_Activation_Sensors.exists(e| e > 0) || pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER.number_of_PNC_Activation_Signals.exists(e| e > 0)-»
                    <!--[$Satisfies $SDD_PNC 058]-->
                    <P-PORT-PROTOTYPE>
                      <SHORT-NAME>PP_PNC_DataServicesPN_DID_F08B_Info_Local</SHORT-NAME>
                      <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«Pnc_DID_F08B_Data_ShortName(pNCGeneral.parent)»</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDIF -»
                    <!--[$Satisfies $SDD_PNC 060]-->
                    <P-PORT-PROTOTYPE>
                      <SHORT-NAME>PP_PNC_DataServicesPN_DID_F08D_Info_Remote</SHORT-NAME>
                      <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/AUTOSAR_Dcm/PortInterfaces/DataServices_«Pnc_DID_F08D_Data_ShortName(pNCGeneral.parent)»</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDIF-»

                    <!--[$Satisfies $SDD_PNC 043]-->
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara-»
                    «FOREACH PartialNWPara.comM_PNC_Ref.comMChannelPerPnc AS ChannelSize ITERATOR i -»
                    «IF PartialNWPara.isTxEnabled == true-»
                    <P-PORT-PROTOTYPE>
                        <SHORT-NAME>PP_Pdugroupswitch_TxReq_BswM_«PartialNWPara.comM_PNC_Ref.shortName -»_Ch«ChannelSize.comMChannelId-»</SHORT-NAME>
                        <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/RB/GM_SUM/Interfaces/PNC_BswMPduGroupSwitchTxReq_Interface</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDIF-»
                    «ENDFOREACH-»
                    «ENDFOREACH-»
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara-»
                    «FOREACH PartialNWPara.comM_PNC_Ref.comMChannelPerPnc AS ChannelSize ITERATOR i -»
                     «IF PartialNWPara.isRxEnabled == true-»
                    <P-PORT-PROTOTYPE>
                        <SHORT-NAME>PP_Pdugroupswitch_RxReq_BswM_«PartialNWPara.comM_PNC_Ref.shortName »_Ch«ChannelSize.comMChannelId-»</SHORT-NAME>
                        <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/RB/GM_SUM/Interfaces/PNC_BswMPduGroupSwitchRxReq_Interface</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDIF»
                    «ENDFOREACH-»
                    «ENDFOREACH-»

                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara-»
                        <P-PORT-PROTOTYPE>
                        <SHORT-NAME>PP_PNC_BswM_ComM_CurrentPNCMode_Req_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                        <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/RB/GM_SUM/Interfaces/PNC_BswM_ComM_CurrentPNCModeReq_«PartialNWPara.comM_PNC_Ref.shortName »</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>

                    <P-PORT-PROTOTYPE>
                      <SHORT-NAME>PP_PNC_BswM_PDUGroup_DM_Switch_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                      <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/Interfaces/PNC_«PartialNWPara.comM_PNC_Ref.shortName -»_Group_DM_Switch</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDFOREACH-»
«REM»[$Satisfies $SDD_PNC 090]«ENDREM»
                    «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara-»
                    <!--[$Satisfies $SDD_PNC 111] [$Satisfies $SDD_PNC 112]-->
                    <P-PORT-PROTOTYPE>
                        <SHORT-NAME>PP_PNC_PN_DTC_Allowed_«PartialNWPara.comM_PNC_Ref.shortName -»</SHORT-NAME>
                        <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/PN_DTC_Allowed</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDFOREACH-»

					«IF IsPDUDisableFeatureEnabled(pNCGeneral.parent)»
					«FOREACH pNCGeneral.sSFMConfigSet_Ref.sum_Ssfm_C_SsmDisable_Tx_PDU AS txMessage-»
          <!--[$Satisfies $SDD_PNC 117] [$Satisfies $SDD_PNC 118] [$Satisfies $SDD_PNC 119]-->
					<R-PORT-PROTOTYPE>
						<SHORT-NAME>RP_PNC_C_Disable_Tx_«txMessage.sum_Ssfm_C_SsmDisable_Tx_PDURef.shortName-»</SHORT-NAME>
						<REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/GM_SUM/Interfaces/SUM_C_Disable_Tx</REQUIRED-INTERFACE-TREF>
					</R-PORT-PROTOTYPE>
					<P-PORT-PROTOTYPE>
	                    <SHORT-NAME>PP_PNC_BswM_DisablePdu_«txMessage.sum_Ssfm_C_SsmDisable_Tx_PDURef.shortName-»</SHORT-NAME>
	                    <PROVIDED-INTERFACE-TREF DEST="MODE-SWITCH-INTERFACE">/GM_SUM/Interfaces/SUM_BswM_DisablePdu</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                    «ENDFOREACH-»
					«ENDIF»
		  			<R-PORT-PROTOTYPE>
                      <SHORT-NAME>RP_PNC_SUSD_RecordInfo</SHORT-NAME>
                      <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/GM_SUM/Interfaces/SUSD_PNC_UpdateRecord</REQUIRED-INTERFACE-TREF>
                    </R-PORT-PROTOTYPE>
                  </PORTS>
                  <INTERNAL-BEHAVIORS>
                    <SWC-INTERNAL-BEHAVIOR>
                      <SHORT-NAME>IB_PNC</SHORT-NAME>
                      <DATA-TYPE-MAPPING-REFS>
                            <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/RB/GM_SUM/Infrastructure/DTMS_PNC</DATA-TYPE-MAPPING-REF>
                            «IF IsPDUDisableFeatureEnabled(pNCGeneral.parent)-»
                            <DATA-TYPE-MAPPING-REF DEST="DATA-TYPE-MAPPING-SET">/GM_SUM/Infrastructure/DTMS_DisablePDU</DATA-TYPE-MAPPING-REF>
                    		«ENDIF-»
                    	</DATA-TYPE-MAPPING-REFS>
                        <EVENTS>
