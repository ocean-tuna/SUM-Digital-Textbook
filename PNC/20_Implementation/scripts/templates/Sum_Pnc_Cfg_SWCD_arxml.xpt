                    <MODE-DECLARATIONS>
                      <MODE-DECLARATION>
                        <SHORT-NAME>PN_DM_ENABLE</SHORT-NAME>
                        <VALUE>1</VALUE>
                      </MODE-DECLARATION>
                      <MODE-DECLARATION>
                        <SHORT-NAME>PN_DM_DISABLE</SHORT-NAME>
                        <VALUE>0</VALUE>
                      </MODE-DECLARATION>
                    </MODE-DECLARATIONS>
                  </MODE-DECLARATION-GROUP>
                  «FOREACH pNCConfigSet.sUM_PNC_PARTIAL_NETWORK_PARAMETER AS PartialNWPara-»
                  <MODE-SWITCH-INTERFACE>
                    <SHORT-NAME>PNC_«PartialNWPara.comM_PNC_Ref.shortName -»_Group_DM_Switch</SHORT-NAME>
                    <IS-SERVICE>false</IS-SERVICE>
                    <MODE-GROUP>
                      <SHORT-NAME>PNC_DM</SHORT-NAME>
                      <TYPE-TREF DEST="MODE-DECLARATION-GROUP">/Interfaces/MDG_PNC_DM</TYPE-TREF>
                    </MODE-GROUP>
                  </MODE-SWITCH-INTERFACE>
				«ENDFOREACH»
            </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
«ENDFILE»
«ENDDEFINE»