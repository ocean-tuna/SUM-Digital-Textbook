/*
 * @defgroup PNC_AR_Runnable_C    PNC - APPLICATION LAYER MODULE
*/

#include "Sum_Pnc.h"
#include "Rte_SUM_PNC.h"

#if (Generate_Pnc_InitRunnable_Status == STD_ON)

/*********************************************************************************
 * Function name : RE_PNC_Init
 * Description   : Runnable call function SUM_PNC_Init
 * Parameter in  : none
 * Parameter out : none
 * Return value  : none
 *
 * [$Satisfies $SDD_PNC 100]
 ********************************************************************************/
/* PRQA S 1503 8 # It's scheduled in the OS */
FUNC(void, PNC_CODE) RE_PNC_Init(void)
{
    /* Keeping as 32 bit variable for lower chance the value could be overwritten to exactly 0. */
	static uint32 Pnc_init_status = 0x0;

	/* Just a plausibility check in case the user accidentally calls this function
     * more than once */
	if(Pnc_init_status != (uint32)SUM_INITIALIZED)
	{
		SUM_PNC_Init();
		Pnc_init_status = SUM_INITIALIZED;
	}

}
#endif



