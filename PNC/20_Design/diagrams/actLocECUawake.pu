@startuml actLocECUawake
skinparam ParticipanrPadding 20
skinparam BoxPadding 20

participant BswM

participant "Sensor SWCs"
participant SUM_PNC
participant SWCs
participant SUM_SSFM
participant SUM_SUSD

autonumber
BswM -> SUM_PNC: SUM PNC Init
activate SUM_PNC
deactivate SUM_PNC

note over "Sensor SWCs": Local Activation Criteria == TRUE\n(Sensor_Act == TRUE)
"Sensor SWCs" -> SUM_PNC: Activation_Sensor
activate SUM_PNC
deactivate SUM_PNC

SUM_PNC -> SUM_PNC: PNC MainFunction
activate SUM_PNC

SUM_PNC -> BswM: PNC_BswM_CurrentPNCModeReq
activate BswM
deactivate BswM

BswM -> SUM_PNC: PNC_BswM_CurrentPNCModeUser
activate SUM_PNC
deactivate SUM_PNC

SUM_PNC -> BswM: PNC_BswMPduGroupSwitchRxReq
activate BswM
deactivate BswM

SUM_PNC -> SUM_SSFM: PNC_ActiveRxPDUEnable
activate SUM_SSFM
deactivate SUM_SSFM

BswM -> SUM_PNC: PNC_BswM_CurrentPNCModeUser
activate SUM_PNC
deactivate SUM_PNC

SUM_PNC -> BswM: PNC_BswMPduGroupSwitchTxReq
activate BswM
deactivate BswM

SUM_PNC -> SWCs: PNC_ActiveTxPDUEnable
activate SWCs
deactivate SWCs
deactivate SUM_PNC

SUM_PNC -> SUM_SUSD: Shutdown_permission_SUSD
SUM_PNC -> SUM_SUSD: SUSD_PNC_UpdateRecord (SUM_PNC_Local_WR)
activate SUM_SUSD
deactivate SUM_SUSD
@enduml