@startuml remAct

state PN_IDLE {
    state PNC_ENABLE_CHECK: * PNC_NM_Frame_Indication sets SUM_PNC_Criteria_NM_Act_Remote == TRUE
    state PNC_ENABLE_CHECK: * Request Activation of PN Rx PDU group
    state PNC_ENABLE_CHECK: * SUM_PNC_PASSIVE_SYNCH_TIME == ON

    state PNC_TX_ENABLE: * Request activation of Tx PDU
    state PNC_TX_ENABLE: * Notify SUSD via SUSD_PNC_UpdateRecord (SUM_PNC_NM_WR)
}

state PN_ACTIVE {
    state PNC_REMOTELY_ACTIVE: * Bus communication == Full Comm
    state PNC_REMOTELY_ACTIVE: * PN state Transition != PNC_NO_COMM
    state PNC_REMOTELY_ACTIVE: * NM Deadline Monitoring Timer active
}

[*] --> PNC_ENABLE_CHECK
PNC_ENABLE_CHECK --> PNC_TX_ENABLE: (Local Activation Criteria == FALSE &&\nNM Remote Criterion (SUM_PNC_Criteria_NM_Act_Remote) == TRUE &&\nPN State Transition != PNC_NO_COMM) &&\nDIAG_DisableNormalComm == <ENABLE_NORMAL_COMM>
PNC_TX_ENABLE -> PNC_REMOTELY_ACTIVE: SUM_PNC_PASSIVE_SYNCH_TIME == EXPIRED
@enduml